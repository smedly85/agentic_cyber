{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-cve-census-v2.json",
  "title": "Historical vulnerability discovery census",
  "type": "array",
  "items": {"$ref": "#/$defs/censusRecord"},
  "$defs": {
    "censusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "identifier_type", "package_project", "utility_component", "target_utility",
        "provenance", "analysis_eligibility", "disposition_reason",
        "source_patch_verification_status", "references"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "identifier_type": {"enum": ["cve", "temporary"]},
        "package_project": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "utility_component": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "target_utility": {"type": "boolean"},
        "provenance": {
          "enum": [
            "upstream_gnu", "downstream_patch", "predecessor_package",
            "unrelated_implementation"
          ]
        },
        "analysis_eligibility": {"enum": ["eligible", "excluded", "unresolved"]},
        "disposition_reason": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "source_patch_verification_status": {
          "enum": ["verified", "partially_verified", "unverified"]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
