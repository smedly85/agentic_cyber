{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Population v2 scientific mapping, source, and measurement ledgers",
  "type": "object",
  "required": ["schema_version", "population_fingerprint", "instrument_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "population_fingerprint": {"$ref": "#/$defs/sha256"},
    "instrument_commit": {"const": "e73c3a98ea3b4f5b8957674b9a05d182ced4558b"}
  },
  "oneOf": [
    {
      "required": ["freeze_status", "mapping_artifact_fingerprint", "members"],
      "properties": {
        "mapping_artifact_fingerprint": {"$ref": "#/$defs/sha256"},
        "freeze_status": {"type": "string"},
        "members": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/mapping"}}
      }
    },
    {
      "required": ["study_status", "members"],
      "properties": {
        "study_status": {"enum": ["in_progress_no_population_statistics", "all_dispositions_complete_aggregation_pending", "complete"]},
        "members": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/result"}}
      }
    },
    {
      "required": ["specimens"],
      "properties": {"specimens": {"type": "array", "items": {"$ref": "#/$defs/specimen"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cve": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "function": {
      "type": "object", "required": ["source_file", "function", "source_identity"],
      "properties": {"source_file": {"type": "string", "minLength": 1}, "function": {"type": "string", "minLength": 1}, "source_identity": {"type": "string", "minLength": 1}, "executables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "mapping": {
      "type": "object", "required": ["cve_id", "mapping_status", "completed", "functions", "mapping_fingerprint"],
      "properties": {
        "cve_id": {"$ref": "#/$defs/cve"}, "completed": {"type": "boolean"},
        "mapping_status": {"enum": ["pending", "verified", "verified_pilot_reuse", "not_applicable", "unresolved", "proxy_evidence_only"]},
        "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
        "programs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_affected_executables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mapping_fingerprint": {"$ref": "#/$defs/sha256"},
        "mapping_frozen_before_new_measurement": {"const": true}
      },
      "allOf": [{"if": {"properties": {"completed": {"const": true}}},
                 "then": {"required": ["vulnerability_evidence", "mapping_frozen_before_new_measurement", "freeze_stage"]}}]
    },
    "observation": {
      "type": "object", "required": ["source_identity", "specimen_id", "analysis_backend", "source_scope_kind", "mapping", "raw_call_depth", "shortest_semantic_path"],
      "properties": {
        "source_identity": {"type": "string"}, "specimen_id": {"type": "string"},
        "analysis_backend": {"const": "clang_llvm_svf"},
        "source_scope_kind": {"enum": ["linker_exact", "reconstructed_program_scope", "archive_superset"]},
        "raw_call_depth": {"type": ["integer", "null"], "minimum": 0},
        "mapping": {"type": "object", "required": ["semantic_mapping_status", "candidate_count", "candidate_identities", "candidates"]},
        "shortest_semantic_path": {"type": ["object", "null"]}
      }
    },
    "result": {
      "type": "object", "required": ["cve_id", "population_member", "completed", "disposition", "depth_applicability", "observations", "reason", "mapping_fingerprint"],
      "properties": {
        "cve_id": {"$ref": "#/$defs/cve"}, "population_member": {"const": true}, "completed": {"type": "boolean"},
        "disposition": {"enum": ["pending", "depth_applicable", "not_applicable_no_vulnerable_runtime_function", "not_applicable_build_or_configuration_only", "affected_specimen_unavailable", "vulnerable_function_mapping_unresolved", "historical_source_unavailable", "historical_build_unavailable", "semantic_analysis_unavailable", "source_identity_not_found", "source_identity_ambiguous", "semantic_unreachable", "unresolved_indirect_dispatch"]},
        "depth_applicability": {"enum": ["not_yet_determined", "applicable", "applicable_in_principle", "not_applicable"]},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "executable_coverage": {"type": "array", "items": {"$ref": "#/$defs/executableCoverage"}},
        "reason": {"type": "string", "minLength": 1}, "mapping_fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [{"if": {"properties": {"completed": {"const": true}}}, "then": {"properties": {"disposition": {"not": {"const": "pending"}}}}}]
    },
    "executableCoverage": {
      "type": "object",
      "required": ["executable", "status", "required_source_identities"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "status": {"enum": ["measured_vulnerable_context", "evidence_backed_exclusion", "pending"]},
        "required_source_identities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1}
      }
    },
    "specimen": {
      "type": "object", "required": ["specimen_id", "source_tree", "source_revision", "source_tree_sha256", "source_scope_kind", "source_scope_evidence", "source_count", "graph_quality", "analysis_provenance", "retained_graph_path", "retained_graph_sha256"],
      "properties": {
        "specimen_id": {"type": "string"}, "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_scope_kind": {"enum": ["linker_exact", "reconstructed_program_scope", "archive_superset"]},
        "source_count": {"type": "integer", "minimum": 1}, "retained_graph_sha256": {"$ref": "#/$defs/sha256"},
        "graph_quality": {
          "type": "object",
          "required": ["defined_function_count", "reachable_function_count", "call_edge_count", "direct_edge_count", "resolved_indirect_edge_count", "unresolved_indirect_callsite_count", "external_unavailable_definition_count", "ambiguous_source_identity_count"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
