{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-v2 historical semantic source-scope checkpoint",
  "type": "object",
  "required": ["schema_version", "analysis_backend", "pointer_analysis", "primary_options", "scope", "archive_superset", "linker_exact", "program_results", "toolchain", "identity_ambiguity_diagnostic", "reachable_indirect_target_set_changes", "begfield_scope_sensitivity"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_backend": {"const": "clang_llvm_svf"},
    "pointer_analysis": {"const": "andersen_wave_diff"},
    "primary_options": {"const": ["-stat=false", "-ff-eq-base"]},
    "scope": {
      "type": "object",
      "required": ["source_scope_kind", "source_revision", "source_tree_sha256", "source_files", "object_source_mapping", "archive_members_required", "objects_directly_linked", "link_command", "make_variables", "removed_source_files", "removed_archive_objects", "source_integrity_verified"],
      "properties": {
        "source_scope_kind": {"const": "linker_exact"},
        "source_integrity_verified": {"const": true},
        "source_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(lib/|src/|generated-config/)"}},
        "source_file_count": {"type": "integer", "minimum": 1},
        "object_count": {"type": "integer", "minimum": 1}
      }
    },
    "archive_superset": {"$ref": "#/$defs/graph_summary"},
    "linker_exact": {"$ref": "#/$defs/graph_summary"},
    "program_results": {
      "type": "object",
      "required": ["archive_superset", "linker_exact"],
      "additionalProperties": {
        "type": "object",
        "required": ["source_scope_kind", "source_files", "build_commands", "bitcode_files", "build_configuration", "historical_build_status", "llvm_ir_status", "primary"],
        "properties": {
          "source_scope_kind": {"enum": ["linker_exact", "reconstructed_program_scope", "archive_superset"]}
        }
      }
    },
    "identity_ambiguity_diagnostic": {"type": "object"},
    "reachable_indirect_target_set_changes": {"type": "array"}
  },
  "$defs": {
    "graph_summary": {
      "type": "object",
      "required": ["analysis_status", "function_count", "call_edge_count", "resolved_indirect_edge_count", "unresolved_indirect_callsite_count", "begfield"],
      "properties": {
        "analysis_status": {"const": "success"},
        "function_count": {"type": "integer", "minimum": 1},
        "call_edge_count": {"type": "integer", "minimum": 0},
        "begfield": {
          "type": "object",
          "required": ["semantic_mapping_status", "requested_source_identity", "candidate_count", "candidate_identities", "candidates"]
        }
      }
    }
  }
}
