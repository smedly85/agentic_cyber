{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-semantic-validation-v1.json",
  "title": "Historical-v1 semantic call-graph instrument validation",
  "type": "object",
  "required": [
    "schema_version", "study", "scientific_use", "modifies_historical_v1",
    "analysis_backend", "pointer_analysis", "primary_svf_options",
    "sensitivity_svf_options", "toolchain", "programs", "observations",
    "aggregate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study": {"const": "historical_v1_semantic_callgraph_validation"},
    "scientific_use": {"const": "side_by_side_instrument_validation_only"},
    "modifies_historical_v1": {"const": false},
    "analysis_backend": {"const": "clang_llvm_svf"},
    "pointer_analysis": {"const": "andersen_wave_diff"},
    "primary_svf_options": {"const": ["-stat=false", "-ff-eq-base"]},
    "sensitivity_svf_options": {"const": ["-stat=false"]},
    "toolchain": {"type": "object"},
    "programs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "program_key", "source_tree", "source_revision",
          "source_tree_sha256", "historical_build_status", "llvm_ir_status",
          "primary", "sensitivity_without_ff_eq_base", "source_scope_kind"
        ],
        "properties": {
          "source_scope_kind": {"$ref": "#/$defs/source_scope_kind"}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/observation"}
    },
    "aggregate": {
      "type": "object",
      "required": [
        "total_vulnerable_function_observations", "semantic_numeric_depth_count",
        "semantic_nonnumeric_or_unavailable_count", "semantic_numeric_coverage",
        "direct_only_reachable_count",
        "reachable_using_resolved_indirect_edge_count",
        "old_nonnumeric_became_numeric_count", "old_numeric_depth_changed_count",
        "old_numeric_became_nonnumeric_or_unavailable_count",
        "ff_eq_base_material_change_count"
      ]
    }
  },
  "$defs": {
    "source_scope_kind": {
      "enum": ["linker_exact", "reconstructed_program_scope", "archive_superset"]
    },
    "identity_mapping": {
      "type": "object",
      "required": ["semantic_mapping_status", "requested_source_identity", "candidate_count", "candidate_identities", "candidates"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_identities": {"type": "array", "items": {"type": "string"}},
        "candidates": {"type": "array", "items": {"type": "object"}}
      },
      "allOf": [{
        "if": {"properties": {"semantic_mapping_status": {"const": "source_identity_ambiguous"}}},
        "then": {"properties": {"candidate_count": {"minimum": 2}, "candidates": {"minItems": 2}}}
      }]
    },
    "edge": {
      "type": "object",
      "required": [
        "caller", "callee", "edge_type", "callsite",
        "pointer_analysis_backend", "pointer_analysis",
        "indirect_target_count", "indirect_target_set"
      ],
      "properties": {
        "edge_type": {"enum": ["direct", "indirect_resolved"]},
        "pointer_analysis_backend": {"const": "SVF"},
        "pointer_analysis": {"const": "andersen_wave_diff"},
        "indirect_target_count": {"type": ["integer", "null"]},
        "indirect_target_set": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "path": {
      "type": ["object", "null"],
      "properties": {
        "function_identities": {"type": ["array", "null"]},
        "edges": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    },
    "observation": {
      "type": "object",
      "allOf": [{
        "if": {"properties": {"semantic_mapping_status": {"const": "source_identity_ambiguous"}}, "required": ["semantic_mapping_status"]},
        "then": {
          "required": ["source_identity_mapping"],
          "properties": {
            "mapped_semantic_identity": {"const": null},
            "semantic_raw_call_depth": {"const": null},
            "shortest_semantic_path": {"const": null}
          }
        }
      }],
      "required": [
        "cve", "vulnerable_source_tree", "source_revision",
        "vulnerable_function_identity", "mapped_semantic_identity",
        "source_file", "historical_build_status", "llvm_ir_status",
        "svf_analysis_status", "semantic_mapping_status",
        "semantic_raw_call_depth", "shortest_semantic_path",
        "direct_edges_on_path", "indirect_edges_on_path",
        "old_prototype_status", "old_prototype_depth",
        "semantic_vs_prototype", "semantic_vs_prototype_explanation",
        "ff_eq_base_sensitivity"
      ],
      "properties": {
        "cve": {"type": "string", "pattern": "^CVE-"},
        "vulnerable_function_identity": {"type": "string"},
        "mapped_semantic_identity": {"type": ["string", "null"]},
        "source_scope_kind": {"$ref": "#/$defs/source_scope_kind"},
        "source_identity_mapping": {"$ref": "#/$defs/identity_mapping"},
        "semantic_raw_call_depth": {"type": ["integer", "null"], "minimum": 0},
        "shortest_semantic_path": {"$ref": "#/$defs/path"},
        "ff_eq_base_sensitivity": {
          "type": "object",
          "required": [
            "configuration", "analysis_status", "semantic_mapping_status",
            "raw_call_depth", "shortest_semantic_path",
            "build_success_changed", "reachability_changed",
            "raw_depth_changed", "shortest_path_changed",
            "indirect_target_set_membership_changed"
          ]
        }
      }
    }
  }
}
