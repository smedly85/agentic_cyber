{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospectively frozen professor-confirmed 24-CVE population",
  "type": "object",
  "required": ["schema_version", "population_name", "population_size", "population_freeze_date", "population_definition", "population_source_artifact", "population_fingerprint", "instrument_commit", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "population_size": {"const": 24},
    "instrument_commit": {"const": "e73c3a98ea3b4f5b8957674b9a05d182ced4558b"},
    "population_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "members": {"type": "array", "minItems": 24, "maxItems": 24, "items": {
      "type": "object",
      "required": ["cve_id", "population_member", "affected_project_package", "utility_component", "implementation_family", "gnu_lineage_relationship", "category_at_freeze", "target_utility_relationship", "authoritative_sources", "descriptors_are_not_inclusion_filters"],
      "properties": {"cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$"}, "population_member": {"const": true}, "descriptors_are_not_inclusion_filters": {"const": true}}
    }}
  }
}
