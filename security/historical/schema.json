{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-vulnerability-v2.json",
  "title": "Manually curated upstream historical vulnerability dataset",
  "type": "array",
  "items": {"$ref": "#/$defs/record"},
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "utility", "upstream_project", "affected_version", "fixed_version", "source_revision",
        "vulnerable_function", "patched_functions", "cwe", "bug_type",
        "attacker_input", "source_reference", "patch_reference", "notes", "verified"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "utility": {"enum": ["sort", "mkdir", "chmod", "grep"]},
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string"},
        "fixed_version": {"type": "string"},
        "source_revision": {"type": "string", "minLength": 1},
        "vulnerable_function": {"type": "string", "minLength": 1},
        "patched_functions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cwe": {"type": "string"},
        "bug_type": {"type": "string"},
        "attacker_input": {"type": "string"},
        "source_reference": {"type": "string"},
        "patch_reference": {"type": "string"},
        "notes": {"type": "string"},
        "verified": {"type": "boolean"}
      }
    }
  }
}
