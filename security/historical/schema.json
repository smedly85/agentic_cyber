{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-vulnerability-v4.json",
  "title": "Manually curated historical vulnerability dataset",
  "type": "array",
  "items": {"$ref": "#/$defs/record"},
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "utility", "upstream_project", "affected_version", "fixed_version", "source_revision",
        "vulnerable_functions", "patched_functions", "cwe", "bug_type",
        "attacker_input", "source_reference", "patch_reference", "notes", "verified"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "utility": {"enum": ["sort", "mkdir", "chmod", "grep"]},
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string"},
        "fixed_version": {"type": "string"},
        "source_revision": {
          "description": "Immutable GNU revision of the analyzed release for upstream_gnu, or of the pristine upstream base for downstream_patch; the final downstream tree is identified separately by its manifest fingerprint.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_provenance": {
          "description": "Whether the vulnerability is mapped in an upstream GNU release or a downstream-patched reconstruction.",
          "enum": ["upstream_gnu", "downstream_patch"]
        },
        "upstream_base_version": {"type": "string", "minLength": 1},
        "downstream_revision": {
          "description": "Immutable downstream packaging-repository commit, distinct from source_revision.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vulnerable_functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
        },
        "patched_functions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "uniqueItems": true
        },
        "cwe": {"type": "string"},
        "bug_type": {"type": "string"},
        "attacker_input": {"type": "string"},
        "source_reference": {"type": "string"},
        "patch_reference": {"type": "string"},
        "notes": {"type": "string"},
        "verified": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_provenance": {"const": "downstream_patch"}},
            "required": ["source_provenance"]
          },
          "then": {"required": ["upstream_base_version", "downstream_revision"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["upstream_base_version"]},
                {"required": ["downstream_revision"]}
              ]
            }
          }
        }
      ]
    }
  }
}
