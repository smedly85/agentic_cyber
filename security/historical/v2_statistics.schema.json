{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical population-v2 semantic call-depth statistics",
  "type": "object",
  "required": ["schema_version", "population_fingerprint", "mapping_artifact_fingerprint", "instrument_commit", "observation_rule", "population_accounting", "primary_function_observations", "primary_function_observation_statistics", "cve_weighted_statistics", "executable_context_sensitivity", "dependence_disclosure", "dependence_interpretation", "per_cve"],
  "properties": {
    "schema_version": {"const": 1},
    "population_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_artifact_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_rule": {"type": "object", "required": ["primary_unit", "shared_function_rule", "raw_contexts_preserved", "sensitivity_contexts_are_independent_vulnerability_observations", "executable_coverage_gate_passed"], "properties": {"executable_coverage_gate_passed": {"const": true}}},
    "population_accounting": {"type": "object", "required": ["population_cves", "depth_applicable_cves", "cves_with_numeric_semantic_depth", "non_depth_applicable_cves", "measurement_unavailable_cves", "all_final_dispositions", "verified_vulnerable_function_observations", "numeric_vulnerable_function_observations", "nonnumeric_vulnerable_function_observations", "raw_executable_contexts"], "properties": {"population_cves": {"const": 24}, "all_final_dispositions": {"const": true}, "depth_applicable_cves": {"type": "integer", "minimum": 0}, "cves_with_numeric_semantic_depth": {"type": "integer", "minimum": 0}, "non_depth_applicable_cves": {"type": "integer", "minimum": 0}, "measurement_unavailable_cves": {"type": "integer", "minimum": 0}, "verified_vulnerable_function_observations": {"type": "integer", "minimum": 0}, "numeric_vulnerable_function_observations": {"type": "integer", "minimum": 0}, "nonnumeric_vulnerable_function_observations": {"type": "integer", "minimum": 0}, "raw_executable_contexts": {"type": "integer", "minimum": 0}}},
    "primary_function_observations": {"type": "array"},
    "primary_function_observation_statistics": {"$ref": "#/$defs/statistics"},
    "cve_weighted_statistics": {"$ref": "#/$defs/statistics"},
    "executable_context_sensitivity": {"type": "object", "required": ["context_count", "independent_vulnerability_observations", "contexts", "statistics"], "properties": {"context_count": {"type": "integer", "minimum": 1}, "independent_vulnerability_observations": {"const": false}, "contexts": {"type": "array"}, "statistics": {"$ref": "#/$defs/statistics"}}},
    "dependence_disclosure": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["specimen", "source_identity", "depth", "counted_for"]}},
    "dependence_interpretation": {"type": "string", "minLength": 1},
    "per_cve": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "object", "required": ["cve_id", "depth_applicability", "verified_vulnerable_function_count", "numeric_vulnerable_function_count", "function_depths", "scope_kinds", "analysis_status"]}}
  },
  "$defs": {
    "statistics": {"type": "object", "required": ["n", "values", "mean", "median", "sample_sd", "q1", "q3", "iqr", "minimum", "maximum", "exact_depth_histogram"], "properties": {"n": {"type": "integer", "minimum": 1}, "values": {"type": "array", "items": {"type": "number"}}, "mean": {"type": "number"}, "median": {"type": "number"}, "sample_sd": {"type": ["number", "null"]}, "q1": {"type": "number"}, "q3": {"type": "number"}, "iqr": {"type": "number"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "exact_depth_histogram": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}}}
  }
}
