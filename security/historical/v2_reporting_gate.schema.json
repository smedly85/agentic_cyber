{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2 reporting gate (not aggregate statistics)",
  "type": "object",
  "required": ["schema_version", "population_fingerprint", "mapping_artifact_fingerprint", "population_count", "completed_disposition_count", "pending_cves", "all_dispositions_complete", "depth_applicable_cve_count", "numeric_cve_count", "not_applicable_cve_count", "measurement_unavailable_cve_count", "verified_cve_function_count", "numeric_executable_function_measurement_count", "cve_function_groups_with_numeric_measurements", "multiple_executable_function_groups", "dependent_call_depth_locations", "executable_coverage_gate_passed", "pending_executable_coverage", "statistics_reportable", "statistics_computed", "gate_reason"],
  "properties": {
    "schema_version": {"const": 1},
    "population_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_artifact_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "population_count": {"const": 24},
    "completed_disposition_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "pending_cves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "all_dispositions_complete": {"type": "boolean"},
    "depth_applicable_cve_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "numeric_cve_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "not_applicable_cve_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "measurement_unavailable_cve_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "verified_cve_function_count": {"type": "integer", "minimum": 0},
    "numeric_executable_function_measurement_count": {"type": "integer", "minimum": 0},
    "cve_function_groups_with_numeric_measurements": {"type": "integer", "minimum": 0},
    "executable_coverage_gate_passed": {"type": "boolean"},
    "pending_executable_coverage": {"type": "array", "items": {"type": "object", "required": ["cve_id", "executable"]}},
    "dependent_call_depth_locations": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["specimen", "source_identity", "depth", "counted_for"]}},
    "statistics_reportable": {"type": "boolean"},
    "statistics_computed": {"type": "boolean"},
    "gate_reason": {"type": "string", "minLength": 1},
    "multiple_executable_function_groups": {
      "type": "array", "items": {
        "type": "object", "required": ["cve_id", "source_identity", "executable_specific_depths"],
        "properties": {
          "cve_id": {"type": "string"}, "source_identity": {"type": "string"},
          "executable_specific_depths": {"type": "array", "minItems": 2, "items": {
            "type": "object", "required": ["specimen_id", "raw_call_depth"],
            "properties": {"specimen_id": {"type": "string"}, "raw_call_depth": {"type": ["integer", "null"], "minimum": 0}}
          }}
        }
      }
    }
  }
}
