{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "population_fingerprint", "instrument_commit", "primary_configuration", "disposition_taxonomy", "mapping_order", "statistics_gate", "statistics_conventions"],
  "properties": {
    "schema_version": {"const": 1},
    "population_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pending_is_not_final": {"const": true},
    "primary_configuration": {"type": "object", "properties": {"clang_llvm": {"const": "21.1.8"}, "svf_commit": {"const": "67efb7745ce47b2b6853fd5696fc22c83d701e6c"}, "options": {"const": ["-stat=false", "-ff-eq-base"]}}}
  }
}
