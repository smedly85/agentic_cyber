{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust vulnerable-function mappings, no semantic measurements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_frozen_before_semantic_measurement", "population_fingerprint", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "mapping_frozen_before_semantic_measurement": {"const": true},
    "population_fingerprint": {"$ref": "#/$defs/hash"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "mapping_status", "category", "depth_applicability", "depth_nonapplicability_reason", "mapping_frozen_before_semantic_measurement", "vulnerable_functions", "unresolved_reason", "mapping_completeness", "review_notes", "excluded_changes", "affected_revision", "affected_version", "fix_revision", "fix_evidence"],
      "properties": {
        "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
        "mapping_status": {"enum": ["verified", "unresolved", "not_applicable"]},
        "category": {"type": "string"},
        "depth_applicability": {"enum": ["applicable", "not_applicable"]},
        "depth_nonapplicability_reason": {"type": ["string", "null"]},
        "mapping_frozen_before_semantic_measurement": {"const": true},
        "vulnerable_functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
        "unresolved_reason": {"type": ["string", "null"]},
        "mapping_completeness": {"enum": ["reviewed_primary_evidence", "partial_verified_locations", "not_applicable"]},
        "review_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_changes": {"type": "string", "minLength": 1},
        "affected_revision": {"$ref": "#/$defs/revision"},
        "affected_version": {"type": "string", "minLength": 1},
        "fix_revision": {"$ref": "#/$defs/revision"},
        "fix_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "configuration_source_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src/.+\\.rs$"}},
        "affected_executables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "source_file", "source_identity", "crate_or_package", "utility_or_shared_component", "affected_executables", "executable_scope_basis", "affected_revision", "affected_version", "fix_revision", "source_sha256", "mapping_evidence", "mapping_reason", "mapping_confidence", "mapping_status", "mapping_frozen_before_semantic_measurement"],
      "properties": {
        "function": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "pattern": "^src/.+\\.rs$"},
        "source_identity": {"type": "string", "pattern": "^src/.+\\.rs::.+$"},
        "crate_or_package": {"type": "string", "minLength": 1},
        "utility_or_shared_component": {"type": "string", "minLength": 1},
        "affected_executables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "executable_scope_basis": {"type": "string", "minLength": 1},
        "affected_revision": {"$ref": "#/$defs/revision"},
        "affected_version": {"type": "string", "minLength": 1},
        "fix_revision": {"$ref": "#/$defs/revision"},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "mapping_evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}},
        "mapping_reason": {"type": "string", "minLength": 1},
        "mapping_confidence": {"enum": ["high", "medium", "low"]},
        "mapping_status": {"const": "verified"},
        "mapping_frozen_before_semantic_measurement": {"const": true}
      }
    }
  }
}
