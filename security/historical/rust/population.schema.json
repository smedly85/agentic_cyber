{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust historical population before semantic measurement",
  "type": "object",
  "required": ["schema_version", "cutoff_date", "project", "population_rule", "mapping_frozen_before_semantic_measurement", "discovery_audit", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "cutoff_date": {"const": "2026-09-11"},
    "project": {"const": "uutils/coreutils"},
    "population_rule": {"type": "string", "minLength": 1},
    "mapping_frozen_before_semantic_measurement": {"const": true},
    "discovery_audit": {"type": "object"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "aliases", "cve_state", "project", "implementation_family", "utility_component", "language", "publication_date", "population_member", "cutoff_date", "affected_versions", "advisory_version_claims", "fixed_version", "authoritative_sources", "category", "depth_applicability", "depth_nonapplicability_reason", "mapping_status", "evidence_file", "exclusion_reason", "notes"],
      "properties": {
        "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}|RUSTSEC-[0-9]{4}-[0-9]{4})$"}},
        "cve_state": {"type": "string"},
        "project": {"type": "string"},
        "implementation_family": {"type": "string"},
        "utility_component": {"type": "string"},
        "language": {"enum": ["Rust", "C"]},
        "publication_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "population_member": {"type": "boolean"},
        "cutoff_date": {"const": "2026-09-11"},
        "affected_versions": {"type": "array", "minItems": 1},
        "advisory_version_claims": {"type": "array"},
        "fixed_version": {"type": ["string", "null"]},
        "authoritative_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(https?|ftp)://"}},
        "category": {"enum": ["runtime_function", "shared_runtime_library", "configuration", "build_system", "dependency", "other_non_function"]},
        "depth_applicability": {"enum": ["applicable", "not_applicable"]},
        "depth_nonapplicability_reason": {"type": ["string", "null"]},
        "mapping_status": {"enum": ["verified", "unresolved", "not_applicable", "excluded"]},
        "evidence_file": {"type": "string", "pattern": "^evidence/CVE-[0-9]{4}-[0-9]{4,}\\.md$"},
        "exclusion_reason": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
