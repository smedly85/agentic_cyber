{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-source-manifest-v6.json",
  "title": "Locally supplied immutable historical source manifest",
  "type": "array",
  "items": {"$ref": "#/$defs/source"},
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_project", "affected_version", "source_revision",
        "source_tree", "source_tree_sha256", "programs"
      ],
      "properties": {
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string", "minLength": 1},
        "source_revision": {
          "description": "Immutable GNU revision of the analyzed release for upstream_gnu, or of the pristine upstream base for downstream_patch; it is never the downstream packaging revision or final patched-tree identity.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_provenance": {
          "description": "Whether the analyzed tree is the GNU release or a downstream-patched reconstruction.",
          "enum": ["upstream_gnu", "downstream_patch"]
        },
        "upstream_base_version": {"type": "string", "minLength": 1},
        "downstream_revision": {
          "description": "Immutable downstream packaging-repository commit, distinct from source_revision.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "downstream_source": {"$ref": "#/$defs/downstreamSource"},
        "source_tree": {"type": "string", "minLength": 1},
        "source_tree_sha256": {
          "description": "Whole-tree C/H fingerprint of the final analyzed tree, including downstream patches when source_provenance is downstream_patch.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "programs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "sort": {"$ref": "#/$defs/program"},
            "mkdir": {"$ref": "#/$defs/program"},
            "chmod": {"$ref": "#/$defs/program"},
            "grep": {"$ref": "#/$defs/program"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_provenance": {"const": "downstream_patch"}},
            "required": ["source_provenance"]
          },
          "then": {
            "required": [
              "upstream_base_version", "downstream_revision", "downstream_source"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["upstream_base_version"]},
                {"required": ["downstream_revision"]},
                {"required": ["downstream_source"]}
              ]
            }
          }
        }
      ]
    },
    "downstreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution", "source_package", "packaging_repository", "spec_file",
        "spec_sha256", "security_patch_file", "security_patch_sha256",
        "security_patch_git_blob", "upstream_archive_sha256",
        "upstream_signature_sha256"
      ],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "source_package": {
          "description": "Downstream package identity represented by the reconstructed packaging state; this field alone does not assert that SRPM bytes or an RPM signature were downloaded or authenticated.",
          "type": "string",
          "minLength": 1
        },
        "packaging_repository": {"type": "string", "format": "uri"},
        "spec_file": {"type": "string", "minLength": 1},
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "security_patch_file": {"type": "string", "minLength": 1},
        "security_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "security_patch_git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point"],
      "oneOf": [
        {"required": ["source_globs"]},
        {"required": ["source_files"]}
      ],
      "properties": {
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "source_globs": {
          "description": "Conservative glob scope for programs without a frozen build-metadata file list.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        },
        "source_files": {
          "description": "Exact, frozen source paths derived from program build metadata.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[?*\\[]).+\\.c$"
          }
        },
        "declared_indirect_dispatches": {
          "description": "Source-supported indirect-call boundaries retained as unresolved rather than converted into call-graph edges.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/indirectDispatch"}
        }
      }
    },
    "indirectDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "callee_text", "possible_target"],
      "properties": {
        "caller": {"$ref": "#/$defs/entryPoint"},
        "callee_text": {"type": "string", "minLength": 1},
        "possible_target": {"$ref": "#/$defs/entryPoint"}
      }
    },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "function"],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[?*\\[]).+$"
        },
        "function": {"type": "string", "minLength": 1}
      }
    }
  }
}
