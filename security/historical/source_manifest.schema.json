{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-source-manifest-v1.json",
  "title": "Locally supplied immutable historical source manifest",
  "type": "array",
  "items": {"$ref": "#/$defs/source"},
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_project", "affected_version", "source_revision",
        "source_tree", "source_tree_sha256"
      ],
      "properties": {
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_tree": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
