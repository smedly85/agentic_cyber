{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-source-manifest-v2.json",
  "title": "Locally supplied immutable historical source manifest",
  "type": "array",
  "items": {"$ref": "#/$defs/source"},
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_project", "affected_version", "source_revision",
        "source_tree", "source_tree_sha256", "programs"
      ],
      "properties": {
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_tree": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "programs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "sort": {"$ref": "#/$defs/program"},
            "mkdir": {"$ref": "#/$defs/program"},
            "chmod": {"$ref": "#/$defs/program"},
            "grep": {"$ref": "#/$defs/program"}
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point", "source_globs"],
      "properties": {
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "source_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        }
      }
    },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "function"],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[?*\\[]).+$"
        },
        "function": {"type": "string", "minLength": 1}
      }
    }
  }
}
