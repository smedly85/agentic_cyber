{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/historical-source-manifest-v5.json",
  "title": "Locally supplied immutable historical source manifest",
  "type": "array",
  "items": {"$ref": "#/$defs/source"},
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_project", "affected_version", "source_revision",
        "source_tree", "source_tree_sha256", "programs"
      ],
      "properties": {
        "upstream_project": {"enum": ["gnu-coreutils", "gnu-grep"]},
        "affected_version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "programs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "sort": {"$ref": "#/$defs/program"},
            "mkdir": {"$ref": "#/$defs/program"},
            "chmod": {"$ref": "#/$defs/program"},
            "grep": {"$ref": "#/$defs/program"}
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point"],
      "oneOf": [
        {"required": ["source_globs"]},
        {"required": ["source_files"]}
      ],
      "properties": {
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "source_globs": {
          "description": "Conservative glob scope for programs without a frozen build-metadata file list.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        },
        "source_files": {
          "description": "Exact, frozen source paths derived from program build metadata.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[?*\\[]).+\\.c$"
          }
        },
        "declared_indirect_dispatches": {
          "description": "Source-supported indirect-call boundaries retained as unresolved rather than converted into call-graph edges.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/indirectDispatch"}
        }
      }
    },
    "indirectDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "callee_text", "possible_target"],
      "properties": {
        "caller": {"$ref": "#/$defs/entryPoint"},
        "callee_text": {"type": "string", "minLength": 1},
        "possible_target": {"$ref": "#/$defs/entryPoint"}
      }
    },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "function"],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[?*\\[]).+$"
        },
        "function": {"type": "string", "minLength": 1}
      }
    }
  }
}
