{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fedora sort generated-module scope completion",
  "type": "object",
  "required": ["schema_version", "analysis_backend", "pointer_analysis", "primary_options", "toolchain", "programs", "modifies_historical_v1", "population_v2_started"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_backend": {"const": "clang_llvm_svf"},
    "pointer_analysis": {"const": "andersen_wave_diff"},
    "primary_options": {"const": ["-stat=false", "-ff-eq-base"]},
    "modifies_historical_v1": {"const": false},
    "population_v2_started": {"const": false},
    "programs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["program_key", "source_scope_kind", "scope", "old_stats", "new_stats", "observations", "analyses"],
        "properties": {
          "source_scope_kind": {"const": "linker_exact"},
          "observations": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {
              "type": "object", "required": ["cve", "requested_source_identity", "old", "new", "comparison_status"],
              "properties": {
                "old": {"$ref": "#/$defs/mapping"},
                "new": {"$ref": "#/$defs/mapping"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "required": ["semantic_mapping_status", "requested_source_identity", "candidate_count", "candidate_identities", "candidates"]
    }
  }
}
