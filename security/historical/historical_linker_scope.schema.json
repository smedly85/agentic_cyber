{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configured historical program source/object closure with generated modules",
  "type": "object",
  "required": ["schema_version", "program_key", "source_scope_kind", "source_revision", "source_tree_sha256", "source_files", "source_file_count", "object_count", "translation_units", "objects_directly_linked", "archive_members_required", "generated_module", "make_variables", "native_link_command", "source_integrity_verified"],
  "properties": {
    "schema_version": {"const": 1},
    "source_scope_kind": {"const": "linker_exact"},
    "program_key": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
    "source_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_file_count": {"type": "integer", "minimum": 1},
    "object_count": {"type": "integer", "minimum": 1},
    "release_source_count": {"type": "integer", "minimum": 1},
    "objects_directly_linked": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "archive_members_required": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
    "source_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_integrity_verified": {"const": true},
    "translation_units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_file", "source_provenance_kind", "source_sha256", "object_name", "configured_object_target", "archive", "link_role", "dependency_evidence", "compile_recipe_provenance"],
        "properties": {
          "source_file": {"type": "string"},
          "object_name": {"type": "string", "pattern": "\\.o$"},
          "configured_object_target": {"type": "string", "pattern": "\\.o$"},
          "source_provenance_kind": {"enum": ["authenticated_historical_tree", "configured_build_generated"]},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "archive": {"type": ["string", "null"]},
          "link_role": {"enum": ["direct_program_object", "static_archive_member"]},
          "compile_recipe_provenance": {
            "type": "object",
            "required": ["kind", "working_directory", "make_command", "configured_compiler_recipe", "clang_command"],
            "properties": {
              "kind": {"const": "configured_automake_dry_run"},
              "working_directory": {"type": "string"},
              "make_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "configured_compiler_recipe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "clang_command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"source_provenance_kind": {"const": "configured_build_generated"}}},
          "then": {"properties": {"source_file": {"pattern": "^generated-config/"}}},
          "else": {"properties": {"source_file": {"pattern": "^(src|lib)/"}}}
        }]
      }
    },
    "generated_module": {
      "type": "object",
      "required": ["source_file", "configured_source_path", "object", "archive", "generation_rule", "generation_command", "package_version", "contents", "regenerated_sha256", "authenticated_release_source"],
      "properties": {"authenticated_release_source": {"const": false}}
    }
  }
}
