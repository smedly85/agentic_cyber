{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-cyber.invalid/schemas/semantic-callgraph-v1.json",
  "title": "Clang/LLVM/SVF semantic static may-call graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_backend", "analysis_status",
    "clang_version", "llvm_version", "svf_version", "pointer_analysis",
    "entry_point", "source_files", "build_commands", "provenance", "functions",
    "call_edges", "unresolved_indirect_callsites", "external_calls", "failures"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_backend": {"const": "clang_llvm_svf"},
    "analysis_status": {"enum": ["success", "build_or_ir_unavailable", "analysis_failure"]},
    "clang_version": {"type": ["string", "null"]},
    "llvm_version": {"type": ["string", "null"]},
    "svf_version": {"type": ["string", "null"]},
    "pointer_analysis": {"const": "andersen_wave_diff"},
    "entry_point": {
      "type": "object",
      "required": ["configured", "resolved_identity"],
      "properties": {
        "configured": {"type": "string", "minLength": 1},
        "resolved_identity": {"type": ["string", "null"]}
      }
    },
    "provenance": {"type": "object"},
    "source_files": {"type": "array", "items": {"type": "object"}},
    "build_commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identity", "source_qualified_identity", "llvm_symbol", "name",
          "source_file", "definition", "linkage",
          "reachable_from_entry", "raw_call_depth", "semantic_status",
          "shortest_call_path"
        ],
        "properties": {
          "identity": {"type": "string", "minLength": 1},
          "source_qualified_identity": {"type": "string", "minLength": 1},
          "llvm_symbol": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source_file": {"type": ["string", "null"]},
          "definition": {"$ref": "#/$defs/locationOrNull"},
          "linkage": {"type": "string"},
          "reachable_from_entry": {"type": "boolean"},
          "raw_call_depth": {"type": ["integer", "null"], "minimum": 0},
          "semantic_status": {
            "enum": [
              "resolved_direct_only", "resolved_with_indirect_edges",
              "resolved_indirect_multi_target", "unreachable_in_semantic_graph"
            ]
          },
          "shortest_call_path": {"type": "object"}
        }
      }
    },
    "call_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "unresolved_indirect_callsites": {"type": "array", "items": {"type": "object"}},
    "external_calls": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["source_file", "line", "column"],
      "properties": {
        "source_file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "locationOrNull": {"oneOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]},
    "edge": {
      "type": "object",
      "required": [
        "caller", "callee", "edge_type", "callsite",
        "pointer_analysis_backend", "pointer_analysis",
        "indirect_target_count", "indirect_target_set"
      ],
      "properties": {
        "caller": {"type": "string"},
        "callee": {"type": "string"},
        "edge_type": {"enum": ["direct", "indirect_resolved"]},
        "callsite": {"$ref": "#/$defs/location"},
        "pointer_analysis_backend": {"const": "SVF"},
        "pointer_analysis": {"const": "andersen_wave_diff"},
        "indirect_target_count": {"type": ["integer", "null"], "minimum": 1},
        "indirect_target_set": {
          "type": ["array", "null"],
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
