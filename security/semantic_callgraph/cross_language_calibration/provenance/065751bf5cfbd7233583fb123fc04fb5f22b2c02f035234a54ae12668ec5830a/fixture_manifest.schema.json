{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen source-only C/Rust calibration corpus",
  "type": "object",
  "required": ["schema_version", "pair_count", "pairs", "instrument_fingerprint_file_sha256", "measurement_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "pair_count": {"const": 15},
    "instrument_fingerprint_file_sha256": {"$ref": "#/$defs/sha"},
    "pairs": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/pair"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "required": ["language", "source_file", "function_name", "source_span", "semantic_role", "identity_policy"],
      "properties": {
        "language": {"enum": ["C", "Rust"]},
        "source_file": {"type": "string", "minLength": 1},
        "function_name": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "source_span": {
          "type": "object", "required": ["start_line", "start_column", "end_line", "end_column"],
          "properties": {
            "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
            "start_column": {"type": "integer", "minimum": 1}, "end_column": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "edges": {"type": "array", "items": {
      "type": "object", "required": ["caller", "callee", "relation"],
      "properties": {"caller": {"type": "string", "minLength": 1}, "callee": {"type": "string", "minLength": 1},
        "relation": {"enum": ["direct_application_call", "closure_application_transition"]}}
    }},
    "sites": {"type": "array", "items": {
      "type": "object", "required": ["callsite_id", "owner", "source_identity", "expected_targets", "exactness", "field_identity"],
      "properties": {
        "callsite_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
        "exactness": {"const": "exact"},
        "source_identity": {"type": "object", "required": ["source_file", "line", "column", "source_text"]},
        "expected_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "build": {
      "type": "object", "required": ["compiler", "compiler_identity", "compiler_sha256", "target", "flags", "smoke_output"],
      "properties": {"compiler": {"type": "string", "minLength": 1}, "compiler_sha256": {"$ref": "#/$defs/sha"},
        "target": {"type": "string", "minLength": 1}, "flags": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "runtime": {
      "type": "object", "required": ["id", "arguments", "stdin", "expected_termination", "expected_exit_code", "expected_stdout", "expected_stderr", "expected_observed_callbacks", "expected_reached_source_targets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}}, "stdin": {"type": "string"},
        "expected_termination": {"const": "normal"}, "expected_exit_code": {"const": 0},
        "expected_stdout": {"type": "string"}, "expected_stderr": {"type": "string"},
        "expected_observed_callbacks": {"type": "object", "required": ["C", "Rust"], "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "expected_reached_source_targets": {"type": "object", "required": ["C", "Rust"], "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
      }
    },
    "pair": {
      "type": "object",
      "required": ["pair_id", "category", "c_source", "rust_source", "c_source_sha256", "rust_source_sha256", "c_entry_identity", "rust_entry_identity", "c_target_identity", "rust_target_identity", "c_functions", "rust_functions", "c_callsites", "rust_callsites", "expected_c_edges", "expected_rust_edges", "expected_c_indirect_targets", "expected_rust_indirect_targets", "cross_language_expectation", "runtime_inputs", "build_configuration", "application_correspondence", "notes"],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^[a-z][a-z_]+$"}, "category": {"type": "string", "minLength": 1},
        "c_source": {"type": "string", "minLength": 1}, "rust_source": {"type": "string", "minLength": 1},
        "c_source_sha256": {"$ref": "#/$defs/sha"}, "rust_source_sha256": {"$ref": "#/$defs/sha"},
        "c_entry_identity": {"$ref": "#/$defs/identity"}, "rust_entry_identity": {"$ref": "#/$defs/identity"},
        "c_target_identity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "rust_target_identity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "c_functions": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/$defs/identity"}},
        "rust_functions": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/$defs/identity"}},
        "expected_c_edges": {"$ref": "#/$defs/edges"}, "expected_rust_edges": {"$ref": "#/$defs/edges"},
        "expected_c_indirect_targets": {"$ref": "#/$defs/sites"}, "expected_rust_indirect_targets": {"$ref": "#/$defs/sites"},
        "cross_language_expectation": {"enum": ["exact_application_structure", "equivalent_indirect_target_set", "equivalent_application_transition_with_runtime_nodes", "expected_library_boundary_difference"]},
        "build_configuration": {"type": "object", "required": ["C", "Rust"], "properties": {"C": {"$ref": "#/$defs/build"}, "Rust": {"$ref": "#/$defs/build"}}},
        "runtime_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime"}},
        "application_correspondence": {"type": "array", "minItems": 1}, "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
