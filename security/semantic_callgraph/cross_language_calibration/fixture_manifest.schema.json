{
  "$defs": {
    "build": {
      "properties": {
        "compiler": {
          "minLength": 1,
          "type": "string"
        },
        "compiler_sha256": {
          "$ref": "#/$defs/sha"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "target": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "compiler",
        "compiler_identity",
        "compiler_sha256",
        "target",
        "flags",
        "smoke_output"
      ],
      "type": "object"
    },
    "edges": {
      "items": {
        "properties": {
          "callee": {
            "minLength": 1,
            "type": "string"
          },
          "caller": {
            "minLength": 1,
            "type": "string"
          },
          "relation": {
            "enum": [
              "direct_application_call",
              "closure_application_transition"
            ]
          }
        },
        "required": [
          "caller",
          "callee",
          "relation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "identity": {
      "properties": {
        "function_name": {
          "minLength": 1,
          "type": "string"
        },
        "language": {
          "enum": [
            "C",
            "Rust"
          ]
        },
        "semantic_role": {
          "minLength": 1,
          "type": "string"
        },
        "source_file": {
          "minLength": 1,
          "type": "string"
        },
        "source_span": {
          "properties": {
            "end_column": {
              "minimum": 1,
              "type": "integer"
            },
            "end_line": {
              "minimum": 1,
              "type": "integer"
            },
            "start_column": {
              "minimum": 1,
              "type": "integer"
            },
            "start_line": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "start_column",
            "end_line",
            "end_column"
          ],
          "type": "object"
        }
      },
      "required": [
        "language",
        "source_file",
        "function_name",
        "source_span",
        "semantic_role",
        "identity_policy"
      ],
      "type": "object"
    },
    "pair": {
      "properties": {
        "application_correspondence": {
          "minItems": 1,
          "type": "array"
        },
        "build_configuration": {
          "properties": {
            "C": {
              "$ref": "#/$defs/build"
            },
            "Rust": {
              "$ref": "#/$defs/build"
            }
          },
          "required": [
            "C",
            "Rust"
          ],
          "type": "object"
        },
        "c_entry_identity": {
          "$ref": "#/$defs/identity"
        },
        "c_functions": {
          "additionalProperties": {
            "$ref": "#/$defs/identity"
          },
          "minProperties": 2,
          "type": "object"
        },
        "c_source": {
          "minLength": 1,
          "type": "string"
        },
        "c_source_sha256": {
          "$ref": "#/$defs/sha"
        },
        "c_target_identity": {
          "items": {
            "$ref": "#/$defs/identity"
          },
          "minItems": 1,
          "type": "array"
        },
        "category": {
          "minLength": 1,
          "type": "string"
        },
        "cross_language_expectation": {
          "enum": [
            "exact_application_structure",
            "equivalent_indirect_target_set",
            "equivalent_application_transition_with_runtime_nodes",
            "expected_library_boundary_difference"
          ]
        },
        "expected_c_edges": {
          "$ref": "#/$defs/edges"
        },
        "expected_c_indirect_targets": {
          "$ref": "#/$defs/sites"
        },
        "expected_rust_edges": {
          "$ref": "#/$defs/edges"
        },
        "expected_rust_indirect_targets": {
          "$ref": "#/$defs/sites"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pair_id": {
          "pattern": "^[a-z][a-z_]+$",
          "type": "string"
        },
        "runtime_inputs": {
          "items": {
            "$ref": "#/$defs/runtime"
          },
          "minItems": 1,
          "type": "array"
        },
        "rust_entry_identity": {
          "$ref": "#/$defs/identity"
        },
        "rust_functions": {
          "additionalProperties": {
            "$ref": "#/$defs/identity"
          },
          "minProperties": 2,
          "type": "object"
        },
        "rust_source": {
          "minLength": 1,
          "type": "string"
        },
        "rust_source_sha256": {
          "$ref": "#/$defs/sha"
        },
        "rust_target_identity": {
          "items": {
            "$ref": "#/$defs/identity"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "category",
        "c_source",
        "rust_source",
        "c_source_sha256",
        "rust_source_sha256",
        "c_entry_identity",
        "rust_entry_identity",
        "c_target_identity",
        "rust_target_identity",
        "c_functions",
        "rust_functions",
        "c_callsites",
        "rust_callsites",
        "expected_c_edges",
        "expected_rust_edges",
        "expected_c_indirect_targets",
        "expected_rust_indirect_targets",
        "cross_language_expectation",
        "runtime_inputs",
        "build_configuration",
        "application_correspondence",
        "notes"
      ],
      "type": "object"
    },
    "runtime": {
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_exit_code": {
          "const": 0
        },
        "expected_observed_callbacks": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required": [
            "C",
            "Rust"
          ],
          "type": "object"
        },
        "expected_reached_source_targets": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "required": [
            "C",
            "Rust"
          ],
          "type": "object"
        },
        "expected_stderr": {
          "type": "string"
        },
        "expected_stdout": {
          "type": "string"
        },
        "expected_termination": {
          "const": "normal"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "stdin": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "arguments",
        "stdin",
        "expected_termination",
        "expected_exit_code",
        "expected_stdout",
        "expected_stderr",
        "expected_observed_callbacks",
        "expected_reached_source_targets"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "sites": {
      "items": {
        "properties": {
          "callsite_id": {
            "minLength": 1,
            "type": "string"
          },
          "exactness": {
            "const": "exact"
          },
          "expected_targets": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "source_identity": {
            "required": [
              "source_file",
              "line",
              "column",
              "source_text"
            ],
            "type": "object"
          }
        },
        "required": [
          "callsite_id",
          "owner",
          "source_identity",
          "expected_targets",
          "exactness",
          "field_identity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "instrument_fingerprint_file_sha256": {
      "$ref": "#/$defs/sha"
    },
    "pair_count": {
      "const": 15
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/pair"
      },
      "maxItems": 15,
      "minItems": 15,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "semantic_extraction_configuration": {
      "properties": {
        "C": {
          "required": [
            "flags",
            "target_policy",
            "canonical_provider",
            "helper_options",
            "helper_sha256"
          ],
          "type": "object"
        },
        "Rust": {
          "required": [
            "flags",
            "canonical_configuration",
            "driver",
            "std_policy",
            "codegen_units",
            "target",
            "edition",
            "panic"
          ],
          "type": "object"
        }
      },
      "required": [
        "C",
        "Rust"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "pair_count",
    "pairs",
    "instrument_fingerprint_file_sha256",
    "measurement_policy",
    "semantic_extraction_configuration",
    "revision_provenance",
    "exact_application_structure_definition",
    "external_boundary_definition"
  ],
  "title": "Frozen source-only C/Rust calibration corpus",
  "type": "object"
}
