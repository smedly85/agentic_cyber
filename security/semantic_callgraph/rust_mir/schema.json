{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled MIR probe graph, not an accepted scientific instrument",
  "type": "object",
  "required": ["schema_version", "analysis_status", "accepted_backend", "functions", "call_edges", "callsites", "unresolved_indirect_callsites", "external_calls", "precision_losses", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_status": {"const": "incomplete"},
    "accepted_backend": {"const": false},
    "functions": {"type": "array", "items": {"type": "object", "required": ["identity", "instance_identity", "source_identity", "definition"]}},
    "call_edges": {"type": "array", "items": {"type": "object", "required": ["caller", "callee", "callsite", "edge_type", "mir_kind"]}},
    "callsites": {"type": "array"},
    "unresolved_indirect_callsites": {"type": "array"},
    "external_calls": {"type": "array"},
    "precision_losses": {"type": "array"},
    "provenance": {"type": "object", "properties": {"scientific_use_permitted": {"const": false}}}
  }
}
