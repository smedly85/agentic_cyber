{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIR allocation-local precision loss, with archived spike records",
  "oneOf": [
    {
      "type": "object",
      "required": ["instance", "reason"],
      "properties": {"instance": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["kind", "allocation", "source_span", "affected_fields", "affected_callsites"],
      "properties": {
        "kind": {"const": "byte_level_alias"},
        "allocation": {"type": "string", "minLength": 1},
        "source_span": {"type": "string"},
        "affected_fields": {"type": "array", "items": {"type": "string"}},
        "affected_callsites": {"type": "array", "items": {"type": "string"}}
      }
    }
  ]
}
