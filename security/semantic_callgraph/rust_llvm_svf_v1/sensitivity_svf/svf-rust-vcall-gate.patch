     if (cs->getCalledFunction() != nullptr || cs->arg_empty())
         return false;
 
+    // rust_llvm_svf_v1 sensitivity patch: this load(gep(load)) shape is the
+    // Itanium C++ vtable convention. Rust trait-object calls lower to the same
+    // shape but carry no C++ class hierarchy, so routing them to
+    // resolveCPPIndCalls discards their ordinary points-to targets. Only
+    // callsites whose debug compile unit is Rust (or, without a subprogram,
+    // whose module has only Rust compile units) are exempted; C and C++
+    // modules keep the upstream behaviour.
+    const llvm::Function* caller = cs->getFunction();
+    if (const llvm::DISubprogram* sp = caller->getSubprogram())
+    {
+        if (sp->getUnit() && sp->getUnit()->getSourceLanguage() == llvm::dwarf::DW_LANG_Rust)
+            return false;
+    }
+    else
+    {
+        bool sawUnit = false, allRust = true;
+        for (const llvm::DICompileUnit* unit : caller->getParent()->debug_compile_units())
+        {
+            sawUnit = true;
+            allRust = allRust && unit->getSourceLanguage() == llvm::dwarf::DW_LANG_Rust;
+        }
+        if (sawUnit && allRust)
+            return false;
+    }
+
     // the first argument (this pointer) must be a pointer type and must be a
     // class name
     if (cs->getArgOperand(0)->getType()->isPointerTy() == false)
