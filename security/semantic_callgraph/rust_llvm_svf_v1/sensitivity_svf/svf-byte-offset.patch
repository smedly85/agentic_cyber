 u32_t SVFIRBuilder::inferFieldIdxFromByteOffset(const llvm::GEPOperator* gepOp, DataLayout *dl, AccessPath& ap, APOffset idx)
 {
-    return 0;
+    // Instrument patch: translate physical offsets into SVF's flattened fields.
+    // Unknown layouts/interior scalar offsets must become variant GEPs, not
+    // silently alias field zero. This does not reconstruct Rust source types.
+    const u32_t unknown = std::numeric_limits<u32_t>::max();
+    if (idx < 0) return unknown;
+    const Type* type = llvmModuleSet()->getTypeInference()->inferObjType(gepOp->getPointerOperand());
+    uint64_t offset = static_cast<uint64_t>(idx);
+    u32_t field = 0;
+    while (type && type->isSized())
+    {
+        auto size = dl->getTypeAllocSize(const_cast<Type*>(type));
+        if (size.isScalable() || offset >= size.getFixedValue()) return unknown;
+        if (const auto* st = SVFUtil::dyn_cast<StructType>(type))
+        {
+            const auto* layout = dl->getStructLayout(const_cast<StructType*>(st));
+            unsigned element = layout->getElementContainingOffset(offset);
+            field += pag->getFlattenedElemIdx(llvmModuleSet()->getSVFType(st), element);
+            offset -= layout->getElementOffset(element);
+            type = st->getElementType(element);
+        }
+        else if (const auto* array = SVFUtil::dyn_cast<ArrayType>(type))
+        {
+            // Byte-array storage has no recoverable pointer-field layout.
+            if (array->getElementType()->isIntegerTy(8)) return unknown;
+            auto stride = dl->getTypeAllocSize(array->getElementType());
+            if (stride.isScalable() || !stride.getFixedValue()) return unknown;
+            unsigned element = offset / stride.getFixedValue();
+            field += pag->getFlattenedElemIdx(llvmModuleSet()->getSVFType(array), element);
+            offset %= stride.getFixedValue();
+            type = array->getElementType();
+        }
+        else return offset == 0 ? field : unknown;
+    }
+    return unknown;
 }
 
