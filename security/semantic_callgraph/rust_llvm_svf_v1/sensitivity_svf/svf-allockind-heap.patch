--- a/svf-llvm/lib/LLVMModule.cpp
+++ b/svf-llvm/lib/LLVMModule.cpp
@@ -994,6 +994,30 @@
     }
     ExtFun2Annotations.swap(newFun2AnnoMap);
 
+    // rust_llvm_svf_v1 sensitivity patch: a body-less declaration whose LLVM
+    // `allockind` attribute states allocation semantics, but which extapi.bc
+    // does not annotate by name, receives the matching ExtAPI annotation.
+    // Rust's mangled allocator shims (__rust_alloc, __rust_alloc_zeroed,
+    // __rust_realloc) are the motivating case.  Both annotation stores (this
+    // map feeds LLVMModuleSet and the core ExtAPI) therefore agree, and every
+    // name-annotated function keeps its upstream model.
+    for (Module& mod : modules)
+    {
+        if (&mod == extModule)
+            continue;
+        for (const Function& fun : mod.functions())
+        {
+            if (!fun.isDeclaration() || !fun.hasFnAttribute(llvm::Attribute::AllocKind) ||
+                    ExtFun2Annotations.count(fun.getName().str()))
+                continue;
+            const llvm::AllocFnKind kind = fun.getFnAttribute(llvm::Attribute::AllocKind).getAllocKind();
+            if ((kind & llvm::AllocFnKind::Realloc) != llvm::AllocFnKind::Unknown)
+                ExtFun2Annotations[fun.getName().str()].push_back("REALLOC_HEAP_RET");
+            else if ((kind & llvm::AllocFnKind::Alloc) != llvm::AllocFnKind::Unknown)
+                ExtFun2Annotations[fun.getName().str()].push_back("ALLOC_HEAP_RET");
+        }
+    }
+
     // Remove ExtAPI module from modules
     auto it = std::find_if(modules.begin(), modules.end(),
                            [&extModule](const std::reference_wrapper<llvm::Module>& moduleRef)
