#include <stdio.h>

#include <stdlib.h>

#include <string.h>

#include <sys/stat.h>

#include <unistd.h>

#include <errno.h>

int

main(int argc, char *argv[])

{

    // Check for unknown options and collect operands

    int optind = 1;

    int operands_start = -1;

    for (int i = 1; i < argc; i++) {

        if (strcmp(argv[i], "--") == 0) {

            operands_start = i + 1;

            break;

        } else if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {

            // Unknown option (starts with -, not --, not bare -)

            fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);

            return 1;

        }

    }

    if (operands_start == -1) {

        operands_start = 1;

    }

    if (argc <= operands_start) {

        fprintf(stderr, "new_mkdir: missing operand\n");

        return 1;

    }

    int success = 1;

    for (int i = operands_start; i < argc; i++) {

        char *path = argv[i];

        // Split path into parent and leaf

        char *last_slash = strrchr(path, '/');

        char *parent, *leaf;

        if (last_slash && last_slash != path) {

            // Parent path exists, e.g., "a/b"

            parent = strndup(path, last_slash - path);

            leaf = strdup(last_slash + 1);

        } else if (last_slash == path) {

            // Path is absolute root, e.g., "/b"

            parent = strdup("/");

            leaf = strdup(path + 1);

        } else {

            // No slash, parent is current directory

            parent = strdup(".");

            leaf = strdup(path);

        }

        if (!parent || !leaf) {

            fprintf(stderr, "new_mkdir: out of memory\n");

            exit(1);

        }

        struct stat st;

        // Check parent directory

        if (stat(parent, &st) != 0) {

            if (errno == ENOENT) {

                fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);

            } else {

                fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            }

            success = 0;

            free(parent);

            free(leaf);

            continue;

        }

        if (!S_ISDIR(st.st_mode)) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);

            success = 0;

            free(parent);

            free(leaf);

            continue;

        }

        // Check if leaf exists

        if (stat(path, &st) == 0) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);

            success = 0;

            free(parent);

            free(leaf);

            continue;

        } else if (errno != ENOENT) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            success = 0;

            free(parent);

            free(leaf);

            continue;

        }

        // Create directory

        if (mkdir(path, 0777) != 0) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            success = 0;

        }

        free(parent);

        free(leaf);

    }

    return success ? 0 : 1;

}

