```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libgen.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <errno.h>

int main(int argc, char *argv[]) {
    int start = 1;
    int i, operand_index;
    int failed = 0;

    // Handle options
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            start = i + 1;
            break;
        } else if (argv[i][0] == '-' && argv[i][1] != '\0') {
            // Invalid option (not -- or -)
            fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[i] + 1);
            exit(1);
        }
    }

    // Check for missing operands
    if (start >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    // Process each operand
    for (operand_index = start; operand_index < argc; operand_index++) {
        char *operand = argv[operand_index];
        if (*operand == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Invalid path\n", operand);
            failed = 1;
            continue;
        }

        char *path_copy1 = strdup(operand);
        if (!path_copy1) {
            perror("new_mkdir");
            exit(1);
        }
        char *parent_path = dirname(path_copy1);

        char *path_copy2 = strdup(operand);
        if (!path_copy2) {
            free(path_copy1);
            perror("new_mkdir");
            exit(1);
        }
        char *base_name = basename(path_copy2);

        struct stat st;

        // Check parent directory exists and is a directory
        if (stat(parent_path, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            free(path_copy1);
            free(path_copy2);
            failed = 1;
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", operand);
            free(path_copy1);
            free(path_copy2);
            failed = 1;
            continue;
        }

        // Check if the operand already exists
        if (stat(operand, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", operand);
            free(path_copy1);
            free(path_copy2);
            failed = 1;
            continue;
        }

        // Create the directory with mode 0777 (masked by umask)
        if (mkdir(operand, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            free(path_copy1);
            free(path_copy2);
            failed = 1;
            continue;
        }

        free(path_copy1);
        free(path_copy2);
    }

    return failed ? 1 : 0;
}
```

