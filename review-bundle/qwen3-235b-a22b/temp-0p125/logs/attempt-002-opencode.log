#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <errno.h>
#include <unistd.h>

int process_operand(char *path) {
    char *path_copy = strdup(path);
    if (!path_copy) {
        fprintf(stderr, "new_mkdir: memory allocation failed\n");
        return 1;
    }

    char *parent = path_copy;
    char *base = strrchr(parent, '/');
    if (base) {
        *base = '\0';
        base++;
        // Handle root case: if parent becomes empty string, set to "/"
        if (strlen(parent) == 0) {
            parent = "/";
        }
    } else {
        base = path_copy;
        parent = ".";
    }

    // Check parent exists and is a directory
    struct stat st;
    if (stat(parent, &st) != 0) {
        fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        free(path_copy);
        return 1;
    }
    if (!S_ISDIR(st.st_mode)) {
        fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
        free(path_copy);
        return 1;
    }

    // Check if the directory to create already exists
    if (lstat(path, &st) == 0) {
        fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
        free(path_copy);
        return 1;
    } else if (errno != ENOENT) {
        fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        free(path_copy);
        return 1;
    }

    // Create the directory
    if (mkdir(path, 0777) != 0) {
        fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        free(path_copy);
        return 1;
    }

    free(path_copy);
    return 0;
}

int main(int argc, char *argv[]) {
    // Check for no operands or unknown options
    int first_operand_index = 1;
    int i = 1;
    while (i < argc && argv[i][0] == '-') {
        if (argv[i][1] == '\0') {
            // "-" is a valid operand, stop processing options
            break;
        }
        if (strcmp(argv[i], "--") == 0) {
            i++;
            first_operand_index = i;
