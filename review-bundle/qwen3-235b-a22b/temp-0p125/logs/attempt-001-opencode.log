So:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    int operand_count = 0;
    char **operands = NULL;
    int after_end = 0;

    // Process arguments
    for (int i = 1; i < argc; i++) {
        if (after_end) {
            // Add to operands
            operands = realloc(operands, (operand_count + 1) * sizeof(char*));
            if (!operands) {
                fprintf(stderr, "new_mkdir: out of memory\n");
                exit(1);
            }
            operands[operand_count++] = argv[i];
        } else {
            if (strcmp(argv[i], "--") == 0) {
                after_end = 1;
            } else if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
                fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[i] + 1);
                exit(1);
            } else {
                operands = realloc(operands, (operand_count + 1) * sizeof(char*));
                if (!operands) {
                    fprintf(stderr, "new_mkdir: out of memory\n");
                    exit(1);
                }
                operands[operand_count++] = argv[i];
            }
        }
    }

    // Check for no operands
    if (operand_count == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    int error_count = 0;

    for (int i = 0; i < operand_count; i++) {
        char *path = operands[i];
        char *last_slash = strrchr(path, '/');
        char *parent;
        char *final;
        struct stat st;

        // Split path into parent and final
        if (last_slash != NULL) {
            parent = strndup(path, last_slash - path);
            final = strdup(last_slash + 1);
        } else {
            parent = strdup(".");
            final = strdup(path);
        }

        if (!parent || !final) {
            fprintf(stderr, "new_mkdir: out of memory\n");
            free(parent);
            free(final);
            error_count++;
            continue;
        }

        // Check parent directory exists and is a directory
        if (stat(parent, &st) != 0) {
            if (errno == ENOENT) {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);
            } else {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            }
            free(parent);
            free(final);
            error_count++;
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            free(parent);
            free(final);
            error_count++;
            continue;
        }

        // Check if the final component already exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            free(parent);
            free(final);
            error_count++;
            continue;
        }

        // Attempt to create the directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            free(parent);
            free(final);
            error_count++;
            continue;
        }

        free(parent);
        free(final);
    }

    free(operands);

