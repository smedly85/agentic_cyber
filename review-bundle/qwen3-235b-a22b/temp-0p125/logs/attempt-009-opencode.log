#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <limits.h>

int main(int argc, char *argv[]) {
    // Check for no operands
    int optind = 1;
    int end_of_options = 0;

    // Process options
    while (optind < argc && argv[optind][0] == '-' && !end_of_options) {
        if (strcmp(argv[optind], "--") == 0) {
            optind++;
            end_of_options = 1;
            break;
        }
        if (strcmp(argv[optind], "-") == 0) {
            // Bare '-' is an operand, not an option
            break;
        }
        // Invalid option (e.g., "-a")
        fprintf(stderr, "unknown option '%s'\n", argv[optind]);
        return 1;
    }

    if (!end_of_options) {
        // Check if we broke because of a bare '-', which is an operand
        while (optind < argc && argv[optind][0] == '-' && strcmp(argv[optind], "-") == 0) {
            // This is an operand, stop processing options
            break;
        }
    }

    // Now, operands start at optind
    if (optind >= argc) {
        fprintf(stderr, "missing operand\n");
        return 1;
    }

    int any_failure = 0;
    for (int i = optind; i < argc; i++) {
        char *path = argv[i];
        char parent[PATH_MAX];
        char *base;

        // Split path into parent and base
        char *last_slash = strrchr(path, '/');
        if (last_slash == path) {
            // Leading slash, parent is root '/'
            parent[0] = '/';
            parent[1] = '\0';
            base = path + 1;
        } else if (last_slash) {
            size_t len = last_slash - path;
            strncpy(parent, path, len);
            parent[len] = '\0';
            base = last_slash + 1;
        } else {
            // No slashes, use current directory as parent
            strcpy(parent, ".");
            base = path;
        }

        // If parent is empty string, use current directory.
        if (parent[0] == '\0') {
            strcpy(parent, ".");
        }

        // Check parent directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            // Parent directory doesn't exist or other error
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            // Parent is not a directory
            errno = ENOTDIR;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        // Check if base already exists
        if (stat(path, &st) == 0) {
            // Final component exists
            errno = EEXIST;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        } else if (errno != ENOENT) {
            // Some other error occurred during stat
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        // Create directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
        }
    }

    return any_failure ? 1 : 0;
}

