#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    int optind = 1;
    int end_of_options = 0;

    // Process options
    while (optind < argc && argv[optind][0] == '-' && !end_of_options) {
        if (strcmp(argv[optind], "--") == 0) {
            optind++;
            end_of_options = 1;
            break;
        }
        if (strcmp(argv[optind], "-") == 0) {
            // Bare '-' as operand
            break;
        }
        fprintf(stderr, "unknown option '%s'\n", argv[optind]);
        return 1;
    }

    if (optind >= argc) {
        fprintf(stderr, "missing operand\n");
        return 1;
    }

    int any_failure = 0;
    for (int i = optind; i < argc; i++) {
        char *path = argv[i];
        char parent[PATH_MAX];
        char *base;

        // Split path
        char *last_slash = strrchr(path, '/');
        if (last_slash == path) {
            parent[0] = '/';
            parent[1] = '\0';
            base = path + 1;
        } else if (last_slash) {
            size_t len = last_slash - path;
            strncpy(parent, path, len);
            parent[len] = '\0';
            base = last_slash + 1;
        } else {
            strcpy(parent, ".");
            base = path;
        }

        if (parent[0] == '\0') {
            strcpy(parent, ".");
        }

        struct stat st;
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            errno = ENOTDIR;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        if (stat(path, &st) == 0) {
            errno = EEXIST;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        } else if (errno != ENOENT) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            continue;
        }

        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
        }
    }

    return any_failure ? 1 : 0;
}

