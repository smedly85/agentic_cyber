            optind++;
            break;
        }
        fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[optind] + 1);
        return 1;
    }

    if (optind >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

