        char *path = argv[i];
        char *dir_copy = strdup(path);
        char *base_copy = strdup(path);
        if (!dir_copy || !base_copy) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            error_occurred = 1;
            free(dir_copy);
            free(base_copy);
            continue;
