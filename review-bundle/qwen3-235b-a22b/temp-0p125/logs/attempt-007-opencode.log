#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <libgen.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    // Process options
    int optind = 1;
    int error_occurred = 0;

    // Check for unknown options
    while (optind < argc && argv[optind][0] == '-') {
        if (argv[optind][1] == '\0') {
            // Single '-' is an operand, stop processing options
            break;
        }
        if (argv[optind][1] == '-' && argv[optind][2] == '\0') {
            // '--' found, skip and break
            optind++;
            break;
        }
        fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[optind] + 1);
        return 1;
    }

    if (optind >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    // Process each operand
    for (int i = optind; i < argc; i++) {
        char *path = argv[i];
        char *path_copy = strdup(path);
        if (!path_copy) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            error_occurred = 1;
            continue;
        }

        char *parent = dirname(path_copy);
        char *base = basename(strdup(path)); // Need to duplicate because basename may modify

        // Check parent exists and is directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            if (errno == ENOENT) {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);
            } else {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            }
            free(path_copy);
            free(base);
            error_occurred = 1;
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            free(path_copy);
            free(base);
            error_occurred = 1;
            continue;
        }

        // Check if base already exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            free(path_copy);
            free(base);
            error_occurred = 1;
            continue;
        }

        // Create directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            error_occurred = 1;
        }

        free(path_copy);
        free(base);
    }

    return error_occurred ? 1 : 0;
}

