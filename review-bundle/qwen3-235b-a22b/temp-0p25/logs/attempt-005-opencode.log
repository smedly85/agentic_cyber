        return 0;

    }

    char *parent = dirname(dname_copy);

    char *bname_copy = strdup(path);

    if (!bname_copy) {

        free(dname_copy);

        fprintf(stderr, "new_mkdir: out of memory\n");

        return 0;

    }

    char *final = basename(bname_copy);

    // Now check parent

    struct stat st;

    if (stat(parent, &st) != 0) {

        fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

        free(dname_copy);

        free(bname_copy);

        return 0;

    }

