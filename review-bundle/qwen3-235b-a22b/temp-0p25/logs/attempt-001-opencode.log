int main(int argc, char **argv) {
    int i = 1;
    int operand_start = 1;
    int found_dashdash = 0;

    // Check for unknown options before --
    for (; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            operand_start = i + 1;
            found_dashdash = 1;
            break;
        }
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[i] + 1);
            exit(1);
        }
    }

    // If -- was found, adjust i to operand_start
    // If not, operand_start remains 1

    int num_operands = argc - operand_start;
    if (num_operands <= 0 && !found_dashdash) {
        // Check if there are operands before --
        // Since no --, operand_start is still 1, but some args could be operands (not options)
        // But the loop would have allowed "-" as operand.
        // Actually, num_operands = argc - 1.
        // Wait, operand_start is 1 if no --.
        // So num_operands = argc - 1.
        // So if argc - 1 <=0 → argc <=1 → no operands.
        if (argc <= 1) {
            fprintf(stderr, "new_mkdir: missing operand\n");
            exit(1);
        }
    } else if (num_operands <= 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    int success = 1;
    char *operand;

    for (i = operand_start; i < argc; i++) {
        operand = argv[i];

        // Split into parent and leaf
        char *last_slash = strrchr(operand, '/');
        char *parent;
        char *leaf;

        if (last_slash != NULL) {
            if (last_slash == operand) {
                // Path starts with '/', e.g., "/dir"
                parent = strdup("/");
                if (!parent) {
                    fprintf(stderr, "new_mkdir: memory allocation failed\n");
                    exit(1);
                }
                leaf = operand + 1;
            } else {
                // Split at last '/'
                size_t parent_len = last_slash - operand;
                parent = strndup(operand, parent_len);
                if (!parent) {
                    fprintf(stderr, "new_mkdir: memory allocation failed\n");
                    exit(1);
                }
                leaf = last_slash + 1;
            }
        } else {
            // No slashes
            parent = strdup(".");
            if (!parent) {
                fprintf(stderr, "new_mkdir: memory allocation failed\n");
                exit(1);
            }
            leaf = operand;
        }

        struct stat st;

        // Check parent exists and is directory
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            free(parent);
            success = 0;
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", operand);
            free(parent);
            success = 0;
            continue;
        }

        // Check if the directory to be created already exists
        if (stat(operand, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", operand);
            free(parent);
            success = 0;
            continue;
        }

        // Try creating the directory
        if (mkdir(operand, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            free(parent);
            success = 0;
            continue;
        }

        free(parent);
    }

    return success ? 0 : 1;
}

