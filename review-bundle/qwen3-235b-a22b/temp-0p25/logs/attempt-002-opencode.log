                snprintf(parent_path, sizeof(parent_path), "/");
            } else {
                snprintf(parent_path, sizeof(parent_path), "%s", trimmed);
            }
        } else {
            // No slash found: parent is current directory
            snprintf(parent_path, sizeof(parent_path), ".");
            final_component = trimmed;
        }

        struct stat st;
        // Check if parent exists and is a directory
        if (stat(parent_path, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
            free(trimmed);
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n");
            all_success = 0;
            free(trimmed);
            continue;
        }

        // Check if final component exists
        char full_path[4096];
        snprintf(full_path, sizeof(full_path), "%s/%s", parent_path, final_component);
        if (stat(full_path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n");
            all_success = 0;
            free(trimmed);
            continue;
        }

        // Create the directory
        errno = 0; // Clear errno before mkdir
        if (mkdir(full_path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
            free(trimmed);
            continue;
        }

        free(trimmed);
    }

    return all_success ? 0 : 1;
}

