    }

    int all_success = 1;
    for (int i = start; i < argc; i++) {
        char *path = argv[i];
        // Trim trailing slashes
        size_t len = strlen(path);
        while (len > 0 && path[len - 1] == '/') {
            len--;
        }
        if (len == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Invalid argument\n", path);
            all_success = 0;
            continue;
        }
        char *trimmed = strndup(path, len);
        if (!trimmed) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            exit(1);
        }

        // Find the last slash in trimmed
        char *last_slash = strrchr(trimmed, '/');
        char parent_path[4096];
        char *final_component;

        if (last_slash) {
            *last_slash = '\0';  // Terminate parent path
            final_component = last_slash + 1;
