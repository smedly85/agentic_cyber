The C code:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <errno.h>

int main(int argc, char *argv[]) {
    // Check for invalid options before '--'
    int i;
    int operands_start = 1;

    // Process until '--' is found or end of args
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            break;
        }
        // If it starts with '-' and is not "-", it's an invalid option
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);
            return 1;
        }
    }

    // If '--' found, set operands_start to after it
    if (i < argc && strcmp(argv[i], "--") == 0) {
        operands_start = i + 1;
    } else {
        operands_start = 1;
    }

    // Check if there are any operands
    if (operands_start >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    int any_failed = 0;

    // Process each operand
    for (i = operands_start; i < argc; i++) {
        char *path = argv[i];
        char *last_slash = strrchr(path, '/');
        char *parent;
        char *base;
        char *parent_dup = NULL;

        // Split into parent and base
        if (last_slash != NULL) {
            // There is a slash in the path
            parent_dup = strndup(path, last_slash - path);
            if (parent_dup == NULL) {
                fprintf(stderr, "new_mkdir: memory allocation failed\n");
                any_failed = 1;
                continue;
            }
            parent = parent_dup;
            base = last_slash + 1;
        } else {
            // No slash in path
            parent = ".";
            base = path;
        }

        struct stat sb;

