    while (i < argc) {
        operands[op_count++] = argv[i++];
    }

    // Operands before --
    if (!after_dd) {
        for (int j = 1; j < i; j++) {
            if (argv[j][0] != '-' || strcmp(argv[j], "-") == 0) {
                operands[op_count++] = argv[j];
            }
        }
