#define MAX_OPERANDS 1000

int main(int argc, char *argv[]) {
    int i = 1;
    int after_dd = 0;

    // Check for unknown options before --
    while (i < argc) {
        if (strcmp(argv[i], "--") == 0) {
            after_dd = 1;
            i++;
            break;
        }
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
