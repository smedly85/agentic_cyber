#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <limits.h>

int main(int argc, char *argv[]) {
    // Skip program name
    int i = 1;
    int end_of_options = 0;
    char **operands = NULL;
    int num_operands = 0;
    int had_error = 0;

    // Check for -- and unknown options
    for (; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            end_of_options = 1;
            continue;
        }
        if (!end_of_options && argv[i][0] == '-' && argv[i][1] != '\0') {
            // It's an option, but check if it's a single '-'
            if (strcmp(argv[i], "-") != 0) {
                fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", argv[i]);
                return 1;
            }
        }
        // Collect operands
        operands = realloc(operands, (num_operands + 1) * sizeof(char*));
        if (!operands) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            return 1;
        }
        operands[num_operands++] = argv[i];
    }

    if (num_operands == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        free(operands);
        return 1;
    }

    for (int j = 0; j < num_operands; j++) {
        char *path = operands[j];
        char parent[PATH_MAX];
        char base[PATH_MAX];
        char *last_slash = strrchr(path, '/');

        if (last_slash != NULL) {
            if (last_slash == path) {
                // Path starts with '/', so parent is root dir
                strcpy(parent, "/");
                strcpy(base, last_slash + 1);
            } else {
                size_t len = last_slash - path;
                strncpy(parent, path, len);
                parent[len] = '\0';
                strcpy(base, last_slash + 1);
            }
        } else {
            strcpy(parent, ".");
            strcpy(base, path);
        }

        // Check if base is empty
        if (base[0] == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);
            had_error = 1;
            continue;
        }

        // Check parent directory exists and is a directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            had_error = 1;
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            had_error = 1;
            continue;
        }

        // Check if the directory to create already exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            had_error = 1;
            continue;
        }

        // Create the directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            had_error = 1;
        }
    }

    free(operands);
    return had_error ? 1 : 0;
}

