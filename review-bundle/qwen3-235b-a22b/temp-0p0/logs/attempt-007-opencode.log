int main(int argc, char *argv[]) {
    // Parse arguments
    // First, check for -- to mark end of options.

    int i = 1;
    int end_of_options = 0;
    char **operands = malloc(argc * sizeof(char*));
    int num_operands = 0;
    int had_error = 0;

    for (i=1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            end_of_options = 1;
            continue;
        }
        if (!end_of_options && argv[i][0] == '-' && argv[i][1] != '\0') {
            // it's an option, but no options allowed except --.
            // unless it's exactly "-", which is allowed as operand.
            if (strcmp(argv[i], "-") != 0) {
                fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", argv[i]);
                free(operands);
                return 1;
            }
        }
        // If we're past -- or it's not an option, treat as operand.
        if (end_of_options || (argv[i][0] != '-' || strcmp(argv[i], "-") == 0)) {
            operands[num_operands++] = argv[i];
        }
    }

    if (num_operands == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        free(operands);
        return 1;
    }

    // Now process each operand
    for (int j=0; j < num_operands; j++) {
        char *path = operands[j];
        // Split into parent and base
        char *last_slash = strrchr(path, '/');
        char parent[PATH_MAX];
        char base[PATH_MAX];

        if (last_slash != NULL) {
            // Found a slash
            if (last_slash == path) {
                // Path starts with /, so parent is root '/'
                strcpy(parent, "/");
                strcpy(base, last_slash + 1);
            } else {
                strncpy(parent, path, last_slash - path);
                parent[last_slash - path] = '\0';
                strcpy(base, last_slash + 1);
            }
        } else {
            strcpy(parent, ".");
            strcpy(base, path);
        }

        // Check if base is empty
        if (base[0] == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);
            had_error = 1;
            continue;
        }

        // Check parent exists and is directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            had_error = 1;
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            had_error = 1;
            continue;
        }

        // Check if base exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            had_error = 1;
            continue;
        }

        // Create the directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            had_error = 1;
        }
    }

    free(operands);
    return had_error ? 1 : 0;
}

