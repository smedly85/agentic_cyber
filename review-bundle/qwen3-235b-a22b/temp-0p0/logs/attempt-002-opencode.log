#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libgen.h>
#include <sys/stat.h>
#include <errno.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    // Process arguments to collect operands and reject unknown options.
    int operand_count = 0;
    char *operands[512];  // Allow up to 512 operands.

    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-') {
            if (argv[i][1] == '\0') {
                // Bare '-' as operand.
                operands[operand_count++] = argv[i];
            } else if (strcmp(argv[i], "--") == 0) {
                // End of options; remaining args are operands.
                for (int j = i + 1; j < argc; j++) {
                    operands[operand_count++] = argv[j];
                }
                break;
            } else {
                // Unrecognized option.
                fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", argv[i]);
                return 1;
            }
        } else {
            operands[operand_count++] = argv[i];
        }
    }

    if (operand_count == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    int errors = 0;

    for (int i = 0; i < operand_count; i++) {
        char *operand = operands[i];

        // Skip empty operand check.

        // Duplicate operand for dirname.
        char *path_dup = strdup(operand);
        if (!path_dup) {
            perror("new_mkdir");
            exit(1);
        }
        char *parent = dirname(path_dup);

        // Duplicate operand for basename.
        char *base_dup = strdup(operand);
        if (!base_dup) {
            perror("new_mkdir");
            free(path_dup);
            exit(1);
        }
        char *base = basename(base_dup);

        // Check for empty base name.
        if (base[0] == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Invalid operand\n", operand);
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Check parent directory.
        struct stat sb;
        if (stat(parent, &sb) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }
        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", operand);
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Construct full path: parent + '/' + base.
        char *full_path = malloc(strlen(parent) + strlen(base) + 2);
        if (!full_path) {
            perror("new_mkdir");
            free(path_dup);
            free(base_dup);
            return 1;
        }
        strcpy(full_path, parent);
        strcat(full_path, "/");
        strcat(full_path, base);

        // Check if the final component already exists.
        struct stat sb2;
        if (stat(full_path, &sb2) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", operand);
            errors++;
            free(full_path);
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Attempt to create the directory.
        if (mkdir(full_path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            errors++;
            free(full_path);
            free(path_dup);
            free(base_dup);
            continue;
        }

        free(full_path);
        free(path_dup);
        free(base_dup);
    }

    return errors ? 1 : 0;
}

