        char *operand = operands[i];

        // Handle empty operand string
        if (operand[0] == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '': Invalid argument\n");
            errors++;
            continue;
        }

        // Duplicate operand for dirname (modifies its argument)
        char *path_dup = strdup(operand);
        if (!path_dup) {
            perror("strdup");
            return 1;
        }
        char *parent = dirname(path_dup);

        char *base_dup = strdup(operand);
        if (!base_dup) {
            perror("strdup");
            free(path_dup);
            return 1;
        }
        char *base = basename(base_dup);
        if (base[0] == '\0') {
            fprintf(stderr, "new_mkdir: invalid operand '%s'\n", operand);
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Check parent directory exists and is a directory
        struct stat sb;
        if (stat(parent, &sb) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }
        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", operand);
            errors++;
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Check if the directory to be created already exists
        char *full_path = malloc(strlen(parent) + strlen(base) + 2);
        if (!full_path) {
            perror("malloc");
            free(path_dup);
            free(base_dup);
            return 1;
        }
        strcpy(full_path, parent);
        strcat(full_path, "/");
        strcat(full_path, base);

        struct stat sb2;
        if (stat(full_path, &sb2) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", operand);
            errors++;
            free(full_path);
            free(path_dup);
            free(base_dup);
            continue;
        }

        // Create the directory
        if (mkdir(full_path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            errors++;
            free(full_path);
            free(path_dup);
            free(base_dup);
            continue;
        }

        free(full_path);
        free(path_dup);
        free(base_dup);
    }

    return errors ? 1 : 0;
}

