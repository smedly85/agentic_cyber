int main(int argc, char *argv[]) {

    // Check for invalid options

    for (int i = 1; i < argc; i++) {

        if (argv[i][0] == '-') {

            if (strcmp(argv[i], "--") == 0) {

                // Valid, will handle later

                continue;

            } else if (strlen(argv[i]) == 1) { // "-"

                // Valid operand

                continue;

            } else {

                fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);

                exit(1);

            }

        }

    }

    // Check for missing operands

    int operands_start = 1;

    for (int i = 1; i < argc; i++) {

        if (strcmp(argv[i], "--") == 0) {

            operands_start = i + 1;

            break;

        }

    }

    if (operands_start >= argc) {

        fprintf(stderr, "new_mkdir: missing operand\n");

        exit(1);

    }

    // Process operands

    int failures = 0;

    for (int i = operands_start; i < argc; i++) {

        char *path = argv[i];

        // Split into parent and leaf

        char *last_slash = strrchr(path, '/');

        char *parent;

        char *leaf;

        if (last_slash == NULL) {

            parent = ".";

            leaf = path;

        } else {

            size_t parent_len = last_slash - path;

            parent = strndup(path, parent_len);

            if (parent == NULL) {

                fprintf(stderr, "new_mkdir: memory allocation failed\n");

                exit(1);

            }

            leaf = last_slash + 1;

        }

        // Check parent

        struct stat sb;

        if (stat(parent, &sb) != 0) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            failures++;

            if (parent != ".") free(parent);

            continue;

        }

        if (!S_ISDIR(sb.st_mode)) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);

            failures++;

            if (parent != ".") free(parent);

            continue;

        }

        // Check if leaf exists

        char *full_path = parent == "." ? leaf : path; // Need to construct full path for stat

        // Wait, if parent is not ".", we have a path like "a/b", parent is "a", leaf is "b"

        // So full path is parent + "/" + leaf

        // But original path is correct.

        struct stat leaf_sb;

        if (stat(path, &leaf_sb) == 0) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);

            failures++;

            if (parent != ".") free(parent);

            continue;

        } else if (errno != ENOENT) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            failures++;

            if (parent != ".") free(parent);

            continue;

        }

        // Create directory

        if (mkdir(path, 0777) != 0) {

            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));

            failures++;

        }

        if (parent != ".") free(parent);

    }

    return failures ? 1 : 0;

}

