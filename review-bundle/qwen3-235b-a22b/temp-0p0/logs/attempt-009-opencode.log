int main(int argc, char **argv) {
    int i = 1;
    int opt_index = 1;
    int no_operands = 1; // assume no, until found

    // Check for invalid options before --
    while (i < argc && strcmp(argv[i], "--") != 0) {
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);
            return 1;
        }
        i++;
        opt_index++;
    }

    if (i < argc && strcmp(argv[i], "--") == 0) {
        i++; // skip --
    }

    if (i >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    int success = 1;
    for (int j = i; j < argc; j++) {
        char *path = argv[j];
        struct stat sb;

        // Split path into parent and final component
        char *last_slash = strrchr(path, '/');
        char parent[PATH_MAX];
        char *final;

        if (last_slash == NULL) {
            // No slashes, parent is current directory
            strcpy(parent, ".");
            final = path;
        } else {
            // Copy up to last slash to parent
            size_t len = last_slash - path;
            if (len >= PATH_MAX) len = PATH_MAX - 1;
            strncpy(parent, path, len);
            parent[len] = '\0';
            final = last_slash + 1;
        }

        // Check if parent exists and is a directory
        if (strlen(parent) == 0) { // case when path starts with '/', like "/x"
            strcpy(parent, "/");
        }

        if (stat(parent, &sb) == -1) {
            if (errno == ENOENT) {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", path);
            } else {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            }
            success = 0;
            continue;
        }

        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            success = 0;
            continue;
        }

        // Check if the final component (whole path) exists
        if (stat(path, &sb) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            success = 0;
            continue;
        } else if (errno != ENOENT) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
            continue;
        }

        // Create the directory
        if (mkdir(path, 0777) == -1) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
            continue;
        }
    }

    return success ? 0 : 1;
}

