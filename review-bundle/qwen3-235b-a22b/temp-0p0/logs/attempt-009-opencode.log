int main(int argc, char **argv) {
    int i = 1;
    int operands_start = 1;

    // Process options until '--' or end
    while (i < argc && strcmp(argv[i], "--") != 0) {
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);
            return 1;
        }
        i++;
    }

    if (i < argc && strcmp(argv[i], "--") == 0) {
        i++; // skip '--'
    }

    if (i >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    operands_start = i;
    int success = 1;

    for (int j = operands_start; j < argc; j++) {
        char *path = argv[j];
        struct stat sb;

        // Split into parent and final component
        char fullpath[PATH_MAX];
        if (strnlen(path, PATH_MAX) >= PATH_MAX - 1) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Path too long\n", path);
            success = 0;
            continue;
        }
        strncpy(fullpath, path, PATH_MAX);
        fullpath[PATH_MAX - 1] = '\0';

        char *last_slash = strrchr(fullpath, '/');
        char parent[PATH_MAX];
        char *final;

        if (last_slash == NULL) {
            // No slashes, use current directory as parent
            strcpy(parent, ".");
            final = fullpath;
        } else {
            // Split the path
            *last_slash = '\0';
            strcpy(parent, fullpath);
            final = last_slash + 1;

            // Case of absolute path starting with '/', e.g., "/foo"
            if (strlen(parent) == 0) {
                strcpy(parent, "/");
            }
        }

        // 1. Check parent exists and is directory
        if (stat(parent, &sb) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
            continue;
        }

        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            success = 0;
            continue;
        }

        // 2. Check if final component exists
        if (stat(path, &sb) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", path);
            success = 0;
            continue;
        } else if (errno != ENOENT) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
            continue;
        }

        // 3. Create directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
            continue;
        }
    }

    return success ? 0 : 1;
}

