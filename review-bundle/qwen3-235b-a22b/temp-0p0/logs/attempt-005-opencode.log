Revised code outline:

int main(int argc, char **argv) {
    // Check invalid options, determine start index as before.

    if (no operands) { ... }

    int error_count = 0;

    for each operand from start to end:

        char *op = argv[i];
        char *path = strdup(op);
        if (!path) {
            fprintf(stderr, "mkdir: Memory allocation failed\n");
            return 1;
        }

        // Split path into parent and dir_name
        char *last_slash = strrchr(path, '/');
        char *parent;
        char *dir_name;

        if (last_slash) {
            *last_slash = '\0';
            parent = path;
            dir_name = last_slash + 1;
        } else {
            parent = ".";
            dir_name = path;
        }

        // Check parent exists and is dir
        struct stat sb;
        if (stat(parent, &sb) != 0) {
            // report error using strerror(errno)
            free(path);
            error_count++;
            continue;
        }
        if (!S_ISDIR(sb.st_mode)) {
            errno = ENOTDIR;
            // report
            free(path);
            error_count++;
            continue;
        }

        // Check component doesn't exist
        char *fullpath;
        if (strcmp(parent, ".") == 0) {
            fullpath = strdup(dir_name);
        } else {
            // allocate for parent + '/' + dir_name + '\0'
            fullpath = malloc(strlen(parent) + strlen(dir_name) + 2);
            if (!fullpath) {
                free(path);
                fprintf(stderr, "mkdir: Memory allocation failed\n");
                return 1;
            }
            sprintf(fullpath, "%s/%s", parent, dir_name);
        }
        if (!fullpath) {
            // Handle error, but should have been caught.
        }

        if (stat(fullpath, &sb) == 0) {
            errno = EEXIST;
            fprintf(stderr, ...);
            free(fullpath);
            free(path);
            error_count++;
            continue;
        } else if (errno != ENOENT) {
            // report error
            free(fullpath);
            free(path);
            error_count++;
            continue;
        }

        if (mkdir(fullpath, 0777) != 0) {
            fprintf(stderr, ...);
            free(fullpath);
            free(path);
            error_count++;
            continue;
        }

        free(fullpath);
        free(path);
    }

    return error_count ? 1 : 0;
}

