#include <stdio.h>

#include <stdlib.h>

#include <string.h>

#include <libgen.h>

#include <sys/stat.h>

#include <errno.h>

#include <unistd.h>

#define PROGRAM_NAME "new_mkdir"

int main(int argc, char *argv[]) {

   // Handle no operands or unknown options

   if (argc < 2) {

      fprintf(stderr, "%s: missing operand\n", PROGRAM_NAME);

      return 1;

   }

   int operand_start = 1;

   int i;

   for (i = 1; i < argc; i++) {

      if (strcmp(argv[i], "--") == 0) {

         operand_start = i + 1;

         break;

      } else if (argv[i][0] == '-' && argv[i][1] != '\0') { // starts with - but more than one character

         // unless it's a bare '-'

         if (strcmp(argv[i], "-") == 0) {

            continue; // valid operand

         } else {

            fprintf(stderr, "%s: invalid option -- '%s'\n", PROGRAM_NAME, argv[i] + 1);

            return 1;

         }

      } else {

         break; // operands start here

      }

   }

   // If all args processed and no operands

   if (operand_start >= argc) {

      fprintf(stderr, "%s: missing operand\n", PROGRAM_NAME);

      return 1;

   }

   int success = 1;

   for (i = operand_start; i < argc; i++) {

      char *path = argv[i];

      // Split into parent and child

      char *dir_copy = strdup(path);

      if (!dir_copy) {

         fprintf(stderr, "%s: memory allocation failed\n", PROGRAM_NAME);

         success = 0;

         continue;

      }

      char *parent = dirname(dir_copy);

      char *base_copy = strdup(path);

      if (!base_copy) {

         free(dir_copy);

         fprintf(stderr, "%s: memory allocation failed\n", PROGRAM_NAME);

         success = 0;

         continue;

      }

      char *child = basename(base_copy);

      struct stat st;

      // Check parent exists and is directory

      if (stat(parent, &st) != 0) {

         fprintf(stderr, "%s: cannot create directory '%s': %s\n", PROGRAM_NAME, path, strerror(errno));

         success = 0;

      } else if (!S_ISDIR(st.st_mode)) {

         fprintf(stderr, "%s: cannot create directory '%s': Not a directory\n", PROGRAM_NAME, path);

         success = 0;

      } else {

         // Check child doesn't exist

         if (stat(path, &st) == 0) {

            fprintf(stderr, "%s: cannot create directory '%s': File exists\n", PROGRAM_NAME, path);

            success = 0;

         } else if (errno != ENOENT) {

            fprintf(stderr, "%s: cannot create directory '%s': %s\n", PROGRAM_NAME, path, strerror(errno));

            success = 0;

         } else {

            // Create the directory

            if (mkdir(path, 0777) != 0) {

               fprintf(stderr, "%s: cannot create directory '%s': %s\n", PROGRAM_NAME, path, strerror(errno));

               success = 0;

            }

         }

      }

      free(dir_copy);

      free(base_copy);

   }

   return success ? 0 : 1;

}

