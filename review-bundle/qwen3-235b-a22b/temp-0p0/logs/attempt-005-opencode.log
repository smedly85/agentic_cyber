int main(int argc, char **argv) {
    // Check for invalid options
    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-') {
            if (strcmp(argv[i], "-") != 0 && strcmp(argv[i], "--") != 0) {
                fprintf(stderr, "mkdir: invalid option -- '%s'\n", argv[i]);
                return 1;
            }
        }
    }

    // Determine operand start index
    int start = 1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            start = i + 1;
            break;
        }
    }

    if (argc - start == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    int error_count = 0;

    for (int i = start; i < argc; i++) {
        char *operand = argv[i];
        char path[4096];
        strncpy(path, operand, sizeof(path));
        path[sizeof(path) - 1] = '\0';

        // Find parent directory
        char *last_slash = strrchr(path, '/');
        char *parent_dir;
        char *dir_name;

        if (last_slash == NULL) {
            parent_dir = ".";
            dir_name = path;
        } else {
            *last_slash = '\0';
            parent_dir = path;
            dir_name = last_slash + 1;
        }

        // Check if parent directory exists and is a directory
        struct stat sb;
        if (stat(parent_dir, &sb) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            error_count++;
            continue;
        } else if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "mkdir: cannot create directory '%s': Not a directory\n", operand);
            error_count++;
            continue;
        }

        // Check if the directory to create already exists
        char fullpath[4096];
        snprintf(fullpath, sizeof(fullpath), "%s/%s", parent_dir, dir_name);
        if (stat(fullpath, &sb) == 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", operand);
            error_count++;
            continue;
        } else if (errno != ENOENT) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            error_count++;
            continue;
        }

        // Create the directory
        if (mkdir(fullpath, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            error_count++;
        }
    }

    return (error_count > 0) ? 1 : 0;
}

