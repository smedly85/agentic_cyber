int main(int argc, char *argv[]) {
    int optind = 1;
    int invalid_option = 0;
    int i;

    // Process arguments before '--'
    while (optind < argc && strcmp(argv[optind], "--") != 0) {
        if (argv[optind][0] == '-' && strcmp(argv[optind], "-") != 0) {
            fprintf(stderr, "mkdir: invalid option '%s'\n", argv[optind]);
            return 1;
        }
        optind++;
    }

    // Skip '--'
    if (optind < argc && strcmp(argv[optind], "--") == 0) {
        optind++;
    }

    // Check for operands
    if (optind >= argc) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    int failure_count = 0;
    for (i = optind; i < argc; i++) {
        const char *path = argv[i];
        char *path_dup1 = strdup(path);
        char *path_dup2 = strdup(path);
        if (!path_dup1 || !path_dup2) {
            fprintf(stderr, "mkdir: memory allocation failed\n");
            free(path_dup1);
            free(path_dup2);
            failure_count++;
            continue;
        }

        char *parent = dirname(path_dup1);
        struct stat st;
        int error = 0;

        // Check parent directory exists and is a directory
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            error = 1;
        } else if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "mkdir: cannot create directory '%s': Not a directory\n", path);
            error = 1;
        }

        // Check if path already exists
        if (!error && stat(path, &st) == 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", path);
            error = 1;
        } else if (!error && errno != ENOENT) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            error = 1;
        }

        free(path_dup1);
        free(path_dup2);

        // Attempt to create directory if no errors so far
        if (!error) {
            if (mkdir(path, 0777) != 0) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
                error = 1;
            }
        }

        if (error) {
            failure_count++;
        }
    }

    return failure_count > 0 ? 1 : 0;
}

