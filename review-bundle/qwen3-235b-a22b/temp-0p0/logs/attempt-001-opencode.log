        fprintf(stderr, "missing operand\n");
        return 1;
    }
    // Check for options: any arg starting with '-' except "--" or "-"
    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-') {
            if (argv[i][1] == '\0') {
                // operand is a single '-', allowed as directory name
                continue;
            }
            if (argv[i][1] == '-' && argv[i][2] == '\0') {
                // "--", end of options
                start = i + 1;
                break;
            }
            // unknown option
            fprintf(stderr, "unknown option: %s\n", argv[i]);
            return 1;
        }
    }
    // Now process operands from start to argc-1
    int success = 1;
    for (int i = start; i < argc; i++) {
        char *path = argv[i];
        // Split into parent and final
        char *last_slash = strrchr(path, '/');
        char *parent, *final;
        if (last_slash == path) { // starts with /
            parent = "/";
            final = path + 1;
        } else if (last_slash) {
            parent = strndup(path, last_slash - path);
            final = last_slash + 1;
        } else {
            parent = ".";
            final = path;
        }
        // Check parent exists and is dir
        struct stat st;
        if (stat(parent, &st) != 0) {
            perror("cannot create directory");
            success = 0;
            continue;
        }
