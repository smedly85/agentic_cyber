#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <errno.h>

int main(int argc, char *argv[]) {
    // Check for unknown options
    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-') {
            if (argv[i][1] == '\0') {
                // Valid operand '-'
                continue;
            }
            if (argv[i][1] == '-' && argv[i][2] == '\0') {
                // End of options
                break;
            }
            fprintf(stderr, "mkdir: unknown option '%s'\n", argv[i]);
            return 1;
        }
    }

    // Determine start of operands
    int start = 1;
    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-' && argv[i][1] == '-' && argv[i][2] == '\0') {
            start = i + 1;
            break;
        }
    }

    // Check for missing operands
    if (argc <= start) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    int all_success = 1;

    for (int i = start; i < argc; i++) {
        char *path = argv[i];
        char *slash = strrchr(path, '/');
        char *parent = NULL;
        char *final = path;

        if (slash) {
            if (slash == path) {
                parent = "/";
                final = path + 1;
            } else {
                parent = strndup(path, slash - path);
                final = slash + 1;
            }
        } else {
            parent = ".";
        }

        // Check parent exists and is directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
            goto cleanup;
        }

        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(ENOTDIR));
            all_success = 0;
            goto cleanup;
        }

        // Check if final component exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(EEXIST));
            all_success = 0;
            goto cleanup;
        }

        // Create the directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
            goto cleanup;
        }

    cleanup:
        if (parent && parent != "/" && parent != ".") {
            free(parent);
        }
    }

    return all_success ? 0 : 1;
}

