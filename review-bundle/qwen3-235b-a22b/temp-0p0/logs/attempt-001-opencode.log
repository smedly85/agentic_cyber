            fprintf(stderr, "directory already exists\n");
            success = 0;
            continue;
        }
        // Create directory
        if (mkdir(path, 0777) != 0) {
            perror("cannot create directory");
            success = 0;
        }
    }
    return success ? 0 : 1;
}

