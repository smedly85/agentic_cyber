int main(int argc, char *argv[]) {
    bool saw_double_dash = false;
    int i = 1;
    int operand_count = 0;
    char **operands = NULL;
    int error_occurred = 0;

    // Check for invalid options and collect operands
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            saw_double_dash = true;
            break;
        }
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_mkdir: invalid option -- '%s'\n", argv[i] + 1);
            exit(1);
        }
    }

    // If we broke from the loop on --, skip it and set start of operands
    if (saw_double_dash) {
        i++; // move past --
        operand_count = argc - i;
        operands = &argv[i];
    } else {
        operand_count = argc - 1;
        operands = &argv[1];
    }

    // Check for missing operands
    if (operand_count == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    // Process each operand
    for (int j = 0; j < operand_count; j++) {
        char *operand = operands[j];
        char *parent;
        char *base;

        // Split operand into parent and base
        const char *last_slash = strrchr(operand, '/');
        if (last_slash == operand) { // absolute path like /a
            parent = strdup("/");
            base = strdup(last_slash + 1);
        } else if (last_slash != NULL) {
            parent = strndup(operand, last_slash - operand);
            base = strdup(last_slash + 1);
        } else {
            parent = strdup(".");
            base = strdup(operand);
        }

        // Check allocations
        if (!parent || !base) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            exit(1);
        }

        // Check parent directory exists and is a directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            // Parent doesn't exist: ENOENT
            fprintf(stderr, "new_mkdir: cannot create directory '%s': No such file or directory\n", operand);
            error_occurred = 1;
            free(parent);
            free(base);
            continue;
        }

        if (!S_ISDIR(st.st_mode)) {
            // Parent exists but is not a directory: ENOTDIR
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", operand);
            error_occurred = 1;
            free(parent);
            free(base);
            continue;
        }

        // Check if operand already exists
        if (stat(operand, &st) == 0) {
            // Operand exists: EEXIST
            fprintf(stderr, "new_mkdir: cannot create directory '%s': File exists\n", operand);
            error_occurred = 1;
            free(parent);
            free(base);
            continue;
        }

        // Create the directory
        if (mkdir(operand, 0777) != 0) {
            // Handle mkdir error
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", operand, strerror(errno));
            error_occurred = 1;
        }

        free(parent);
        free(base);
    }

    return error_occurred ? 1 : 0;
}

