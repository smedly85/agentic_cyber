int main(int argc, char *argv[]) {
    // Skip argv[0] (program name)
    // Handle options: look for "--" and unknown options.
    int optind = 1;
    while (optind < argc && argv[optind][0] == '-') {
        if (argv[optind][1] == '\0') {
            // Bare "-" is an operand, not an option. So break.
            break;
        } else if (argv[optind][1] == '-' && argv[optind][2] == '\0') {
            // "--" found, stop processing options.
            optind++;
            break;
        } else {
            // Unknown option.
            fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[optind]);
            exit(1);
        }
    }

    // Now, operands are from optind to argc-1.
    if (argc - optind < 1) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    int success = 1;
    for (int i = optind; i < argc; i++) {
        char *path = argv[i];
        // Split into dir and base.
        char *last_slash = strrchr(path, '/');
        char *dir, *base;
        if (last_slash != NULL && last_slash != path) {
            // Found a slash, not at the beginning.
            dir = strndup(path, last_slash - path);
            base = last_slash + 1;
        } else {
            // No slash, or path is "/".
            dir = strdup(".");
            base = path;
        }
        // Check dir exists and is a directory.
        struct stat st;
        if (stat(dir, &st) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            success = 0;
        } else if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': not a directory\n", path);
            success = 0;
        } else {
            // Check if base exists.
            char *full_path = malloc(strlen(dir) + 1 + strlen(base) + 1);
            if (full_path == NULL) {
                fprintf(stderr, "new_mkdir: out of memory\n");
                exit(1);
            }
            sprintf(full_path, "%s/%s", dir, base);
            if (stat(full_path, &st) == 0) {
                fprintf(stderr, "new_mkdir: cannot create directory '%s': file exists\n", path);
                success = 0;
            } else {
                // Try to create the directory.
                if (mkdir(full_path, 0777) != 0) {
                    fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
                    success = 0;
                }
            }
            free(full_path);
        }
        free(dir);
    }

    return success ? 0 : 1;
}

