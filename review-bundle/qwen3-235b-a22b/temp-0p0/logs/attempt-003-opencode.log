#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

int main(int argc, char *argv[]) {
    // Option parsing
    int i = 1;
    while (i < argc) {
        if (argv[i][0] != '-') {
            break; // Operands start
        }
        if (argv[i][1] == '\0') {
            // Bare '-' is an operand
            break;
        }
        if (argv[i][1] == '-' && argv[i][2] == '\0') {
            // "--" found, skip and break
            i++;
            break;
        }
        // Any other option starting with '-' is invalid
        fprintf(stderr, "new_mkdir: invalid option '%s'\n", argv[i]);
        exit(1);
    }

    // Now, operands start at i
    if (i >= argc) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        exit(1);
    }

    int all_success = 1;

    for (int j = i; j < argc; j++) {
        char *path = argv[j];
        // Split into dir and base
        char *last_slash = strrchr(path, '/');
        char *dir, *base;
        if (last_slash == NULL) {
            // No slashes
            dir = ".";
            base = path;
        } else {
            if (last_slash == path) {
                // Path starts with '/', so dir is "/"
                dir = "/";
            } else {
                // Allocate dir as the part before the slash
                dir = strndup(path, last_slash - path);
                if (dir == NULL) {
                    fprintf(stderr, "new_mkdir: out of memory\n");
                    exit(1);
                }
            }
            base = last_slash + 1;
        }

        // Check base is not empty
        if (base[0] == '\0') {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': invalid name\n", path);
            all_success = 0;
            if (strcmp(dir, "/") != 0 && dir != "/") {
                free(dir);
            }
            continue;
        }

        // Check if dir exists and is a directory
        struct stat st;
        if (stat(dir, &st) != 0) {
           fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
            if (dir != "/" && strcmp(dir, ".") != 0) {
                free(dir);
            }
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': not a directory\n", path);
            all_success = 0;
            if (dir != "/" && strcmp(dir, ".") != 0) {
                free(dir);
            }
            continue;
        }

        // Construct full path for base
        char *full_path;
        if (strcmp(dir, "/") == 0) {
            full_path = malloc(2 + strlen(base) + 1); // "/x" + null
            if (full_path == NULL) {
                fprintf(stderr, "new_mkdir: out of memory\n");
                exit(1);
            }
            sprintf(full_path, "/%s", base);
        } else {
            full_path = malloc(strlen(dir) + 1 + strlen(base) + 1);
            if (full_path == NULL) {
                fprintf(stderr, "new_mkdir: out of memory\n");
                exit(1);
            }
            sprintf(full_path, "%s/%s", dir, base);
        }

        // Check if base exists
        if (stat(full_path, &st) == 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': file exists\n", path);
            all_success = 0;
            free(full_path);
            if (dir != "/" && strcmp(dir, ".") != 0) {
                free(dir);
            }
            continue;
        }

        // Attempt to create directory
        if (mkdir(full_path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            all_success = 0;
        }

        free(full_path);
        if (dir != "/" && strcmp(dir, ".") != 0) {
            free(dir);
        }
    }

    return all_success ? 0 : 1;
}

