Pseudo:

int main(int argc, char *argv[]) {
   const char *prog = "mkdir";
   // option parsing
   int i=1;
   // handle no args etc.
   ...

   int any_failure=0;

   for (; i<argc; ++i) {
      const char *orig = argv[i];
      // skip "--" sentinel already processed earlier, but loop after options includes it? We broke earlier when encountering '--' and break out to processing operands. So fine.
      // normalize copy
      char *norm = strdup(orig);
      if (!norm) { fprintf(stderr,...); return 1; }
      // strip trailing slashes except root
      size_t len = strlen(norm);
      while (len > 1 && norm[len-1] == '/') {
          norm[--len] = '\0';
      }

      // Determine parent path string
      char *parent;
      const char *slash = strrchr(norm, '/');
      if (slash) {
          if (slash == norm) {
              // root '/', parent is "/"
              parent = strdup("/"); // or just "/" literal; stat("/") works.
          } else {
              size_t plen = slash - norm;
              parent = malloc(plen + 1);
              if (!parent) { fprintf...; free(norm); return 1;}
              memcpy(parent, norm, plen);
              parent[plen] = '\0';
          }
      } else {
          // no slash => current directory "."
          parent = strdup(".");
      }

      struct stat sb;
      if (stat(parent, &sb) != 0) {
         print_error(prog, orig, strerror(errno));
         any_failure=1;
         free(parent);
         free(norm);
         continue;
      }
      if (!S_ISDIR(sb.st_mode)) {
         print_error(prog, orig, "Not a directory");
         any_failure=1;
         free(parent);
         free(norm);
         continue;
      }
      free(parent);

      // check existence of final component
      struct stat sb2;
      if (lstat(norm, &sb2) == 0) {
         print_error(prog, orig, "File exists");
         any_failure=1;
         free(norm);
         continue;
      }

      if (mkdir(norm, 0777) != 0) {
          print_error(prog, orig, strerror(errno));
          any_failure=1;
          free(norm);
          continue;
      }
      free(norm);
   }

   return any_failure ? 1 : 0;
}

