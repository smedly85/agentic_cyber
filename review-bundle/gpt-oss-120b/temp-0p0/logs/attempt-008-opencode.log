Let's craft C program:

- parse argv.
- Recognize "--" sentinel: after it, treat remaining args as operands, even if they start with '-'.
- Unknown option: any arg starting with '-' and not '--' and not a bare '-', before encountering '--', is an unknown option. Also need to check for operand "-" (a single dash) which is allowed as operand.

Algorithm:

int main(int argc, char *argv[]) {
    bool end_of_options = false;
    int i=1;
    bool any_operand = false;
    int exit_status = 0;

    while (i < argc) {
        char *arg = argv[i];
        if (!end_of_options && strcmp(arg, "--") == 0) {
            end_of_options = true;
            i++;
            continue;
        }
        // Determine if option
        if (!end_of_options && arg[0] == '-' && !(strcmp(arg, "-") == 0)) {
            // unknown option
            fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", arg);
            return 1;
        }

        any_operand = true;

        // process operand
        // split path: find last '/'.
        char *path = arg;
        char *slash = strrchr(path, '/');
        char parent[PATH_MAX];
        if (slash) {
            size_t len = slash - path; // length before slash
            if (len == 0) { // root "/"
                strcpy(parent, "/");
            } else {
                strncpy(parent, path, len);
                parent[len] = '\0';
            }
        } else {
            // no slash -> current directory "."
            strcpy(parent, ".");
        }

        // check parent existence and is directory
        struct stat sb;
        if (stat(parent, &sb) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            exit_status = 1;
            i++;
            continue;
        }
        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': Not a directory\n", path);
            // but we need proper message using strerror? Use ENOTDIR.
            errno = ENOTDIR;
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            exit_status = 1;
            i++;
            continue;
        }

        // check if final component exists
        struct stat sb2;
        if (stat(path, &sb2) == 0) {
            // exists
            errno = EEXIST;
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            exit_status = 1;
            i++;
            continue;
        }

        // attempt mkdir with mode 0777 (umask applied automatically)
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            exit_status = 1;
        }

        i++;
    }

    if (!any_operand) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    return exit_status;
}

