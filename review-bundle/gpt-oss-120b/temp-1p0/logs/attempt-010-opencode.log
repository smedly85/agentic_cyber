Let's design fresh implementation:

static int process_operand(const char *path) {
    // Determine parent
    const char *sep = strrchr(path, '/');
    const char *parent;
    char *parent_buf = NULL;
    if (!sep) {
        parent = ".";
    } else if (sep == path) { // leading slash
        parent = "/";
    } else {
        size_t plen = sep - path;
        parent_buf = malloc(plen + 1);
        if (!parent_buf) {
            fprintf(stderr, "mkdir: memory allocation failure\n");
            return -1;
        }
        memcpy(parent_buf, path, plen);
        parent_buf[plen] = '\0';
        parent = parent_buf;
    }

    // Stat parent
    struct stat sb;
    if (stat(parent, &sb) != 0) {
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        free(parent_buf);
        return 1;
    }
    if (!S_ISDIR(sb.st_mode)) {
        fprintf(stderr, "mkdir: cannot create directory '%s': Not a directory\n", path);
        free(parent_buf);
        return 1;
    }

    // Check existence of target
    struct stat sb2;
    if (stat(path, &sb2) == 0) {
        fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", path);
        free(parent_buf);
        return 1;
    }

    // Try to mkdir
    if (mkdir(path, 0777) != 0) {
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        free(parent_buf);
        return 1;
    }

    free(parent_buf);
    return 0;
}

