Algorithm:

int main(int argc,char *argv[]){
 int i=1;
 // skip program name
 bool end_of_options=false;
 int first_operand_index=-1;
 for(i=1;i<argc;i++){
   if(!end_of_options && strcmp(argv[i],"--")==0){
      end_of_options=true;
      continue;
   }
   if(!end_of_options && argv[i][0]=='-' && !(argv[i][1]==0)){ // not bare "-"
        // unknown option
        fprintf(stderr,"new_mkdir: unrecognized option '%s'\n",argv[i]);
        return 1;
   }
   // operand
   if(first_operand_index==-1) first_operand_index=i;
 }
 if(first_operand_index==-1){
    fprintf(stderr,"new_mkdir: missing operand\n");
    return 1;
 }

 bool any_failure=false;
 for(i=first_operand_index;i<argc;i++){
   char *arg = argv[i];
   // skip '--' if appears after operands? but we already handled earlier.
   if(strcmp(arg,"--")==0) continue; // not operand
   // process arg as path
   // find parent path: use strdup, strrchr to last '/'.
   char *path=arg;
   char *slash = strrchr(path,'/');
   char parent[PATH_MAX];
   char leaf[NAME_MAX+1];
   if(slash){
       size_t plen = slash - path;
       memcpy(parent,path,plen);
       parent[plen]='\0';
       strcpy(leaf, slash+1);
   } else {
       parent[0]='\0'; // empty -> current directory
       strcpy(leaf, path);
   }
   // check parent existence unless empty (means cwd)
   struct stat sb;
   if(parent[0]!='\0'){
        if(lstat(parent,&sb)!=0){
            fprintf(stderr,"new_mkdir: cannot create directory '%s': %s\n",arg,strerror(errno));
            any_failure=true;
            continue;
        }
        if(!S_ISDIR(sb.st_mode)){
            fprintf(stderr,"new_mkdir: cannot create directory '%s': Not a directory\n",arg);
            any_failure=true;
            continue;
        }
   } else {
        // cwd exists by definition, but could be non-dir? cwd is dir.
   }
   // check if leaf already exists
   char fullpath[PATH_MAX];
   if(parent[0]!='\0'){
        snprintf(fullpath,sizeof(fullpath),"%s/%s",parent,leaf);
   } else {
        snprintf(fullpath,sizeof(fullpath),"%s",leaf);
   }
   if(lstat(fullpath,&sb)==0){
        fprintf(stderr,"new_mkdir: cannot create directory '%s': File exists\n",arg);
        any_failure=true;
        continue;
   }
   // attempt mkdir
   if(mkdir(fullpath,0777)!=0){
        fprintf(stderr,"new_mkdir: cannot create directory '%s': %s\n",arg,strerror(errno));
        any_failure=true;
        continue;
   }
 }
 return any_failure?1:0;
}

