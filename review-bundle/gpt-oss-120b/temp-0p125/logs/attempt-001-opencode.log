int main(int argc, char *argv[]) {
  int i;
  int end_of_options = 0;
  int any_operand = 0;
  int had_error = 0;

  for (i=1; i<argc; ++i) {
    char *arg = argv[i];
    if (!end_of_options && strcmp(arg, "--")==0) {
        end_of_options = 1;
        continue;
    }
    if (!end_of_options && arg[0]=='-' && !(strcmp(arg, "-")==0)) {
        // unknown option
        fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", arg);
        return 1;
    }
    // treat as operand
    any_operand = 1;
    // process later after loop? maybe process immediately.
    if (mkdir(arg, 0777) !=0) {
        had_error = 1;
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", arg, strerror(errno));
    }
  }

  if (!any_operand) {
     fprintf(stderr, "new_mkdir: missing operand\n");
     return 1;
  }

  return had_error ? 1 : 0;
}

