Implementation details:

int main(int argc, char *argv[]) {
    int any_failure = 0;
    int operand_count = 0;
    int parsing_options = 1;

    for (int i=1;i<argc;i++) { 
        char *arg = argv[i];
        if (parsing_options) {
            if (strcmp(arg, "--")==0) {
                parsing_options = 0;
                continue;
            }
            if (arg[0]=='-' && strcmp(arg,"-")!=0) {
                fprintf(stderr, "new_mkdir: unrecognized option '%s'\n", arg);
                return 1;
            }
        }
        // treat as operand
        operand_count++;
        // process path
        char *path = arg; // keep original for messages

        // duplicate for manipulation (remove trailing slashes)
        char *dup = strdup(path);
        if (!dup) {
            fprintf(stderr, "new_mkdir: memory allocation failed\n");
            return 1;
        }
        // strip trailing '/'
        size_t len = strlen(dup);
        while (len > 1 && dup[len-1]=='/') { dup[--len]=0; }

        // find last slash
        char *slash = strrchr(dup, '/');
        const char *parent;
        if (slash) {
            if (slash == dup) {
                // parent is "/"
                parent = "/";
                // final component after slash
            } else {
                *slash = '\0';
                parent = dup;
            }
        } else {
            parent = ".";
        }

        // check parent existence and directory
        struct stat sb;
        if (stat(parent, &sb) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
            free(dup);
            continue;
        }
        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, "mkdir: cannot create directory '%s': Not a directory\n", path);
            any_failure = 1;
            free(dup);
            continue;
        }

        // check final component existence
        struct stat sb2;
        if (stat(path, &sb2) == 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", path);
            any_failure = 1;
            free(dup);
            continue;
        } else {
            // If error other than ENOENT, we still proceed to mkdir which will give appropriate message.
        }

        // attempt mkdir
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
            any_failure = 1;
        }
        free(dup);
    }

    if (operand_count == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }

    return any_failure ? 1 : 0;
}

