                        }
                        free(parent_copy);
                    }
                    free(real_src);
                }
            }
        }

        if (skip) {
            free(eff_dest);
            any_failed = 1;
            continue;
        }

        /* Interactive prompt when policy is interactive and dest exists */
        if (policy == 2 && eff_exists) {
