static int is_descendant_or_same(const char *src_real, const char *dest) {
    // src_real is the canonical absolute path of the source directory
    size_t len = strlen(src_real);
    // Check if dest (absolute) starts with src_real followed by '/' or is equal
    // dest might be relative, so we need to make it absolute
    char dest_abs[PATH_MAX];
    if (dest[0] == '/') {
        strncpy(dest_abs, dest, PATH_MAX);
    } else {
        char cwd[PATH_MAX];
        if (getcwd(cwd, PATH_MAX) == NULL) return 0; // can't determine, let kernel handle
        snprintf(dest_abs, PATH_MAX, "%s/%s", cwd, dest);
    }
    // Normalize: remove trailing slash
    size_t dlen = strlen(dest_abs);
    if (dlen > 0 && dest_abs[dlen-1] == '/') dest_abs[dlen-1] = '\0';
    
    // Check equality
    if (strcmp(dest_abs, src_real) == 0) return 1;
    // Check prefix
    if (strncmp(dest_abs, src_real, len) == 0 && dest_abs[len] == '/') return 1;
    return 0;
}
```

