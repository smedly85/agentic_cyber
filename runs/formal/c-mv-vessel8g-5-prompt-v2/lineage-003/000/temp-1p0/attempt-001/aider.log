                    fprintf(stderr, "c_mv: '%s' and '%s' are the same file\n", src, eff_dest);
                    failed = 1;
                    continue;
                }
            }

            /* Type compatibility */
            if (S_ISDIR(src_st.st_mode)) {
                int dest_exists = 0;
                int dest_is_dir = is_directory(eff_dest, &dest_exists);
                if (dest_exists && !dest_is_dir) {
                    fprintf(stderr, "c_mv: cannot move directory '%s' to non-directory '%s'\n", src, eff_dest);
                    failed = 1;
