```c
#include <errno.h>
#include <limits.h>
#include <libgen.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

/* Core filesystem move operation */
static int move_path(const char *src, const char *dest)
{
    return rename(src, dest);
}

static void die_usage(void)
{
    /* stdout empty, diagnostic on stderr, status 1 */
    fprintf(stderr, "c_mv: missing operand(s)\n");
    exit(1);
}

static int is_directory(const char *path, int *exists)
{
    struct stat st;
    if (stat(path, &st) != 0) {
        *exists = 0;
        return 0;
    }
    *exists = 1;
    return S_ISDIR(st.st_mode);
}

static int type_of(const char *path, struct stat *st)
{
    if (lstat(path, st) != 0) return -1;
    return 0;
}

/* Check if dest path is the same as or inside src_real (canonical absolute path of a directory) */
static int path_is_inside_or_same(const char *src_real, const char *dest)
{
    size_t src_len = strlen(src_real);
    
    if (dest[0] == '/') {
        /* Absolute path */
        if (strcmp(dest, src_real) == 0) return 1;
        if (strncmp(dest, src_real, src_len) == 0 && dest[src_len] == '/') return 1;
    } else {
        /* Relative path - make absolute */
        char cwd[PATH_MAX];
        if (getcwd(cwd, sizeof(cwd)) == NULL) return 0;
        char abs_path[PATH_MAX];
        if (snprintf(abs_path, sizeof(abs_path), "%s/%s", cwd, dest) >= (int)sizeof(abs_path))
            return 0;
        if (strcmp(abs_path, src_real) == 0) return 1;
        if (strncmp(abs_path, src_real, src_len) == 0 && abs_path[src_len] == '/') return 1;
    }
    return 0;
}

static const char *basename_of(const char *path)
{
    /* Find last '/' and return pointer after it */
    const char *slash = strrchr(path, '/');
    if (slash == NULL) return path;
    if (slash[1] == '\0') return path; /* path ends with / */
    return slash + 1;
}

static int path_join(char *buf, size_t bufsz, const char *dir, const char *name)
{
    int n = snprintf(buf, bufsz, "%s/%s", dir, name);
    return (n >= 0 && n < (int)bufsz) ? 0 : -1;
}

int main(int argc, char *argv[])
{
    /* Parse arguments */
    const char **operands = NULL;
    int n_operands = 0;
    int cap = 0;
    int seen_dd = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_dd) {
            if (strcmp(arg, "--") == 0) {
                seen_dd = 1;
                continue;
            }
            if (strcmp(arg, "-") == 0) {
                /* bare dash is a filename */
            } else if (arg[0] == '-' && arg[1] != '\0') {
                fprintf(stderr, "c_mv: unknown option -- %s\n", arg);
                return 1;
            }
        }
        if (n_operands == cap) {
            cap = cap ? cap * 2 : 8;
            operands = realloc(operands, cap * sizeof(*operands));
            if (!operands) {
                fprintf(stderr, "c_mv: out of memory\n");
                return 1;
            }
        }
        operands[n_operands++] = arg;
    }

    if (n_operands < 2) {
        fprintf(stderr, "c_mv: missing operand(s)\n");
        return 1;
    }

    int failed = 0;

    if (n_operands == 2) {
        const char *src = operands[0];
        const char *dest = operands[1];

        /* Determine effective destination */
        int dest_exists = 0;
        int dest_is_dir = is_directory(dest, &dest_exists);

        char eff_dest[PATH_MAX];
        if (dest_is_dir) {
            const char *base = basename_of(src);
            if (path_join(eff_dest, sizeof(eff_dest), dest, base) != 0) {
                fprintf(stderr, "c_mv: path too long for %s\n", src);
                return 1;
            }
        } else {
            /* dest is not a directory (or doesn't exist) - use as-is */
            if (strlen(dest) >= PATH_MAX) {
                fprintf(stderr, "c_mv: path too long for %s\n", src);
                return 1;
            }
