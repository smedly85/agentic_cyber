static const char *basename_of(const char *path)
{
    const char *slash = strrchr(path, '/');
    if (slash == NULL) return path;
    if (slash == path) return path + 1; /* root "/" */
    if (slash[1] == '\0') {
        /* Trailing slash, look for the one before */
        const char *prev = slash - 1;
        while (prev >= path && *prev == '/') prev--;
        if (prev < path) return path + 1; /* just "/" */
        const char *name = prev + 1;
        const char *prev_slash = strrchr(name, '/');
        if (prev_slash == NULL) return name;
        return prev_slash + 1;
    }
    return slash + 1;
}
```

