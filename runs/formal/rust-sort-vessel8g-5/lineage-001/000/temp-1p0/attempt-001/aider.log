```rust
use std::io::{self, Read, Write};
use std::process;

fn main() {
    // Handle allocation failures: report and exit 2 instead of aborting silently.
    std::alloc::set_alloc_error_hook(|_| {
        let msg = b"rust_sort: error: out of memory\n";
        let stderr = io::stderr();
        let _ = stderr.lock().write_all(msg);
        process::exit(2);
    });

    // Parse arguments: only valid forms are no-args or bare "--".
    let args: Vec<String> = std::env::args().collect();
    let program_args = &args[1..];
    if !program_args.is_empty() {
        if program_args.len() == 1 && program_args[0] == "--" {
            // bare "--" is valid
        } else {
            eprintln!("usage: rust_sort");
            process::exit(2);
        }
    }

    // Read all of stdin.
    let mut input = Vec::new();
    if let Err(e) = io::stdin().read_to_end(&mut input) {
        eprintln!("rust_sort: error: failed to read input: {}", e);
        process::exit(2);
    }

    // Empty input produces empty output.
    if input.is_empty() {
        process::exit(0);
    }

    // Split into newline-delimited records.
    let mut records: Vec<&[u8]> = input.split(|&b| b == b'\n').collect();
    // If input ends with newline, the last split piece is a spurious empty tail.
    if input.last() == Some(&b'\n') {
        records.pop();
    }

    // Sort in unsigned bytewise lexicographic ascending order (Rust's default
    // Ord for byte slices).
    records.sort();

    // Emit each record followed by a newline.
    let stdout = io::stdout();
    let mut out = stdout.lock();
    for record in &records {
        if let Err(e) = out.write_all(record).and_then(|_| out.write_all(b"\n")) {
            eprintln!("rust_sort: error: failed to write output: {}", e);
            process::exit(2);
        }
    }
    if let Err(e) = out.flush() {
        eprintln!("rust_sort: error: failed to flush output: {}", e);
        process::exit(2);
    }
