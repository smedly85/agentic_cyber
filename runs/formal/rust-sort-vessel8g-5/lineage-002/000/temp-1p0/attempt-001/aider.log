use std::io::{self, Read, Write};

fn main() {
    let args: Vec<String> = std::env::args().collect();
    let arg_list = &args[1..];

    // `--` is the only recognized token; it ends option parsing and admits
    // no operands.  Every other token is either an unknown option or an
    // operand – both are fatal.
    for arg in arg_list {
        if arg != "--" {
            eprintln!("Usage: rust_sort [--]");
            std::process::exit(2);
        }
    }

    // Read all of stdin.
    let mut input: Vec<u8> = Vec::new();
    if let Err(e) = io::stdin().read_to_end(&mut input) {
        eprintln!("rust_sort: reading input: {}", e);
        std::process::exit(2);
    }

    // Split into newline-delimited records.  A trailing non-empty
    // unterminated chunk is still a record.
    let mut records: Vec<&[u8]> = Vec::new();
    let mut start = 0usize;
    for (i, &b) in input.iter().enumerate() {
        if b == b'\n' {
            records.push(&input[start..i]);
            start = i + 1;
        }
    }
    if start < input.len() {
        records.push(&input[start..]);
    }

    // Unsigned bytewise lexicographic ascending (LC_ALL=C order).
    records.sort();

    // Write each record followed by a newline.
    let stdout = io::stdout();
    let mut out = stdout.lock();
    for rec in &records {
        if out.write_all(rec).is_err() || out.write_all(b"\n").is_err() {
            eprintln!("rust_sort: writing output");
            std::process::exit(2);
        }
    }
    if out.flush().is_err() {
        eprintln!("rust_sort: writing output");
        std::process::exit(2);
    }
}
```

