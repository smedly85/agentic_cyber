```rust
use std::io::{self, Read, Write};

fn fold_byte(b: u8) -> u8 {
    if (b'A'..=b'Z').contains(&b) { b + 32 } else { b }
}

fn folded_key(rec: &[u8]) -> Vec<u8> {
    rec.iter().map(|b| fold_byte(*b)).collect()
}

fn main() {
    let args: Vec<String> = std::env::args().collect();
    let arg_list = &args[1..];

    let mut reverse = false;
    let mut ignore_case = false;
    let mut unique = false;

    for arg in arg_list {
        if arg == "--" {
            continue;
        }
        if arg == "--reverse" {
            reverse = true;
            continue;
        }
        if arg == "--ignore-case" {
            ignore_case = true;
            continue;
        }
        if arg == "--unique" {
            unique = true;
            continue;
        }
        if arg.starts_with("--") {
            eprintln!("sort: unrecognized option '{}'", arg);
            eprintln!("Try 'sort --help' for more information.");
            std::process::exit(2);
        }
        if arg.starts_with('-') {
            let cluster = &arg[1..];
            if cluster.is_empty() {
                eprintln!("sort: unrecognized option '-'");
                eprintln!("Try 'sort --help' for more information.");
                std::process::exit(2);
            }
            for c in cluster.chars() {
                match c {
                    'r' => reverse = true,
                    'f' => ignore_case = true,
                    'u' => unique = true,
                    _ => {
                        eprintln!("sort: unrecognized option '{}'", arg);
                        eprintln!("Try 'sort --help' for more information.");
                        std::process::exit(2);
                    }
                }
            }
            continue;
        }
        // operand
        match std::fs::metadata(arg) {
            Err(e) => {
                let msg = e.to_string();
                let stripped = if let Some(pos) = msg.rfind(" (os error ") {
                    &msg[..pos]
                } else {
                    &msg
                };
                eprintln!("sort: cannot read: {}: {}", arg, stripped);
                std::process::exit(2);
            }
            Ok(m) if m.is_dir() => {
                eprintln!("sort: cannot read: {}: Is a directory", arg);
                std::process::exit(2);
            }
            Ok(_) => {
                eprintln!("sort: cannot read: {}: file operands are not supported", arg);
                std::process::exit(2);
            }
        }
    }

    // Read all of stdin as bytes.
    let mut input: Vec<u8> = Vec::new();
    if let Err(e) = io::stdin().read_to_end(&mut input) {
        eprintln!("rust_sort: reading input: {e}");
        std::process::exit(2);
    }

    // Split into newline-delimited records.
    let mut records: Vec<(usize, Vec<u8>)> = Vec::new(); // (input_ordinal, bytes)
    let mut start = 0usize;
    let mut ordinal = 0usize;
    for (i, &b) in input.iter().enumerate() {
        if b == b'\n' {
            records.push((ordinal, input[start..i].to_vec()));
            ordinal += 1;
            start = i + 1;
        }
    }
    if start < input.len() {
        records.push((ordinal, input[start..].to_vec()));
    }

    if records.is_empty() {
        // No output, exit 0
        return;
    }

    // Determine comparison keys
    // If ignore_case: key = folded bytes
    // Else: key = raw bytes
    
    let keys: Vec<Vec<u8>> = if ignore_case {
        records.iter().map(|(_, rec)| folded_key(rec)).collect()
    } else {
        records.iter().map(|(_, rec)| rec.clone()).collect()
    };

    let result: Vec<usize> = if unique {
        // Deduplicate: for each unique key, keep the record with lowest input ordinal
        // Since records are already in input order (ordinal 0, 1, 2, ...),
        // the first occurrence of each key is the representative.
        let mut seen: std::collections::HashSet<Vec<u8>> = std::collections::HashSet::new();
        let mut unique_indices: Vec<usize> = Vec::new();
        for i in 0..records.len() {
            if seen.insert(keys[i].clone()) {
                unique_indices.push(i);
            }
        }
        // Sort by comparison key
        unique_indices.sort_by(|&a, &b| {
            let ord = keys[a].cmp(&keys[b]);
            if reverse { ord.reverse() } else { ord }
        });
        unique_indices
    } else {
        // Sort all records
        let mut indices: Vec<usize> = (0..records.len()).collect();
        indices.sort_by(|&a, &b| {
            let primary;
            if ignore_case {
                // Compare folded keys first, then original bytes as last-resort
                primary = keys[a].cmp(&keys[b]).then_with(|| records[a].1.cmp(&records[b].1));
            } else {
                primary = keys[a].cmp(&keys[b]);
            }
            if reverse { primary.reverse() } else { primary }
        });
        indices
    };

    // Emit records
    let stdout = io::stdout();
    let mut out = stdout.lock();
    for &idx in &result {
        let rec = &records[idx].1;
        if out.write_all(rec).is_err() || out.write_all(b"\n").is_err() {
            eprintln!("rust_sort: writing output");
            std::process::exit(2);
        }
    }
    if out.flush().is_err() {
        eprintln!("rust_sort: writing output");
        std::process::exit(2);
    }
}
```

