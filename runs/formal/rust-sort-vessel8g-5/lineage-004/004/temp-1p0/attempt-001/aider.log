fn cmp_primary(a: &[u8], b: &[u8], ignore_case: bool) -> std::cmp::Ordering {
    if !ignore_case {
        return a.cmp(b);
    }
    let min_len = std::cmp::min(a.len(), b.len());
    for i in 0..min_len {
        let fa = fold(a[i]);
        let fb = fold(b[i]);
        if fa != fb {
            return fa.cmp(&fb);
        }
    }
    a.len().cmp(&b.len())
}
```

