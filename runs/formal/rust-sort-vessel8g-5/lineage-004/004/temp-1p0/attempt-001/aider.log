fn is_in_order(a: &[u8], b: &[u8], ignore_case: bool, unique: bool, reverse: bool) -> bool {
    let primary = if ignore_case {
        cmp_folded(a, b)  // compare folded bytes only
    } else {
        a.cmp(b)
    };
    
    if unique {
        // Strict ordering required
        let in_order = match primary {
            std::cmp::Ordering::Less => true,
            std::cmp::Ordering::Greater => false,
            std::cmp::Ordering::Equal => false,  // violation with -u
        };
        if reverse { !in_order } else { in_order }
    } else {
        // Non-strict ordering; last-resort applies if ignore_case
        let full = if ignore_case {
            if primary == std::cmp::Ordering::Equal {
                a.cmp(b)  // last-resort
            } else {
                primary
            }
        } else {
            primary
        };
        let in_order = match full {
            std::cmp::Ordering::Less => true,
            std::cmp::Ordering::Equal => true,
            std::cmp::Ordering::Greater => false,
        };
        if reverse { !in_order } else { in_order }
    }
}
```

