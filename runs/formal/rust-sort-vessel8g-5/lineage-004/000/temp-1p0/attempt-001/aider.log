```rust
use std::io::{self, Read, Write};
use std::process;

fn main() {
    std::panic::set_hook(Box::new(|_| {
        let _ = io::stderr().write_all(b"rust_sort: internal error\n");
        process::exit(2);
    }));

    // Argument parsing
    let args: Vec<String> = std::env::args().skip(1).collect();
    let mut after_ddash = false;
    for arg in &args {
        if after_ddash {
            fail_usage();
        }
        if arg == "--" {
            after_ddash = true;
            continue;
        }
        if arg.starts_with('-') {
            fail_usage();
        }
        fail_usage();
    }

    // Read all of stdin
    let mut input: Vec<u8> = Vec::new();
    if let Err(e) = io::stdin().read_to_end(&mut input) {
        eprintln!("rust_sort: {}", e);
        process::exit(2);
    }

    // Split into record ranges (start, length) without copying
    let mut ranges: Vec<(usize, usize)> = Vec::new();
    if !input.is_empty() {
        let mut start: usize = 0;
        let mut i: usize = 0;
        while i < input.len() {
            if input[i] == b'\n' {
                ranges.push((start, i - start));
                start = i + 1;
                i = start;
            } else {
                i += 1;
            }
        }
        if start < input.len() {
            ranges.push((start, input.len() - start));
        }
    }

    // Sort in unsigned bytewise lexicographic ascending order
    ranges.sort_by(|a, b| {
        input[a.0..a.0 + a.1].cmp(&input[b.0..b.0 + b.1])
    });

    // Write output
    let stdout = io::stdout();
    let mut out = stdout.lock();
    for &(start, len) in &ranges {
        if let Err(e) = out.write_all(&input[start..start + len]) {
            eprintln!("rust_sort: {}", e);
            process::exit(2);
        }
        if let Err(e) = out.write_all(b"\n") {
            eprintln!("rust_sort: {}", e);
            process::exit(2);
        }
    }
    if let Err(e) = out.flush() {
        eprintln!("rust_sort: {}", e);
        process::exit(2);
    }
}

fn fail_usage() -> ! {
    eprintln!("Usage: rust_sort [OPTION]...");
    process::exit(2);
}
```

