fn are_duplicates(a: &[u8], b: &[u8], ignore_case: bool) -> bool {
    if !ignore_case {
        return a == b;
    }
    let min_len = std::cmp::min(a.len(), b.len());
    for i in 0..min_len {
        let fa = fold(a[i]);
        let fb = fold(b[i]);
        if fa != fb {
            return false;
        }
    }
    a.len() == b.len()
}

fn fold(b: u8) -> u8 {
    if b >= b'a' && b <= b'z' { b - 32 } else { b }
}
