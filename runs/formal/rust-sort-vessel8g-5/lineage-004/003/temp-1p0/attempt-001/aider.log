            cmp_records(
                &input[b.0..b.0 + b.1],
                &input[a.0..a.0 + a.1],
                ignore_case,
            )
        });
    } else {
        records.sort_by(|a, b| {
            cmp_records(
                &input[a.0..a.0 + a.1],
                &input[b.0..b.0 + b.1],
