```rust
use std::io::{self, Read, Write};

fn main() {
    // Parse arguments
    let args: Vec<String> = std::env::args().skip(1).collect();
    
    // Validate arguments: only valid cases are empty or exactly ["--"]
    if !args.is_empty() {
        // Check if it's exactly one arg and it's "--"
        if args.len() != 1 || args[0] != "--" {
            eprintln!("usage: rust_sort [OPTION...] [FILE...]");
            eprintln!("\nSort lines from FILEs to standard output.");
            eprintln!("\nWith no FILE, or when FILE is -, read standard input.");
            std::process::exit(2);
        }
    }
    
    // Read all of stdin
    let mut input = Vec::new();
    let mut stdin = io::stdin().lock();
    if let Err(e) = stdin.read_to_end(&mut input) {
        eprintln!("rust_sort: error reading input: {}", e);
        std::process::exit(2);
    }
    
    // Split into records
    let mut records: Vec<Vec<u8>> = Vec::new();
    let mut start = 0;
    for (i, &b) in input.iter().enumerate() {
        if b == b'\n' {
            records.push(input[start..i].to_vec());
            start = i + 1;
        }
    }
    if start < input.len() {
        records.push(input[start..].to_vec());
    }
    
    // Sort bytewise
    records.sort_unstable_by(|a, b| a.cmp(b));
    
    // Write output
    let stdout = io::stdout();
    let mut out = stdout.lock();
    for rec in &records {
        if let Err(e) = out.write_all(rec) {
            eprintln!("rust_sort: error writing output: {}", e);
            std::process::exit(2);
        }
        if let Err(e) = out.write_all(b"\n") {
            eprintln!("rust_sort: error writing output: {}", e);
            std::process::exit(2);
        }
    }
    if let Err(e) = out.flush() {
        eprintln!("rust_sort: error flushing output: {}", e);
        std::process::exit(2);
    }
}
```

