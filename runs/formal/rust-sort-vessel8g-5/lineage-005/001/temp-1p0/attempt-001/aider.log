use std::io::{self, Read, Write};

fn os_error_msg(e: &io::Error) -> String {
    let s = e.to_string();
    match s.find(" (os error") {
        Some(pos) => s[..pos].to_string(),
        None => s,
    }
}

fn unknown_option(opt: &str) -> ! {
    eprint!("sort: unrecognized option '{}'\nTry 'sort --help' for more information.\n", opt);
    std::process::exit(2)
}

fn extra_operand(arg: &str) -> ! {
    eprint!("sort: extra operand '{}'\nTry 'sort --help' for more information.\n", arg);
    std::process::exit(2)
}

fn main() {
    let args: Vec<String> = std::env::args().skip(1).collect();

    let mut reverse = false;
    let mut seen_ddash = false;

    for arg in &args {
        if seen_ddash {
            extra_operand(arg);
        }
        if arg == "--" {
            seen_ddash = true;
            continue;
        }
        if arg == "-" {
            extra_operand(arg);
        }
        if arg.starts_with("--") {
            match arg.as_str() {
                "--reverse" => { reverse = true; }
                _ => unknown_option(arg),
            }
            continue;
        }
        if arg.starts_with('-') && arg.len() > 1 {
            for c in arg[1..].chars() {
                match c {
                    'r' => { reverse = true; }
                    _ => {
                        let opt = format!("-{}", c);
                        unknown_option(&opt);
                    }
                }
            }
            continue;
        }
        extra_operand(arg);
    }

    let mut input: Vec<u8> = Vec::new();
    let mut stdin = io::stdin().lock();
    if let Err(e) = stdin.read_to_end(&mut input) {
        eprintln!("sort: cannot read input: {}", os_error_msg(&e));
        std::process::exit(2);
    }

    let mut records: Vec<&[u8]> = Vec::new();
    let mut start = 0;
    for (i, &b) in input.iter().enumerate() {
        if b == 0x0A {
            records.push(&input[start..i]);
            start = i + 1;
        }
    }
    if start < input.len() {
        records.push(&input[start..]);
    }

    if reverse {
        records.sort_unstable_by(|a, b| b.cmp(a));
    } else {
        records.sort_unstable_by(|a, b| a.cmp(b));
    }

    let stdout = io::stdout();
    let mut out = stdout.lock();
    for rec in &records {
        if out.write_all(rec).is_err() || out.write_all(b"\n").is_err() {
            eprintln!("sort: cannot write output");
            std::process::exit(2);
        }
    }
    if out.flush().is_err() {
        eprintln!("sort: cannot write output");
        std::process::exit(2);
    }
}
```

**Summary of changes:**

- Replaced `reject_operand` (which had a file-open side effect) with `extra_operand` that simply prints a diagnostic and exits 2.
- Added `unknown_option` helper for consistent unknown-option diagnostics.
- Replaced the blanket "reject everything starting with `-`" logic with a proper argument parser that:
  - Accepts `--reverse` (long option)
  - Accepts `-r` via short-option-cluster iteration (each char after the leading `-` is checked; `r` sets reverse, anything else is unknown)
  - Treats `-` as an extra operand (rejected)
  - Treats `--` as end-of-options; anything after is an extra operand (rejected)
  - Treats any other non-option arg as an extra operand (rejected)
- Changed the sort to use `b.cmp(a)` when `reverse` is true, `a.cmp(b)` otherwise.

**Files changed:** `src/rust_sort/rust_sort.rs`

**Behavior implemented:** Reverse sort via `-r` and `--reverse`, short-option clustering, repeated-option idempotency, all base behaviors preserved.

