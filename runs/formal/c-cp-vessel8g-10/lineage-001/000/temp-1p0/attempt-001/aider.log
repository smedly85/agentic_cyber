	struct stat src_stat, dest_stat;
	int src_fd, dest_fd;
	char buf[65536];
	ssize_t nread, nwritten;
	int dest_existed = 0;

	if (stat(src, &src_stat) != 0) {
		fprintf(stderr, "cp: cannot stat '%s': %s\n", src, strerror(errno));
		return -1;
	}
	if (!S_ISREG(src_stat.st_mode)) {
		fprintf(stderr, "cp: '%s': not a regular file\n", src);
		return -1;
	}

	if (stat(dest, &dest_stat) == 0) {
		if (!S_ISREG(dest_stat.st_mode)) {
			fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
				S_ISDIR(dest_stat.st_mode)
					? "Is a directory"
					: "Inappropriate file type");
			return -1;
		}
		if (src_stat.st_dev == dest_stat.st_dev &&
		    src_stat.st_ino == dest_stat.st_ino) {
			fprintf(stderr, "cp: '%s' and '%s' are the same file\n",
				src, dest);
			return -1;
		}
		dest_existed = 1;
	} else {
		struct stat ls;
		if (lstat(dest, &ls) == 0 && S_ISLNK(ls.st_mode)) {
			fprintf(stderr,
				"cp: cannot create '%s': No such file or directory\n",
				dest);
			return -1;
		}
	}

	src_fd = open(src, O_RDONLY);
	if (src_fd < 0) {
		fprintf(stderr, "cp: cannot open '%s' for reading: %s\n",
			src, strerror(errno));
		return -1;
	}

	if (dest_existed) {
		dest_fd = open(dest, O_WRONLY | O_TRUNC);
	} else {
		dest_fd = open(dest, O_WRONLY | O_CREAT | O_TRUNC,
			       (mode_t)(src_stat.st_mode & 07777));
	}
	if (dest_fd < 0) {
		fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
			strerror(errno));
		close(src_fd);
		return -1;
	}

	for (;;) {
		nread = read(src_fd, buf, sizeof(buf));
		if (nread < 0) {
			fprintf(stderr, "cp: error reading '%s': %s\n",
				src, strerror(errno));
			goto fail;
		}
		if (nread == 0)
			break;
		nwritten = 0;
		while (nwritten < nread) {
			ssize_t w = write(dest_fd, buf + nwritten,
					 nread - nwritten);
			if (w < 0) {
				fprintf(stderr, "cp: error writing '%s': %s\n",
					dest, strerror(errno));
				goto fail;
			}
			nwritten += w;
		}
	}

	close(src_fd);
	close(dest_fd);
	return 0;

fail:
	close(src_fd);
	close(dest_fd);
	return -1;
}

int main(int argc, char *argv[])
{
	int i, sep_idx = -1, n_operands = 0, n_ops = 0;
	char **operands;
	int failed = 0;
	int n_sources, last_is_dir = 0;
	const char *dir_arg = NULL;

	/* Find -- separator */
	for (i = 1; i < argc; i++) {
		if (strcmp(argv[i], "--") == 0) {
			sep_idx = i;
			break;
		}
	}

	/* Count operands */
	for (i = 1; i < argc; i++) {
		if (i != sep_idx)
			n_operands++;
	}

	if (n_operands < 2) {
		fprintf(stderr, "cp: missing operand\n");
		return 1;
	}

	operands = malloc((size_t)n_operands * sizeof(char *));
	if (!operands) {
		fprintf(stderr, "cp: out of memory\n");
		return 1;
	}

	/* Collect operands, rejecting unknown options before -- */
	for (i = 1; i < argc; i++) {
		if (i == sep_idx)
			continue;
		if (sep_idx < 0 || i < sep_idx) {
			if (argv[i][0] == '-' && argv[i][1] != '\0') {
				fprintf(stderr, "cp: unknown option '%s'\n",
					argv[i]);
				free(operands);
				return 1;
			}
		}
		operands[n_ops++] = argv[i];
	}

	/* Validate multi-source: last must be existing directory */
	if (n_operands >= 3) {
		struct stat st;
		const char *last = operands[n_operands - 1];
		if (stat(last, &st) != 0) {
			fprintf(stderr, "cp: target '%s': No such file or directory\n",
				last);
			free(operands);
			return 1;
		}
		if (!S_ISDIR(st.st_mode)) {
			fprintf(stderr, "cp: target '%s': Not a directory\n", last);
			free(operands);
			return 1;
		}
		last_is_dir = 1;
		dir_arg = last;
	}

	n_sources = n_operands - (last_is_dir ? 1 : 0);

	/* Process each source in order */
	for (i = 0; i < n_sources; i++) {
		const char *src = operands[i];
		char dest[4096];
		size_t dlen;

		if (last_is_dir) {
			const char *bn = base_name(src);
			/* Avoid double slash if dir_arg ends with / */
			if (dir_arg[0] != '\0' &&
			    dir_arg[strlen(dir_arg) - 1] == '/')
				dlen = strlen(dir_arg) + strlen(bn) + 1;
			else
				dlen = strlen(dir_arg) + 1 + strlen(bn) + 1;
			if (dlen > sizeof(dest)) {
				fprintf(stderr, "cp: path too long\n");
				failed = 1;
				continue;
			}
			if (dir_arg[0] != '\0' &&
			    dir_arg[strlen(dir_arg) - 1] == '/')
				snprintf(dest, sizeof(dest), "%s%s", dir_arg, bn);
			else
				snprintf(dest, sizeof(dest), "%s/%s", dir_arg, bn);
		} else {
			/* Two operands: check if DEST is a directory */
			struct stat dst;
			if (stat(operands[1], &dst) == 0 && S_ISDIR(dst.st_mode)) {
				const char *bn = base_name(src);
				if (operands[1][strlen(operands[1]) - 1] == '/')
					snprintf(dest, sizeof(dest), "%s%s",
						 operands[1], bn);
				else
					snprintf(dest, sizeof(dest), "%s/%s",
						 operands[1], bn);
			} else {
				snprintf(dest, sizeof(dest), "%s", operands[1]);
			}
		}

		if (copy_path(src, dest) != 0)
			failed = 1;
	}

	free(operands);
	return failed ? 1 : 0;
}
