#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>

/* copy_path: the core filesystem operation that copies one regular file
   from src to dest. Returns 0 on success, -1 on failure. */
static int copy_path(const char *src, const char *dest) {
    struct stat src_stat;
    struct stat dest_stat;
    int src_fd, dest_fd;
    int rc = -1;
    char buf[65536];
    ssize_t nread, nwritten;
    int dest_existed = 0;
    mode_t dest_mode = 0;

    /* Resolve source (follow symlinks) */
    if (stat(src, &src_stat) != 0) {
        fprintf(stderr, "cp: cannot stat '%s': %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISREG(src_stat.st_mode)) {
        fprintf(stderr, "cp: '%s' is not a regular file\n", src);
        return -1;
    }

    /* Check destination */
    if (stat(dest, &dest_stat) == 0) {
        /* Destination exists (resolved through symlinks) */
        if (!S_ISREG(dest_stat.st_mode)) {
            fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
                    S_ISDIR(dest_stat.st_mode) ? "Is a directory" : "Inappropriate file type");
            return -1;
        }
        /* Self-copy detection */
        if (src_stat.st_dev == dest_stat.st_dev &&
            src_stat.st_ino == dest_stat.st_ino) {
            fprintf(stderr, "cp: '%s' and '%s' are the same file\n", src, dest);
            return -1;
        }
        dest_existed = 1;
        dest_mode = dest_stat.st_mode & 07777;
    } else if (errno == ENOENT) {
        /* Destination doesn't exist - that's fine, we'll create it.
           But check if it's a dangling symlink */
        struct stat lstat_result;
        if (lstat(dest, &lstat_result) == 0) {
            if (S_ISLNK(lstat_result.st_mode)) {
                fprintf(stderr, "cp: cannot create '%s': No such file or directory\n", dest);
                return -1;
            }
        }
        /* Parent must exist - we'll find out when we try to open */
    } else {
        fprintf(stderr, "cp: cannot stat '%s': %s\n", dest, strerror(errno));
        return -1;
    }

    /* Open source for reading */
    src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "cp: cannot open '%s' for reading: %s\n", src, strerror(errno));
        return -1;
    }

    /* Open destination for writing */
    if (dest_existed) {
        dest_fd = open(dest, O_WRONLY | O_TRUNC);
    } else {
        dest_fd = open(dest, O_WRONLY | O_CREAT | O_TRUNC,
                       src_stat.st_mode & 07777);
    }
    if (dest_fd < 0) {
        fprintf(stderr, "cp: cannot create '%s': %s\n", dest, strerror(errno));
        close(src_fd);
        return -1;
    }

    /* Copy data */
    for (;;) {
        nread = read(src_fd, buf, sizeof(buf));
        if (nread < 0) {
            fprintf(stderr, "cp: error reading '%s': %s\n", src, strerror(errno));
            goto fail;
        }
        if (nread == 0) break;
        nwritten = 0;
        while (nwritten < nread) {
            ssize_t w = write(dest_fd, buf + nwritten, nread - nwritten);
            if (w < 0) {
                fprintf(stderr, "cp: error writing '%s': %s\n", dest, strerror(errno));
                goto fail;
            }
            nwritten += w;
        }
    }

    close(src_fd);
    close(dest_fd);
    return 0;

fail:
    close(src_fd);
    close(dest_fd);
    return -1;
}
```

