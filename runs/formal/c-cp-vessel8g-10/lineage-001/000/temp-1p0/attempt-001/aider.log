```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>

static int copy_path(const char *src, const char *dest) {
    struct stat src_stat, dest_stat;
    int src_fd, dest_fd;
    char buf[65536];
    ssize_t nread, nwritten;
    int dest_existed = 0;

    if (stat(src, &src_stat) != 0) {
        fprintf(stderr, "cp: cannot stat '%s': %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISREG(src_stat.st_mode)) {
        fprintf(stderr, "cp: '%s': not a regular file\n", src);
        return -1;
    }

    if (stat(dest, &dest_stat) == 0) {
        if (!S_ISREG(dest_stat.st_mode)) {
            fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
                    S_ISDIR(dest_stat.st_mode) ? "Is a directory" : "Inappropriate file type in operand");
            return -1;
        }
        if (src_stat.st_dev == dest_stat.st_dev &&
            src_stat.st_ino == dest_stat.st_ino) {
            fprintf(stderr, "cp: '%s' and '%s' are the same file\n", src, dest);
            return -1;
        }
        dest_existed = 1;
    } else {
        /* Distinguish dangling symlink from non-existent path */
        struct stat ls;
        if (lstat(dest, &ls) == 0 && S_ISLNK(ls.st_mode)) {
            fprintf(stderr, "cp: cannot create '%s': No such file or directory\n", dest);
            return -1;
        }
    }

    src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "cp: cannot open '%s' for reading: %s\n", src, strerror(errno));
        return -1;
    }

    if (dest_existed) {
        dest_fd = open(dest, O_WRONLY | O_TRUNC);
    } else {
        dest_fd = open(dest, O_WRONLY | O_CREAT | O_TRUNC, src_stat.st_mode & 07777);
    }
    if (dest_fd < 0) {
        fprintf(stderr, "cp: cannot create '%s': %s\n", dest, strerror(errno));
        close(src_fd);
        return -1;
    }

    for (;;) {
        nread = read(src_fd, buf, sizeof(buf));
        if (nread < 0) {
            fprintf(stderr, "cp: error reading '%s': %s\n", src, strerror(errno));
            close(src_fd);
            close(dest_fd);
            return -1;
        }
        if (nread == 0) break;
        nwritten = 0;
        while (nwritten < nread) {
            ssize_t w = write(dest_fd, buf + nwritten, nread - nwritten);
            if (w < 0) {
                fprintf(stderr, "cp: error writing '%s': %s\n", dest, strerror(errno));
                close(src_fd);
                close(dest_fd);
                return -1;
            }
            nwritten += w;
        }
    }

    close(src_fd);
    close(dest_fd);
    return 0;
}

static const char *base_name(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

int main(int argc, char *argv[]) {
    int i, n_ops;
    int sep_idx = -1; /* index of -- in argv, or -1 if absent */
    char **operands;
    int n_operands = 0;
    int failed = 0;
    int *op_flags; /* 1 if from after -- */
    
    /* Phase 1: parse arguments */
    /* Find -- separator */
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            sep_idx = i;
            break;
        }
    }
    
    /* Count operands */
    n_operands = 0;
    for (i = 1; i < argc; i++) {
        if (i == sep_idx) continue;
        n_operands++;
    }
    
    operands = calloc(n_operands, sizeof(char *));
    if (!operands) {
        fprintf(stderr, "cp: out of memory\n");
        return 1;
    }
    
    n_ops = 0;
    for (i = 1; i < argc; i++) {
        if (i == sep_idx) continue;
        if (sep_idx < 0 || i < sep_idx) {
            /* Before --: check for unknown options */
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "cp: unknown option '%s'\n", argv[i]);
                free(operands);
                return 1;
            }
        }
        operands[n_ops++] = argv[i];
    }
    
    /* Phase 2: validate invocation */
    if (n_operands < 2) {
        fprintf(stderr, "cp: missing operand\n");
        free(operands);
        return 1;
    }
    
    /* If 3+ operands, last must be an existing directory */
    int last_is_dir = 0;
    int n_sources;
    const char *dir_arg = NULL;
    
    if (n_operands >= 3) {
        const char *last = operands[n_operands - 1];
        struct stat st;
        if (stat(last, &st) != 0) {
            fprintf(stderr, "cp: target '%s': No such file or directory\n", last);
            free(operands);
            return 1;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "cp: target '%s': Not a directory\n", last);
            free(operands);
            return 1;
        }
        last_is_dir = 1;
        dir_arg = last;
        n_sources = n_operands - 1;
    } else {
        /* Exactly 2 operands: SOURCE DEST */
        n_sources = 1;
        /* DEST might be a directory - we'll handle in the copy phase */
    }
    
    /* Phase 3+4: Process each source */
    for (i = 0; i < n_sources; i++) {
        const char *src = operands[i];
        char dest[4096];
        int rc;
        
        if (n_operands >= 3) {
            /* Multi-source: dest = dir/basename(src) */
            snprintf(dest, sizeof(dest), "%s/%s", dir_arg, base_name(src));
        } else {
            /* Two operands: check if DEST is a directory */
            struct stat dst;
            if (stat(operands[1], &dst) == 0 && S_ISDIR(dst.st_mode)) {
                snprintf(dest, sizeof(dest), "%s/%s", operands[1], base_name(src));
            } else {
                snprintf(dest, sizeof(dest), "%s", operands[1]);
            }
        }
        
        rc = copy_path(src, dest);
        if (rc != 0) {
            failed = 1;
        }
    }
    
    free(operands);
    return failed ? 1 : 0;
}
