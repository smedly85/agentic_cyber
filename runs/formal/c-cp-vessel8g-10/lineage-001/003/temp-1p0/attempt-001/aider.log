			fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
				S_ISDIR(dest_stat.st_mode)
					? "Is a directory"
					: "Inappropriate file type");
			return -1;
		}
		if (src_stat.st_dev == dest_stat.st_dev &&
		    src_stat.st_ino == dest_stat.st_ino) {
			fprintf(stderr, "cp: '%s' and '%s' are the same file\n",
				src, dest);
			return -1;
		}
		dest_existed = 1;
	} else {
		struct stat ls;
		if (lstat(dest, &ls) == 0 && S_ISLNK(ls.st_mode)) {
			fprintf(stderr,
				"cp: cannot create '%s': No such file or directory\n",
				dest);
			return -1;
		}
	}

	if (dest_existed && interactive_flag) {
		if (!interactive_prompt(dest))
			return 1;
	}

	src_fd = open(src, O_RDONLY);
	if (src_fd < 0) {
		fprintf(stderr, "cp: cannot open '%s' for reading: %s\n",
			src, strerror(errno));
		return -1;
	}

	if (dest_existed) {
		dest_fd = open(dest, O_WRONLY | O_TRUNC);
		if (dest_fd < 0 && force_flag) {
			struct stat ds;
			if (stat(dest, &ds) == 0 && !S_ISDIR(ds.st_mode) &&
			    unlink(dest) == 0) {
				dest_fd = open(dest, O_WRONLY | O_CREAT | O_TRUNC,
					       (mode_t)(src_stat.st_mode & 07777));
			}
		}
	} else {
		dest_fd = open(dest, O_WRONLY | O_CREAT | O_TRUNC,
			       (mode_t)(src_stat.st_mode & 07777));
	}
	if (dest_fd < 0) {
		fprintf(stderr, "cp: cannot create '%s': %s\n", dest,
			strerror(errno));
		close(src_fd);
		return -1;
	}

	for (;;) {
		nread = read(src_fd, buf, sizeof(buf));
		if (nread < 0) {
			fprintf(stderr, "cp: error reading '%s': %s\n",
				src, strerror(errno));
			goto fail;
		}
		if (nread == 0)
			break;
		nwritten = 0;
		while (nwritten < nread) {
			ssize_t w = write(dest_fd, buf + nwritten,
					 nread - nwritten);
			if (w < 0) {
				fprintf(stderr, "cp: error writing '%s': %s\n",
					dest, strerror(errno));
				goto fail;
			}
			nwritten += w;
		}
	}

	close(src_fd);
	close(dest_fd);
	return 0;

fail:
	close(src_fd);
	close(dest_fd);
	return -1;
}

static int copy_tree(const char *src, const char *dest)
{
	struct stat src_stat;
	int failed = 0;

	if (lstat(src, &src_stat) != 0) {
		fprintf(stderr, "cp: cannot stat '%s': %s\n", src, strerror(errno));
		return -1;
	}
	if (!S_ISDIR(src_stat.st_mode)) {
		fprintf(stderr, "cp: '%s': not a directory\n", src);
		return -1;
	}

	/* Self / descendant check */
	{
		struct stat ss, ds;
		if (lstat(src, &ss) == 0 && lstat(dest, &ds) == 0) {
			if (ss.st_dev == ds.st_dev && ss.st_ino == ds.st_ino) {
				fprintf(stderr,
					"cp: '%s' and '%s' are the same file\n",
					src, dest);
				return -1;
			}
		}
		/* Descendant: build absolute paths and compare prefix */
		{
			char cwd_buf[4096];
			if (getcwd(cwd_buf, sizeof(cwd_buf)) != NULL) {
				char abs_src[4096], abs_dest[4096];
				size_t al;
				if (src[0] == '/')
					al = snprintf(abs_src, sizeof(abs_src), "%s", src);
				else
					al = snprintf(abs_src, sizeof(abs_src), "%s/%s", cwd_buf, src);
				if (al < sizeof(abs_src) && al > 0) {
					size_t dl2;
					if (dest[0] == '/')
						dl2 = snprintf(abs_dest, sizeof(abs_dest), "%s", dest);
					else
						dl2 = snprintf(abs_dest, sizeof(abs_dest), "%s/%s", cwd_buf, dest);
					if (dl2 < sizeof(abs_dest) && dl2 > 0) {
						size_t sl = strlen(abs_src);
						if (strncmp(abs_dest, abs_src, sl) == 0 &&
						    (abs_dest[sl] == '/' || abs_dest[sl] == '\0')) {
							fprintf(stderr,
								"cp: cannot copy '%s' into itself or a descendant\n",
								src);
							return -1;
						}
					}
				}
			}
		}
	}

	/* Create destination directory if needed */
	{
		struct stat dst;
		if (stat(dest, &dst) != 0) {
			if (mkdir(dest, (mode_t)(src_stat.st_mode & 07777)) != 0) {
				fprintf(stderr, "cp: cannot create directory '%s': %s\n",
					dest, strerror(errno));
				return -1;
			}
		} else if (!S_ISDIR(dst.st_mode)) {
			fprintf(stderr, "cp: cannot create '%s': Not a directory\n",
				dest);
			return -1;
		}
	}

	/* Traverse and copy entries */
	DIR *dir = opendir(src);
	if (!dir) {
		fprintf(stderr, "cp: cannot open directory '%s': %s\n",
			src, strerror(errno));
		return -1;
	}

	struct dirent *entry;
	while ((entry = readdir(dir)) != NULL) {
		if (strcmp(entry->d_name, ".") == 0 ||
		    strcmp(entry->d_name, "..") == 0)
			continue;

		char e_src[4096], e_dest[4096];
		int n;
		n = snprintf(e_src, sizeof(e_src), "%s/%s", src, entry->d_name);
		if (n < 0 || (size_t)n >= sizeof(e_src)) {
			fprintf(stderr, "cp: path too long\n");
			failed = 1;
			continue;
		}
		n = snprintf(e_dest, sizeof(e_dest), "%s/%s", dest, entry->d_name);
		if (n < 0 || (size_t)n >= sizeof(e_dest)) {
			fprintf(stderr, "cp: path too long\n");
			failed = 1;
			continue;
		}

		struct stat est;
		if (lstat(e_src, &est) != 0) {
			fprintf(stderr, "cp: cannot stat '%s': %s\n",
				e_src, strerror(errno));
			failed = 1;
			continue;
		}

		if (S_ISLNK(est.st_mode)) {
			if (copy_symlink(e_src, e_dest) != 0)
				failed = 1;
		} else if (S_ISREG(est.st_mode)) {
			if (copy_path(e_src, e_dest) != 0)
				failed = 1;
		} else if (S_ISDIR(est.st_mode)) {
			if (copy_tree(e_src, e_dest) != 0)
				failed = 1;
		} else {
			fprintf(stderr, "cp: skipping '%s': unsupported file type\n",
				e_src);
			failed = 1;
		}
	}

	closedir(dir);
	return failed ? -1 : 0;
}

int main(int argc, char *argv[])
{
	int i, sep_idx = -1, n_operands = 0, n_ops = 0;
	char **operands;
	int failed = 0;
	int last_is_dir = 0;
	const char *dir_arg = NULL;
	int n_sources;

	for (i = 1; i < argc; i++) {
		if (strcmp(argv[i], "--") == 0) {
			sep_idx = i;
			break;
		}
	}

	for (i = 1; i < argc; i++) {
		if (i == sep_idx)
			break;
		if (strcmp(argv[i], "-f") == 0 || strcmp(argv[i], "--force") == 0) {
			force_flag = 1;
		} else if (strcmp(argv[i], "-i") == 0 ||
			   strcmp(argv[i], "--interactive") == 0) {
			interactive_flag = 1;
		} else if (strcmp(argv[i], "-r") == 0 ||
			   strcmp(argv[i], "--recursive") == 0) {
			recursive_flag = 1;
		} else if (argv[i][0] == '-' && argv[i][1] != '\0') {
			fprintf(stderr, "cp: unknown option '%s'\n", argv[i]);
			return 1;
		}
	}

	for (i = 1; i < argc; i++) {
		if (i == sep_idx)
			continue;
		if (sep_idx < 0 || i < sep_idx) {
			if (strcmp(argv[i], "-f") == 0 ||
			    strcmp(argv[i], "--force") == 0 ||
			    strcmp(argv[i], "-i") == 0 ||
			    strcmp(argv[i], "--interactive") == 0 ||
			    strcmp(argv[i], "-r") == 0 ||
			    strcmp(argv[i], "--recursive") == 0)
				continue;
		}
		n_operands++;
	}

	if (n_operands < 2) {
		fprintf(stderr, "cp: missing operand\n");
		return 1;
	}

	operands = malloc((size_t)n_operands * sizeof(char *));
	if (!operands) {
		fprintf(stderr, "cp: out of memory\n");
		return 1;
	}

	for (i = 1; i < argc; i++) {
		if (i == sep_idx)
			continue;
		if (sep_idx < 0 || i < sep_idx) {
			if (strcmp(argv[i], "-f") == 0 ||
			    strcmp(argv[i], "--force") == 0 ||
			    strcmp(argv[i], "-i") == 0 ||
			    strcmp(argv[i], "--interactive") == 0 ||
			    strcmp(argv[i], "-r") == 0 ||
			    strcmp(argv[i], "--recursive") == 0)
				continue;
		}
		operands[n_ops++] = argv[i];
	}

	if (n_operands >= 3) {
		struct stat st;
		const char *last = operands[n_operands - 1];
		if (stat(last, &st) != 0) {
			fprintf(stderr,
				"cp: target '%s': No such file or directory\n",
				last);
			free(operands);
			return 1;
		}
		if (!S_ISDIR(st.st_mode)) {
			fprintf(stderr,
				"cp: target '%s': Not a directory\n", last);
			free(operands);
			return 1;
		}
		last_is_dir = 1;
		dir_arg = last;
	}

	n_sources = n_operands - 1;

	for (i = 0; i < n_sources; i++) {
		const char *src = operands[i];
		char dest[4096];
		int n;

		if (last_is_dir) {
			const char *bn = base_name(src);
			size_t dl = strlen(dir_arg);
			if (dl > 0 && dir_arg[dl - 1] == '/')
				n = snprintf(dest, sizeof(dest), "%s%s",
					     dir_arg, bn);
			else
				n = snprintf(dest, sizeof(dest), "%s/%s",
					     dir_arg, bn);
			if (n < 0 || (size_t)n >= sizeof(dest)) {
				fprintf(stderr, "cp: path too long\n");
				failed = 1;
				continue;
			}
		} else {
			struct stat dst;
			if (stat(operands[1], &dst) == 0 &&
			    S_ISDIR(dst.st_mode)) {
				const char *bn = base_name(src);
				size_t dl = strlen(operands[1]);
				if (dl > 0 && operands[1][dl - 1] == '/')
					n = snprintf(dest, sizeof(dest),
						      "%s%s", operands[1], bn);
				else
					n = snprintf(dest, sizeof(dest),
						      "%s/%s", operands[1], bn);
			} else {
				n = snprintf(dest, sizeof(dest), "%s",
					     operands[1]);
			}
			if (n < 0 || (size_t)n >= sizeof(dest)) {
				fprintf(stderr, "cp: path too long\n");
				failed = 1;
				continue;
			}
		}

		{
			struct stat lst;
			if (lstat(src, &lst) != 0) {
				fprintf(stderr, "cp: cannot stat '%s': %s\n",
					src, strerror(errno));
				failed = 1;
				continue;
			}
			if (S_ISLNK(lst.st_mode)) {
				if (recursive_flag) {
					if (copy_symlink(src, dest) != 0)
						failed = 1;
				} else {
					if (copy_path(src, dest) != 0)
						failed = 1;
				}
			} else if (S_ISDIR(lst.st_mode)) {
				if (recursive_flag) {
					if (copy_tree(src, dest) != 0)
						failed = 1;
				} else {
					fprintf(stderr,
						"cp: '%s': not a regular file\n", src);
					failed = 1;
				}
			} else if (S_ISREG(lst.st_mode)) {
				if (copy_path(src, dest) != 0)
					failed = 1;
			} else {
				fprintf(stderr,
					"cp: '%s': unsupported file type\n", src);
				failed = 1;
			}
		}
	}

	free(operands);
	return failed ? 1 : 0;
}
