```c
static int recursive_flag = 0;

// New function: copy a symlink
static int copy_symlink(const char *src, const char *dest)
{
    char target[4096];
    ssize_t len = readlink(src, target, sizeof(target) - 1);
    if (len < 0) {
        fprintf(stderr, "cp: cannot read link '%s': %s\n", src, strerror(errno));
        return -1;
    }
    target[len] = '\0';
    
    // Remove existing dest if it exists
    struct stat st;
    if (lstat(dest, &st) == 0) {
        if (unlink(dest) != 0) {
            fprintf(stderr, "cp: cannot remove '%s': %s\n", dest, strerror(errno));
            return -1;
        }
    }
    
    if (symlink(target, dest) != 0) {
        fprintf(stderr, "cp: cannot create link '%s': %s\n", dest, strerror(errno));
        return -1;
    }
    return 0;
}

// New function: recursive directory copy
static int copy_tree(const char *src, const char *dest)
{
    struct stat src_stat;
    char src_real[4096], dest_real[4096];
    DIR *dir;
    struct dirent *entry;
    int failed = 0;
    
    if (lstat(src, &src_stat) != 0) {
        fprintf(stderr, "cp: cannot stat '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    // If src is a symlink, handle it in the caller. This function is only
    // called when src is a directory.
    
    // Self/descendant check
    if (realpath(src, src_real) == NULL) {
        fprintf(stderr, "cp: cannot resolve '%s': %s\n", src, strerror(errno));
        return -1;
    }
    if (realpath(dest, dest_real) == NULL) {
        // dest doesn't exist yet, which is fine
        // But we still need to check if src is inside dest or vice versa
        // Since dest doesn't exist, it can't be an ancestor of src
        // But src could be an ancestor of dest... let's check
        // Actually if dest doesn't exist, realpath will fail.
        // We need to check if dest would be inside src.
        // Let's check if dest starts with src_real + "/"
        size_t srclen = strlen(src_real);
        if (strncmp(dest, src_real, srclen) == 0 && (dest[srclen] == '/' || dest[srclen] == '\0')) {
            fprintf(stderr, "cp: cannot copy '%s' into itself\n", src);
            return -1;
        }
        // Also check if dest == src
        if (strcmp(dest, src_real) == 0) {
            fprintf(stderr, "cp: '%s' and '%s' are the same file\n", src, dest);
            return -1;
        }
    } else {
        if (strcmp(src_real, dest_real) == 0) {
            fprintf(stderr, "cp: '%s' and '%s' are the same file\n", src, dest);
            return -1;
        }
        size_t srclen = strlen(src_real);
        if (strncmp(dest_real, src_real, srclen) == 0 && dest_real[srclen] == '/') {
            fprintf(stderr, "cp: cannot copy '%s' into itself or a descendant\n", src);
            return -1;
        }
    }
    
    // Create dest if it doesn't exist
    struct stat dest_stat;
    if (stat(dest, &dest_stat) != 0) {
        if (mkdir(dest, (mode_t)(src_stat.st_mode & 07777)) != 0) {
            fprintf(stderr, "cp: cannot create directory '%s': %s\n", dest, strerror(errno));
            return -1;
        }
    } else if (!S_ISDIR(dest_stat.st_mode)) {
        fprintf(stderr, "cp: cannot create '%s': Not a directory\n", dest);
        return -1;
    }
    
    dir = opendir(src);
    if (!dir) {
        fprintf(stderr, "cp: cannot open directory '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        
        char entry_src[4096], entry_dest[4096];
        int n;
        
        n = snprintf(entry_src, sizeof(entry_src), "%s/%s", src, entry->d_name);
        if (n < 0 || (size_t)n >= sizeof(entry_src)) {
            fprintf(stderr, "cp: path too long\n");
            failed = 1;
            continue;
        }
        n = snprintf(entry_dest, sizeof(entry_dest), "%s/%s", dest, entry->d_name);
        if (n < 0 || (size_t)n >= sizeof(entry_dest)) {
            fprintf(stderr, "cp: path too long\n");
            failed = 1;
            continue;
        }
        
        struct stat est;
        if (lstat(entry_src, &est) != 0) {
            fprintf(stderr, "cp: cannot stat '%s': %s\n", entry_src, strerror(errno));
            failed = 1;
            continue;
        }
        
        if (S_ISLNK(est.st_mode)) {
            if (copy_symlink(entry_src, entry_dest) != 0)
                failed = 1;
        } else if (S_ISREG(est.st_mode)) {
            if (copy_path(entry_src, entry_dest) != 0)
                failed = 1;
        } else if (S_ISDIR(est.st_mode)) {
            if (copy_tree(entry_src, entry_dest) != 0)
                failed = 1;
        } else {
            fprintf(stderr, "cp: skipping '%s': unsupported file type\n", entry_src);
            failed = 1;
        }
    }
    
    closedir(dir);
    return failed ? -1 : 0;
}
```

