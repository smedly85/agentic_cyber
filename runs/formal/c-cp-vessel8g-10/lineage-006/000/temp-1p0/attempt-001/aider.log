        fprintf(stderr, "c_cp: missing required operand\n");
        free(ops);
        return 1;
    }
    
    /* Determine source/dest structure */
    const char *dest;
    int n_src;
    const char **srcs;
    
    if (n_ops == 2) {
        n_src = 1;
        srcs = ops;
        dest = ops[1];
