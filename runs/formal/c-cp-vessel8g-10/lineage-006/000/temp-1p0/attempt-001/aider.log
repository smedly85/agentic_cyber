```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

/* Core filesystem copy: reads src (regular file or symlink to one) and
   writes its contents to dst, following dst symlinks to regular files. */
static int copy_path(const char *src, const char *dst)
{
    struct stat src_st;
    if (stat(src, &src_st) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    if (!S_ISREG(src_st.st_mode)) {
        fprintf(stderr, "c_cp: %s: not a regular file\n", src);
        return 1;
    }

    /* Determine destination state. */
    struct stat dst_st;
    int dst_exists = (stat(dst, &dst_st) == 0);
    if (!dst_exists) {
        struct stat lst;
        if (lstat(dst, &lst) == 0 && S_ISLNK(lst.st_mode)) {
            fprintf(stderr, "c_cp: %s: dangling symlink\n", dst);
            return 1;
        }
    } else {
        if (!S_ISREG(dst_st.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination not a regular file\n", dst);
            return 1;
        }
        if (src_st.st_dev == dst_st.st_dev && src_st.st_ino == dst_st.st_ino) {
            fprintf(stderr, "c_cp: '%s' and '%s': same file\n", src, dst);
            return 1;
        }
    }

    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }

    int dst_fd;
    if (dst_exists) {
        dst_fd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        dst_fd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, (mode_t)(src_st.st_mode & 0777));
    }
    if (dst_fd < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        close(src_fd);
        return 1;
    }

    char buf[65536];
    for (;;) {
        ssize_t n = read(src_fd, buf, sizeof buf);
        if (n < 0) {
            fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
            close(src_fd); close(dst_fd);
            return 1;
        }
        if (n == 0) break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, (size_t)(n - off));
            if (w < 0) {
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(src_fd); close(dst_fd);
                return 1;
            }
            off += w;
        }
    }

    close(src_fd);
    close(dst_fd);
    return 0;
}

int main(int argc, char *argv[])
{
    /* Locate '--' */
    int dd = -1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) { dd = i; break; }
    }

    /* Collect operands; before --, dash-prefixed args (except '-') are options. */
    int cap = (argc > 1) ? argc - 1 : 1;
    char **ops = malloc((size_t)cap * sizeof *ops);
    if (!ops) { fprintf(stderr, "c_cp: out of memory\n"); return 1; }
    int n_ops = 0;

    int lim = (dd >= 0) ? dd : argc;
    for (int i = 1; i < lim; i++) {
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "c_cp: unknown option: '%s'\n", argv[i]);
            free(ops);
            return 1;
        }
        ops[n_ops++] = argv[i];
    }
    for (int i = (dd >= 0 ? dd + 1 : argc); i < argc; i++) {
        ops[n_ops++] = argv[i];
    }

    if (n_ops < 2) {
        fprintf(stderr, "c_cp: missing required operand\n");
        free(ops);
        return 1;
    }

    /* Multi-source: last operand must be existing directory. */
    int n_src;
    const char *dest;
    if (n_ops == 2) {
        n_src = 1;
        dest = ops[1];
    } else {
        n_src = n_ops - 1;
        dest = ops[n_ops - 1];
        struct stat st;
        if (stat(dest, &st) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", dest, strerror(errno));
            free(ops);
            return 1;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", dest);
            free(ops);
            return 1;
        }
    }

    /* Helper: compute effective destination for a source. */
    /* For single-source where dest is not a dir: dest as-is. */
    /* Otherwise: dest/basename(src). */

    int any_fail = 0;
    for (int i = 0; i < n_src; i++) {
        const char *src = ops[i];
        char *dst = NULL;
        int use_basename = (n_ops > 2);

        if (n_ops == 2) {
            struct stat st;
            if (stat(dest, &st) == 0 && S_ISDIR(st.st_mode))
                use_basename = 1;
        }

        if (use_basename) {
            const char *base = strrchr(src, '/');
            base = base ? base + 1 : src;
            size_t dlen = strlen(dest);
            size_t blen = strlen(base);
            dst = malloc(dlen + 1 + blen + 1);
            if (!dst) { any_fail = 1; break; }
            memcpy(dst, dest, dlen);
            dst[dlen] = '/';
            memcpy(dst + dlen + 1, base, blen + 1);
        } else {
            dst = strdup(dest);
            if (!dst) { any_fail = 1; break; }
        }

        if (copy_path(src, dst) != 0)
            any_fail = 1;
        free(dst);
    }

    free(ops);
    return any_fail ? 1 : 0;
}
