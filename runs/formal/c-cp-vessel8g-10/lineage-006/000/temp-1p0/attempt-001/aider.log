int main(int argc, char *argv[])
{
    /* Locate -- */
    int dd = -1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) { dd = i; break; }
    }
    
    /* Collect operands */
    int max_ops = argc - 1;
    char **ops = malloc(max_ops * sizeof(char *));
    if (!ops) { fprintf(stderr, "c_cp: out of memory\n"); return 1; }
    int n_ops = 0;
    
    int limit = (dd >= 0) ? dd : argc;
    for (int i = 1; i < limit; i++) {
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "c_cp: unknown option: '%s'\n", argv[i]);
            free(ops);
            return 1;
