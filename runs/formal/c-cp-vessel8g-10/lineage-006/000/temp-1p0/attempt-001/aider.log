#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>

/* Core filesystem copy operation. */
static int copy_path(const char *src, const char *dst)
{
    struct stat src_st;
    struct stat dst_st;
    
    /* Resolve source (follows symlinks). */
    if (stat(src, &src_st) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    if (!S_ISREG(src_st.st_mode)) {
        fprintf(stderr, "c_cp: %s: not a regular file\n", src);
        return 1;
    }
    
    /* Check if destination exists. */
    int dst_exists = (stat(dst, &dst_st) == 0);
    if (dst_exists) {
        if (!S_ISREG(dst_st.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is not a regular file\n", dst);
            return 1;
        }
        /* Reject self-copy. */
        if (src_st.st_dev == dst_st.st_dev && src_st.st_ino == dst_st.st_ino) {
            fprintf(stderr, "c_cp: %s and %s: same file\n", src, dst);
            return 1;
        }
    }
    
    /* Open source for reading. */
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
    /* Open destination for writing. */
    int dst_fd;
    if (dst_exists) {
        dst_fd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        dst_fd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, src_st.st_mode & 0777);
    }
    if (dst_fd < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        close(src_fd);
        return 1;
    }
    
    /* Copy data. */
    char buf[65536];
    ssize_t n;
    while ((n = read(src_fd, buf, sizeof buf)) > 0) {
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, n - off);
            if (w < 0) {
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(src_fd);
                close(dst_fd);
                return 1;
            }
            off += w;
        }
    }
    if (n < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        close(src_fd);
        close(dst_fd);
        return 1;
    }
    
    close(src_fd);
    close(dst_fd);
    return 0;
}
```

