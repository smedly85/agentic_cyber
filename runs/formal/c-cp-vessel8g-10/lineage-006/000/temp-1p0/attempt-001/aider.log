        srcs = ops;
        dest = ops[n_ops - 1];
        /* Must be existing directory */
        struct stat st;
        if (stat(dest, &st) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", dest, strerror(errno));
            free(ops);
            return 1;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", dest);
            free(ops);
            return 1;
        }
    }
    
    /* Process each source */
    int any_fail = 0;
    for (int i = 0; i < n_src; i++) {
        const char *src = srcs[i];
        char *dst = NULL;
        
        /* Compute effective destination */
        if (n_ops == 2) {
            struct stat st;
            if (stat(dest, &st) == 0 && S_ISDIR(st.st_mode)) {
                const char *base = strrchr(src, '/');
                base = (base && base != src) ? base + 1 : src;
                size_t len = strlen(dest) + 1 + strlen(base) + 1;
                dst = malloc(len);
                if (!dst) { any_fail = 1; break; }
                memcpy(dst, dest, strlen(dest));
                dst[strlen(dest)] = '/';
                memcpy(dst + strlen(dest) + 1, base, strlen(base) + 1);
            } else {
                dst = strdup(dest);
