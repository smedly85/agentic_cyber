            close(src_fd);
            close(dst_fd);
            return 1;
        }
        if (n == 0)
            break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, (size_t)(n - off));
            if (w < 0) {
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(src_fd);
                close(dst_fd);
                return 1;
            }
