```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>

static int opt_force = 0;
static int opt_interactive = 0;

static int interactive_confirm(const char *dst)
{
    fprintf(stderr, "c_cp: overwrite '%s'? ", dst);
    fflush(stderr);

    int first = getchar();
    if (first == EOF) return 0;
    int c;
    while ((c = getchar()) != EOF && c != '\n')
        ;
    return (first == 'y' || first == 'Y') ? 1 : 0;
}

/*
 * copy_path: core filesystem operation.
 * Copies the regular file at 'src' to 'dst'.
 * Returns 0 on success, -1 on failure (with errno set or diagnostic printed).
 */
static int copy_path(const char *src, const char *dst)
{
    struct stat st_src;
    struct stat st_dst;
    int dst_exists = 0;
    int dst_is_symlink = 0;
    char dst_resolved[PATH_MAX];

    /* Stat the source (follows symlinks) */
    if (stat(src, &st_src) != 0) {
        fprintf(stderr, "c_cp: cannot stat '%s': %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISREG(st_src.st_mode)) {
        fprintf(stderr, "c_cp: '%s': not a regular file\n", src);
        return -1;
    }

    /* Check destination */
    if (lstat(dst, &st_dst) == 0) {
        dst_exists = 1;
        if (S_ISLNK(st_dst.st_mode)) {
            dst_is_symlink = 1;
            /* Follow the destination symlink */
            if (realpath(dst, dst_resolved) == NULL) {
                fprintf(stderr, "c_cp: '%s': dangling symlink\n", dst);
                return -1;
            }
            if (stat(dst_resolved, &st_dst) != 0) {
                fprintf(stderr, "c_cp: '%s': dangling symlink\n", dst);
                return -1;
            }
        }
        if (!S_ISREG(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: '%s': not a regular file\n", dst);
            return -1;
        }
    }

    /* Self-copy detection: compare source and destination inodes */
    {
        struct stat st_check;
        if (dst_exists && S_ISREG(st_dst.st_mode)) {
            if (st_src.st_dev == st_dst.st_dev && st_src.st_ino == st_dst.st_ino) {
                fprintf(stderr, "c_cp: '%s' and '%s' are the same file\n", src, dst);
                return -1;
            }
        }
    }

    /* Interactive prompt before overwriting existing destination */
    if (opt_interactive && dst_exists) {
        if (!interactive_confirm(dst)) {
            fprintf(stderr, "c_cp: not overwriting '%s'\n", dst);
            return -1;
        }
    }

    /* Open source for reading */
    int fd_src = open(src, O_RDONLY);
    if (fd_src < 0) {
        fprintf(stderr, "c_cp: cannot open '%s': %s\n", src, strerror(errno));
        return -1;
    }

    /* Open or create destination */
    int fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666);
    if (fd_dst < 0) {
        if (opt_force && dst_exists && !dst_is_symlink) {
            /* Force: try to remove and recreate */
            if (unlink(dst) != 0) {
                fprintf(stderr, "c_cp: cannot remove '%s': %s\n", dst, strerror(errno));
                close(fd_src);
                return -1;
            }
            fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666);
            if (fd_dst < 0) {
                fprintf(stderr, "c_cp: cannot create '%s': %s\n", dst, strerror(errno));
                close(fd_src);
                return -1;
            }
            /* New file: set source permissions masked by umask */
            mode_t umask_val = umask(0);
            umask(umask_val);
            chmod(dst, st_src.st_mode & ~umask_val & 0777);
        } else if (dst_is_symlink && opt_force) {
            /* Force with symlink dest: remove symlink and create new file */
            if (unlink(dst) != 0) {
                fprintf(stderr, "c_cp: cannot remove '%s': %s\n", dst, strerror(errno));
                close(fd_src);
                return -1;
            }
            fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666);
            if (fd_dst < 0) {
                fprintf(stderr, "c_cp: cannot create '%s': %s\n", dst, strerror(errno));
                close(fd_src);
                return -1;
            }
            mode_t umask_val = umask(0);
            umask(umask_val);
            chmod(dst, st_src.st_mode & ~umask_val & 0777);
        } else {
            fprintf(stderr, "c_cp: cannot open '%s': %s\n", dst, strerror(errno));
            close(fd_src);
            return -1;
        }
    } else {
        /* Check if this is a new file or overwrite */
        struct stat st_new;
        if (fstat(fd_dst, &st_new) == 0) {
            if (!dst_exists) {
                /* New file: set source permissions masked by umask */
                mode_t umask_val = umask(0);
                umask(umask_val);
                chmod(dst, st_src.st_mode & ~umask_val & 0777);
            }
            /* If dst existed, retain its existing permissions (already done by O_TRUNC) */
        }
    }

    /* Copy data */
    char buf[65536];
    ssize_t n;
    while ((n = read(fd_src, buf, sizeof buf)) > 0) {
        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(fd_dst, buf + written, n - written);
            if (w < 0) {
                if (errno == EINTR) continue;
                fprintf(stderr, "c_cp: write to '%s': %s\n", dst, strerror(errno));
                close(fd_src);
                close(fd_dst);
                return -1;
            }
            written += w;
        }
    }
    if (n < 0) {
        fprintf(stderr, "c_cp: read from '%s': %s\n", src, strerror(errno));
        close(fd_src);
        close(fd_dst);
        return -1;
    }

    close(fd_src);
    close(fd_dst);
    return 0;
}
```

