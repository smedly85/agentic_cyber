int main(int argc, char *argv[])
{
    const char *operands[256];
    int n_operands = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        if (!after_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                after_ddash = 1;
                continue;
            }
            if (strcmp(argv[i], "-f") == 0) {
                opt_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--force") == 0) {
                opt_force = 1;
                continue;
            }
            if (strcmp(argv[i], "-i") == 0) {
                opt_interactive = 1;
                continue;
            }
            if (strcmp(argv[i], "--interactive") == 0) {
                opt_interactive = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "c_cp: unknown option '%s'\n", argv[i]);
                return 1;
            }
        }
        operands[n_operands++] = argv[i];
    }

    /* Validate operand count */
    if (n_operands < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        return 1;
    }

    const char *last = operands[n_operands - 1];
    int multi = (n_operands > 2);

    if (multi) {
        /* Last operand must be an existing directory */
        struct stat st;
        if (stat(last, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: '%s': not a directory\n", last);
            return 1;
        }
    }

    int exit_status = 0;
    for (int i = 0; i < n_operands - 1; i++) {
        const char *src = operands[i];
        const char *dst;
        if (multi) {
            /* dst = last + "/" + basename(src) */
            const char *base = strrchr(src, '/');
            base = base ? base + 1 : src;
            size_t len = strlen(last) + 1 + strlen(base) + 1;
            char *path = malloc(len);
            if (!path) {
                fprintf(stderr, "c_cp: out of memory\n");
                return 1;
            }
            snprintf(path, len, "%s/%s", last, base);
            dst = path;
        } else {
            dst = operands[1];
        }
        if (copy_path(src, dst) != 0) {
            exit_status = 1;
        }
        if (multi) free((void*)dst);
    }

    return exit_status;
}
