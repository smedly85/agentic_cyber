static int same_file(int fd1, int fd2)
{
    struct stat st1, st2;
    if (fstat(fd1, &st1) != 0) return 0;
    if (fstat(fd2, &st2) != 0) return 0;
    return st1.st_dev == st2.st_dev && st1.st_ino == st2.st_ino;
}

static int same_file_path(const char *path1, const char *path2)
{
