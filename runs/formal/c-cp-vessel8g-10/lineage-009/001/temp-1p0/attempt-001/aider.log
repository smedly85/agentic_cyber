int copy_path(const char *src, const char *dst, int force) {
    struct stat src_stat;
    if (stat(src, &src_stat) != 0)
        return -1;
    if (!S_ISREG(src_stat.st_mode))
        return -1;

    // If dst resolves to a directory, reject
    struct stat dst_stat;
    int dst_resolves = (stat(dst, &dst_stat) == 0);
    if (dst_resolves) {
        if (S_ISDIR(dst_stat.st_mode))
            return -1;
        if (src_stat.st_dev == dst_stat.st_dev &&
            src_stat.st_ino == dst_stat.st_ino)
            return -1;
    }

    int sfd = open(src, O_RDONLY);
    if (sfd < 0)
        return -1;

    int dfd;
    if (dst_resolves) {
        // dst exists and is a regular file (or symlink to regular file)
        dfd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        // dst doesn't resolve (doesn't exist, or dangling symlink)
        // Without force: if it's a dangling symlink, reject
        struct stat lst;
        if (lstat(dst, &lst) == 0 && S_ISLNK(lst.st_mode)) {
            // dangling symlink - reject without force
            close(sfd);
            if (!force)
                return -1;
            // with force, fall through to unlink + create
            if (unlink(dst) != 0) {
                close(sfd);
                return -1;
            }
            dfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC,
                       (mode_t)(src_stat.st_mode & 0777));
            if (dfd < 0) { close(sfd); return -1; }
        } else {
            // doesn't exist at all
            dfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC,
                       (mode_t)(src_stat.st_mode & 0777));
            if (dfd < 0) { close(sfd); return -1; }
        }
    }

    if (dfd < 0) {
        // Opening existing destination failed (e.g., EACCES)
        if (force) {
            struct stat lst;
            if (lstat(dst, &lst) == 0 && !S_ISDIR(lst.st_mode)) {
                if (unlink(dst) == 0) {
