int main(int argc, char *argv[]) {
    // Phase 1: Parse arguments
    // Separate options from operands
    // Before --: - is filename, -X is unknown option (error), -- is terminator
    // After --: everything is operand
    
    const char **operands = NULL;
    int n_operands = 0;
    int after_ddash = 0;
    
    // First pass: count and validate
    // Actually, let's collect operands into an array
    
    // We need to be careful about memory. Let's just use the argv array directly.
    // Collect operand indices.
    
    int *operand_idx = malloc(argc * sizeof(int)); // will free
    if (!operand_idx) {
        // Can't even malloc
        fprintf(stderr, "c_cp: out of memory\n");
        return 1;
    }
    
    for (int i = 1; i < argc; i++) {
        if (!after_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                after_ddash = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // Unknown option (bare - is filename)
                fprintf(stderr, "c_cp: unknown option: %s\n", argv[i]);
                free(operand_idx);
                return 1;
            }
        }
        operand_idx[n_operands++] = i;
    }
    
    if (n_operands < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        free(operand_idx);
        return 1;
    }
    
    // Determine sources and destinations
    // If n_operands > 2: last is directory, rest are sources
    // If n_operands == 2: could be src dst, or src dir (if dst is dir)
    
    int n_sources;
    const char *dest_dir = NULL;
    
    if (n_operands > 2) {
        dest_dir = argv[operand_idx[n_operands - 1]];
        n_sources = n_operands - 1;
        // Validate dest_dir is existing directory
        struct stat dstat;
        if (stat(dest_dir, &dstat) != 0 || !S_ISDIR(dstat.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", dest_dir);
            free(operand_idx);
            return 1;
        }
    } else {
        n_sources = 1;
    }
    
    // For each source, determine effective destination and copy
    int any_failure = 0;
    
    for (int i = 0; i < n_sources; i++) {
        const char *src = argv[operand_idx[i]];
        const char *dst;
        
        if (dest_dir) {
            // dst = dest_dir / basename(src)
            const char *base = strrchr(src, '/');
            base = base ? base + 1 : src;
            // Need to construct path
            size_t dlen = strlen(dest_dir);
            size_t blen = strlen(base);
            char *path = malloc(dlen + 1 + blen + 1);
            if (!path) {
                fprintf(stderr, "c_cp: %s: out of memory\n", src);
                any_failure = 1;
                continue;
            }
            memcpy(path, dest_dir, dlen);
            path[dlen] = '/';
            memcpy(path + dlen + 1, base, blen + 1);
            dst = path;
        } else {
            dst = argv[operand_idx[1]];
        }
        
        if (copy_path(src, dst) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
            any_failure = 1;
        }
        
        if (dest_dir) free((void*)dst); // careful: dst is path
    }
    
    free(operand_idx);
    return any_failure ? 1 : 0;
}
