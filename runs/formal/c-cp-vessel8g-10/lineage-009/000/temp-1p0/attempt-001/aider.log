#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>
#include <limits.h>

static int copy_file_data(int src_fd, int dst_fd) {
    char buf[65536];
    for (;;) {
        ssize_t nread = read(src_fd, buf, sizeof(buf));
        if (nread < 0) {
            if (errno == EINTR) continue;
            return -1;
        }
        if (nread == 0) break;
        ssize_t total = 0;
        while (total < nread) {
            ssize_t nwritten = write(dst_fd, buf + total, nread - total);
            if (nwritten < 0) {
                if (errno == EINTR) continue;
                return -1;
            }
            total += nwritten;
        }
    }
    return 0;
}

int copy_path(const char *src, const char *dst) {
    struct stat src_stat;
    if (stat(src, &src_stat) != 0)
        return -1;
    if (!S_ISREG(src_stat.st_mode))
        return -1;
    
    struct stat dst_stat;
    int dst_exists = (stat(dst, &dst_stat) == 0);
    
    if (dst_exists) {
        if (!S_ISREG(dst_stat.st_mode))
            return -1;
        // Self-copy check
        if (src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino)
            return -1;
    } else {
        // Check if it's a dangling symlink
        struct stat lst;
        if (lstat(dst, &lst) == 0 && S_ISLNK(lst.st_mode))
            return -1;
        // Also check if it's a symlink to something non-regular
        // Actually if stat failed and lstat succeeded as symlink, it's dangling
        // If lstat also failed, it just doesn't exist - OK to create
    }
    
    // Open source
    int sfd = open(src, O_RDONLY);
    if (sfd < 0)
        return -1;
    
    int dfd;
    if (dst_exists) {
        dfd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        dfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, src_stat.st_mode & 07777);
    }
    if (dfd < 0) {
        close(sfd);
        return -1;
    }
    
    int rc = copy_file_data(sfd, dfd);
    close(sfd);
    close(dfd);
    return rc;
}
```

