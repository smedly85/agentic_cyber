static int is_self_or_descendant(const char *src, const char *dest) {
    char *src_real = realpath(src, NULL);
    if (!src_real) return 0; // can't determine, let it fail naturally
    char *dest_real = NULL;
    if (access(dest, F_OK) == 0) {
        dest_real = realpath(dest, NULL);
    }
    if (!dest_real) {
        // dest doesn't exist or realpath failed
        // Try to resolve parent + basename
        // For simplicity, check lexically
        char cwd[PATH_MAX];
        if (!getcwd(cwd, sizeof(cwd))) { free(src_real); return 0; }
        // Make dest absolute if needed
        char dest_abs[PATH_MAX];
        if (dest[0] == '/')
            snprintf(dest_abs, sizeof(dest_abs), "%s", dest);
        else
            snprintf(dest_abs, sizeof(dest_abs), "%s/%s", cwd, dest);
        // Check if dest_abs starts with src_real + "/"
        size_t srclen = strlen(src_real);
        if (strncmp(dest_abs, src_real, srclen) == 0 && dest_abs[srclen] == '/') {
            free(src_real);
            return 1;
        }
        free(src_real);
        return 0;
    }
    // Both resolved
    if (strcmp(src_real, dest_real) == 0) { free(src_real); free(dest_real); return 1; }
    size_t srclen = strlen(src_real);
    if (strncmp(dest_real, src_real, srclen) == 0 && dest_real[srclen] == '/') {
        free(src_real); free(dest_real);
        return 1;
    }
    free(src_real); free(dest_real);
    return 0;
}
```

