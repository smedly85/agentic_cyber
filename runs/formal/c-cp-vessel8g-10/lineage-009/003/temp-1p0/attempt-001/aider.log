#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>
#include <dirent.h>
#include <limits.h>

#ifndef PATH_MAX
#define PATH_MAX 4096
#endif

static int copy_file_data(int src_fd, int dst_fd) {
    char buf[65536];
    for (;;) {
        ssize_t nread = read(src_fd, buf, sizeof(buf));
        if (nread < 0) {
            if (errno == EINTR)
                continue;
            return -1;
        }
        if (nread == 0)
            break;
        ssize_t written = 0;
        while (written < nread) {
            ssize_t nw = write(dst_fd, buf + written, (size_t)(nread - written));
            if (nw < 0) {
                if (errno == EINTR)
                    continue;
                return -1;
            }
            written += nw;
        }
    }
    return 0;
}

int copy_path(const char *src, const char *dst, int force, int interactive) {
    struct stat src_stat;
    if (stat(src, &src_stat) != 0)
        return -1;
    if (!S_ISREG(src_stat.st_mode))
        return -1;

    /* Pre-checks: reject directory destinations and self-copy before
       any destructive action. */
    struct stat dst_stat;
    int dst_resolves = (stat(dst, &dst_stat) == 0);
    if (dst_resolves) {
        if (S_ISDIR(dst_stat.st_mode))
            return -1;
        if (src_stat.st_dev == dst_stat.st_dev &&
            src_stat.st_ino == dst_stat.st_ino)
            return -1;
    } else {
        struct stat lst;
        if (lstat(dst, &lst) == 0 && S_ISLNK(lst.st_mode)) {
            errno = ENOLINK;
            return -1;
        }
    }

    if (interactive && dst_resolves) {
        fprintf(stderr, "overwrite %s? ", dst);
        fflush(stderr);
        char line[64];
        if (fgets(line, sizeof(line), stdin) == NULL ||
            (line[0] != 'y' && line[0] != 'Y'))
            return -2;
    }

    int sfd = open(src, O_RDONLY);
    if (sfd < 0)
        return -1;

    int dfd = -1;

    /* Try to open the destination for writing.
       - Existing regular file (or symlink→regular): O_WRONLY|O_TRUNC works.
       - Missing path: ENOENT, fall through to O_CREAT.
       - Dangling symlink: ENOLINK (handled above). */
    dfd = open(dst, O_WRONLY | O_TRUNC);
    if (dfd < 0) {
        dfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC,
                   (mode_t)(src_stat.st_mode & 0777));
    }
    if (dfd < 0 && force) {
        /* Force: remove existing non-directory entry and create fresh. */
        struct stat lst;
        if (lstat(dst, &lst) == 0 && !S_ISDIR(lst.st_mode)) {
            if (unlink(dst) == 0) {
                dfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC,
                           (mode_t)(src_stat.st_mode & 0777));
            }
        }
    }
    if (dfd < 0) {
        close(sfd);
        return -1;
    }

    int rc = copy_file_data(sfd, dfd);
    close(sfd);
    close(dfd);
    return rc;
}

static int is_self_copy(const char *src, const char *dest) {
    char *src_real = realpath(src, NULL);
    if (!src_real)
        return 0;
    int result = 0;
    char *dest_real = NULL;
    if (access(dest, F_OK) == 0) {
        dest_real = realpath(dest, NULL);
    }
    if (dest_real) {
        if (strcmp(src_real, dest_real) == 0)
            result = 1;
        else {
            size_t sl = strlen(src_real);
            if (strncmp(dest_real, src_real, sl) == 0 && dest_real[sl] == '/')
                result = 1;
        }
        free(dest_real);
    } else {
        /* dest does not exist; lexical check against resolved src */
        char cwd[PATH_MAX];
        if (getcwd(cwd, sizeof(cwd)) == 0) {
            free(src_real);
            return 0;
        }
        char dest_abs[PATH_MAX];
        if (dest[0] == '/')
            snprintf(dest_abs, sizeof(dest_abs), "%s", dest);
        else
            snprintf(dest_abs, sizeof(dest_abs), "%s/%s", cwd, dest);
        size_t sl = strlen(src_real);
        if (strncmp(dest_abs, src_real, sl) == 0 && dest_abs[sl] == '/')
            result = 1;
    }
    free(src_real);
    return result;
}

static int recursive_copy(const char *src, const char *dst, int force, int interactive) {
    DIR *dir = opendir(src);
    if (!dir)
        return -1;
    int any_failure = 0;
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        char src_path[PATH_MAX], dst_path[PATH_MAX];
        if (snprintf(src_path, sizeof(src_path), "%s/%s", src, entry->d_name) >= (int)sizeof(src_path) ||
            snprintf(dst_path, sizeof(dst_path), "%s/%s", dst, entry->d_name) >= (int)sizeof(dst_path)) {
            any_failure = 1;
            continue;
        }
        struct stat st;
        if (lstat(src_path, &st) != 0) {
            any_failure = 1;
            continue;
        }
        if (S_ISREG(st.st_mode)) {
            if (copy_path(src_path, dst_path, force, interactive) != 0)
                any_failure = 1;
        } else if (S_ISDIR(st.st_mode)) {
            if (mkdir(dst_path, (mode_t)(st.st_mode & 0777)) != 0 && errno != EEXIST) {
                any_failure = 1;
                continue;
            }
            if (recursive_copy(src_path, dst_path, force, interactive) != 0)
                any_failure = 1;
        } else if (S_ISLNK(st.st_mode)) {
            char target[PATH_MAX];
            ssize_t tlen = readlink(src_path, target, sizeof(target) - 1);
            if (tlen < 0) {
                any_failure = 1;
                continue;
            }
            target[tlen] = '\0';
            struct stat dst_st;
            if (lstat(dst_path, &dst_st) == 0) {
                if (S_ISDIR(dst_st.st_mode)) {
                    any_failure = 1;
                    continue;
                }
                if (unlink(dst_path) != 0) {
                    any_failure = 1;
                    continue;
                }
            }
            if (symlink(target, dst_path) != 0)
                any_failure = 1;
        } else {
            any_failure = 1;
        }
    }
    closedir(dir);
    return any_failure ? -1 : 0;
}

