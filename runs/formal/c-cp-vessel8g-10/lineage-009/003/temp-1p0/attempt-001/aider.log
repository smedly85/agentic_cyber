static int is_self_copy(const char *src, const char *dest) {
    /* Same inode? */
    struct stat sst, dst_st;
    if (stat(src, &sst) == 0 && stat(dest, &dst_st) == 0) {
        if (sst.st_dev == dst_st.st_dev && sst.st_ino == dst_st.st_ino)
            return 1;
    }

    /* Dest is a path below src? (lexical, after absolutizing) */
    char cwd[PATH_MAX];
    if (getcwd(cwd, sizeof(cwd)) == 0)
        return 0;

    size_t src_len;
    const char *src_abs;
    char *src_heap = NULL;
    if (src[0] == '/') {
        src_abs = src;
        src_len = strlen(src);
    } else {
        src_len = strlen(cwd) + 1 + strlen(src);
        src_heap = malloc(src_len + 1);
        if (!src_heap) return 0;
        snprintf(src_heap, src_len + 1, "%s/%s", cwd, src);
        src_abs = src_heap;
    }

    size_t dst_len;
    const char *dest_abs;
    char *dest_heap = NULL;
    if (dest[0] == '/') {
        dest_abs = dest;
        dst_len = strlen(dest);
    } else {
        dst_len = strlen(cwd) + 1 + strlen(dest);
        dest_heap = malloc(dst_len + 1);
        if (!dest_heap) { free(src_heap); return 0; }
        snprintf(dest_heap, dst_len + 1, "%s/%s", cwd, dest);
        dest_abs = dest_heap;
    }

    int result = 0;
    if (dst_len > src_len && strncmp(dest_abs, src_abs, src_len) == 0 && dest_abs[src_len] == '/')
        result = 1;

    free(src_heap);
    free(dest_heap);
    return result;
}
```

