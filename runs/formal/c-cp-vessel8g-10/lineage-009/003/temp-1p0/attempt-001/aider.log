static int recursive_copy(const char *src, const char *dst, int force, int interactive) {
    // src and dst are the full paths to the directory being copied
    // Open src directory
    DIR *dir = opendir(src);
    if (!dir) return -1;
    
    int any_failure = 0;
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        
        char src_entry[PATH_MAX];  // need to construct path
        char dst_entry[PATH_MAX];
        // construct src_entry = src + "/" + entry->d_name
        // construct dst_entry = dst + "/" + entry->d_name
        
        struct stat st;
        if (lstat(src_entry, &st) != 0) { any_failure = 1; continue; }
        
        if (S_ISREG(st.st_mode)) {
            if (copy_path(src_entry, dst_entry, force, interactive) != 0)
                any_failure = 1;
        } else if (S_ISDIR(st.st_mode)) {
            // Create dst_entry as directory
            if (mkdir(dst_entry, (mode_t)(st.st_mode & 0777)) != 0 && errno != EEXIST) {
                any_failure = 1;
                continue;
            }
            if (recursive_copy(src_entry, dst_entry, force, interactive) != 0)
                any_failure = 1;
        } else if (S_ISLNK(st.st_mode)) {
            // Read symlink target
            char target[PATH_MAX];
            ssize_t len = readlink(src_entry, target, sizeof(target) - 1);
            if (len < 0) { any_failure = 1; continue; }
            target[len] = '\0';
            // Remove existing dst_entry if present (for recreation)
            // Actually, for symlinks in the tree, we need to handle existing ones
            // The spec says "recreated" — so if it exists, replace it
            if (lstat(dst_entry, &st) == 0) {
                if (S_ISLNK(st.st_mode) || S_ISREG(st.st_mode))
                    unlink(dst_entry);
                // If it's a directory, we can't remove it — error
                else if (S_ISDIR(st.st_mode)) {
                    any_failure = 1;
                    continue;
                }
            }
            if (symlink(target, dst_entry) != 0)
                any_failure = 1;
        } else {
            // Special files — error
            any_failure = 1;
        }
    }
    closedir(dir);
    return any_failure ? -1 : 0;
}
```

