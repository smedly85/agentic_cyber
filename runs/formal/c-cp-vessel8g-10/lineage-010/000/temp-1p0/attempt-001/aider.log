#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <limits.h>
#include <libgen.h>

// copy_path: core filesystem operation
static int copy_path(const char *src, const char *dst) {
    // Open source
    int fd_src = open(src, O_RDONLY);
    if (fd_src < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
    // Stat the source (follows symlinks)
    struct stat st_src;
    if (fstat(fd_src, &st_src) < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        close(fd_src);
        return 1;
    }
    
    // Check it's a regular file
    if (!S_ISREG(st_src.st_mode)) {
        fprintf(stderr, "c_cp: %s: not a regular file\n", src);
        close(fd_src);
        return 1;
    }
    
    // Determine if destination exists
    struct stat st_dst;
    int dst_exists = (stat(dst, &st_dst) == 0);
    
    if (dst_exists) {
        if (S_ISDIR(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is a directory\n", dst);
            close(fd_src);
            return 1;
        }
        if (S_ISLNK(st_dst.st_mode)) {
            // Already handled by stat() which follows symlinks
            // If stat succeeded and it's a regular file, we're good
        }
        if (!S_ISREG(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is not a regular file\n", dst);
            close(fd_src);
            return 1;
        }
    }
    
    // Open destination
    int fd_dst;
    if (dst_exists) {
        fd_dst = open(dst, O_WRONLY | O_TRUNC);
    } else {
        fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666); // will be masked by umask
    }
    
    if (fd_dst < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        close(fd_src);
        return 1;
    }
    
    // Copy data
    char buf[65536];
    ssize_t n;
    while ((n = read(fd_src, buf, sizeof(buf))) > 0) {
        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(fd_dst, buf + written, n - written);
            if (w < 0) {
                if (errno == EINTR) continue;
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(fd_src);
                close(fd_dst);
                return 1;
            }
            written += w;
        }
    }
    if (n < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        close(fd_src);
        close(fd_dst);
        return 1;
    }
    
    // Set permissions
    // If destination existed, retain its rwx bits
    // If new, source rwx bits masked by umask (open with 0666 already handles this via umask)
    // Actually, for new files, the mode is determined by the open() call masked by umask.
    // The prompt says "New files have source rwx bits masked by umask."
    // So I need to chmod to source rwx & ~umask for new files.
    
    if (!dst_exists) {
        // Get current umask
        mode_t umask_val = umask(0);
        umask(umask_val);
        mode_t new_mode = (st_src.st_mode & 0777) & ~umask_val;
        fchmod(fd_dst, new_mode);
    }
    // If dst existed, retain existing rwx bits (already done by not changing them)
    
    close(fd_src);
    close(fd_dst);
    return 0;
}
