```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>

static const char *get_basename(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

static int copy_path(const char *src, const char *dst) {
    struct stat st_src;
    struct stat st_dst;
    int dst_existed = 0;
    int dst_is_link = 0;

    /* Resolve source (follows symlinks). */
    if (stat(src, &st_src) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    if (!S_ISREG(st_src.st_mode)) {
        fprintf(stderr, "c_cp: %s: not a regular file\n", src);
        return 1;
    }

    /* Inspect destination. */
    struct stat st_l;
    if (lstat(dst, &st_l) == 0) {
        dst_is_link = S_ISLNK(st_l.st_mode);
    }
    if (stat(dst, &st_dst) == 0) {
        dst_existed = 1;
        if (S_ISDIR(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is a directory\n", dst);
            return 1;
        }
        if (!S_ISREG(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is not a regular file\n", dst);
            return 1;
        }
        /* Self-copy: same inode on same device. */
        if (st_src.st_dev == st_dst.st_dev && st_src.st_ino == st_dst.st_ino) {
            fprintf(stderr, "c_cp: %s: source and destination are identical\n", src);
            return 1;
        }
    } else {
        if (dst_is_link) {
            fprintf(stderr, "c_cp: %s: dangling symbolic link\n", dst);
            return 1;
        }
    }

    /* Open source for reading. */
    int fd_src = open(src, O_RDONLY);
    if (fd_src < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }

    /* Open destination for writing. */
    int fd_dst;
    if (dst_existed) {
        fd_dst = open(dst, O_WRONLY | O_TRUNC);
    } else {
        fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, st_src.st_mode & 0777);
    }
    if (fd_dst < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        close(fd_src);
        return 1;
    }

    /* Transfer data. */
    enum { BUFSZ = 65536 };
    char buf[BUFSZ];
    for (;;) {
        ssize_t n = read(fd_src, buf, BUFSZ);
        if (n < 0) {
            if (errno == EINTR) continue;
            fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
            close(fd_src);
            close(fd_dst);
            return 1;
        }
        if (n == 0) break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(fd_dst, buf + off, (size_t)(n - off));
            if (w < 0) {
                if (errno == EINTR) continue;
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(fd_src);
                close(fd_dst);
                return 1;
            }
            off += w;
        }
    }

    close(fd_src);
    if (close(fd_dst) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        return 1;
    }
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        return 1;
    }

    /* Parse arguments: collect operands, reject unknown options. */
    const char *operands[argc - 1];
    int n_op = 0;
    int ddash = 0;

    for (int i = 1; i < argc; i++) {
        if (!ddash && strcmp(argv[i], "--") == 0) {
            ddash = 1;
            continue;
        }
        if (!ddash && argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "c_cp: unknown option: %s\n", argv[i]);
            return 1;
        }
        operands[n_op++] = argv[i];
    }

    if (n_op < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        return 1;
    }

    int is_multi = (n_op > 2);

    if (is_multi) {
        struct stat st;
        if (stat(operands[n_op - 1], &st) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", operands[n_op - 1], strerror(errno));
            return 1;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", operands[n_op - 1]);
            return 1;
        }
    }

    int n_sources = is_multi ? n_op - 1 : 1;
    int any_failure = 0;

    for (int s = 0; s < n_sources; s++) {
        const char *src = operands[s];
        const char *dst;
        char *dst_heap = NULL;

        if (is_multi) {
            const char *dir = operands[n_op - 1];
            const char *base = get_basename(src);
            size_t dlen = strlen(dir);
            size_t blen = strlen(base);
            size_t extra = (dlen > 0 && dir[dlen - 1] == '/') ? 0 : 1;
            dst_heap = malloc(dlen + extra + blen + 1);
            if (!dst_heap) {
                fprintf(stderr, "c_cp: out of memory\n");
                return 1;
            }
            memcpy(dst_heap, dir, dlen);
            if (extra) dst_heap[dlen] = '/';
            memcpy(dst_heap + dlen + extra, base, blen + 1);
            dst = dst_heap;
        } else {
            dst = operands[1];
        }

        if (copy_path(src, dst) != 0) {
            any_failure = 1;
        }
        free(dst_heap);
    }

    return any_failure ? 1 : 0;
}
```

