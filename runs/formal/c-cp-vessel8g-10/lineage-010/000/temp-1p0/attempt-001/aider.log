    int after_ddash = 0;
    
    for (i = 1; i < argc; i++) {
        if (!after_ddash && strcmp(argv[i], "--") == 0) {
            after_ddash = 1;
            continue;
        }
        if (!after_ddash && argv[i][0] == '-' && argv[i][1] != '\0') {
            // Unknown option
