            return 1;
        }
        // Collect operand
        operands = realloc(operands, (n_operands + 1) * sizeof(char*));
        operands[n_operands++] = argv[i];
    }
    
    // Check operand count
    if (n_operands < 2) {
        fprintf(stderr, "c_cp: missing operand(s)\n");
        return 1;
    }
    
    // Determine if multi-source
    int is_multi = (n_operands > 2);
    
    if (is_multi) {
        // Last operand must be existing directory
        struct stat st;
        if (stat(operands[n_operands-1], &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", operands[n_operands-1]);
            return 1;
        }
    }
    
    // Process each source
    int any_failure = 0;
    int n_sources = is_multi ? (n_operands - 1) : 1;
    
    for (int s = 0; s < n_sources; s++) {
        const char *src = operands[s];
        const char *dst;
        
