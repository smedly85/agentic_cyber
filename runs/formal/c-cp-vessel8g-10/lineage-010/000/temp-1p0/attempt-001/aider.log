#include <fcntl.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <limits.h>

static int copy_path(const char *src, const char *dst) {
    struct stat st_src;
    struct stat st_dst;
    
    // Resolve source (follow symlinks)
    if (stat(src, &st_src) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    if (!S_ISREG(st_src.st_mode)) {
        fprintf(stderr, "c_cp: %s: not a regular file\n", src);
        return 1;
    }
    
    // Check destination
    int dst_is_link = 0;
    struct stat st_dst_l;
    if (lstat(dst, &st_dst_l) == 0) {
        dst_is_link = S_ISLNK(st_dst_l.st_mode);
    }
    
    if (stat(dst, &st_dst) == 0) {
        // Destination exists (possibly through symlink)
        if (S_ISDIR(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is a directory\n", dst);
            return 1;
        }
        if (!S_ISREG(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: destination is not a regular file\n", dst);
            return 1;
        }
        // Self-copy check
        if (st_src.st_dev == st_dst.st_dev && st_src.st_ino == st_dst.st_ino) {
            fprintf(stderr, "c_cp: %s: source and destination are the same file\n", src);
            return 1;
        }
    } else {
        // Destination doesn't exist (or is dangling symlink)
        if (dst_is_link) {
            fprintf(stderr, "c_cp: %s: destination symlink is dangling\n", dst);
            return 1;
        }
        // Check parent exists (don't create missing parents)
        // open() will fail with ENOENT if parent doesn't exist
    }
    
    // Open source
    int fd_src = open(src, O_RDONLY);
    if (fd_src < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
    // Open destination
    int fd_dst;
    int dst_existed = (stat(dst, &st_dst) == 0);
    if (dst_existed) {
        fd_dst = open(dst, O_WRONLY | O_TRUNC);
    } else {
        fd_dst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, st_src.st_mode & 0777);
    }
    if (fd_dst < 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        close(fd_src);
        return 1;
    }
    
    // Copy data
    enum { BUFSZ = 65536 };
    char buf[BUFSZ];
    for (;;) {
        ssize_t n = read(fd_src, buf, BUFSZ);
        if (n < 0) {
            if (errno == EINTR) continue;
            fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
            close(fd_src);
            close(fd_dst);
            return 1;
        }
        if (n == 0) break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(fd_dst, buf + off, (size_t)(n - off));
            if (w < 0) {
                if (errno == EINTR) continue;
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                close(fd_src);
                close(fd_dst);
                return 1;
            }
            off += w;
        }
    }
    
    close(fd_src);
    if (close(fd_dst) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
        return 1;
    }
    
    return 0;
}
