            base = base ? base + 1 : src;
            
            char *dst_path;
            size_t dlen = strlen(operands[n_operands-1]);
            size_t blen = strlen(base);
            dst_path = malloc(dlen + 1 + blen + 1);
            if (!dst_path) {
                fprintf(stderr, "c_cp: out of memory\n");
                return 1;
            }
            memcpy(dst_path, operands[n_operands-1], dlen);
            dst_path[dlen] = '/';
