        char target[4096];
        ssize_t len = readlink(src, target, sizeof(target) - 1);
        if (len < 0) {
            fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
            return 1;
        }
        target[len] = '\0';
        
        // If dst exists, remove it
        struct stat st_dst;
        if (lstat(dst, &st_dst) == 0) {
            if (unlink(dst) != 0) {
                fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
                return 1;
            }
        }
        if (symlink(target, dst) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
            return 1;
        }
        return 0;
    }
    
    struct stat st;
    if (stat(src, &st) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
    if (S_ISREG(st.st_mode)) {
        return copy_path(src, dst, force, interactive);
    }
    
    if (!S_ISDIR(st.st_mode)) {
        fprintf(stderr, "c_cp: %s: unsupported file type\n", src);
        return 1;
    }
    
    // It's a directory - self-copy check
    // ... (see below)
    
    // Create dst directory if needed
    struct stat st_dst;
    if (lstat(dst, &st_dst) == 0) {
        if (!S_ISDIR(st_dst.st_mode)) {
            fprintf(stderr, "c_cp: %s: not a directory\n", dst);
            return 1;
        }
    } else {
        if (mkdir(dst, st.st_mode & 0777) != 0) {
            fprintf(stderr, "c_cp: %s: %s\n", dst, strerror(errno));
            return 1;
        }
    }
    
    // Iterate entries
    DIR *dir = opendir(src);
    if (!dir) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
    int any_failure = 0;
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        
        // Build src_child and dst_child paths
        size_t src_len = strlen(src);
        size_t name_len = strlen(entry->d_name);
        size_t dst_len = strlen(dst);
        int src_slash = (src_len > 0 && src[src_len-1] == '/') ? 0 : 1;
        int dst_slash = (dst_len > 0 && dst[dst_len-1] == '/') ? 0 : 1;
        
        char src_child[4096], dst_child[4096];
        if (src_len + src_slash + name_len + 1 > sizeof(src_child) ||
            dst_len + dst_slash + name_len + 1 > sizeof(dst_child)) {
            fprintf(stderr, "c_cp: path too long\n");
            any_failure = 1;
            continue;
        }
        
        memcpy(src_child, src, src_len);
        if (src_slash) src_child[src_len] = '/';
        memcpy(src_child + src_len + src_slash, entry->d_name, name_len + 1);
        
        memcpy(dst_child, dst, dst_len);
        if (dst_slash) dst_child[dst_len] = '/';
        memcpy(dst_child + dst_len + dst_slash, entry->d_name, name_len + 1);
        
        if (copy_recursive(src_child, dst_child, force, interactive) != 0) {
            any_failure = 1;
        }
    }
    closedir(dir);
    return any_failure ? 1 : 0;
}
