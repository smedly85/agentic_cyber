static int copy_recursive(const char *src, const char *dst, int force, int interactive) {
    struct stat lst;
    if (lstat(src, &lst) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
    }
    
