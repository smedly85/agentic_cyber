    return slash ? slash + 1 : path;
}

static int copy_path(const char *src, const char *dst, int force) {
    struct stat st_src;

    if (stat(src, &st_src) != 0) {
        fprintf(stderr, "c_cp: %s: %s\n", src, strerror(errno));
        return 1;
