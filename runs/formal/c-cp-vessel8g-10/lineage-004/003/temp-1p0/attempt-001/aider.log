static int path_is_self_or_descendant(const char *dir, const char *path)
{
    struct stat dir_st, path_st;
    if (stat(dir, &dir_st) == 0 && stat(path, &path_st) == 0) {
        if (dir_st.st_dev == path_st.st_dev && dir_st.st_ino == path_st.st_ino)
            return 1;
    }

