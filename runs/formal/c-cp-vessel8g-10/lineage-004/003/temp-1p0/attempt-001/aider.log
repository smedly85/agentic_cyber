static int path_is_self_or_descendant(const char *dir, const char *path) {
    char cd[PATH_MAX], cp[PATH_MAX];
    if (realpath(dir, cd) == NULL) return 0;
    if (realpath(path, cp) == NULL) {
        // path doesn't exist; canonicalize parent + append basename
        char parent_buf[PATH_MAX];
        char *slash = strrchr(path, '/');
        const char *basename_part;
        if (slash == NULL) {
            if (realpath(".", cp) == NULL) return 0;
            basename_part = path;
        } else {
            size_t plen = slash - path;
            if (plen == 0) {
                cp[0] = '/'; cp[1] = '\0';
            } else {
                memcpy(parent_buf, path, plen);
                parent_buf[plen] = '\0';
                if (realpath(parent_buf, cp) == NULL) return 0;
            }
            basename_part = slash + 1;
        }
        // Append basename to cp
        size_t cplen = strlen(cp);
