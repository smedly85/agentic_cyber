static int is_self_copy(const char *src_dir, const char *effective_dest)
{
    char can_src[PATH_MAX], can_dest[PATH_MAX];
    if (realpath(src_dir, can_src) == NULL) return 0; // can't determine, let it fail naturally
    
    if (realpath(effective_dest, can_dest) == NULL) {
        // Dest doesn't exist. Try to canonicalize its parent.
        // Find the last '/' and try to realpath the parent.
        char parent[PATH_MAX];
        size_t len = strlen(effective_dest);
        if (len == 0) return 0;
        // Copy up to last '/'
        char *last_slash = strrchr(effective_dest, '/');
        if (!last_slash) {
            // Relative path with no slash - parent is "."
            if (realpath(".", can_dest) == NULL) return 0;
            // Append the filename
            strncat(can_dest, effective_dest, sizeof(can_dest) - strlen(can_dest) - 1);
        } else {
            size_t parent_len = last_slash - effective_dest;
            if (parent_len == 0) {
                strncpy(can_dest, "/", sizeof(can_dest));
            } else {
                memcpy(parent, effective_dest, parent_len);
                parent[parent_len] = '\0';
                if (realpath(parent, can_dest) == NULL) return 0;
            }
            // Append remaining
            strncat(can_dest, last_slash, sizeof(can_dest) - strlen(can_dest) - 1);
        }
    }
    
    // Now compare: is can_dest == can_src or can_dest starts with can_src + "/"
    size_t src_len = strlen(can_src);
    if (strcmp(can_dest, can_src) == 0) return 1;
    if (strncmp(can_dest, can_src, src_len) == 0 && can_dest[src_len] == '/') return 1;
    return 0;
}
```

