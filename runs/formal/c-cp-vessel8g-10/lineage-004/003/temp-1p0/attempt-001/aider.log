            fprintf(stderr, "cp: cannot copy '%s' to '%s': %s\n", src_path, dst_path, strerror(errno));
            *any_failed = 1;
        }
        return 0;
    }
    if (S_ISDIR(st.st_mode)) {
        // Create dest directory if needed
        if (mkdir(dst_path, st.st_mode & 0777) != 0 && errno != EEXIST) {
            fprintf(stderr, "cp: cannot create directory '%s': %s\n", dst_path, strerror(errno));
