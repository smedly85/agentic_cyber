static int is_self_or_ancestor(const char *dir, const char *path) {
    char can_dir[PATH_MAX], can_path[PATH_MAX];
    if (realpath(dir, can_dir) == NULL) return 0;
    if (realpath(path, can_path) == NULL) {
        // path doesn't exist; try parent
        char tmp[PATH_MAX];
        char *last_slash = strrchr(path, '/');
        if (!last_slash) {
            if (realpath(".", can_path) == NULL) return 0;
            size_t len = strlen(can_path);
            snprintf(can_path + len, sizeof(can_path) - len, "/%s", path);
        } else {
            size_t parent_len = last_slash - path;
            if (parent_len == 0) {
                strcpy(can_path, "/");
            } else {
                memcpy(tmp, path, parent_len);
                tmp[parent_len] = '\0';
                if (realpath(tmp, can_path) == NULL) return 0;
            }
            size_t len = strlen(can_path);
            if (can_path[len-1] != '/') {
                can_path[len] = '/';
                can_path[len+1] = '\0';
                len += 1;
            }
            size_t rest_len = strlen(last_slash);
            if (len + rest_len >= sizeof(can_path)) return 0;
            memcpy(can_path + len, last_slash, rest_len);
        }
    }
    size_t dl = strlen(can_dir);
    if (strcmp(can_dir, can_path) == 0) return 1;
    if (strncmp(can_dir, can_path, dl) == 0 && can_path[dl] == '/') return 1;
    return 0;
}
