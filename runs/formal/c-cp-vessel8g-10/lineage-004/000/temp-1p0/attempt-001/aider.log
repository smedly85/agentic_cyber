            fprintf(stderr, "cp: '%s' is a directory\n", src);
            any_failed = 1;
            continue;
        }

        if (copy_path(src, dst) != 0) {
            fprintf(stderr, "cp: cannot copy '%s' to '%s'\n", src, dst);
            any_failed = 1;
        }
    }

    return any_failed ? 1 : 0;
}
