static int copy_path(const char *src, const char *dst)
{
    struct stat src_st;
    struct stat dst_st;
    int dst_exists = 0;

    if (stat(src, &src_st) != 0)
        return -1;
    if (!S_ISREG(src_st))
        return -1;

    if (stat(dst, &dst_st) == 0) {
        dst_exists = 1;
        if (!S_ISREG(dst_st))
