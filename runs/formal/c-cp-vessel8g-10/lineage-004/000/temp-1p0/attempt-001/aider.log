#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <limits.h>

static int copy_path(const char *src, const char *dst) {
    struct stat src_st;
    if (stat(src, &src_st) != 0)
        return -1;
    if (!S_ISREG(src_st))
        return -1;
    
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0)
        return -1;
    
    int dst_flags = O_WRONLY | O_CREAT | O_TRUNC;
    mode_t dst_mode = src_st.st_mode & 07777;
    
    int dst_fd = open(dst, dst_flags, dst_mode);
    if (dst_fd < 0) {
        close(src_fd);
        return -1;
    }
    
    char buf[65536];
    ssize_t n;
    while ((n = read(src_fd, buf, sizeof(buf))) > 0) {
        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(dst_fd, buf + written, n - written);
            if (w < 0) {
                if (errno == EINTR) continue;
                close(src_fd);
                close(dst_fd);
                return -1;
            }
            written += w;
        }
    }
    if (n < 0) {
        close(src_fd);
        close(dst_fd);
        return -1;
    }
    
    close(src_fd);
    close(dst_fd);
    return 0;
}
```

