Let me now write the full implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <limits.h>

static const char *basename_of(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

static int make_dest_path(const char *dir, const char *src, char *out, size_t outsz) {
    const char *base = basename_of(src);
    int n = snprintf(out, outsz, "%s/%s", dir, base);
    if (n < 0 || (size_t)n >= outsz)
        return -1;
    return 0;
}

static int copy_path(const char *src, const char *dst) {
    struct stat src_st;
    struct stat dst_st;
    int dst_exists = 0;
    
    /* Resolve source (follows symlinks). */
    if (stat(src, &src_st) != 0)
        return -1;
    if (!S_ISREG(src_st))
        return -1;
    
    /* Resolve destination. */
    if (stat(dst, &dst_st) == 0) {
        dst_exists = 1;
        if (!S_ISREG(dst_st))
            return -1;
    } else if (errno == ENOENT) {
        /* Check if it's a dangling symlink. */
        struct stat lstat_st;
        if (lstat(dst, &lstat_st) == 0 && S_ISLNK(lstat_st.st_mode))
            return -1; /* dangling symlink */
        /* Otherwise, parent directory may not exist, or path is truly missing.
           Either way, we'll try to open and let it fail. */
    } else {
        return -1;
    }
    
    /* Self-copy check. */
    if (dst_exists) {
        if (src_st.st_dev == dst_st.st_dev && src_st.st_ino == dst_st.st_ino)
            return -1;
    }
    
    /* Open source. */
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0)
        return -1;
    
    /* Open destination. */
    int dst_fd;
    if (dst_exists) {
        dst_fd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        mode_t mode = src_st.st_mode & 07777;
        dst_fd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, mode);
    }
    if (dst_fd < 0) {
        close(src_fd);
        return -1;
    }
    
    /* Copy data. */
    char buf[65536];
    int rc = 0;
    for (;;) {
        ssize_t n = read(src_fd, buf, sizeof(buf));
        if (n < 0) {
            if (errno == EINTR) continue;
            rc = -1;
            break;
        }
        if (n == 0) break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, (size_t)(n - off));
            if (w < 0) {
                if (errno == EINTR) continue;
                rc = -1;
                break;
            }
            off += w;
        }
        if (rc != 0) break;
    }
    
    close(src_fd);
    close(dst_fd);
    return rc;
}

int main(int argc, char *argv[]) {
    int separator_found = 0;
    int nops = 0;
    const char *ops[4096];
    
    for (int i = 1; i < argc; i++) {
        if (!separator_found && strcmp(argv[i], "--") == 0) {
            separator_found = 1;
            continue;
        }
        if (!separator_found && argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "cp: unknown option '%s'\n", argv[i]);
            return 1;
        }
        if (nops >= 4096) {
            fprintf(stderr, "cp: too many operands\n");
            return 1;
        }
        ops[nops++] = argv[i];
    }
    
    if (nops < 2) {
        fprintf(stderr, "cp: missing operand(s)\n");
        return 1;
    }
    
    int nsrc;
    const char *dest_dir = NULL;
    
    if (nops == 2) {
        nsrc = 1;
        /* Check if ops[1] is a directory */
        struct stat st;
        if (stat(ops[1], &st) == 0 && S_ISDIR(st.st_mode)) {
            dest_dir = ops[1];
        }
        /* else: ops[1] is the literal destination file */
    } else {
        nsrc = nops - 1;
        dest_dir = ops[nops - 1];
        /* Last must be existing directory */
        struct stat st;
        if (stat(dest_dir, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "cp: '%s' is not a directory\n", dest_dir);
            return 1;
        }
    }
    
    int any_failed = 0;
    
    for (int i = 0; i < nsrc; i++) {
        const char *src = ops[i];
        char dst[PATH_MAX];
        
        if (dest_dir) {
            const char *base = basename_of(src);
            if (snprintf(dst, sizeof(dst), "%s/%s", dest_dir, base) >= (int)sizeof(dst)) {
                fprintf(stderr, "cp: destination path too long for '%s'\n", src);
                any_failed = 1;
                continue;
            }
        } else {
            /* nops == 2, dest is ops[1] literally */
            if (strlen(ops[1]) >= PATH_MAX) {
                fprintf(stderr, "cp: destination path too long\n");
                any_failed = 1;
                continue;
            }
            memcpy(dst, ops[1], strlen(ops[1]) + 1);
        }
        
        /* Per-source validation: reject directory sources */
        struct stat st;
        if (stat(src, &st) == 0 && S_ISDIR(st.st_mode)) {
            fprintf(stderr, "cp: '%s' is a directory\n", src);
            any_failed = 1;
            continue;
        }
        
        if (copy_path(src, dst) != 0) {
            /* copy_path already knows what went wrong; emit generic error */
            fprintf(stderr, "cp: cannot copy '%s' to '%s': %s\n", src, dst, strerror(errno));
            any_failed = 1;
        }
    }
    
    return any_failed ? 1 : 0;
}
```

