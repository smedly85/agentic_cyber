Let me now write the complete implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <errno.h>
#include <limits.h>

static const char *get_basename(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

static char *join_path(const char *dir, const char *name) {
    size_t dir_len = strlen(dir);
    size_t name_len = strlen(name);
    int need_slash = (dir_len == 0 || dir[dir_len - 1] != '/');
    size_t total = dir_len + (need_slash ? 1 : 0) + name_len + 1;
    char *result = malloc(total);
    if (!result) return NULL;
    memcpy(result, dir, dir_len);
    size_t pos = dir_len;
    if (need_slash) result[pos++] = '/';
    memcpy(result + pos, name, name_len + 1);
    return result;
}

static int copy_path(const char *src, const char *dst) {
    struct stat src_stat;
    if (stat(src, &src_stat) != 0) {
        fprintf(stderr, "c_cp: cannot read '%s': %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISREG(src_stat.st_mode)) {
        if (S_ISDIR(src_stat.st_mode)) {
            fprintf(stderr, "c_cp: cannot copy directory '%s'\n", src);
        } else {
            fprintf(stderr, "c_cp: cannot copy '%s': not a regular file\n", src);
        }
        return -1;
    }
    
    // Determine destination type
    struct stat dst_stat;
    int dst_exists = 0;
    struct stat dst_lstat;
    
    if (lstat(dst, &dst_lstat) == 0) {
        dst_exists = 1;
        if (S_ISREG(dst_lstat.st_mode)) {
            dst_stat = dst_lstat;
        } else if (S_ISLNK(dst_lstat.st_mode)) {
            if (stat(dst, &dst_stat) != 0) {
                fprintf(stderr, "c_cp: destination '%s' is a dangling symlink\n", dst);
                return -1;
            }
            if (!S_ISREG(dst_stat.st_mode)) {
                fprintf(stderr, "c_cp: destination '%s' is not a regular file\n", dst);
                return -1;
            }
        } else if (S_ISDIR(dst_lstat.st_mode)) {
            fprintf(stderr, "c_cp: destination '%s' is a directory\n", dst);
            return -1;
        } else {
            fprintf(stderr, "c_cp: destination '%s' is not a regular file\n", dst);
            return -1;
        }
    } else if (errno != ENOENT) {
        fprintf(stderr, "c_cp: cannot access '%s': %s\n", dst, strerror(errno));
        return -1;
    }
    
    // Self-copy check
    if (dst_exists && src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino) {
        fprintf(stderr, "c_cp: '%s' and '%s' are the same file\n", src, dst);
        return -1;
    }
    
    // Open source
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "c_cp: cannot read '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    // Open destination
    int dst_fd;
    if (dst_exists) {
        dst_fd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        dst_fd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, src_stat.st_mode & 0777);
    }
    if (dst_fd < 0) {
