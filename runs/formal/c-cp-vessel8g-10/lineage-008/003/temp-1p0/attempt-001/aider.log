static int path_is_same_or_descendant(const char *ancestor, const char *descendant) {
    char anc[PATH_MAX];
    char desc[PATH_MAX];
    
    if (!realpath(ancestor, anc)) return 0;
    
    if (realpath(descendant, desc)) {
        // Both resolved
        size_t alen = strlen(anc);
        if (strncmp(anc, desc, alen) == 0 && (desc[alen] == '/' || desc[alen] == '\0'))
            return 1;
        return 0;
    }
    
    // descendant doesn't exist fully. Try to resolve as much as possible.
    // Make it absolute first.
    char abs_desc[PATH_MAX];
    if (descendant[0] != '/') {
        char cwd[PATH_MAX];
        if (!getcwd(cwd, sizeof(cwd))) return 0;
        snprintf(abs_desc, sizeof(abs_desc), "%s/%s", cwd, descendant);
    } else {
        snprintf(abs_desc, sizeof(abs_desc), "%s", descendant);
    }
    
    // Now try to resolve the longest existing prefix
    // Split by '/' and walk down
    // ... this is getting complex
    
    // Simpler: just check lexically against anc
    // anc is already a canonical absolute path
    // abs_desc is an absolute path (may have . or ..)
    // For safety, let's just check if abs_desc starts with anc + "/" or equals anc
    // This might miss some edge cases with symlinks in the path, but it's reasonable
    
    size_t alen = strlen(anc);
    if (strncmp(anc, abs_desc, alen) == 0 && (abs_desc[alen] == '/' || abs_desc[alen] == '\0'))
        return 1;
    return 0;
}
```

