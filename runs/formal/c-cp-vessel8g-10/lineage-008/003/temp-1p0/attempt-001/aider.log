```c
static int copy_tree(const char *src, const char *dst, int force, int interactive) {
    struct stat src_st;
    if (lstat(src, &src_st) != 0) {
        fprintf(stderr, "c_cp: cannot read '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    if (!S_ISDIR(src_st.st_mode)) {
        // Not a directory - handle as regular file or symlink
        // This shouldn't normally be called for non-directories in recursive mode
        // unless it's a symlink to a directory... but we lstat'd so it's the link itself
        // Actually, in recursive mode, symlinks are recreated, not followed
        // So if called with a symlink, we should just recreate the symlink
        // But this function is only called for directories
        fprintf(stderr, "c_cp: cannot copy '%s': not a directory\n", src);
        return -1;
    }
    
    // Check for self-copy
    if (would_copy_into_self(src, dst)) {
        fprintf(stderr, "c_cp: cannot copy '%s' into itself\n", src);
        return -1;
    }
    
    // Create destination directory if it doesn't exist
    struct stat dst_st;
    if (lstat(dst, &dst_st) != 0) {
        if (errno != ENOENT) {
            fprintf(stderr, "c_cp: cannot access '%s': %s\n", dst, strerror(errno));
            return -1;
        }
        if (mkdir(dst, src_st.st_mode & 0777) != 0) {
            fprintf(stderr, "c_cp: cannot create directory '%s': %s\n", dst, strerror(errno));
            return -1;
        }
    } else {
        if (!S_ISDIR(dst_st.st_mode)) {
            fprintf(stderr, "c_cp: destination '%s' is not a directory\n", dst);
            return -1;
        }
        // Existing directory - keep its permissions
    }
    
    // Iterate over src entries
    DIR *dir = opendir(src);
    if (!dir) {
        fprintf(stderr, "c_cp: cannot open directory '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    int any_failed = 0;
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        
        char *src_entry = join_path(src, entry->d_name);
        char *dst_entry = join_path(dst, entry->d_name);
        if (!src_entry || !dst_entry) {
            fprintf(stderr, "c_cp: out of memory\n");
            free(src_entry);
            free(dst_entry);
            any_failed = 1;
            continue;
        }
        
        struct stat entry_st;
        if (lstat(src_entry, &entry_st) != 0) {
            fprintf(stderr, "c_cp: cannot read '%s': %s\n", src_entry, strerror(errno));
            free(src_entry);
            free(dst_entry);
            any_failed = 1;
            continue;
        }
        
        if (S_ISDIR(entry_st.st_mode)) {
            if (copy_tree(src_entry, dst_entry, force, interactive) != 0)
                any_failed = 1;
        } else if (S_ISLNK(entry_st.st_mode)) {
            // Recreate symlink
            char target[4096];
            ssize_t len = readlink(src_entry, target, sizeof(target) - 1);
            if (len < 0) {
                fprintf(stderr, "c_cp: cannot read link '%s': %s\n", src_entry, strerror(errno));
                free(src_entry);
                free(dst_entry);
                any_failed = 1;
                continue;
            }
            target[len] = '\0';
            
            // Remove existing dst_entry if it exists (unless it's a directory)
            struct stat dst_entry_st;
            if (lstat(dst_entry, &dst_entry_st) == 0) {
                if (S_ISDIR(dst_entry_st.st_mode)) {
                    fprintf(stderr, "c_cp: cannot replace directory '%s' with symlink\n", dst_entry);
                    free(src_entry);
                    free(dst_entry);
                    any_failed = 1;
                    continue;
                }
                if (unlink(dst_entry) != 0) {
                    fprintf(stderr, "c_cp: cannot remove '%s': %s\n", dst_entry, strerror(errno));
                    free(src_entry);
                    free(dst_entry);
                    any_failed = 1;
                    continue;
                }
            }
            
            if (symlink(target, dst_entry) != 0) {
                fprintf(stderr, "c_cp: cannot create link '%s': %s\n", dst_entry, strerror(errno));
            }
        } else if (S_ISREG(entry_st.st_mode)) {
            if (copy_path(src_entry, dst_entry, force, interactive) != 0)
                any_failed = 1;
        } else {
            // Unsupported type (fifo, socket, device)
            fprintf(stderr, "c_cp: cannot copy '%s': unsupported file type\n", src_entry);
            any_failed = 1;
        }
        
        free(src_entry);
        free(dst_entry);
    }
    
    closedir(dir);
    return any_failed ? -1 : 0;
}
```

