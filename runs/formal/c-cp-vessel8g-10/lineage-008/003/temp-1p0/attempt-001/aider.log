```c
static int would_copy_into_self(const char *src, const char *dst) {
    char src_real[4096];
    struct stat src_st;
    
    if (realpath(src, src_real) == NULL) return 0;
    if (stat(src, &src_st) != 0) return 0;
    
    // If dst exists, compare real paths
    struct stat dst_st;
    if (lstat(dst, &dst_st) == 0) {
        if (dst_st.st_dev == src_st.st_dev && dst_st.st_ino == src_st.st_ino)
            return 1;
        char dst_real[4096];
        if (realpath(dst, dst_real) != NULL) {
            size_t slen = strlen(src_real);
            if (strncmp(src_real, dst_real, slen) == 0 && 
                (dst_real[slen] == '/' || dst_real[slen] == '\0'))
                return 1;
        }
        return 0;
    }
    
    // dst doesn't exist. Check if it's a descendant of src.
    // Walk up from dst to find the first existing ancestor.
    char abs_dst[4096];
    if (dst[0] == '/') {
        strncpy(abs_dst, dst, sizeof(abs_dst) - 1);
        abs_dst[sizeof(abs_dst)-1] = '\0';
    } else {
        char cwd[4096];
        if (getcwd(cwd, sizeof(cwd)) == NULL) return 0;
        snprintf(abs_dst, sizeof(abs_dst), "%s/%s", cwd, dst);
    }
    
    // Find the longest existing prefix of abs_dst
    // Try progressively shorter prefixes
    char *p = abs_dst;
    while ((p = strrchr(p + 1, '/')) != NULL) {
        *p = '\0';
        if (stat(abs_dst, &dst_st) == 0) {
            if (dst_st.st_dev == src_st.st_dev && dst_st.st_ino == src_st.st_ino)
                return 1;
            char ancestor_real[4096];
            if (realpath(abs_dst, ancestor_real) != NULL) {
                size_t slen = strlen(src_real);
                if (strncmp(src_real, ancestor_real, slen) == 0 &&
                    (ancestor_real[slen] == '/' || ancestor_real[slen] == '\0'))
                    return 1;
            }
            return 0;
        }
    }
    return 0;
}
```

