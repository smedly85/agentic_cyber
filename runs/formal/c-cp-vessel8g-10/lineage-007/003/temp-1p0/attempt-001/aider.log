                free(op);
                return 1;
            }
            op = tmp;
        }
        op[n_op++] = argv[i];
    }

    if (n_op < 2) {
        fprintf(stderr, "cp: missing operand\n");
        free(op);
        return 1;
    }

    int multi = (n_op > 2);
    const char *last = op[n_op - 1];

    if (multi) {
        struct stat st;
        if (stat(last, &st) != 0 || !S_ISDIR(st.st_mode)) {
