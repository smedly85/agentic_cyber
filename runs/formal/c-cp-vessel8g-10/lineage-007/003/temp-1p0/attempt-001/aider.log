                    continue;
                }
                if (strcmp(argv[i], "-i") == 0 || strcmp(argv[i], "--interactive") == 0) {
                    interactive = 1;
                    continue;
                }
                if (strcmp(argv[i], "-r") == 0 || strcmp(argv[i], "--recursive") == 0) {
                    recursive = 1;
                    continue;
                }
