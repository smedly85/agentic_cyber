```c
static int dst_inside_src(const char *src_dir, const char *effective_dst) {
    char src_real[PATH_MAX];
    if (realpath(src_dir, src_real) == NULL)
        return 0;
    size_t srclen = strlen(src_real);
    
    char dst_real[PATH_MAX];
    if (realpath(effective_dst, dst_real) != NULL) {
        if (strcmp(src_real, dst_real) == 0) return 1;
        if (strncmp(src_real, dst_real, srclen) == 0 && dst_real[srclen] == '/') return 1;
        return 0;
    }
    
    // effective_dst doesn't exist
    // Find longest existing prefix and resolve it
    char work[PATH_MAX];
    snprintf(work, sizeof(work), "%s", effective_dst);
    
    char existing_prefix[PATH_MAX] = "";
    for (char *p = work + 1; *p; p++) {
        if (*p == '/') {
            *p = '\0';
            if (access(work, F_OK) == 0) {
                snprintf(existing_prefix, sizeof(existing_prefix), "%s", work);
            }
            *p = '/';
        }
    }
    
    if (existing_prefix[0] == '\0') {
        // No existing prefix; do lexical comparison with cwd-relative paths
        // Get cwd
        char cwd[PATH_MAX];
        if (getcwd(cwd, sizeof(cwd)) == NULL) return 0;
        // Make src absolute
        char src_abs[PATH_MAX];
        if (src_dir[0] != '/') {
            snprintf(src_abs, sizeof(src_abs), "%s/%s", cwd, src_dir);
        } else {
            snprintf(src_abs, sizeof(src_abs), "%s", src_dir);
        }
        char dst_abs[PATH_MAX];
        if (effective_dst[0] != '/') {
            snprintf(dst_abs, sizeof(dst_abs), "%s/%s", cwd, effective_dst);
        } else {
            snprintf(dst_abs, sizeof(dst_abs), "%s", effective_dst);
        }
        // Normalize and compare (simplified: just check prefix)
        // This is a best-effort check
        return 0; // Be conservative: if we can't determine, don't reject
    }
    
    char prefix_real[PATH_MAX];
    if (realpath(existing_prefix, prefix_real) == NULL)
        return 0;
    
    size_t plen = strlen(existing_prefix);
    const char *remaining = effective_dst + plen;
    
    char combined[PATH_MAX];
    int n = snprintf(combined, sizeof(combined), "%s%s", prefix_real, remaining);
    if (n < 0 || (size_t)n >= sizeof(combined))
        return 0;
    
    if (strcmp(src_real, combined) == 0) return 1;
    if (strncmp(src_real, combined, srclen) == 0 && combined[srclen] == '/') return 1;
    return 0;
}
```

