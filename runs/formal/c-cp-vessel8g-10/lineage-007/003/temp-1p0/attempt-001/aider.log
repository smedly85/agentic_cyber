```c
static int copy_tree(const char *src, const char *dst, int force, int interactive) {
    struct stat src_st;
    if (stat(src, &src_st) != 0) {
        fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISDIR(src_st.st_mode)) {
        fprintf(stderr, "cp: %s: not a directory\n", src);
        return -1;
    }
    
    // Self-copy check
    if (dst_inside_src(src, dst)) {
        fprintf(stderr, "cp: %s: cannot copy into itself\n", src);
        return -1;
    }
    
    // Ensure dst exists as a directory
    struct stat dst_st;
    if (lstat(dst, &dst_st) == 0) {
        if (!S_ISDIR(dst_st.st_mode)) {
            fprintf(stderr, "cp: %s: destination is not a directory\n", dst);
            return -1;
        }
        // Existing directory: keep its mode
    } else {
        // Create with source's mode masked by umask (umask is applied by mkdir)
        if (mkdir(dst, src_st.st_mode & 0777) != 0) {
            fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
            return -1;
        }
    }
    
    // Copy entries
    DIR *dir = opendir(src);
    if (!dir) {
        fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
        return -1;
    }
    
    int any_fail = 0;
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        
        char src_path[PATH_MAX], dst_path[PATH_MAX];
        int n1 = snprintf(src_path, sizeof(src_path), "%s/%s", src, entry->d_name);
        int n2 = snprintf(dst_path, sizeof(dst_path), "%s/%s", dst, entry->d_name);
        if (n1 < 0 || (size_t)n1 >= sizeof(src_path) || n2 < 0 || (size_t)n2 >= sizeof(dst_path)) {
            fprintf(stderr, "cp: %s: path too long\n", entry->d_name);
            any_fail = 1;
            continue;
        }
        
        if (copy_entry(src_path, dst_path, force, interactive) != 0)
            any_fail = 1;
    }
    closedir(dir);
    
    return any_fail ? -1 : 0;
}
```

Now for `copy_entry`:
```c
static int copy_entry(const char *src, const char *dst, int force, int interactive) {
    struct stat st;
    if (lstat(src, &st) != 0) {
        fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
        return -1;
    }
    
    if (S_ISLNK(st.st_mode)) {
        char target[PATH_MAX];
        ssize_t len = readlink(src, target, sizeof(target) - 1);
        if (len < 0) {
            fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
            return -1;
        }
        target[len] = '\0';
        
        // Check if dst exists
        struct stat dst_st;
        if (lstat(dst, &dst_st) == 0) {
            if (S_ISDIR(dst_st.st_mode)) {
                fprintf(stderr, "cp: %s: destination is a directory\n", dst);
                return -1;
            }
            if (S_ISLNK(dst_st.st_mode) || S_ISREG(dst_st.st_mode)) {
                if (force) {
                    if (unlink(dst) != 0) {
                        fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
                        return -1;
                    }
                } else {
                    // Interactive?
                    if (interactive) {
                        // Prompt
                        // ... but the spec says "Destination symlink collisions within a copied tree are excluded"
                        // So this case shouldn't be tested. But let's handle it.
                        fprintf(stderr, "cp: overwrite '%s', continue? ", dst);
                        fflush(stderr);
                        char line[256];
                        if (fgets(line, sizeof(line), stdin) == NULL)
                            return -1;
                        if (line[0] != 'y' && line[0] != 'Y')
                            return -1;
                    } else {
                        fprintf(stderr, "cp: %s: destination exists\n", dst);
                        return -1;
                    }
                }
            } else {
                fprintf(stderr, "cp: %s: incompatible destination type\n", dst);
                return -1;
            }
        }
        
        if (symlink(target, dst) != 0) {
            fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
            return -1;
        }
        return 0;
    }
    
    if (S_ISDIR(st.st_mode)) {
        return copy_tree(src, dst, force, interactive);
    }
    
    if (S_ISREG(st.st_mode)) {
        return copy_path(src, dst, force, interactive);
    }
    
    fprintf(stderr, "cp: %s: unsupported file type\n", src);
    return -1;
}
```

