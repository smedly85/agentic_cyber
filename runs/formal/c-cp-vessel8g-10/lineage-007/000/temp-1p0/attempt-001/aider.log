            ssize_t w = write(dst_fd, buf + off, (size_t)(n - off));
            if (w < 0) {
                fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
                goto fail;
            }
            off += w;
        }
    }

    close(src_fd);
    close(dst_fd);
    return 0;

fail:
    close(src_fd);
    close(dst_fd);
    (void)rc;
    return -1;
}

