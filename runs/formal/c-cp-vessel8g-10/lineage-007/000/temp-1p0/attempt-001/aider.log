#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>

#define BUF_SIZE (256 * 1024)

static int copy_path(const char *src, const char *dst) {
    struct stat src_stat;
    struct stat dst_stat;
    int src_fd, dst_fd;
    char buf[BUF_SIZE];
    ssize_t n;
    int is_new = 0;
    int ret = -1;

    /* Validate source */
    if (stat(src, &src_stat) != 0) {
        fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
        return -1;
    }
    if (!S_ISREG(src_stat.st_mode)) {
        fprintf(stderr, "cp: %s: not a regular file\n", src);
        return -1;
    }

    /* Check destination */
    int dst_exists = (stat(dst, &dst_stat) == 0);
    if (dst_exists) {
        if (!S_ISREG(dst_stat.st_mode)) {
            fprintf(stderr, "cp: %s: destination is not a regular file\n", dst);
            return -1;
        }
        /* Self-copy detection */
        if (src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino) {
            fprintf(stderr, "cp: %s and %s are the same file\n", src, dst);
            return -1;
        }
    } else {
        /* Check for dangling symlink */
        struct stat lstat_buf;
        if (lstat(dst, &lstat_buf) == 0) {
            if (S_ISLNK(lstat_buf.st_mode)) {
                fprintf(stderr, "cp: %s: destination is a dangling symlink\n", dst);
                return -1;
            }
        }
        is_new = 1;
    }

    /* Open source */
    src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
        return -1;
    }

    /* Open destination */
    int flags = O_WRONLY | O_TRUNC;
    if (is_new) {
        flags |= O_CREAT;
    }
    mode_t mode = is_new ? (src_stat.st_mode & 0777) : 0;
    dst_fd = open(dst, flags, mode);
    if (dst_fd < 0) {
        fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
        close(src_fd);
        return -1;
    }

    /* Copy data */
    for (;;) {
        n = read(src_fd, buf, sizeof(buf));
        if (n < 0) {
            fprintf(stderr, "cp: %s: %s\n", src, strerror(errno));
            goto fail;
        }
        if (n == 0) break;
        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(dst_fd, buf + written, n - written);
            if (w < 0) {
                fprintf(stderr, "cp: %s: %s\n", dst, strerror(errno));
                goto fail;
            }
            written += w;
        }
    }

    close(src_fd);
    close(dst_fd);
    return 0;

fail:
    close(src_fd);
    close(dst_fd);
    return -1;
}

static const char *basename_of(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

static int make_dst_path(char *buf, size_t buf_size, const char *dir, const char *name) {
    int n = snprintf(buf, buf_size, "%s/%s", dir, name);
    if (n < 0 || (size_t)n >= buf_size) {
        return -1;
    }
    return 0;
}

int main(int argc, char *argv[]) {
    /* Parse arguments */
    int dashdash = 0;
    char **operands = NULL;
    int n_operands = 0;
    int cap = 0;

    for (int i = 1; i < argc; i++) {
        if (!dashdash) {
            if (strcmp(argv[i], "--") == 0) {
                dashdash = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "cp: unknown option: %s\n", argv[i]);
                return 1;
            }
        }
        /* It's an operand */
        if (n_operands == cap) {
            cap = cap ? cap * 2 : 8;
            char **tmp = realloc(operands, cap * sizeof(*tmp));
            if (!tmp) {
                free(operands);
                fprintf(stderr, "cp: memory allocation failed\n");
                return 1;
            }
            operands = tmp;
        }
        operands[n_operands++] = argv[i];
    }

    if (n_operands < 2) {
        fprintf(stderr, "cp: missing operand\n");
        free(operands);
        return 1;
    }

    int multi = (n_operands > 2);
    const char *last = operands[n_operands - 1];

    if (multi) {
        struct stat last_stat;
        if (stat(last, &last_stat) != 0 || !S_ISDIR(last_stat.st_mode)) {
            fprintf(stderr, "cp: %s: not a directory\n", last);
            free(operands);
            return 1;
        }
    }

    /* Process each source */
    int any_failed = 0;
    int n_sources = multi ? (n_operands - 1) : 1;

    for (int i = 0; i < n_sources; i++) {
        const char *src = operands[i];
        const char *dst;
        char dst_buf[4096];

        if (multi) {
            if (make_dst_path(dst_buf, sizeof(dst_buf), last, basename_of(src)) != 0) {
                fprintf(stderr, "cp: %s: path too long\n", src);
                any_failed = 1;
                continue;
            }
            dst = dst_buf;
        } else {
            dst = operands[1];
            /* If dst is a directory, append basename */
            struct stat dst_stat;
            if (stat(dst, &dst_stat) == 0 && S_ISDIR(dst_stat.st_mode)) {
                if (make_dst_path(dst_buf, sizeof(dst_buf), dst, basename_of(src)) != 0) {
                    fprintf(stderr, "cp: %s: path too long\n", src);
                    any_failed = 1;
                    continue;
                }
                dst = dst_buf;
            }
        }

        if (copy_path(src, dst) != 0) {
            any_failed = 1;
        }
    }

    free(operands);
    return any_failed ? 1 : 0;
}
```

