{
    int n = snprintf(buf, size, "%s/%s", dir, name);
    return (n < 0 || (size_t)n >= size) ? -1 : 0;
}

int main(int argc, char *argv[])
{
    int saw_dd = 0;
    char **op = NULL;
    int n_op = 0, cap = 0;

    for (int i = 1; i < argc; i++) {
