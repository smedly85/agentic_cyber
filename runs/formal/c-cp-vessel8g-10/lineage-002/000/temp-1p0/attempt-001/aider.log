```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>
#include <limits.h>

// copy_path: core copy operation for one file
static int copy_path(const char *src, const char *dst) {
    // 1. stat source
    struct stat src_stat;
    if (stat(src, &src_stat) != 0) return -1;
    if (S_ISDIR(src_stat.st_mode)) return -1;  // reject directory
    if (!S_ISREG(src_stat.st_mode)) return -1;  // reject non-regular
    
    // 2. Check destination
    struct stat dst_stat;
    int dst_exists = (lstat(dst, &dst_stat) == 0);
    if (dst_exists) {
        if (S_ISDIR(dst_stat.st_mode)) return -1;  // can't copy to directory
        if (S_ISLNK(dst_stat.st_mode)) {
            if (stat(dst, &dst_stat) != 0) return -1;  // dangling
            if (S_ISDIR(dst_stat.st_mode)) return -1;
            if (!S_ISREG(dst_stat.st_mode)) return -1;
        }
        if (!S_ISREG(dst_stat.st_mode) && !S_ISLNK(dst_stat.st_mode)) return -1;
        
        // Self-copy check
        if (src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino)
            return -1;
    }
    
    // 3. Open source for reading
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0) return -1;
    
    // 4. Open destination for writing
    int open_mode;
    if (dst_exists) {
        open_mode = O_WRONLY | O_TRUNC;
    } else {
        open_mode = O_WRONLY | O_CREAT | O_TRUNC;
    }
    int dst_fd = open(dst, open_mode, src_stat.st_mode);
    if (dst_fd < 0) { close(src_fd); return -1; }
    
    // 5. Copy bytes
    char buf[65536];
    ssize_t n;
    while ((n = read(src_fd, buf, sizeof buf)) > 0) {
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, n - off);
            if (w < 0) { close(src_fd); close(dst_fd); return -1; }
            off += w;
        }
    }
    if (n < 0) { close(src_fd); close(dst_fd); return -1; }
    
    close(src_fd);
    close(dst_fd);
    return 0;
}

int main(int argc, char *argv[]) {
    // Parse arguments
    // ...
    
    // For each source:
    //   call copy_path(src, dst)
    //   on failure: print diagnostic, set exit code
    
    return exit_code;
}
```

