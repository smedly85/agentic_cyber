#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>

static int copy_path(const char *src, const char *dst) {
    struct stat src_stat;
    if (stat(src, &src_stat) != 0)
        return -1;
    if (S_ISDIR(src_stat.st_mode)) {
        errno = EISDIR;
        return -1;
    }
    if (!S_ISREG(src_stat.st_mode)) {
        errno = EPERM;
        return -1;
    }
    
    struct stat dst_stat;
    int dst_exists = (lstat(dst, &dst_stat) == 0);
    if (dst_exists) {
        if (S_ISDIR(dst_stat.st_mode)) {
            errno = EISDIR;
            return -1;
        }
        if (S_ISLNK(dst_stat.st_mode)) {
            if (stat(dst, &dst_stat) != 0)
                return -1;  // dangling symlink
            if (!S_ISREG(dst_stat.st_mode)) {
                errno = EPERM;
                return -1;
            }
        } else if (!S_ISREG(dst_stat.st_mode)) {
            errno = EPERM;
            return -1;
        }
        // Self-copy check
        if (src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino) {
            errno = ELOOP;
            return -1;
        }
    }
    
    int src_fd = open(src, O_RDONLY);
    if (src_fd < 0)
        return -1;
    
    int flags = O_WRONLY;
    if (dst_exists) {
        flags |= O_TRUNC;
    } else {
        flags |= O_CREAT | O_TRUNC;
    }
    int dst_fd = open(dst, flags, src_stat.st_mode & 07777);
    if (dst_fd < 0) {
        close(src_fd);
        return -1;
    }
    
    char buf[65536];
    for (;;) {
        ssize_t n = read(src_fd, buf, sizeof buf);
        if (n < 0) {
            close(src_fd);
            close(dst_fd);
            return -1;
        }
        if (n == 0)
            break;
        ssize_t off = 0;
        while (off < n) {
            ssize_t w = write(dst_fd, buf + off, (size_t)(n - off));
            if (w < 0) {
                close(src_fd);
                close(dst_fd);
                return -1;
            }
            off += w;
        }
    }
    
    close(src_fd);
    close(dst_fd);
    return 0;
}
