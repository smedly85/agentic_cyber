                }
                if (strcmp(argv[i], "-r") == 0 || strcmp(argv[i], "--recursive") == 0) {
                    recursive = 1;
                    continue;
                }
                fprintf(stderr, "c_cp: unknown option: %s\n", argv[i]);
                return 1;
            }
        }
        if (n >= 8192) {
            fprintf(stderr, "c_cp: too many operands\n");
            return 1;
        }
        operands[n++] = argv[i];
    }

