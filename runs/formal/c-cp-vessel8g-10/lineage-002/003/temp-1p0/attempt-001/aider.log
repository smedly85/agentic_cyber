    // The dangerous case is when dst is lexically under src
    
    // Actually, the simplest check: if dst == src (same inode) or dst is under src
    struct stat dst_stat;
    int dst_exists = (lstat(dst, &dst_stat) == 0);
    
    if (dst_exists) {
        if (dst_stat.st_dev == src_stat.st_dev && dst_stat.st_ino == src_stat.st_ino) {
            errno = ELOOP;
            return -1;
        }
        if (S_ISDIR(dst_stat.st_mode)) {
            // dst is a dir, check if it's under src
            char dst_real[PATH_MAX];
            if (realpath(dst, dst_real) != NULL) {
                size_t srclen = strlen(src_real);
                if (strncmp(dst_real, src_real, srclen) == 0 && dst_real[srclen] == '/') {
                    errno = ELOOP;
                    return -1;
