static int is_under(const char *ancestor, const char *descendant) {
    size_t alen = strlen(ancestor);
    if (strncmp(descendant, ancestor, alen) != 0)
        return 0;
    if (descendant[alen] != '\0' && descendant[alen] != '/')
        return 0;
    return 1;
}
