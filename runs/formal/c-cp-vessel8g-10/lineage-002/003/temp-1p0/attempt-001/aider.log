    }

    closedir(dp);
    return rc;
}

int main(int argc, char *argv[])
{
    int force = 0;
    int interactive = 0;
    int recursive = 0;
    int seen_ddash = 0;
    const char *operands[8192];
    int n = 0;

    for (int i = 1; i < argc; i++) {
        if (!seen_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                seen_ddash = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                if (strcmp(argv[i], "-f") == 0 || strcmp(argv[i], "--force") == 0) {
                    force = 1;
