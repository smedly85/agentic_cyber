static int copy_tree(const char *src, const char *dst, int force, int interactive) {
    struct stat src_st;
    if (lstat(src, &src_st) != 0) {
        fprintf(stderr, "cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    struct stat dst_st;
    int dst_existed = (stat(dst, &dst_st) == 0);
    if (dst_existed) {
