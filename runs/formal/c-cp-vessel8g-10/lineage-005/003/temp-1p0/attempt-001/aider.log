static int is_self_or_descendant(const char *src, const char *dst) {
    // Both must exist for this check to be meaningful
    struct stat src_st, dst_st;
    if (stat(src, &src_st) != 0 || !S_ISDIR(src_st.st_mode))
        return 0;
    if (stat(dst, &dst_st) != 0)
        return 0; // dst doesn't exist yet, can't be self/descendant
    if (src_st.st_dev == dst_st.st_dev && src_st.st_ino == dst_st.st_ino)
        return 1;
    // Check if dst is under src: compare canonical paths
    char src_abs[PATH_MAX], dst_abs[PATH_MAX];
    if (!realpath(src, src_abs) || !realpath(dst, dst_abs))
        return 0;
    size_t slen = strlen(src_abs);
    if (strncmp(dst_abs, src_abs, slen) == 0 && dst_abs[slen] == '/')
        return 1;
    return 0;
}
```

