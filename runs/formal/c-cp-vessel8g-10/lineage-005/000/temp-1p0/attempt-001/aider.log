```c
const char *get_basename(const char *path) {
    const char *last_slash = strrchr(path, '/');
    if (last_slash == NULL) return path;
    if (last_slash[1] != '\0') return last_slash + 1;
    // trailing slash: go back
    // e.g., "foo/bar/" → "bar"
    // e.g., "/" → "/"
    const char *p = last_slash;
    while (p > path && p[-1] == '/') p--;
    // p points to the first char of basename
    // if p == path and path[0] == '/', return "/"
    // actually this is getting complicated for edge cases
    // For our purposes, let's just return last_slash + 1 if non-empty,
    // otherwise walk back
    // Simpler: if last_slash[1] == '\0', walk back past consecutive slashes
    const char *name = last_slash;
    while (name > path && *(name - 1) == '/') name--;
    if (name == path && path[0] == '/') return "/";
    return name;
}
```

