int copy_path(const char *src, const char *dst) {
    // 1. Open source (follows symlinks)
    int srcfd = open(src, O_RDONLY);
    if (srcfd < 0) return -1;
    
    struct stat src_stat;
    if (fstat(srcfd, &src_stat) < 0) { close(srcfd); return -1; }
    if (!S_ISREG(src_stat.st_mode)) { close(srcfd); return -1; } // reject directory or other
    
    // 2. Check destination
    //    - stat the destination (follows symlinks)
    struct stat dst_stat;
    int dst_exists = (stat(dst, &dst_stat) == 0);
    
    if (dst_exists) {
        if (!S_ISREG(dst_stat.st_mode)) { close(srcfd); return -1; } // reject non-regular dest
        // self-copy check
        if (src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino) {
            close(srcfd); return -1;
        }
    }
    
    // 3. Open destination
    int dstfd;
    if (dst_exists) {
        dstfd = open(dst, O_WRONLY | O_TRUNC);
    } else {
        dstfd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, src_stat.st_mode);
    }
    if (dstfd < 0) { close(srcfd); return -1; }
    
    // 4. Copy data
    char buf[65536];
    ssize_t n;
    while ((n = read(srcfd, buf, sizeof buf)) > 0) {
        ssize_t written = 0;
        while (written < n) {
            ssize_t w = write(dstfd, buf + written, n - written);
            if (w < 0) { close(srcfd); close(dstfd); return -1; }
            written += w;
        }
    }
    if (n < 0) { close(srcfd); close(dstfd); return -1; }
    
    close(srcfd);
    close(dstfd);
    return 0;
}

