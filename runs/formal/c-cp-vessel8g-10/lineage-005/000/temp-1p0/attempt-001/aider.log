```c
int main(int argc, char *argv[]) {
    char **operands = NULL;
    int noperands = 0;
    int see_through = 0; // after --
    
    for (int i = 1; i < argc; i++) {
        if (!see_through) {
            if (strcmp(argv[i], "--") == 0) {
                see_through = 1;
                continue;
            }
            // Check if it looks like an option
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // unknown option
                fprintf(stderr, "c_cp: unknown option '%s'\n", argv[i]);
                return 1;
            }
        }
        // it's an operand
        operands = realloc(operands, (noperands + 1) * sizeof(char*));
        operands[noperands++] = argv[i];
    }
    
    // Validate operand count
    if (noperands < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        return 1;
    }
    
    // Determine sources and destinations
    // If noperands == 2: SOURCE DEST
    // If noperands > 2: SOURCE... DIRECTORY (last must be existing directory)
    
    const char *dest_dir = NULL;
    int nsrc;
    
    if (noperands == 2) {
        nsrc = 1;
    } else {
        // last operand must be an existing directory
        dest_dir = operands[noperands - 1];
        struct stat st;
        if (stat(dest_dir, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: '%s' is not a directory\n", dest_dir);
            return 1;
        }
        nsrc = noperands - 1;
    }
    
    // Process each source
    int status = 0;
    for (int i = 0; i < nsrc; i++) {
        const char *src = operands[i];
        const char *dst;
        if (noperands == 2) {
            dst = operands[1];
        } else {
            // dest_dir / basename(src)
            // need to construct the path
            char *base = basename(src); // but basename modifies its argument...
            // Actually, let's use a different approach
            // Find the last '/'
            const char *slash = strrchr(src, '/');
            const char *name = (slash && slash[1] != '\0') ? slash + 1 : src;
            // Construct dest_dir + "/" + name
            size_t dlen = strlen(dest_dir);
            size_t nlen = strlen(name);
            char *dstbuf = malloc(dlen + 1 + nlen + 1);
            memcpy(dstbuf, dest_dir, dlen);
            dstbuf[dlen] = '/';
            memcpy(dstbuf + dlen + 1, name, nlen + 1);
            dst = dstbuf;
            // ... after copy_path, free dstbuf
        }
        if (copy_path(src, dst) != 0) {
            status = 1;
        }
    }
    return status;
}
```

