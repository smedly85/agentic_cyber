    } else {
        struct stat lst;
        if (lstat(dst, &lst) == 0) {
            if (S_ISDIR(lst.st_mode)) {
                fprintf(stderr, "c_cp: '%s': cannot create (destination is a directory)\n", dst);
                close(src_fd);
                return -1;
            }
            if (!force) {
                fprintf(stderr, "c_cp: '%s': cannot create (not a regular file or missing)\n", dst);
                close(src_fd);
                return -1;
