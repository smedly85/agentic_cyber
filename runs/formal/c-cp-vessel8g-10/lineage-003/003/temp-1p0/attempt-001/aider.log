The key insight is: `main` already resolves the destination. By the time `recursive_copy` is called, `dst` is the final path where the tree should go. So:

```c
static int recursive_copy(const char *src, const char *dst, int force, int interactive)
{
    char *src_abs = realpath(src, NULL);
    if (!src_abs) { error; return -1; }
    
    // Check dst
    struct stat dst_st;
    if (lstat(dst, &dst_st) == 0) {
        if (S_ISLNK(dst_st.st_mode)) {
            // Dangling or valid symlink at dst - can't use as tree root
            error; return -1;
        }
        if (!S_ISDIR(dst_st.st_mode)) {
            // dst exists as a file - can't use as tree root
            error; return -1;
        }
        // dst is an existing directory - use as tree root (merge)
    } else {
        // dst doesn't exist - create it as tree root
        struct stat src_st;
        int mode = 0777;
        if (lstat(src_abs, &src_st) == 0)
            mode = src_st.st_mode & 0777;
        if (mkdir(dst, mode) < 0) {
            error; return -1;
        }
    }
    
    // Self-copy check
    char *dst_abs = realpath(dst, NULL);
    if (dst_abs) {
        size_t sl = strlen(src_abs);
        if (strcmp(src_abs, dst_abs) == 0 ||
            (strncmp(src_abs, dst_abs, sl) == 0 && dst_abs[sl] == '/')) {
            free(src_abs); free(dst_abs);
            error; return -1;
        }
        free(dst_abs);
    }
    
    // Traverse
    rc_state.src_abs = src_abs;
    rc_state.dst_root = dst;
