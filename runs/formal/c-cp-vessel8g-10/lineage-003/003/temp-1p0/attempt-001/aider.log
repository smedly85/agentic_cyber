            }
            off += (size_t)w;
        }
    }

    close(src_fd);
    close(dst_fd);
    return 0;
}

static int recreate_symlink(const char *src, const char *dst)
{
    char target[PATH_MAX];
    ssize_t len = readlink(src, target, sizeof target - 1);
