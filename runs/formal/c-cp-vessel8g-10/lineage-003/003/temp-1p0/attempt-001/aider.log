            fprintf(stderr, "c_cp: '%s': %s\n", dst, strerror(errno));
            free(src_abs);
            return -1;
        }
    }

    char *dst_abs = realpath(dst, NULL);
    if (dst_abs) {
        size_t sl = strlen(src_abs);
