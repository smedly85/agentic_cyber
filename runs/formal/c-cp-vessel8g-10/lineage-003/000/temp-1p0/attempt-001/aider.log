static const char *get_basename(const char *path) {
    const char *last_slash = strrchr(path, '/');
    if (last_slash == NULL) return path;
    if (last_slash[1] == '\0') {
        // Trailing slash, go back to previous component
        // This is an edge case; for our purposes, return the last non-empty component
        // Actually, if path ends with /, it's a directory path. We shouldn't be getting here for a file.
        // Let's just return last_slash + 1 (which would be empty string) - but that's bad.
        // Better: find the component before the trailing slash.
        const char *p = last_slash;
        while (p > path && *p == '/') p--;
        // Now p points to the last non-slash char or start
        // Actually this gets complicated. Let me just handle it simply.
        return last_slash + 1; // empty string, which will cause an error when we build the path
    }
    return last_slash + 1;
}
