static int copy_path(const char *src, const char *dst) {
    struct stat src_st;
    int src_fd;
    int dst_fd;
    char buf[65536];
    ssize_t n;
    
    // Open source (follows symlinks)
    src_fd = open(src, O_RDONLY);
    if (src_fd < 0) {
        if (errno == ENOENT)
            fprintf(stderr, "c_cp: '%s': No such file or directory\n", src);
        else
            fprintf(stderr, "c_cp: '%s': %s\n", src, strerror(errno));
        return -1;
    }
    
    // Verify it's a regular file (fstat follows the fd)
    if (fstat(src_fd, &src_st) < 0) {
        fprintf(stderr, "c_cp: '%s': %s\n", src, strerror(errno));
        close(src_fd);
        return -1;
    }
    
    if (!S_ISREG(src_st.st_mode)) {
        fprintf(stderr, "c_cp: '%s': cannot copy a directory\n", src);
        close(src_fd);
        return -1;
    }
    
    // Check destination
    struct stat dst_st;
    int dst_exists = (stat(dst, &dst_st) == 0);
    
    if (dst_exists) {
        if (S_ISDIR(dst_st.st_mode)) {
            fprintf(stderr, "c_cp: '%s': cannot overwrite directory\n", dst);
            close(src_fd);
            return -1;
        }
        
        // Check self-copy
        if (src_st.st_dev == dst_st.st_dev && src_st.st_ino == dst_st.st_ino) {
            fprintf(stderr, "c_cp: '%s' and '%s' are the same file\n", src, dst);
            close(src_fd);
            return -1;
        }
        
        // Open for writing (truncates, retains permissions)
        dst_fd = open(dst, O_WRONLY | O_TRUNC);
        if (dst_fd < 0) {
            fprintf(stderr, "c_cp: '%s': %s\n", dst, strerror(errno));
            close(src_fd);
            return -1;
        }
    } else {
        // Check for dangling symlink
        struct stat lst;
        if (lstat(dst, &lst) == 0) {
            if (S_ISLNK(lst.st_mode)) {
                fprintf(stderr, "c_cp: '%s': cannot create (dangling symlink)\n", dst);
                close(src_fd);
                return -1;
            }
            // Some other type (fifo, socket, etc.) - reject
            fprintf(stderr, "c_cp: '%s': cannot create over non-regular file\n", dst);
            close(src_fd);
            return -1;
        }
        
        // Create new file with source permissions (umask applied by kernel)
        dst_fd = open(dst, O_WRONLY | O_CREAT | O_EXCL, src_st.st_mode & 0777);
        if (dst_fd < 0) {
            fprintf(stderr, "c_cp: '%s': %s\n", dst, strerror(errno));
            close(src_fd);
            return -1;
        }
    }
    
    // Copy data
    for (;;) {
        n = read(src_fd, buf, sizeof(buf));
        if (n < 0) {
            fprintf(stderr, "c_cp: '%s': read: %s\n", src, strerror(errno));
            close(src_fd);
            close(dst_fd);
            return -1;
        }
        if (n == 0) break;
