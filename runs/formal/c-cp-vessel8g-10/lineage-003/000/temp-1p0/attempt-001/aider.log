int main(int argc, char *argv[]) {
    // Collect operands
    const char **operands;
    int n_op = 0, cap = 0;
    int i;
    int no_more_options = 0;
    
    for (i = 1; i < argc; i++) {
        if (!no_more_options && strcmp(argv[i], "--") == 0) {
            no_more_options = 1;
            continue;
        }
        if (!no_more_options && argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "c_cp: invalid option -- '%s'\n", argv[i]);
            return 1;
        }
        // It's an operand
        if (n_op == cap) {
            cap = cap ? cap * 2 : 8;
            operands = realloc(operands, cap * sizeof(*operands));
            if (!operands) {
                fprintf(stderr, "c_cp: out of memory\n");
                return 1;
            }
        }
        operands[n_op++] = argv[i];
    }
    
    if (n_op < 2) {
        fprintf(stderr, "c_cp: missing operand\n");
        free(operands);
        return 1;
    }
    
    // Determine copy targets
    // Case 1: 2 operands
    // Case 2: 3+ operands (last must be existing directory)
    
    struct {
        const char *src;
        char *dst; // allocated
    } *copies;
    int n_copies;
    
    if (n_op == 2) {
        struct stat st;
        if (stat(operands[1], &st) == 0 && S_ISDIR(st.st_mode)) {
            // Directory destination: dest = dir + "/" + basename(src)
            n_copies = 1;
            copies = malloc(sizeof(*copies));
            copies[0].src = operands[0];
            const char *bn = basename_ptr(operands[0]);
            size_t len = strlen(operands[1]) + 1 + strlen(bn) + 1;
            copies[0].dst = malloc(len);
            snprintf(copies[0].dst, len, "%s/%s", operands[1], bn);
        } else {
            n_copies = 1;
            copies = malloc(sizeof(*copies));
            copies[0].src = operands[0];
            copies[0].dst = strdup(operands[1]);
        }
    } else {
        // 3+ operands, last must be existing directory
        struct stat st;
        if (stat(operands[n_op - 1], &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_cp: '%s' is not a directory\n", operands[n_op - 1]);
            free(operands);
            return 1;
        }
        n_copies = n_op - 1;
        copies = malloc(n_copies * sizeof(*copies));
        const char *dir = operands[n_op - 1];
        for (i = 0; i < n_copies; i++) {
            const char *bn = basename_ptr(operands[i]);
            size_t len = strlen(dir) + 1 + strlen(bn) + 1;
            copies[i].src = operands[i];
            copies[i].dst = malloc(len);
            snprintf(copies[i].dst, len, "%s/%s", dir, bn);
        }
    }
    
    // Process each copy
    int any_failure = 0;
    for (i = 0; i < n_copies; i++) {
        if (copy_path(copies[i].src, copies[i].dst) != 0) {
            any_failure = 1;
        }
        free(copies[i].dst);
    }
    free(copies);
    free(operands);
    return any_failure ? 1 : 0;
}
