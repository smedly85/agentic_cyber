#include <sys/types.h>

int main(int argc, char *argv[]) {
    int i = 1;
    int end_of_options = 0;
    int has_operands = 0;
    int any_failed = 0;
    
    // Parse arguments
    // First, collect operands
    // `--` marks end of options
    // Any arg starting with `-` (not bare `-`, not `--`) is unknown option
    
    // Pass 1: validate and collect operands
    char **operands = NULL;
    int n_operands = 0;
    int max_operands = 0;
    
    for (i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!end_of_options) {
            if (strcmp(arg, "--") == 0) {
                end_of_options = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                // Unknown option (not bare '-', not '--')
                fprintf(stderr, "mkdir: unknown option -- '%s'\n", arg + 1);
                return 1;
            }
        }
        // It's an operand
        if (n_operands == max_operands) {
            max_operands = max_operands == 0 ? 4 : max_operands * 2;
            char **tmp = realloc(operands, max_operands * sizeof(char*));
            if (!tmp) {
                fprintf(stderr, "mkdir: memory allocation failed\n");
                free(operands);
                return 1;
            }
            operands = tmp;
        }
        operands[n_operands++] = argv[i];
        has_operands = 1;
    }
    
    if (!has_operands) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }
    
    // Now attempt to create each directory
    for (i = 0; i < n_operands; i++) {
        if (mkdir(operands[i], 0777) != 0) {
            int e = errno;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    operands[i], strerror(e));
            any_failed = 1;
        }
    }
    
    free(operands);
    return any_failed ? 1 : 0;
}
