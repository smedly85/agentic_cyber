    if (*end_of_opts) return IS_OPERAND;
    if (a[0] != '-') return IS_OPERAND;
    if (a[1] == '\0') return IS_OPERAND;
    if (a[1] == '-' && a[2] == '\0') { *end_of_opts = 1; return IS_END_OPTS; }
    return IS_UNKNOWN_OPT;
}

int main(int argc, char *argv[]) {
    int end_of_opts = 0;
    int operand_count = 0;

    /* Validate: reject unknown options, count operands */
    for (int i = 1; i < argc; i++) {
        int cls = classify(argv[i], &end_of_opts);
        if (cls == IS_UNKNOWN_OPT) {
            if (argv[i][1] == '-')
                fprintf(stderr, "mkdir: unrecognized option '%s'\n", argv[i]);
            else
                fprintf(stderr, "mkdir: invalid option -- '%c'\n", argv[i][1]);
            return 1;
        }
        if (cls == IS_OPERAND) operand_count++;
    }

    if (operand_count == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    /* Create each directory */
    end_of_opts = 0;
    int any_failed = 0;
    for (int i = 1; i < argc; i++) {
        int cls = classify(argv[i], &end_of_opts);
        if (cls != IS_OPERAND) continue;
        if (mkdir(argv[i], 0777) != 0) {
            int e = errno;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    argv[i], strerror(e));
            any_failed = 1;
        }
    }

    return any_failed ? 1 : 0;
}
EOF
```

