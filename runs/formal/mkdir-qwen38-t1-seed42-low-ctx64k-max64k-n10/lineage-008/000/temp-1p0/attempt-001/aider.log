#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

int main(int argc, char *argv[]) {
    int i;
    int end_of_opts = 0;
    int operand_count = 0;
    int any_failed = 0;

    /* Validate: count operands, reject unknown options */
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!end_of_opts) {
            if (a[0] == '-') {
                if (a[1] == '\0') {
                    /* bare '-' is a valid operand */
                } else if (a[1] == '-' && a[2] == '\0') {
                    /* '--' marks end of options */
                    end_of_opts = 1;
                    continue;
                } else {
                    /* unknown option */
                    fprintf(stderr, "mkdir: unknown option -- %s\n", a + 1);
                    return 1;
                }
            }
        }
        if (!(a[0] == '-' && a[1] == '-' && a[2] == '\0' && !end_of_opts)) {
            operand_count++;
        }
    }

    if (operand_count == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    /* Create directories */
    end_of_opts = 0;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (!end_of_opts) {
            if (a[0] == '-') {
                if (a[1] == '\0') {
                    /* bare '-', it's an operand */
                } else if (a[1] == '-' && a[2] == '\0') {
                    end_of_opts = 1;
                    continue;
                } else {
                    /* unknown option - already validated, skip */
                    continue;
                }
            }
        }
        /* It's an operand */
        if (a[0] == '-' && a[1] == '-' && a[2] == '\0' && !end_of_opts) {
            continue; /* this is '--', not an operand */
        }
        if (mkdir(a, 0777) != 0) {
            int e = errno;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", a, strerror(e));
            any_failed = 1;
        }
    }

    return any_failed ? 1 : 0;
}
