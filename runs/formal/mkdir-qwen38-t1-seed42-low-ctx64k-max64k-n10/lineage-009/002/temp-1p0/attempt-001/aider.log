```c
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

/* --- Mode parsing --- */

static int parse_octal_mode(const char *s, mode_t *result)
{
    size_t len = strlen(s);
    if (len == 0 || len > 4)
        return -1;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7')
            return -1;
    }
    unsigned val = 0;
    for (size_t i = 0; i < len; i++)
        val = val * 8 + (unsigned)(s[i] - '0');
    if (val > 07777)
        return -1;
    *result = (mode_t)val;
    return 0;
}

/* Parse a single symbolic clause like "u=rwx", "go+", "a-t", "o=" */
/* Returns 0 on success, -1 on failure. Updates *mode. */
static int apply_clause(const char *clause, mode_t *mode)
{
    const char *p = clause;
    
    /* Parse class letters */
    int has_u = 0, has_g = 0, has_o = 0;
    int has_class = 0;
    while (*p && (*p == 'u' || *p == 'g' || *p == 'o' || *p == 'a')) {
        if (*p == 'u') has_u = 1;
        else if (*p == 'g') has_g = 1;
        else if (*p == 'o') has_o = 1;
        else if (*p == 'a') { has_u = has_g = has_o = 1; }
        has_class = 1;
        p++;
    }
    if (!has_class) {
        /* No class letters: treat as 'a' */
        has_u = has_g = has_o = 1;
    }
    
    /* Parse operator */
    char op = *p;
    if (op != '+' && op != '-' && op != '=')
        return -1;
    p++;
    
    /* Parse permission letters */
    int has_r = 0, has_w = 0, has_x = 0, has_s = 0, has_t = 0;
    int has_perm = 0;
    while (*p) {
        if (*p == 'r') has_r = 1;
        else if (*p == 'w') has_w = 1;
        else if (*p == 'x' || *p == 'X') has_x = 1;
        else if (*p == 's') has_s = 1;
        else if (*p == 't') has_t = 1;
        else return -1;
        has_perm = 1;
        p++;
    }
    /* Note: has_perm can be 0 for clauses like "o=" which is valid */
    
    (void)has_perm; /* empty perms are valid with '=' and with +/- */
    
    /* Build the rwx mask for each class */
    unsigned rwx = 0;
    if (has_r) rwx |= 4;
    if (has_w) rwx |= 2;
    if (has_x) rwx |= 1;
    
    /* Apply to mode */
    if (op == '+') {
        if (has_u) *mode |= (rwx << 6) & 0700;
        if (has_g) *mode |= (rwx << 3) & 0070;
        if (has_o) *mode |= rwx & 0007;
        if (has_s) {
            if (has_u) *mode |= 04000;
            if (has_g) *mode |= 02000;
        }
        if (has_t) *mode |= 01000;
    } else if (op == '-') {
        if (has_u) *mode &= ~(0700 & (rwx << 6));
        if (has_g) *mode &= ~(0070 & (rwx << 3));
        if (has_o) *mode &= ~(0007 & rwx);
        if (has_s) {
            if (has_u) *mode &= ~04000;
            if (has_g) *mode &= ~02000;
        }
        if (has_t) *mode &= ~01000;
    } else { /* '=' */
        if (has_u) {
            *mode &= ~0700;
            *mode |= (rwx << 6) & 0700;
            if (has_s) *mode |= 04000;
            else *mode &= ~04000;
        }
        if (has_g) {
            *mode &= ~0070;
            *mode |= (rwx << 3) & 0070;
            if (has_s) *mode |= 02000;
            else *mode &= ~02000;
        }
        if (has_o) {
            *mode &= ~0007;
            *mode |= rwx & 0007;
            if (has_t) *mode |= 01000;
            else *mode &= ~01000;
        }
    }
    
    return 0;
}

static int parse_symbolic_mode(const char *s, mode_t *result)
{
    mode_t mode = 0777; /* base */
    const char *start = s;
    
    while (*start) {
        /* Find end of this clause (comma or end) */
        const char *end = start;
        while (*end && *end != ',')
            end++;
        
        /* Extract clause (length = end - start) */
        size_t len = (size_t)(end - start);
        char *clause = malloc(len + 1);
        if (!clause)
            return -1;
        memcpy(clause, start, len);
        clause[len] = '\0';
        
        if (len == 0) {
            free(clause);
            return -1; /* empty clause is invalid */
        }
        
        int rc = apply_clause(clause, &mode);
        free(clause);
        if (rc != 0)
            return -1;
        
        start = end;
        if (*start == ',')
            start++;
    }
    
    *result = mode;
    return 0;
}

static int parse_mode(const char *s, mode_t *result)
{
    if (!s || *s == '\0')
        return -1;
    
    /* Try octal first */
    if (parse_octal_mode(s, result) == 0)
        return 0;
    
    /* Try symbolic */
    return parse_symbolic_mode(s, result);
}
```

