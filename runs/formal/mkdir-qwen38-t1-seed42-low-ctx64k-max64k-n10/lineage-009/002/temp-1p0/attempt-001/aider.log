static int parse_octal_mode(const char *s, mode_t *result)
{
    size_t len = strlen(s);
    if (len == 0)
        return -1;
    unsigned val = 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7')
            return -1;
        val = val * 8u + (unsigned)(s[i] - '0');
