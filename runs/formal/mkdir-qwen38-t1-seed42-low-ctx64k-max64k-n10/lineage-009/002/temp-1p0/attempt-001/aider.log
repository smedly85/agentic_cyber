    while (p < end) {
        if (*p == 'r') has_r = 1;
        else if (*p == 'w') has_w = 1;
        else if (*p == 'x' || *p == 'X') has_x = 1;
        else if (*p == 's') has_s = 1;
        else if (*p == 't') has_t = 1;
        else return -1;
        p++;
