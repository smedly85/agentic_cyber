    }
    *result = mode;
    return 0;
}

static int parse_mode(const char *s, mode_t *result)
{
    if (!s || *s == '\0')
        return -1;
    if (parse_octal_mode(s, result) == 0)
        return 0;
    return parse_symbolic_mode(s, result);
}

/* --- Directory creation --- */

static int create_parents(const char *path, mode_t final_mode)
{
    size_t len = strlen(path);
