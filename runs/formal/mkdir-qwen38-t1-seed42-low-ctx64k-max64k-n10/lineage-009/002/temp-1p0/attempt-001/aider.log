        if (has_o) {
            *mode &= ~0007;
            *mode |= (mode_t)(rwx & 7u);
            if (has_t) *mode |= 01000;
            else *mode &= ~01000;
        }
    }
    return 0;
}

static int parse_symbolic_mode(const char *s, mode_t *result)
{
    mode_t mode = 0777;
    const char *start = s;
    while (*start) {
        const char *end = start;
