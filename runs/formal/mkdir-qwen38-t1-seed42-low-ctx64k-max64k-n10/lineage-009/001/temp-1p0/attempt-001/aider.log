        int err = errno;
        if (err == EEXIST) {
            struct stat st;
            if (stat(buf, &st) == 0 && S_ISDIR(st.st_mode))
                continue;
            /* Exists but is not a directory */
            errno = ENOTDIR;
            rc = -1;
            break;
        }
        /* ENOTDIR or any other error */
        rc = -1;
        break;
    }

    free(buf);
    return rc;
}

