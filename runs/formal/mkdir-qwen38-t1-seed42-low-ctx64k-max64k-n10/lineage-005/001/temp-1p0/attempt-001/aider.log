static int create_parents(const char *path) {
    // We need to walk through the path and create each component
    // path is something like "a/b/c" or "/a/b/c" or "." etc.
    
    char buf[4096];
    if (strlen(path) >= sizeof(buf)) return -1; // too long, but unlikely in tests
    memcpy(buf, path, strlen(path) + 1);
    
    // Walk through each component
    for (char *p = buf + 1; *p; p++) {
        if (*p == '/') {
            *p = '\0';
            // Check if buf exists
            struct stat st;
            if (stat(buf, &st) == 0) {
                if (!S_ISDIR(st.st_mode)) return -1; // exists but not dir
            } else if (errno == ENOENT) {
                if (mkdir(buf, 0777) != 0) return -1;
            } else {
                return -1;
            }
            *p = '/';
        }
    }
    
    // Now handle the final component (buf is the full path)
    struct stat st;
    if (stat(buf, &st) == 0) {
        if (S_ISDIR(st.st_mode)) return 0; // exists as dir, success
        return -1; // exists but not dir
    } else if (errno == ENOENT) {
        if (mkdir(buf, 0777) != 0) return -1;
    } else {
        return -1;
    }
    return 0;
}
