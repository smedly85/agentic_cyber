```c
static int parse_mode_str(const char *s)
{
    if (s[0] == '\0')
        return -1;
    
    // Try octal
    int all_octal = 1;
    for (const char *p = s; *p; p++) {
        if (*p < '0' || *p > '7') { all_octal = 0; break; }
    }
    if (all_octal) {
        unsigned int mode = 0;
        for (const char *p = s; *p; p++) {
            mode = mode * 8 + (unsigned int)(*p - '0');
            if (mode > 07777) return -1;
        }
        return (int)mode;
    }
    
    // Symbolic
    int mode = 0777;
    const char *p = s;
    
    while (*p) {
        int classes = 0;
        int has_class = 0;
        
        while (*p == 'u' || *p == 'g' || *p == 'a' || *p == 'o') {
            has_class = 1;
            if (*p == 'u') classes |= 1;
            else if (*p == 'g') classes |= 2;
            else if (*p == 'a') classes = 7;
            else if (*p == 'o') classes |= 4;
            p++;
        }
        if (!has_class) classes = 7;
        
        if (*p != '+' && *p != '-' && *p != '=')
            return -1;
        char op = *p++;
        
        int named = 0;
        int has_perm = 0;
        
        while (*p && *p != ',') {
            switch (*p) {
                case 'r':
                    has_perm = 1;
                    if (classes & 1) named |= 4;
                    if (classes & 2) named |= 32;
                    if (classes & 4) named |= 256;
                    break;
                case 'w':
                    has_perm = 1;
                    if (classes & 1) named |= 2;
                    if (classes & 2) named |= 16;
                    if (classes & 4) named |= 128;
                    break;
                case 'x': case 'X':
                    has_perm = 1;
                    if (classes & 1) named |= 1;
                    if (classes & 2) named |= 8;
                    if (classes & 4) named |= 64;
                    break;
                case 's':
                    has_perm = 1;
                    if (classes & 1) named |= 2048;
                    if (classes & 2) named |= 1024;
                    break;
                case 't':
                    has_perm = 1;
                    named |= 512;
                    break;
                default:
                    return -1;
            }
            p++;
        }
        
        // Compute affected bits for this class
        int affected = 0;
        if (classes & 1) affected |= 7 | 2048;   // owner rwx + setuid
        if (classes & 2) affected |= 56 | 1024;  // group rwx + setgid
        if (classes & 4) affected |= 448 | 512;  // other rwx + sticky
        
        if (op == '=') {
            mode = (mode & ~affected) | named;
        } else if (op == '+') {
            mode |= named;
        } else { // '-'
            mode &= ~named;
        }
        
        if (*p == ',') p++;
        else if (*p == '\0') break;
        else return -1;
    }
    
    return mode;
}
```

