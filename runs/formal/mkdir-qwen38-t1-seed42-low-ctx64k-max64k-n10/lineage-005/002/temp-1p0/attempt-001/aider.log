```c
static int create_parents(const char *path, int final_mode, int has_mode)
{
    size_t len = strlen(path);
    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return -1;
    }
    memcpy(buf, path, len + 1);

    for (size_t i = 1; i < len; i++) {
        if (buf[i] == '/') {
            buf[i] = '\0';
            struct stat st;
            if (stat(buf, &st) == 0) {
                if (!S_ISDIR(st.st_mode)) {
                    free(buf);
                    errno = ENOTDIR;
                    return -1;
                }
            } else if (errno == ENOENT) {
                if (mkdir(buf, 0777) != 0) {
                    free(buf);
                    return -1;
                }
            } else {
                free(buf);
                return -1;
            }
            buf[i] = '/';
        }
    }

    struct stat st;
    if (stat(buf, &st) == 0) {
        if (!S_ISDIR(st.st_mode)) {
            free(buf);
            errno = ENOTDIR;
            return -1;
        }
    } else if (errno == ENOENT) {
        if (mkdir(buf, 0777) != 0) {
            free(buf);
            return -1;
        }
        if (has_mode && chmod(buf, (mode_t)final_mode) != 0) {
            free(buf);
            return -1;
        }
    } else {
        free(buf);
        return -1;
    }

    free(buf);
    return 0;
}
```

