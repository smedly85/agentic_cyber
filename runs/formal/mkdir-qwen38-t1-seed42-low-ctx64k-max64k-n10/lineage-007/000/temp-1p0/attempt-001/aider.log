    int any_failed = 0;
    end_of_options = 0;
    
    for (int i = 1; i < argc; i++) {
        if (!end_of_options) {
            if (strcmp(argv[i], "--") == 0) {
                end_of_options = 1;
                continue;
            }
        }
        
        const char *path = argv[i];
        
        // Determine parent and base
        char *last_slash = strrchr(path, '/');
        const char *parent = ".";
        const char *base = path;
        char *parent_alloc = NULL;
        
        if (last_slash != NULL) {
            if (last_slash == path) {
                // Absolute path
                if (path[1] == '\0') {
                    // Path is "/"
                    struct stat st;
                    if (lstat(path, &st) == 0) {
                        fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
                    } else {
                        fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
                    }
                    any_failed = 1;
                    continue;
                }
                parent = "/";
                base = last_slash + 1;
            } else {
                size_t plen = (size_t)(last_slash - path);
                parent_alloc = malloc(plen + 1);
                if (!parent_alloc) {
                    fprintf(stderr, "%s: memory allocation failed\n", prog);
                    return 1;
                }
                memcpy(parent_alloc, path, plen);
                parent_alloc[plen] = '\0';
                parent = parent_alloc;
                base = last_slash + 1;
            }
        }
        
        // Handle trailing slash (empty base)
        if (base[0] == '\0') {
            // Path ends with '/', refers to parent directory itself
            struct stat st;
            if (lstat(parent, &st) == 0) {
                fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
            } else {
                fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
            }
            any_failed = 1;
            free(parent_alloc);
            continue;
        }
        
        // Check parent exists and is a directory
        struct stat st;
        if (stat(parent, &st) != 0) {
            fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
            any_failed = 1;
            free(parent_alloc);
            continue;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "%s: cannot create directory '%s': Not a directory\n", prog, path);
            any_failed = 1;
            free(parent_alloc);
            continue;
        }
        
        // Check target doesn't already exist
        if (lstat(path, &st) == 0) {
            fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
            any_failed = 1;
            free(parent_alloc);
            continue;
        }
        
        // Create the directory
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
            any_failed = 1;
            free(parent_alloc);
            continue;
        }
        
        free(parent_alloc);
    }
    
    return any_failed ? 1 : 0;
}
