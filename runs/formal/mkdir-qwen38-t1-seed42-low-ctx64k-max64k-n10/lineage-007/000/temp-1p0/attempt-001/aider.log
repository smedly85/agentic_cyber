int main(int argc, char *argv[]) {
    const char *prog = argv[0];
    
    // Parse arguments
    int end_of_options = 0;
    int has_operands = 0;
    
    // First pass: check for unknown options and count operands
    for (int i = 1; i < argc; i++) {
        if (!end_of_options) {
            if (strcmp(argv[i], "--") == 0) {
                end_of_options = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // Unknown option (bare '-' is allowed as operand)
                fprintf(stderr, "%s: unknown option -- '%s'\n", prog, argv[i]);
                return 1;
            }
        }
        has_operands = 1;
    }
    
    if (!has_operands) {
        fprintf(stderr, "%s: missing operand\n", prog);
        return 1;
    }
    
    // Second pass: create directories
    int any_failed = 0;
    
    for (int i = 1; i < argc; i++) {
        if (!end_of_options) {
            if (strcmp(argv[i], "--") == 0) {
                end_of_options = 1;
                continue;
            }
        }
        
        const char *path = argv[i];
        
        // Find parent and base
        char *last_slash = strrchr(path, '/');
        const char *parent;
        const char *base;
        char *parent_buf = NULL;
        
        if (last_slash == NULL) {
            parent = ".";
            base = path;
        } else if (last_slash == path) {
            // Absolute path
            if (path[1] == '\0') {
                // Path is "/"
                // Root always exists
                fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
                any_failed = 1;
                continue;
            }
            parent = "/";
            base = last_slash + 1;
        } else {
            // Copy parent portion
            size_t plen = (size_t)(last_slash - path);
            parent_buf = malloc(plen + 1);
            if (!parent_buf) {
                fprintf(stderr, "%s: memory exhausted\n", prog);
                return 1;
            }
            memcpy(parent_buf, path, plen);
            parent_buf[plen] = '\0';
            parent = parent_buf;
            base = last_slash + 1;
        }
        
        // Check base is not empty (path ends with '/')
        if (base[0] == '\0') {
            // Trailing slash - the path refers to the parent directory itself
            // Check if parent exists
            struct stat st;
            if (stat(parent, &st) == 0) {
                fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
                any_failed = 1;
            } else if (errno == ENOENT) {
                fprintf(stderr, "%s: cannot create directory '%s': No such file or directory\n", prog, path);
                any_failed = 1;
            } else {
                fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
                any_failed = 1;
            }
            free(parent_buf);
            continue;
        }
        
        // Check parent exists
        struct stat st;
        if (stat(parent, &st) != 0) {
            if (errno == ENOENT) {
                fprintf(stderr, "%s: cannot create directory '%s': No such file or directory\n", prog, path);
            } else {
                fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
            }
            any_failed = 1;
            free(parent_buf);
            continue;
        }
        
        // Check parent is a directory
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "%s: cannot create directory '%s': Not a directory\n", prog, path);
            any_failed = 1;
            free(parent_buf);
            continue;
        }
        
        // Check if the target already exists
        if (stat(path, &st) == 0) {
            fprintf(stderr, "%s: cannot create directory '%s': File exists\n", prog, path);
            any_failed = 1;
            free(parent_buf);
            continue;
        }
        
        // Try to create
        if (mkdir(path, 0777) != 0) {
            fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, path, strerror(errno));
            any_failed = 1;
            free(parent_buf);
            continue;
        }
        
        free(parent_buf);
    }
    
    return any_failed ? 1 : 0;
}
