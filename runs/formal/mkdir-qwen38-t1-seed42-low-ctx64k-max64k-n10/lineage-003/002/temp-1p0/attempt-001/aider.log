```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <errno.h>
#include <unistd.h>

// --- Mode parsing ---

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int parse_octal_mode(const char *s, long *result) {
    if (s[0] == '\0') return -1;
    long val = 0;
    for (const char *p = s; *p; p++) {
        if (!is_octal_digit(*p)) return -1;
        val = val * 8 + (*p - '0');
        if (val > 07777) return -1; // too large
    }
    *result = val;
    return 0;
}

static int parse_symbolic_clause(const char *s, size_t len, long *mode) {
    // s[0..len-1] is one clause
    int who_u = 0, who_g = 0, who_o = 0;
    int has_who = 0;
    char op = 0;
    int perm_r = 0, perm_w = 0, perm_x = 0, perm_s = 0, perm_t = 0;
    int has_perm = 0;
    
    size_t i = 0;
    
    // Parse who
    while (i < len && (s[i] == 'u' || s[i] == 'g' || s[i] == 'o' || s[i] == 'a')) {
        has_who = 1;
        switch (s[i]) {
            case 'u': who_u = 1; break;
            case 'g': who_g = 1; break;
            case 'o': who_o = 1; break;
            case 'a': who_u = who_g = who_o = 1; break;
        }
        i++;
    }
    
    // If no who specified, default to all
    if (!has_who) {
        who_u = who_g = who_o = 1;
    }
    
    // Parse operator
    if (i >= len) return -1; // no operator
    op = s[i];
    if (op != '+' && op != '-' && op != '=') return -1;
    i++;
    
    // Parse permissions (can be empty for = like o=)
    while (i < len) {
        switch (s[i]) {
            case 'r': perm_r = 1; has_perm = 1; break;
            case 'w': perm_w = 1; has_perm = 1; break;
            case 'x': case 'X': perm_x = 1; has_perm = 1; break;
            case 's': perm_s = 1; has_perm = 1; break;
            case 't': perm_t = 1; has_perm = 1; break;
            default: return -1; // invalid char
        }
        i++;
    }
    
    // For '+' and '-', we need at least one permission (or s/t)
    // For '=', empty perms is OK (clears the class)
    if (op != '=' && !has_perm) return -1;
    
    // Compute rwx bits
    int rwx = (perm_r ? 4 : 0) | (perm_w ? 2 : 0) | (perm_x ? 1 : 0);
    
    if (op == '+') {
        if (who_u) *mode |= rwx << 6;
        if (who_g) *mode |= rwx << 3;
        if (who_o) *mode |= rwx;
        if (perm_s) {
            if (who_u) *mode |= 04000;
            if (who_g) *mode |= 02000;
        }
        if (perm_t) *mode |= 01000;
    } else if (op == '-') {
        if (who_u) *mode &= ~(rwx << 6);
        if (who_g) *mode &= ~(rwx << 3);
        if (who_o) *mode &= ~rwx;
        if (perm_s) {
            if (who_u) *mode &= ~04000L;
            if (who_g) *mode &= ~02000L;
        }
        if (perm_t) *mode &= ~01000L;
    } else { // '='
        if (who_u) *mode = (*mode & ~0700L) | ((long)rwx << 6);
        if (who_g) *mode = (*mode & ~0070L) | ((long)rwx << 3);
        if (who_o) *mode = (*mode & ~0007L) | rwx;
        if (who_u) *mode = (*mode & ~04000L) | (perm_s ? 04000L : 0);
        if (who_g) *mode = (*mode & ~02000L) | (perm_s ? 02000L : 0);
        // sticky: affected if o is in who, or if who was default (all)
        // I'll say: always affected for '=' (simplest)
        *mode = (*mode & ~01000L) | (perm_t ? 01000L : 0);
    }
    
    return 0;
}

static int parse_symbolic_mode(const char *s, long *result) {
    if (s[0] == '\0') return -1;
    long mode = 0777;
    
    const char *start = s;
    while (1) {
        const char *comma = strchr(start, ',');
        size_t len = comma ? (size_t)(comma - start) : strlen(start);
        if (len == 0) return -1; // empty clause
        if (parse_symbolic_clause(start, len, &mode) != 0) return -1;
        if (!comma) break;
        start = comma + 1;
    }
    
    *result = mode;
    return 0;
}

static int parse_mode(const char *s, long *result) {
    if (s == NULL || s[0] == '\0') return -1;
    
    // Try octal first
    int all_octal = 1;
    for (const char *p = s; *p; p++) {
        if (!is_octal_digit(*p)) { all_octal = 0; break; }
    }
    if (all_octal) {
        return parse_octal_mode(s, result);
    }
    
    // Try symbolic
    return parse_symbolic_mode(s, result);
}

// --- create_parents (modified to accept a final_mode parameter) ---

static int create_parents(const char *path, int apply_mode, long final_mode) {
    size_t len = strlen(path);
    if (len == 0) return 0;

    for (size_t i = 0; i <= len; i++) {
        if (path[i] == '/' || path[i] == '\0') {
            size_t prefix_len = i;
            if (prefix_len == 0) continue;

            int is_last = (i == len);

            char *prefix = malloc(prefix_len + 1);
            if (!prefix) { errno = ENOMEM; return -1; }
            memcpy(prefix, path, prefix_len);
            prefix[prefix_len] = '\0';

            struct stat st;
            int rc = stat(prefix, &st);
            if (rc == 0) {
                if (!S_ISDIR(st.st_mode)) {
                    errno = is_last ? EEXIST : ENOTDIR;
                    free(prefix);
                    return -1;
                }
            } else if (errno == ENOENT) {
                mode_t m = (is_last && apply_mode) ? (mode_t)final_mode : 0777;
                if (mkdir(prefix, m) != 0) {
                    free(prefix);
                    return -1;
                }
            } else {
                free(prefix);
                return -1;
            }
            free(prefix);
        }
    }
    return 0;
}
