```c
static int create_parents(const char *path, mode_t final_mode, int has_mode)
{
    size_t len = strlen(path);
    char *copy = malloc(len + 1);
    if (!copy) {
        errno = ENOMEM;
        return -1;
    }
    memcpy(copy, path, len + 1);

    size_t pos = 0;
    while (pos < len && copy[pos] == '/') pos++;

    int last_created = 0;
    
    while (pos < len) {
        size_t end = pos;
        while (end < len && copy[end] != '/') end++;

        char saved = copy[end];
        copy[end] = '\0';

        struct stat st;
        int is_final = (end >= len);
        
        if (stat(copy, &st) == 0) {
            if (!S_ISDIR(st.st_mode)) {
                errno = ENOTDIR;
                free(copy);
                return -1;
            }
            last_created = 0;
        } else {
            if (mkdir(copy, 0777) != 0) {
                if (errno == EEXIST) {
                    if (stat(copy, &st) != 0 || !S_ISDIR(st.st_mode)) {
                        errno = ENOTDIR;
                        free(copy);
                        return -1;
                    }
                    last_created = 0;
                } else {
                    free(copy);
                    return -1;
                }
            } else {
                last_created = 1;
            }
        }

        if (is_final && has_mode && last_created) {
            if (chmod(copy, final_mode) != 0) {
                free(copy);
                return -1;
            }
        }

        copy[end] = saved;

        if (end >= len) break;
        pos = end + 1;
        while (pos < len && copy[pos] == '/') pos++;
    }

    free(copy);
    return 0;
}
```

