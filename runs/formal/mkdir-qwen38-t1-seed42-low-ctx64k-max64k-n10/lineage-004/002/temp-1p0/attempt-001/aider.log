```c
/* Mode parsing */
static int parse_mode(const char *str, mode_t *result) {
    if (!str || str[0] == '\0') return -1;
    
    // Check if it's all octal digits
    int all_octal = 1;
    for (const char *p = str; *p; p++) {
        if (*p < '0' || *p > '7') { all_octal = 0; break; }
    }
    
    if (all_octal) {
        // Parse as octal
        long val = 0;
        for (const char *p = str; *p; p++) {
            val = val * 8 + (*p - '0');
        }
        if (val > 07777) return -1; // Too large
        *result = (mode_t)val;
        return 0;
    }
    
    // Parse as symbolic
    mode_t base = 0777;
    // Split by commas and process each clause
    const char *p = str;
    while (1) {
        // Parse one clause
        mode_t perm = 0;
        mode_t mask = 0;
        int has_u = 0, has_g = 0, has_o = 0;
        int op = 0; // '+', '-', '='
        int has_perm = 0;
        
        // Parse class letters
        while (*p && (*p == 'u' || *p == 'g' || *p == 'o' || *p == 'a')) {
            if (*p == 'u' || *p == 'a') has_u = 1;
            if (*p == 'g' || *p == 'a') has_g = 1;
            if (*p == 'o' || *p == 'a') has_o = 1;
            p++;
        }
        
        if (!has_u && !has_g && !has_o) {
            // No class specified, treat as 'a'
            has_u = has_g = has_o = 1;
        }
        
        // Parse operator
        if (*p == '+' || *p == '-' || *p == '=') {
            op = *p;
            p++;
        } else {
            return -1; // Invalid clause
        }
        
        // Parse permissions
        int has_r = 0, has_w = 0, has_x = 0, has_s = 0, has_t = 0;
        while (*p && *p != ',' && *p != '\0') {
            if (*p == 'r') has_r = 1;
            else if (*p == 'w') has_w = 1;
            else if (*p == 'x' || *p == 'X') has_x = 1;
            else if (*p == 's') has_s = 1;
            else if (*p == 't') has_t = 1;
            else return -1; // Invalid character
            p++;
        }
        has_perm = has_r || has_w || has_x || has_s || has_t;
        
        // Compute perm bits
        if (has_r) perm |= (has_u ? 0400 : 0) | (has_g ? 0040 : 0) | (has_o ? 0004 : 0);
        if (has_w) perm |= (has_u ? 0200 : 0) | (has_g ? 0020 : 0) | (has_o ? 0002 : 0);
        if (has_x) perm |= (has_u ? 0100 : 0) | (has_g ? 0010 : 0) | (has_o ? 0001 : 0);
        if (has_s) {
            if (has_u) perm |= 04000;
            if (has_g) perm |= 02000;
        }
        if (has_t) perm |= 01000;
        
        // Compute mask (bits that can be affected by this clause)
        if (has_u) mask |= 0700;
        if (has_g) mask |= 0070;
        if (has_o) mask |= 0007;
        
