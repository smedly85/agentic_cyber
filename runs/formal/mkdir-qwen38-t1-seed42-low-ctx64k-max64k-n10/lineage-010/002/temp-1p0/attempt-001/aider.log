            case '+': mode |= perms; break;
            case '-': mode &= ~perms; break;
            case '=': mode = (mode & ~mask) | perms; break;
        }
        
        // Move to next clause or end
        if (*p == ',') p++;
        else break;
    }
    
    *result = mode;
    return 0;
}
