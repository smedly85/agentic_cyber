            switch (*p) {
                case 'r': perms |= 0444; has_perm = 1; break;
                case 'w': perms |= 0222; has_perm = 1; break;
                case 'x': case 'X': perms |= 0111; has_perm = 1; break;
                case 's': perms |= 06000; has_perm = 1; break;
                case 't': perms |= 01000; has_perm = 1; break;
                default: return -1;
            }
            p++;
        }
        
        // Mask permissions to relevant classes
        int mask = 0;
        if (classes & 1) mask |= 0400 + 0200 + 0100 + 04000; // u: rwx + setuid
        if (classes & 2) mask |= 0040 + 0020 + 0010 + 02000; // g: rwx + setgid
        if (classes & 4) mask |= 0004 + 0002 + 0001 + 01000; // o: rwx + sticky
