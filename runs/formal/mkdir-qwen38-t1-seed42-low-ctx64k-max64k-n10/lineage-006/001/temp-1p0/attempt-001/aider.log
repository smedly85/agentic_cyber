            if (strcmp(argv[i], "-p") == 0 || strcmp(argv[i], "--parents") == 0) {
                parents = 1;
                continue;
            }
            fprintf(stderr, "mkdir: unrecognized option '%s'\n", argv[i]);
            fprintf(stderr, "Try 'mkdir --help' for more information.\n");
            return 1;
        }
        have_operands = 1;
        int rc;
        if (parents) {
            rc = make_parents(argv[i]);
        } else {
            rc = (mkdir(argv[i], 0777) != 0) ? -1 : 0;
