```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>

int main(int argc, char *argv[]) {
    int i = 1;
    int end_opts = 0;
    
    // Collect operands
    int operands_count = 0;
    const char **operands = NULL;
    
    // First pass: count operands and validate
    for (i = 1; i < argc; i++) {
        if (!end_opts) {
            if (strcmp(argv[i], "--") == 0) {
                end_opts = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // Unknown option (not bare "-")
                fprintf(stderr, "new_mkdir: unknown option '%s'\n", argv[i]);
                return 1;
            }
        }
        // It's an operand (or we're past --)
        operands_count++;
    }
    
    if (operands_count == 0) {
        fprintf(stderr, "new_mkdir: missing operand\n");
        return 1;
    }
    
    // Allocate array for operands
    operands = malloc(operands_count * sizeof(const char *));
    if (!operands) {
        fprintf(stderr, "new_mkdir: memory allocation failed\n");
        return 1;
    }
    
    // Second pass: fill in operands
    int idx = 0;
    end_opts = 0;
    for (i = 1; i < argc; i++) {
        if (!end_opts) {
            if (strcmp(argv[i], "--") == 0) {
                end_opts = 1;
                continue;
            }
            // We already validated above, so this is an operand
        }
        operands[idx++] = argv[i];
    }
    
    // Attempt to create each directory
    int any_failed = 0;
    for (int j = 0; j < operands_count; j++) {
        const char *path = operands[j];
        if (mkdir(path, 0777) != 0) {
            any_failed = 1;
            fprintf(stderr, "new_mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
        }
    }
    
    free(operands);
    return any_failed ? 1 : 0;
}
```

