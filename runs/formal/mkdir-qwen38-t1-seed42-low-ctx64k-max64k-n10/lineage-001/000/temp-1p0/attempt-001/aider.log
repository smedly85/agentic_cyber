                            fprintf(stderr, "%s: cannot create directory '%s': %s\n", 
                                    argv[0], path_copy, strerror(errno));
                            free(path_copy);
                            return 1;
                        }
                    }
                    *q = '/';
                }
            }
            
            // Create the final directory
            if (mkdir(path_copy, 0777) != 0 && errno != EEXIST) {
                fprintf(stderr, "%s: cannot create directory '%s': %s\n", 
                        argv[0], path, strerror(errno));
                free(path_copy);
                return 1;
            }
            
