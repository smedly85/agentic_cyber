    int opt;
    int parents = 0;
    
    // Parse options
    while ((opt = getopt(argc, argv, "p")) != -1) {
        switch (opt) {
            case 'p':
                parents = 1;
                break;
            default:
                fprintf(stderr, "Usage: %s [-p] directory ...\n", argv[0]);
                return 2;
