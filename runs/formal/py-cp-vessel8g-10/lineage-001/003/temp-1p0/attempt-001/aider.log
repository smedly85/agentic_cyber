def _parse_operands(argv: list[str]) -> tuple[list[str], bool, bool, bool]:
    """Extract operand list and force/interactive/recursive flags; reject unknown options before --."""
    operands: list[str] = []
    force = False
    interactive = False
    recursive = False
    seen_ddash = False
    for arg in argv:
        if not seen_ddash:
            if arg == "--":
