```python
def _copy_tree(src: str, dst: str, force: bool, interactive: bool) -> None:
    """Recursively copy directory src into directory dst.
    dst is created if missing (with src's mode & ~umask).
    Symlinks are recreated, not followed.
    Regular files use copy_path with force.
    Raises OSError on failure.
    """
    # Ensure dst exists
    try:
        dst_st = os.stat(dst)
        if not stat.S_ISDIR(dst_st.st_mode):
            raise OSError("not a directory")
    except FileNotFoundError:
        os.mkdir(dst)
        src_st = os.lstat(src)
        os.chmod(dst, stat.S_IMODE(src_st.st_mode) & ~_UMASK)
    except NotADirectoryError:
        raise OSError("not a directory")
    
    # Copy entries
    for name in os.listdir(src):
        src_child = os.path.join(src, name)
        dst_child = os.path.join(dst, name)
        
        try:
            child_lstat = os.lstat(src_child)
        except OSError:
            continue  # entry disappeared, skip
        
        if stat.S_ISLNK(child_lstat.st_mode):
            # Recreate symlink (don't follow)
            target = os.readlink(src_child)
            if os.path.lexists(dst_child):
