                continue
            if arg == "-f" or arg == "--force":
                force = True
                continue
            if arg == "-i" or arg == "--interactive":
                interactive = True
                continue
            if arg == "-r" or arg == "--recursive":
                recursive = True
                continue
            if arg.startswith("-") and len(arg) > 1:
                print(f"py_cp: unknown option: {arg}", file=sys.stderr)
                raise SystemExit(1)
        operands.append(arg)
    return operands, force, interactive, recursive


