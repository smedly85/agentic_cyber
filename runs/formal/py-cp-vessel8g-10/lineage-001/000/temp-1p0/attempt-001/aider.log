```python
#!/usr/bin/env python3
"""py_cp — checkpoint 000: basic regular-file copy."""
import os
import stat
import sys


def copy_path(src: str, dst: str) -> None:
    """Copy a regular file src to dst.

    - src must be a path to a regular file (symlinks to regular files OK).
    - dst may be:
        * an existing regular file (overwritten, its rwx preserved),
        * an existing symlink to a regular file (target overwritten),
        * a non-existent path (new file created with src rwx masked by umask).
    Raises OSError on failure.
    """
    # src must be accessible as a regular file
    src_st = os.stat(src)  # follows symlinks
    if not stat.S_ISREG(src_st.st_mode):
        raise OSError(f"{src}: not a regular file")

    # Determine if dst is new or existing
    try:
        dst_st = os.stat(dst)  # follows symlinks
        if not stat.S_ISREG(dst_st.st_mode):
            raise OSError(f"{dst}: not a regular file")
        # Existing regular file (or symlink to one): preserve its permissions
        is_new = False
    except FileNotFoundError:
        is_new = True

    # Open dst for writing
    if is_new:
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o666)
    else:
        fd = os.open(dst, os.O_WRONLY | os.O_TRUNC)

    try:
        # Copy contents
        with os.fdopen(os.dup(fd), 'rb') as src_fd:  # Hmm, this is getting complicated
            pass
    except:
        os.close(fd)
        raise
```

