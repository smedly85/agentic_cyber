        if not stat.S_ISREG(dst_st.st_mode):
            raise OSError(f"{dst}: not a regular file")
        is_new = False
    except FileNotFoundError:
        # Could be: dst doesn't exist (OK, we'll create it)
        # or: dst is a dangling symlink (error)
        # Distinguish: check if dst exists as a symlink
        if os.path.islink(dst):
            raise OSError(f"{dst}: dangling symlink")
        is_new = True
    
