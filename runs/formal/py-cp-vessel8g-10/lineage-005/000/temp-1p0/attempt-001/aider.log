def copy_path(src: str, dst: str) -> None:
    real_src = os.path.realpath(src)
    
    # Verify source is a regular file (following symlinks)
    src_stat = os.stat(real_src)  # follows symlinks
    if not stat.S_ISREG(src_stat.st_mode):
        raise CopyError(f"source '{src}' is not a regular file")
    
    # Check destination
    dst_exists = False
    try:
        os.lstat(dst)
        dst_exists = True
    except FileNotFoundError:
        pass
    
    if dst_exists:
        real_dst = os.path.realpath(dst)
        dst_stat = os.stat(real_dst)  # follows symlinks
        if not stat.S_ISREG(dst_stat.st_mode):
            # Could be dangling symlink (lstat succeeds, stat fails) or directory
            raise CopyError(f"destination '{dst}' is not a regular file")
    else:
        real_dst = os.path.realpath(dst)
        # Check parent directory exists
        parent = os.path.dirname(real_dst)
        if not os.path.isdir(parent):
            raise CopyError(f"destination directory does not exist for '{dst}'")
    
    # Self-copy check
    if real_src == real_dst:
        raise CopyError(f"source and destination are the same file: '{src}'")
    
    # Get source mode for new file creation
    src_mode = stat.S_IMODE(src_stat.st_mode)
    
    # Open source for reading
    fd_src = os.open(real_src, os.O_RDONLY)
    try:
        # Open destination
        if dst_exists:
            fd_dst = os.open(real_dst, os.O_WRONLY | os.O_TRUNC)
        else:
            fd_dst = os.open(real_dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, src_mode)
        try:
            # Copy data
            while True:
                chunk = os.read(fd_src, 65536)
                if not chunk:
                    break
                written = 0
                while written < len(chunk):
                    written += os.write(fd_dst, chunk[written:])
        finally:
            os.close(fd_dst)
    finally:
        os.close(fd_src)
```

