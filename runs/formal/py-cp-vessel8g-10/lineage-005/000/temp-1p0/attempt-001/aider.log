def parse_args(argv):
    """Parse arguments. Returns list of operands. Raises on error."""
    # Find --
    if '--' in argv:
        sep_idx = argv.index('--')
        pre = argv[:sep_idx]
        post = argv[sep_idx+1:]
    else:
        pre = argv
        post = []
    
    # Before --: options and operands
    operands = []
    for arg in pre:
        if arg == '-':
            operands.append(arg)
        elif arg.startswith('-') and len(arg) > 1:
            raise InvocationError(f"unknown option: {arg}")
        else:
            operands.append(arg)
    
    # After --: all are operands
    operands.extend(post)
    
    return operands
