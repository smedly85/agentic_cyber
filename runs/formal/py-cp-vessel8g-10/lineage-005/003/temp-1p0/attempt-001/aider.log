def main() -> None:
    argv = sys.argv[1:]

    if "--" in argv:
        sep = argv.index("--")
        pre = argv[:sep]
        post = argv[sep + 1:]
    else:
        pre = argv
        post = []

    force = False
    interactive = False
    recursive = False
    operands: list[str] = []
    for arg in pre:
        if arg == "-":
            operands.append(arg)
        elif arg == "-f" or arg == "--force":
            force = True
        elif arg == "-i" or arg == "--interactive":
            interactive = True
        elif arg == "-r" or arg == "--recursive":
            recursive = True
        elif arg.startswith("-") and len(arg) > 1:
            print(f"py_cp: unknown option: {arg}", file=sys.stderr)
            sys.exit(1)
        else:
            operands.append(arg)

    operands.extend(post)

    if len(operands) < 2:
        print("py_cp: missing operand(s)", file=sys.stderr)
        sys.exit(1)

    sources = operands[:-1]
    dest = operands[-1]

    pairs: list[tuple[str, str]] = []
    if len(sources) > 1:
        if not os.path.isdir(dest):
            print(f"py_cp: destination '{dest}' is not an existing directory",
                  file=sys.stderr)
            sys.exit(1)
        for src in sources:
            base = os.path.basename(src) or src
            pairs.append((src, os.path.join(dest, base)))
    else:
        src = sources[0]
        if os.path.isdir(dest):
            base = os.path.basename(src) or src
            pairs.append((src, os.path.join(dest, base)))
        else:
            pairs.append((src, dest))

    had_error = False
    for src, dst in pairs:
        try:
            st = os.lstat(src)
            if stat.S_ISLNK(st.st_mode):
                if recursive:
                    _recreate_symlink(src, dst)
                else:
                    copy_path(src, dst, force=force, interactive=interactive)
            elif stat.S_ISDIR(st.st_mode):
                if recursive:
                    copy_tree(src, dst, force=force, interactive=interactive)
                else:
                    raise OSError(f"source '{src}' is not a regular file")
            elif stat.S_ISREG(st.st_mode):
                copy_path(src, dst, force=force, interactive=interactive)
            else:
                raise OSError(f"source '{src}' is not a regular file")
        except OSError as exc:
            had_error = True
            print(f"py_cp: {exc}", file=sys.stderr)

    sys.exit(1 if had_error else 0)


if __name__ == "__main__":
