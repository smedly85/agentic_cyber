```python
def copy_tree(src: str, dst: str, force: bool = False, interactive: bool = False) -> None:
    """Copy a directory tree, preserving structure, symlinks, and file contents."""
    real_src = os.path.realpath(src)
    
    # Determine effective destination
    try:
        dst_stat = os.lstat(dst)
        dst_exists = True
    except OSError:
        dst_exists = False
    
    if dst_exists:
        if stat.S_ISDIR(dst_stat.st_mode):
            base = os.path.basename(src) or src
            if base == "." or base == "":
                effective_dst = dst
            else:
                effective_dst = os.path.join(dst, base)
        else:
            # Destination exists but is not a directory — can't place tree there
            # Unless it's a symlink to a directory?
            real_dst = os.path.realpath(dst)
            if os.path.isdir(real_dst):
                base = os.path.basename(src) or src
                if base == "." or base == "":
                    effective_dst = real_dst
                else:
                    effective_dst = os.path.join(real_dst, base)
            else:
                raise OSError(f"cannot create directory '{dst}': not a directory")
    else:
        effective_dst = dst
    
    # Self-copy detection
    real_dst_for_check = os.path.realpath(effective_dst) if os.path.lexists(effective_dst) else os.path.realpath(os.path.dirname(effective_dst) or ".")
    if real_dst_for_check == real_src or real_dst_for_check.startswith(real_src + os.sep):
        raise OSError(f"cannot copy a directory ('{src}') into itself")
    
    # Create the root of the tree if needed
    if not os.path.isdir(effective_dst):
        src_st = os.lstat(src)
        if not stat.S_ISDIR(src_st.st_mode):
            raise OSError(f"source '{src}' is not a directory")
        mode = stat.S_IMODE(src_st.st_mode)
        os.mkdir(effective_dst, mode)
    
    # Recursively copy
    _copy_tree_recursive(src, effective_dst, force, interactive)
```

