    """Recursively copy a directory tree from source to effective_dest."""
    had_error = False
    # Create the top-level destination directory
    try:
        os.stat(effective_dest)
    except FileNotFoundError:
        try:
            os.makedirs(effective_dest)  # or os.mkdir
        except OSError as exc:
            raise _CopyError(f"cannot create directory: {effective_dest}: ...")
        # Set permissions: source rwx & ~umask
        umask = _get_umask()
        src_st = os.stat(source)
