def _parse_operands(argv):
    """Return (operands, force, interactive, recursive) enforcing option and terminator rules.

    Before --: bare '-' is a filename; '-f', '--force', '-i', '--interactive', '-r', and '--recursive' set flags (idempotent);
    any other '-'-prefixed token is an unknown option.  After --: every token is
    a literal operand.
    """
    operands = []
    literal = False
    force = False
    interactive = False
    recursive = False
    for arg in argv:
        if not literal:
            if arg == "--":
                literal = True
            elif arg == "-":
                operands.append(arg)
            elif arg == "-f" or arg == "--force":
                force = True
            elif arg == "-i" or arg == "--interactive":
                interactive = True
            elif arg == "-r" or arg == "--recursive":
                recursive = True
            elif arg.startswith("-") and len(arg) > 1:
                raise _CopyError(f"unknown option: {arg}")
            else:
                operands.append(arg)
        else:
            operands.append(arg)
    return operands, force, interactive, recursive


