def _copy_tree(source, effective_dest, force, interactive):
    """Recursively copy a directory tree from source to effective_dest.

    effective_dest is the directory that corresponds to source.
    Returns True if any per-entry error occurred.
    """
    had_error = False
    umask = _get_umask()
    _MAX_DEPTH = 4096
    _MAX_NODES = 10_000_000
    _node_count = 0

    def _ensure_dir(src_dir, dst_dir):
        nonlocal had_error
        try:
            st = os.stat(dst_dir)
            if not stat.S_ISDIR(st.st_mode):
                print(f"py_cp: cannot create directory: {dst_dir}: file exists",
                      file=sys.stderr)
                had_error = True
                return False
        except FileNotFoundError:
            try:
                os.mkdir(dst_dir)
            except OSError as exc:
                print(f"py_cp: cannot create directory: {dst_dir}: "
                      f"{exc.strerror or exc}", file=sys.stderr)
                had_error = True
                return False
            src_st = os.lstat(src_dir)
            try:
                os.chmod(dst_dir, stat.S_IMODE(src_st.st_mode) & ~umask)
            except OSError:
                pass
        except PermissionError:
            print(f"py_cp: permission denied: {dst_dir}", file=sys.stderr)
            had_error = True
            return False
        return True

    def _recurse(src_dir, dst_dir, depth):
        nonlocal had_error, _node_count
        if depth > _MAX_DEPTH:
            print(f"py_cp: maximum directory depth exceeded: {src_dir}",
                  file=sys.stderr)
            had_error = True
            return
        if not _ensure_dir(src_dir, dst_dir):
            return
        try:
            entries = list(os.scandir(src_dir))
        except PermissionError:
            print(f"py_cp: cannot read directory: {src_dir}", file=sys.stderr)
            had_error = True
            return
        except OSError as exc:
            print(f"py_cp: cannot read directory: {src_dir}: "
                  f"{exc.strerror or exc}", file=sys.stderr)
            had_error = True
            return

        for entry in sorted(entries, key=lambda e: e.name):
            _node_count += 1
            if _node_count > _MAX_NODES:
                print("py_cp: resource limit exceeded", file=sys.stderr)
                had_error = True
                return
            src_path = entry.path
            dst_path = os.path.join(dst_dir, entry.name)
            try:
                st = os.lstat(src_path)
            except OSError as exc:
                print(f"py_cp: cannot access: {src_path}: "
                      f"{exc.strerror or exc}", file=sys.stderr)
                had_error = True
                continue
            if stat.S_ISLNK(st.st_mode):
                try:
                    target = os.readlink(src_path)
                except OSError as exc:
                    print(f"py_cp: cannot read symlink: {src_path}: "
                          f"{exc.strerror or exc}", file=sys.stderr)
                    had_error = True
                    continue
                try:
                    os.lstat(dst_path)
                except (FileNotFoundError, OSError):
                    pass
                else:
                    try:
                        os.unlink(dst_path)
                    except OSError:
                        pass
                try:
                    os.symlink(target, dst_path)
                except OSError as exc:
                    print(f"py_cp: cannot create symlink: {dst_path}: "
                          f"{exc.strerror or exc}", file=sys.stderr)
                    had_error = True
            elif stat.S_ISDIR(st.st_mode):
                _recurse(src_path, dst_path, depth + 1)
            elif stat.S_ISREG(st.st_mode):
                try:
                    copy_path(src_path, dst_path, force=force,
