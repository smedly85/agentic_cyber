```python
def main():
    try:
        operands, force, interactive, recursive = _parse_operands(sys.argv[1:])
    except _CopyError as exc:
        print(f"py_cp: {exc}", file=sys.stderr)
        return 1

    if len(operands) < 2:
        print("py_cp: missing operand", file=sys.stderr)
        return 1

    multi = len(operands) > 2
    if multi:
        dest_dir = operands[-1]
        try:
            st = os.stat(dest_dir)
        except (OSError, ValueError):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        if not stat.S_ISDIR(st.st_mode):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        sources = operands[:-1]
    else:
        sources = [operands[0]]

    pairs = []
    for src in sources:
        base = os.path.basename(src)
        if multi:
            dest = os.path.join(dest_dir, base)
        else:
            dest = operands[1]
            try:
                st = os.stat(dest)
                if stat.S_ISDIR(st.st_mode):
                    dest = os.path.join(dest, base)
            except (OSError, ValueError):
                pass
        pairs.append((src, dest))

    had_error = False
    for src, dest in pairs:
        try:
            if recursive:
                # Determine source type without following symlinks
                try:
                    src_st = os.lstat(src)
                except FileNotFoundError:
                    print(f"py_cp: no such file: {src}", file=sys.stderr)
                    had_error = True
                    continue
                except PermissionError:
                    print(f"py_cp: permission denied: {src}", file=sys.stderr)
                    had_error = True
                    continue
                except OSError as exc:
                    print(f"py_cp: cannot access: {src}: {exc.strerror or exc}", file=sys.stderr)
                    had_error = True
                    continue

                if stat.S_ISLNK(src_st.st_mode):
                    # Recreate symlink
                    target = os.readlink(src)
                    try:
                        os.lstat(dest)
                    except (FileNotFoundError, OSError):
                        pass
                    else:
                        try:
                            os.unlink(dest)
                        except OSError:
                            pass
                    os.symlink(target, dest)
                elif stat.S_ISDIR(src_st.st_mode):
                    # Check self-copy
                    src_real = os.path.realpath(src)
                    dest_real = os.path.realpath(dest)
                    if dest_real == src_real or dest_real.startswith(src_real + os.sep):
                        print(f"py_cp: cannot copy a directory into itself: {src}", file=sys.stderr)
                        had_error = True
                        continue
                    # Check dest is compatible
                    try:
                        dst_st = os.stat(dest)
                        if not stat.S_ISDIR(dst_st.st_mode):
                            print(f"py_cp: cannot create directory: {dest}: file exists", file=sys.stderr)
                            had_error = True
                            continue
                    except FileNotFoundError:
                        pass
                    except PermissionError:
                        print(f"py_cp: permission denied: {dest}", file=sys.stderr)
                        had_error = True
                        continue
                    # Copy the tree
                    if _copy_tree(src, dest, force, interactive):
                        had_error = True
                elif stat.S_ISREG(src_st.st_mode):
                    # Regular file - same as non-recursive
                    src_st2 = _validate_source(src)
                    dst_st = _validate_destination(dest)
                    if dst_st is not None and src_st2.st_dev == dst_st.st_dev \
                            and src_st2.st_ino == dst_st.st_ino:
                        print(f"py_cp: source and destination are the same file: {src}", file=sys.stderr)
                        had_error = True
                        continue
                    copy_path(src, dest, force=force, interactive=interactive)
                else:
                    print(f"py_cp: not a regular file or directory: {src}", file=sys.stderr)
                    had_error = True
            else:
                # Non-recursive: existing logic
                src_st = _validate_source(src)
                dst_st = _validate_destination(dest)
                if dst_st is not None and src_st.st_dev == dst_st.st_dev \
                        and src_st.st_ino == dst_st.st_ino:
                    print(f"py_cp: source and destination are the same file: {src}", file=sys.stderr)
                    had_error = True
                    continue
                copy_path(src, dest, force=force, interactive=interactive)
        except _CopyDeclined:
            had_error = True
        except _CopyError as exc:
            print(f"py_cp: {exc}", file=sys.stderr)
            had_error = True
        except OSError as exc:
            print(f"py_cp: {exc.strerror or exc}", file=sys.stderr)
            had_error = True

    return 1 if had_error else 0
```

