                elif stat.S_ISDIR(src_lstat.st_mode):
                    src_real = os.path.realpath(src)
                    dest_real = os.path.realpath(dest)
                    if dest_real == src_real \
                            or dest_real.startswith(src_real + os.sep):
                        print(
                            f"py_cp: cannot copy directory into itself "
                            f"or its descendant: {src}", file=sys.stderr)
                        had_error = True
                        continue
                    try:
                        dst_st = os.stat(dest)
                        if not stat.S_ISDIR(dst_st.st_mode):
                            print(
                                f"py_cp: cannot create directory: {dest}: "
                                f"file exists", file=sys.stderr)
                            had_error = True
                            continue
                    except FileNotFoundError:
                        pass
                    except PermissionError:
                        print(f"py_cp: permission denied: {dest}",
                              file=sys.stderr)
                        had_error = True
                        continue
                    if _copy_tree(src, dest, force, interactive):
                        had_error = True
                elif stat.S_ISREG(src_lstat.st_mode):
                    _copy_regular_file(src, dest)
                else:
                    print(f"py_cp: unsupported file type: {src}",
                          file=sys.stderr)
                    had_error = True
            else:
                _copy_regular_file(src, dest)
        except _CopyDeclined:
            had_error = True
        except _CopyError as exc:
            print(f"py_cp: {exc}", file=sys.stderr)
            had_error = True
        except OSError as exc:
            print(f"py_cp: {exc.strerror or exc}", file=sys.stderr)
            had_error = True

    return 1 if had_error else 0


if __name__ == "__main__":
    sys.exit(main())
