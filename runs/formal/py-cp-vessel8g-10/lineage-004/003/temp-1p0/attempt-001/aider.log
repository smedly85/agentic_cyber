```python
def main():
    try:
        operands, force, interactive, recursive = _parse_operands(sys.argv[1:])
    except _CopyError as exc:
        print(f"py_cp: {exc}", file=sys.stderr)
        return 1

    if len(operands) < 2:
        print("py_cp: missing operand", file=sys.stderr)
        return 1

    multi = len(operands) > 2
    if multi:
        dest_dir = operands[-1]
        # Validate dest_dir is an existing directory
        try:
            st = os.stat(dest_dir)
        except (OSError, ValueError):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        if not stat.S_ISDIR(st.st_mode):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        sources = operands[:-1]
    else:
        sources = [operands[0]]

    # Compute (source, destination) pairs
    pairs = []
    for src in sources:
        base = os.path.basename(src)
        if multi:
            dest = os.path.join(dest_dir, base)
        else:
            dest = operands[1]
            if recursive:
                # Determine if dest is a directory
                try:
                    st = os.stat(dest)
                    if stat.S_ISDIR(st.st_mode):
                        dest = os.path.join(dest, base)
                except (OSError, ValueError):
                    pass
                # If dest doesn't exist, it stays as-is (will be the tree root)
                # If dest is a file and src is a dir, that's an error (checked later)
            else:
                try:
                    st = os.stat(dest)
                    if stat.S_ISDIR(st.st_mode):
                        dest = os.path.join(dest, base)
                except (OSError, ValueError):
                    pass
        pairs.append((src, dest))

    # Process in operand order
    had_error = False
    for src, dest in pairs:
        try:
            if recursive:
                _process_recursive(src, dest, force, interactive)
            else:
                _process_single(src, dest, force, interactive)
        except _CopyDeclined:
            had_error = True
        except _CopyError as exc:
            print(f"py_cp: {exc}", file=sys.stderr)
            had_error = True
        except OSError as exc:
            print(f"py_cp: {exc.strerror or exc}", file=sys.stderr)
            had_error = True

    return 1 if had_error else 0
```

