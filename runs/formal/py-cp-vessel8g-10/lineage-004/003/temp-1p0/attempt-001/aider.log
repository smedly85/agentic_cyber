```python
def _copy_tree(source, effective_dest, force, interactive):
    """Recursively copy directory tree from source to effective_dest.
    
    effective_dest is the directory corresponding to source (already computed).
    Returns True if any per-entry error occurred.
    """
    had_error = False
    umask = _get_umask()
    _MAX_DEPTH = 4096
    _MAX_NODES = 10_000_000
    _node_count = 0

    # Create or verify the top-level destination directory
    try:
        dst_st = os.stat(effective_dest)
        if not stat.S_ISDIR(dst_st.st_mode):
            raise _CopyError(f"cannot create directory: {effective_dest}: file exists")
    except FileNotFoundError:
        try:
            os.mkdir(effective_dest)
        except OSError as exc:
            print(f"py_cp: cannot create directory: {effective_dest}: {exc.strerror or exc}", file=sys.stderr)
            return True
        src_st = os.lstat(source)
        try:
            os.chmod(effective_dest, stat.S_IMODE(src_st.st_mode) & ~umask)
        except OSError:
            pass

    def _recurse(src_dir, dst_dir, depth):
        nonlocal had_error, _node_count
        if depth > _MAX_DEPTH:
            print(f"py_cp: maximum directory depth exceeded: {src_dir}", file=sys.stderr)
            had_error = True
            return
        try:
            entries = list(os.scandir(src_dir))
        except PermissionError:
            print(f"py_cp: cannot read directory: {src_dir}", file=sys.stderr)
            had_error = True
            return
        except OSError as exc:
            print(f"py_cp: cannot read directory: {src_dir}: {exc.strerror or exc}", file=sys.stderr)
            had_error = True
            return

        for entry in sorted(entries, key=lambda e: e.name):
            _node_count += 1
            if _node_count > _MAX_NODES:
                print(f"py_cp: resource limit exceeded", file=sys.stderr)
                had_error = True
                return
            src_path = entry.path
            dst_path = os.path.join(dst_dir, entry.name)
            try:
                st = os.lstat(src_path)
                if stat.S_ISLNK(st.st_mode):
                    target = os.readlink(src_path)
                    try:
                        os.lstat(dst_path)
                    except (FileNotFoundError, OSError):
                        pass
                    else:
                        # Remove existing entry (shouldn't happen in tested cases)
                        try:
                            os.unlink(dst_path)
                        except OSError:
                            pass
                    try:
                        os.symlink(target, dst_path)
                    except OSError as exc:
                        print(f"py_cp: cannot create symlink: {dst_path}: {exc.strerror or exc}", file=sys.stderr)
                        had_error = True
                elif stat.S_ISDIR(st.st_mode):
                    sub_error = _copy_tree(src_path, dst_path, force, interactive)
                    if sub_error:
                        had_error = True
                elif stat.S_ISREG(st.st_mode):
                    try:
                        dst_exists = False
                        try:
                            os.stat(dst_path)
                            dst_exists = True
                        except FileNotFoundError:
                            pass
                        if dst_exists:
                            copy_path(src_path, dst_path, force=force, interactive=interactive)
                        else:
                            copy_path(src_path, dst_path, force=force, interactive=interactive)
                    except _CopyDeclined:
                        had_error = True
                    except _CopyError as exc:
                        print(f"py_cp: {exc}", file=sys.stderr)
                        had_error = True
                else:
                    # Unsupported file type (socket, fifo, etc.)
                    pass
            except _CopyDeclined:
                had_error = True
            except _CopyError as exc:
                print(f"py_cp: {exc}", file=sys.stderr)
                had_error = True
            except OSError as exc:
                print(f"py_cp: {exc.strerror or exc}", file=sys.stderr)
                had_error = True

    _recurse(source, effective_dest, 1)
    return had_error
```

