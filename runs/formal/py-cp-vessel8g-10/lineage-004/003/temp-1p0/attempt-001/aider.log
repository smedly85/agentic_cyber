                os.fchmod(dst_fd, stat.S_IMODE(src_st.st_mode) & ~umask)

        _copy_bytes(src_fd, dst_fd)
        os.close(dst_fd)
        dst_fd = None
    finally:
        if dst_fd is not None:
            try:
                os.close(dst_fd)
            except OSError:
                pass
        try:
            os.close(src_fd)
        except OSError:
            pass


