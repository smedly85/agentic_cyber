```python
#!/usr/bin/env python3
"""py_cp — checkpoint 000: basic file copy."""

import os
import stat
import sys


class CopyError(Exception):
    """Raised for per-source copy failures."""
    pass


def _get_umask():
    """Return the current process umask."""
    mask = os.umask(0)
    os.umask(mask)
    return mask


def _resolve(path):
    """Resolve a path to its canonical form (follows symlinks).
    Returns None if the path doesn't exist."""
    try:
        return os.path.realpath(path)
    except (OSError, ValueError):
        return None


def _is_self_copy(source, destination):
    """Check if source and destination refer to the same file."""
    src_stat = os.stat(source)  # follows symlinks
    dst_stat = os.stat(destination)  # follows symlinks
    return (src_stat.st_dev == dst_stat.st_dev and
            src_stat.st_ino == dst_stat.st_ino)


def _validate_source(source):
    """Validate that source is a regular file (following symlinks)."""
    try:
        st = os.stat(source)  # follows symlinks
    except FileNotFoundError:
        raise CopyError(f"cannot stat: {source}")
    except PermissionError:
        raise CopyError(f"permission denied: {source}")
    except OSError as e:
        raise CopyError(f"cannot access: {source}: {e.strerror or e}")
    if stat.S_ISDIR(st.st_mode):
        raise CopyError(f"is a directory: {source}")
    if not stat.S_ISREG(st.st_mode):
        raise CopyError(f"not a regular file: {source}")
    return st


def _validate_destination(destination):
    """Validate that destination is usable (regular file, symlink to regular file, or creatable)."""
    # Check if destination exists (following symlinks)
    try:
        st = os.stat(destination)  # follows symlinks
    except FileNotFoundError:
        # Doesn't exist or dangling symlink
        if os.path.islink(destination):
            raise CopyError(f"dangling symlink: {destination}")
        # Must be creatable: parent must exist
        parent = os.path.dirname(destination)
        if not parent:
            parent = "."
        try:
            os.stat(parent)
        except (OSError, ValueError):
            raise CopyError(f"no such file or directory: {parent}")
        return None  # new file
    except PermissionError:
        raise CopyError(f"permission denied: {destination}")
    except OSError as e:
        raise CopyError(f"cannot access: {destination}: {e.strerror or e}")
    
    if stat.S_ISDIR(st.st_mode):
        raise CopyError(f"is a directory: {destination}")
    if not stat.S_ISREG(st.st_mode):
        raise CopyError(f"not a regular file: {destination}")
    return st  # existing file


def copy_path(source, destination):
    """Core filesystem operation: copy file contents from source to destination.
    
    Both paths must be pre-validated. Handles byte transfer and permission
    setting for new files.
    """
    umask = _get_umask()
    
    # Open source for reading
    try:
        src_fd = os.open(source, os.O_RDONLY)
    except PermissionError:
        raise CopyError(f"permission denied (read): {source}")
    except OSError as e:
        raise CopyError(f"cannot open: {source}: {e.strerror or e}")
    
    try:
        # Open destination
        try:
            os.stat(destination)  # follows symlinks; will raise if dangling/missing
            # Existing file (or symlink to file)
            dst_fd = os.open(destination, os.O_WRONLY | os.O_TRUNC)
        except (FileNotFoundError, OSError):
            # New file
            dst_fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o777)
            # Set permissions: source rwx & ~umask
            try:
                src_st = os.stat(source)
            except OSError:
                src_st = None
            if src_st:
                mode = stat.S_IMODE(src_st.st_mode) & ~umask
                os.fchmod(dst_fd, mode)
        
        # Copy contents
        _copy_bytes(src_fd, dst_fd)
        
        os.close(dst_fd)
    finally:
        os.close(src_fd)


def _copy_bytes(src_fd, dst_fd):
    """Copy all bytes from src_fd to dst_fd."""
    chunk_size = 1 << 20  # 1 MiB
    while True:
        chunk = os.read(src_fd, chunk_size)
        if not chunk:
            break
        written = 0
        while written < len(chunk):
            written += os.write(dst_fd, chunk[written:])


def parse_operands(argv):
    """Parse argv into a list of operand strings.
    
    Before --: arguments starting with '-' (length > 1) are unknown options.
    Bare '-' is a filename. After --: everything is literal.
    Returns list of operands.
    Raises CopyError for unknown options.
    """
    operands = []
    after_dashdash = False
    for arg in argv:
        if not after_dashdash:
            if arg == "--":
                after_dashdash = True
            elif arg == "-":
                operands.append(arg)
            elif arg.startswith("-") and len(arg) > 1:
                raise CopyError(f"unknown option: {arg}")
            else:
                operands.append(arg)
        else:
            operands.append(arg)
    return operands


def main():
    argv = sys.argv[1:]
    
    try:
        operands = parse_operands(argv)
    except CopyError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    
    if len(operands) < 2:
        print("missing operand", file=sys.stderr)
        sys.exit(1)
    
    # Determine source/destination pairs
    if len(operands) > 2:
        # Multi-source: last must be existing directory
        dest_dir = operands[-1]
        try:
            st = os.stat(dest_dir)
        except (OSError, ValueError):
            print(f"not a directory: {dest_dir}", file=sys.stderr)
            sys.exit(1)
        if not stat.S_ISDIR(st.st_mode):
            print(f"not a directory: {dest_dir}", file=sys.stderr)
            sys.exit(1)
        sources = operands[:-1]
    else:
        sources = [operands[0]]
        dest_dir = operands[1]
        # If dest is a directory, effective dest is dest/basename(source)
        # But we check this per-source
    
    # For multi-source, compute all destination paths
    # For single-source, compute the destination path
    pairs = []
    for src in sources:
        if len(operands) > 2:
            # Multi-source: dest is dest_dir/basename(src)
            basename = os.path.basename(src)
            if not basename:
                # src is "/" or ends with "/" - edge case
                basename = "/"
                # Actually os.path.basename("/") is ""
                # Hmm, let me think...
                # If src is "/", basename is "". That's a problem.
                # But "/" is a directory, so it would be rejected anyway.
                # For src like "foo/", basename is "". But "foo/" resolves to "foo"
                # which is a directory → rejected.
                # Actually os.path.basename("foo/") returns ""
                # Let's use os.path.basename on the resolved path? No, that changes things.
                # I think the spec implies normal paths without trailing slashes for files.
                # Let's just use os.path.basename and handle the empty case.
                pass
            dest = os.path.join(dest_dir, basename)
        else:
            # Single source
            dest = operands[1]
            # If dest is an existing directory, use dest/basename(src)
            try:
                st = os.stat(dest)
                if stat.S_ISDIR(st.st_mode):
                    basename = os.path.basename(src)
                    dest = os.path.join(dest, basename)
            except (OSError, ValueError):
                pass
        pairs.append((src, dest))
    
    # Now process each pair
    had_error = False
    for src, dest in pairs:
        try:
            # Validate source
            src_stat = _validate_source(src)
            
            # Validate destination
            dst_stat = _validate_destination(dest)
            
            # Check self-copy (only if both exist as files)
            # src_stat exists (we just validated). dst_stat may be None (new file).
            if dst_stat is not None:
                if (src_stat.st_dev == dst_stat.st_dev and
                        src_stat.st_ino == dst_stat.st_ino):
                    raise CopyError(f"same file: {src}")
            
            # Perform the copy
            copy_path(src, dest)
        except CopyError as e:
            print(str(e), file=sys.stderr)
            had_error = True
        except OSError as e:
            print(f"error: {e.strerror or e}", file=sys.stderr)
            had_error = True
    
    sys.exit(1 if had_error else 0)


if __name__ == "__main__":
    main()
