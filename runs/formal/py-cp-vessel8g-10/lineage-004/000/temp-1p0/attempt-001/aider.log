```python
#!/usr/bin/env python3
"""py_cp — checkpoint 000: basic file copy."""

import os
import stat
import sys


class _CopyError(Exception):
    """Per-source copy failure."""


def _get_umask():
    mask = os.umask(0)
    os.umask(mask)
    return mask


def _copy_bytes(src_fd, dst_fd):
    """Copy all bytes from src_fd to dst_fd using read/write."""
    while True:
        chunk = os.read(src_fd, 1 << 20)
        if not chunk:
            break
        offset = 0
        while offset < len(chunk):
            n = os.write(dst_fd, chunk[offset:])
            offset += n


def copy_path(source, destination):
    """Core filesystem operation: copy file contents from source to destination.

    Both paths must have been pre-validated for type and self-copy.
    If destination is a new file, its permissions are set to source rwx & ~umask.
    If destination is an existing file (or symlink to one), existing rwx are retained.
    """
    umask = _get_umask()

    try:
        src_fd = os.open(source, os.O_RDONLY)
    except PermissionError:
        raise _CopyError(f"cannot read: {source}")
    except OSError as exc:
        raise _CopyError(f"cannot open: {source}: {exc.strerror or exc}")

    dst_fd = None
    try:
        # Determine if destination exists as a regular file (following symlinks)
        try:
            os.stat(destination)
            # Exists as regular file (validated earlier) — open for overwrite
            dst_fd = os.open(destination, os.O_WRONLY | os.O_TRUNC)
        except FileNotFoundError:
            # New file (dangling symlinks rejected earlier, parent validated)
            dst_fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o777)
            src_st = os.stat(source)
            os.fchmod(dst_fd, stat.S_IMODE(src_st.st_mode) & ~umask)
        except OSError as exc:
            raise _CopyError(f"cannot open: {destination}: {exc.strerror or exc}")

        _copy_bytes(src_fd, dst_fd)
        os.close(dst_fd)
        dst_fd = None
    finally:
        if dst_fd is not None:
            try:
                os.close(dst_fd)
            except OSError:
                pass
        os.close(src_fd)


def _parse_operands(argv):
    """Split argv into operand list, enforcing option rules.

    Before --: bare '-' is a filename; other '-'-prefixed args are unknown options.
    After --: every argument is a literal operand.
    """
    operands = []
    literal = False
    for arg in argv:
        if not literal:
            if arg == "--":
                literal = True
            elif arg == "-":
                operands.append(arg)
            elif arg.startswith("-") and len(arg) > 1:
                raise _CopyError(f"unknown option: {arg}")
            else:
                operands.append(arg)
        else:
            operands.append(arg)
    return operands


def _validate_source(source):
    """Return stat of source (must be regular file following symlinks)."""
    try:
        st = os.stat(source)
    except FileNotFoundError:
        raise _CopyError(f"no such file: {source}")
    except PermissionError:
        raise _CopyError(f"permission denied: {source}")
    except OSError as exc:
        raise _CopyError(f"cannot access: {source}: {exc.strerror or exc}")
    if stat.S_ISDIR(st.st_mode):
        raise _CopyError(f"is a directory: {source}")
    if not stat.S_ISREG(st.st_mode):
        raise _CopyError(f"not a regular file: {source}")
    return st


def _validate_destination(destination):
    """Validate destination; return stat if existing regular file, else None (new)."""
    try:
        st = os.stat(destination)
    except FileNotFoundError:
        # Dangling symlink or truly absent
        if os.path.islink(destination):
            raise _CopyError(f"dangling symlink: {destination}")
        parent = os.path.dirname(destination) or "."
        try:
            os.stat(parent)
        except (OSError, ValueError):
            raise _CopyError(f"no such file or directory: {parent}")
        return None
    except PermissionError:
        raise _CopyError(f"permission denied: {destination}")
    except OSError as exc:
        raise _CopyError(f"cannot access: {destination}: {exc.strerror or exc}")
    if stat.S_ISDIR(st.st_mode):
        raise _CopyError(f"is a directory: {destination}")
    if not stat.S_ISREG(st.st_mode):
        raise _CopyError(f"incompatible destination: {destination}")
    return st


def main():
    try:
        operands = _parse_operands(sys.argv[1:])
    except _CopyError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    if len(operands) < 2:
        print("py_cp: missing operand", file=sys.stderr)
        return 1

    # Build (source, destination) pairs
    if len(operands) > 2:
        dest_dir = operands[-1]
        try:
            st = os.stat(dest_dir)
        except (OSError, ValueError):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        if not stat.S_ISDIR(st.st_mode):
            print(f"py_cp: not a directory: {dest_dir}", file=sys.stderr)
            return 1
        sources = operands[:-1]
    else:
        sources = [operands[0]]
        dest_dir = operands[1]

    pairs = []
    for src in sources:
        basename = os.path.basename(src)
        if len(operands) > 2:
            dest = os.path.join(dest_dir, basename)
        else:
            # Single source: if dest is an existing directory, append basename
            dest = operands[1]
            try:
                st = os.stat(dest)
                if stat.S_ISDIR(st.st_mode):
                    dest = os.path.join(dest, basename)
            except (OSError, ValueError):
                pass
        pairs.append((src, dest))

    # Pre-validate all pairs before any filesystem changes (invocation-wide)
    # Self-copy check is per-pair but done before any modification
    had_error = False
    for src, dest in pairs:
        try:
            src_stat = _validate_source(src)
            dst_stat = _validate_destination(dest)
            if dst_stat is not None:
                if src_stat.st_dev == dst_stat.st_dev and src_stat.st_ino == dst_stat.st_ino:
                    raise _CopyError(f"source and destination are the same file: {src}")
            copy_path(src, dest)
        except _CopyError as exc:
            print(f"py_cp: {exc}", file=sys.stderr)
            had_error = True
        except OSError as exc:
            print(f"py_cp: {exc.strerror or exc}", file=sys.stderr)
            had_error = True

    return 1 if had_error else 0


if __name__ == "__main__":
    sys.exit(main())
```

