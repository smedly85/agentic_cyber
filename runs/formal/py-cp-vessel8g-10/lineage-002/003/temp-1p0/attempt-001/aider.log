                except OSError as e:
                    print(f"py_cp: {dst}: {e.strerror or e}", file=sys.stderr)
                    exit_status = 1
                    continue
            except OSError as e:
                print(f"py_cp: {dst}: {e.strerror or e}", file=sys.stderr)
                exit_status = 1
                continue
            
            # Copy the tree
            sub = copy_tree(src, dst, force, interactive)
            exit_status |= sub
        
        elif stat.S_ISREG(src_lstat.st_mode):
