#!/usr/bin/env python3
"""py_cp — checkpoint 003: basic file copy utility with recursive support."""
import os
import stat
import sys


def parse_args(argv):
    operands = []
    after_ddash = False
    force = False
    interactive = False
    recursive = False
    for token in argv:
        if not after_ddash and token == '--':
            after_ddash = True
            continue
        if after_ddash:
            operands.append(token)
        else:
            if token in ('-f', '--force'):
                force = True
            elif token in ('-i', '--interactive'):
                interactive = True
            elif token in ('-r', '--recursive'):
                recursive = True
            elif token.startswith('-') and token != '-':
                return None, None, None, None, f"unknown option: {token}"
            else:
                operands.append(token)
    return operands, force, interactive, recursive, None


def copy_path(src, dst, force=False):
    # (unchanged from before)
    ...


def _interactive_prompt(dst):
    """Prompt on stderr for overwrite confirmation. Returns True if affirmed."""
    sys.stderr.write(f"py_cp: overwrite '{dst}'? (y/n) ")
    sys.stderr.flush()
    answer = sys.stdin.readline()
    return bool(answer) and answer[0] in ('y', 'Y')


def copy_tree(src, dst, force, interactive):
    """Recursively copy contents of directory src into directory dst.
    dst must already exist. Returns exit status (0 or 1)."""
    exit_status = 0
    try:
        entries = os.listdir(src)
    except OSError as e:
        print(f"py_cp: {src}: {e.strerror or e}", file=sys.stderr)
        return 1
    
    for name in entries:
        src_entry = os.path.join(src, name)
        dst_entry = os.path.join(dst, name)
        
        try:
            st = os.lstat(src_entry)
        except OSError as e:
            print(f"py_cp: {src_entry}: {e.strerror or e}", file=sys.stderr)
            exit_status = 1
            continue
        
        if stat.S_ISLNK(st.st_mode):
            # Recreate symlink
            try:
                target = os.readlink(src_entry)
            except OSError as e:
                print(f"py_cp: {src_entry}: {e.strerror or e}", file=sys.stderr)
                exit_status = 1
                continue
            # Remove existing dst_entry if present
            try:
                os.lstat(dst_entry)
                os.unlink(dst_entry)
            except FileNotFoundError:
                pass
            except OSError as e:
                print(f"py_cp: {dst_entry}: {e.strerror or e}", file=sys.stderr)
                exit_status = 1
                continue
            try:
                os.symlink(target, dst_entry)
            except OSError as e:
                print(f"py_cp: {dst_entry}: {e.strerror or e}", file=sys.stderr)
                exit_status = 1
        
        elif stat.S_ISDIR(st.st_mode):
            # Check if dst_entry exists
            try:
                dst_st = os.lstat(dst_entry)
                if not stat.S_ISDIR(dst_st.st_mode):
                    print(f"py_cp: {dst_entry}: Not a directory", file=sys.stderr)
                    exit_status = 1
                    continue
            except FileNotFoundError:
                # Create new directory with source mode & ~umask
                mode = stat.S_IMODE(st.st_mode) & ~0o022
                try:
                    os.mkdir(dst_entry, mode)
                except OSError as e:
                    print(f"py_cp: {dst_entry}: {e.strerror or e}", file=sys.stderr)
                    exit_status = 1
                    continue
            # Recurse
            sub = copy_tree(src_entry, dst_entry, force, interactive)
            exit_status |= sub
        
        elif stat.S_ISREG(st.st_mode):
            # Regular file
            dst_exists = False
            try:
                dst_st = os.lstat(dst_entry)
                if stat.S_ISREG(dst_st.st_mode):
                    dst_exists = True
                elif stat.S_ISDIR(dst_st.st_mode):
                    print(f"py_cp: {dst_entry}: Is a directory", file=sys.stderr)
                    exit_status = 1
                    continue
            except FileNotFoundError:
                pass
            
            if interactive and dst_exists:
                if not _interactive_prompt(dst_entry):
                    exit_status = 1
                    continue
            
            try:
