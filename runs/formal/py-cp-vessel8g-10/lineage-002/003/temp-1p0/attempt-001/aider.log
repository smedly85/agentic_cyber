                dst_st = os.lstat(dst)
                if not stat.S_ISDIR(dst_st.st_mode):
                    print(f"py_cp: {dst}: Not a directory", file=sys.stderr)
                    exit_status = 1
                    continue
            except FileNotFoundError:
                mode = stat.S_IMODE(src_lstat.st_mode) & ~0o022
                try:
