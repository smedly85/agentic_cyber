```python
#!/usr/bin/env python3
import os
import stat
import sys


def parse_args(argv):
    """Parse command-line arguments. Returns (operands, error_message) where
    exactly one is None."""
    operands = []
    after_ddash = False
    
    for token in argv:
        if not after_ddash and token == '--':
            after_ddash = True
            continue
        if after_ddash:
            operands.append(token)
        else:
            if token.startswith('-') and token != '-':
                return None, f"unknown option: {token}"
            operands.append(token)
    
    return operands, None


def copy_path(src, dst):
    """Core filesystem operation: copy regular file src to dst."""
    # Open source for reading
    src_fd = os.open(src, os.O_RDONLY)
    try:
        src_stat = os.fstat(src_fd)
        
        # Open/create destination
        try:
            dst_stat = os.stat(dst)
            if not stat.S_ISREG(dst_stat.st_mode):
                raise IsADirectoryError(f"{dst}: not a regular file")
            dst_fd = os.open(dst, os.O_WRONLY | os.O_TRUNC)
        except FileNotFoundError:
            dst_fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            src_mode = stat.S_IMODE(src_stat.st_mode)
            os.fchmod(dst_fd, src_mode & ~0o022)
        
        # Copy data
        while True:
            chunk = os.read(src_fd, 131072)
            if not chunk:
                break
            written = 0
            while written < len(chunk):
                written += os.write(dst_fd, chunk[written:])
        
        os.close(dst_fd)
    finally:
        os.close(src_fd)


def main():
    argv = sys.argv[1:]
    
    # Phase 1: Parse arguments
    operands, error = parse_args(argv)
    if error:
        print(error, file=sys.stderr)
        sys.exit(1)
    
    # Check operand count
    if len(operands) < 2:
        print("py_cp: missing operand", file=sys.stderr)
        sys.exit(1)
    
    # Determine sources and destination
    if len(operands) > 2:
        # Multi-source: last must be existing directory
        dest_dir = operands[-1]
        sources = operands[:-1]
        try:
            st = os.stat(dest_dir)
            if not stat.S_ISDIR(st.st_mode):
                print(f"py_cp: {dest_dir}: not a directory", file=sys.stderr)
                sys.exit(1)
        except OSError:
            print(f"py_cp: {dest_dir}: not a directory", file=sys.stderr)
            sys.exit(1)
    else:
        sources = [operands[0]]
        dest_dir = operands[1]  # could be a file or directory
    
    # Phase 2: Process sources
    any_failure = False
    
    for src in sources:
        if len(operands) > 2:
            dst = os.path.join(dest_dir, os.path.basename(src))
        else:
            dst = dest_dir
        
        try:
            # Validate source
            src_stat = os.stat(src)  # follows symlinks
            if not stat.S_ISREG(src_stat.st_mode):
                print(f"py_cp: {src}: not a regular file", file=sys.stderr)
                any_failure = True
                continue
            
            # Validate destination
            try:
                dst_stat = os.stat(dst)
                if not stat.S_ISREG(dst_stat.st_mode):
                    print(f"py_cp: {dst}: not a regular file", file=sys.stderr)
                    any_failure = True
                    continue
                # Self-copy check
                if (src_stat.st_ino == dst_stat.st_ino and 
                    src_stat.st_dev == dst_stat.st_dev):
                    print(f"py_cp: {src} and {dst} are the same file", file=sys.stderr)
                    any_failure = True
                    continue
            except FileNotFoundError:
                # Destination doesn't exist - check parent exists
                parent = os.path.dirname(dst)
                if parent:
                    try:
                        os.stat(parent)
                    except OSError:
                        print(f"py_cp: cannot create {dst}: No such file or directory", file=sys.stderr)
                        any_failure = True
                        continue
                # Also check if dst is a dangling symlink
                try:
                    os.lstat(dst)
                    # It's a dangling symlink
                    print(f"py_cp: {dst}: dangling symbolic link", file=sys.stderr)
                    any_failure = True
                    continue
                except FileNotFoundError:
                    pass  # OK, doesn't exist at all
            except PermissionError:
                print(f"py_cp: cannot access {dst}: Permission denied", file=sys.stderr)
                any_failure = True
                continue
            
            # Perform the copy
            copy_path(src, dst)
            
        except PermissionError as e:
            print(f"py_cp: {src}: Permission denied", file=sys.stderr)
            any_failure = True
        except IsADirectoryError as e:
            print(f"py_cp: {src}: Is a directory", file=sys.stderr)
            any_failure = True
        except OSError as e:
            print(f"py_cp: {src}: {e.strerror or e}", file=sys.stderr)
            any_failure = True
    
    sys.exit(1 if any_failure else 0)


if __name__ == "__main__":
    main()
```

