#!/usr/bin/env python3
"""py_cp — checkpoint 000: basic copy utility."""
import os
import stat
import sys


def copy_path(src: str, dst: str) -> None:
    """Copy a regular file from src to dst.
    
    Follows symlinks in both source and destination.
    If dst exists and is a regular file, overwrites it retaining its rwx bits.
    If dst doesn't exist, creates it with source rwx bits masked by umask.
    If dst is a symlink to a regular file, follows it and overwrites the target.
    Rejects dangling symlinks at dst.
    """
    # Open source
    src_fd = os.open(src, os.O_RDONLY)
    try:
        src_stat = os.fstat(src_fd)
        if not stat.S_ISREG(src_stat.st_mode):
            # Shouldn't happen if caller validated, but be safe
            raise IsADirectoryError(f"not a regular file: {src}")
        
        # Determine destination
        # If dst exists, check it
        try:
            dst_stat = os.stat(dst)  # follows symlinks
            if not stat.S_ISREG(dst_stat.st_mode):
                raise IsADirectoryError(f"destination not a regular file: {dst}")
            # Destination is existing regular file (or symlink to one)
            # Retain existing destination rwx bits
            dst_mode = stat.S_IMODE(dst_stat.st_mode)
            dst_fd = os.open(dst, os.O_WRONLY | os.O_TRUNC)
        except FileNotFoundError:
            # Create new file
            dst_fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            # Set permissions: source rwx masked by umask
            src_mode = stat.S_IMODE(src_stat.st_mode)
            os.fchmod(dst_fd, src_mode & ~0o022)
        
        # Copy contents
        # Use sendfile-like approach or read/write
        # For simplicity, read in chunks
        while True:
            chunk = os.read(src_fd, 65536)
            if not chunk:
                break
            os.write(dst_fd, chunk)
        
        os.close(dst_fd)
    finally:
        os.close(src_fd)
```

