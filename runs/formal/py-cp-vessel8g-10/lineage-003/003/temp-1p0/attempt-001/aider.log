def _determine_copy_type(src: str, recursive: bool) -> str:
    """Return 'file', 'dir', or 'symlink' for the source."""
    if recursive:
        st = os.lstat(src)
        if stat.S_ISLNK(st.st_mode):
            return 'symlink'
        elif stat.S_ISDIR(st.st_mode):
            return 'dir'
        elif stat.S_ISREG(st.st_mode):
            return 'file'
        else:
            return 'unknown'
    else:
        # Without -r, follow symlinks
        st = os.stat(src)
        if stat.S_ISDIR(st.st_mode):
            return 'dir'  # will be rejected since no -r
        elif stat.S_ISREG(st.st_mode):
            return 'file'
        else:
            return 'unknown'
