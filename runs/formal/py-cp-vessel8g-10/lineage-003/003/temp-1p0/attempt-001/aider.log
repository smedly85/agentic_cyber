```python
def _copy_tree(src: str, dst: str, force: bool, interactive: bool) -> bool:
    """Recursively copy directory tree from src to dst.
    Returns True on success, False if any error occurred."""
    # Self-copy check
    src_real = os.path.realpath(src)
    dst_real = os.path.realpath(dst)
    if dst_real == src_real:
        print(f"py_cp: {src}: cannot copy a directory into itself", file=sys.stderr)
        return False
    if dst_real.startswith(src_real + os.sep):
        print(f"py_cp: {src}: cannot copy a directory into its descendant '{dst}'", file=sys.stderr)
        return False
    
    # Create destination if it doesn't exist
    try:
        os.stat(dst)
        dst_existed = True
    except OSError:
        dst_existed = False
        try:
            os.mkdir(dst)
        except OSError as exc:
            print(f"py_cp: {dst}: {exc.strerror or exc}", file=sys.stderr)
            return False
        # Set permissions for new directory
        umask = os.umask(0o022)
        try:
            st = os.stat(src)
            os.chmod(dst, stat.S_IMODE(st.st_mode) & ~umask)
        except OSError:
            pass
    
    # Copy contents
    had_error = False
    try:
        entries = os.listdir(src)
    except OSError as exc:
        print(f"py_cp: {src}: {exc.strerror or exc}", file=sys.stderr)
        return False
    
    for name in sorted(entries):
        src_path = os.path.join(src, name)
        dst_path = os.path.join(dst, name)
        
        try:
            st = os.lstat(src_path)
        except OSError:
            had_error = True
            continue
        
        if stat.S_ISLNK(st.st_mode):
            # Recreate symlink
            try:
                target = os.readlink(src_path)
                if os.path.lexists(dst_path):
                    os.unlink(dst_path)
                os.symlink(target, dst_path)
            except OSError:
                had_error = True
        
        elif stat.S_ISDIR(st.st_mode):
