Let me now write the complete implementation:

```python
#!/usr/bin/env python3
"""py_cp - checkpoint 000: base file copy."""
import os
import stat
import sys


def copy_path(src: str, dst: str) -> None:
    """Core copy: read all bytes from src (following symlinks) and write to dst.
    
    If dst already exists as a regular file (or symlink to one), overwrite
    retaining its permissions. If dst is new, set permissions to
    source_perms & ~umask.
    Raises OSError on failure.
    """
    umask = os.umask(0o022)
    
    # Determine if dst pre-exists (follow symlinks)
    dst_existed = False
    try:
        os.stat(dst)
        dst_existed = True
    except OSError:
        pass
    
    fd = os.open(src, os.O_RDONLY)
    try:
        st = os.fstat(fd)
        dfd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o666)
        try:
            _copy_fd(fd, dfd)
            if not dst_existed:
                os.fchmod(dfd, stat.S_IMODE(st.st_mode) & ~umask)
        finally:
            os.close(dfd)
    finally:
        os.close(fd)


def _copy_fd(srcfd: int, dstfd: int) -> None:
    buf_size = 1024 * 1024
    while True:
        buf = os.read(srcfd, buf_size)
        if not buf:
            break
        os.write(dstfd, buf)


def _parse_operands(argv: list[str]) -> tuple[list[str] | None, str | None]:
    """Split argv into operands. Returns (operands, None) or (None, error)."""
    if "--" in argv:
        idx = argv.index("--")
        pre = argv[:idx]
        post = argv[idx + 1:]
    else:
        pre = argv
        post = []
    
    operands: list[str] = []
    for arg in pre:
        if arg == "-":
            operands.append(arg)
        elif len(arg) > 1 and arg.startswith("-"):
            return None, f"unknown option: {arg}"
        else:
            operands.append(arg)
    operands.extend(post)
    
    if len(operands) < 2:
        return None, "missing operands"
    return operands, None


def _resolve_pairs(operands: list[str]) -> tuple[list[tuple[str, str]] | None, str | None]:
    """Resolve source/dest pairs. Returns (pairs, None) or (None, error)."""
    srcs = operands[:-1]
    dst = operands[-1]
    
    if len(srcs) > 1:
        # Multi-source: dst must be existing directory
        try:
            st = os.stat(dst)  # follows symlinks
        except OSError:
            return None, f"destination {dst} does not exist or is not accessible"
        if not stat.S_ISDIR(st.st_mode):
            return None, f"destination {dst} is not a directory"
        pairs = [(s, os.path.join(dst, os.path.basename(s))) for s in srcs]
    else:
        # Single source
        s = srcs[0]
        try:
            st = os.stat(dst)  # follows symlinks
        except OSError:
            # dst doesn't exist; will be created (parent must exist)
            pairs = [(s, dst)]
        else:
            if stat.S_ISDIR(st.st_mode):
                pairs = [(s, os.path.join(dst, os.path.basename(s)))]
            else:
                pairs = [(s, dst)]
    
    return pairs, None


def _validate_pair(src: str, dst: str) -> str | None:
    """Validate a single src/dst pair. Returns None on success, error message on failure."""
    # Source must exist and be a regular file (following symlinks)
    try:
        st = os.stat(src)
    except OSError as e:
        return f"cannot stat {src}: {e.strerror or e}"
    if stat.S_ISDIR(st.st_mode):
        return f"{src}: is a directory"
    if not stat.S_ISREG(st.st_mode):
        return f"{src}: is not a regular file"
    
    # Destination checks
    try:
        os.stat(dst)  # follows symlinks
        # dst exists; check it's not a directory
        dst_st = os.stat(dst)
        if stat.S_ISDIR(dst_st.st_mode):
            return f"{dst}: is a directory"
    except FileNotFoundError:
        # dst doesn't exist - check for dangling symlink
        if os.path.islink(dst):
            return f"{dst}: dangling symbolic link"
        # check parent exists
        parent = os.path.dirname(dst)
        if parent:
            try:
                os.stat(parent)
            except OSError:
                return f"cannot create {dst}: parent directory does not exist"
    except OSError as e:
        return f"cannot stat {dst}: {e.strerror or e}"
    
    # Self-copy check
    if os.path.realpath(src) == os.path.realpath(dst):
        return f"{src} and {dst} are the same file"
    
    return None


def main() -> None:
    argv = sys.argv[1:]
    
    operands, err = _parse_operands(argv)
    if err:
        print(err, file=sys.stderr)
        sys.exit(1)
    
    pairs, err = _resolve_pairs(operands)
    if err:
        print(err, file=sys.stderr)
        sys.exit(1)
    
    # Validate all pairs before any changes
    for src, dst in pairs:
        err = _validate_pair(src, dst)
        if err:
            print(err, file=sys.stderr)
            sys.exit(1)
    
    # Execute copies in order
    had_error = False
    for src, dst in pairs:
        try:
            copy_path(src, dst)
        except OSError as e:
            print(f"py_cp: {src}: {e.strerror or e}", file=sys.stderr)
            had_error = True
    
    sys.exit(1 if had_error else 0)


if __name__ == "__main__":
    main()
```

