        view = memoryview(chunk)
        while view:
            written = os.write(dstfd, view)
            view = view[written:]


def _parse_operands(argv: list[str]) -> tuple[list[str] | None, str | None]:
    """Extract operand list from argv, respecting -- and rejecting unknown options."""
    if "--" in argv:
