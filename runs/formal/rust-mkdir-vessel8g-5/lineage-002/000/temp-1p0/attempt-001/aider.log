```rust
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
use std::process::ExitCode;

fn main() -> ExitCode {
    let args: Vec<std::ffi::OsString> = std::env::args_os().skip(1).collect();
    
    if args.is_empty() {
        let mut err = std::io::stderr().lock();
        let _ = err.write_all(b"mkdir: missing operand\nTry 'mkdir --help' for more information.\n");
        return ExitCode::from(1);
    }
    
    let mut operands: Vec<std::ffi::OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        let bytes = arg.as_bytes();
        if !after_ddash {
            if bytes == b"--" {
                after_ddash = true;
                continue;
            }
            if bytes.len() >= 2 && bytes[0] == b'-' {
                // Unknown option
                let mut err = std::io::stderr().lock();
                if bytes.len() >= 3 && bytes[1] == b'-' {
                    // Long option: unrecognized option '--foo'
                    let _ = err.write_all(b"mkdir: unrecognized option '");
                    let _ = err.write_all(bytes);
                    let _ = err.write_all(b"'\nTry 'mkdir --help' for more information.\n");
                } else {
                    // Short option: invalid option -- 'x'
                    let _ = err.write_all(b"mkdir: invalid option -- '");
                    let _ = err.write_all(&bytes[1..2]);
                    let _ = err.write_all(b"'\nTry 'mkdir --help' for more information.\n");
                }
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        let mut err = std::io::stderr().lock();
        let _ = err.write_all(b"mkdir: missing operand\nTry 'mkdir --help' for more information.\n");
        return ExitCode::from(1);
    }
    
    let mut any_failed = false;
    for operand in &operands {
        if let Err(e) = std::fs::create_dir(operand) {
            let errno = e.raw_os_error().unwrap_or(0);
            let msg = errno_to_message(errno);
            let mut err = std::io::stderr().lock();
            let _ = err.write_all(b"mkdir: cannot create directory '");
            let _ = err.write_all(operand.as_bytes());
            let _ = err.write_all(b"': ");
            let _ = err.write_all(msg.as_bytes());
            let _ = err.write_all(b"\n");
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn errno_to_message(errno: i32) -> &'static str {
    // Linux errno values
    match errno {
        1 => "Operation not permitted",        // EPERM
        2 => "No such file or directory",      // ENOENT
        3 => "No such process",                // ESRCH
        4 => "Interrupted system call",        // EINTR
        5 => "Input/output error",             // EIO
        6 => "No such device or address",      // ENXIO
        7 => "Argument list too long",         // E2BIG
        8 => "Exec format error",              // ENOEXEC
        9 => "Bad file descriptor",            // EBADF
        10 => "No child process",             // ECHILD
        11 => "Resource temporarily unavailable", // EAGAIN/EWOULDBLOCK
        12 => "Cannot allocate memory",        // ENOMEM
        13 => "Permission denied",             // EACCES
        14 => "Bad address",                   // EFAULT
        15 => "Block device required",         // ENOTBLK
        16 => "Resource busy",                 // EBUSY
        17 => "File exists",                   // EEXIST
        18 => "Cross-device link",            // EXDEV
        19 => "No such device",               // ENODEV
        20 => "Not a directory",              // ENOTDIR
        21 => "Is a directory",               // EISDIR
        22 => "Invalid argument",             // EINVAL
        23 => "File table overflow",          // EMFILE (actually ENFILE on some)
        24 => "Too many open files",          // ENFILE (actually EMFILE on some)
        // Actually on Linux: 23 = ENFILE, 24 = EMFILE
        25 => "Not a tty",                     // ENOTTY
        26 => "Text file busy",               // ETXTBSY
        27 => "File too large",               // EFBIG
        28 => "No space left on device",      // ENOSPC
        29 => "Invalid seek",                 // ESPIPE
        30 => "Read-only file system",        // EROFS
        31 => "Too many links",               // EMLINK
        32 => "Broken pipe",                 // EPIPE
        33 => "Domain error",                // EDOM
        34 => "Result not representable",    // ERANGE
        35 => "No message of desired type",  // EAGAIN (actually this is different)
        36 => "File name too long",          // ENAMETOOLONG
        37 => "No link",                     // ENOANO
        38 => "No message available",        // ENOLCK (actually 37)
