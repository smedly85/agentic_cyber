use std::ffi::OsStr;
use std::os::unix::ffi::OsStrExt;
use std::process::ExitCode;

fn main() -> ExitCode {
    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();
    if args.len() < 2 {
        // No arguments at all - this shouldn't happen since argv[0] is always there
        // Actually args[0] is the program name, so args.len() < 2 means no operands
        eprintln!("mkdir: missing operand");
        eprintln!("Try 'mkdir --help' for more information.");
        return ExitCode::from(1);
    }
    
    let args = &args[1..]; // skip program name
    
    let mut operands: Vec<std::ffi::OsString> = Vec::new();
    let mut option_terminator_seen = false;
    
    for arg in args {
        let bytes = arg.as_bytes();
        if !option_terminator_seen {
            if bytes == b"--" {
                option_terminator_seen = true;
                continue;
            }
            if bytes.len() > 1 && bytes[0] == b'-' {
                // It's an option (unknown since we support none)
                if bytes[1] == b'-' {
                    eprintln!("mkdir: unrecognized option '{}'", arg.to_string_lossy());
                } else {
                    eprintln!("mkdir: invalid option -- '{}'", arg.to_string_lossy().chars().nth(1).unwrap_or('?'));
                }
                eprintln!("Try 'mkdir --help' for more information.");
                return ExitCode::from(1);
            }
            // bytes == b"-" or any non-dash-starting arg is an operand
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        eprintln!("mkdir: missing operand");
        eprintln!("Try 'mkdir --help' for more information.");
        return ExitCode::from(1);
    }
    
    let mut any_failed = false;
    for operand in &operands {
        if let Err(e) = std::fs::create_dir(operand) {
            let errno = e.raw_os_error().unwrap_or(0);
            let msg = errno_to_message(errno);
            eprintln!("mkdir: cannot create directory '{}': {}", 
                operand.to_string_lossy(), msg);
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn errno_to_message(errno: i32) -> &'static str {
    match errno {
        17 => "File exists",           // EEXIST
        2 => "No such file or directory", // ENOENT
        20 => "Not a directory",        // ENOTDIR
        13 => "Permission denied",      // EACCES
        30 => "Read-only file system",  // EROFS
        40 => "Too many levels of symbolic links", // ELOOP
        36 => "File name too long",     // ENAMETOOLONG
        28 => "No space left on device", // ENOSPC
        24 => "Too many open files",    // EMFILE
        12 => "Cannot allocate memory", // ENOMEM
        27 => "File too large",         // EFBIG
        21 => "Is a directory",         // EISDIR
        23 => "Too many open files in system", // ENFILE
        22 => "Invalid argument",       // EINVAL
        3 => "No such process",         // ESRCH (unlikely)
        5 => "Input/output error",      // EIO
        6 => "No such device or address", // ENXIO
        18 => "Function not implemented", // ENOSYS
        19 => "Resource temporarily unavailable", // EAGAIN/EWOULDBLOCK
        29 => "No locks available",     // ENOLCK
        38 => "No buffer space available", // ENOBUFS
        52 => "Socket is connected",    // EISCONN (unlikely)
        _ => "Unknown error",
    }
}
