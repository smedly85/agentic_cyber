fn create_parents(operand: &OsString) -> Result<(), std::io::Error> {
    let path = Path::new(operand);
    
    // If it already exists as a directory, we're done
    if is_dir_or_symlink_to_dir(path) {
        return Ok(());
    }
    
    // Collect all proper ancestors
    let mut ancestors: Vec<&Path> = Vec::new();
    let mut p = path;
    while let Some(parent) = p.parent() {
        if parent.as_os_str().is_empty() {
            break;
        }
        ancestors.push(parent);
        p = parent;
    }
    ancestors.reverse();
    
    // Create each ancestor that doesn't already exist as a directory
    for ancestor in &ancestors {
        if is_dir_or_symlink_to_dir(ancestor) {
            continue;
        }
        if ancestor.symlink_metadata().is_ok() {
            return Err(std::io::Error::new(
                std::io::ErrorKind::AlreadyExists,
                "File exists"
            ));
        }
        std::fs::create_dir(ancestor)?;
    }
    
    // Create the final directory
