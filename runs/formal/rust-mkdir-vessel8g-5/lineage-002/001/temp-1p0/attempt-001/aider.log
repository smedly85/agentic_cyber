    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    if args.is_empty() {
        emit_usage_error(b"mkdir: missing operand");
        return ExitCode::from(1);
    }

    let mut parents = false;
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;

    for arg in &args {
        let bytes = arg.as_bytes();
        if after_ddash {
            operands.push(arg.clone());
            continue;
        }
        if bytes == b"--" {
            after_ddash = true;
            continue;
        }
        if bytes.len() >= 2 && bytes[0] == b'-' && bytes[1] != b'-' {
            if bytes == b"-p" {
                parents = true;
                continue;
            }
            emit_unknown_short_option(bytes);
            return ExitCode::from(1);
        }
        if bytes.len() >= 3 && bytes[0] == b'-' && bytes[1] == b'-' {
            if bytes == b"--parents" {
                parents = true;
                continue;
            }
            emit_unknown_long_option(bytes);
            return ExitCode::from(1);
        }
        operands.push(arg.clone());
    }

    if operands.is_empty() {
        emit_usage_error(b"mkdir: missing operand");
        return ExitCode::from(1);
    }

    let mut any_failed = false;
    for operand in &operands {
        let result = if parents {
            create_parents(operand)
        } else {
            std::fs::create_dir(operand)
        };
        if let Err(e) = result {
            let errno = e.raw_os_error().unwrap_or(17); // default to EEXIST
            let msg = errno_to_message(errno);
            let mut stderr = std::io::stderr().lock();
            let _ = stderr.write_all(b"mkdir: cannot create directory '");
            let _ = stderr.write_all(operand.as_bytes());
            let _ = stderr.write_all(b"': ");
            let _ = stderr.write_all(msg.as_bytes());
            let _ = stderr.write_all(b"\n");
            any_failed = true;
        }
    }

    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}
