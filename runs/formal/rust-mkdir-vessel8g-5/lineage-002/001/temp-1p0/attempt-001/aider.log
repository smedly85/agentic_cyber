fn create_parents(operand: &OsString) -> Result<(), std::io::Error> {
    let path = Path::new(operand);
    
    // If the path already exists and is a directory (or symlink to dir), success
    if path_exists_and_is_dir(path) {
        return Ok(());
    }
    
    // Walk components from left to right
    let components: Vec<&OsString> = path.components_iter();
    
    let mut current = OsString::new();
    for component in &components {
        if component == b"." || component.is_empty() {
            continue;
        }
        if !current.is_empty() {
            current.push(b"/");
        }
        current.push(component);
        
        // Check if current path exists
        let p = Path::new(&current);
        if p.exists() {
            // It exists - check if it's a directory or symlink to dir
            if is_dir_or_symlink_to_dir(p) {
                continue;
            } else {
                // Exists but not a directory
                return Err(std::io::Error::new(
                    std::io::ErrorKind::AlreadyExists,
                    "File exists"
                ));
            }
        }
        
        // Doesn't exist - create it
        std::fs::create_dir(p)?;
    }
    
    Ok(())
}
