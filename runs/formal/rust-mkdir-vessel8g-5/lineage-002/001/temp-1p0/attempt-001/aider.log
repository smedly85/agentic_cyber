fn create_parents(operand: &OsString) -> Result<(), std::io::Error> {
    let path = Path::new(operand);
    
    // Quick check: if the full path already exists as a dir, we're done
    if is_dir_or_symlink_to_dir(path) {
        return Ok(());
    }
    
    // Build up path component by component
    let mut current = std::ffi::OsString::new();
    
    for comp in path.components() {
        match comp {
            std::path::Component::CurDir => continue,
            std::path::Component::RootDir => {
                current = std::ffi::OsString::from("/");
                continue;
            }
            std::path::Component::ParentDir | std::path::Component::Normal(_) => {
                if !current.is_empty() && current.as_bytes().last() != Some(&b'/') {
                    current.push("/");
                }
                current.push(comp.as_os_str());
            }
            std::path::Component::Prefix(_) => unreachable!(),
        }
        
        let p = Path::new(&current);
        if is_dir_or_symlink_to_dir(p) {
            continue;
        }
        
        // Check if it exists as something else
        if p.symlink_metadata().is_ok() {
            return Err(std::io::Error::new(
                std::io::ErrorKind::AlreadyExists,
                "File exists"
            ));
        }
        
        std::fs::create_dir(p)?;
    }
    
    Ok(())
}
```

