```rust
use std::ffi::OsString;
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;
use std::process::ExitCode;

const SPECIAL_BITS: u32 = 0o7000;
const ORDINARY_BITS: u32 = 0o0777;
const SETUID: u32 = 0o4000;
const SETGID: u32 = 0o2000;
const STICKY: u32 = 0o1000;

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    let umask = get_umask();

    let (parents, mode, operands) = match parse_args(&args, umask) {
        Ok(v) => v,
        Err(msg) => {
            let mut stderr = std::io::stderr().lock();
            let _ = stderr.write_all(msg.as_bytes());
            return ExitCode::from(1);
        }
    };

    if operands.is_empty() {
        let mut stderr = std::io::stderr().lock();
        let _ = stderr.write_all(b"mkdir: missing operand\n");
        let _ = stderr.write_all(b"Try 'mkdir --help' for more information.\n");
        return ExitCode::from(1);
    }

    let mut any_failed = false;
    for operand in &operands {
        let result = if parents {
            create_parents_mode(operand, mode)
        } else if let Some(m) = mode {
            create_dir_with_mode(operand, m)
        } else {
            std::fs::create_dir(operand)
        };
        if let Err(e) = result {
            emit_create_error(operand, &e);
            any_failed = true;
        }
    }

    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn parse_args(
    args: &[OsString],
    umask: u32,
) -> Result<(bool, Option<u32>, Vec<OsString>), String> {
    let mut parents = false;
    let mut mode: Option<u32> = None;
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;

    let mut i = 0;
    while i < args.len() {
        let arg = &args[i];
        let bytes = arg.as_bytes();

        if after_ddash {
            operands.push(arg.clone());
            i += 1;
            continue;
        }

        if bytes == b"--" {
            after_ddash = true;
            i += 1;
            continue;
        }

        if bytes.len() >= 3 && bytes[0] == b'-' && bytes[1] == b'-' {
            if bytes == b"--parents" {
                parents = true;
                i += 1;
                continue;
            }
            if bytes == b"--mode" {
                if i + 1 >= args.len() {
                    return Err(
                        "mkdir: option '--mode' requires an argument\n\
                         Try 'mkdir --help' for more information.\n"
                            .to_string(),
                    );
                }
                i += 1;
                let m = parse_mode_arg(args[i].as_bytes(), umask)?;
                mode = Some(m);
                i += 1;
                continue;
            }
            if bytes.starts_with(b"--mode=") {
                let val = &bytes[b"--mode=".len()..];
                let m = parse_mode_arg(val, umask)?;
                mode = Some(m);
                i += 1;
                continue;
            }
            let s = String::from_utf8_lossy(bytes);
            return Err(format!(
                "mkdir: unrecognized option '{}'\n\
                 Try 'mkdir --help' for more information.\n",
                s
            ));
        }

        if bytes.len() >= 2 && bytes[0] == b'-' && bytes[1] != b'-' {
            if bytes == b"-p" {
                parents = true;
                i += 1;
                continue;
            }
            if bytes[1] == b'm' {
                if bytes.len() == 2 {
                    if i + 1 >= args.len() {
                        return Err(
                            "mkdir: option '-m' requires an argument\n\
                             Try 'mkdir --help' for more information.\n"
                                .to_string(),
                        );
                    }
                    i += 1;
                    let m = parse_mode_arg(args[i].as_bytes(), umask)?;
                    mode = Some(m);
                    i += 1;
                    continue;
                } else {
                    let val = &bytes[2..];
                    let m = parse_mode_arg(val, umask)?;
                    mode = Some(m);
                    i += 1;
                    continue;
                }
            }
            let c = bytes[1] as char;
            return Err(format!(
                "mkdir: invalid option -- '{}'\n\
                 Try 'mkdir --help' for more information.\n",
                c
            ));
        }

        operands.push(arg.clone());
        i += 1;
    }

    Ok((parents, mode, operands))
}

fn parse_mode_arg(bytes: &[u8], umask: u32) -> Result<u32, String> {
    let s = String::from_utf8_lossy(bytes);
    if bytes.is_empty() {
        return Err(format!("mkdir: invalid mode '{}'\n", s));
    }
    if let Some(m) = try_parse_numeric(bytes) {
        return Ok(m);
    }
    match parse_symbolic_mode(bytes, umask) {
        Ok(m) => Ok(m),
        Err(_) => Err(format!("mkdir: invalid mode '{}'\n", s)),
    }
}

fn try_parse_numeric(bytes: &[u8]) -> Option<u32> {
    if bytes.is_empty() || bytes.len() > 5 {
        return None;
    }
    let mut val: u32 = 0;
    for &b in bytes {
        if b < b'0' || b > b'7' {
            return None;
        }
        val = val * 8 + (b - b'0') as u32;
        if val > 0o7777 {
            return None;
        }
    }
    Some(val)
}

fn parse_symbolic_mode(bytes: &[u8], umask: u32) -> Result<u32, ()> {
    let mut mode: u32 = 0o777;
    let mut ordinary_explicit = false;

    let clauses: Vec<&[u8]> = split_clauses(bytes);
    if clauses.is_empty() {
        return Err(());
    }

    for clause in &clauses {
        if clause.is_empty() {
            return Err(());
        }
        let result = apply_clause(clause, &mut mode, umask);
        if let Some(true) = result {
            ordinary_explicit = true;
        }
        if result.is_none() {
            return Err(());
        }
    }

    if !ordinary_explicit {
        mode = (mode & SPECIAL_BITS) | (mode & ORDINARY_BITS & !umask);
    }

    Ok(mode)
}

fn split_clauses(bytes: &[u8]) -> Vec<&[u8]> {
    let mut out = Vec::new();
    let mut start = 0;
    for (i, &b) in bytes.iter().enumerate() {
        if b == b',' {
            out.push(&bytes[start..i]);
            start = i + 1;
        }
    }
    out.push(&bytes[start..]);
    out
}

fn apply_clause(clause: &[u8], mode: &mut u32, umask: u32) -> Option<bool> {
    let mut i = 0;
    let mut who_u = false;
    let mut who_g = false;
    let mut who_o = false;
    let mut who_omitted = true;

    while i < clause.len() {
        match clause[i] {
            b'u' => {
                who_u = true;
                who_omitted = false;
            }
            b'g' => {
                who_g = true;
                who_omitted = false;
            }
            b'o' => {
                who_o = true;
                who_omitted = false;
            }
            b'a' => {
                who_u = true;
                who_g = true;
                who_o = true;
                who_omitted = false;
            }
            b'+' | b'-' | b'=' => break,
            _ => return None,
        }
        i += 1;
    }

    if i >= clause.len() {
        return None;
    }
    let op = clause[i];
    if !matches!(op, b'+' | b'-' | b'=') {
        return None;
    }
    i += 1;

    if who_omitted {
        who_u = true;
        who_g = true;
        who_o = true;
    }

    let mut perm_r = false;
    let mut perm_w = false;
    let mut perm_x = false;
    let mut perm_s = false;
    let mut perm_t = false;
    let mut copy_u = false;
    let mut copy_g = false;
    let mut copy_o = false;
    let mut perm_empty = true;

    while i < clause.len() {
        match clause[i] {
            b'r' => {
                perm_r = true;
                perm_empty = false;
            }
            b'w' => {
                perm_w = true;
                perm_empty = false;
            }
            b'x' | b'X' => {
                perm_x = true;
                perm_empty = false;
            }
            b's' => {
                perm_s = true;
                perm_empty = false;
            }
            b't' => {
                perm_t = true;
                perm_empty = false;
            }
            b'u' => {
                copy_u = true;
                perm_empty = false;
            }
            b'g' => {
                copy_g = true;
                perm_empty = false;
            }
            b'o' => {
                copy_o = true;
                perm_empty = false;
            }
            _ => return None,
        }
        i += 1;
    }

    let affects_ordinary = perm_r || perm_w || perm_x || copy_u || copy_g || copy_o;
    let is_explicit = !who_omitted;

    let mut perm_bits: u32 = 0;
    if perm_r {
        perm_bits |= 0o004;
    }
    if perm_w {
        perm_bits |= 0o002;
    }
    if perm_x {
        perm_bits |= 0o001;
    }
    if perm_s {
        if who_u {
            perm_bits |= SETUID;
        }
        if who_g {
            perm_bits |= SETGID;
        }
        if who_omitted || (who_u && who_g) {
            perm_bits |= SETUID | SETGID;
        }
    }
    if perm_t {
        perm_bits |= STICKY;
    }

    if copy_u || copy_g || copy_o {
        let src_r = if copy_u { 0o004 } else { 0 };
        let src_w = if copy_u { 0o002 } else { 0 };
        let src_x = if copy_u { 0o001 } else { 0 };
        let src = src_r | src_w | src_x;
        let gsrc_r = if copy_g { 0o040 } else { 0 };
        let gsrc_w = if copy_g { 0o020 } else { 0 };
        let gsrc_x = if copy_g { 0o010 } else { 0 };
        let gsrc = gsrc_r | gsrc_w | gsrc_x;
        let osrc_r = if copy_o { 0o400 } else { 0 };
        let osrc_w = if copy_o { 0o200 } else { 0 };
        let osrc_x = if copy_o { 0o100 } else { 0 };
        let osrc = osrc_r | osrc_w | osrc_x;
        let copy_bits = src | gsrc | osrc;
        match op {
            b'+' => {
                *mode |= copy_bits;
            }
            b'-' => {
                *mode &= !copy_bits;
            }
            b'=' => {
                let who_mask = (who_u as u32) * 0o700
                    | (who_g as u32) * 0o070
                    | (who_o as u32) * 0o007;
                *mode = (*mode & !who_mask) | (copy_bits & who_mask);
            }
            _ => {}
        }
    } else {
        let who_mask =
            (who_u as u32) * 0o700 | (who_g as u32) * 0o070 | (who_o as u32) * 0o007;
        let mut effective_perm = perm_bits;

        if who_omitted {
            let ordinary_part = effective_perm & ORDINARY_BITS;
            effective_perm = (effective_perm & SPECIAL_BITS) | (ordinary_part & !umask);
        }

        match op {
            b'+' => {
                *mode |= effective_perm & who_mask | (effective_perm & SPECIAL_BITS);
            }
            b'-' => {
                *mode &= !(effective_perm & who_mask);
                *mode &= !(effective_perm & SPECIAL_BITS);
            }
            b'=' => {
                *mode = (*mode & !who_mask) | (effective_perm & who_mask);
                if effective_perm & SPECIAL_BITS != 0 {
                    *mode |= effective_perm & SPECIAL_BITS;
                }
            }
            _ => {}
        }
    }

    if perm_empty && op == b'=' {
        let who_mask =
            (who_u as u32) * 0o700 | (who_g as u32) * 0o070 | (who_o as u32) * 0o007;
        *mode &= !who_mask;
        return Some(true);
    }

    if affects_ordinary && is_explicit {
        Some(true)
    } else {
        Some(false)
    }
}

fn get_umask() -> u32 {
    let name = format!(".umask_probe_{}", std::process::id());
    let path = Path::new(&name);
    match std::fs::create_dir(path) {
        Ok(()) => {
            let umask = if let Ok(meta) = std::fs::metadata(path) {
                let m = meta.permissions().mode();
                0o777 & !m
            } else {
                0o022
            };
            let _ = std::fs::remove_dir(path);
            umask
        }
        Err(_) => 0o022,
    }
}

fn create_dir_with_mode(path: &OsString, mode: u32) -> Result<(), std::io::Error> {
    std::fs::create_dir(path)?;
    std::fs::set_permissions(path, std::fs::Permissions::from_mode(mode))?;
    Ok(())
}

fn create_parents_mode(operand: &OsString, mode: Option<u32>) -> Result<(), std::io::Error> {
    let path = Path::new(operand);

    if is_dir_or_symlink_to_dir(path) {
        return Ok(());
    }

    let mut ancestors: Vec<&Path> = Vec::new();
    let mut p = path;
    while let Some(parent) = p.parent() {
        if parent.as_os_str().is_empty() {
            break;
        }
        ancestors.push(parent);
        p = parent;
    }
    ancestors.reverse();

    for ancestor in &ancestors {
        if is_dir_or_symlink_to_dir(ancestor) {
            continue;
        }
        if ancestor.symlink_metadata().is_ok() {
            return Err(std::io::Error::new(
                std::io::ErrorKind::AlreadyExists,
                "File exists",
            ));
        }
        std::fs::create_dir(ancestor)?;
        if let Ok(meta) = std::fs::metadata(ancestor) {
            let current = meta.permissions().mode();
            if current & 0o300 != 0o300 {
                let new_mode = current | 0o300;
                let _ = std::fs::set_permissions(
                    ancestor,
                    std::fs::Permissions::from_mode(new_mode),
                );
            }
        }
    }

    if let Some(m) = mode {
        create_dir_with_mode(path, m)
    } else {
        std::fs::create_dir(path)
    }
}

fn is_dir_or_symlink_to_dir(p: &Path) -> bool {
    std::fs::metadata(p).map(|m| m.is_dir()).unwrap_or(false)
}

fn emit_create_error(operand: &OsString, e: &std::io::Error) {
    let errno = e.raw_os_error().unwrap_or(17);
    let msg = errno_to_message(errno);
    let mut stderr = std::io::stderr().lock();
    let _ = stderr.write_all(b"mkdir: cannot create directory '");
    let _ = stderr.write_all(operand.as_bytes());
    let _ = stderr.write_all(b"': ");
    let _ = stderr.write_all(msg.as_bytes());
    let _ = stderr.write_all(b"\n");
}

fn errno_to_message(errno: i32) -> &'static str {
    match errno {
        1 => "Operation not permitted",
        2 => "No such file or directory",
        5 => "Input/output error",
        12 => "Cannot allocate memory",
        13 => "Permission denied",
        16 => "Resource busy",
        17 => "File exists",
        20 => "Not a directory",
        21 => "Is a directory",
        22 => "Invalid argument",
        23 => "File table overflow",
        24 => "Too many open files",
        27 => "File too large",
        28 => "No space left on device",
        30 => "Read-only file system",
        36 => "File name too long",
        38 => "Function not implemented",
        39 => "Directory not empty",
        40 => "Too many levels of symbolic links",
        _ => "Unknown error",
    }
}
```

**What was failing and why:**
- The `-m` option was completely unimplemented. Any argument starting with `-m` was rejected as an unknown short option (`invalid option -- 'm'`), causing all 95 test failures.
- The missing-operand error message used non-GNU wording (`"Hey, mkdir needs an operand!"` instead of `"mkdir: missing operand"`).

**What was changed:**
- Added full `-m`/`--mode`/`--mode=VALUE`/`-mMODE` argument parsing with last-mode-wins semantics.
- Added numeric octal mode parsing (1-5 octal digits, value ≤ 07777).
- Added symbolic mode parsing with GNU 9.11 directory semantics: `a=rwx` starting point, `+`/`-`/`=` operators, `u`/`g`/`o`/`a` selectors, `rwxXst` permissions, permission-copy, comma-separated clauses, omitted-who umask interaction, and special-bit rules.
- Added `get_umask()` via temp-dir probe (std-only, no unsafe).
- Added `create_dir_with_mode` (create + chmod to override umask).
- Modified `create_parents` to `create_parents_mode`: applies explicit mode only to the final directory; ensures owner write+search on newly-created intermediate parents; does not modify existing directories.
- Fixed the missing-operand error to GNU wording.
- Invalid mode errors use exact format `mkdir: invalid mode 'VALUE'\n`.

**Compiler diagnostics addressed:** None reported in the build (exit 0). The new code uses only `std` APIs available in Rust 1.85 with edition 2021, no `unsafe`, no external crates.

**How edits address every reported failure:**
- All `-m`-related failures: `-m` is now parsed and the mode is applied via `chmod` after directory creation.
- `err-no-operand`: error message corrected to `mkdir: missing operand\nTry 'mkdir --help' for more information.\n`.
- `err-bad-mode` and all `neg-m-*` / `rand-neg-*`: invalid modes are rejected with `mkdir: invalid mode 'VALUE'\n`.
- `adv-*` cases (dot, dotdot, leading-dash, long-name, many-operands, name variants, symlink-parent): these all pass `-m` as an argument which is now correctly consumed, leaving the intended operand for directory creation.
- `quirk-*` and `pair-*` and `single-m-*` and `rand-ok-*`: mode is correctly applied to newly created directories with proper umask interaction.

**Unresolved constraints:** The `get_umask()` function creates a temporary directory in the current working directory to probe the umask value. This is the only std-only, no-unsafe approach available. It uses a PID-unique name and cleans up immediately. If the CWD is not writable (extremely unlikely in the test harness which uses `TemporaryDirectory`), it falls back to 0022.
