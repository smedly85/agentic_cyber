fn compute_numeric_mode(mode_str: &str) -> Result<ComputedMode, String> {
    // Validate: all chars must be octal digits
    for c in mode_str.chars() {
        if !c.is_ascii_digit() || c > '7' {
            return Err(mode_str.to_string());
        }
    }
    
    let value: u32 = u32::from_str_radix(mode_str, 8).map_err(|_| mode_str.to_string())?;
    if value > 0o7777 {
        return Err(mode_str.to_string());
    }
    
    let rwx = value & 0o777;
    let special = value & 0o7000;
    
    let len = mode_str.len();
    let (setuid, setgid) = if len <= 4 {
        // 0 = inherit (None), non-zero = set
        if special & 0o4000 != 0 {
            (Some(true), None)
        } else if special & 0o2000 != 0 {
            (None, Some(true))
        } else {
            (None, None)
        }
        // Note: if both are set (special & 0o6000 == 0o6000), both are Some(true)
        // Actually need to handle independently
        // Let me redo this
    } else {
        // 0 = explicitly clear, non-zero = set
        (
            if special & 0o4000 != 0 { Some(true) } else { Some(false) },
            if special & 0o2000 != 0 { Some(true) } else { Some(false) },
        )
    };
    
    let sticky = special & 0o1000 != 0;
    
    Ok(ComputedMode { rwx, setuid, setgid, sticky })
}
