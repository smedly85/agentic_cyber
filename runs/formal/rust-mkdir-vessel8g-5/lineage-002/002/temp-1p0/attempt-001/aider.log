               if bytes == b"--parents" {
                   parents = true;
               } else if bytes == b"--mode" {
                   // --mode MODE (next arg is the mode)
                   if i + 1 >= args.len() {
                       // missing argument for --mode
                       eprint!("mkdir: option '--mode' requires an argument\nTry 'mkdir --help' for more information.\n");
                       return ExitCode::from(1);
                   }
                   i += 1;
                   let mode_str = &args[i];
                   match parse_mode(mode_str) {
                       Ok(m) => mode = Some(m),
                       Err(s) => {
                           eprint!("mkdir: invalid mode '{}'\n", s);
                           return ExitCode::from(1);
                       }
                   }
               } else if bytes.starts_with(b"--mode=") {
                   let mode_bytes = &bytes[7..]; // after "--mode="
                   let mode_str = String::from_utf8_lossy(mode_bytes);
                   match parse_mode_bytes(mode_bytes) {
                       Ok(m) => mode = Some(m),
                       Err(_) => {
                           eprint!("mkdir: invalid mode '{}'\n", mode_str);
                           return ExitCode::from(1);
                       }
                   }
               } else {
                   // unknown long option
                   eprint!("mkdir: unrecognized option '{}'\nTry 'mkdir --help' for more information.\n", String::from_utf8_lossy(bytes));
                   return ExitCode::from(1);
               }
               i += 1;
               continue;
           }
           
           // Short options
           if bytes.len() >= 2 && bytes[0] == b'-' && bytes[1] != b'-' {
               if bytes == b"-p" {
                   parents = true;
                   i += 1;
                   continue;
               }
               if bytes.len() >= 2 && bytes[1] == b'm' {
                   // -m or -mMODE
                   if bytes.len() == 2 {
                       // -m MODE (next arg)
                       if i + 1 >= args.len() {
                           eprint!("mkdir: option '-m' requires an argument\nTry 'mkdir --help' for more information.\n");
                           return ExitCode::from(1);
                       }
                       i += 1;
                       let mode_bytes = args[i].as_bytes();
                       match parse_mode_bytes(mode_bytes) {
                           Ok(m) => mode = Some(m),
                           Err(_) => {
                               let s = String::from_utf8_lossy(mode_bytes);
                               eprint!("mkdir: invalid mode '{}'\n", s);
                               return ExitCode::from(1);
                           }
                       }
                   } else {
                       // -mMODE (attached)
                       let mode_bytes = &bytes[2..];
                       match parse_mode_bytes(mode_bytes) {
                           Ok(m) => mode = Some(m),
                           Err(_) => {
                               let s = String::from_utf8_lossy(mode_bytes);
                               eprint!("mkdir: invalid mode '{}'\n", s);
                               return ExitCode::from(1);
                           }
                       }
                   }
                   i += 1;
                   continue;
               }
               // unknown short option
               eprint!("mkdir: invalid option -- '{}'\nTry 'mkdir --help' for more information.\n", String::from_utf8_lossy(&bytes[1..2]));
               return ExitCode::from(1);
           }
           
           // Operand
           operands.push(arg.clone());
           i += 1;
       }
       
       if operands.is_empty() {
           eprint!("mkdir: missing operand\nTry 'mkdir --help' for more information.\n");
           return ExitCode::from(1);
       }
       
       // Create directories
       let umask = get_umask();
       let mut any_failed = false;
       
       for operand in &operands {
           let result = if parents {
               create_parents(operand, mode, umask)
           } else if let Some(m) = mode {
               create_dir_with_mode(operand, m)
           } else {
               std::fs::create_dir(operand)
           };
           if let Err(e) = result {
               emit_create_error(operand, &e);
               any_failed = true;
           }
       }
       
       if any_failed {
           ExitCode::from(1)
       } else {
           ExitCode::SUCCESS
       }
   }
