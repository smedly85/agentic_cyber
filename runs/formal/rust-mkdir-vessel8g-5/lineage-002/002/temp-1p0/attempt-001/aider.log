               return Err("empty clause"); // Actually, trailing comma?
           }
           
           // Parse who
           let mut i = 0;
           let mut who_u = false;
           let mut who_g = false;
           let mut who_o = false;
           let mut who_omitted = true;
           
           while i < clause.len() {
               match clause[i] {
                   b'u' => { who_u = true; who_omitted = false; }
                   b'g' => { who_g = true; who_omitted = false; }
                   b'o' => { who_o = true; who_omitted = false; }
                   b'a' => { who_u = true; who_g = true; who_o = true; who_omitted = false; }
                   b'+' | b'-' | b'=' => break,
                   _ => return Err(...),
               }
               i += 1;
           }
           
           if i >= clause.len() {
               return Err("missing operator");
           }
           
           let op = clause[i];
           i += 1;
           
           // Parse perms
           let mut perm_r = false;
           let mut perm_w = false;
           let mut perm_x = false;
           let mut perm_s = false;
           let mut perm_t = false;
           let mut perm_copy_u = false;
           let mut perm_copy_g = false;
           let mut perm_copy_o = false;
           let mut perm_empty = true;
           
           while i < clause.len() {
               match clause[i] {
                   b'r' => { perm_r = true; perm_empty = false; }
                   b'w' => { perm_w = true; perm_empty = false; }
                   b'x' | b'X' => { perm_x = true; perm_empty = false; }
                   b's' => { perm_s = true; perm_empty = false; }
                   b't' => { perm_t = true; perm_empty = false; }
                   b'u' => { perm_copy_u = true; perm_empty = false; }
                   b'g' => { perm_copy_g = true; perm_empty = false; }
                   b'o' => { perm_copy_o = true; perm_empty = false; }
                   _ => return Err(...),
               }
               i += 1;
           }
           
           // Now apply the operation
           // ...
       }
       
       // Apply umask if ordinary was never explicitly set
       if !ordinary_explicit {
           mode = (mode & MODE_SPECIAL) | (mode & MODE_ORDINARY & !umask);
       }
       
       mode
   }
