use std::ffi::OsString;
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
use std::path::Component;
use std::process;

fn os_error_str(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.find(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

/// Create the path and all missing intermediate directories.
/// Returns Ok(()) on success, Err(message) on failure.
fn mkdir_p(path: &std::ffi::OsStr) -> Result<(), String> {
    let components: Vec<Component> = path.components().collect();
    
    if components.is_empty() {
        return Err(format!("mkdir: cannot create directory '{}': No such file or directory", 
                           path.to_string_lossy()));
    }
    
    let mut current = OsString::new();
    let total = components.len();
    
    for (i, comp) in components.iter().enumerate() {
        match comp {
            Component::CurDir => continue,
            Component::ParentDir => {
                current.push("..");
                // We don't need to create anything for .., just verify the resolved path exists
                // Actually, .. always resolves to something that exists (at least /), so skip
                // But we should still check
                // Actually, let's just verify it can be resolved
                continue;
            }
            Component::RootDir => {
                current = OsString::from("/");
                continue;
            }
            Component::Normal(name) => {
                current.push(name);
            }
        }
        
        let is_last = (i == total - 1);
        
        match std::fs::symlink_metadata(&current) {
            Ok(meta) => {
                let ft = meta.file_type();
                if ft.is_dir() {
                    // Already a directory, OK
                    continue;
                }
                if ft.is_symlink() {
                    // Check where it resolves
                    match std::fs::metadata(&current) {
                        Ok(m) if m.is_dir() => continue,
                        _ => {
                            // Symlink to non-directory
                            if is_last {
                                return Err(format!(
                                    "mkdir: cannot create directory '{}': File exists",
                                    current.to_string_lossy()));
                            } else {
                                return Err(format!(
                                    "mkdir: cannot create directory '{}': Not a directory",
                                    current.to_string_lossy()));
                            }
                        }
                    }
                }
                // Regular file or other non-dir, non-symlink
                if is_last {
                    return Err(format!(
                        "mkdir: cannot create directory '{}': File exists",
                        current.to_string_lossy()));
                } else {
                    return Err(format!(
                        "mkdir: cannot create directory '{}': Not a directory",
                        current.to_string_lossy()));
                }
            }
            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
                // Path doesn't exist, create it
                std::fs::create_dir(&current).map_err(|e| {
                    format!("mkdir: cannot create directory '{}': {}",
                            current.to_string_lossy(), os_error_str(&e))
                })?;
                continue;
            }
            Err(e) => {
                return Err(format!(
                    "mkdir: cannot create directory '{}': {}",
                    current.to_string_lossy(), os_error_str(&e)));
            }
        }
    }
    
    Ok(())
}
```

