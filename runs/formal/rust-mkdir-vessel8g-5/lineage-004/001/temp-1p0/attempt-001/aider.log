   ```rust
   fn mkdir_p(operand: &OsStr) -> Result<(), Vec<u8>> {
       let bytes = operand.as_bytes();
       
       // Build list of component byte-slices
       let mut segments: Vec<&[u8]> = Vec::new();
       for seg in bytes.split(|&b| b == b'/') {
           if seg.is_empty() || seg == b"." {
               continue;
           }
           if seg == b".." {
               // Pop last non-".." segment
               if let Some(last) = segments.last() {
                   if *last != b".." {
                       segments.pop();
                       continue;
                   }
               }
           }
           segments.push(seg);
       }
       
       if segments.is_empty() {
           // Path is just "/", or just dots, or empty
           if bytes == b"/" || bytes.starts_with(b"/") && bytes.trim_end_matches('/') == b"" {
               // root dir already exists
               return Ok(());
           }
           return Err(err_msg(operand, "No such file or directory"));
       }
       
       let is_absolute = bytes[0] == b'/';
       
       let mut current_bytes: Vec<u8> = Vec::new();
       if is_absolute {
           current_bytes.push(b'/');
       }
       
       for (i, seg) in segments.iter().enumerate() {
           if !current_bytes.is_empty() && current_bytes.last().unwrap() != &b'/' {
               current_bytes.push(b'/');
           }
           current_bytes.extend_from_slice(*seg);
           
           let path = OsString::from_vec(current_bytes.clone());
           let is_last = (i + 1) == segments.len();
           
           match std::fs::symlink_metadata(&path) {
               Ok(meta) => {
                   let ft = meta.file_type();
                   if ft.is_dir() {
                       continue;
                   }
                   if ft.is_symlink() {
                       if let Ok(m) = std::fs::metadata(&path) {
                           if m.is_dir() {
                               continue;
                           }
                       }
                   }
                   if is_last {
                       return Err(err_msg(operand, "File exists"));
                   } else {
                       return Err(err_msg(operand, "Not a directory"));
                   }
               }
               Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
                   if let Err(e) = std::fs::create_dir(&path) {
                       return Err(err_msg(operand, &os_error_str(&e)));
                   }
                   if !is_last {
                       if let Ok(meta) = std::fs::metadata(&path) {
                           let mode = meta.permissions().mode();
                           let _ = std::fs::set_permissions(
                               &path,
                               std::fs::Permissions::from_mode(mode | 0o300),
                           );
                       }
                   }
                   continue;
               }
               Err(e) => {
                   return Err(err_msg(operand, &os_error_str(&e)));
               }
           }
       }
       
       Ok(())
   }
   ```

   This approach explicitly builds the path as bytes with `/` separators, so there's no ambiguity.

