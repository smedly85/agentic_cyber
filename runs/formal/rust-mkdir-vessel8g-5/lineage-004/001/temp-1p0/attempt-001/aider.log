use std::ffi::OsString;
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
use std::path::Component;
use std::process;

fn os_error_str(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.find(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

fn mkdir_p(operand: &std::ffi::OsStr) -> Result<(), Vec<u8>> {
    let components: Vec<Component> = operand.components().collect();
    
    if components.is_empty() {
        let mut msg = b"mkdir: cannot create directory '".to_vec();
        msg.extend_from_slice(operand.as_bytes());
        msg.extend_from_slice(b"': No such file or directory\n".as_slice());
        return Err(msg);
    }
    
    let mut current = OsString::new();
    let total = components.len();
    
    for (i, comp) in components.iter().enumerate() {
        match comp {
            Component::CurDir => continue,
            Component::ParentDir => {
                // Push and let OS resolve when we check
                current.push("..");
                // .. always resolves to an existing directory (at worst /)
                // No need to create, but we should verify the resolved path is accessible
                // Actually, if it's not the last, the next iteration will check the combined path
                // If it IS the last, it resolves to an existing dir, so we're fine
                continue;
            }
            Component::RootDir => {
                current = OsString::from("/");
                continue;
            }
            Component::Normal(name) => {
                current.push(name);
            }
        }
        
        let is_last = (i == total - 1);
        
        match std::fs::symlink_metadata(&current) {
            Ok(meta) => {
                let ft = meta.file_type();
                if ft.is_dir() {
                    continue;
                }
                if ft.is_symlink() {
                    match std::fs::metadata(&current) {
                        Ok(m) if m.is_dir() => continue,
                        _ => {}
                    }
                    // Symlink to non-dir
                    if is_last {
                        let mut msg = b"mkdir: cannot create directory '".to_vec();
                        msg.extend_from_slice(operand.as_bytes());
                        msg.extend_from_slice(b"': File exists\n".as_slice());
                        return Err(msg);
                    } else {
                        let mut msg = b"mkdir: cannot create directory '".to_vec();
                        msg.extend_from_slice(operand.as_bytes());
                        msg.extend_from_slice(b"': Not a directory\n".as_slice());
                        return Err(msg);
                    }
                }
                // Non-dir, non-symlink (regular file, etc.)
                if is_last {
                    let mut msg = b"mkdir: cannot create directory '".to_vec();
                    msg.extend_from_slice(operand.as_bytes());
                    msg.extend_from_slice(b"': File exists\n".as_slice());
                    return Err(msg);
                } else {
                    let mut msg = b"mkdir: cannot create directory '".to_vec();
                    msg.extend_from_slice(operand.as_bytes());
                    msg.extend_from_slice(b"': Not a directory\n".as_slice());
                    return Err(msg);
                }
            }
            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
                // Doesn't exist, create it
                if let Err(e) = std::fs::create_dir(&current) {
                    let err_desc = os_error_str(&e);
                    let mut msg = b"mkdir: cannot create directory '".to_vec();
                    msg.extend_from_slice(operand.as_bytes());
                    msg.extend_from_slice(b"': ".as_slice());
                    msg.extend_from_slice(err_desc.as_bytes());
                    msg.extend_from_slice(b"\n".as_slice());
                    return Err(msg);
                }
                continue;
            }
            Err(e) => {
                let err_desc = os_error_str(&e);
                let mut msg = b"mkdir: cannot create directory '".to_vec();
                msg.extend_from_slice(operand.as_bytes());
                msg.extend_from_slice(b"': ".as_slice());
                msg.extend_from_slice(err_desc.as_bytes());
                msg.extend_from_slice(b"\n".as_slice());
                return Err(msg);
            }
        }
    }
    
    Ok(())
}

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    let mut operands: Vec<OsString> = Vec::new();
    let mut parents = false;
    let mut after_ddash = false;
    
    for arg in &args {
        if after_ddash {
            operands.push(arg.clone());
            continue;
        }
        let bytes = arg.as_bytes();
        if bytes == b"--" {
            after_ddash = true;
            continue;
        }
        if bytes == b"-" {
            operands.push(arg.clone());
            continue;
        }
        if bytes[0] == b'-' && bytes.len() > 1 {
            if bytes == b"-p" || bytes == b"--parents" {
                parents = true;
                continue;
            }
            // Unknown option
            let stderr = std::io::stderr();
            let mut lock = stderr.lock();
            if bytes.len() >= 3 && bytes[1] == b'-' {
                let _ = lock.write_all(b"mkdir: unrecognized option '");
                let _ = lock.write_all(bytes);
                let _ = lock.write_all(b"'\n");
            } else {
                let _ = lock.write_all(b"mkdir: invalid option -- '");
                let _ = lock.write_all(&[bytes[1]]);
                let _ = lock.write_all(b"'\n");
            }
            let _ = lock.write_all(b"Try 'mkdir --help' for more information.\n");
            process::exit(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        let stderr = std::io::stderr();
        let mut lock = stderr.lock();
        let _ = lock.write_all(b"mkdir: missing operand\n");
        let _ = lock.write_all(b"Try 'mkdir --help' for more information.\n");
        process::exit(1);
    }
    
    let mut any_failed = false;
    for operand in &operands {
        if parents {
            if let Err(msg) = mkdir_p(operand) {
                let stderr = std::io::stderr();
                let mut lock = stderr.lock();
                let _ = lock.write_all(&msg);
                any_failed = true;
            }
        } else {
            if let Err(e) = std::fs::create_dir(operand) {
                let err_msg = os_error_str(&e);
                let stderr = std::io::stderr();
                let mut lock = stderr.lock();
                let _ = lock.write_all(b"mkdir: cannot create directory '");
                let _ = lock.write_all(operand.as_bytes());
                let _ = lock.write_all(b"': ");
                let _ = lock.write_all(err_msg.as_bytes());
                let _ = lock.write_all(b"\n");
                any_failed = true;
            }
        }
    }
    
    if any_failed {
        process::exit(1);
    }
}
