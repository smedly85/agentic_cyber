```rust
use std::env;
use std::ffi::OsStr;
use std::os::unix::ffi::OsStrExt;
use std::process;

fn os_error_str(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.find(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

fn main() {
    let args: Vec<std::ffi::OsString> = env::args_os().skip(1).collect();
    
    let mut operands: Vec<std::ffi::OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if after_ddash {
            operands.push(arg.clone());
            continue;
        }
        let bytes = arg.as_bytes();
        if bytes == b"--" {
            after_ddash = true;
            continue;
        }
        if bytes == b"-" {
            operands.push(arg.clone());
            continue;
        }
        if bytes[0] == b'-' && bytes.len() > 1 {
            // Unknown option
            if bytes.len() >= 3 && bytes[1] == b'-' {
                // Long option: --foo
                let opt_str = String::from_utf8_lossy(&bytes[1..]);
                eprint!("mkdir: unrecognized option '{}'\n", opt_str);
            } else {
                // Short option: -x
                let c = bytes[1] as char;
                eprint!("mkdir: invalid option -- '{}'\n", c);
            }
            eprint!("Try 'mkdir --help' for more information.\n");
            process::exit(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        eprint!("mkdir: missing operand\n");
        eprint!("Try 'mkdir --help' for more information.\n");
        process::exit(1);
    }
    
    let mut any_failed = false;
    for operand in &operands {
        match std::fs::create_dir(operand) {
            Ok(()) => {}
            Err(e) => {
                // Format: mkdir: cannot create directory 'PATH': ERROR
                let path_str = operand.to_string_lossy();
                eprint!("mkdir: cannot create directory '{}': {}\n", path_str, os_error_str(&e));
                any_failed = true;
            }
        }
    }
    
    if any_failed {
        process::exit(1);
    }
}
```

