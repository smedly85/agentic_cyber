                            Ok(md) if md.is_dir() => {}
                            _ => return Err(e),
                        }
                    }
                    // Intermediate: accept EEXIST (GNU behavior)
                } else {
                    return Err(e);
                }
            }
        }
    }

    Ok(())
}
