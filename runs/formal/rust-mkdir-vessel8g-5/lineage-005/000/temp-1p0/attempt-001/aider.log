fn errno_string(e: &std::io::Error) -> String {
    let s = e.to_string();
    // Format is "Description (os error N)" on Unix
    if let Some(idx) = s.rfind(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}
```

