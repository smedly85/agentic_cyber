```rust
use std::env;
use std::ffi::OsString;
use std::os::unix::ffi::OsStrExt;
use std::process;

fn errno_string(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.rfind(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    
    let mut operands: Vec<OsString> = Vec::new();
    let mut option_terminated = false;
    
    for arg in &args {
        if !option_terminated {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                if bytes == b"--" {
                    option_terminated = true;
                    continue;
                }
                // Unknown option
                if bytes.len() == 2 {
                    // single char option: -X
                    let c = bytes[1] as char;
                    eprintln!("mkdir: invalid option -- '{}'", c);
                } else if bytes[1] == b'-' {
                    // long option: --word
                    let word = String::from_utf8_lossy(&bytes[1..]);
                    eprintln!("mkdir: unrecognized option '{}'", word);
                } else {
                    // multiple short chars: -xyz
                    let c = bytes[1] as char;
                    eprintln!("mkdir: invalid option -- '{}'", c);
                }
                process::exit(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        eprintln!("mkdir: missing operand");
        process::exit(1);
    }
    
    let mut had_error = false;
    for op in &operands {
        match std::fs::create_dir(op) {
            Ok(()) => {}
            Err(e) => {
                let name = op.to_string_lossy();
                eprintln!("mkdir: cannot create directory '{}': {}", name, errno_string(&e));
                had_error = true;
            }
        }
    }
    
    process::exit(if had_error { 1 } else { 0 });
}
```

