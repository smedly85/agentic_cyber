Here is the complete implementation for `src/rust_mkdir/rust_mkdir.rs`:

```rust
use std::ffi::OsString;
use std::os::unix::ffi::OsStrExt;

fn errno_string(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.rfind(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let mut operands: Vec<OsString> = Vec::new();
    let mut option_terminated = false;

    for arg in &args {
        if !option_terminated {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                if bytes == b"--" {
                    option_terminated = true;
                    continue;
                }
                if bytes.len() == 2 || bytes[1] != b'-' {
                    let c = bytes[1] as char;
                    eprintln!("mkdir: invalid option -- '{}'", c);
                } else {
                    let word = String::from_utf8_lossy(&bytes[1..]);
                    eprintln!("mkdir: unrecognized option '{}'", word);
                }
                std::process::exit(1);
            }
        }
        operands.push(arg.clone());
    }

    if operands.is_empty() {
        eprintln!("mkdir: missing operand");
        std::process::exit(1);
    }

    let mut had_error = false;
    for op in &operands {
        if let Err(e) = std::fs::create_dir(op) {
            eprintln!(
                "mkdir: cannot create directory '{}': {}",
                op.to_string_lossy(),
                errno_string(&e)
            );
            had_error = true;
        }
    }

    std::process::exit(if had_error { 1 } else { 0 });
}
```

**Files changed:** `src/rust_mkdir/rust_mkdir.rs` (created from scratch)

**Behavior implemented:**
- Creates each operand as a single-level directory via `mkdir(2)` with mode 0777 (kernel applies umask)
- `--` terminates option parsing; subsequent args (including dash-prefixed) are literal operands
- Bare `-` is an operand
- Unknown short options (`-X` or `-XY`): reports `invalid option -- 'X'`, exits 1 immediately
- Unknown long options (`--word`): reports `unrecognized option '--word'`, exits 1 immediately
- No operands: reports `missing operand`, exits 1
- Per-operand creation failure: reports `cannot create directory 'NAME': <errno string>`, continues to next operand
- Exit 0 iff all operands created successfully; exit 1 otherwise
- stdout is always empty; stderr empty on full success
- Byte-string paths handled via `OsString`/`OsStr` (no UTF-8 requirement)
- No unsafe, no external dependencies, std only
- No flags or options beyond `--` terminator

**Interpretation chosen:** When an unknown option is encountered, the program reports it and exits 1 without attempting any directory creation (matching GNU coreutils behavior where `usage(EXIT_FAILURE)` halts processing). The "continue after per-operand errors" requirement applies only to operand creation failures, not option parsing errors.
