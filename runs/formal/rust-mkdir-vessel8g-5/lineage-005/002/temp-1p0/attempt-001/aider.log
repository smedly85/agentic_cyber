OK let me now write the full algorithm:

```rust
fn evaluate_symbolic(mode_str: &str, umask: u32) -> Result<u32, String> {
    // umask is the ordinary-bits portion (lower 9 bits)
    let umask_ordinary = umask & 0o777;
    
    // Parse all clauses
    let clauses: Vec<Result<Vec<ClauseOp>, String>> = mode_str
        .split(',')
        .map(|c| parse_clause(c))
        .collect();
    
    // Check all clauses parsed successfully
    let mut all_ops = Vec::new();
    for c in clauses {
        all_ops.extend(c?);
    }
    
    // Determine if any op touches ordinary bits
    let touches_ordinary = all_ops.iter().any(|op| op.touches_ordinary());
    
    // Starting mode
    let start_ordinary: u32 = if touches_ordinary {
        0o777
    } else {
        0o777 & !umask_ordinary & 0o777
    };
    let mut mode: u32 = start_ordinary;
    
    // Apply each operation in order
    for op in &all_ops {
        mode = apply_op(mode, op, umask_ordinary)?;
    }
    
    Ok(mode & 0o7777)
}
```

