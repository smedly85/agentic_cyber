```rust
fn apply_op(mode: u32, op: &PermOp, umask: u32) -> u32 {
    let umask = umask & 0o777;
    let who = if op.who == 0 { WHO_A } else { op.who }; // omitted who → a
    let who_omitted = op.who == 0;
    
    // Compute the effective permission bits for this op
    // This is a u32 mask of the bits to be affected
    let mut perm_mask: u32 = 0;
    
    if op.is_copy {
        // Copy source: get the ordinary bits of the source class
        let src = match op.copy_who {
            WHO_U => (mode >> 6) & 0o7,
            WHO_G => (mode >> 3) & 0o7,
            WHO_O => mode & 0o7,
            _ => 0,
        };
        // Expand src bits to the target who classes
        if who & WHO_U != 0 { perm_mask |= src << 6; }
        if who & WHO_G != 0 { perm_mask |= src << 3; }
        if who & WHO_O != 0 { perm_mask |= src; }
    } else {
        // Regular permissions
        if op.perms & PERM_R != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o400; }
            if who & WHO_G != 0 { perm_mask |= 0o040; }
            if who & WHO_O != 0 { perm_mask |= 0o004; }
        }
        if op.perms & PERM_W != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o200; }
            if who & WHO_G != 0 { perm_mask |= 0o020; }
            if who & WHO_O != 0 { perm_mask |= 0o002; }
        }
        if op.perms & PERM_X != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o100; }
            if who & WHO_G != 0 { perm_mask |= 0o010; }
            if who & WHO_O != 0 { perm_mask |= 0o001; }
        }
        if op.perms & PERM_S != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o4000; }
            if who & WHO_G != 0 { perm_mask |= 0o2000; }
        }
        if op.perms & PERM_T != 0 {
            if who & WHO_O != 0 { perm_mask |= 0o1000; }
        }
    }
    
    // Separate ordinary and special bits
    let ordinary_mask = perm_mask & 0o777;
    let special_mask = perm_mask & 0o7000;
    
    match op.op {
        '+' => {
            if who_omitted {
                // Only add ordinary bits not protected by umask
                let add_ordinary = ordinary_mask & !umask & 0o777;
                mode |= add_ordinary;
                mode |= special_mask; // special bits not affected by umask
            } else {
                mode |= perm_mask;
            }
        }
        '-' => {
            if who_omitted {
                // Only remove ordinary bits not protected by umask
                let remove_ordinary = ordinary_mask & !umask & 0o777;
                mode &= !remove_ordinary & 0o7777;
                mode &= !special_mask & 0o7777; // special bits not affected by umask
            } else {
                mode &= !perm_mask & 0o7777;
            }
        }
        '=' => {
            // Set the affected bits
            if who_omitted {
                // Ordinary: set to (requested & ~umask)
                let new_ordinary = ordinary_mask & !umask & 0o777;
                // Special: handle per the special-bit rules
                let new_special = handle_equals_special(mode, op, who, special_mask);
                mode = (mode & 0o7777) & 0o0000; // clear everything? No...
                // Actually: replace the affected classes' bits
                // For omitted who (who=a): replace all ordinary bits
                mode = (mode & 0o7000) & !0o777; // preserve special, clear ordinary
                mode |= new_ordinary;
                mode |= new_special;
            } else {
                // Explicit who: set the selected classes' bits
                // Clear the selected classes' ordinary bits, then set to requested
                let class_mask: u32 = if who & WHO_U != 0 { 0o700 } else { 0 }
                                  | if who & WHO_G != 0 { 0o070 } else { 0 }
                                  | if who & WHO_O != 0 { 0o007 } else { 0 };
                mode &= !class_mask; // clear selected classes
                mode |= ordinary_mask; // set requested ordinary bits
                
                // Special bits
                let new_special = handle_equals_special(mode, op, who, special_mask);
                // Clear old special bits that are being replaced
                // ... this is getting complex
            }
        }
        _ => {}
    }
    
    mode & 0o7777
}
