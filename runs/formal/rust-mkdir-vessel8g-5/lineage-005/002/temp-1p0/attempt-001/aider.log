## Implementation Instructions for `src/rust_mkdir/rust_mkdir.rs`

Replace the entire file with the following. The changes add `-m`/`--mode` support with full GNU 9.11 symbolic and numeric mode semantics, while preserving existing `-p`/`--parents` behavior.

**Key architectural decisions:**
- Mode is parsed into a list of `(who, op, perm_mask, is_copy, copy_who)` operations, then evaluated against a starting mode
- Umask is probed by creating and removing a temporary directory
- Directory creation with explicit mode = create (gets `0777 & ~umask`) then `chmod` to the desired value
- With `-p`, mode applies only to the final newly-created directory; intermediates use the normal umask rule + owner-wx

```rust
use std::ffi::OsString;
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::PermissionsExt;

// ─── errno helper ───────────────────────────────────────────────────────────

fn errno_string(e: &std::io::Error) -> String {
    let s = e.to_string();
    if let Some(idx) = s.rfind(" (os error ") {
        s[..idx].to_string()
    } else {
        s
    }
}

// ─── ensure owner wx on intermediate parents ───────────────────────────────

fn ensure_owner_wx(path: &std::ffi::OsStr) {
    if let Ok(md) = std::fs::metadata(path) {
        let mode = md.permissions().mode() & 0o7777;
        if mode & 0o300 != 0o300 {
            let mut perms = md.permissions();
            perms.set_mode(mode | 0o300);
            let _ = std::fs::set_permissions(path, perms);
        }
    }
}

// ─── umask probe ────────────────────────────────────────────────────────────

fn get_umask() -> u32 {
    let name = format!(".mkdir_umask_probe_{}", std::process::id());
    let path = std::path::Path::new(&name);
    if std::fs::create_dir(path).is_ok() {
        if let Ok(md) = std::fs::metadata(path) {
            let mode = md.permissions().mode() & 0o777;
            let _ = std::fs::remove_dir(path);
            return 0o777 & !mode;
        }
        let _ = std::fs::remove_dir(path);
    }
    0o022
}

// ─── mode parsing ───────────────────────────────────────────────────────────

const PERM_R: u8 = 1;
const PERM_W: u8 = 2;
const PERM_X: u8 = 4;
const PERM_S: u8 = 8;
const PERM_T: u8 = 16;

const WHO_U: u8 = 1;
const WHO_G: u8 = 2;
const WHO_O: u8 = 4;

struct PermOp {
    who: u8,       // 0 = omitted, else bitmask of WHO_U|WHO_G|WHO_O
    op: char,      // '+', '-', '='
    perms: u8,     // bitmask of PERM_R|W|X|S|T
    is_copy: bool,
    copy_who: u8,  // WHO_U, WHO_G, or WHO_O
}

fn is_numeric_mode(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|b| (b'0'..=b'7').contains(&b))
}

fn parse_numeric(s: &str) -> Result<u32, String> {
    let v = u32::from_str_radix(s, 8).map_err(|_| "invalid mode".to_string())?;
    if v > 0o7777 {
        return Err("invalid mode".to_string());
    }
    Ok(v)
}

fn parse_symbolic(s: &str) -> Result<Vec<PermOp>, String> {
    let mut ops = Vec::new();
    for clause in s.split(',') {
        if clause.is_empty() {
            return Err("invalid mode".to_string());
        }
        let cb = clause.as_bytes();
        let mut i = 0usize;
        while i < cb.len() {
            match cb[i] {
                b'u' | b'g' | b'o' | b'a' => i += 1,
                _ => break,
            }
        }
        let who_s = std::str::from_utf8(&cb[..i]).unwrap();
        let mut who: u8 = 0;
        for c in who_s.bytes() {
            match c {
                b'u' => who |= WHO_U,
                b'g' => who |= WHO_G,
                b'o' => who |= WHO_O,
                b'a' => who = WHO_U | WHO_G | WHO_O,
                _ => {}
            }
        }

        let rest = &clause[i..];
        if rest.is_empty() {
            return Err("invalid mode".to_string());
        }
        let rb = rest.as_bytes();
        let mut j = 0usize;
        while j < rb.len() {
            let op_char = rb[j] as char;
            if op_char != '+' && op_char != '-' && op_char != '=' {
                return Err("invalid mode".to_string());
            }
            j += 1;

            let mut perms: u8 = 0;
            let mut is_copy = false;
            let mut copy_who: u8 = 0;

            if j < rb.len() {
                let c = rb[j];
                if c == b'u' || c == b'g' || c == b'o' {
                    is_copy = true;
                    match c {
                        b'u' => copy_who = WHO_U,
                        b'g' => copy_who = WHO_G,
                        b'o' => copy_who = WHO_O,
                        _ => {}
                    }
                    j += 1;
                } else if c == b'r' || c == b'w' || c == b'x' || c == b'X' || c == b's' || c == b't' {
                    while j < rb.len() {
                        match rb[j] {
                            b'r' => { perms |= PERM_R; j += 1; }
                            b'w' => { perms |= PERM_W; j += 1; }
                            b'x' | b'X' => { perms |= PERM_X; j += 1; }
                            b's' => { perms |= PERM_S; j += 1; }
                            b't' => { perms |= PERM_T; j += 1; }
                            _ => break,
                        }
                    }
                } else if c == b'+' || c == b'-' || c == b'=' {
                    // empty perm group (e.g. "u=") – perms stays 0
                } else {
                    return Err("invalid mode".to_string());
                }
            }

            ops.push(PermOp { who, op: op_char, perms, is_copy, copy_who });
        }
    }
    Ok(ops)
}

fn parse_mode_str(mode_str: &str, umask: u32) -> Result<u32, String> {
    if mode_str.is_empty() {
        return Err("invalid mode".to_string());
    }
    if is_numeric_mode(mode_str) {
        return parse_numeric(mode_str);
    }
    let ops = parse_symbolic(mode_str)?;
    Ok(evaluate_ops(&ops, umask))
}

fn evaluate_ops(ops: &[PermOp], umask: u32) -> u32 {
    let umask = umask & 0o777;

    let touches_ordinary = ops.iter().any(|op| {
        if op.is_copy { return true; }
        if op.perms == 0 { return true; }
        op.perms & (PERM_R | PERM_W | PERM_X) != 0
    });

    let mut mode: u32 = if touches_ordinary {
        0o777
    } else {
        0o777 & !umask & 0o777
    };

    for op in ops {
        mode = apply_op(mode, op, umask);
    }

    mode & 0o7777
}

fn apply_op(mode: u32, op: &PermOp, umask: u32) -> u32 {
    let umask = umask & 0o777;
    let who = if op.who == 0 { WHO_U | WHO_G | WHO_O } else { op.who };
    let who_omitted = op.who == 0;

    // Build the effective permission mask (full 12-bit mode bits)
    let mut perm_mask: u32 = 0;

    if op.is_copy {
        let src = match op.copy_who {
            WHO_U => (mode >> 6) & 0o7,
            WHO_G => (mode >> 3) & 0o7,
            WHO_O => mode & 0o7,
            _ => 0,
        };
        if who & WHO_U != 0 { perm_mask |= src << 6; }
        if who & WHO_G != 0 { perm_mask |= src << 3; }
        if who & WHO_O != 0 { perm_mask |= src; }
    } else {
        if op.perms & PERM_R != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o400; }
            if who & WHO_G != 0 { perm_mask |= 0o040; }
            if who & WHO_O != 0 { perm_mask |= 0o004; }
        }
        if op.perms & PERM_W != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o200; }
            if who & WHO_G != 0 { perm_mask |= 0o020; }
            if who & WHO_O != 0 { perm_mask |= 0o002; }
        }
        if op.perms & PERM_X != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o100; }
            if who & WHO_G != 0 { perm_mask |= 0o010; }
            if who & WHO_O != 0 { perm_mask |= 0o001; }
        }
        if op.perms & PERM_S != 0 {
            if who & WHO_U != 0 { perm_mask |= 0o4000; }
            if who & WHO_G != 0 { perm_mask |= 0o2000; }
        }
        if op.perms & PERM_T != 0 {
            if who & WHO_O != 0 { perm_mask |= 0o1000; }
        }
    }

    let ordinary_mask = perm_mask & 0o777;
    let special_mask = perm_mask & 0o7000;

    match op.op {
        '+' => {
            if who_omitted {
                mode |= ordinary_mask & !umask & 0o777;
                mode |= special_mask;
            } else {
                mode |= perm_mask;
            }
        }
        '-' => {
            if who_omitted {
                mode &= !(ordinary_mask & !umask & 0o777) & 0o7777;
                mode &= !special_mask & 0o7777;
            } else {
                mode &= !perm_mask & 0o7777;
            }
        }
        '=' => {
            // Clear the affected ordinary bits for the selected classes
            let class_mask: u32 = {
                let mut m = 0u32;
                if who & WHO_U != 0 { m |= 0o700; }
                if who & WHO_G != 0 { m |= 0o070; }
                if who & WHO_O != 0 { m |= 0o007; }
                m
            };

            let new_ordinary;
            if who_omitted {
                new_ordinary = ordinary_mask & !umask & 0o777;
            } else {
                new_ordinary = ordinary_mask & 0o777;
            }

            // Special bits per the GNU directory rules
            let new_special = equals_special(mode, op.perms, who);

            mode = (mode & !class_mask & 0o7777) & 0o0000; // zero out ordinary
            mode |= new_ordinary;
            mode |= new_special;
        }
        _ => {}
    }

    mode & 0o7777
}

fn equals_special(current_mode: u32, perms: u8, who: u8) -> u32 {
    let mut special = 0u32;

    // setuid (0o4000): set if perms has S and who has U; else preserved
    if who & WHO_U != 0 {
        if perms & PERM_S != 0 {
            special |= 0o4000;
        } else {
            special |= current_mode & 0o4000;
        }
    } else {
        special |= current_mode & 0o4000;
    }

    // setgid (0o2000): set if perms has S and who has G; else preserved
    if who & WHO_G != 0 {
        if perms & PERM_S != 0 {
            special |= 0o2000;
        } else {
            special |= current_mode & 0o2000;
        }
    } else {
        special |= current_mode & 0o2000;
    }

    // sticky (0o1000): if who has O → set if perms has T, else cleared; if who lacks O → preserved
    if who & WHO_O != 0 {
        if perms & PERM_T != 0 {
            special |= 0o1000;
        }
    } else {
        special |= current_mode & 0o1000;
    }

    special
}

// ─── directory creation with explicit mode ──────────────────────────────────

fn create_dir_with_mode(path: &std::ffi::OsStr, mode: Option<u32>) -> std::io::Result<()> {
    std::fs::create_dir(path)?;
    if let Some(m) = mode {
        let mut perms = std::fs::metadata(path)?.permissions();
        perms.set_mode(m);
        std::fs::set_permissions(path, perms)?;
    }
    Ok(())
}

// ─── -p creation with optional final mode ───────────────────────────────────

fn create_dir_with_parents(path: &std::ffi::OsStr, final_mode: Option<u32>) -> std::io::Result<()> {
    let bytes = path.as_bytes();
    let is_absolute = bytes.first() == Some(&b'/');

    let components: Vec<&[u8]> = bytes
        .split(|&b| b == b'/')
        .filter(|c| !c.is_empty() && c != b".")
        .collect();

    if components.is_empty() {
        return Ok(());
    }

    let mut current = std::ffi::OsString::new();

    for (i, comp) in components.iter().enumerate() {
        let is_last = i == components.len() - 1;
        let comp_os = std::ffi::OsStr::from_bytes(comp);

        if i == 0 {
            if is_absolute {
                current.push("/");
            }
            current.push(comp_os);
        } else {
            current.push("/");
            current.push(comp_os);
        }

        match std::fs::create_dir(&current) {
            Ok(()) => {
                if is_last {
                    // Final directory: apply explicit mode if given
                    if let Some(m) = final_mode {
                        let mut perms = std::fs::metadata(&current)?.permissions();
                        perms.set_mode(m);
                        std::fs::set_permissions(&current, perms)?;
                    }
                } else {
                    // Intermediate: ensure owner wx
                    ensure_owner_wx(&current);
                }
            }
            Err(e) => {
                if e.kind() == std::io::ErrorKind::AlreadyExists {
                    if is_last {
                        match std::fs::metadata(&current) {
                            Ok(md) if md.is_dir() => {}
                            _ => return Err(e),
                        }
                    }
                    // Intermediate EEXIST: accept (GNU behavior)
                } else {
                    return Err(e);
                }
            }
        }
    }

    Ok(())
}

// ─── main ───────────────────────────────────────────────────────────────────

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let mut operands: Vec<OsString> = Vec::new();
    let mut option_terminated = false;
    let mut parents = false;
    let mut mode_str: Option<String> = None;

    let mut i = 0usize;
    while i < args.len() {
        if !option_terminated {
            let arg = &args[i];
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                if bytes == b"--" {
                    option_terminated = true;
                    i += 1;
                    continue;
                }
                if bytes == b"-p" {
                    parents = true;
                    i += 1;
                    continue;
                }
                if bytes == b"--parents" {
                    parents = true;
                    i += 1;
                    continue;
                }
                // -m or -mXXX
                if bytes == b"-m" {
                    if i + 1 >= args.len() {
                        eprintln!("mkdir: option requires an argument -- 'm'");
                        std::process::exit(1);
                    }
                    mode_str = Some(args[i + 1].to_string_lossy().into_owned());
                    i += 2;
                    continue;
                }
                if bytes.len() > 2 && bytes[1] == b'm' && bytes[2] != b'-' {
                    // -mXXX form
                    let mode_part = std::str::from_utf8(&bytes[2..])
                        .unwrap_or("");
                    mode_str = Some(mode_part.to_string());
                    i += 1;
                    continue;
                }
                // --mode=