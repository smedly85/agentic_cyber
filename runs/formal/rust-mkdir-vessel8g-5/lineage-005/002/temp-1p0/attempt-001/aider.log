Let me think about this more concretely and write the actual code.

```rust
const PERM_R: u8 = 1;
const PERM_W: u8 = 2;
const PERM_X: u8 = 4;
const PERM_S: u8 = 8;
const PERM_T: u8 = 16;

const WHO_U: u8 = 1;
const WHO_G: u8 = 2;
const WHO_O: u8 = 4;
const WHO_A: u8 = 7;

struct PermOp {
    who: u8,
    op: char,
    perms: u8,
    is_copy: bool,
    copy_who: u8,
}

fn is_mode_numeric(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|b| (b'0'..=b'7').contains(&b))
}

fn parse_numeric(s: &str) -> Result<u32, String> {
    let v = u32::from_str_radix(s, 8).map_err(|_| "invalid mode".to_string())?;
    if v > 0o7777 {
        return Err("invalid mode".to_string());
    }
    Ok(v)
}

fn parse_symbolic(s: &str) -> Result<Vec<PermOp>, String> {
    let mut ops = Vec::new();
    for clause in s.split(',') {
        if clause.is_empty() {
            return Err("invalid mode".to_string());
        }
        // Parse who
        let mut i = 0;
        let bytes = s.as_bytes(); // wrong, should be clause.as_bytes()
        let cbytes = clause.as_bytes();
        while i < cbytes.len() && (cbytes[i] == b'u' || cbytes[i] == b'g' || cbytes[i] == b'o' || cbytes[i] == b'a') {
            i += 1;
        }
        let who_str = &clause[..i];
        let who = if who_str.is_empty() { 0 } else {
            let mut w: u8 = 0;
            for c in who_str.bytes() {
                match c {
                    b'u' => w |= WHO_U,
                    b'g' => w |= WHO_G,
                    b'o' => w |= WHO_O,
                    b'a' => w = WHO_A,
                    _ => {}
                }
            }
            w
        };
        
        // Parse ops
        let rest = &clause[i..];
        if rest.is_empty() {
            return Err("invalid mode".to_string());
        }
        
        let mut j = 0;
        while j < rest.len() {
            let op = rest.as_bytes()[j];
            if op != b'+' && op != b'-' && op != b'=' {
                return Err("invalid mode".to_string());
            }
            j += 1;
            
            // Parse perm group
            let mut perms: u8 = 0;
            let mut is_copy = false;
            let mut copy_who: u8 = 0;
            
            if j < rest.len() {
                let c = rest.as_bytes()[j];
                if c == b'u' || c == b'g' || c == b'o' {
                    // Could be a copy source or part of rwxXst
                    // u, g, o are NOT in rwxXst, so this must be a copy source
                    is_copy = true;
                    match c {
                        b'u' => copy_who = WHO_U,
                        b'g' => copy_who = WHO_G,
                        b'o' => copy_who = WHO_O,
                        _ => {}
                    }
                    j += 1;
                } else if c == b'r' || c == b'w' || c == b'x' || c == b'X' || c == b's' || c == b't' {
                    // Parse run of rwxXst characters
                    while j < rest.len() {
                        let c = rest.as_bytes()[j];
                        match c {
                            b'r' => { perms |= PERM_R; j += 1; }
                            b'w' => { perms |= PERM_W; j += 1; }
                            b'x' | b'X' => { perms |= PERM_X; j += 1; }
                            b's' => { perms |= PERM_S; j += 1; }
                            b't' => { perms |= PERM_T; j += 1; }
                            _ => break,
                        }
                    }
                } else if c == b'+' || c == b'-' || c == b'=' {
                    // Empty perm group (like `u=`)
                    // perms stays 0, is_copy stays false
                    // j stays the same (next char is the next operator)
                } else {
                    return Err("invalid mode".to_string());
                }
            }
            
            ops.push(PermOp { who, op, perms, is_copy, copy_who });
        }
    }
    Ok(ops)
}
```

