```rust
fn evaluate_ops(ops: &[PermOp], umask: u32) -> u32 {
    let umask = umask & 0o777; // only ordinary bits matter for umask
    
    // Determine if any op touches ordinary bits
    let touches_ordinary = ops.iter().any(|op| {
        op.perms & (PERM_R | PERM_W | PERM_X) != 0 
            || op.is_copy
            || op.perms == 0 // empty perms (like `u=`)
    });
    
    let mut mode: u32 = if touches_ordinary {
        0o777
    } else {
        (0o777 & !umask) & 0o777
    };
    
    for op in ops {
        mode = apply_op(mode, op, umask);
    }
    
    mode & 0o7777
}
```

