```rust
fn equals_special_bits(mode: u32, perms: u8, who: u8) -> u32 {
    let mut special = 0u32;
    
    // setuid (0o4000)
    if who & WHO_U != 0 {
        if perms & PERM_S != 0 {
            special |= 0o4000; // explicitly set
        } else {
            special |= mode & 0o4000; // preserved
        }
    }
    // If who doesn't include u, setuid is preserved
    if who & WHO_U == 0 {
        special |= mode & 0o4000;
    }
    
    // setgid (0o2000)
    if who & WHO_G != 0 {
        if perms & PERM_S != 0 {
            special |= 0o2000;
        } else {
            special |= mode & 0o2000;
        }
    }
    if who & WHO_G == 0 {
        special |= mode & 0o2000;
    }
    
    // sticky (0o1000)
    if who & WHO_O != 0 {
        if perms & PERM_T != 0 {
            special |= 0o1000; // explicitly set
        }
        // else: cleared (not preserved)
    }
    if who & WHO_O == 0 {
        special |= mode & 0o1000; // preserved
    }
    
    special
}
