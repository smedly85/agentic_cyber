**Function `build_path`** — joins the first `up_to` components into a path `OsString`, prefixed with `/` if absolute:

```rust
fn build_path(is_absolute: bool, components: &[OsString], up_to: usize) -> OsString {
    if is_absolute {
        if up_to == 0 {
            return OsString::from("/");
        }
        let mut result = OsString::from("/");
        for (i, comp) in components.iter().take(up_to).enumerate() {
            if i > 0 {
                result.push("/");
            }
            result.push(comp);
        }
        result
    } else {
        let mut result = OsString::new();
        for (i, comp) in components.iter().take(up_to).enumerate() {
            if i > 0 {
                result.push("/");
            }
            result.push(comp);
        }
        result
    }
}
```

