```rust
fn create_with_parents(path: &OsString) -> Result<(), String> {
    let (is_absolute, components) = normalize_path(path);
    
    if components.is_empty() {
        // Path is "." or "/" - already exists as a directory (or is the sandbox root)
        return Ok(());
    }
    
    for i in 0..components.len() {
        let next = build_path(is_absolute, &components, i + 1);
        let is_final = (i + 1 == components.len());
        
        match fs::metadata(&next) {
            Ok(meta) => {
                if !meta.is_dir() {
                    return Err(format!(
                        "mkdir: cannot create directory '{}': Not a directory",
                        path_lossy(path)
                    ));
                }
            }
            Err(ref e) if e.kind() == std::io::ErrorKind::NotFound => {
                fs::create_dir(&next).map_err(|e| {
                    let errno = e.raw_os_error().unwrap_or(-1);
                    format!(
                        "mkdir: cannot create directory '{}': {}",
                        path_lossy(path),
                        errno_to_str(errno)
                    )
                })?;
                if !is_final {
                    // Ensure owner has write + search permission
                    if let Ok(meta) = fs::metadata(&next) {
                        let mode = meta.mode() | 0o300;
                        let _ = fs::chmod(&next, mode);
                    }
                }
            }
            Err(e) => {
                let errno = e.raw_os_error().unwrap_or(-1);
                return Err(format!(
                    "mkdir: cannot create directory '{}': {}",
                    path_lossy(path),
                    errno_to_str(errno)
                ));
            }
        }
    }
    Ok(())
}
```

