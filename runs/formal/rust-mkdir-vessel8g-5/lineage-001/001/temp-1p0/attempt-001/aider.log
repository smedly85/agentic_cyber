fn normalize_path(path: &OsString) -> (bool, Vec<OsString>) {
    let bytes = path.as_encoded_bytes();
    let is_absolute = bytes.starts_with(b"/");
    let mut components: Vec<OsString> = Vec::new();
    let mut current: Vec<u8> = Vec::new();

