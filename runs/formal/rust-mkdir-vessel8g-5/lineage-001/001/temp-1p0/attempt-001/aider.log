```rust
use std::os::unix::ffi::{OsStrExt, OsStringExt};

fn normalize_path(path: &OsString) -> (bool, Vec<OsString>) {
    let bytes = path.as_bytes(); // From OsStrExt
    let is_absolute = bytes.starts_with(b"/");
    let mut components: Vec<Vec<u8>> = Vec::new();
    let mut current: Vec<u8> = Vec::new();
    
    for &b in bytes {
        if b == b'/' {
            let c = &current;
            if !c.is_empty() && c != b"." {
                if c == b".." {
                    components.pop();
                } else {
                    components.push(c.clone());
                }
            }
            current.clear();
        } else {
            current.push(b);
        }
    }
    // Handle last component
    if !current.is_empty() && current != b"." {
        if current == b".." {
            components.pop();
        } else {
            components.push(current);
        }
    }
    
    let comps: Vec<OsString> = components.into_iter().map(|v| OsString::from_vec(v)).collect();
    (is_absolute, comps)
}
```

