```
fn create_parents(path: &OsString) -> Result<(), Error> {
    // Normalize the path into components
    let components = normalize_path(path);
    
    // If absolute, start from root
    let is_absolute = path starts with '/';
    let mut current = if is_absolute { OsString::from("/") } else { OsString::new() };
    
    for (i, component) in components.iter().enumerate() {
        let next = if current == OsString::from("/") {
            OsString::from("/") + component  // e.g., "/foo"
        } else if current.is_empty() {
            component.clone()  // e.g., "foo"
        } else {
            current + "/" + component  // e.g., "foo/bar"
        };
        
        // Check if next exists
        match fs::symlink_metadata(&next) {
            Ok(meta) => {
                if meta.is_dir() || (meta.file_type().is_symlink() && fs::metadata(&next).map(|m| m.is_dir()).unwrap_or(false)) {
                    // Exists as dir or symlink-to-dir: OK for -p
                    current = next;
                    continue;
                } else {
                    // Exists as non-directory: error
                    return Err(...);
                }
            }
            Err(e) if e.kind() == io::ErrorKind::NotFound => {
                // Doesn't exist: create it
                fs::create_dir(&next)?;
                if i < components.len() - 1 {
                    // Intermediate: ensure owner wx
                    let mode = fs::metadata(&next)?.mode() | 0o300;
                    fs::chmod(&next, mode)?;
                }
                current = next;
            }
            Err(e) => return Err(e),
        }
    }
    Ok(())
}
```

