```rust
fn create_with_parents(path: &OsString) -> io::Result<()> {
    let (is_absolute, components) = normalize_path(path);
    
    // If no components, the path is "." (current dir) which is always a directory
    // For -p, this should succeed
    if components.is_empty() {
        // Check that the current directory is a directory (it should be)
        let _ = fs::metadata(".")?;
        return Ok(());
    }
    
    for i in 0..components.len() {
        let next = build_path(is_absolute, &components, i + 1);
        let is_final = (i + 1 == components.len());
        
        match fs::metadata(&next) {
            Ok(meta) => {
                if meta.is_dir() {
                    continue; // Exists as directory (or symlink to dir): OK
                } else {
                    // Exists as non-directory: error
                    return Err(io::Error::new(
                        io::ErrorKind::NotADirectory,
                        format!("mkdir: cannot create directory '{}': Not a directory", 
                                display_path(path))
                    ));
                }
            }
            Err(ref e) if e.kind() == io::ErrorKind::NotFound => {
                fs::create_dir(&next)?;
                if !is_final {
                    // Intermediate: ensure owner has write+search
                    let meta = fs::metadata(&next)?;
                    use std::os::unix::fs::MetadataExt;
                    let mode = meta.mode() | 0o300;
                    fs::chmod(&next, mode)?;
                }
            }
            Err(e) => return Err(e),
        }
    }
    Ok(())
}
```

