```rust
fn apply_symbolic_clause(mode: &mut u32, clause: &str, umask: u32) -> Option<bool> {
    // Parse: find operator
    let op_idx = clause.find(|c| c == '+' || c == '-' || c == '=')?;
    let who_str = &clause[..op_idx];
    let op = clause.as_bytes()[op_idx] as char;
    let perm_str = &clause[op_idx + 1..];
    
    // Parse who
    let who: u8;
    if who_str.is_empty() {
        who = 0; // omitted
    } else {
        who = 0;
        for c in who_str.chars() {
            match c {
                'u' => who |= 1,
                'g' => who |= 2,
                'o' => who |= 4,
                'a' => who |= 7,
                _ => return None,
            }
        }
    }
    
    // Determine effective who (for class selection)
    let eff_who: u8;
    if who == 0 {
        eff_who = 7; // all classes
    } else {
        eff_who = who;
    }
    
    // Parse permissions
    let mut r_mentioned: u8 = 0; // per-class rwx bits mentioned
    // Actually, let me track which rwx bits are in the perm string
    let mut perm_r = false;
    let mut perm_w = false;
    let mut perm_x = false;
    let mut perm_s = false;
    let mut perm_t = false;
    let mut copy_u = false;
    let mut copy_g = false;
    let mut copy_o = false;
    
    for c in perm_str.chars() {
        match c {
            'r' => perm_r = true,
            'w' => perm_w = true,
            'x' | 'X' => perm_x = true,
            's' => perm_s = true,
            't' => perm_t = true,
            'u' => copy_u = true,
            'g' => copy_g = true,
            'o' => copy_o = true,
            _ => return None,
        }
    }
    
    // If no permissions and op is not '=', that's invalid
    if !perm_r && !perm_w && !perm_x && !perm_s && !perm_t && !copy_u && !copy_g && !copy_o {
        if op != '=' {
            return None;
        }
    }
    
    // Compute the rwx bits to apply (per class)
    let mut u_bits: u8 = 0;
    let mut g_bits: u8 = 0;
    let mut o_bits: u8 = 0;
    if perm_r { u_bits |= 4; g_bits |= 4; o_bits |= 4; }
    if perm_w { u_bits |= 2; g_bits |= 2; o_bits |= 2; }
    if perm_x { u_bits |= 1; g_bits |= 1; o_bits |= 1; }
    
    // Handle copy
    if copy_u || copy_g || copy_o {
        // For copy, the source's current rwx bits are copied to the target classes
        // We need to do this based on the current mode
        let src_u = (mode >> 6) & 7;
        let src_g = (mode >> 3) & 7;
        let src_o = mode & 7;
        
        if copy_u {
            // Copy u's bits to affected classes
            if eff_who & 1 != 0 { u_bits = src_u; }
            if eff_who & 2 != 0 { g_bits = src_u; }
            if eff_who & 4 != 0 { o_bits = src_u; }
        }
        if copy_g {
            if eff_who & 1 != 0 { u_bits = src_g; }
            if eff_who & 2 != 0 { g_bits = src_g; }
            if eff_who & 4 != 0 { o_bits = src_g; }
        }
        if copy_o {
            if eff_who & 1 != 0 { u_bits = src_o; }
            if eff_who & 2 != 0 { g_bits = src_o; }
            if eff_who & 4 != 0 { o_bits = src_o; }
        }
    }
    
    // Apply umask if who is omitted
    let (final_u, final_g, final_o);
    if who == 0 {
        let umask_u = (umask >> 6) & 7;
        let umask_g = (umask >> 3) & 7;
        let umask_o = umask & 7;
        match op {
            '+' => {
                final_u = u_bits & !umask_u;
                final_g = g_bits & !umask_g;
                final_o = o_bits & !umask_o;
            }
            '-' => {
                final_u = u_bits & !umask_u;
                final_g = g_bits & !umask_g;
                final_o = o_bits & !umask_o;
            }
            '=' => {
                final_u = u_bits & !umask_u;
                final_g = g_bits & !umask_g;
                final_o = o_bits & !umask_o;
            }
            _ => unreachable!(),
        }
    } else {
        final_u = u_bits;
        final_g = g_bits;
        final_o = o_bits;
    }
    
    // Apply to mode
    match op {
        '+' => {
            if eff_who & 1 != 0 { *mode |= final_u << 6; }
            if eff_who & 2 != 0 { *mode |= final_g << 3; }
            if eff_who & 4 != 0 { *mode |= final_o; }
            if perm_s {
                if eff_who & 1 != 0 { *mode |= 0o4000; }
                if eff_who & 2 != 0 { *mode |= 0o2000; }
            }
            if perm_t {
                if eff_who & 4 != 0 { *mode |= 0o1000; }
            }
        }
        '-' => {
            if eff_who & 1 != 0 { *mode &= !(final_u as u32) << 6; }
            if eff_who & 2 != 0 { *mode &= !(final_g as u32) << 3; }
            if eff_who & 4 != 0 { *mode &= !(final_o as u32); }
            if perm_s {
                if eff_who & 1 != 0 { *mode &= !0o4000; }
                if eff_who & 2 != 0 { *mode &= !0o2000; }
            }
            if perm_t {
                if eff_who & 4 != 0 { *mode &= !0o1000; }
            }
        }
        '=' => {
            // Replace rwx bits for affected classes
            if eff_who & 1 != 0 {
                *mode = (*mode & !(7u32 << 6)) | ((final_u as u32) << 6);
            }
            if eff_who & 2 != 0 {
                *mode = (*mode & !(7u32 << 3)) | ((final_g as u32) << 3);
            }
            if eff_who & 4 != 0 {
                *mode = (*mode & !7u32) | (final_o as u32);
            }
            // Special bits: set if mentioned, preserve if not
            if eff_who & 1 != 0 {
                *mode = if perm_s { *mode | 0o4000 } else { *mode & 0o4000 };
                // Wait, "preserve unless explicitly addressed" means:
                // if s is mentioned → set; if not mentioned → preserve
                // So: if perm_s → set; else → keep current
                // That's what I have: if perm_s, OR in 0o4000; else, keep
                // But my code above sets it to 0o4000 or keeps it... let me fix
            }
            // ...
        }
        _ => unreachable!(),
    }
    
    Some(true)
}
```

