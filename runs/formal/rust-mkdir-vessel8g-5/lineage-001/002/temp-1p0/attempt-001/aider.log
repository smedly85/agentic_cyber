The op is a single character: +, -, or =

So I need to find the op character, then split into who (before) and perms (after).

```rust
fn parse_clause(clause: &str) -> Option<(u8, char, &str)> {
    // Find the operator
    let op_pos = clause.find(|c| c == '+' || c == '-' || c == '=')?;
    let who_str = &clause[..op_pos];
    let op = clause.as_bytes()[op_pos] as char;
    let perm_str = &clause[op_pos+1..];
    
    // Validate who
    let who = parse_who(who_str)?;
    
    // Validate perms (can be empty for empty assignment with =)
    if op != '=' && perm_str.is_empty() { return None; }
    // Actually, empty perms with + or - is also invalid in GNU
    // Let's allow empty only for =
    
    Some((who, op, perm_str))
}

fn parse_who(who_str: &str) -> Option<u8> {
    if who_str.is_empty() { return Some(0); } // omitted
    let mut who: u8 = 0;
    for c in who_str.chars() {
        match c {
            'u' => who |= 1,
            'g' => who |= 2,
            'o' => who |= 4,
            'a' => who |= 7,
            _ => return None,
        }
    }
    Some(who)
}
```

