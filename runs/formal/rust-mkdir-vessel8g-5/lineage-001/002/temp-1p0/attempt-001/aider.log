fn parse_symbolic(spec: &str, umask: u32) -> Option<u32> {
    let mut mode: u32 = 0o755; // starting point: a=rwx
    
    for clause in spec.split(',') {
        if clause.is_empty() {
            return None;
        }
        if !apply_symbolic_clause(&mut mode, clause, umask)? {
            return None;
        }
    }
    
    Some(mode & 0o7777)
}
```

