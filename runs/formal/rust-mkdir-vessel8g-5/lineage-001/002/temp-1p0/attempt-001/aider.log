use std::env;
use std::ffi::OsString;
use std::fs;
use std::io::Write;
use std::process;
use std::os::unix::ffi::OsStringExt;
use std::os::unix::fs::MetadataExt;
use std::os::unix::fs::PermissionsExt;

// ... existing errno_to_str, normalize_path, build_path ...

fn get_umask() -> u32 {
    let dir = std::env::temp_dir();
    let path = dir.join(format!(".umask_probe_{}", std::process::id()));
    let _ = std::fs::remove_file(&path);
    if std::fs::File::create(&path).is_ok() {
        if let Ok(meta) = std::fs::metadata(&path) {
            let mode = meta.permissions().mode() & 0o777;
            let _ = std::fs::remove_file(&path);
            return 0o666 & !mode;
        }
    }
    let _ = std::fs::remove_file(&path);
    0o022
}

fn parse_numeric_mode(s: &str) -> Option<u32> {
    if s.is_empty() { return None; }
    for c in s.chars() {
        if !c.is_ascii_digit() || c > '7' { return None; }
    }
    // Strip leading zeros to determine significant digits
    let val: u32 = u32::from_str_radix(s, 8).ok()?;
    if val > 0o77777 { return None; }
    Some(val)
}

fn parse_symbolic_mode(s: &str, umask: u32) -> Option<u32> {
    if s.is_empty() { return None; }
    
    let mut mode: u32 = 0o755; // a=rwx starting point for directories
    
    for clause in s.split(',') {
        if clause.is_empty() { return None; }
        
        let (who, op, perm_str) = parse_clause(clause)?;
        apply_clause(&mut mode, who, op, perm_str, umask)?;
    }
    
    Some(mode & 0o7777)
}
```

