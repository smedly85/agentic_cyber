fn parse_mode_spec(spec: &str, umask: u32) -> Option<u32> {
    if spec.is_empty() {
        return None;
    }
    
    // Try numeric
    if spec.bytes().all(|b| b.is_ascii_digit() && b <= b'7') {
        let val = u32::from_str_radix(spec, 8).ok()?;
        if val > 0o77777 {
            return None;
        }
        // 1-4 significant digits: preserve set-ID bits (they're 0 for new dirs anyway)
        // 5+ digits: explicit special bits
        // For our purposes (new dirs), both just use the value as-is
        // But the spec says "preserve unspecified directory set-ID bits" for <=4 digits
        // Since we start from 0755 (no special bits), there's nothing to preserve
        // So the result is just val & 0o7777
        return Some(val & 0o7777);
    }
    
    // Symbolic mode
    parse_symbolic(spec, umask)
}
```

