rust_mkdir.rs
```
use std::env;
use std::ffi::OsString;
use std::fs;
use std::io::Write;
use std::process;
use std::os::unix::ffi::OsStringExt;
use std::os::unix::fs::MetadataExt;
use std::os::unix::fs::PermissionsExt;

fn errno_to_str(errno: i32) -> &'static str {
    match errno {
        2 => "No such file or directory",
        13 => "Permission denied",
        17 => "File exists",
        20 => "Not a directory",
        30 => "Read-only file system",
        36 => "File name too long",
        40 => "Too many levels of symbolic links",
        _ => "Unknown error",
    }
}

fn normalize_path(path: &OsString) -> (bool, Vec<OsString>) {
    let bytes = path.as_encoded_bytes();
    let is_absolute = bytes.starts_with(b"/");
    let mut components: Vec<OsString> = Vec::new();
    let mut current: Vec<u8> = Vec::new();

    for &b in bytes {
        if b == b'/' {
            if !current.is_empty() {
                if current != b"." {
                    if current == b".." {
                        components.pop();
                    } else {
                        components.push(OsString::from_vec(current.clone()));
                    }
                }
            }
            current.clear();
        } else {
            current.push(b);
        }
    }
    if !current.is_empty() && current != b"." {
        if current == b".." {
            components.pop();
        } else {
            components.push(OsString::from_vec(current));
        }
    }
    (is_absolute, components)
}

fn build_path(is_absolute: bool, components: &[OsString], up_to: usize) -> OsString {
    if is_absolute {
        if up_to == 0 {
            return OsString::from("/");
        }
        let mut result = OsString::from("/");
        for (i, comp) in components.iter().take(up_to).enumerate() {
            if i > 0 {
                result.push("/");
            }
            result.push(comp);
        }
        result
    } else {
        let mut result = OsString::new();
        for (i, comp) in components.iter().take(up_to).enumerate() {
            if i > 0 {
                result.push("/");
            }
            result.push(comp);
        }
        result
    }
}

fn get_umask() -> u32 {
    let dir = std::env::temp_dir();
    let path = dir.join(format!(".umask_probe_{}", std::process::id()));
    let _ = std::fs::remove_file(&path);
    if std::fs::File::create(&path).is_ok() {
        if let Ok(meta) = std::fs::metadata(&path) {
            let mode = meta.permissions().mode() & 0o777;
            let _ = std::fs::remove_file(&path);
            return 0o666 & !mode;
        }
    }
    let _ = std::fs::remove_file(&path);
    0o022
}

fn parse_numeric_mode(s: &str) -> Option<u32> {
    if s.is_empty() {
        return None;
    }
    for c in s.bytes() {
        if c < b'0' || c > b'7' {
            return None;
        }
    }
    let val = u32::from_str_radix(s, 8).ok()?;
    if val > 0o7777 {
        return None;
    }
    Some(val & 0o7777)
}

fn parse_symbolic_mode(s: &str, umask: u32) -> Option<u32> {
    if s.is_empty() {
        return None;
    }
    let mut mode: u32 = 0o777;
    for clause in s.split(',') {
        if clause.is_empty() {
            return None;
        }
        apply_symbolic_clause(&mut mode, clause, umask)?;
    }
    Some(mode & 0o7777)
}

fn apply_symbolic_clause(mode: &mut u32, clause: &str, umask: u32) -> Option<()> {
    let op_idx = clause
        .find(|c| c == '+' || c == '-' || c == '=')?;
    let who_str = &clause[..op_idx];
    let op = clause.as_bytes()[op_idx];
    let perm_str = &clause[op_idx + 1..];

    // Parse who
    let who: u8;
    if who_str.is_empty() {
        who = 0;
    } else {
        let mut w: u8 = 0;
        for c in who_str.bytes() {
            match c {
                b'u' => w |= 1,
                b'g' => w |= 2,
                b'o' => w |= 4,
                b'a' => w |= 7,
                _ => return None,
            }
        }
        who = w;
    }

    let eff_who: u8 = if who == 0 { 7 } else { who };

    // Parse permissions
    let mut has_r = false;
    let mut has_w = false;
    let mut has_x = false;
    let mut has_s = false;
    let mut has_t = false;
    let mut copy_u = false;
    let mut copy_g = false;
    let mut copy_o = false;

    for c in perm_str.bytes() {
        match c {
            b'r' => has_r = true,
            b'w' => has_w = true,
            b'x' | b'X' => has_x = true,
            b's' => has_s = true,
            b't' => has_t = true,
            b'u' => copy_u = true,
            b'g' => copy_g = true,
            b'o' => copy_o = true,
            _ => return None,
        }
    }

    let any_perm = has_r || has_w || has_x || has_s || has_t || copy_u || copy_g || copy_o;
    if !any_perm && op != b'=' {
        return None;
    }

    // Compute requested rwx bits per class
    let mut req_u: u8 = 0;
    let mut req_g: u8 = 0;
    let mut req_o: u8 = 0;
    if has_r { req_u |= 4; req_g |= 4; req_o |= 4; }
    if has_w { req_u |= 2; req_g |= 2; req_o |= 2; }
    if has_x { req_u |= 1; req_g |= 1; req_o |= 1; }

    // Handle permission copy (overrides explicit rwx for affected classes)
    if copy_u || copy_g || copy_o {
        let src_u = ((*mode >> 6) & 7) as u8;
        let src_g = ((*mode >> 3) & 7) as u8;
        let src_o = (*mode & 7) as u8;
        if copy_u {
            if eff_who & 1 != 0 { req_u = src_u; }
            if eff_who & 2 != 0 { req_g = src_u; }
            if eff_who & 4 != 0 { req_o = src_u; }
        }
        if copy_g {
            if eff_who & 1 != 0 { req_u = src_g; }
            if eff_who & 2 != 0 { req_g = src_g; }
            if eff_who & 4 != 0 { req_o = src_g; }
        }
        if copy_o {
            if eff_who & 1 != 0 { req_u = src_o; }
            if eff_who & 2 != 0 { req_g = src_o; }
            if eff_who & 4 != 0 { req_o = src_o; }
        }
    }

    // Apply umask filtering for omitted who (ordinary bits only)
    let (fu, fg, fo): (u8, u8, u8);
    if who == 0 {
        let um_u = ((umask >> 6) & 7) as u8;
        let um_g = ((umask >> 3) & 7) as u8;
        let um_o = (umask & 7) as u8;
        fu = req_u & !um_u;
        fg = req_g & !um_g;
        fo = req_o & !um_o;
    } else {
        fu = req_u;
        fg = req_g;
        fo = req_o;
    }

    // Apply operation
    match op {
        b'+' => {
            if eff_who & 1 != 0 { *mode |= (fu as u32) << 6; }
            if eff_who & 2 != 0 { *mode |= (fg as u32) << 3; }
            if eff_who & 4 != 0 { *mode |= fo as u32; }
            if has_s {
                if eff_who & 1 != 0 { *mode |= 0o4000; }
                if eff_who & 2 != 0 { *mode |= 0o2000; }
            }
            if has_t {
                if eff_who & 4 != 0 { *mode |= 0o1000; }
            }
        }
        b'-' => {
            if eff_who & 1 != 0 { *mode &= !((fu as u32) << 6); }
            if eff_who & 2 != 0 { *mode &= !((fg as u32) << 3); }
            if eff_who & 4 != 0 { *mode &= !(fo as u32); }
            if has_s {
                if eff_who & 1 != 0 { *mode &= !0o4000u32; }
                if eff_who & 2 != 0 { *mode &= !0o2000u32; }
            }
            if has_t {
                if eff_who & 4 != 0 { *mode &= !0o1000u32; }
            }
        }
        b'=' => {
            if eff_who & 1 != 0 {
                *mode = (*mode & !(7u32 << 6)) | ((fu as u32) << 6);
            }
            if eff_who & 2 != 0 {
                *mode = (*mode & !(7u32 << 3)) | ((fg as u32) << 3);
            }
            if eff_who & 4 != 0 {
                *mode = (*mode & !7u32) | (fo as u32);
            }
            // Special bits: setuid/setgid preserved unless s explicitly addressed;
            // sticky cleared unless t explicitly addressed
            if eff_who & 1 != 0 {
                if has_s { *mode |= 0o4000; }
                // else: preserve (do nothing)
            }
            if eff_who & 2 != 0 {
                if has_s { *mode |= 0o2000; }
                // else: preserve
            }
            if eff_who & 4 != 0 {
                if has_t {
                    *mode |= 0o1000;
                } else {
                    *mode &= !0o1000u32;
                }
            }
        }
        _ => return None,
    }

    Some(())
}

fn parse_mode_spec(spec: &str, umask: u32) -> Option<u32> {
    if spec.is_empty() {
        return None;
    }
    // Numeric: all chars are 0-7
    if spec.bytes().all(|b| b >= b'0' && b <= b'7') {
        return parse_numeric_mode(spec);
    }
    parse_symbolic_mode(spec, umask)
}

fn die_invalid_mode(mode_str: &str) -> ! {
    let mut err = std::io::stderr();
    let _ = writeln!(err, "mkdir: invalid mode '{}'", mode_str);
    process::exit(1);
}

fn create_with_parents(op: &OsString, explicit_mode: Option<u32>) -> bool {
    let (is_absolute, components) = normalize_path(op);

    if components.is_empty() {
        return true;
    }

    for i in 0..components.len() {
        let next = build_path(is_absolute, &components, i + 1);
        let is_final = i + 1 == components.len();

        match fs::metadata(&next) {
            Ok(meta) => {
                if !meta.is_dir() {
                    let mut err = std::io::stderr().lock();
                    let _ = write!(err, "mkdir: cannot create directory '");
                    let _ = err.write_all(op.as_encoded_bytes());
                    let _ = writeln!(err, "': Not a directory");
                    return false;
                }
            }
            Err(ref e) if e.kind() == std::io::ErrorKind::NotFound => {
                if let Err(e) = fs::create_dir(&next) {
                    let errno = e.raw_os_error().unwrap_or(-1);
                    let msg = errno_to_str(errno);
                    let mut err = std::io::stderr().lock();
                    let _ = write!(err, "mkdir: cannot create directory '");
                    let _ = err.write_all(op.as_encoded_bytes());
                    let _ = writeln!(err, "': {}", msg);
                    return false;
                }
                if is_final {
                    if let Some(mode) = explicit_mode {
                        let _ = fs::set_permissions(&next, fs::Permissions::from_mode(mode));
                    }
                } else {
                    if let Ok(meta) = fs::metadata(&next) {
                        let mode = meta.mode() | 0o300;
                        let _ = fs::set_permissions(&next, fs::Permissions::from_mode(mode));
                    }
                }
            }
            Err(e) => {
                let errno = e.raw_os_error().unwrap_or(-1);
                let msg = errno_to_str(errno);
                let mut err = std::io::stderr().lock();
                let _ = write!(err, "mkdir: cannot create directory '");
                let _ = err.write_all(op.as_encoded_bytes());
                let _ = writeln!(err, "': {}", msg);
                return false;
            }
        }
    }
    true
}

fn die_invalid_option(arg: &OsString) -> ! {
    let bytes = arg.as_encoded_bytes();
    let mut err = std::io::stderr();
    if bytes.len() > 2 && bytes.starts_with(b"--") {
        let _ = write!(err, "mkdir: unrecognized option '");
        let _ = err.write_all(bytes);
        let _ = writeln!(err, "'");
    } else {
        let c = bytes.get(1).copied().unwrap_or(b'?') as char;
        let _ = writeln!(err, "mkdir: invalid option -- '{}'", c);
    }
    let _ = writeln!(err, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn die_missing_operand() -> ! {
    let mut err = std::io::stderr();
    let _ = writeln!(err, "mkdir: missing operand");
    let _ = writeln!(err, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    let mut parents = false;
    let mut mode_value: Option<OsString> = None;

    let mut i = 0;
    while i < args.len() {
        let arg = &args[i];
        let b = arg.as_encoded_bytes();

        if after_ddash {
            operands.push(arg.clone());
            i += 1;
            continue;
        }

        if b == b"--" {
            after_ddash = true;
            i += 1;
            continue;
        }

        if b == b"-p" || b == b"--parents" {
            parents = true;
            i += 1;
            continue;
        }

        if b == b"-m" {
            i += 1;
            if i >= args.len() {
                die_invalid_mode("");
            }
            let v = args[i].as_encoded_bytes();
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(args[i].clone());
            i += 1;
            continue;
        }

        if b.starts_with(b"-m") && b.len() > 2 {
            let v = &b[2..];
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(OsString::from_vec(v.to_vec()));
            i += 1;
            continue;
        }

        if b == b"--mode" {
            i += 1;
            if i >= args.len() {
                die_invalid_mode("");
            }
            let v = args[i].as_encoded_bytes();
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(args[i].clone());
            i += 1;
            continue;
        }

        if b.starts_with(b"--mode=") {
            let v = &b[7..];
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(OsString::from_vec(v.to_vec()));
            i += 1;
            continue;
        }

        if b.len() > 1 && b[0] == b'-' {
            die_invalid_option(arg);
        }

        operands.push(arg.clone());
        i += 1;
    }

    if operands.is_empty() {
        die_missing_operand();
    }

    // Validate mode before any filesystem mutation
    let explicit_mode: Option<u32> = mode_value.as_ref().map(|mv| {
        let s = String::from_utf8_lossy(mv.as_encoded_bytes());
        let umask = get_umask();
        match parse_mode_spec(&s, umask) {
            Some(m) => m,
            None => die_invalid_mode(&s),
        }
    });

    let mut all_ok = true;

    for op in &operands {
        if parents {
            if !create_with_parents(op, explicit_mode) {
                all_ok = false;
            }
        } else {
            if let Err(e) = fs::create_dir(op) {
                all_ok = false;
                let errno = e.raw_os_error().unwrap_or(-1);
                let msg = errno_to_str(errno);
                let path = op.as_encoded_bytes();
                let mut err = std::io::stderr().lock();
                let _ = write!(err, "mkdir: cannot create directory '");
                let _ = err.write_all(path);
                let _ = writeln!(err, "': {}", msg);
            } else if let Some(mode) = explicit_mode {
                let _ = fs::set_permissions(op, fs::Permissions::from_mode(mode));
            }
        }
    }

    process::exit(if all_ok { 0 } else { 1 });
}
