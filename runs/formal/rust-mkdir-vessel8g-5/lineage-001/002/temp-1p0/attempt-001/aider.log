            if eff_who & 2 != 0 { req_g = src_u; }
            if eff_who & 4 != 0 { req_o = src_u; }
        }
        if copy_g {
            if eff_who & 1 != 0 { req_u = src_g; }
            if eff_who & 2 != 0 { req_g = src_g; }
            if eff_who & 4 != 0 { req_o = src_g; }
