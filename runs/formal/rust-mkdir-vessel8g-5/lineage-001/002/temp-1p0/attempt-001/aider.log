    }

    for i in 0..components.len() {
        let next = build_path(is_absolute, &components, i + 1);
        let is_final = i + 1 == components.len();

        match fs::metadata(&next) {
            Ok(meta) => {
                if !meta.is_dir() {
                    let mut err = std::io::stderr().lock();
                    let _ = write!(err, "mkdir: cannot create directory '");
                    let _ = err.write_all(op.as_encoded_bytes());
                    let _ = writeln!(err, "': Not a directory");
                    return false;
                }
            }
            Err(ref e) if e.kind() == std::io::ErrorKind::NotFound => {
                if let Err(e) = fs::create_dir(&next) {
                    let errno = e.raw_os_error().unwrap_or(-1);
                    let msg = errno_to_str(errno);
                    let mut err = std::io::stderr().lock();
                    let _ = write!(err, "mkdir: cannot create directory '");
                    let _ = err.write_all(op.as_encoded_bytes());
                    let _ = writeln!(err, "': {}", msg);
                    return false;
                }
                if is_final {
                    if let Some(mode) = explicit_mode {
                        let _ = fs::set_permissions(&next, fs::Permissions::from_mode(mode));
                    }
                } else {
                    if let Ok(meta) = fs::metadata(&next) {
                        let mode = meta.mode() | 0o300;
                        let _ = fs::set_permissions(&next, fs::Permissions::from_mode(mode));
                    }
                }
            }
            Err(e) => {
                let errno = e.raw_os_error().unwrap_or(-1);
                let msg = errno_to_str(errno);
                let mut err = std::io::stderr().lock();
                let _ = write!(err, "mkdir: cannot create directory '");
                let _ = err.write_all(op.as_encoded_bytes());
                let _ = writeln!(err, "': {}", msg);
                return false;
            }
        }
    }
    true
}

fn die_invalid_option(arg: &OsString) -> ! {
    let bytes = arg.as_encoded_bytes();
    let mut err = std::io::stderr();
    if bytes.len() > 2 && bytes.starts_with(b"--") {
        let _ = write!(err, "mkdir: unrecognized option '");
        let _ = err.write_all(bytes);
        let _ = writeln!(err, "'");
    } else {
        let c = bytes.get(1).copied().unwrap_or(b'?') as char;
        let _ = writeln!(err, "mkdir: invalid option -- '{}'", c);
    }
    let _ = writeln!(err, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn die_missing_operand() -> ! {
    let mut err = std::io::stderr();
    let _ = writeln!(err, "mkdir: missing operand");
    let _ = writeln!(err, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    let mut parents = false;
    let mut mode_value: Option<OsString> = None;

    let mut i = 0;
    while i < args.len() {
        let arg = &args[i];
        let b = arg.as_encoded_bytes();

        if after_ddash {
            operands.push(arg.clone());
            i += 1;
            continue;
        }

        if b == b"--" {
            after_ddash = true;
            i += 1;
            continue;
        }

        if b == b"-p" || b == b"--parents" {
            parents = true;
            i += 1;
            continue;
        }

        if b == b"-m" {
            i += 1;
            if i >= args.len() {
                die_invalid_mode("");
            }
            let v = args[i].as_encoded_bytes();
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(args[i].clone());
            i += 1;
            continue;
        }

        if b.starts_with(b"-m") && b.len() > 2 {
            let v = &b[2..];
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(OsString::from_vec(v.to_vec()));
            i += 1;
            continue;
        }

        if b == b"--mode" {
            i += 1;
            if i >= args.len() {
                die_invalid_mode("");
            }
            let v = args[i].as_encoded_bytes();
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(args[i].clone());
            i += 1;
            continue;
        }

        if b.starts_with(b"--mode=") {
            let v = &b[7..];
            if v.is_empty() {
                die_invalid_mode("");
            }
            mode_value = Some(OsString::from_vec(v.to_vec()));
            i += 1;
            continue;
        }

        if b.len() > 1 && b[0] == b'-' {
            die_invalid_option(arg);
        }

        operands.push(arg.clone());
        i += 1;
    }

    if operands.is_empty() {
        die_missing_operand();
    }

    // Validate mode before any filesystem mutation
    let explicit_mode: Option<u32> = mode_value.as_ref().map(|mv| {
        let s = String::from_utf8_lossy(mv.as_encoded_bytes());
        let umask = get_umask();
        match parse_mode_spec(&s, umask) {
            Some(m) => m,
            None => die_invalid_mode(&s),
        }
    });

    let mut all_ok = true;

    for op in &operands {
        if parents {
            if !create_with_parents(op, explicit_mode) {
                all_ok = false;
            }
        } else {
            if let Err(e) = fs::create_dir(op) {
                all_ok = false;
                let errno = e.raw_os_error().unwrap_or(-1);
                let msg = errno_to_str(errno);
                let path = op.as_encoded_bytes();
                let mut err = std::io::stderr().lock();
                let _ = write!(err, "mkdir: cannot create directory '");
                let _ = err.write_all(path);
                let _ = writeln!(err, "': {}", msg);
            } else if let Some(mode) = explicit_mode {
                let _ = fs::set_permissions(op, fs::Permissions::from_mode(mode));
            }
        }
    }

    process::exit(if all_ok { 0 } else { 1 });
}
