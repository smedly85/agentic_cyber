Now let me write the complete implementation:

```rust
use std::env;
use std::ffi::OsString;
use std::fs;
use std::io::Write;
use std::os::unix::ffi::OsStringExt;
use std::process;

fn errno_to_str(errno: i32) -> &'static str {
    match errno {
        2 => "No such file or directory",
        13 => "Permission denied",
        17 => "File exists",
        20 => "Not a directory",
        30 => "Read-only file system",
        36 => "File name too long",
        40 => "Too many levels of symbolic links",
        _ => "Unknown error",
    }
}

fn report_invalid_option(arg: &OsString) -> ! {
    let bytes = arg.as_encoded_bytes();
    let mut stderr = std::io::stderr();
    if bytes.starts_with(b"--") && bytes.len() > 2 {
        let name = &bytes[2..];
        let _ = write!(stderr, "mkdir: unrecognized option '");
        let _ = stderr.write_all(name);
        let _ = writeln!(stderr, "'");
    } else {
        let ch = bytes.get(1).copied().unwrap_or(63); // '?' if no second byte
        let _ = write!(stderr, "mkdir: invalid option -- '{}'", ch as char);
    }
    let _ = writeln!(stderr, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn report_missing_operand() -> ! {
    let mut stderr = std::io::stderr();
    let _ = writeln!(stderr, "mkdir: missing operand");
    let _ = writeln!(stderr, "Try 'mkdir --help' for more information.");
    process::exit(1);
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if after_ddash {
            operands.push(arg.clone());
        } else if arg.as_encoded_bytes() == b"--" {
            after_ddash = true;
        } else if arg.as_encoded_bytes().starts_with(b"-") && arg.as_encoded_bytes().len() > 1 {
            report_invalid_option(arg);
        } else {
            operands.push(arg.clone());
        }
    }
    
    if operands.is_empty() {
        report_missing_operand();
    }
    
    let mut all_ok = true;
    let mut stderr = std::io::stderr();
    
    for operand in &operands {
        match fs::create_dir(operand) {
            Ok(()) => {}
            Err(e) => {
                all_ok = false;
                let errno = e.raw_os_error().unwrap_or(-1);
                let msg = errno_to_str(errno);
                let path_bytes = operand.as_encoded_bytes();
                let _ = write!(stderr, "mkdir: cannot create directory '");
                let _ = stderr.write_all(path_bytes);
                let _ = writeln!(stderr, "': {}", msg);
            }
        }
    }
    
    process::exit(if all_ok { 0 } else { 1 });
}
```

