        let bytes = arg.as_bytes();
        
        if seen_dd {
            operands.push(arg.clone());
            i += 1;
            continue;
        }
        
        if bytes == b"--" {
            seen_dd = true;
        } else if bytes == b"-" {
            operands.push(arg.clone());
        } else if bytes == b"-p" {
            parents = true;
        } else if bytes == b"--parents" {
