```rust
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::PermissionsExt;

fn main() {
    let args: Vec<std::ffi::OsString> = std::env::args_os().skip(1).collect();

    let mut seen_dd = false;
    let mut operands: Vec<std::ffi::OsString> = Vec::new();
    let mut parents = false;

    for arg in &args {
        let bytes = arg.as_bytes();
        if !seen_dd {
            if bytes == b"--" {
                seen_dd = true;
            } else if bytes == b"-" {
                operands.push(arg.clone());
            } else if bytes == b"-p" {
                parents = true;
            } else if bytes == b"--parents" {
                parents = true;
            } else if bytes.first() == Some(&b'-') {
                // Unknown option
                let mut out: Vec<u8> = Vec::new();
                if bytes.len() > 1 && bytes[1] == b'-' {
                    out.extend_from_slice(b"mkdir: unrecognized option '");
                    out.extend_from_slice(bytes);
                    out.extend_from_slice(b"'\nTry 'mkdir --help' for more information.\n");
                } else {
                    out.extend_from_slice(b"mkdir: invalid option -- '");
                    out.push(bytes[1]);
                    out.extend_from_slice(b"'\nTry 'mkdir --help' for more information.\n");
                }
                let stderr = std::io::stderr();
                let mut lock = stderr.lock();
                let _ = lock.write_all(&out);
                std::process::exit(1);
            } else {
                operands.push(arg.clone());
            }
        } else {
            operands.push(arg.clone());
        }
    }

    if operands.is_empty() {
        let msg = b"mkdir: missing operand\nTry 'mkdir --help' for more information.\n";
        let stderr = std::io::stderr();
        let mut lock = stderr.lock();
        let _ = lock.write_all(msg);
        std::process::exit(1);
    }

    let mut any_failed = false;
    for operand in &operands {
        let path = std::path::Path::new(operand);
        let result = if parents {
            create_parents(path)
        } else {
            std::fs::create_dir(path).map(|()| ())
        };

        if let Err(e) = result {
            any_failed = true;
            let err_msg = os_error_message(&e);
            let mut out: Vec<u8> = Vec::new();
            out.extend_from_slice(b"mkdir: cannot create directory '");
            out.extend_from_slice(operand.as_bytes());
            out.extend_from_slice(b"': ");
            out.extend_from_slice(err_msg.as_bytes());
            out.extend_from_slice(b"\n");
            let stderr = std::io::stderr();
            let mut lock = stderr.lock();
            let _ = lock.write_all(&out);
        }
    }

    if any_failed {
        std::process::exit(1);
    }
}

fn create_parents(path: &std::path::Path) -> Result<(), std::io::Error> {
    // Normalize the path: remove '.' components, resolve '..' lexically,
    // collapse repeated slashes.
    let normalized = normalize_path(path);
    
    if normalized.as_os_str().is_empty() {
        // Just "." or "" - nothing to do
        return Ok(());
    }
    
    // Walk components building up prefix
    let mut prefix = std::path::PathBuf::new();
    let mut components: Vec<&std::path::Component> = normalized.components().collect();
    
    // If the path is just "/" (root), it exists, so succeed.
    if normalized == std::path::Path::new("/") {
        return Ok(());
    }
    
    let n = components.len();
    for (i, comp) in components.iter().enumerate() {
        match comp {
            std::path::Component::RootDir => {
                prefix.push("/");
            }
            std::path::Component::Normal(c) => {
                prefix.push(c);
                let is_final = (i == n - 1);
                // Check if prefix exists
                if std::path::Path::new(&prefix).symlink_metadata().is_ok() {
                    // It exists - check if it's a directory
                    let meta = std::fs::metadata(prefix)?;  // follows symlinks
                    if !meta.is_dir() {
                        return Err(std::io::Error::new(
                            std::io::ErrorKind::NotADirectory,
                            "Not a directory"
                        ));
                    }
                    // It's a directory (or symlink to dir) - OK for -p
                } else {
                    // Doesn't exist - create it
                    let mode = if is_final {
                        0o777  // umask will be applied by kernel
                    } else {
                        0o777  // umask will be applied, then we fix owner bits
                    };
                    std::fs::DirBuilder::new().mode(mode).create(prefix)?;
                    if !is_final {
                        // Ensure owner has write and search (execute) permission
                        let meta = std::fs::metadata(prefix)?;
                        let current_mode = meta.permissions().mode();
                        let desired_mode = current_mode | 0o300;
                        if current_mode != desired_mode {
                            std::fs::set_permissions(prefix, std::fs::Permissions::from_mode(desired_mode))?;
                        }
                    }
                }
            }
            _ => {}
        }
    }
    
    Ok(())
}
```

