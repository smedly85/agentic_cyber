#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>

typedef struct {
    unsigned char *data;
    size_t len;
    size_t input_idx;
} Record;

static int do_reverse = 0;
static int do_fold = 0;
static int do_unique = 0;
static int do_check = 0;

static void
free_records(Record *records, size_t count)
{
    for (size_t i = 0; i < count; i++)
        free(records[i].data);
    free(records);
}

static int
fold_byte(unsigned char c)
{
    if (c >= 'A' && c <= 'Z')
        return (unsigned char)(c + 0x20);
    return c;
}

static int
compare_records(const void *a, const void *b)
{
    const Record *ra = (const Record *)a;
    const Record *rb = (const Record *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int cmp = 0;

    if (do_fold) {
        for (size_t i = 0; i < minlen; i++) {
            unsigned char fa = fold_byte(ra->data[i]);
            unsigned char fb = fold_byte(rb->data[i]);
            if (fa != fb) {
                cmp = (int)fa - (int)fb;
                break;
            }
        }
        if (cmp == 0) {
            if (ra->len < rb->len)
                cmp = -1;
            else if (ra->len > rb->len)
                cmp = 1;
            else
                cmp = memcmp(ra->data, rb->data, ra->len);
        }
    } else {
        if (minlen > 0)
            cmp = memcmp(ra->data, rb->data, minlen);
        if (cmp == 0) {
            if (ra->len < rb->len)
                cmp = -1;
            else if (ra->len > rb->len)
                cmp = 1;
        }
    }

    return do_reverse ? -cmp : cmp;
}

static int
records_equal_for_unique(const Record *a, const Record *b)
{
    if (a->len != b->len)
        return 0;
    if (do_fold) {
        for (size_t i = 0; i < a->len; i++) {
            if (fold_byte(a->data[i]) != fold_byte(b->data[i]))
                return 0;
        }
        return 1;
    }
    return memcmp(a->data, b->data, a->len) == 0;
}

int
main(int argc, char *argv[])
{
    signal(SIGPIPE, SIG_IGN);

    /* --- argument parsing --- */
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];

        if (strcmp(arg, "--") == 0) {
            if (i + 1 < argc) {
                fprintf(stderr, "sort: cannot read: %s: %s\n",
                        argv[i + 1], strerror(ENOENT));
                return 2;
            }
            continue;
        }

        if (arg[0] == '-' && arg[1] == '-') {
            /* long option */
            if (strcmp(arg, "--reverse") == 0) {
                do_reverse = 1;
                continue;
            }
            if (strcmp(arg, "--ignore-case") == 0) {
                do_fold = 1;
                continue;
            }
            if (strcmp(arg, "--unique") == 0) {
                do_unique = 1;
                continue;
            }
            if (strcmp(arg, "--check") == 0) {
                do_check = 1;
                continue;
            }
            fprintf(stderr, "sort: unrecognized option '%s'\n", arg);
            fprintf(stderr, "Try 'sort --help' for more information.\n");
            return 2;
        }

        if (arg[0] == '-' && arg[1] != '\0') {
            /* short option cluster: parse each character */
            for (const char *p = arg + 1; *p; p++) {
                switch (*p) {
                case 'r':
                    do_reverse = 1;
                    break;
                case 'f':
                    do_fold = 1;
                    break;
                case 'u':
                    do_unique = 1;
                    break;
                case 'c':
                    do_check = 1;
                    break;
                default:
                    fprintf(stderr, "sort: unrecognized option '%c'\n", *p);
                    fprintf(stderr, "Try 'sort --help' for more information.\n");
                    return 2;
                }
            }
            continue;
        }

        /* bare "-" or any operand: not supported */
        fprintf(stderr, "sort: cannot read: %s: %s\n",
                arg, strerror(ENOENT));
        return 2;
    }

    /* --- read all records from stdin --- */
    Record  *records = NULL;
    size_t   count    = 0;
    size_t   capacity = 0;
    char    *linebuf  = NULL;
    size_t   linecap  = 0;

    for (;;) {
        ssize_t linelen = getline(&linebuf, &linecap, stdin);
        if (linelen == -1) {
            if (ferror(stdin)) {
                fprintf(stderr, "sort: error reading input\n");
                free(linebuf);
                free_records(records, count);
                return 2;
            }
            break;  /* EOF */
        }

        /* strip trailing newline if present */
        size_t reclen = (linelen > 0 && linebuf[linelen - 1] == '\n')
                        ? (size_t)(linelen - 1)
                        : (size_t)linelen;

        /* grow the records array */
        if (count >= capacity) {
            size_t newcap = capacity ? capacity * 2 : 256;
            Record *tmp = realloc(records, newcap * sizeof *tmp);
            if (!tmp) {
                fprintf(stderr, "sort: out of memory\n");
                free(linebuf);
                free_records(records, count);
                return 2;
            }
            records = tmp;
            capacity = newcap;
        }

        /* copy record bytes (may contain NUL) */
        unsigned char *data = NULL;
        if (reclen > 0) {
            data = malloc(reclen);
            if (!data) {
                fprintf(stderr, "sort: out of memory\n");
                free(linebuf);
                free_records(records, count);
                return 2;
            }
            memcpy(data, linebuf, reclen);
        }

        records[count].data = data;
        records[count].len  = reclen;
        records[count].input_idx = count;
        count++;
    }

    free(linebuf);

    /* --- check mode: verify input order, emit nothing on stdout --- */
    if (do_check) {
        for (size_t i = 0; i + 1 < count; i++) {
            int violation = 0;
            if (do_unique && records_equal_for_unique(&records[i], &records[i + 1])) {
                violation = 1;
            } else {
                int cmp = compare_records(&records[i], &records[i + 1]);
                if (cmp > 0)
                    violation = 1;
            }
            if (violation) {
                fprintf(stderr, "sort: %zu: input is not in sorted order\n", i + 2);
                free_records(records, count);
                return 1;
            }
        }
        free_records(records, count);
        return 0;
    }

    /* --- sort --- */
    if (count > 1)
        qsort(records, count, sizeof *records, compare_records);

    /* --- deduplicate (first-in-input-order representative per group) --- */
    if (do_unique && count > 0) {
        size_t out_count = 0;
        size_t i = 0;
        while (i < count) {
            size_t j = i + 1;
            while (j < count && records_equal_for_unique(&records[i], &records[j]))
                j++;
            /* group is [i, j); pick the one with smallest input_idx */
            size_t best = i;
            for (size_t k = i + 1; k < j; k++)
                if (records[k].input_idx < records[best].input_idx)
                    best = k;
            /* free non-chosen records in the group */
            for (size_t k = i; k < j; k++) {
                if (k != best)
                    free(records[k].data);
            }
            /* move chosen record to out_count position */
            if (best != out_count)
                records[out_count] = records[best];
            out_count++;
            i = j;
        }
        count = out_count;
    }

    /* --- write output --- */
    for (size_t i = 0; i < count; i++) {
        if (records[i].len > 0) {
            if (fwrite(records[i].data, 1, records[i].len, stdout)
                != records[i].len)
                goto write_err;
        }
        if (fputc('\n', stdout) == EOF)
            goto write_err;
    }

    if (fflush(stdout) == EOF)
        goto write_err;

    free_records(records, count);
    return 0;

write_err:
    fprintf(stderr, "sort: error writing output\n");
    free_records(records, count);
    return 2;
}
