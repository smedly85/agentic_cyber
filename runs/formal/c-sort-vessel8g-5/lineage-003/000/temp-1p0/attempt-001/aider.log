#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Record;

static void
free_records(Record *records, size_t count)
{
    for (size_t i = 0; i < count; i++)
        free(records[i].data);
    free(records);
}

static int
compare_records(const void *a, const void *b)
{
    const Record *ra = *(const Record *const *)a;
    const Record *rb = *(const Record *const *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int cmp = memcmp(ra->data, rb->data, minlen);
    if (cmp != 0)
        return cmp;
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return  1;
    return 0;
}

