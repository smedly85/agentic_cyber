#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Record;

static int compare_records(const void *a, const void *b) {
    const Record *ra = *(const Record * const *)a;
    const Record *rb = *(const Record * const *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int cmp = memcmp(ra->data, rb->data, minlen);
    if (cmp != 0) return cmp;
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return 1;
    return 0;
}

static void usage(void) {
    fprintf(stderr, "Usage: sort [OPTION]...\n");
    fprintf(stderr, "Try 'sort --help' for more information.\n");
}

int main(int argc, char *argv[]) {
    // Argument parsing
    if (argc == 2 && strcmp(argv[1], "--") == 0) {
        // valid: bare --
    } else if (argc != 1) {
        // invalid
        usage();
        return 2;
    }
    
    // Read all records
    Record *records = NULL;
    size_t count = 0;
    size_t capacity = 0;
    
    char *linebuf = NULL;
    size_t linecap = 0;
    ssize_t linelen;
    
    while ((linelen = getline(&linebuf, &linecap, stdin)) != -1) {
        if (ferror(stdin)) {
            free(linebuf);
            free(records);
            fprintf(stderr, "sort: read error\n");
            return 2;
        }
        
        size_t reclen = linelen;
        if (linelen > 0 && linebuf[linelen - 1] == '\n') {
            reclen = linelen - 1;
        }
        
        // Grow records array
        if (count >= capacity) {
            size_t newcap = capacity ? capacity * 2 : 256;
            Record *newarr = realloc(records, newcap * sizeof(Record));
            if (!newarr) {
                free(linebuf);
                free(records);
                fprintf(stderr, "sort: memory allocation failed\n");
                return 2;
            }
            records = newarr;
            capacity = newcap;
        }
        
        // Allocate record data
        unsigned char *data;
        if (reclen > 0) {
            data = malloc(reclen);
            if (!data) {
                free(linebuf);
                free(records);
                fprintf(stderr, "sort: memory allocation failed\n");
                return 2;
            }
            memcpy(data, linebuf, reclen);
        } else {
            data = NULL;
        }
        
        records[count].data = data;
        records[count].len = reclen;
        count++;
    }
    
    free(linebuf);
    
    // Sort
    if (count > 1) {
        qsort(records, count, sizeof(Record), compare_records);
    }
    
    // Write output
    for (size_t i = 0; i < count; i++) {
        if (records[i].len > 0) {
            if (fwrite(records[i].data, 1, records[i].len, stdout) != records[i].len) {
                fprintf(stderr, "sort: write error\n");
                return 2;
            }
        }
        if (fputc('\n', stdout) == EOF) {
            fprintf(stderr, "sort: write error\n");
            return 2;
        }
    }
    
    if (fflush(stdout) == EOF) {
        fprintf(stderr, "sort: write error\n");
        return 2;
    }
    
    // Cleanup
    for (size_t i = 0; i < count; i++) {
        free(records[i].data);
    }
    free(records);
    
    return 0;
}
```

