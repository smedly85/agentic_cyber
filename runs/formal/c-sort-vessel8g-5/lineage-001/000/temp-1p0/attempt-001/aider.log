Now, let me write the complete C implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

// Read all of stdin into a dynamically allocated buffer
static unsigned char *read_all_stdin(size_t *out_len) {
    size_t cap = 65536;
    size_t len = 0;
    unsigned char *buf = malloc(cap);
    if (!buf) return NULL;
    
    for (;;) {
        if (len == cap) {
            cap *= 2;
            unsigned char *nb = realloc(buf, cap);
            if (!nb) { free(buf); return NULL; }
            buf = nb;
        }
        ssize_t n = read(STDIN_FILENO, buf + len, cap - len);
        if (n < 0) {
            if (errno == EINTR) continue;
            free(buf);
            return NULL;
        }
        if (n == 0) break;
        len += (size_t)n;
    }
    *out_len = len;
    return buf;
}

// Record: pointer into buf + length
typedef struct {
    const unsigned char *ptr;
    size_t len;
} Record;

static int compare_records(const void *a, const void *b) {
    const Record *ra = a;
    const Record *rb = b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int cmp = memcmp(ra->ptr, rb->ptr, minlen);
    if (cmp != 0) return cmp;
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    // Argument validation
    int seen_ddash = 0;
    for (int i = 1; i < argc; i++) {
        if (!seen_ddash && strcmp(argv[i], "--") == 0) {
            seen_ddash = 1;
            continue;
        }
        // At this point, argv[i] is either an option or operand
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            // Unknown option
            fprintf(stderr, "sort: unrecognized option '%c'\n", argv[i][1]);
            fprintf(stderr, "Try 'sort --help' for more information.\n");
            return 2;
        }
        // Operand (includes bare '-')
        fprintf(stderr, "sort: extra operand '%s'\n", argv[i]);
        fprintf(stderr, "Try 'sort --help' for more information.\n");
        return 2;
    }
    
    // Read all of stdin
    size_t input_len;
    unsigned char *input = read_all_stdin(&input_len);
    if (!input) {
        fprintf(stderr, "sort: memory exhausted\n");
        return 2;
    }
    
    // Split into records
    if (input_len == 0) {
        free(input);
        return 0;
    }
    
    // Count records and allocate array
    // A record is a maximal sequence of bytes not containing 0x0A
    // Records are separated by 0x0A
    // If input doesn't end with 0x0A, the last segment is still a record
    
    // First pass: count records
    size_t nrecords = 0;
    for (size_t i = 0; i < input_len; i++) {
        if (input[i] == '\n') nrecords++;
    }
    // If last byte is not newline, there's one more record
    if (input_len > 0 && input[input_len - 1] != '\n') nrecords++;
    
    if (nrecords == 0) {
        free(input);
        return 0;
    }
    
    Record *records = malloc(nrecords * sizeof(Record));
    if (!records) {
        free(input);
        fprintf(stderr, "sort: memory exhausted\n");
        return 2;
    }
    
    // Second pass: fill in records
    size_t idx = 0;
    size_t start = 0;
    for (size_t i = 0; i < input_len; i++) {
        if (input[i] == '\n') {
            records[idx].ptr = input + start;
            records[idx].len = i - start;
            idx++;
            start = i + 1;
        }
    }
    // Handle last record (unterminated)
    if (input[input_len - 1] != '\n') {
        records[idx].ptr = input + start;
        records[idx].len = input_len - start;
        idx++;
    }
    
    // Sort
    qsort(records, nrecords, sizeof(Record), compare_records);
    
    // Output
    for (size_t i = 0; i < nrecords; i++) {
        if (records[i].len > 0) {
            if (write(STDOUT_FILENO, records[i].ptr, records[i].len) < 0) {
                fprintf(stderr, "sort: write error\n");
                free(records);
                free(input);
                return 2;
            }
        }
        if (write(STDOUT_FILENO, "\n", 1) < 0) {
            fprintf(stderr, "sort: write error\n");
            free(records);
            free(input);
            return 2;
        }
    }
    
    free(records);
    free(input);
    return 0;
}
```

