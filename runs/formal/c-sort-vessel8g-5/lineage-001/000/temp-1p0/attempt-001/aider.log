#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static void die(const char *msg) {
    fprintf(stderr, "%s\n", msg);
    exit(2);
}

static int write_all(int fd, const unsigned char *buf, size_t len) {
    while (len > 0) {
        ssize_t n = write(fd, buf, len);
        if (n < 0) {
            if (errno == EINTR) continue;
            return -1;
        }
        buf += (size_t)n;
        len -= (size_t)n;
    }
    return 0;
}

typedef struct {
    const unsigned char *ptr;
    size_t len;
} Record;

static int cmp_records(const void *a, const void *b) {
    const Record *ra = (const Record *)a;
    const Record *rb = (const Record *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int c = memcmp(ra->ptr, rb->ptr, minlen);
    if (c != 0) return c;
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    const char *prog = (argc > 0) ? argv[0] : "sort";
    
    /* Argument validation: no options, no operands allowed. */
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            /* -- ends option parsing; anything after is an operand. */
            if (i + 1 < argc) {
                fprintf(stderr, "%s: extra operand '%s'\n", prog, argv[i + 1]);
                fprintf(stderr, "Try '%s --help' for more information.\n", prog);
                return 2;
            }
            break;
        }
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            if (argv[i][1] == '-') {
                fprintf(stderr, "%s: unrecognized option '%s'\n", prog, argv[i]);
            } else {
                fprintf(stderr, "%s: unrecognized option '%c'\n", prog, argv[i][1]);
            }
            fprintf(stderr, "Try '%s --help' for more information.\n", prog);
            return 2;
        }
        /* Operand (includes bare '-') */
        fprintf(stderr, "%s: extra operand '%s'\n", prog, argv[i]);
        fprintf(stderr, "Try '%s --help' for more information.\n", prog);
        return 2;
    }
    
    /* Read all of stdin. */
    size_t cap = 65536, len = 0;
    unsigned char *buf = malloc(cap);
    if (!buf) {
        fprintf(stderr, "%s: memory exhausted\n", prog);
        return 2;
    }
    for (;;) {
        if (len == cap) {
            size_t ncap = cap * 2;
            if (ncap < cap) { /* overflow */
                free(buf);
                fprintf(stderr, "%s: memory exhausted\n", prog);
                return 2;
            }
            unsigned char *nb = realloc(buf, ncap);
            if (!nb) {
                free(buf);
                fprintf(stderr, "%s: memory exhausted\n", prog);
                return 2;
            }
            buf = nb;
            cap = ncap;
        }
        ssize_t n = read(STDIN_FILENO, buf + len, cap - len);
        if (n < 0) {
            if (errno == EINTR) continue;
            free(buf);
            fprintf(stderr, "%s: read error\n", prog);
            return 2;
        }
        if (n == 0) break;
        len += (size_t)n;
    }
    
    if (len == 0) {
        free(buf);
        return 0;
    }
    
    /* Count records. */
    size_t nrec = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n') nrec++;
    }
    if (buf[len - 1] != '\n') nrec++;
    
    if (nrec == 0) {
        free(buf);
        return 0;
    }
    
    Record *recs = malloc(nrec * sizeof(Record));
    if (!recs) {
        free(buf);
        fprintf(stderr, "%s: memory exhausted\n", prog);
        return 2;
    }
    
    /* Fill records. */
    size_t idx = 0, start = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n') {
            recs[idx].ptr = buf + start;
            recs[idx].len = i - start;
            idx++;
            start = i + 1;
        }
    }
    if (buf[len - 1] != '\n') {
        recs[idx].ptr = buf + start;
        recs[idx].len = len - start;
        idx++;
    }
    
    /* Sort. */
    qsort(recs, nrec, sizeof(Record), cmp_records);
    
    /* Output. */
    for (size_t i = 0; i < nrec; i++) {
        if (recs[i].len > 0) {
            if (write_all(STDOUT_FILENO, recs[i].ptr, recs[i].len) < 0) {
