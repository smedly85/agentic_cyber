#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

/* Read all of stdin into a dynamically growing buffer */
static uint8_t *read_all(size_t *out_len) {
    size_t cap = 65536;
    size_t len = 0;
    uint8_t *buf = malloc(cap);
    if (!buf) return NULL;
    
    for (;;) {
        if (len >= cap) {
            cap *= 2;
            uint8_t *nb = realloc(buf, cap);
            if (!nb) { free(buf); return NULL; }
            buf = nb;
        }
        size_t n = fread(buf + len, 1, cap - len, stdin);
        len += n;
        if (n < cap - len) {
            /* EOF or error */
            if (ferror(stdin)) { free(buf); return NULL; }
            break;
        }
    }
    *out_len = len;
    return buf;
}

