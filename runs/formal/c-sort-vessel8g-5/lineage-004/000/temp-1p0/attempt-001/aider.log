```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Record;

static int cmp_records(const void *pa, const void *pb) {
    const Record *a = (const Record *)pa;
    const Record *b = (const Record *)pb;
    size_t min_len = a->len < b->len ? a->len : b->len;
    int c = memcmp(a->data, b->data, min_len);
    if (c != 0) return c;
    if (a->len < b->len) return -1;
    if (a->len > b->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    /* Argument validation */
    int seen_ddash = 0;
    for (int i = 1; i < argc; i++) {
        if (seen_ddash) {
            fputs("usage: c_sort [--]\n", stderr);
            return 2;
        }
        if (strcmp(argv[i], "--") == 0) {
            seen_ddash = 1;
        } else {
            fputs("usage: c_sort [--]\n", stderr);
            return 2;
        }
    }

    /* Read all of stdin */
    size_t cap = 65536;
    size_t len = 0;
    unsigned char *buf = malloc(cap);
    if (!buf) {
        fputs("c_sort: memory allocation failed\n", stderr);
        return 2;
    }
    for (;;) {
        if (len == cap) {
            size_t newcap = cap * 2;
            if (newcap < cap) { /* overflow */
                free(buf);
                fputs("c_sort: input too large\n", stderr);
                return 2;
            }
            unsigned char *nb = realloc(buf, newcap);
            if (!nb) {
                free(buf);
                fputs("c_sort: memory allocation failed\n", stderr);
                return 2;
            }
            buf = nb;
            cap = newcap;
        }
        size_t n = fread(buf + len, 1, cap - len, stdin);
        len += n;
        if (n < (cap - len)) {
            if (ferror(stdin)) {
                free(buf);
                fputs("c_sort: read error\n", stderr);
                return 2;
            }
            break;
        }
    }

    /* Parse records */
    size_t *offsets = NULL;
    size_t *lengths = NULL;
    size_t count = 0;
    size_t cap_recs = 64;
    offsets = malloc(cap_recs * sizeof(size_t));
    lengths = malloc(cap_recs * sizeof(size_t));
    if (!offsets || !lengths) {
        free(offsets); free(lengths); free(buf);
        fputs("c_sort: memory allocation failed\n", stderr);
        return 2;
    }

    size_t pos = 0;
    while (pos < len) {
        /* find next newline */
        size_t nl = pos;
        while (nl < len && buf[nl] != '\n') nl++;
        
        size_t reclen = nl - pos;
        if (count == cap_recs) {
            cap_recs *= 2;
            size_t *no = realloc(offsets, cap_recs * sizeof(size_t));
            if (!no) {
                free(offsets); free(lengths); free(buf);
                fputs("c_sort: memory allocation failed\n", stderr);
                return 2;
            }
            offsets = no;
            size_t *nl2 = realloc(lengths, cap_recs * sizeof(size_t));
            if (!nl2) {
                free(offsets); free(lengths); free(buf);
                fputs("c_sort: memory allocation failed\n", stderr);
                return 2;
            }
            lengths = nl2;
        }
        offsets[count] = pos;
        lengths[count] = reclen;
        count++;
        
        if (nl < len) {
            pos = nl + 1; /* skip the newline */
        } else {
            pos = len; /* end of input */
        }
    }

    /* If input is empty, count is 0, output nothing */
    
    /* Build array of pointers for qsort */
    /* Actually, I can qsort an array of Record structs, or I can create an array of indices */
    /* Let me create an array of pointers to (offset,length) pairs */
    
    /* Actually, simplest: create an array of size_t indices, and qsort with a comparator that looks up the actual data */
    /* Or better: create an array of Record structs */
    
    // Hmm, qsort needs contiguous elements. Let me create a Record array.
    // But I already have offsets and lengths as parallel arrays. Let me just use a different approach.
    
    // Create array of Record structs
    Record *recs = malloc(count * sizeof(Record));
    if (!recs && count > 0) {
        free(offsets); free(lengths); free(buf);
        fputs("c_sort: memory allocation failed\n", stderr);
        return 2;
    }
    for (size_t i = 0; i < count; i++) {
        recs[i].data = buf + offsets[i];
        recs[i].len = lengths[i];
    }
    free(offsets);
    free(lengths);

    /* Sort */
    if (count > 1) {
        qsort(recs, count, sizeof(Record), cmp_records);
    }

    /* Write output */
    for (size_t i = 0; i < count; i++) {
        if (recs[i].len > 0) {
            if (fwrite(recs[i].data, 1, recs[i].len, stdout) != recs[i].len) {
                free(recs); free(buf);
                fputs("c_sort: write error\n", stderr);
                return 2;
            }
        }
        if (fputc('\n', stdout) == EOF) {
            free(recs); free(buf);
            fputs("c_sort: write error\n", stderr);
            return 2;
        }
    }

    if (fflush(stdout) != 0) {
        free(recs); free(buf);
        fputs("c_sort: write error\n", stderr);
        return 2;
    }

    free(recs);
    free(buf);
    return 0;
}
