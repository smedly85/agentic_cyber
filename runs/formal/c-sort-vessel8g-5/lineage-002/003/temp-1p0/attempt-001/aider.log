#define _POSIX_C_SOURCE 200809L

#include <errno.h>
#include <stdio.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

struct record {
    const unsigned char *ptr;
    size_t len;
};

static int reverse_order = 0;
static int fold_case = 0;
static int unique = 0;

static int compare_folded(const struct record *ra, const struct record *rb)
{
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    for (size_t i = 0; i < minlen; i++) {
        unsigned char a = ra->ptr[i];
        unsigned char b = rb->ptr[i];
        if (a >= 'A' && a <= 'Z') a = (unsigned char)(a - 'A' + 'a');
        if (b >= 'A' && b <= 'Z') b = (unsigned char)(b - 'A' + 'a');
        if (a != b)
            return (int)a - (int)b;
    }
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return 1;
    return 0;
}

static int keys_equal(const struct record *a, const struct record *b)
{
    if (fold_case)
        return compare_folded(a, b) == 0;
    if (a->len != b->len) return 0;
    return memcmp(a->ptr, b->ptr, a->len) == 0;
}

static int cmp_records(const void *a, const void *b)
{
    const struct record *ra = (const struct record *)a;
    const struct record *rb = (const struct record *)b;
    int c;

    if (fold_case) {
        c = compare_folded(ra, rb);
        if (c != 0)
            return reverse_order ? -c : c;
        /* folded keys equal: fall through to last-resort original-byte comparison */
    }

    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    c = memcmp(ra->ptr, rb->ptr, minlen);
    if (c != 0)
        return reverse_order ? -c : c;
    if (ra->len < rb->len)
        return reverse_order ? 1 : -1;
    if (ra->len > rb->len)
        return reverse_order ? -1 : 1;
    return 0;
}

static void fail(const char *msg)
{
    size_t i = 0;
    while (msg[i] != '\0')
        i++;
    (void)write(2, msg, i);
    (void)write(2, "\n", 1);
    exit(2);
}

static int write_all(int fd, const void *buf, size_t len)
{
    const unsigned char *p = (const unsigned char *)buf;
    size_t off = 0;
    while (off < len) {
        ssize_t n = write(fd, p + off, len - off);
        if (n < 0) {
            if (errno == EINTR)
                continue;
            return -1;
        }
        off += (size_t)n;
    }
    return 0;
}

