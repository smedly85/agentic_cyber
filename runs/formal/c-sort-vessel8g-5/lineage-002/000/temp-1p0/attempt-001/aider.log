#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>

struct record {
    const unsigned char *ptr;
    size_t len;
};

static int cmp_records(const void *a, const void *b) {
    const struct record *ra = (const struct record *)a;
    const struct record *rb = (const struct record *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int c = memcmp(ra->ptr, rb->ptr, minlen);
    if (c != 0) return c;
    if (ra->len < rb->len) return -1;
    if (ra->len > rb->len) return 1;
    return 0;
}

static void die(const char *msg) {
    fprintf(stderr, "%s\n", msg);
    exit(2);
}

int main(int argc, char *argv[]) {
    // Argument parsing: only empty args or exactly ["--"] is valid
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            if (i + 1 < argc) {
                fprintf(stderr, "usage: sort\n");
                return 2;
            }
            break; // OK, end of options, no more args
        } else {
            fprintf(stderr, "usage: sort\n");
            return 2;
        }
    }
    
    // Read all of stdin
    size_t cap = 65536;
    size_t len = 0;
    unsigned char *buf = malloc(cap);
    if (!buf) die("sort: out of memory");
    
    for (;;) {
        if (len == cap) {
            size_t newcap = cap * 2;
            unsigned char *tmp = realloc(buf, newcap);
            if (!tmp) die("sort: out of memory");
            buf = tmp;
            cap = newcap;
        }
        ssize_t r = read(0, buf + len, cap - len);
        if (r < 0) {
            if (errno == EINTR) continue;
            die("sort: read error");
        }
        if (r == 0) break;
        len += (size_t)r;
    }
    
    // Parse records
    size_t max_records = len / 2 + 1; // upper bound (every other byte is \n)
    // Actually worst case: every byte is \n, so len records + possibly 1 more
    // But if every byte is \n, we get len records (each empty)
    // If no byte is \n, we get 1 record
    // Upper bound: len/2 + 1 is not right either
    // True upper bound: len + 1 (if len > 0, at most len/2 + 1 records if alternating)
    // Actually the max number of records is: count of \n + (last char != \n ? 1 : 0)
    // Max count of \n is len, so max records is len + 1... no wait
    // If all bytes are \n: len records (each empty)
    // If alternating \n and other: about len/2 records
    // Max is len (all \n) or 1 (no \n and len > 0) or 0 (len == 0)
    // So upper bound is max(len, 1) if len > 0, else 0
    // But to be safe, let's just use len + 1 as upper bound
    
    if (len == 0) {
        free(buf);
        return 0;
    }
    
    // Count records first
    size_t nrecords = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n') nrecords++;
    }
    if (buf[len - 1] != '\n') nrecords++;
    
    struct record *recs = malloc(nrecords * sizeof(struct record));
    if (!recs) die("sort: out of memory");
    
    size_t idx = 0;
    size_t start = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n') {
            recs[idx].ptr = buf + start;
            recs[idx].len = i - start;
            idx++;
            start = i + 1;
        }
    }
    if (start < len) {
        recs[idx].ptr = buf + start;
        recs[idx].len = len - start;
        idx++;
    }
    // idx should == nrecords
    
    // Sort
    if (nrecords > 1) {
        qsort(recs, nrecords, sizeof(struct record), cmp_records);
    }
    
    // Output
    for (size_t i = 0; i < nrecords; i++) {
        if (recs[i].len > 0) {
            ssize_t w = write(1, recs[i].ptr, recs[i].len);
            if (w < 0) {
                if (errno == EINTR) { /* retry? or die? */ }
                die("sort: write error");
