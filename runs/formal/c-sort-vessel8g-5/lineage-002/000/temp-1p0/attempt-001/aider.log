        }
        unsigned char nl = '\n';
        ssize_t w = write(1, &nl, 1);
        if (w < 0) {
            if (errno == EINTR) { /* retry? or die? */ }
            die("sort: write error");
        }
    }
    
    free(recs);
    free(buf);
    return 0;
}
```

