            if (c < 0 || (c == 0 && unique)) {
                fprintf(stderr, "sort: disorder: line %zu\n", i + 2);
                free(recs);
                free(buf);
                return 1;
            }
        }
        free(recs);
        free(buf);
        return 0;
    }

    /* Sort records (unsigned bytewise lexicographic). */
    if (nrec > 1)
        qsort(recs, nrec, sizeof(*recs), cmp_records);

    /* Deduplicate after sorting: equal records are now adjacent;
