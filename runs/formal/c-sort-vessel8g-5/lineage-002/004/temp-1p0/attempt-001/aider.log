        }
        {
            FILE *f = fopen(argv[i], "rb");
            if (f == NULL) {
                fprintf(stderr, "sort: cannot read: %s: %s\n", argv[i], strerror(errno));
                exit(2);
            }
            fclose(f);
            fprintf(stderr, "sort: file operands are not supported\n");
            exit(2);
        }
    }

    /* Read all of stdin into a dynamically growing buffer. */
    size_t cap = 65536;
    size_t len = 0;
    unsigned char *buf = malloc(cap);
    if (buf == NULL)
        fail("sort: out of memory");

    for (;;) {
        if (len >= cap) {
            size_t newcap = cap * 2;
            if (newcap < cap)
                fail("sort: out of memory");
            unsigned char *tmp = realloc(buf, newcap);
            if (tmp == NULL) {
                free(buf);
                fail("sort: out of memory");
            }
            buf = tmp;
            cap = newcap;
        }
        ssize_t n = read(0, buf + len, cap - len);
        if (n < 0) {
            if (errno == EINTR)
                continue;
            free(buf);
            fail("sort: read error");
        }
        if (n == 0)
            break;
        len += (size_t)n;
    }

    /* Empty input: emit nothing, exit 0. */
    if (len == 0) {
        free(buf);
        return 0;
    }

    /* Count records. */
    size_t nrec = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n')
            nrec++;
    }
    if (buf[len - 1] != '\n')
        nrec++;

    struct record *recs = malloc(nrec * sizeof(*recs));
    if (recs == NULL) {
        free(buf);
        fail("sort: out of memory");
    }

    /* Partition buffer into records (pointers into buf). */
    size_t idx = 0;
    size_t start = 0;
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '\n') {
            recs[idx].ptr = buf + start;
            recs[idx].len = i - start;
            recs[idx].idx = idx;
            idx++;
            start = i + 1;
        }
    }
    if (start < len) {
        recs[idx].ptr = buf + start;
        recs[idx].len = len - start;
        recs[idx].idx = idx;
        idx++;
    }

    /* Check mode: verify input is already ordered; emit no stdout. */
    if (check_mode) {
        if (nrec <= 1) {
            free(recs);
            free(buf);
            return 0;
        }
        for (size_t i = 0; i + 1 < nrec; i++) {
            int c;
            if (fold_case) {
                c = compare_folded(&recs[i], &recs[i + 1]);
                if (c != 0)
                    c = reverse_order ? -c : c;
                else if (!unique) {
