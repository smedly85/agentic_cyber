#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

struct record {
    const unsigned char *ptr;
    size_t len;
};

static int cmp_records(const void *a, const void *b) {
    const struct record *ra = *(const struct record *const *)a;
    const struct record *rb = *(const struct record *const *)b;
    size_t minlen = ra->len < rb->len ? ra->len : rb->len;
    int c = memcmp(ra->ptr, rb->ptr, minlen);
    if (c != 0)
        return c;
    if (ra->len < rb->len)
        return -1;
    if (ra->len > rb->len)
        return 1;
    return 0;
}

static void die(const char *msg) {
    fprintf(stderr, "c_sort: %s\n", msg);
    exit(2);
}

int main(int argc, char *argv[]) {
    /* Argument validation: no options or operands are accepted.
       A lone "--" is tolerated. Anything else is an error. */
    for (int i = 1; i < argc; i++) {
        if (i == 1 && strcmp(argv[i], "--") == 0)
            continue;
        /* After "--" or for any non-"--" arg: error */
        if (i > 1)
            die("unrecognized operand");
        /* i == 1 and not "--" */
        if (argv[i][0] == '-' && argv[i][1] != '\0')
            die("unrecognized option");
        else
            die("unrecognized operand");
    }
```

