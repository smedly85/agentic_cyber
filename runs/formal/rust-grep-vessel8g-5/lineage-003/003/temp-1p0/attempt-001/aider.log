use std::env;
use std::ffi::OsString;
use std::fs::File;
use std::io::{self, BufRead, BufReader, Write};
use std::os::unix::ffi::OsStrExt;
use std::process;

#[derive(PartialEq)]
enum FilenameMode {
    Default,
    ForceOn,
    ForceOff,
}

fn contains_subslice(haystack: &[u8], needle: &[u8]) -> bool {
    if needle.is_empty() {
        return true;
    }
    if needle.len() > haystack.len() {
        return false;
    }
    haystack.windows(needle.len()).any(|w| w == needle)
}

fn search_stream<R: BufRead, W: Write>(
    reader: &mut R,
    writer: &mut W,
    pattern: &[u8],
    prefix: &[u8],
) -> io::Result<bool> {
    let mut matched = false;
    let mut line = Vec::new();
    loop {
        line.clear();
        let n = reader.read_until(b'\n', &mut line)?;
        if n == 0 {
            break;
        }
        let content = if line.last() == Some(&b'\n') {
            &line[..line.len() - 1]
        } else {
            &line[..]
        };
        if contains_subslice(content, pattern) {
            if !prefix.is_empty() {
                writer.write_all(prefix)?;
            }
            writer.write_all(content)?;
            writer.write_all(b"\n")?;
            matched = true;
        }
    }
    Ok(matched)
}

fn search_one_file(pattern: &[u8], path: &OsString, prefix: &[u8]) -> io::Result<bool> {
    let file = File::open(path)?;
    let mut reader = BufReader::new(file);
    let stdout = io::stdout();
    let mut writer = stdout.lock();
    search_stream(&mut reader, &mut writer, pattern, prefix)
}

fn join_path(base: &OsString, name: &OsString) -> OsString {
    let base_bytes = base.as_bytes();
    let mut result = OsString::new();
    result.push(base);
    if !base_bytes.is_empty() && base_bytes[base_bytes.len() - 1] != b'/' {
        result.push("/");
    }
    result.push(name);
    result
}

fn traverse_directory(
    pattern: &[u8],
    dir_path: &OsString,
    need_prefix: bool,
    any_match: &mut bool,
    any_error: &mut bool,
) {
    let entries = match std::fs::read_dir(dir_path) {
        Ok(entries) => entries,
        Err(e) => {
            let name = dir_path.to_string_lossy();
            let _ = writeln!(io::stderr(), "rust_grep: {}: {}", name, e);
            *any_error = true;
            return;
        }
    };

    let mut names: Vec<OsString> = Vec::new();
    for entry in entries {
        match entry {
            Ok(e) => names.push(e.file_name()),
            Err(e) => {
                let name = dir_path.to_string_lossy();
                let _ = writeln!(io::stderr(), "rust_grep: {}: {}", name, e);
                *any_error = true;
            }
        }
    }
    names.sort();

    for name in names {
        let full_path = join_path(dir_path, &name);

        let metadata = match std::fs::symlink_metadata(&full_path) {
            Ok(m) => m,
            Err(e) => {
                let display = full_path.to_string_lossy();
                let _ = writeln!(io::stderr(), "rust_grep: {}: {}", display, e);
                *any_error = true;
                continue;
            }
        };

        let file_type = metadata.file_type();

        if file_type.is_symlink() {
            continue;
        }

        if file_type.is_file() {
            let prefix: Vec<u8> = if need_prefix {
                let mut p = full_path.as_bytes().to_vec();
                p.push(b':');
                p
            } else {
                Vec::new()
            };
            match search_one_file(pattern, &full_path, &prefix) {
                Ok(m) => {
                    if m {
                        *any_match = true;
                    }
                }
                Err(e) => {
                    let display = full_path.to_string_lossy();
                    let _ = writeln!(io::stderr(), "rust_grep: {}: {}", display, e);
                    *any_error = true;
                }
            }
        } else if file_type.is_dir() {
            traverse_directory(pattern, &full_path, need_prefix, any_match, any_error);
        }
    }
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();

    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut past_ddash = false;
    let mut filename_mode = FilenameMode::Default;
    let mut recursive = false;

    for arg in &args {
        let bytes = arg.as_bytes();
        if !past_ddash && bytes == b"--" {
            past_ddash = true;
