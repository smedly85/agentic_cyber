fn join_path(base: &OsString, name: &OsString) -> OsString {
    let base_bytes = base.as_bytes();
    if base_bytes.ends_with(b"/") || base_bytes.ends_with(b"\\") {
        // No need to add separator
        let mut result = base.clone();
        result.push(name);
        result
