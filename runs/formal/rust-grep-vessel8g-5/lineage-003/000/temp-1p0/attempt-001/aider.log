        Some(p) => p,
        None => {
            eprintln!("usage: rust_grep PATTERN [FILE...]");
            process::exit(2);
        }
    };
    
    let any_match = search(&pattern, &files);
    let exit_code = if any_match.is_err() { 2 } else if any_match.unwrap() { 0 } else { 1 };
    process::exit(exit_code);
}
