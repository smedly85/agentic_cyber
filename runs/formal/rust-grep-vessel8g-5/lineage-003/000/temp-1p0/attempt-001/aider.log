```rust
use std::env;
use std::fs::File;
use std::io::{self, BufRead, BufReader, Read, Write};
use std::os::unix::ffi::OsStringExt;
use std::process;

fn search_stream<R: BufRead, W: Write>(
    reader: &mut R,
    writer: &mut W,
    pattern: &[u8],
    prefix: &[u8],
) -> io::Result<bool> {
    let mut matched = false;
    let mut line = Vec::new();
    loop {
        line.clear();
        let n = reader.read_line(&mut line)?;
        if n == 0 {
            break;
        }
        // Strip trailing newline for matching
        let content = if line.last() == Some(&b'\n') {
            &line[..line.len() - 1]
        } else {
            &line[..]
        };
        if pattern.is_empty() || content.windows(pattern.len()).any(|w| w == pattern) {
            if !prefix.is_empty() {
                writer.write_all(prefix)?;
            }
            writer.write_all(content)?;
            writer.write_all(b"\n")?;
            matched = true;
        }
    }
    Ok(matched)
}

fn main() {
    let args: Vec<std::ffi::OsString> = env::args_os().skip(1).collect();
    
    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<std::ffi::OsString> = Vec::new();
    let mut past_ddash = false;
    
    for arg in &args {
        let bytes = arg.as_bytes();
        if !past_ddash && bytes == b"--" {
            past_ddash = true;
            continue;
        }
        if !past_ddash && bytes.len() > 1 && bytes[0] == b'-' {
            eprint!("\x1brust_grep: usage: rust_grep PATTERN [FILE...]\n");
            process::exit(2);
        }
        if pattern.is_none() {
            pattern = Some(bytes.to_vec());
        } else {
            files.push(arg.clone());
        }
    }
    
    let pattern = match pattern {
        Some(p) => p,
        None => {
            eprint!("\x1brust_grep: usage: rust_grep PATTERN [FILE...]\n");
            process::exit(2);
        }
    };
    
    let mut any_match = false;
    let mut any_error = false;
    
    if files.is_empty() {
        // Search stdin
        let stdin = io::stdin();
        let mut reader = BufReader::new(stdin.lock());
        let stdout = io::stdout();
        let mut writer = stdout.lock();
        match search_stream(&mut reader, &mut writer, &pattern, b"") {
            Ok(matched) => { any_match = matched; }
            Err(_) => {
                eprint!("\x1brust_grep: read error on stdin\n");
                any_error = true;
            }
        }
    } else {
        let need_prefix = files.len() >= 2;
        for file in &files {
            let result = search_file(&pattern, file, need_prefix);
            match result {
                Ok(matched) => { if matched { any_match = true; } }
                Err(e) => {
                    let name = file.to_string_lossy();
                    eprint!("\x1brust_grep: {}: {}\n", name, e);
                    any_error = true;
                }
            }
        }
    }
    
    // Flush stdout
    let _ = io::stdout().flush();
    
    let code = if any_error { 2 } else if any_match { 0 } else { 1 };
    process::exit(code);
}

fn search_file(
    pattern: &[u8],
    path: &std::ffi::OsString,
    need_prefix: bool,
) -> io::Result<bool> {
    let file = File::open(path)?;
    let mut reader = BufReader::new(file);
    let stdout = io::stdout();
    let mut writer = stdout.lock();
    
    let prefix: Vec<u8> = if need_prefix {
        let mut p = path.as_bytes().to_vec();
        p.push(b':');
        p
    } else {
        Vec::new()
    };
    
    search_stream(&mut reader, &mut writer, pattern, &prefix)
}
```

