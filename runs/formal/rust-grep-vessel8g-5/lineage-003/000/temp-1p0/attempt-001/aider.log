                        any_match = true;
                    }
                }
                Err(e) => {
                    let name = file.to_string_lossy();
                    let _ = writeln!(io::stderr(), "rust_grep: {}: {}", name, e);
                    any_error = true;
                }
            }
        }
    }

    let _ = io::stdout().flush();

    let code = if any_error { 2 } else if any_match { 0 } else { 1 };
    process::exit(code);
}
```

**Summary of the implementation:**

- **`contains_subslice`**: Linear scan for fixed byte substring using `windows`. Empty needle always matches.
- **`search_stream`**: The semantic anchor. Reads lines via `read_until(b'\n')`, strips trailing `\n` for matching, checks substring, emits matched lines with a guaranteed trailing newline. Returns whether any line matched.
- **`search_one_file`**: Opens a file (follows symlinks via `File::open`), wraps in `BufReader`, calls `search_stream`.
- **`main`**: Parses arguments (rejects unsupported options, handles `--`), dispatches to stdin or file search, tracks match/error state, selects exit code (0/1/2), flushes stdout before exit.

**Key design decisions:**
- Empty pattern matches every line (including empty lines) via `needle.is_empty()` short-circuit.
- The prefix decision (`files.len() >= 2`) is made before any file is opened, independent of success/failure.
- File errors (missing, directory, unreadable) produce a diagnostic with the operand name and the I/O error description; processing continues to the next operand.
- All writes to stdout/stderr use `let _ =` to discard results, preventing panics on broken pipes.
- No `unsafe`, no external crates, no subprocesses — pure std library, single file.
