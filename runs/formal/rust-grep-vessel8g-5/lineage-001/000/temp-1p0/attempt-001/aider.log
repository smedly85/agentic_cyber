```rust
use std::env;
use std::ffi::OsString;
use std::fs::File;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::path::Path;
use std::process::exit;

fn search_stream(input: &[u8], pattern: &[u8], prefix: Option<&[u8]>, out: &mut dyn Write) -> io::Result<bool> {
    let mut any_match = false;
    let mut line_start = 0;

    let matched = |line: &[u8]| -> bool {
        pattern.is_empty() || {
            pattern.len() <= line.len() && line.windows(pattern.len()).any(|w| w == pattern)
        }
    };

    for i in 0..input.len() {
        if input[i] == 0x0A {
            let line = &input[line_start..i];
            if matched(line) {
                if let Some(p) = prefix {
                    out.write_all(p)?;
                    out.write_all(b":")?;
                }
                out.write_all(line)?;
                out.write_all(b"\n")?;
                any_match = true;
            }
            line_start = i + 1;
        }
    }
    if line_start < input.len() {
        let line = &input[line_start..];
        if matched(line) {
            if let Some(p) = prefix {
                out.write_all(p)?;
                out.write_all(b":")?;
            }
            out.write_all(line)?;
            out.write_all(b"\n")?;
            any_match = true;
        }
    }
    Ok(any_match)
}
```

