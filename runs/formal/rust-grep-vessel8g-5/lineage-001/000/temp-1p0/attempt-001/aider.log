fn search_stream(input: &[u8], pattern: &[u8], prefix: Option<&[u8]>, out: &mut impl Write) -> Result<bool, io::Error> {
    let mut any_match = false;
    let mut line_start = 0;
    
    let emit_line = |line: &[u8], prefix: Option<&[u8]>, out: &mut dyn Write| -> io::Result<()> {
        if let Some(p) = prefix {
            out.write_all(p)?;
            out.write_all(b":")?;
        }
        out.write_all(line)?;
        out.write_all(b"\n")?;
        Ok(())
    };
    
    for i in 0..input.len() {
        if input[i] == 0x0A {
            let line = &input[line_start..i];
            if pattern.is_empty() || line.windows(pattern.len()).any(|w| w == pattern) {
                emit_line(line, prefix, out)?;
                any_match = true;
            }
            line_start = i + 1;
        }
    }
    if line_start < input.len() {
        let line = &input[line_start..];
        if pattern.is_empty() || line.windows(pattern.len()).any(|w| w == pattern) {
            emit_line(line, prefix, out)?;
            any_match = true;
        }
    }
    Ok(any_match)
}
```

