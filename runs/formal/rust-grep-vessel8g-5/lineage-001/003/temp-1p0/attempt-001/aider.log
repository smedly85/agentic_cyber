fn traverse_dir(
    dir_path: &OsStr,
    pattern: &[u8],
    prefix_base: Option<&OsStr>,
    out: &mut dyn Write,
) -> io::Result<bool> {
    let mut any_match = false;
    let entries = match std::fs::read_dir(dir_path) {
        Ok(e) => e,
        Err(err) => {
            // diagnose and continue
            eprintln!("rust_grep: {}: {}", dir_path.to_string_lossy(), err);
            return Ok(any_match);
        }
    };
    
    let mut entries: Vec<_> = entries.filter_map(|e| e.ok()).collect();
    // Sort by raw byte order
    entries.sort_by(|a, b| {
        let a_bytes = a.file_name().as_bytes(); // OsString bytes
        let b_bytes = b.file_name().as_bytes();
        a_bytes.cmp(b_bytes)
    });
    
    for entry in entries {
        let file_name = entry.file_name();
        let full_path = dir_path.join(&file_name);
        
        let metadata = match std::fs::symlink_metadata(&full_path) {
            Ok(m) => m,
            Err(_) => {
                // diagnose unreadable
                eprintln!("rust_grep: {}: cannot stat", full_path.to_string_lossy());
                continue;
            }
        };
        
        let file_type = metadata.file_type();
        if file_type.is_symlink() {
            // skip symlinks during traversal
            continue;
        }
        
        if file_type.is_file() {
            // search this file
            let prefix = if should_prefix { Some(full_path.as_os_str().as_bytes()) } else { None };
            // ... read and search
        } else if file_type.is_dir() {
            // recurse
            any_match = any_match || traverse_dir(&full_path, pattern, should_prefix, out)?;
        }
    }
    
    Ok(any_match)
}
```

