fn traverse_dir(
    dir: &OsStr,
    pattern: &[u8],
    use_prefix: bool,
    out: &mut dyn Write,
) -> (bool, bool) {
    // Returns (any_match, any_error)
    let mut any_match = false;
    let mut any_error = false;

