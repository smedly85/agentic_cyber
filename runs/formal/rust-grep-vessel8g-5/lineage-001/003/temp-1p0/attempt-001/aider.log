            let prefix_bytes: Vec<u8> = if use_prefix {
                full.as_os_str().as_bytes().to_vec()
            } else {
                Vec::new()
            };
            let (m, e) = search_file_path(
                &full,
                pattern,
                if use_prefix { Some(prefix_bytes.as_slice()) } else { None },
                out,
            );
