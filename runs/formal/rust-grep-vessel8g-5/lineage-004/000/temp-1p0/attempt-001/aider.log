```rust
use std::io::{self, Read, Write};

fn search_stream<R: Read, W: Write>(
    reader: &mut R,
    writer: &mut W,
    pattern: &[u8],
    prefix: Option<&[u8]>,
) -> io::Result<bool> {
    let mut buf = [0u8; 8192];
    let mut line = Vec::new();
    let mut any_match = false;

    loop {
        let n = reader.read(&mut buf)?;
        if n == 0 {
            // EOF
            if !line.is_empty() {
                // final unterminated line
                if matches(&line, pattern) {
                    write_line(writer, &line, prefix)?;
                    any_match = true;
                }
            }
            return Ok(any_match);
        }
        for &byte in &buf[..n] {
            if byte == b'\n' {
                if matches(&line, pattern) {
                    write_line(writer, &line, prefix)?;
                    any_match = true;
                }
                line.clear();
            } else {
                line.push(byte);
            }
        }
    }
}

fn matches(line: &[u8], pattern: &[u8]) -> bool {
    if pattern.is_empty() {
        return true;
    }
    line.windows(pattern.len()).any(|w| w == pattern)
}

fn write_line<W: Write>(writer: &mut W, line: &[u8], prefix: Option<&[u8]>) -> io::Result<()> {
    if let Some(p) = prefix {
        writer.write_all(p)?;
        writer.write_all(b":")?;
    }
    writer.write_all(line)?;
    writer.write_all(b"\n")?;
    Ok(())
}
```

