Let me now write the complete implementation:

```rust
use std::ffi::OsString;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;

fn os_to_bytes(os: &std::ffi::OsStr) -> &[u8] {
    os.as_bytes()
}

fn search_stream<R: Read, W: Write>(
    reader: &mut R,
    writer: &mut W,
    pattern: &[u8],
    prefix: Option<&[u8]>,
) -> io::Result<bool> {
    let mut buf = [0u8; 8192];
    let mut line = Vec::new();
    let mut any_match = false;

    loop {
        let n = reader.read(&mut buf)?;
        if n == 0 {
            // EOF: emit final unterminated line if non-empty
            if !line.is_empty() {
                if line_contains(&line, pattern) {
                    emit_line(writer, &line, prefix)?;
                    any_match = true;
                }
            }
            return Ok(any_match);
        }
        for &byte in &buf[..n] {
            if byte == b'\n' {
                if line_contains(&line, pattern) {
                    emit_line(writer, &line, prefix)?;
                    any_match = true;
                }
                line.clear();
            } else {
                line.push(byte);
            }
        }
    }
}

fn line_contains(line: &[u8], pattern: &[u8]) -> bool {
    if pattern.is_empty() {
        return true;
    }
    if pattern.len() > line.len() {
        return false;
    }
    line.windows(pattern.len()).any(|w| w == pattern)
}

fn emit_line<W: Write>(writer: &mut W, line: &[u8], prefix: Option<&[u8]>) -> io::Result<()> {
    if let Some(p) = prefix {
        writer.write_all(p)?;
    }
    writer.write_all(line)?;
    writer.write_all(b"\n")?;
    Ok(())
}

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut seen_ddash = false;

    for arg in &args {
        let bytes = os_to_bytes(arg);
        if !seen_ddash {
            if bytes == b"--" {
                seen_ddash = true;
                continue;
            }
            if bytes.len() > 1 && bytes[0] == b'-' {
                let err = io::stderr();
                let mut err = err.lock();
                let _ = err.write_all(b"rust_grep: unsupported option: ");
                let _ = err.write_all(bytes);
                let _ = err.write_all(b"\nusage: rust_grep PATTERN [FILE...]\n");
                std::process::exit(2);
            }
        }
        if pattern.is_none() {
            pattern = Some(bytes.to_vec());
        } else {
            files.push(arg.clone());
        }
    }

    let pattern = match pattern {
        Some(p) => p,
        None => {
            let err = io::stderr();
            let mut err = err.lock();
            let _ = err.write_all(b"rust_grep: missing PATTERN\nusage: rust_grep PATTERN [FILE...]\n");
            std::process::exit(2);
        }
    };

    let stdout = io::stdout();
    let mut out = stdout.lock();
    let mut any_match = false;
    let mut had_error = false;

    if files.is_empty() {
        // Search stdin
        let stdin = io::stdin();
        let mut input = stdin.lock();
        match search_stream(&mut input, &mut out, &pattern, None) {
            Ok(m) => any_match = m,
            Err(e) => {
                had_error = true;
                let err = io::stderr();
                let mut err = err.lock();
                let _ = err.write_all(b"rust_grep: read error: ");
                let _ = err.write_all(e.to_string().as_bytes());
                let _ = err.write_all(b"\n");
            }
        }
    } else {
        let need_prefix = files.len() >= 2;
        for file in &files {
            let file_bytes = os_to_bytes(file);
            let prefix: Option<Vec<u8>> = if need_prefix {
                let mut p = file_bytes.to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };

            // Check if it's a directory (follows symlinks)
            let metadata = match std::fs::metadata(file) {
                Ok(m) => m,
                Err(e) => {
                    had_error = true;
                    let err = io::stderr();
                    let mut err = err.lock();
                    let _ = err.write_all(b"rust_grep: ");
                    let _ = err.write_all(file_bytes);
                    let _ = err.write_all(b": ");
                    let _ = err.write_all(e.to_string().as_bytes());
                    let _ = err.write_all(b"\n");
                    continue;
                }
            };

            if metadata.is_dir() {
                had_error = true;
                let err = io::stderr();
                let mut err = err.lock();
                let _ = err.write_all(b"rust_grep: ");
                let _ = err.write_all(file_bytes);
                let _ = err.write_all(b": Is a directory\n");
                continue;
            }

            let file_handle = match std::fs::File::open(file) {
                Ok(f) => f,
                Err(e) => {
                    had_error = true;
                    let err = io::stderr();
                    let mut err = err.lock();
                    let _ = err.write_all(b"rust_grep: ");
                    let _ = err.write_all(file_bytes);
                    let _ = err.write_all(b": ");
                    let _ = err.write_all(e.to_string().as_bytes());
                    let _ = err.write_all(b"\n");
                    continue;
                }
            };

            match search_stream(&mut file_handle, &mut out, &pattern, prefix.as_deref()) {
                Ok(m) => any_match = any_match || m,
                Err(e) => {
                    had_error = true;
                    let err = io::stderr();
                    let mut err = err.lock();
                    let _ = err.write_all(b"rust_grep: ");
                    let _ = err.write_all(file_bytes);
                    let _ = err.write_all(b": ");
                    let _ = err.write_all(e.to_string().as_bytes());
                    let _ = err.write_all(b"\n");
                }
            }
        }
    }

    // Flush stdout
    let _ = out.flush();

    if had_error {
        std::process::exit(2);
    } else if any_match {
        std::process::exit(0);
    } else {
        std::process::exit(1);
    }
}
```

