            Err(_) => {
                had_error = true;
                eprint_bytes(b"rust_grep: read error on stdin");
            }
        }
    } else {
        for file in &files {
            let file_bytes: &[u8] = file.as_bytes();
            let prefix: Option<Vec<u8>> = if need_prefix {
                let mut p = file_bytes.to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };

            let metadata = match std::fs::metadata(file) {
                Ok(m) => m,
                Err(e) => {
                    had_error = true;
                    let mut msg = file_bytes.to_vec();
                    msg.push(b':');
                    msg.push(b' ');
                    msg.extend_from_slice(e.to_string().as_bytes());
                    msg.push(b'\n');
                    eprint_bytes(&msg);
                    continue;
                }
            };

            if metadata.is_dir() {
                had_error = true;
                let mut msg = file_bytes.to_vec();
                msg.extend_from_slice(b": Is a directory\n");
                eprint_bytes(&msg);
                continue;
            }

            let mut file_handle = match std::fs::File::open(file) {
                Ok(f) => f,
                Err(e) => {
                    had_error = true;
                    let mut msg = file_bytes.to_vec();
                    msg.push(b':');
                    msg.push(b' ');
                    msg.extend_from_slice(e.to_string().as_bytes());
                    msg.push(b'\n');
                    eprint_bytes(&msg);
                    continue;
                }
            };

            match search_stream(&mut file_handle, &mut out, &pattern, prefix.as_deref()) {
                Ok(m) => any_match = any_match || m,
                Err(e) => {
                    had_error = true;
                    let mut msg = file_bytes.to_vec();
                    msg.push(b':');
                    msg.push(b' ');
                    msg.extend_from_slice(e.to_string().as_bytes());
                    msg.push(b'\n');
                    eprint_bytes(&msg);
                }
            }
        }
    }

    let _ = out.flush();

    if had_error {
        std::process::exit(2);
    } else if any_match {
        std::process::exit(0);
    } else {
        std::process::exit(1);
    }
}
