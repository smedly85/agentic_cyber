fn join_path(base: &OsString, component: &OsString) -> OsString {
    let base_bytes: &[u8] = base.as_bytes();
    let comp_bytes: &[u8] = component.as_bytes();
    let mut result = Vec::with_capacity(base_bytes.len() + 1 + comp_bytes.len());
    if base_bytes.last() == Some(&b'/') {
        result.extend_from_slice(base_bytes);
    } else {
        result.extend_from_slice(base_bytes);
        result.push(b'/');
    }
    result.extend_from_slice(comp_bytes);
    OsString::from_vec(result)
}

fn traverse_dir<W: Write>(
    dir_path: &OsString,
    display_base: &OsString,
    pattern: &[u8],
    writer: &mut W,
    need_prefix: bool,
) -> (bool, bool) {
    let mut any_match = false;
    let mut had_error = false;

    let read_dir = match std::fs::read_dir(dir_path) {
        Ok(rd) => rd,
        Err(e) => {
            let mut msg = display_base.as_bytes().to_vec();
            msg.push(b':');
            msg.push(b' ');
            msg.extend_from_slice(e.to_string().as_bytes());
            msg.push(b'\n');
            eprint_bytes(&msg);
            return (false, true);
        }
    };

    let mut entries: Vec<OsString> = Vec::new();
    for entry in read_dir {
        match entry {
            Ok(e) => entries.push(e.file_name()),
            Err(e) => {
                had_error = true;
                let mut msg = display_base.as_bytes().to_vec();
                msg.push(b':');
                msg.push(b' ');
                msg.extend_from_slice(e.to_string().as_bytes());
                msg.push(b'\n');
                eprint_bytes(&msg);
            }
        }
    }

    entries.sort();

    for name in entries {
        let child_path = join_path(dir_path, &name);
        let child_display = join_path(display_base, &name);

        let file_type = match std::fs::symlink_metadata(&child_path) {
            Ok(m) => m.file_type(),
            Err(e) => {
                had_error = true;
                let mut msg = child_display.as_bytes().to_vec();
                msg.push(b':');
                msg.push(b' ');
                msg.extend_from_slice(e.to_string().as_bytes());
                msg.push(b'\n');
                eprint_bytes(&msg);
                continue;
            }
        };

        if file_type.is_symlink() {
            continue;
        }

        if file_type.is_dir() {
            let (m, e) = traverse_dir(&child_path, &child_display, pattern, writer, need_prefix);
            any_match = any_match || m;
            had_error = had_error || e;
        } else if file_type.is_file() {
            let prefix: Option<Vec<u8>> = if need_prefix {
                let mut p = child_display.as_bytes().to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };

            let mut file_handle = match std::fs::File::open(&child_path) {
                Ok(f) => f,
                Err(e) => {
                    had_error = true;
                    let mut msg = child_display.as_bytes().to_vec();
                    msg.push(b':');
                    msg.push(b' ');
                    msg.extend_from_slice(e.to_string().as_bytes());
                    msg.push(b'\n');
                    eprint_bytes(&msg);
                    continue;
                }
            };

            match search_stream(&mut file_handle, writer, pattern, prefix.as_deref()) {
                Ok(m) => any_match = any_match || m,
                Err(e) => {
                    had_error = true;
                    let mut msg = child_display.as_bytes().to_vec();
                    msg.push(b':');
                    msg.push(b' ');
                    msg.extend_from_slice(e.to_string().as_bytes());
                    msg.push(b'\n');
                    eprint_bytes(&msg);
                }
            }
        }
        // Skip other file types (FIFOs, sockets, devices, etc.)
    }

    (any_match, had_error)
}

