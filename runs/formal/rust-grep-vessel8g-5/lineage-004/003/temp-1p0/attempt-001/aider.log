fn traverse_dir<W: Write>(
    dir_path: &OsString,
    display_base: &OsString,
    pattern: &[u8],
    writer: &mut W,
    need_prefix: bool,
) -> (bool, bool) {
    let mut any_match = false;
    let mut had_error = false;
    
    let entries = match std::fs::read_dir(dir_path) {
        Ok(e) => e,
        Err(e) => {
            // diagnose
            let mut msg = display_base.to_vec(); // or file_bytes
            // ...
            return (false, true);
        }
    };
    
    // Collect and sort entries
    let mut names: Vec<(OsString, std::fs::DirEntry)> = Vec::new();
    for entry in entries {
        match entry {
            Ok(e) => names.push((e.file_name(), e)),
            Err(_) => had_error = true,
        }
    }
    
    names.sort_by(|a, b| a.0.as_bytes().cmp(b.0.as_bytes()));
    
    for (name, _entry) in names {
        let child_path = join_path(dir_path, &name);
        let child_display = join_path(display_base, &name);
        
        // Check if symlink (using symlink_metadata = lstat)
        let symlink_meta = match std::fs::symlink_metadata(&child_path) {
            Ok(m) => m,
            Err(_) => { had_error = true; continue; }
        };
        
        if symlink_meta.file_type().is_symlink() {
            continue; // skip symlinks during traversal
        }
        
        if symlink_meta.is_dir() {
            let (m, e) = traverse_dir(&child_path, &child_display, pattern, writer, need_prefix);
            any_match = any_match || m;
            had_error = had_error || e;
        } else if symlink_meta.is_file() {
            let prefix = if need_prefix {
                Some(join_path(&child_display, &name)) // wait, no
            } else {
                None
            };
            
            // Actually, child_display IS the full display path
            let prefix = if need_prefix {
                let mut p = child_display.as_bytes().to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };
            
            let mut file_handle = match std::fs::File::open(&child_path) {
                Ok(f) => f,
                Err(e) => {
                    had_error = true;
                    // diagnose
                    continue;
                }
            };
            
            match search_stream(&mut file_handle, writer, pattern, prefix.as_deref()) {
                Ok(m) => any_match = any_match || m,
                Err(e) => {
                    had_error = true;
                    // diagnose
                }
            }
        }
        // else: skip (fifos, sockets, devices, etc.)
    }
    
    (any_match, had_error)
}
```

