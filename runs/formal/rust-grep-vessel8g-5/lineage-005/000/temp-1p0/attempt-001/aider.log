                Err(e) => {
                    eprintln!("rust_grep: {}: {}", file.to_string_lossy(), e);
                    any_error = true;
                }
            }
        }
    }
    
    // Flush output
    if let Err(_) = out.flush() {
        any_error = true;
    }
    
    if any_error {
        process::exit(2);
    } else if any_match {
        process::exit(0);
    } else {
        process::exit(1);
    }
}
