use std::ffi::OsString;
use std::fs::File;
use std::io::{self, Read, Write, BufReader, BufWriter};
use std::process;

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    
    // Parse arguments
    let mut pattern: Option<OsString> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut end_of_options = false;
    
    for arg in &args {
        if !end_of_options && arg == "--" {
            end_of_options = true;
            continue;
        }
        if !end_of_options && pattern.is_none() && is_unsupported_option(arg) {
            eprint_usage(arg);
            process::exit(2);
        }
        if pattern.is_none() {
            pattern = Some(arg.clone());
        } else {
            files.push(arg.clone());
        }
    }
    
    let pattern = match pattern {
        Some(p) => p,
        None => {
            eprint_usage(None);
            process::exit(2);
        }
    };
    
    // Convert pattern to bytes
    let pattern_bytes: Vec<u8> = os_string_to_bytes(&pattern);
    
    let mut any_match = false;
    let mut any_error = false;
    
    let stdout = io::stdout();
    let mut out = BufWriter::new(stdout.lock());
    
    if files.is_empty() {
        // Search stdin
        let stdin = io::stdin();
        let mut reader = BufReader::new(stdin.lock());
        match search_stream(&pattern_bytes, &mut reader, &mut out) {
            Ok(matched) => { any_match = matched; }
            Err(_) => { any_error = true; }
        }
    } else {
        let multi = files.len() >= 2;
        for file in &files {
            let file_bytes = os_string_to_bytes(file);
            match File::open(file) {
                Ok(f) => {
                    // Check if it's a directory
                    let metadata = match f.metadata() {
                        Ok(m) => m,
                        Err(_) => { any_error = true; continue; }
                    };
                    if metadata.is_dir() {
                        eprintln!("rust_grep: {}: Is a directory", file.to_string_lossy());
                        any_error = true;
                        continue;
