```rust
fn recursive_traverse(
    root: &[u8],
    pattern: &[u8],
    output: &mut BufWriter<io::StdoutLock>,
    use_prefix: bool,
) -> (bool, bool) {
    // returns (matched_any, any_error)
    let mut matched_any = false;
    let mut any_error = false;
    
    // Work stack: (path_bytes, is_dir)
    // We push in reverse order for LIFO to process in ascending order
    let mut stack: Vec<(Vec<u8>, bool)> = Vec::new();
    stack.push((root.to_vec(), true)); // root is a directory
    
    while let Some((path, is_dir)) = stack.pop() {
        if is_dir {
            let entries = match fs::read_dir(std::ffi::OsStr::from_bytes(&path)) {
                Ok(d) => d,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", String::from_utf8_lossy(&path), e);
                    any_error = true;
                    continue;
                }
            };
            
            // Collect entries with their names
            let mut entry_list: Vec<(Vec<u8>, fs::DirEntry)> = Vec::new();
            for entry in entries {
                match entry {
                    Ok(e) => {
                        let name = e.file_name().as_bytes().to_vec();
                        entry_list.push((name, e));
                    }
                    Err(e) => {
                        eprintln!("rust_grep: {}: {}", String::from_utf8_lossy(&path), e);
                        any_error = true;
                    }
                }
            }
            
            // Sort by raw bytes ascending
            entry_list.sort_by(|a, b| a.0.cmp(&b.0));
            
            // Push in reverse order onto the stack
            for (name, entry) in entry_list.iter().rev() {
                let sm = match entry.symlink_metadata() {
                    Ok(m) => m,
                    Err(_) => continue,
                };
                
                if sm.file_type().is_symlink() {
                    continue; // skip symlinks in traversal
                }
                
                if sm.is_dir() {
                    let child_path = join_path(&path, name);
                    stack.push((child_path, true));
                } else if sm.is_file() {
                    let child_path = join_path(&path, name);
                    stack.push((child_path, false));
                }
                // else: skip other types (sockets, fifos, etc.)
            }
        } else {
            // It's a file to search
            let file = match File::open(std::ffi::OsStr::from_bytes(&path)) {
                Ok(f) => f,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", String::from_utf8_lossy(&path), e);
                    any_error = true;
                    continue;
                }
            };
            
            let mut reader = BufReader::new(file);
            let prefix = if use_prefix {
                let mut p = path.clone();
                p.push(b':');
                Some(p)
            } else {
                None
            };
            
            match search_stream(pattern, reader, output, prefix.as_deref()) {
                Ok(m) => { if m { matched_any = true; } }
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", String::from_utf8_lossy(&path), e);
                    any_error = true;
                }
            }
        }
    }
    
    (matched_any, any_error)
}
```

