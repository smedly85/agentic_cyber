### 3. Add `recursive_traverse` function (place it before `main`)

```rust
fn recursive_traverse(
    root: &[u8],
    pattern: &[u8],
    output: &mut impl Write,
    use_prefix: bool,
) -> (bool, bool) {
    let mut matched_any = false;
    let mut any_error = false;

    // Work stack: (path_bytes, is_directory)
    // LIFO: push children in reverse so they pop in ascending order (pre-order)
    let mut stack: Vec<(Vec<u8>, bool)> = Vec::new();
    stack.push((root.to_vec(), true));

    while let Some((path, is_dir)) = stack.pop() {
        if is_dir {
            let os_path = OsString::from_vec(path.clone());
            let dir = match fs::read_dir(&os_path) {
                Ok(d) => d,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", os_path.to_string_lossy(), e);
                    any_error = true;
                    continue;
                }
            };

            let mut entry_list: Vec<(Vec<u8>, fs::DirEntry)> = Vec::new();
            for entry in dir {
                match entry {
                    Ok(e) => {
                        let name = e.file_name().as_bytes().to_vec();
                        entry_list.push((name, e));
                    }
                    Err(e) => {
                        eprintln!("rust_grep: {}: {}", os_path.to_string_lossy(), e);
                        any_error = true;
                    }
                }
            }

            entry_list.sort_by(|a, b| a.0.cmp(&b.0));

            // Push in reverse so first entry is popped first (pre-order)
            for (name, entry) in entry_list.iter().rev() {
                let sm = match entry.symlink_metadata() {
                    Ok(m) => m,
                    Err(e) => {
                        let child = join_path(&path, name);
                        let os_child = OsString::from_vec(child.clone());
                        eprintln!("rust_grep: {}: {}", os_child.to_string_lossy(), e);
                        any_error = true;
                        continue;
                    }
                };

                if sm.file_type().is_symlink() {
                    continue;
                }

                let child_path = join_path(&path, name);
                if sm.is_dir() {
                    stack.push((child_path, true));
                } else if sm.is_file() {
                    stack.push((child_path, false));
                }
            }
        } else {
            let os_path = OsString::from_vec(path.clone());
            let file = match File::open(&os_path) {
                Ok(f) => f,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", os_path.to_string_lossy(), e);
                    any_error = true;
                    continue;
                }
            };

            let mut reader = BufReader::new(file);
            let prefix: Option<Vec<u8>> = if use_prefix {
                let mut p = path.clone();
                p.push(b':');
                Some(p)
            } else {
                None
            };

            match search_stream(pattern, reader, output, prefix.as_deref()) {
                Ok(m) => {
                    if m {
                        matched_any = true;
                    }
                }
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", os_path.to_string_lossy(), e);
                    any_error = true;
                }
            }
        }
    }

    (matched_any, any_error)
}
```

