fn join_path(base: &[u8], name: &[u8]) -> Vec<u8> {
    let mut result = Vec::with_capacity(base.len() + 1 + name.len());
    result.extend_from_slice(base);
    if !base.is_empty() && base[base.len()-1] != b'/' {
        result.push(b'/');
    }
    result.extend_from_slice(name);
    result
}
```

