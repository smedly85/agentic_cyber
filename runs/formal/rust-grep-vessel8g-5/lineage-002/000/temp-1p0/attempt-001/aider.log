Let me write the full implementation:

```rust
use std::env;
use std::ffi::OsString;
use std::fs::File;
use std::io::{self, Read, Write, BufReader, StdoutLock};
use std::os::unix::ffi::OsStrExt;
use std::process;

fn contains_substring(haystack: &[u8], needle: &[u8]) -> bool {
    if needle.is_empty() {
        return true;
    }
    if needle.len() > haystack.len() {
        return false;
    }
    haystack.windows(needle.len()).any(|w| w == needle)
}

fn search_stream(
    pattern: &[u8],
    input: &mut impl Read,
    output: &mut impl Write,
    prefix: Option<&[u8]>,
) -> io::Result<bool> {
    let mut any_selected = false;
    let mut line_buf = Vec::new();
    
    loop {
        line_buf.clear();
        let n = input.read_until(b'\n', &mut line_buf)?;
        if n == 0 {
            break;
        }
        
        let match_content = if line_buf.ends_with(&[b'\n']) {
            &line_buf[..line_buf.len() - 1]
        } else {
            &line_buf[..]
        };
        
        if contains_substring(match_content, pattern) {
            if let Some(prefix) = prefix {
                output.write_all(prefix)?;
            }
            output.write_all(match_content)?;
            output.write_all(b"\n")?;
            any_selected = true;
        }
    }
    
    Ok(any_selected)
}

fn main() {
    let args: Vec<OsString> = env::args_os().collect();
    
    // Parse arguments
    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args[1..] {
        if !after_ddash {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                eprint_bytes_usage();
                process::exit(2);
            }
        }
        if !after_ddash && arg.as_bytes() == b"--" {
            after_ddash = true;
            continue;
        }
        if pattern.is_none() {
            pattern = Some(arg.as_bytes().to_vec());
        } else {
            files.push(arg.clone());
        }
    }
    
    let pattern = match pattern {
        Some(p) => p,
        None => {
            eprint_bytes_usage();
            process::exit(2);
        }
    };
    
    let mut stdout = io::stdout();
    let mut any_selected = false;
    let mut had_error = false;
    
    if files.is_empty() {
        // Search stdin
        let stdin = io::stdin();
        let mut reader = BufReader::new(stdin.lock());
        match search_stream(&pattern, &mut reader, &mut stdout, None) {
            Ok(selected) => {
                any_selected = selected;
            }
            Err(_) => {
                had_error = true;
            }
        }
    } else {
        // Search files
        let need_prefix = files.len() >= 2;
        for file_path in &files {
            let file = match File::open(file_path) {
                Ok(f) => f,
                Err(e) => {
                    // Diagnose by name
                    eprint_file_error(file_path, &e.to_string());
                    had_error = true;
                    continue;
                }
            };
            
            // Check if it's a directory
            let metadata = match file.metadata() {
                Ok(m) => m,
                Err(_) => {
                    eprint_file_error(file_path, "cannot stat");
                    had_error = true;
                    continue;
                }
            };
            
            if metadata.is_dir() {
                eprint_file_error(file_path, "is a directory");
                had_error = true;
                continue;
            }
            
            let mut reader = BufReader::new(file);
            
            let prefix: Option<Vec<u8>> = if need_prefix {
                let mut p = file_path.as_bytes().to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };
            
            match search_stream(&pattern, &mut reader, &mut stdout, prefix.as_deref()) {
                Ok(selected) => {
                    if selected {
                        any_selected = true;
                    }
                }
                Err(_) => {
                    had_error = true;
                }
            }
        }
    }
    
    // Flush stdout
    let _ = stdout.flush();
    
    if had_error {
        process::exit(2);
    } else if any_selected {
        process::exit(0);
    } else {
        process::exit(1);
    }
}

fn eprint_bytes_usage() {
    // Write usage to stderr as bytes (handles arbitrary encoding)
    let msg = b"rust_grep: usage: rust_grep PATTERN [FILE...]\n";
    let mut stderr = io::stderr();
    let _ = stderr.write_all(msg);
    let _ = stderr.flush();
}

fn eprint_file_error(path: &OsString, msg: &str) {
    let mut stderr = io::stderr();
