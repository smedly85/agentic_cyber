fn search_stream(
    pattern: &[u8],
    input: &mut dyn Read,
    output: &mut dyn Write,
    prefix: Option<&[u8]>,
) -> io::Result<bool> {
    let mut any_selected = false;
    let mut line_buf = Vec::new();
    
    loop {
        // Read a line (up to and including \n, or remaining bytes)
        line_buf.clear();
        let n = input.read_until(b'\n', &mut line_buf)?;
        if n == 0 {
            break;
        }
        
        // Strip trailing \n for matching
        let match_content = if line_buf.ends_with(&[b'\n']) {
            &line_buf[..line_buf.len() - 1]
