    let _ = err.write_all(msg.as_bytes());
    let _ = err.write_all(b"\n");
    let _ = err.flush();
}

fn main() {
    let args: Vec<OsString> = env::args_os().collect();

    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut after_ddash = false;

    for arg in args.iter().skip(1) {
        if !after_ddash {
            let b = arg.as_bytes();
            if b == b"--" {
                after_ddash = true;
                continue;
            }
            if b.len() > 1 && b[0] == b'-' {
                usage_exit();
            }
        }
        if pattern.is_none() {
            pattern = Some(arg.as_bytes().to_vec());
        } else {
            files.push(arg.clone());
        }
    }

    let pattern = match pattern {
        Some(p) => p,
        None => usage_exit(),
    };

    let stdout = io::stdout();
    let mut out = stdout.lock();
    let mut any_selected = false;
    let mut had_error = false;

    if files.is_empty() {
        let stdin = io::stdin();
        let mut reader = BufReader::new(stdin.lock());
        match search_stream(&pattern, &mut reader, &mut out, None) {
            Ok(s) => any_selected = s,
            Err(_) => had_error = true,
        }
    } else {
        let need_prefix = files.len() >= 2;
        for path in &files {
            let file = match File::open(path) {
                Ok(f) => f,
                Err(_) => {
                    file_diagnostic(path, "cannot open");
                    had_error = true;
                    continue;
                }
            };
            let meta = match file.metadata() {
                Ok(m) => m,
                Err(_) => {
                    file_diagnostic(path, "cannot stat");
                    had_error = true;
                    continue;
                }
            };
            if meta.is_dir() {
                file_diagnostic(path, "is a directory");
                had_error = true;
                continue;
            }
            let mut reader = BufReader::new(file);
            let prefix = if need_prefix {
                let mut p = path.as_bytes().to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };
            match search_stream(&pattern, &mut reader, &mut out, prefix.as_deref()) {
                Ok(s) => {
                    if s {
                        any_selected = true;
                    }
                }
                Err(_) => had_error = true,
            }
        }
    }

    let _ = out.flush();

    if had_error {
        process::exit(2);
    } else if any_selected {
        process::exit(0);
    } else {
        process::exit(1);
    }
}
