        if contains_substring(match_content, pattern) {
            if let Some(prefix) = prefix {
                output.write_all(prefix)?;
            }
            output.write_all(match_content)?;
            output.write_all(b"\n")?;
            any_selected = true;
        }
    }
    
    Ok(any_selected)
}
