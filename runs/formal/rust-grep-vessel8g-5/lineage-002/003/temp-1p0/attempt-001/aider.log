```rust
use std::ffi::OsString;
use std::fs::{self, File};
use std::io::{self, BufReader, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::path::Path;
use std::process;

/// Core line-selection: read lines from `reader`, emit those containing `pattern`
/// to `out`, with optional prefix. Returns true if any line was selected.
fn search_stream(
    reader: &mut dyn Read,
    pattern: &[u8],
    out: &mut dyn Write,
    prefix: Option<&OsString>,
) -> io::Result<bool> {
    let mut found = false;
    let mut buf = [0u8; 8192];
    let mut line: Vec<u8> = Vec::new();

    loop {
        let n = reader.read(&mut buf)?;
        if n == 0 {
            // EOF: emit the final unterminated line if non-empty
            if !line.is_empty() {
                if matches_line(&line, pattern) {
                    emit_line(out, prefix, &line)?;
                    found = true;
                }
                line.clear();
            }
            break;
        }
        for &b in &buf[..n] {
            if b == 0x0A {
                if matches_line(&line, pattern) {
                    emit_line(out, prefix, &line)?;
                    found = true;
                }
                line.clear();
            } else {
                line.push(b);
            }
        }
    }

    Ok(found)
}

fn matches_line(line: &[u8], pattern: &[u8]) -> bool {
    if pattern.is_empty() {
        return true;
    }
    if pattern.len() > line.len() {
        return false;
    }
    line.windows(pattern.len()).any(|w| w == pattern)
}

fn emit_line(out: &mut dyn Write, prefix: Option<&OsString>, line: &[u8]) -> io::Result<()> {
    if let Some(p) = prefix {
        out.write_all(p.as_bytes())?;
        out.write_all(b":")?;
    }
    out.write_all(line)?;
    out.write_all(b"\n")?;
    Ok(())
}
```

