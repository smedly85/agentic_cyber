fn main() {
    let args: Vec<OsString> = std::env::args_os().collect();
    let mut pattern: Option<OsString> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut with_filename: Option<bool> = None;
    let mut recursive: bool = false;
    let mut after_ddash: bool = false;
    let mut pattern_set: bool = false;

    let mut i = 1;
    while i < args.len() {
        let arg = &args[i];
        
        if after_ddash {
            if !pattern_set {
                pattern = Some(arg.clone());
                pattern_set = true;
            } else {
                files.push(arg.clone());
            }
            i += 1;
            continue;
        }
        
        let bytes = arg.as_bytes();
        
        if bytes == b"--" {
            after_ddash = true;
            i += 1;
            continue;
        }
        
        if bytes.len() > 1 && bytes[0] == b'-' {
            if bytes.len() > 2 && bytes[1] == b'-' {
                // Long option
                let opt = &bytes[2..];
                match opt {
                    b"with-filename" => { with_filename = Some(true); }
                    b"no-filename" => { with_filename = Some(false); }
                    b"recursive" => { recursive = true; }
                    _ => {
                        eprintln!("rust_grep: unsupported option: --{}", String::from_utf8_lossy(opt));
                        process::exit(2);
                    }
                }
            } else {
                // Short option(s), possibly clustered
                let mut j = 1;
                while j < bytes.len() {
                    match bytes[j] {
                        b'H' => { with_filename = Some(true); }
                        b'h' => { with_filename = Some(false); }
                        b'r' => { recursive = true; }
                        _ => {
                            eprintln!("rust_grep: unsupported option: -{}", String::from_utf8_lossy(&bytes[j..j+1]));
                            process::exit(2);
                        }
                    }
                    j += 1;
                }
