```rust
fn traverse_dir(
    dir: &Path,
    out_files: &mut Vec<OsString>,
    had_error: &mut bool,
) {
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(_) => {
            eprintln!("rust_grep: {}: cannot read directory", dir.to_string_lossy());
            *had_error = true;
            return;
        }
    };
    
    // Collect entries and sort by raw byte order
    let mut entries_vec: Vec<OsString> = Vec::new();
    for entry in entries.flatten() {
        entries_vec.push(entry.file_name());
    }
    entries_vec.sort(); // OsString sorts by byte order on Unix
    
    for name in entries_vec {
        let full = dir.join(&name);
        let meta = match fs::symlink_metadata(&full) {
            Ok(m) => m,
            Err(_) => {
                eprintln!("rust_grep: {}: cannot stat", full.to_string_lossy());
                *had_error = true;
                continue;
            }
        };
        
        if meta.file_type().is_symlink() {
            continue; // skip symlinks during traversal
        }
        
        if meta.is_dir() {
            traverse_dir(&full, out_files, had_error);
        } else if meta.is_file() {
            out_files.push(full);
        }
        // else: skip (fifo, socket, device, etc.)
    }
}
```

