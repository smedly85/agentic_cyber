```rust
fn traverse_recursive(
    dir_path: &OsString,
    pattern: &[u8],
    out: &mut dyn Write,
    need_prefix: bool,
) -> (bool, bool) {
    // Returns (any_selected, had_error)
    let read_result = std::fs::read_dir(dir_path);
    let mut any_selected = false;
    let mut had_error = false;

    let dir_iter = match read_result {
        Ok(d) => d,
        Err(_) => {
            file_diagnostic(dir_path, "cannot read directory");
            return (false, true);
        }
    };

    let mut entries: Vec<(OsString, OsString)> = Vec::new();
    for entry in dir_iter {
        match entry {
            Ok(e) => {
                let name = e.file_name();
                let full = join_path(dir_path, &name);
                entries.push((name, full));
            }
            Err(_) => {
                had_error = true;
            }
        }
    }

    // Sort by raw bytes ascending
    entries.sort_by(|a, b| a.0.as_bytes().cmp(b.0.as_bytes()));

    for (_name, full_path) in entries {
        let sym_meta = match std::fs::symlink_metadata(&full_path) {
            Ok(m) => m,
            Err(_) => {
                file_diagnostic(&full_path, "cannot stat");
                had_error = true;
                continue;
            }
        };

        if sym_meta.file_type().is_symlink() {
            continue;
        }

        if sym_meta.is_dir() {
            let (sel, err) = traverse_recursive(&full_path, pattern, out, need_prefix);
            if sel {
                any_selected = true;
            }
            if err {
                had_error = true;
            }
        } else if sym_meta.is_file() {
            let file = match File::open(&full_path) {
                Ok(f) => f,
                Err(_) => {
                    file_diagnostic(&full_path, "cannot open");
                    had_error = true;
                    continue;
                }
            };
            let prefix = if need_prefix {
                let mut p = full_path.as_bytes().to_vec();
                p.push(b':');
                Some(p)
            } else {
                None
            };
            let mut reader = BufReader::new(file);
            match search_stream(pattern, &mut reader, out, prefix.as_deref()) {
                Ok(s) => {
                    if s {
                        any_selected = true;
                    }
                }
                Err(_) => had_error = true,
            }
        }
        // Non-regular, non-directory, non-symlink (fifo, socket, device): skip silently
    }

    (any_selected, had_error)
}
```

