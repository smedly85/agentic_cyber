use std::ffi::OsString;
use std::fs::{self, File};
use std::io::{self, BufReader, Read, Write};
use std::os::unix::ffi::{OsStrExt, OsStringExt};
use std::path::Path;
use std::process;

/// Core line-selection: read lines from `reader`, emit those containing `pattern`
/// to `out`, with optional prefix. Returns true if any line was selected.
fn search_stream(
    reader: &mut dyn Read,
    pattern: &[u8],
    out: &mut dyn Write,
    prefix: Option<&OsString>,
) -> io::Result<bool> {
    let mut found = false;
    let mut buf = [0u8; 8192];
    let mut line: Vec<u8> = Vec::new();
    
    loop {
        let n = reader.read(&mut buf)?;
        if n == 0 {
            // EOF: emit the last unterminated line if non-empty
            if !line.is_empty() {
                if pattern.is_empty() || line.windows(pattern.len()).any(|w| w == pattern) {
                    if let Some(p) = prefix {
                        out.write_all(p.as_bytes())?;
                        out.write_all(b":")?;
                    }
                    out.write_all(&line)?;
                    out.write_all(b"\n")?;
                    found = true;
                }
                line.clear();
            }
            break;
        }
        for &b in &buf[..n] {
            if b == b'\n' {
                // Process the complete line
                if pattern.is_empty() || line.windows(pattern.len()).any(|w| w == pattern) {
                    if let Some(p) = prefix {
                        out.write_all(p.as_bytes())?;
                        out.write_all(b":")?;
                    }
                    out.write_all(&line)?;
                    out.write_all(b"\n")?;
                    found = true;
                }
                line.clear();
            } else {
                line.push(b);
            }
