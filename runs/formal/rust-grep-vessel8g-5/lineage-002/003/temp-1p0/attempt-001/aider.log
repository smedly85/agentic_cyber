use std::env;
use std::ffi::OsString;
use std::fs::File;
use std::io::{self, BufReader, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::process;

fn contains_substring(haystack: &[u8], needle: &[u8]) -> bool {
    if needle.is_empty() {
        return true;
    }
    if needle.len() > haystack.len() {
        return false;
    }
    haystack.windows(needle.len()).any(|w| w == needle)
}

fn read_line(input: &mut dyn Read, buf: &mut Vec<u8>) -> io::Result<usize> {
    let mut byte_buf = [0u8; 1];
    loop {
        let n = input.read(&mut byte_buf)?;
        if n == 0 {
            return Ok(buf.len());
        }
        buf.push(byte_buf[0]);
        if byte_buf[0] == b'\n' {
            return Ok(buf.len());
        }
    }
}

fn join_path(dir: &OsString, name: &OsString) -> OsString {
    let dir_bytes = dir.as_bytes();
    let name_bytes = name.as_bytes();
    let mut result = Vec::with_capacity(dir_bytes.len() + 1 + name_bytes.len());
    result.extend_from_slice(dir_bytes);
    if !dir_bytes.is_empty() && dir_bytes[dir_bytes.len() - 1] != b'/' {
        result.push(b'/');
    }
    result.extend_from_slice(name_bytes);
    OsString::from_vec(result)
}

fn search_stream(
    pattern: &[u8],
    input: &mut dyn Read,
    output: &mut dyn Write,
    prefix: Option<&[u8]>,
) -> io::Result<bool> {
    let mut any_selected = false;
    let mut line_buf: Vec<u8> = Vec::new();

    loop {
        line_buf.clear();
        let n = read_line(input, &mut line_buf)?;
        if n == 0 {
            break;
        }
        let content = if line_buf[n - 1] == b'\n' {
            &line_buf[..n - 1]
        } else {
            &line_buf[..n]
        };
        if contains_substring(content, pattern) {
            if let Some(p) = prefix {
                output.write_all(p)?;
            }
            output.write_all(content)?;
            output.write_all(b"\n")?;
            any_selected = true;
        }
    }

    Ok(any_selected)
}

fn traverse_recursive(
    dir_path: &OsString,
    pattern: &[u8],
    out: &mut dyn Write,
    need_prefix: bool,
) -> (bool, bool) {
    // Returns (any_selected, had_error)
    let read_result = std::fs::read_dir(dir_path);
    let mut any_selected = false;
    let mut had_error = false;

    let dir_iter = match read_result {
        Ok(d) => d,
        Err(_) => {
            file_diagnostic(dir_path, "cannot read directory");
            return (false, true);
        }
    };

    let mut entries: Vec<(OsString, OsString)> = Vec::new();
    for entry in dir_iter {
        match entry {
            Ok(e) => {
                let name = e.file_name();
                let full = join_path(dir_path, &name);
                entries.push((name, full));
            }
            Err(_) => {
                had_error = true;
            }
        }
    }

    // Sort by raw bytes ascending
    entries.sort_by(|a, b| a.0.as_bytes().cmp(b.0.as_bytes()));

    for (_name, full_path) in entries {
        let sym_meta = match std::fs::symlink_metadata(&full_path) {
            Ok(m) => m,
            Err(_) => {
                file_diagnostic(&full_path, "cannot stat");
                had_error = true;
                continue;
            }
        };

