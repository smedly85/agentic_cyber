```rust
fn traverse_dir(
    dir_path: &OsString,
    pattern: &[u8],
    ci: bool,
    prefix_base: Option<&OsString>,
    out: &mut impl Write,
    err: &mut impl Write,
    found: &mut bool,
    had_error: &mut bool,
) -> io::Result<()> {
    let entries = fs::read_dir(dir_path)?;
    let mut names: Vec<OsString> = Vec::new();
    for entry in entries {
        match entry {
            Ok(e) => names.push(e.file_name()),
            Err(e) => {
                eprintln!("rust_grep: error reading directory entry: {}", e);
                *had_error = true;
            }
        }
    }
    names.sort(); // raw byte sort on Unix
    
    for name in names {
        let full_path = join_path(dir_path, &name);
        // Check if symlink
        let meta = match fs::symlink_metadata(&full_path) {
            Ok(m) => m,
            Err(e) => {
                eprintln!("rust_grep: {}: {}", display_path(&full_path), e);
                *had_error = true;
                continue;
            }
        };
        
        if meta.file_type().is_symlink() {
            // Skip symlinks during traversal
            continue;
        }
        
        if meta.is_dir() {
            traverse_dir(&full_path, pattern, ci, prefix_base, out, err, found, had_error)?;
        } else if meta.is_file() {
            search_file(&full_path, pattern, ci, prefix_base, out, err, found, had_error);
        }
        // else: skip (fifo, socket, etc.)
    }
    Ok(())
}
```

