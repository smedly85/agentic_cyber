```rust
fn join_path(parent: &OsString, child: &OsString) -> OsString {
    let parent_bytes = parent.as_bytes();
    let child_bytes = child.as_bytes();
    let mut result = Vec::with_capacity(parent_bytes.len() + 1 + child_bytes.len());
    result.extend_from_slice(parent_bytes);
    if !parent_bytes.is_empty() && *parent_bytes.last().unwrap() != b'/' {
        result.push(b'/');
    }
    result.extend_from_slice(child_bytes);
    OsString::from_vec(result)
}
```

