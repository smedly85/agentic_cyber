```rust
use std::env;
use std::ffi::{OsStr, OsString};
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::MetadataExt;
use std::path::Path;

fn fold_byte(b: u8) -> u8 {
    if (0x41..=0x5A).contains(&b) { b + 0x20 } else { b }
}

fn bytes_ci_equal(a: &[u8], b: &[u8], ci: bool) -> bool {
    if a.len() != b.len() {
        return false;
    }
    if !ci {
        return a == b;
    }
    for (&x, &y) in a.iter().zip(b.iter()) {
        let fx = fold_byte(x);
        let fy = fold_byte(y);
        if fx != fy {
            return false;
        }
    }
    true
}

fn line_contains_pattern(line: &[u8], pattern: &[u8], ci: bool) -> bool {
    if pattern.is_empty() {
        return true;
    }
    if line.len() < pattern.len() {
        return false;
    }
    if !ci {
        return line.windows(pattern.len()).any(|w| w == pattern);
    }
    let folded_pattern: Vec<u8> = pattern.iter().map(&fold_byte).collect();
    for window in line.windows(pattern.len()) {
        let mut match_found = true;
        for (i, &b) in window.iter().enumerate() {
            if fold_byte(b) != folded_pattern[i] {
                match_found = false;
                break;
            }
        }
        if match_found {
            return true;
        }
    }
    false
}

fn search_stream<R: Read>(
    reader: &mut R,
    pattern: &[u8],
    ci: bool,
    prefix: Option<&[u8]>,
    out: &mut impl Write,
) -> io::Result<bool> {
    let mut buf = Vec::with_capacity(8192);
    let mut line = Vec::new();
    let mut found = false;
    
    loop {
        buf.clear();
        let n = reader.read(&mut buf)?;
        if n == 0 {
            // Process remaining line if non-empty (final unterminated line)
            if !line.is_empty() {
                if line_contains_pattern(&line, pattern, ci) {
                    emit_line(out, prefix, &line)?;
                    found = true;
                }
                line.clear();
            }
            break;
        }
        for &byte in buf.iter() {
            if byte == 0x0A {
                if line_contains_pattern(&line, pattern, ci) {
                    emit_line(out, prefix, &line)?;
                    found = true;
                }
                line.clear();
            } else {
                line.push(byte);
            }
        }
    }
    Ok(found)
}
```

