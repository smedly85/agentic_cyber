    let mut names: Vec<OsString> = Vec::new();
    for entry in entries {
        match entry {
            Ok(e) => names.push(e.file_name()),
            Err(e) => {
                eprintln!("rust_grep: {}: {}", display_os(dir), e);
                *had_error = true;
            }
        }
    }
    names.sort(); // Lexicographic byte order on Unix
    
    for name in &names {
        let full = join_os(dir, name);
        let meta = match fs::symlink_metadata(&full) {
            Ok(m) => m,
            Err(e) => {
                eprintln!("rust_grep: {}: {}", display_os(&full), e);
                *had_error = true;
                continue;
            }
        };
        
        if meta.file_type().is_symlink() {
            continue;
        }
        
        if meta.is_dir() {
            let child_prefix: Option<Vec<u8>> = current_prefix.map(|p| {
                let mut v = p.to_vec();
                if !v.is_empty() && v.last().unwrap() != b'/' {
                    v.push(b'/');
                }
                v.extend_from_slice(name.as_bytes());
                v
            });
            recursive_traverse(
                &full, pattern, ci,
                child_prefix.as_deref(),
                out, found, had_error,
            );
        } else if meta.is_file() {
            let file = match fs::File::open(&full) {
                Ok(f) => f,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", display_os(&full), e);
                    *had_error = true;
                    continue;
                }
            };
            let prefix: Option<Vec<u8>> = current_prefix.map(|p| p.to_vec());
            match search_stream(&mut file, pattern, ci, prefix.as_deref(), out) {
                Ok(f) => { *found = *found || f; }
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", display_os(&full), e);
                    *had_error = true;
                }
            }
        }
        // else: skip (fifo, socket, device, etc.)
    }
}
