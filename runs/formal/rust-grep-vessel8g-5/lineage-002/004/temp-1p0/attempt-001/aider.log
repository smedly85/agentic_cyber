                    }
                }
            }
            continue;
        }

        if pattern.is_none() {
            pattern = Some(bytes.to_vec());
        } else {
            files.push(arg.clone());
        }
    }

    let pattern = match pattern {
        Some(p) => p,
        None => {
            eprintln!("rust_grep: missing PATTERN");
            std::process::exit(2);
        }
    };

    let mut out = io::stdout();
    let mut found_any = false;
    let mut had_error = false;

    if files.is_empty() {
        let prefix: Option<Vec<u8>> = match filename_mode {
            FilenameMode::With => Some(b"(standard input)".to_vec()),
            _ => None,
        };
        let stdin = io::stdin();
        let mut stdin_lock = stdin.lock();
        match search_stream(
            &mut stdin_lock,
            &pattern,
            ignore_case,
            prefix.as_deref(),
            &mut out,
        ) {
            Ok(f) => found_any = f,
            Err(_) => had_error = true,
        }
    } else {
        let use_prefix = match filename_mode {
            FilenameMode::With => true,
            FilenameMode::Without => false,
            FilenameMode::Default => {
                if files.len() >= 2 {
                    true
                } else {
                    files.iter().any(|f| Path::new(f).is_dir())
                }
            }
        };

        for file in &files {
            let path = Path::new(file);

            let file_meta = match fs::symlink_metadata(path) {
                Ok(m) => m,
                Err(_) => {
                    eprintln!(
                        "rust_grep: {}: No such file or directory",
                        display_os(file)
                    );
                    had_error = true;
                    continue;
                }
            };

            if file_meta.is_dir() {
                if !recursive {
                    eprintln!("rust_grep: {}: Is a directory", display_os(file));
                    had_error = true;
                    continue;
                }
                let normalized = normalize_operand(file);
                recursive_traverse(
                    &normalized,
                    &pattern,
                    ignore_case,
                    use_prefix,
                    &mut out,
                    &mut found_any,
                    &mut had_error,
                );
                continue;
            }

            if file_meta.file_type().is_symlink() {
                let target_meta = match fs::metadata(path) {
                    Ok(m) => m,
                    Err(_) => {
                        eprintln!(
                            "rust_grep: {}: No such file or directory",
                            display_os(file)
                        );
                        had_error = true;
                        continue;
                    }
                };
                if target_meta.is_dir() {
                    if !recursive {
                        eprintln!(
                            "rust_grep: {}: Is a directory",
                            display_os(file)
                        );
                        had_error = true;
                        continue;
                    }
                    let normalized = normalize_operand(file);
                    recursive_traverse(
                        &normalized,
                        &pattern,
                        ignore_case,
                        use_prefix,
                        &mut out,
                        &mut found_any,
                        &mut had_error,
                    );
                    continue;
                }
            }

            let mut file_handle = match fs::File::open(path) {
                Ok(f) => f,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", display_os(file), e);
                    had_error = true;
                    continue;
                }
            };
            let prefix: Option<Vec<u8>> = if use_prefix {
                Some(file.as_bytes().to_vec())
            } else {
                None
            };
            match search_stream(
                &mut file_handle,
                &pattern,
                ignore_case,
                prefix.as_deref(),
                &mut out,
            ) {
                Ok(f) => found_any = found_any || f,
                Err(e) => {
                    eprintln!("rust_grep: {}: {}", display_os(file), e);
                    had_error = true;
                }
            }
        }
    }

    let exit_code = if had_error {
        2
    } else if found_any {
        0
    } else {
        1
    };
    std::process::exit(exit_code);
}
