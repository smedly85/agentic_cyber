Let me now write the complete implementation. This is going to be substantial.

```rust
use std::env;
use std::ffi::{OsStr, OsString};
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;

fn fold_byte(b: u8) -> u8 {
    if (0x41..=0x5A).contains(&b) { b + 0x20 } else { b }
}

fn line_contains_pattern(line: &[u8], pattern: &[u8], ci: bool) -> bool {
    if pattern.is_empty() {
        return true;
    }
    if line.len() < pattern.len() {
        return false;
    }
    if !ci {
        return line.windows(pattern.len()).any(|w| w == pattern);
    }
    let folded_pattern: Vec<u8> = pattern.iter().map(&fold_byte).collect();
    let plen = folded_pattern.len();
    for i in 0..=(line.len() - plen) {
        let mut ok = true;
        for j in 0..plen {
            if fold_byte(line[i + j]) != folded_pattern[j] {
                ok = false;
                break;
            }
        }
        if ok {
            return true;
        }
    }
    false
}

fn emit_line(out: &mut impl Write, prefix: Option<&[u8]>, line: &[u8]) -> io::Result<()> {
    if let Some(p) = prefix {
        out.write_all(p)?;
        out.write_all(b":")?;
    }
    out.write_all(line)?;
    out.write_all(b"\n")?;
    Ok(())
}

fn search_stream<R: Read>(
    reader: &mut R,
    pattern: &[u8],
    ci: bool,
    prefix: Option<&[u8]>,
    out: &mut impl Write,
) -> io::Result<bool> {
    let mut buf = vec![0u8; 65536];
    let mut line = Vec::new();
    let mut found = false;
    
    loop {
        let n = match reader.read(&mut buf) {
            Ok(0) => {
                if !line.is_empty() {
                    if line_contains_pattern(&line, pattern, ci) {
                        emit_line(out, prefix, &line)?;
                        found = true;
                    }
                }
                break;
            }
            Ok(n) => n,
            Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,
            Err(e) => return Err(e),
        };
        
        let data = &buf[..n];
        let mut start = 0;
        while start < data.len() {
            match data[start..].iter().position(|&b| b == 0x0A) {
                Some(pos) => {
                    let end = start + pos;
                    line.extend_from_slice(&data[start..end]);
                    if line_contains_pattern(&line, pattern, ci) {
                        emit_line(out, prefix, &line)?;
                        found = true;
                    }
                    line.clear();
                    start = end + 1;
                }
                None => {
                    line.extend_from_slice(&data[start..]);
                    break;
                }
            }
        }
    }
    Ok(found)
}
```

Now for the main function and argument parsing:

```rust
enum FilenameMode {
    Default,
    With,    // -H
    Without, // -h
}

struct ParsedArgs {
    pattern: Option<Vec<u8>>,
    files: Vec<OsString>,
    filename_mode: FilenameMode,
    recursive: bool,
    ignore_case: bool,
}

fn is_long_option(s: &str) -> bool {
    s.len() > 1 && s.starts_with("--")
}

fn main() {
    let args: Vec<OsString> = env::args_os().collect();
    if args.len() < 2 {
        eprintln!("rust_grep: missing PATTERN");
        std::process::exit(2);
    }
    
    let mut pattern: Option<Vec<u8>> = None;
    let mut files: Vec<OsString> = Vec::new();
    let mut filename_mode = FilenameMode::Default;
    let mut recursive = false;
    let mut ignore_case = false;
    let mut after_ddash = false;
    
    let arg_list = &args[1..];
    let mut i = 0;
    
    while i < arg_list.len() {
        let arg = &arg_list[i];
        
        if after_ddash {
            // Non-option operand
            if pattern.is_none() {
                pattern = Some(arg.as_bytes().to_vec());
            } else {
                files.push(arg.clone());
            }
            i += 1;
            continue;
        }
        
        let bytes = arg.as_bytes();
        
        if bytes == b"--" {
            after_ddash = true;
            i += 1;
            continue;
        }
        
        if bytes.len() > 2 && bytes.starts_with(b"--") {
            // Long option
            let opt_str = String::from_utf8_lossy(&bytes[2..]);
            match opt_str.as_ref() {
                "with-filename" => { filename_mode = FilenameMode::With; }
                "no-filename" => { filename_mode = FilenameMode::Without; }
                "recursive" => { recursive = true; }
                "ignore-case" => { ignore_case = true; }
                _ => {
                    eprintln!("rust_grep: unsupported option: --{}", opt_str);
                    std::process::exit(2);
                }
            }
            i += 1;
            continue;
        }
        
        if bytes.len() >= 2 && bytes[0] == b'-' && bytes[1] != b'-' {
            // Short option cluster
            let cluster = &bytes[1..];
            for &c in cluster {
                match c {
                    b'H' => { filename_mode = FilenameMode::With; }
                    b'h' => { filename_mode = FilenameMode::Without; }
                    b'r' => { recursive = true; }
                    b'i' => { ignore_case = true; }
                    _ => {
                        eprintln!("rust_grep: unsupported option: -{}", (c as char));
                        std::process::exit(2);
                    }
                }
            }
            i += 1;
            continue;
        }
        
        if bytes == b"-" {
            // Ordinary filename
            if pattern.is_none() {
                pattern = Some(vec![b'-']);
            } else {
                files.push(OsString::from("-"));
            }
            i += 1;
            continue;
        }
        
        // Non-option operand
        if pattern.is_none() {
            pattern = Some(arg.as_bytes().to_vec());
        } else {
            files.push(arg.clone());
        }
        i += 1;
    }
    
    let pattern = match pattern {
        Some(p) => p,
        None => {
            eprintln!("rust_grep: missing PATTERN");
            std::process::exit(2);
        }
    };
    
    // Now execute the search
    let mut out = io::stdout();
    let mut found_any = false;
    let mut had_error = false;
    
    if files.is_empty() {
        // Search stdin
        let prefix: Option<Vec<u8>> = match filename_mode {
            FilenameMode::With => Some(b"(standard input)".to_vec()),
            _ => None,
        };
        let stdin = io::stdin();
        let mut lock = stdin.lock();
        match search_stream(&mut lock, &pattern, ignore_case, prefix.as_deref(), &mut out) {
            Ok(f) => { found_any = f; }
            Err(_) => { had_error = true; }
        }
    } else {
        // Determine prefix mode
        let use_prefix = match filename_mode {
            FilenameMode::With => true,
            FilenameMode::Without => false,
            FilenameMode::Default => {
                files.len() >= 2 || files.iter().any(|f| {
                    Path::new(f).is_dir()
                })
            }
        };
        
        for file in &files {
            let path = Path::new(file);
            
            if path.is_dir() {
                if !recursive {
                    eprintln!("rust_grep: {}: Is a directory", display_os(file));
                    had_error = true;
                    continue;
                }
                // Recursive traversal
                let base_prefix: Vec<u8> = if use_prefix {
                    // Normalize: strip trailing slash for joining
                    let normalized = normalize_operand(file);
                    normalized
                } else {
                    Vec::new()
                };
                let prefix: Option<Vec<u8>> = if use_prefix {
                    Some(base_prefix)
                } else {
                    None
                };
                recursive_traverse(
                    file, &pattern, ignore_case, prefix, &mut out, &mut found_any, &mut had_error,
                );
            } else {
                // Regular file or symlink to file
                let file_meta = match fs::symlink_metadata(path) {
                    Ok(m) => m,
                    Err(_) => {
                        eprintln!("rust_grep: {}: No such file or directory", display_os(file));
                        had_error = true;
                        continue;
                    }
                };
                
                if file_meta.is_dir() {
                    // This is a symlink to a directory
                    if !recursive {
                        eprintln!("rust_grep: {}: Is a directory", display_os(file));
                        had_error = true;
                        continue;
                    }
                    // Treat as directory traversal
                    let prefix: Option<Vec<u8>> = if use_prefix {
                        Some(normalize_operand(file).as_os_str().as_bytes().to_vec())
                    } else {
                        None
                    };
                    recursive_traverse(
                        file, &pattern, ignore_case, prefix, &mut out, &mut found_any, &mut had_error,
                    );
                } else {
                    // Regular file (or symlink to regular file)
                    let file_contents = match fs::File::open(path) {
                        Ok(f) => f,
                        Err(e) => {
                            eprintln!("rust_grep: {}: {}", display_os(file), e);
                            had_error = true;
                            continue;
                        }
                    };
                    let prefix: Option<Vec<u8>> = if use_prefix {
                        Some(file.as_bytes().to_vec())
                    } else {
                        None
                    };
                    match search_stream(
                        &mut file_contents, &pattern, ignore_case, prefix.as_deref(), &mut out,
                    ) {
                        Ok(f) => { found_any = found_any || f; }
                        Err(_) => { had_error = true; }
                    }
                }
            }
        }
    }
    
    let exit_code = if had_error { 2 } else if found_any { 0 } else { 1 };
    std::process::exit(exit_code);
}
