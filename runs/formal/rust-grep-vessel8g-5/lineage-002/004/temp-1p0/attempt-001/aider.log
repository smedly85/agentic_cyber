```rust
fn recursive_traverse(
    dir: &OsString,
    pattern: &[u8],
    ci: bool,
    current_prefix: Option<&[u8]>,
    out: &mut impl Write,
    found: &mut bool,
    had_error: &mut bool,
) {
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(e) => {
            eprintln!("rust_grep: {}: {}", display_os(dir), e);
            *had_error = true;
            return;
