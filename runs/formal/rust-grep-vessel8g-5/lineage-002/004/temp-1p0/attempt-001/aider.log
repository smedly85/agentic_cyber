fn search_stream<R: Read>(
    reader: &mut R,
    pattern: &[u8],
    ci: bool,
    prefix: Option<&[u8]>,
    out: &mut impl Write,
) -> io::Result<bool> {
    let mut buf = vec![0u8; 65536];
    let mut line = Vec::new();
    let mut found = false;
    
    loop {
        let n = match reader.read(&mut buf) {
            Ok(0) => {
                if !line.is_empty() {
                    if line_contains_pattern(&line, pattern, ci) {
                        emit_line(out, prefix, &line)?;
                        found = true;
                    }
                }
                break;
            }
            Ok(n) => n,
            Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
            Err(e) => return Err(e),
        };
        
        let data = &buf[..n];
        let mut start = 0;
        while let Some(pos) = data[start..].iter().position(|&b| b == 0x0A) {
            let end = start + pos;
            line.extend_from_slice(&data[start..end]);
            if line_contains_pattern(&line, pattern, ci) {
                emit_line(out, prefix, &line)?;
                found = true;
            }
            line.clear();
            start = end + 1;
        }
        line.extend_from_slice(&data[start..]);
    }
    Ok(found)
}
```

