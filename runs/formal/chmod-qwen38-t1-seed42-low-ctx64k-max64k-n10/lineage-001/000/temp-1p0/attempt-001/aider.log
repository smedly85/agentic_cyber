#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <sys/stat.h>

// Mode parsing
typedef struct {
    int is_octal;
    uint16_t octal_value;
    // Symbolic clauses
    struct {
        int class_u, class_g, class_o;  // which classes
        char op;                         // '+', '-', '='
        int perm_r, perm_w, perm_x;      // which perms
        int has_X;
    } clauses[64];
    int num_clauses;
} ParsedMode;

static int parse_mode(const char *s, ParsedMode *pm) {
    memset(pm, 0, sizeof(*pm));
    
    // Check if all digits
    int all_digits = 1;
    for (const char *p = s; *p; p++) {
        if (*p < '0' || *p > '9') { all_digits = 0; break; }
    }
    
    if (all_digits) {
        // Must be 1-4 digits, all 0-7
        size_t len = strlen(s);
        if (len < 1 || len > 4) return -1;
        for (const char *p = s; *p; p++) {
            if (*p > '7') return -1;
        }
        pm->is_octal = 1;
        pm->octal_value = 0;
        for (const char *p = s; *p; p++) {
            pm->octal_value = pm->octal_value * 8 + (*p - '0');
        }
        return 0;
    }
    
    // Symbolic form
    // Split by commas
    const char *start = s;
    while (*start || start > s) {
        // Find end of clause
        const char *comma = strchr(start, ',');
        size_t len = comma ? (size_t)(comma - start) : strlen(start);
        
        if (len == 0) return -1; // empty clause
        
        // Parse clause: [ugoa...][+-=][rwxX...]
        const char *p = start;
        int has_u = 0, has_g = 0, has_o = 0;
        int has_a = 0;
        
        // Class letters
        while (p < start + len && (*p == 'u' || *p == 'g' || *p == 'o' || *p == 'a')) {
            switch (*p) {
                case 'u': has_u = 1; break;
                case 'g': has_g = 1; break;
                case 'o': has_o = 1; break;
                case 'a': has_a = 1; break;
            }
            p++;
        }
        
        if (has_a) { has_u = has_g = has_o = 1; }
        if (!has_u && !has_g && !has_o) { has_u = has_g = has_o = 1; }
        
        // Operator
        if (p >= start + len) return -1; // no operator
        char op = *p;
        if (op != '+' && op != '-' && op != '=') return -1;
        p++;
        
        // Permissions
        int perm_r = 0, perm_w = 0, perm_x = 0, has_X = 0;
        while (p < start + len) {
            switch (*p) {
                case 'r': perm_r = 1; break;
                case 'w': perm_w = 1; break;
                case 'x': perm_x = 1; break;
                case 'X': has_X = 1; break;
                default: return -1; // invalid permission letter
            }
            p++;
        }
        
        pm->clauses[pm->num_clauses].class_u = has_u;
        pm->clauses[pm->num_clauses].class_g = has_g;
        pm->clauses[pm->num_clauses].class_o = has_o;
        pm->clauses[pm->num_clauses].op = op;
        pm->clauses[pm->num_clauses].perm_r = perm_r;
        pm->clauses[pm->num_clauses].perm_w = perm_w;
        pm->clauses[pm->num_clauses].perm_x = perm_x;
        pm->clauses[pm->num_clauses].has_X = has_X;
        pm->num_clauses++;
        
        if (comma) start = comma + 1;
        else break;
    }
    
    if (pm->num_clauses == 0) return -1;
    return 0;
}
```

