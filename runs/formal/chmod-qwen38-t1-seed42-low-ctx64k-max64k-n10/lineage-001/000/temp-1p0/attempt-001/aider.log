#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>

typedef struct {
    int class_u, class_g, class_o;
    char op;
    int perm_r, perm_w, perm_x;
    int has_X;
} Clause;

typedef struct {
    int is_octal;
    uint16_t octal_value;
    Clause clauses[64];
    int num_clauses;
} ParsedMode;

static int parse_mode(const char *s, ParsedMode *pm) {
    memset(pm, 0, sizeof(*pm));

    if (s == NULL || s[0] == '\0') return -1;

    int all_digits = 1;
    for (const char *p = s; *p; p++) {
        if (*p < '0' || *p > '9') { all_digits = 0; break; }
    }

    if (all_digits) {
        size_t len = strlen(s);
        if (len > 4) return -1;
        for (const char *p = s; *p; p++) {
            if (*p > '7') return -1;
        }
        pm->is_octal = 1;
        pm->octal_value = 0;
        for (const char *p = s; *p; p++) {
            pm->octal_value = (uint16_t)(pm->octal_value * 8 + (unsigned)(*p - '0'));
        }
        return 0;
    }

    const char *start = s;
    for (;;) {
        const char *comma = strchr(start, ',');
        size_t len = comma ? (size_t)(comma - start) : strlen(start);

        if (len == 0) return -1;

        const char *p = start;
        int has_u = 0, has_g = 0, has_o = 0, has_a = 0;
        int in_class = 1;
        while (p < start + len && in_class) {
            switch (*p) {
                case 'u': has_u = 1; p++; break;
                case 'g': has_g = 1; p++; break;
                case 'o': has_o = 1; p++; break;
                case 'a': has_a = 1; p++; break;
                default: in_class = 0; break;
            }
        }

        if (has_a) { has_u = 1; has_g = 1; has_o = 1; }
        if (!has_u && !has_g && !has_o) { has_u = 1; has_g = 1; has_o = 1; }

        if (p >= start + len) return -1;
        char op = *p;
        if (op != '+' && op != '-' && op != '=') return -1;
        p++;

        int perm_r = 0, perm_w = 0, perm_x = 0, has_X = 0;
        while (p < start + len) {
            switch (*p) {
                case 'r': perm_r = 1; p++; break;
                case 'w': perm_w = 1; p++; break;
                case 'x': perm_x = 1; p++; break;
                case 'X': has_X = 1; p++; break;
                default: return -1;
            }
        }

        Clause *c = &pm->clauses[pm->num_clauses];
        c->class_u = has_u;
        c->class_g = has_g;
        c->class_o = has_o;
        c->op = op;
        c->perm_r = perm_r;
        c->perm_w = perm_w;
        c->perm_x = perm_x;
        c->has_X = has_X;
        pm->num_clauses++;

        if (comma) {
            start = comma + 1;
        } else {
            break;
        }
    }

    if (pm->num_clauses == 0) return -1;
    return 0;
}

static mode_t apply_parsed(const ParsedMode *pm, mode_t current, int is_dir) {
    if (pm->is_octal) return (mode_t)pm->octal_value;

    mode_t mode = current;
    for (int i = 0; i < pm->num_clauses; i++) {
        const Clause *c = &pm->clauses[i];

        int eff = 0;
        if (c->perm_r) eff |= 4;
        if (c->perm_w) eff |= 2;
        if (c->perm_x) eff |= 1;
        if (c->has_X && (is_dir || (mode & 0111))) eff |= 1;

        if (c->class_u) {
            mode_t u = (mode & 0700) >> 8;
            if (c->op == '+') u |= (mode_t)eff;
            else if (c->op == '-') u &= (mode_t)~((mode_t)eff);
            else u = (mode_t)eff;
            mode = (mode & ~0700) | (u << 8);
        }
        if (c->class_g) {
            mode_t g = (mode & 0070) >> 4;
            if (c->op == '+') g |= (mode_t)eff;
            else if (c->op == '-') g &= (mode_t)~((mode_t)eff);
            else g = (mode_t)eff;
            mode = (mode & ~0070) | (g << 4);
        }
        if (c->class_o) {
            mode_t o = mode & 0007;
            if (c->op == '+') o |= (mode_t)eff;
            else if (c->op == '-') o &= (mode_t)~((mode_t)eff);
            else o = (mode_t)eff;
            mode = (mode & ~0007) | o;
        }
    }
    return mode;
}

int main(int argc, char *argv[]) {
    int i = 1;
    int seen_dd = 0;

    for (; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) {
            seen_dd = 1;
            i++;
            break;
        }
        if (argv[i][0] == '-') {
            fprintf(stderr, "new_chmod: unknown option: %s\n", argv[i]);
            fprintf(stderr, "usage: new_chmod MODE FILE...\n");
            return 1;
        }
        break;
    }

    if (i >= argc) {
        if (!seen_dd)
            fprintf(stderr, "new_chmod: missing MODE and FILE operands\n");
        else
            fprintf(stderr, "new_chmod: missing MODE\n");
        fprintf(stderr, "usage: new_chmod MODE FILE...\n");
        return 1;
    }

    const char *mode_str = argv[i];
    i++;

    if (i >= argc) {
        fprintf(stderr, "new_chmod: missing FILE operand\n");
        fprintf(stderr, "usage: new_chmod MODE FILE...\n");
        return 1;
    }

    ParsedMode pm;
    if (parse_mode(mode_str, &pm) != 0) {
        fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
        return 1;
    }

    int any_failed = 0;

    for (; i < argc; i++) {
        const char *path = argv[i];
        struct stat st;

        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }

        int is_dir = S_ISDIR(st.st_mode);
        mode_t current = st.st_mode & 07777;
        mode_t new_mode = apply_parsed(&pm, current, is_dir);

        if (chmod(path, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }
    }

    return any_failed ? 1 : 0;
}
