```c
static mode_t apply_mode(const ParsedMode *pm, mode_t current, int is_dir) {
    if (pm->is_octal) return (mode_t)pm->octal_value;
    
    mode_t mode = current;
    for (int i = 0; i < pm->num_clauses; i++) {
        const auto *c = &pm->clauses[i];
        
        // Compute effective 3-bit permissions
        int eff = 0;
        if (c->perm_r) eff |= 4;
        if (c->perm_w) eff |= 2;
        if (c->perm_x) eff |= 1;
        if (c->has_X && (is_dir || (mode & 0111))) eff |= 1;
        
        // Apply to each class
        if (c->class_u) {
            mode_t u_bits = (mode & 0700) >> 8;
            switch (c->op) {
                case '+': u_bits |= eff; break;
                case '-': u_bits &= ~eff; break;
                case '=': u_bits = eff; break;
            }
            mode = (mode & ~0700) | (u_bits << 8);
        }
        if (c->class_g) {
            mode_t g_bits = (mode & 0070) >> 4;
            switch (c->op) {
                case '+': g_bits |= eff; break;
                case '-': g_bits &= ~eff; break;
                case '=': g_bits = eff; break;
            }
            mode = (mode & ~0070) | (g_bits << 4);
        }
        if (c->class_o) {
            mode_t o_bits = (mode & 0007);
            switch (c->op) {
                case '+': o_bits |= eff; break;
                case '-': o_bits &= ~eff; break;
                case '=': o_bits = eff; break;
            }
            mode = (mode & ~0007) | o_bits;
        }
    }
    return mode;
}
