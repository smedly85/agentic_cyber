```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <unistd.h>

#define MAX_CLAUSES 64

typedef struct {
    int classes;  // bitmask: bit0=u, bit1=g, bit2=o (0 means "all" in symbolic)
    char op;      // '+', '-', '='
    int perms;    // bitmask: bit0=r, bit1=w, bit2=x, bit3=X
} clause_t;

typedef struct {
    int is_octal;
    mode_t octal_value;
    clause_t clauses[MAX_CLAUSES];
    int n_clauses;
} mode_spec_t;

static void die_usage(void) {
    fprintf(stderr, "usage: new_chmod MODE FILE...\n");
    exit(1);
}

static void die_invalid_mode(const char *mode) {
    fprintf(stderr, "new_chmod: invalid mode '%s'\n", mode);
    exit(1);
}

static int is_octal_string(const char *s) {
    size_t len = strlen(s);
    if (len < 1 || len > 4) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
    }
    return 1;
}

static int is_all_digits(const char *s) {
    size_t len = strlen(s);
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '9') return 0;
    }
    return 1;
}

static int parse_symbolic(const char *s, clause_t *clauses, int *n_clauses) {
    // Split on commas, parse each clause
    *n_clauses = 0;
    const char *p = s;
    
    while (*p) {
        // Skip leading comma? No - a leading comma would mean empty clause
        // Actually, we split on commas. Let's find the next comma.
        const char *comma = strchr(p, ',');
        size_t len = comma ? (size_t)(comma - p) : strlen(p);
        
        if (len == 0) return -1;  // empty clause (e.g., trailing comma or ",,")
        
        // Parse the clause
        clause_t c = {0, 0, 0};
        const char *q = p;
        
        // Class letters
        int saw_class = 0;
        while (q - p < (long)len) {
            char ch = *q;
            if (ch == 'u') { c.classes |= 1; saw_class = 1; q++; }
            else if (ch == 'g') { c.classes |= 2; saw_class = 1; q++; }
            else if (ch == 'o') { c.classes |= 4; saw_class = 1; q++; }
            else if (ch == 'a') { c.classes |= 7; saw_class = 1; q++; }
            else break;
        }
        
        // Operator
        if (q - p >= (long)len) return -1;  // no operator
        c.op = *q;
        if (c.op != '+' && c.op != '-' && c.op != '=') return -1;
        q++;
        
        // Permission letters
        while (q - p < (long)len) {
            char ch = *q;
            if (ch == 'r') { c.perms |= 1; q++; }
            else if (ch == 'w') { c.perms |= 2; q++; }
            else if (ch == 'x') { c.perms |= 4; q++; }
            else if (ch == 'X') { c.perms |= 8; q++; }
            else return -1;  // invalid permission letter
        }
        
        clauses[(*n_clauses)++] = c;
        
        if (!comma) break;
        p = comma + 1;
    }
    
    return 0;
}

static int parse_mode(const char *s, mode_spec_t *spec) {
    memset(spec, 0, sizeof(*spec));
    
    if (strlen(s) == 0) return -1;
    
    // Check if it's all digits
    if (is_all_digits(s)) {
        // Must be valid octal (1-4 digits, all 0-7)
        if (!is_octal_string(s)) return -1;
        spec->is_octal = 1;
        spec->octal_value = (mode_t)strtol(s, NULL, 8);
        return 0;
    }
    
    // Try symbolic
    spec->is_octal = 0;
    return parse_symbolic(s, spec->clauses, &spec->n_clauses);
}

static mode_t apply_symbolic(mode_t current, const clause_t *clauses, int n, int is_dir) {
    mode_t result = current;
    
    for (int i = 0; i < n; i++) {
        const clause_t *c = &clauses[i];
        
        int classes = c->classes;
        // classes == 0 means "all" (empty class list)
        // But 'a' sets all three bits too
        // So if classes is 0, treat as all (7)
        if (classes == 0) classes = 7;
        
        // Build permission bits mask (across all 3 classes)
        int bits = 0;
        if (c->perms & 1) bits |= 0444;  // r
        if (c->perms & 2) bits |= 0222;  // w
        if (c->perms & 4) bits |= 0111;  // x
        
        // X: only if is_dir or current result has any x bit
        if (c->perms & 8) {
            if (is_dir || (result & 0111)) {
                bits |= 0111;  // x
            }
        }
        
        // Class mask
        int class_mask = 0;
        if (classes & 1) class_mask |= 0700;  // u
        if (classes & 2) class_mask |= 0070;  // g
        if (classes & 4) class_mask |= 0007;  // o
        
        int affected = bits & class_mask;
        
        switch (c->op) {
            case '+': result |= affected; break;
            case '-': result &= (mode_t)~affected; break;
            case '=': result = (result & (mode_t)~class_mask) | affected; break;
        }
    }
    
    return result;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        die_usage();
    }
    
    int start = 1;
    if (strcmp(argv[1], "--") == 0) {
        start = 2;
    }
    
    // Check for unknown options
    if (argv[start][0] == '-' && argv[start][1] != '\0') {
        // It starts with - and isn't just "-"
        // Wait, what about just "-"? That's not --, so it's an unknown option
        // Actually, "-" alone: starts with -, isn't --. It's an unknown option.
        fprintf(stderr, "new_chmod: unknown option '%s'\n", argv[start]);
        exit(1);
    }
    
    const char *mode_str = argv[start];
    int operand_start = start + 1;
    
    if (operand_start >= argc) {
        die_usage();
    }
    
    mode_spec_t spec;
    if (parse_mode(mode_str, &spec) != 0) {
        die_invalid_mode(mode_str);
    }
    
    int any_failed = 0;
    
    for (int i = operand_start; i < argc; i++) {
        const char *path = argv[i];
        
        struct stat st;
        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }
        
        int is_dir = S_ISDIR(st.st_mode);
        mode_t current = st.st_mode & 07777;
        mode_t new_mode;
        
        if (spec.is_octal) {
