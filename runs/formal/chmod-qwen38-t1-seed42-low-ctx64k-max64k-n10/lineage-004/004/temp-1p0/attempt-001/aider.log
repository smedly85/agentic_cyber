#define MAX_CLAUSES 64

typedef struct {
    int classes; /* bitmask: bit0=u, bit1=g, bit2=o; 0 means "all" */
    char op;     /* '+', '-', '=' */
    int perms;   /* bitmask: bit0=r, bit1=w, bit2=x, bit3=X */
