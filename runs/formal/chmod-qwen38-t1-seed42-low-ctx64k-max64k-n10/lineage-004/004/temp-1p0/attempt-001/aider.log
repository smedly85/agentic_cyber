    int all_digits = 1;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '9') { all_digits = 0; break; }
    }

    if (all_digits) {
        if (len > 4)
            return -1;
        for (size_t i = 0; i < len; i++) {
            if (s[i] > '7')
