        if (strcmp(argv[start], "--") == 0) {
            start++;
            break;
        } else if (strcmp(argv[start], "-R") == 0) {
            recursive = 1;
            start++;
        } else if (strcmp(argv[start], "--recursive") == 0) {
            recursive = 1;
            start++;
