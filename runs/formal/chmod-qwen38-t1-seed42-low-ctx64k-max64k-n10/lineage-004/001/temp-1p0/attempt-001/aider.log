static int apply_to_path(const char *path, const mode_spec_t *spec) {
    struct stat st;
    if (stat(path, &st) != 0) {
        fprintf(stderr, "new_chmod: cannot access '%s': %s\n", path, strerror(errno));
        return -1;
    }
    
    int is_dir = S_ISDIR(st.st_mode);
    mode_t current = st.st_mode & 07777;
    mode_t new_mode;
    
    if (spec->is_octal) {
        new_mode = spec->octal_value;
    } else {
        mode_t special = current & 07000;
        mode_t perm_bits = current & 00777;
        mode_t new_perm = apply_symbolic(perm_bits, spec->clauses, spec->n_clauses, is_dir);
        new_mode = special | new_perm;
    }
    
    if (chmod(path, new_mode) != 0) {
        fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n", path, strerror(errno));
        return -1;
    }
    return 0;
}
