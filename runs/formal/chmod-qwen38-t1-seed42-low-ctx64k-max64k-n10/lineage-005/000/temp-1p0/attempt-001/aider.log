#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stat.h>
#include <errno.h>

#define MAX_CLAUSES 256

typedef struct {
    int classes; // bit 0=u, bit 1=g, bit 2=o
    char op;     // '+', '-', '='
    int perms;   // bit 0=r, bit 1=w, bit 2=x, bit 3=X
} clause_t;

typedef struct {
    int is_octal;
    mode_t octal_value;
    int nclauses;
    clause_t clauses[MAX_CLAUSES];
} mode_spec_t;

static int parse_octal(const char *s, mode_t *out) {
    size_t len = strlen(s);
    if (len < 1 || len > 4) return -1;
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return -1;
        val = val * 8 + (s[i] - '0');
    }
    *out = val;
    return 0;
}

static int parse_symbolic(const char *s, mode_spec_t *spec) {
    spec->is_octal = 0;
    spec->nclauses = 0;
    
    const char *p = s;
    while (*p) {
        // Parse a clause
        clause_t c = {0, 0, 0};
        
        // Parse class letters
        while (*p == 'u' || *p == 'g' || *p == 'o' || *p == 'a') {
            if (*p == 'u' || *p == 'a') c.classes |= 1;
            if (*p == 'g' || *p == 'a') c.classes |= 2;
            if (*p == 'o' || *p == 'a') c.classes |= 4;
            p++;
        }
        
        // Parse operator
        if (*p != '+' && *p != '-' && *p != '=') return -1;
        c.op = *p;
        p++;
        
        // Parse permission letters
        while (*p == 'r' || *p == 'w' || *p == 'x' || *p == 'X') {
            if (*p == 'r') c.perms |= 1;
            else if (*p == 'w') c.perms |= 2;
            else if (*p == 'x') c.perms |= 4;
            else if (*p == 'X') c.perms |= 8;
            p++;
        }
        
        spec->clauses[spec->nclauses++] = c;
        
        // Expect comma or end
        if (*p == ',') {
            p++;
            // If we hit end after comma, that's a trailing comma → invalid
            if (*p == '\0') return -1;
        } else if (*p != '\0') {
            return -1; // unexpected character
        }
    }
    
    if (spec->nclauses == 0) return -1;
    return 0;
}
```

