#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>
#include <stdbool.h>

// Parse octal mode: 1-4 digits, each 0-7
// Returns true on success, sets *mode
static bool parse_octal(const char *s, mode_t *mode) {
    size_t len = strlen(s);
    if (len < 1 || len > 4) return false;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return false;
    }
    *mode = 0;
    for (size_t i = 0; i < len; i++) {
        *mode = (*mode << 3) | (s[i] - '0');
    }
    return true;
}

// Check if string is a valid octal mode
static bool is_octal(const char *s) {
    mode_t m;
    return parse_octal(s, &m);
}

// Symbolic form: represents a set of clauses to apply
// Each clause: classes (bitmask of u/g/o), operator (+/-/=), perms (bitmask of r/w/x/X)

#define CL_U 0x1
#define CL_G 0x2
#define CL_O 0x4
#define CL_A (CL_U | CL_G | CL_O)

#define OP_ADD 0
#define OP_SUB 1
#define OP_EQ  2

#define PERM_R 0x1
#define PERM_W 0x2
#define PERM_X 0x4
#define PERM_XCOND 0x8  // conditional execute (X)

typedef struct {
    int classes;   // CL_U, CL_G, CL_O bits
    int op;        // OP_ADD, OP_SUB, OP_EQ
    int perms;     // PERM_R, PERM_W, PERM_X, PERM_XCOND bits
} clause_t;

#define MAX_CLAUSES 256

typedef struct {
    clause_t clauses[MAX_CLAUSES];
    int count;
} symbolic_mode_t;

// Parse a single symbolic clause
static bool parse_clause(const char *s, size_t len, clause_t *clause) {
    // [ugoa...][+-=][rwxX...]
    // Class part: any sequence of u, g, o, a
    // Operator: exactly one of +, -, =
    // Perm part: any sequence of r, w, x, X (can be empty)
    
    size_t i = 0;
    int classes = 0;
    
    // Parse class letters
    while (i < len) {
        char c = s[i];
        if (c == 'u') { classes |= CL_U; i++; }
        else if (c == 'g') { classes |= CL_G; i++; }
        else if (c == 'o') { classes |= CL_O; i++; }
        else if (c == 'a') { classes |= CL_A; i++; }
        else break;
    }
    
    // If no class letters, means all
    if (classes == 0) classes = CL_A;
    
    // Parse operator
    if (i >= len) return false; // no operator
    char op_char = s[i];
    int op;
    if (op_char == '+') op = OP_ADD;
    else if (op_char == '-') op = OP_SUB;
    else if (op_char == '=') op = OP_EQ;
    else return false;
    i++;
    
    // Parse permission letters
    int perms = 0;
    while (i < len) {
        char c = s[i];
        if (c == 'r') { perms |= PERM_R; i++; }
        else if (c == 'w') { perms |= PERM_W; i++; }
        else if (c == 'x') { perms |= PERM_X; i++; }
        else if (c == 'X') { perms |= PERM_XCOND; i++; }
        else return false;
    }
    
    clause->classes = classes;
    clause->op = op;
    clause->perms = perms;
    return true;
}

// Parse the full symbolic mode string
static bool parse_symbolic(const char *s, symbolic_mode_t *sm) {
    sm->count = 0;
    if (*s == '\0') return false; // empty mode
    
    // Split by commas, each part must be a valid clause
    // But trailing comma is invalid (empty clause)
    
    const char *start = s;
    while (1) {
        // Find next comma or end
        const char *comma = strchr(start, ',');
        size_t len = comma ? (size_t)(comma - start) : strlen(start);
        
        if (len == 0) return false; // empty clause (trailing comma or leading comma)
        
        clause_t clause;
        if (!parse_clause(start, len, &clause)) return false;
        
        if (sm->count >= MAX_CLAUSES) return false;
        sm->clauses[sm->count++] = clause;
        
        if (comma) {
            start = comma + 1;
        } else {
            break;
        }
    }
    return true;
}

// Apply a single clause to a mode
static void apply_clause(const clause_t *clause, mode_t *mode, bool is_dir) {
    int classes = clause->classes;
    int op = clause->op;
    int perms = clause->perms;
    
    // Determine which bits to affect per class
    // For each class, compute the permission bits to add/remove/set
    
    // Map permission letters to actual bits per class
    // r = 4, w = 2, x = 1 per class
    // X = 1 (execute) only if is_dir or any execute bit already set
    
    bool any_exec = ((*mode >> 6) & 1) || ((*mode >> 3) & 1) || ((*mode >> 0) & 1);
    
    for (int cl = 0; cl < 3; cl++) {
        if (!(classes & (1 << cl))) continue; // not this class
        
        unsigned shift = (2 - cl) * 3; // u=6, g=3, o=0
        unsigned mask = 7 << shift;
        unsigned current = (*mode & mask);
        
        // Compute the permission bits for this class
        unsigned p = 0;
        if (perms & PERM_R) p |= (4 << shift);
        if (perms & PERM_W) p |= (2 << shift);
        if (perms & PERM_X) p |= (1 << shift);
        if (perms & PERM_XCOND) {
            if (is_dir || any_exec) p |= (1 << shift);
        }
        
        switch (op) {
            case OP_ADD: *mode |= p; break;
            case OP_SUB: *mode &= ~p; break;
            case OP_EQ:  *mode = (*mode & ~mask) | p; break;
        }
    }
}

// Apply all clauses to a mode
static mode_t apply_symbolic(const symbolic_mode_t *sm, mode_t current, bool is_dir) {
    mode_t m = current;
    for (int i = 0; i < sm->count; i++) {
        apply_clause(&sm->clauses[i], &m, is_dir);
    }
    // Preserve special bits (setuid, setgid, sticky)
    m |= (current & 07000);
    return m;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "new_chmod: missing operand\n");
        fprintf(stderr, "usage: new_chmod MODE FILE...\n");
        return 1;
    }
    
    // Parse arguments: find options, then MODE and FILEs
    int start = 1; // skip program name
    int end_of_options = start;
    
    for (int i = start; i < argc; i++) {
        if (argv[i][0] == '-') {
            if (strcmp(argv[i], "--") == 0) {
                end_of_options = i + 1;
                break;
            } else {
                fprintf(stderr, "new_chmod: unknown option -- %s\n", argv[i]);
                fprintf(stderr, "usage: new_chmod MODE FILE...\n");
                return 1;
            }
        } else {
            end_of_options = i;
            break;
        }
    }
    
    // Now argv[end_of_options] is MODE, argv[end_of_options+1..] are FILEs
    if (end_of_options >= argc) {
        // No operands after options — but we need at least a MODE
        fprintf(stderr, "new_chmod: missing operand\n");
        fprintf(stderr, "usage: new_chmod MODE FILE...\n");
        return 1;
    }
    
    const char *mode_str = argv[end_of_options];
    int file_start = end_of_options + 1;
    
    if (file_start >= argc) {
        fprintf(stderr, "new_chmod: missing operand\n");
        fprintf(stderr, "usage: new_chmod MODE FILE...\n");
        return 1;
    }
    
    // Determine if mode is octal or symbolic
    bool is_octal_form = true;
    // Check: if all chars are octal digits and length 1-4, it's octal
    // Otherwise it's symbolic
    {
        size_t len = strlen(mode_str);
        if (len < 1 || len > 4) {
            is_octal_form = false;
        } else {
            for (size_t i = 0; i < len; i++) {
                if (mode_str[i] < '0' || mode_str[i] > '7') {
                    is_octal_form = false;
                    break;
                }
            }
        }
    }
    
    mode_t octal_mode = 0;
    symbolic_mode_t sym;
    
    if (is_octal_form) {
        if (!parse_octal(mode_str, &octal_mode)) {
            fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
            return 1;
        }
    } else {
        if (!parse_symbolic(mode_str, &sym)) {
            fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
            return 1;
        }
    }
    
    // Apply to each operand
    int any_failed = 0;
    
    for (int i = file_start; i < argc; i++) {
        const char *path = argv[i];
        
        // Stat the file (follow symlinks)
        struct stat st;
        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }
        
        bool is_dir = S_ISDIR(st.st_mode);
        mode_t current = st.st_mode & 07777;
        mode_t new_mode;
        
        if (is_octal_form) {
            new_mode = octal_mode;
        } else {
            new_mode = apply_symbolic(&sym, current, is_dir);
        }
        
        // Only set the permission bits, preserve file type
        if (chmod(path, new_mode) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
            any_failed = 1;
        }
    }
    
    return any_failed;
}
