   ```c
   static int name_cmp(const void *a, const void *b) {
       const unsigned char *na = (const unsigned char *)a;
       const unsigned char *nb = (const unsigned char *)b;
       // Compare up to 256 bytes (names are NUL-terminated within 256)
       size_t i = 0;
       while (i < 256 && na[i] == nb[i]) i++;
       if (i < 256) return (int)na[i] - (int)nb[i];
       return 0;
   }
