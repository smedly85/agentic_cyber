    int any_failed = 0;

    for (int fi = file_start; fi < argc; fi++) {
        const char *path = argv[fi];

        if (recursive) {
            struct stat st;
            if (stat(path, &st) != 0) {
                fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
                any_failed = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                if (recursive_apply(path, is_octal_form, octal_val, &sym))
                    any_failed = 1;
            } else {
                if (apply_to_path(path, is_octal_form, octal_val, &sym) != 0)
                    any_failed = 1;
            }
        } else {
            if (apply_to_path(path, is_octal_form, octal_val, &sym) != 0)
                any_failed = 1;
        }
    }

    return any_failed;
}
