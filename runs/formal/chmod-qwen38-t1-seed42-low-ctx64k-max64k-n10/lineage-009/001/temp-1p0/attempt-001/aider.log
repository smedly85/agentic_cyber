    exit(1);
}

static char *xstrdup(const char *s) {
    size_t len = strlen(s) + 1;
    char *p = malloc(len);
    if (!p) oom();
    memcpy(p, s, len);
    return p;
}

static char *xstrcat3(const char *a, const char *b) {
    // a + "/" + b
    size_t len = strlen(a) + 1 + strlen(b) + 1;
    char *p = malloc(len);
    if (!p) oom();
    snprintf(p, len, "%s/%s", a, b);
    return p;
}

static int apply_to_path(const char *path, int is_octal, mode_t octal_val,
                         const symbolic_mode_t *sym) {
    struct stat st;
    if (stat(path, &st) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    int is_dir = S_ISDIR(st.st_mode);
    mode_t current = st.st_mode & 07777;
    mode_t new_mode;
    if (is_octal) {
        new_mode = octal_val;
    } else {
        new_mode = apply_symbolic(sym, current, is_dir);
    }
    if (chmod(path, new_mode) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    return 0;
}

static int cmp_names(const void *a, const void *b) {
    const char *sa = *(const char *const *)a;
    const char *sb = *(const char *const *)b;
    return strcmp(sa, sb);
}

static int recursive_apply(const char *root, int is_octal, mode_t octal_val,
                           const symbolic_mode_t *sym) {
    int failed = 0;
    
    // Explicit stack of paths to process
    size_t stack_cap = 64;
    char **stack = malloc(stack_cap * sizeof(char *));
    if (!stack) oom();
    size_t sp = 0;
    
    // Push root
    stack[sp++] = xstrdup(root);
    
    while (sp > 0) {
        sp--;
        char *path = stack[sp];
        
        // Apply mode to this path
        if (apply_to_path(path, is_octal, octal_val, sym) != 0)
            failed = 1;
        
        // If it's a directory, push its children (non-symlinks) in reverse sorted order
        struct stat st;
        if (lstat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
            DIR *d = opendir(path);
            if (d) {
                // Collect entry names
                size_t n = 0, cap = 0;
                char **names = NULL;
                struct dirent *ent;
                while ((ent = readdir(d)) != NULL) {
                    if (strcmp(ent->d_name, ".") == 0 ||
                        strcmp(ent->d_name, "..") == 0)
                        continue;
                    if (n >= cap) {
                        cap = cap ? cap * 2 : 32;
                        char **tmp = realloc(names, cap * sizeof(char *));
                        if (!tmp) oom();
                        names = tmp;
                    }
                    names[n++] = xstrdup(ent->d_name);
                }
                closedir(d);
                
                // Sort by byte order
                qsort(names, n, sizeof(char *), cmp_names);
                
                // Push in reverse order onto stack
                for (size_t i = n; i > 0; i--) {
                    char *full = xstrcat3(path, names[i - 1]);
                    free(names[i - 1]);
                    
                    // Skip symlinks
                    struct stat lst;
                    if (lstat(full, &lst) == 0 && S_ISLNK(lst.st_mode)) {
                        free(full);
                        continue;
                    }
                    
                    if (sp >= stack_cap) {
                        size_t new_cap = stack_cap * 2;
                        char **tmp = realloc(stack, new_cap * sizeof(char *));
                        if (!tmp) oom();
                        stack = tmp;
                        stack_cap = new_cap;
                    }
                    stack[sp++] = full;
                }
                
                for (size_t j = 0; j < n; j++) free(names[j]);
                free(names);
            } else {
                // Can't open directory - report error
                fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
                failed = 1;
            }
        }
        
        free(path);
    }
    
    free(stack);
    return failed;
}

static void usage(void) {
    fprintf(stderr, "usage: new_chmod [-R | --recursive] MODE FILE...\n");
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
