        struct stat st;

        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }

        if (recursive && S_ISDIR(st.st_mode)) {
