```c
static int walk_dir(const char *dir, mode_spec_t *spec, int *any_failed, int depth)
{
    if (depth > MAX_DEPTH) {
        fprintf(stderr, "new_chmod: maximum recursion depth exceeded for '%s'\n", dir);
        *any_failed = 1;
        return;
    }
    
    DIR *d = opendir(dir);
    if (!d) {
        fprintf(stderr, "new_chmod: cannot open directory '%s': %s\n", dir, strerror(errno));
        *any_failed = 1;
        return;
    }
    
    // Collect entries
    char **names = NULL;
    int n = 0, cap = 0;
    struct dirent *ent;
    while ((ent = readdir(d)) != NULL) {
        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
            continue;
        if (n >= cap) {
            cap = cap ? cap * 2 : 16;
            names = realloc(names, cap * sizeof(char*));
            if (!names) {
                closedir(d);
                fprintf(stderr, "new_chmod: out of memory\n");
                *any_failed = 1;
                return;
            }
        }
        // Store the name
        names[n] = strdup(ent->d_name);
        if (!names[n]) {
            closedir(d);
            // cleanup
            for (int i = 0; i < n; i++) free(names[i]);
            free(names);
            fprintf(stderr, "new_chmod: out of memory\n");
            *any_failed = 1;
            return;
        }
        n++;
    }
    closedir(d);
    
    // Sort
    qsort(names, n, sizeof(char*), name_cmp);
    
    // Process each entry
    for (int i = 0; i < n; i++) {
        char *full = malloc(strlen(dir) + 1 + strlen(names[i]) + 1);
        if (!full) {
            for (int j = 0; j < n; j++) free(names[j]);
            free(names);
            *any_failed = 1;
            return;
        }
        sprintf(full, "%s/%s", dir, names[i]);
        
        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n", full, strerror(errno));
            *any_failed = 1;
            free(full);
            continue;
        }
        
        if (S_ISLNK(st.st_mode)) {
            // Skip symlinks during traversal
            free(full);
            continue;
        }
        
        mode_t new_mode;
        if (spec->is_octal) {
            new_mode = spec->octal_val;
        } else {
            new_mode = apply_symbolic(st.st_mode, spec->clauses, spec->nclauses, S_ISDIR(st.st_mode));
        }
        
        if (chmod(full, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n", full, strerror(errno));
            *any_failed = 1;
            free(full);
            continue;
        }
        
        if (S_ISDIR(st.st_mode)) {
            walk_dir(full, spec, any_failed, depth + 1);
        }
        
        free(full);
    }
    
    for (int i = 0; i < n; i++) free(names[i]);
    free(names);
}
```

