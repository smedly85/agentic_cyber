    format_octal(old_octal, sizeof(old_octal), old_mode);
    format_octal(new_octal, sizeof(new_octal), new_mode);
    format_symbolic(old_sym, sizeof(old_sym), old_mode);
    format_symbolic(new_sym, sizeof(new_sym), new_mode);
    printf("mode of '%s' changed from %s (%s) to %s (%s)\n",
           path, old_octal, old_sym, new_octal, new_sym);
