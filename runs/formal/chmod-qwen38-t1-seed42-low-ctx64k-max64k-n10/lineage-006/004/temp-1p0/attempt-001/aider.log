{
    snprintf(buf, buf_size, "%04o", (unsigned)(mode & 07777));
}

static void format_symbolic(char *buf, size_t buf_size, mode_t mode)
{
    (void)buf_size;
    unsigned m = (unsigned)(mode & 07777);
    buf[0] = (m & 0400) ? 'r' : '-';
    buf[1] = (m & 0200) ? 'w' : '-';
    buf[2] = (m & 0100) ? ((m & 04000) ? 's' : 'x') : ((m & 04000) ? 'S' : '-');
    buf[3] = (m & 0040) ? 'r' : '-';
    buf[4] = (m & 0020) ? 'w' : '-';
    buf[5] = (m & 0010) ? ((m & 02000) ? 's' : 'x') : ((m & 02000) ? 'S' : '-');
    buf[6] = (m & 0004) ? 'r' : '-';
    buf[7] = (m & 0002) ? 'w' : '-';
    buf[8] = (m & 0001) ? ((m & 01000) ? 't' : 'x') : ((m & 01000) ? 'T' : '-');
    buf[9] = '\0';
