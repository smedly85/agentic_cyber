    mode_spec_t spec;
    if (!parse_mode(mode_str, mode_len, &spec)) {
        fprintf(stderr, "new_chmod: invalid mode '%s'\n", mode_str);
        return 1;
    }

    int any_failed = 0;
    for (int i = idx; i < argc; i++) {
        const char *path = argv[i];
        struct stat st;
        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
