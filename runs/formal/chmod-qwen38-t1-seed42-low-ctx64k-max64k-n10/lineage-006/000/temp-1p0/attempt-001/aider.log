```c
static mode_t apply_symbolic(mode_t current, const clause_t *clauses, int n, int is_dir) {
    mode_t result = current & 0777; // Only the permission bits, not special bits
    
    for (int i = 0; i < n; i++) {
        clause_t *cl = &clauses[i];
        int has_exec = (result & 0111) != 0; // any exec bit set?
        
        // Determine which permission bits this clause affects
        int r_bit = cl->perms & 1;
        int w_bit = cl->perms & 2;
        int x_bit = cl->perms & 4;
        int X_bit = cl->perms & 8;
        
        // X contributes x only if dir or already has exec
        int effective_x = x_bit || (X_bit && (is_dir || has_exec));
        
        // Build the permission mask for this clause
        int perm_mask = (r_bit ? 0400 : 0) | (w_bit ? 0200 : 0) | (effective_x ? 0100 : 0);
        // Wait, that's wrong. I need to apply per-class.
        
        // For each class, apply the operation
        // Owner bits: 0700, Group bits: 0070, Other bits: 0007
        
        for (int cls = 0; cls < 3; cls++) {
            if (!(cl->classes & (1 << cls))) continue;
            
            mode_t class_mask = (mode_t)(0700 >> (cls * 3));
            // r, w, x for this class
            int r = r_bit ? (0400 >> (cls * 3)) : 0;
            int w = w_bit ? (0200 >> (cls * 3)) : 0;
            int x = effective_x ? (0100 >> (cls * 3)) : 0;
            mode_t perm = (mode_t)(r | w | x);
            
            if (cl->op == '+') {
                result |= perm;
            } else if (cl->op == '-') {
                result &= ~perm;
            } else { // '='
                result = (result & ~class_mask) | perm;
            }
        }
    }
    
    // Preserve special bits (setuid, setgid, sticky)
    return result | (current & 07000);
}
```

