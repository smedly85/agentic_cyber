```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>

typedef struct {
    int classes;   // bit 0: u, bit 1: g, bit 2: o
    int op;        // '+', '-', '='
    int perms;     // bit 0: r, bit 1: w, bit 2: x, bit 3: X
} clause_t;

typedef struct {
    int is_octal;
    mode_t octal_val;
    clause_t clauses[128];
    int nclauses;
} mode_spec_t;

static int parse_octal(const char *s, size_t len, mode_t *out) {
    if (len < 1 || len > 4) return 0;
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
        val = (val << 3) | (mode_t)(s[i] - '0');
    }
    *out = val;
    return 1;
}

static int is_octal_string(const char *s, size_t len) {
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
    }
    return 1;
}

static int parse_clause(const char *s, size_t len, clause_t *out) {
    if (len == 0) return 0;
    
    size_t i = 0;
    int classes = 0;
    
    // Read class letters
    while (i < len) {
        char c = s[i];
        if (c == 'u') classes |= 1;
        else if (c == 'g') classes |= 2;
        else if (c == 'o') classes |= 4;
        else if (c == 'a') classes |= 7;
        else break;
        i++;
    }
    
    // Must have operator
    if (i >= len) return 0;
    int op = s[i];
    if (op != '+' && op != '-' && op != '=') return 0;
    i++;
    
    // Read permission letters
    int perms = 0;
    while (i < len) {
        char c = s[i];
        if (c == 'r') perms |= 1;
        else if (c == 'w') perms |= 2;
        else if (c == 'x') perms |= 4;
        else if (c == 'X') perms |= 8;
        else return 0;
        i++;
    }
    
    if (classes == 0) classes = 7; // empty means all
    out->classes = classes;
    out->op = op;
    out->perms = perms;
    return 1;
}

static int parse_mode(const char *s, size_t len, mode_spec_t *spec) {
    memset(spec, 0, sizeof(*spec));
    
    if (len == 0) return 0;
    
    if (is_octal_string(s, len)) {
        if (!parse_octal(s, len, &spec->octal_val)) return 0;
        spec->is_octal = 1;
        return 1;
    }
    
    // Symbolic: split by commas
    spec->is_octal = 0;
    size_t start = 0;
    for (size_t i = 0; i <= len; i++) {
        if (i == len || s[i] == ',') {
            size_t clause_len = i - start;
            if (clause_len == 0) return 0; // empty clause
            if (spec->nclauses >= 128) return 0;
            if (!parse_clause(s + start, clause_len, &spec->clauses[spec->nclauses])) return 0;
            spec->nclauses++;
            start = i + 1;
        }
    }
    
    if (spec->nclauses == 0) return 0;
    return 1;
}

static mode_t apply_symbolic(mode_t current, const clause_t *clauses, int n, int is_dir) {
    mode_t result = current & 0777;
    
    for (int i = 0; i < n; i++) {
        const clause_t *cl = &clauses[i];
        int has_exec = (result & 0111) != 0;
        
        int r_bit = cl->perms & 1;
        int w_bit = cl->perms & 2;
        int x_bit = cl->perms & 4;
        int X_bit = cl->perms & 8;
        
        int effective_x = x_bit || (X_bit && (is_dir || has_exec));
        
        for (int cls = 0; cls < 3; cls++) {
            if (!(cl->classes & (1 << cls))) continue;
            
            mode_t class_mask = (mode_t)(0700 >> (cls * 3));
            mode_t perm = 0;
            if (r_bit) perm |= (mode_t)(0400 >> (cls * 3));
            if (w_bit) perm |= (mode_t)(0200 >> (cls * 3));
            if (effective_x) perm |= (mode_t)(0100 >> (cls * 3));
            
            if (cl->op == '+') {
                result |= perm;
            } else if (cl->op == '-') {
                result &= ~perm;
            } else { // '='
                result = (result & ~class_mask) | perm;
            }
        }
    }
    
    return result | (current & 07000);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "new_chmod: missing operand\n");
        return 1;
    }
    
    int idx = 1;
    if (argv[1][0] == '-') {
        if (strcmp(argv[1], "--") == 0) {
            idx = 2;
        } else {
            fprintf(stderr, "new_chmod: unknown option '%s'\n", argv[1]);
            return 1;
        }
    }
    
    if (idx >= argc) {
        fprintf(stderr, "new_chmod: missing operand\n");
        return 1;
    }
    
    const char *mode_str = argv[idx];
    idx++;
    
    if (idx >= argc) {
        fprintf(stderr, "new_chmod: missing operand\n");
        return 1;
    }
    
    size_t mode_len = strlen(mode_str);
    mode_spec_t spec;
    if (!parse_mode(mode_str, mode_len, &spec)) {
        fprintf(stderr, "new_chmod: invalid mode '%s'\n", mode_str);
        return 1;
    }
    
    int any_failed = 0;
    for (int i = idx; i < argc; i++) {
        const char *path = argv[i];
        struct stat st;
        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }
        
        mode_t new_mode;
        if (spec.is_octal) {
            new_mode = spec.octal_val;
        } else {
            int is_dir = S_ISDIR(st.st_mode);
            new_mode = apply_symbolic(st.st_mode, spec.clauses, spec.nclauses, is_dir);
        }
        
        if (chmod(path, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n", path, strerror(errno));
            any_failed = 1;
            continue;
        }
    }
    
    return any_failed ? 1 : 0;
}
