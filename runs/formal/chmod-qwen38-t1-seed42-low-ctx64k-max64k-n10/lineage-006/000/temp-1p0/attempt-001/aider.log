static int parse_clause(const char *s, size_t len, clause_t *out) {
    // Classes
    int classes = 0;
    size_t i = 0;
    
    // Read class letters
    while (i < len) {
        char c = s[i];
        if (c == 'u') { classes |= 1; i++; }
        else if (c == 'g') { classes |= 2; i++; }
        else if (c == 'o') { classes |= 4; i++; }
        else if (c == 'a') { classes |= 7; i++; }
        else break;
    }
    
    // Must have operator
    if (i >= len) return 0; // no operator
    int op = s[i];
    if (op != '+' && op != '-' && op != '=') return 0;
    i++;
    
    // Read permission letters
    int perms = 0;
    while (i < len) {
        char c = s[i];
        if (c == 'r') { perms |= 1; i++; }
        else if (c == 'w') { perms |= 2; i++; }
        else if (c == 'x') { perms |= 4; i++; }
        else if (c == 'X') { perms |= 8; i++; }
        else return 0; // invalid character
    }
    
    out->classes = classes ? classes : 7; // empty means all
    out->op = op;
    out->perms = perms;
    return 1;
}
```

