```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

#define MAX_CLAUSES 256

typedef struct {
    unsigned char class_mask; /* bit0=u, bit1=g, bit2=o */
    char op;                  /* '+', '-', '=' */
    unsigned char perms;      /* bit0=r, bit1=w, bit2=x, bit3=X */
} clause_t;

typedef struct {
    int count;
    clause_t c[MAX_CLAUSES];
} symbolic_mode_t;

/* ---------- octal ---------- */

static bool is_octal_string(const char *s)
{
    size_t len = strlen(s);
    if (len == 0 || len > 4)
        return false;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7')
            return false;
    }
    return true;
}

static bool parse_octal(const char *s, int *result)
{
    int val = 0;
    for (const char *p = s; *p; p++)
        val = val * 8 + (*p - '0');
    *result = val;
    return true;
}

/* ---------- symbolic ---------- */

static bool parse_clause(const char *s, size_t len, clause_t *out)
{
    size_t pos = 0;
    unsigned char cm = 0;

    while (pos < len) {
        char c = s[pos];
        if (c == 'u')       { cm |= 1; pos++; }
        else if (c == 'g')  { cm |= 2; pos++; }
        else if (c == 'o')  { cm |= 4; pos++; }
        else if (c == 'a')  { cm |= 7; pos++; }
        else                break;
    }
    if (cm == 0)
        cm = 7;

    if (pos >= len)
        return false;
    char op = s[pos];
    if (op != '+' && op != '-' && op != '=')
        return false;
    pos++;

    unsigned char pm = 0;
    while (pos < len) {
        char c = s[pos];
        if (c == 'r')      { pm |= 1; pos++; }
        else if (c == 'w') { pm |= 2; pos++; }
        else if (c == 'x') { pm |= 4; pos++; }
        else if (c == 'X') { pm |= 8; pos++; }
        else               return false;
    }

    out->class_mask = cm;
    out->op = op;
    out->perms = pm;
    return true;
}

static bool parse_symbolic(const char *s, symbolic_mode_t *out)
{
    out->count = 0;
    if (s[0] == '\0')
        return false;

    const char *start = s;
    for (;;) {
        const char *comma = start;
        while (*comma && *comma != ',')
            comma++;
        size_t clen = (size_t)(comma - start);
        bool more = (*comma == ',');

        if (clen == 0)
            return false;
        if (out->count >= MAX_CLAUSES)
            return false;
        if (!parse_clause(start, clen, &out->c[out->count]))
            return false;
        out->count++;

        if (!more)
            break;
        start = comma + 1;
    }
    return true;
}

/* ---------- apply ---------- */

static mode_t apply_symbolic(const symbolic_mode_t *sm, mode_t current, bool is_dir)
{
    mode_t result = current;

    for (int i = 0; i < sm->count; i++) {
        const clause_t *cl = &sm->c[i];

        unsigned char p = 0;
        if (cl->perms & 1) p |= 4; /* r */
        if (cl->perms & 2) p |= 2; /* w */
        if (cl->perms & 4) p |= 1; /* x */
        if (cl->perms & 8) {       /* X */
            if (is_dir || (result & 0111))
                p |= 1;
        }

        if (cl->class_mask & 1) { /* owner */
            mode_t v = (mode_t)(p << 6);
            if (cl->op == '+')      result |= v;
            else if (cl->op == '-') result &= ~v;
            else                    result = (result & ~0700) | v;
        }
        if (cl->class_mask & 2) { /* group */
            mode_t v = (mode_t)(p << 3);
            if (cl->op == '+')      result |= v;
            else if (cl->op == '-') result &= ~v;
            else                    result = (result & ~0070) | v;
        }
        if (cl->class_mask & 4) { /* other */
            mode_t v = (mode_t)p;
            if (cl->op == '+')      result |= v;
            else if (cl->op == '-') result &= ~v;
            else                    result = (result & ~0007) | v;
        }
    }
    return result;
}

/* ---------- main ---------- */

static void die_usage(void)
{
    fprintf(stderr, "usage: new_chmod MODE FILE...\n");
    exit(1);
}

int main(int argc, char *argv[])
{
    if (argc < 2)
        die_usage();

    const char *mode_str;
    char **operands;
    int noperands;

    if (strcmp(argv[1], "--") == 0) {
        if (argc < 4)
            die_usage();
        mode_str = argv[2];
        operands = &argv[3];
        noperands = argc - 3;
    } else if (argv[1][0] == '-') {
        fprintf(stderr, "new_chmod: unknown option: %s\n", argv[1]);
        die_usage();
    } else {
        if (argc < 3)
            die_usage();
        mode_str = argv[1];
        operands = &argv[2];
        noperands = argc - 2;
    }

    if (noperands < 1)
        die_usage();

    /* Parse the mode */
    bool octal = false;
    int octal_val = 0;
    symbolic_mode_t sm;

    if (is_octal_string(mode_str)) {
        if (!parse_octal(mode_str, &octal_val)) {
            fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
            return 1;
        }
        octal = true;
    } else {
        if (!parse_symbolic(mode_str, &sm)) {
            fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
            return 1;
        }
    }

    /* Apply to each operand */
    int any_failed = 0;

    for (int i = 0; i < noperands; i++) {
        const char *path = operands[i];
        struct stat st;

        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                    path, strerror(errno));
            any_failed = 1;
            continue;
        }

        mode_t new_mode;
        if (octal) {
            new_mode = (mode_t)octal_val;
        } else {
            new_mode = apply_symbolic(&sm, st.st_mode, S_ISDIR(st.st_mode));
        }

        if (chmod(path, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n",
                    path, strerror(errno));
            any_failed = 1;
        }
    }

    return any_failed ? 1 : 0;
}
```

