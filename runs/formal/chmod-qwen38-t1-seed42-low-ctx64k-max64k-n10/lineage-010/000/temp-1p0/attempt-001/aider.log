```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>

enum {
    CLASS_U = 0x1,
    CLASS_G = 0x2,
    CLASS_O = 0x4,
    PERM_R  = 0x1,
    PERM_W  = 0x2,
    PERM_X  = 0x4,
    PERM_XS = 0x8,
};

#define MAX_CLAUSES 256

typedef struct {
    int classes;  // CLASS_U | CLASS_G | CLASS_O
    char op;      // '+', '-', '='
    int perms;    // PERM_R | PERM_W | PERM_X | PERM_XS
} clause;

typedef struct {
    int is_octal;
    mode_t octal_value;
    int num_clauses;
    clause clauses[MAX_CLAUSES];
} parsed_mode;

static void die_oom(void) {
    fprintf(stderr, "new_chmod: out of memory\n");
    exit(1);
}

static void usage(void) {
    fprintf(stderr, "usage: new_chmod MODE FILE...\n");
}

// Parse octal: all digits 0-7, length 1-4
static int try_parse_octal(const char *s, mode_t *out) {
    size_t len = strlen(s);
    if (len < 1 || len > 4) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
    }
    *out = (mode_t)strtol(s, NULL, 8);
    return 1;
}

// Parse symbolic mode
static int parse_symbolic(const char *s, parsed_mode *pm) {
    pm->is_octal = 0;
    pm->num_clauses = 0;
    
    const char *p = s;
    if (*p == '\0') return -1; // empty
    
    while (*p) {
        // Parse one clause
        clause c = {0, 0, 0};
        
        // Class letters
        while (*p == 'u' || *p == 'g' || *p == 'o' || *p == 'a') {
            switch (*p) {
                case 'u': c.classes |= CLASS_U; break;
                case 'g': c.classes |= CLASS_G; break;
                case 'o': c.classes |= CLASS_O; break;
                case 'a': c.classes |= CLASS_U | CLASS_G | CLASS_O; break;
            }
            p++;
        }
        
        // Operator
        if (*p != '+' && *p != '-' && *p != '=') return -1;
        c.op = *p;
        p++;
        
        // Permission letters
        while (*p == 'r' || *p == 'w' || *p == 'x' || *p == 'X') {
            switch (*p) {
                case 'r': c.perms |= PERM_R; break;
                case 'w': c.perms |= PERM_W; break;
                case 'x': c.perms |= PERM_X; break;
                case 'X': c.perms |= PERM_XS; break;
            }
            p++;
        }
        
        if (pm->num_clauses >= MAX_CLAUSES) return -1;
        pm->clauses[pm->num_clauses++] = c;
        
        // Separator
        if (*p == ',') {
            p++;
            if (*p == '\0') return -1; // trailing comma → empty clause
            continue;
        }
        if (*p == '\0') break;
        // Anything else is invalid (we've consumed all valid chars)
        return -1;
    }
    
    return 0;
}

static int parse_mode(const char *s, parsed_mode *pm) {
    if (s == NULL || *s == '\0') return -1;
    
    mode_t octal_val;
    if (try_parse_octal(s, &octal_val)) {
        pm->is_octal = 1;
        pm->octal_value = octal_val;
        pm->num_clauses = 0;
        return 0;
    }
    
    return parse_symbolic(s, pm);
}

// Apply a single clause to a mode
// is_dir: whether the target is a directory
static mode_t apply_clause(const clause *c, mode_t current, int is_dir) {
    mode_t result = current;
    
    // Resolve X: if is_dir or any execute bit is set, X becomes X
    int perms = c->perms;
    if (perms & PERM_XS) {
        if (is_dir || (current & (S_IXUSR | S_IXGRP | S_IXOTH))) {
            perms |= PERM_X;
        }
        perms &= ~PERM_XS;
    }
    
    // For each affected class
    mode_t class_perms = 0;
    
    // Build the permission bits for this clause (without special bits)
    mode_t u_bits = 0, g_bits = 0, o_bits = 0;
    if (perms & PERM_R) { u_bits |= S_IRUSR; g_bits |= S_IRGRP; o_bits |= S_IROTH; }
    if (perms & PERM_W) { u_bits |= S_IWUSR; g_bits |= S_IWGRP; o_bits |= S_IWOTH; }
    if (perms & PERM_X) { u_bits |= S_IXUSR; g_bits |= S_IXGRP; o_bits |= S_IXOTH; }
    
    if (c->classes & CLASS_U) {
        if (c->op == '+') result |= u_bits;
        else if (c->op == '-') result &= ~u_bits;
        else if (c->op == '=') {
            // Clear all user bits, then set the specified ones
            result = (result & ~00700) | (u_bits & 00700);
            // But we also need to preserve special bits
            // Actually, the spec says symbolic never touches special bits
            // So we should only modify the 9 permission bits
        }
    }
    // ... similar for G and O
    
    return result;
}
