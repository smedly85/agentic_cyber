int main(int argc, char *argv[]) {
    if (argc < 2) {
        usage();
        return 1;
    }
    
    int start = 1;
    if (strcmp(argv[1], "--") == 0) {
        start = 2;
    }
    
    if (start >= argc) {
        usage();
        return 1;
    }
    
    // Check if first arg (mode) starts with '-'
    if (argv[start][0] == '-' && strcmp(argv[start], "--") != 0) {
        // Unknown option
        fprintf(stderr, "new_chmod: unknown option '%s'\n", argv[start]);
        usage();
        return 1;
    }
    
    const char *mode_str = argv[start];
    int num_operands = argc - start - 1;
    char **operands = &argv[start + 1];
    
    if (num_operands < 1) {
        usage();
        return 1;
    }
    
    parsed_mode pm;
    if (parse_mode(mode_str, &pm) != 0) {
        fprintf(stderr, "new_chmod: invalid mode '%s'\n", mode_str);
        return 1;
    }
    
    int any_failed = 0;
    
    for (int i = 0; i < num_operands; i++) {
        const char *path = operands[i];
        
        struct stat st;
        if (stat(path, &st) != 0) {
