```c
static int walk_dir(const char *path, const parsed_mode_t *pm, int depth) {
    DIR *dir = opendir(path);
    if (!dir) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return 1;
    }
    
    // Collect entries
    struct dirent *entry;
    char **names = NULL;
    int count = 0;
    int capacity = 0;
    
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (count >= capacity) {
            capacity = capacity ? capacity * 2 : 64;
            names = realloc(names, capacity * sizeof(char *));
            if (!names) { closedir(dir); return 1; }
        }
        names[count] = strdup(entry->d_name);
        if (!names[count]) { /* cleanup... */ closedir(dir); return 1; }
        count++;
    }
    closedir(dir);
    
    // Sort by byte comparison
    qsort(names, count, sizeof(char *), compare_names);
    
    int any_failed = 0;
    for (int i = 0; i < count; i++) {
        char *full = /* join path and names[i] */;
        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", full, strerror(errno));
            any_failed = 1;
            free(full);
            continue;
        }
        if (S_ISLNK(st.st_mode)) {
            free(full);
            continue;
        }
        int is_dir = S_ISDIR(st.st_mode);
        mode_t current = st.st_mode & 07777;
        mode_t new_mode;
        if (pm->is_octal) {
            new_mode = pm->octal_value;
        } else {
            new_mode = current;
            for (int j = 0; j < pm->num_clauses; j++)
                new_mode = apply_clause(&pm.clauses[j], new_mode, is_dir);
        }
        if (chmod(full, new_mode) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", full, strerror(errno));
            any_failed = 1;
        }
        if (is_dir) {
            if (depth + 1 > MAX_DEPTH) {
                fprintf(stderr, "new_chmod: %s: maximum recursion depth exceeded\n", full);
                any_failed = 1;
            } else {
                if (walk_dir(full, pm, depth + 1))
                    any_failed = 1;
            }
        }
        free(full);
        free(names[i]);
    }
    free(names);
    return any_failed ? 1 : 0;
}
```

