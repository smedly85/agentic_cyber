Now for the symbolic rendering function:

```c
static void render_symbolic(mode_t m, char *buf) {
    // buf must be at least 10 bytes (9 chars + null)
    buf[0] = (m & S_IRUSR) ? 'r' : '-';
    buf[1] = (m & S_IWUSR) ? 'w' : '-';
    buf[2] = (m & S_IXUSR) ? 'x' : '-';
    buf[3] = (m & S_IRGRP) ? 'r' : '-';
    buf[4] = (m & S_IWGRP) ? 'w' : '-';
    buf[5] = (m & S_IXGRP) ? 'x' : '-';
    buf[6] = (m & S_IROTH) ? 'r' : '-';
    buf[7] = (m & S_IWOTH) ? 'w' : '-';
    buf[8] = (m & S_IXOTH) ? 'x' : '-';
    buf[9] = '\0';
    
    // Special bits
    if (m & S_ISUID) buf[2] = (m & S_IXUSR) ? 's' : 'S';
    if (m & S_ISGID) buf[5] = (m & S_IXGRP) ? 's' : 'S';
    if (m & S_ISVTX) buf[8] = (m & S_IXOTH) ? 't' : 'T';
}
```

