Actually, I'll create a small helper that strips trailing slashes:

```c
static char *strip_trailing_slashes(const char *s) {
    // Return a newly allocated string without trailing slashes
    // (but keep at least one character - a lone "/" becomes "/")
    size_t len = strlen(s);
    while (len > 1 && s[len - 1] == '/')
        len--;
    char *result = malloc(len + 1);
    if (!result) return NULL;
    memcpy(result, s, len);
    result[len] = '\0';
    return result;
}
```

