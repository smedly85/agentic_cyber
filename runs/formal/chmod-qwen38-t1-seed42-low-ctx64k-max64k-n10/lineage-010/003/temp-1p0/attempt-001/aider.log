    CLASS_O = 0x4,
    PERM_R  = 0x1,
    PERM_W  = 0x2,
    PERM_X  = 0x4,
    PERM_XS = 0x8,
};

#define MAX_CLAUSES 1024
#define MAX_DEPTH 4096

