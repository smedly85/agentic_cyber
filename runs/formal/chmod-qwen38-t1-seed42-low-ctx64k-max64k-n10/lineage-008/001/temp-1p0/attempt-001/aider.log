Looking at the code, the issue is a **double free** in `walk_dir`. Inside the processing loop, `names[i]` is freed on every path through the loop body, and then freed *again* in the cleanup loop at the bottom of the function. This corrupts the heap and triggers SIGTRAP (glibc's heap consistency check).

The fix is to remove all `free(names[i])` calls from inside the processing loop and rely solely on the cleanup at the bottom.

```c
static int walk_dir(const char *path, const mode_spec_t *spec)
{
    int had_error = 0;

    DIR *dir = opendir(path);
    if (!dir) {
        fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                path, strerror(errno));
        return 1;
    }

    char **names = NULL;
    int count = 0, cap = 0;

    while (true) {
        struct dirent *entry = readdir(dir);
        if (!entry)
            break;
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (count == cap) {
            cap = cap ? cap * 2 : 16;
            char **tmp = realloc(names, (size_t)cap * sizeof(char *));
            if (!tmp) {
                for (int j = 0; j < count; j++) free(names[j]);
                free(names);
                closedir(dir);
                return 1;
            }
            names = tmp;
        }
        names[count] = strdup(entry->d_name);
        if (!names[count]) {
            for (int j = 0; j < count; j++) free(names[j]);
            free(names);
            closedir(dir);
            return 1;
        }
        count++;
    }
    closedir(dir);

    if (count > 1)
        qsort(names, (size_t)count, sizeof(char *), cmp_names);

    for (int i = 0; i < count; i++) {
        size_t plen = strlen(path);
        size_t nlen = strlen(names[i]);
        char *full = malloc(plen + 1 + nlen + 1);
        if (!full) {
            had_error = 1;
            continue;
        }
        memcpy(full, path, plen);
        full[plen] = '/';
        memcpy(full + plen + 1, names[i], nlen + 1);

        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                    full, strerror(errno));
            had_error = 1;
            free(full);
            continue;
        }

        if (S_ISLNK(st.st_mode)) {
            free(full);
            continue;
        }

        bool is_dir = S_ISDIR(st.st_mode);
        mode_t new_mode;
        if (spec->is_octal)
            new_mode = spec.octal_value;
        else
            new_mode = apply_symbolic(spec, st.st_mode, is_dir);

        if (chmod(full, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n",
                    full, strerror(errno));
            had_error = 1;
        }

        if (is_dir) {
            if (walk_dir(full, spec))
                had_error = 1;
        }

        free(full);
    }

    for (int i = 0; i < count; i++)
        free(names[i]);
    free(names);
    return had_error;
}
```

