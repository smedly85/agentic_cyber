#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <dirent.h>
#include <stdbool.h>
#include <ctype.h>
#include <getopt.h>

typedef struct {
    bool is_octal;
    mode_t octal_value;
    bool has_u, has_g, has_o, has_a;
    bool plus, minus, equal;
    mode_t u_r, u_w, u_x;
    mode_t g_r, g_w, g_x;
    mode_t o_r, o_w, o_x;
    bool special_setuid, special_setgid, special_sticky;
    mode_t special_value;
} mode_spec_t;

static int cmp_names(const void *a, const void *b)
{
    return strcmp(*(const char **)a, *(const char **)b);
}

static bool parse_symbolic(const char *spec, mode_spec_t *result)
{
    const char *p = spec;
    while (*p) {
        bool class_u = false, class_g = false, class_o = false, class_a = false;
        bool has_plus = false, has_minus = false, has_equal = false;
        mode_t u_r = 0, u_w = 0, u_x = 0;
        mode_t g_r = 0, g_w = 0, g_x = 0;
        mode_t o_r = 0, o_w = 0, o_x = 0;
        bool special_setuid = false, special_setgid = false, special_sticky = false;
        mode_t special_value = 0;

        // Parse classes
        while (*p && !strchr("+-=", *p)) {
            switch (*p) {
                case 'u': class_u = true; break;
                case 'g': class_g = true; break;
                case 'o': class_o = true; break;
                case 'a': class_a = true; break;
                default:
                    if (!isupper(*p) && !islower(*p)) {
                        return false;
                    }
                    p++;
                    continue;
            }
            p++;
        }

        if (!class_u && !class_g && !class_o && !class_a)
            class_a = true;

        // Parse operator
        if (*p == '+') { has_plus = true; p++; }
        else if (*p == '-') { has_minus = true; p++; }
        else if (*p == '=') { has_equal = true; p++; }
        else {
            return false;
        }

        // Parse permissions
        while (*p && !strchr(",;", *p)) {
            switch (*p) {
                case 'r':
                    if (class_u) u_r = S_IRUSR;
                    if (class_g) g_r = S_IRGRP;
                    if (class_o) o_r = S_IROTH;
                    if (class_a) { u_r = S_IRUSR; g_r = S_IRGRP; o_r = S_IROTH; }
                    break;
                case 'w':
                    if (class_u) u_w = S_IWUSR;
                    if (class_g) g_w = S_IWGRP;
                    if (class_o) o_w = S_IWOTH;
                    if (class_a) { u_w = S_IWUSR; g_w = S_IWGRP; o_w = S_IWOTH; }
                    break;
                case 'x':
                    if (class_u) u_x = S_IXUSR;
                    if (class_g) g_x = S_IXGRP;
                    if (class_o) o_x = S_IXOTH;
                    if (class_a) { u_x = S_IXUSR; g_x = S_IXGRP; o_x = S_IXOTH; }
                    break;
                case 'X':
                    // Handled separately - just mark that X was seen
                    break;
                case 's':
                    if (class_u) special_setuid = true;
                    if (class_g) special_setgid = true;
                    if (class_a) { special_setuid = true; special_setgid = true; }
                    break;
                case 't':
                    if (class_o || class_a) special_sticky = true;
                    break;
                case '-':
                case '+':
                case '=':
                case ',':
                case ';':
                    break;
                default:
                    return false;
            }
            p++;
        }

        // Store results
        if (has_plus) {
            result->has_u = true; result->has_g = true; result->has_o = true; result->has_a = true;
            result->plus = true;
            result->u_r |= u_r; result->u_w |= u_w; result->u_x |= u_x;
            result->g_r |= g_r; result->g_w |= g_w; result->g_x |= g_x;
            result->o_r |= o_r; result->o_w |= o_w; result->o_x |= o_x;
            if (special_setuid) result->special_setuid = true;
            if (special_setgid) result->special_setgid = true;
            if (special_sticky) result->special_sticky = true;
        } else if (has_minus) {
            result->has_u = true; result->has_g = true; result->has_o = true; result->has_a = true;
            result->minus = true;
            result->u_r &= ~u_r; result->u_w &= ~u_w; result->u_x &= ~u_x;
            result->g_r &= ~g_r; result->g_w &= ~g_w; result->g_x &= ~g_x;
            result->o_r &= ~o_r; result->o_w &= ~o_w; result->o_x &= ~o_x;
            if (special_setuid) result->special_setuid = false;
            if (special_setgid) result->special_setgid = false;
            if (special_sticky) result->special_sticky = false;
        } else if (has_equal) {
            result->has_u = true; result->has_g = true; result->has_o = true; result->has_a = true;
            result->equal = true;
            result->u_r = u_r; result->u_w = u_w; result->u_x = u_x;
            result->g_r = g_r; result->g_w = g_w; result->g_x = g_x;
            result->o_r = o_r; result->o_w = o_w; result->o_x = o_x;
            if (special_setuid) result->special_setuid = true;
            if (special_setgid) result->special_setgid = true;
            if (special_sticky) result->special_sticky = true;
        }

        if (*p == ',' || *p == ';') p++;
    }

    return true;
}

static mode_t apply_symbolic(const mode_spec_t *spec, mode_t current, bool is_dir)
{
    mode_t result = current;

    // Handle X specially
    if (spec->plus) {
        if (is_dir || (current & (S_IXUSR | S_IXGRP | S_IXOTH))) {
            result |= spec->u_x | spec->g_x | spec->o_x;
        }
    }

    // Apply u permissions
    if (spec->has_u) {
        if (spec->equal) {
            result &= ~(S_IRUSR | S_IWUSR | S_IXUSR);
            result |= (spec->u_r & S_IRUSR) | (spec->u_w & S_IWUSR) | (spec->u_x & S_IXUSR);
        } else if (spec->plus) {
            result |= spec->u_r | spec->u_w | spec->u_x;
        } else if (spec->minus) {
            result &= ~(spec->u_r | spec->u_w | spec->u_x);
        }
    }

    // Apply g permissions
    if (spec->has_g) {
        if (spec->equal) {
            result &= ~(S_IRGRP | S_IWGRP | S_IXGRP);
            result |= (spec->g_r & S_IRGRP) | (spec->g_w & S_IWGRP) | (spec->g_x & S_IXGRP);
        } else if (spec->plus) {
            result |= spec->g_r | spec->g_w | spec->g_x;
        } else if (spec->minus) {
            result &= ~(spec->g_r | spec->g_w | spec->g_x);
        }
    }

    // Apply o permissions
    if (spec->has_o) {
        if (spec->equal) {
            result &= ~(S_IROTH | S_IWOTH | S_IXOTH);
            result |= (spec->o_r & S_IROTH) | (spec->o_w & S_IWOTH) | (spec->o_x & S_IXOTH);
        } else if (spec->plus) {
            result |= spec->o_r | spec->o_w | spec->o_x;
        } else if (spec->minus) {
            result &= ~(spec->o_r | spec->o_w | spec->o_x);
        }
    }

    // Handle special bits
    if (spec->special_setuid) {
        result |= S_ISUID;
    } else if (spec->equal && spec->has_u) {
        result &= ~S_ISUID;
    }

    if (spec->special_setgid) {
        result |= S_ISGID;
    } else if (spec->equal && spec->has_g) {
        result &= ~S_ISGID;
    }

    if (spec->special_sticky) {
        result |= S_ISVTX;
    } else if (spec->equal && spec->has_o) {
        result &= ~S_ISVTX;
    }

    return result;
}

static int parse_mode(const char *mode_str, mode_spec_t *spec)
{
    // Check if it's octal
    bool is_octal = true;
    for (const char *p = mode_str; *p; p++) {
        if (*p < '0' || *p > '7') {
            is_octal = false;
            break;
        }
    }

    if (is_octal) {
        spec->is_octal = true;
        spec->octal_value = (mode_t)strtol(mode_str, NULL, 8);
        return 0;
    }

    // Parse symbolic
    spec->is_octal = false;
    if (!parse_symbolic(mode_str, spec)) {
        return -1;
    }

    return 0;
}

static int walk_dir(const char *path, const mode_spec_t *spec)
{
    int had_error = 0;

    DIR *dir = opendir(path);
    if (!dir) {
        fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                path, strerror(errno));
        return 1;
    }

    char **names = NULL;
    int count = 0, cap = 0;

    while (true) {
        struct dirent *entry = readdir(dir);
        if (!entry)
            break;
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (count == cap) {
            cap = cap ? cap * 2 : 16;
            char **tmp = realloc(names, (size_t)cap * sizeof(char *));
            if (!tmp) {
                for (int j = 0; j < count; j++) free(names[j]);
                free(names);
                closedir(dir);
                return 1;
            }
            names = tmp;
        }
        names[count] = strdup(entry->d_name);
        if (!names[count]) {
            for (int j = 0; j < count; j++) free(names[j]);
            free(names);
            closedir(dir);
            return 1;
        }
        count++;
    }
    closedir(dir);

    if (count > 1)
        qsort(names, (size_t)count, sizeof(char *), cmp_names);

    for (int i = 0; i < count; i++) {
        size_t plen = strlen(path);
        size_t nlen = strlen(names[i]);
        char *full = malloc(plen + 1 + nlen + 1);
        if (!full) {
            had_error = 1;
            continue;
        }
        memcpy(full, path, plen);
        full[plen] = '/';
        memcpy(full + plen + 1, names[i], nlen + 1);

        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                    full, strerror(errno));
            had_error = 1;
            free(full);
            continue;
        }

        if (S_ISLNK(st.st_mode)) {
            free(full);
            continue;
        }

        bool is_dir = S_ISDIR(st.st_mode);
        mode_t new_mode;
        if (spec->is_octal)
            new_mode = spec->octal_value;
        else
            new_mode = apply_symbolic(spec, st.st_mode, is_dir);

        if (chmod(full, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n",
                    full, strerror(errno));
            had_error = 1;
        }

        if (is_dir) {
            if (walk_dir(full, spec))
                had_error = 1;
        }

        free(full);
    }

    for (int i = 0; i < count; i++)
        free(names[i]);
    free(names);
    return had_error;
}

int main(int argc, char *argv[])
{
    static const struct option long_options[] = {
        {"recursive", no_argument, NULL, 'R'},
        {NULL, 0, NULL, 0}
    };

    int opt;
    bool recursive = false;

    while ((opt = getopt_long(argc, argv, "+R", long_options, NULL)) != -1) {
        switch (opt) {
            case 'R':
                recursive = true;
                break;
            default:
                fprintf(stderr, "usage: new_chmod [-R] mode file...\n");
                return 1;
        }
    }

    if (optind >= argc) {
        fprintf(stderr, "usage: new_chmod [-R] mode file...\n");
        return 1;
    }

    const char *mode_str = argv[optind++];
    mode_spec_t spec;

    if (parse_mode(mode_str, &spec) != 0) {
        fprintf(stderr, "new_chmod: invalid mode\n");
        return 1;
    }

    int exit_code = 0;

    if (optind >= argc) {
        fprintf(stderr, "usage: new_chmod [-R] mode file...\n");
        return 1;
    }

    for (int i = optind; i < argc; i++) {
        const char *path = argv[i];
        struct stat st;

        if (lstat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                    path, strerror(errno));
            exit_code = 1;
            continue;
        }

        if (recursive && S_ISDIR(st.st_mode)) {
            if (walk_dir(path, &spec))
                exit_code = 1;
        } else {
            mode_t new_mode;
            if (spec.is_octal)
                new_mode = spec.octal_value;
            else
                new_mode = apply_symbolic(&spec, st.st_mode, S_ISDIR(st.st_mode));

            if (chmod(path, new_mode) != 0) {
                fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n",
                        path, strerror(errno));
                exit_code = 1;
            }
        }
    }

    return exit_code;
}
