For the apply function:
```c
static mode_t apply_clause(const clause_t *c, mode_t current, bool is_dir) {
    mode_t result = current;
    
    // Determine which permission bits this clause affects
    mode_t bits = 0;
    if (c->perm_r) bits |= S_IRUSR | S_IRGRP | S_IROTH; // will be masked by class
    if (c->perm_w) bits |= S_IWUSR | S_IWGRP | S_IWOTH;
    if (c->perm_x) bits |= S_IXUSR | S_IXGRP | S_IXOTH;
    
    // Handle X: only add x if is_dir or any x already set
    if (c->perm_X) {
        if (is_dir || (current & (S_IXUSR | S_IXGRP | S_IXOTH))) {
            bits |= S_IXUSR | S_IXGRP | S_IXOTH;
        }
    }
    
    // Mask by class
    mode_t class_mask = 0;
    if (c->has_u) class_mask |= S_IRUSR | S_IWUSR | S_IXUSR;
    if (c->has_g) class_mask |= S_IRGRP | S_IWGRP | S_IXGRP;
    if (c->has_o) class_mask |= S_IROTH | S_IWOTH | S_IXOTH;
    
    bits &= class_mask;
    
    // The "affected" bits are all rwx bits in the affected classes
    mode_t affected = class_mask;
    
    switch (c->op) {
        case 0: // +
            result |= bits;
            break;
        case 1: // -
            result &= ~bits;
            break;
        case 2: // =
            result &= ~affected;  // clear all rwx in affected classes
            result |= bits;       // set the specified bits
            break;
    }
    
    return result;
}
```

