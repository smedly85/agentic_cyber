// Recursive walk function
static int walk_dir(const char *path, const mode_spec_t *spec, int is_recursive)
{
    // path is a directory (confirmed by caller)
    DIR *dir = opendir(path);
    if (!dir) {
        fprintf(stderr, "new_chmod: cannot access '%s': %s\n", path, strerror(errno));
        return 1;
    }
    
    // Read all entries
    struct dirent *entry;
    // Collect names into a dynamic array
    char **names = NULL;
    int count = 0, cap = 0;
    
    while ((entry = readdir(dir)) != NULL) {
        // Skip "." and ".."
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (count == cap) {
            cap = cap ? cap * 2 : 16;
            names = realloc(names, cap * sizeof(char*));
            if (!names) { closedir(dir); return 1; }
        }
        names[count] = strdup(entry->d_name);
        if (!names[count]) { closedir(dir); /* free names */ return 1; }
        count++;
    }
    closedir(dir);
    
    // Sort by byte order
    // qsort with strcmp
    
    // For each entry:
    for (int i = 0; i < count; i++) {
        char *full = /* path/names[i] */;
        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n", full, strerror(errno));
            exit_code = 1; // but continue
            free(full);
            continue;
        }
        if (S_ISLNK(st.st_mode)) {
            free(full);
            continue; // skip symlinks
        }
        bool is_dir = S_ISDIR(st.st_mode);
        mode_t new_mode;
        if (spec->is_octal)
            new_mode = spec->octal_value;
        else
            new_mode = apply_symbolic(spec, st.st_mode, is_dir);
        
        if (chmod(full, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n", full, strerror(errno));
            exit_code = 1;
        }
        
        if (is_dir) {
            // recurse
            exit_code |= walk_dir(full, spec, 1);
        }
        free(full);
    }
    
    free(names);
    return exit_code;
}
