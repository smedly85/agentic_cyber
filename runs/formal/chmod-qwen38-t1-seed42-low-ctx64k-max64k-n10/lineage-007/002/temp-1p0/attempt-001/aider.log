    size_t root_len = strlen(root);
    char *root_copy = strdup(root);
    if (!root_copy) { free(stack); return -1; }
    stack[sp++] = root_copy;

    while (sp > 0) {
        char *path = stack[--sp];
        struct stat st;
        if (stat(path, &st) != 0) {
