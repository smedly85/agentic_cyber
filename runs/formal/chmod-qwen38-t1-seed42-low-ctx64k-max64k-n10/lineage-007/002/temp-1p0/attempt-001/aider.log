static char *strip_trailing_slashes(const char *s) {
    size_t len = strlen(s);
    while (len > 1 && s[len - 1] == '/') len--;
    char *result = malloc(len + 1);
    if (!result) return strdup(s);
    memcpy(result, s, len);
    result[len] = '\0';
    return result;
}

int main(int argc, char *argv[]) {
