Let me write a helper to strip trailing slashes:
```c
static char *strip_trailing_slash(const char *s) {
    size_t len = strlen(s);
    while (len > 1 && s[len-1] == '/') len--;
    char *result = malloc(len + 1);
    if (result) {
        memcpy(result, s, len);
        result[len] = '\0';
    }
    return result;
}
```

