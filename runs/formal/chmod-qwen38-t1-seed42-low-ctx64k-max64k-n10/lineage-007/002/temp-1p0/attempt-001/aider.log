                    char *full = malloc(plen);
                    if (!full) {
                        for (size_t k = 0; k < count; k++) free(names[k]);
                        free(names); closedir(dp); free(path); free(stack);
                        return -1;
                    }
                    snprintf(full, plen, "%s/%s", path, entry->d_name);
                    struct stat lst;
                    if (lstat(full, &lst) != 0) {
                        fprintf(stderr, "new_chmod: %s: %s\n", full, strerror(errno));
