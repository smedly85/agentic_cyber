                closedir(dp);
                if (count > 0) {
                    qsort(names, count, sizeof(char *), byte_compare);
                    for (size_t j = count; j > 0; j--) {
                        if (sp == cap) {
                            size_t ncap2 = cap * 2;
                            char **tmp = realloc(stack, ncap2 * sizeof(char *));
                            if (!tmp) {
