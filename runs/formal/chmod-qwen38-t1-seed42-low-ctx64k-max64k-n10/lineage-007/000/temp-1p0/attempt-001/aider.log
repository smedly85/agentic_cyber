                else if (c->op == 1) clear_mask |= w_bit;
                else set_mask |= w_bit;
            }
            if (c->perms & 4) { /* x */
                if (c->op == 0) set_mask |= x_bit;
                else if (c->op == 1) clear_mask |= x_bit;
                else set_mask |= x_bit;
