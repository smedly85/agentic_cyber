#include <dirent.h>
#include <unistd.h>
#include <sys/types.h>

static int apply_to_path(const mode_spec_t *spec, const char *path) {
    struct stat st;
    if (stat(path, &st) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    int is_dir = S_ISDIR(st.st_mode);
    unsigned long current = (unsigned long)st.st_mode & 07777;
    unsigned long new_mode = apply_mode(spec, current, is_dir);
    if (chmod(path, (mode_t)new_mode) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    return 0;
}

typedef int (*compare_fn)(const void *, const void *);

static int compare_names(const void *a, const void *b) {
    const char *na = *(const char * const *)a;
    const char *nb = *(const char * const *)b;
    // byte-wise comparison
    size_t la = strlen(na), lb = strlen(nb);
    int cmp = memcmp(na, nb, la < lb ? la : lb);
    if (cmp != 0) return cmp;
    return (la > lb) - (la < lb);
}

static int walk_recursive(const mode_spec_t *spec, const char *dirpath) {
    // Apply mode to the directory itself first
    int rc = apply_to_path(spec, dirpath);
    // Even if apply failed, we should still try to walk (the test "R-missing-operand-still-walks-the-rest" suggests continuing)
    // Actually, looking at the tests more carefully:
    // "R-unreadable-subdirectory-is-an-error" expects exit 1 and the subdir is not walked
    // But "R-missing-operand-still-walks-the-rest" expects the other operand to still be processed
    
    // Actually re-reading: "a failure anywhere in a tree is diagnosed on standard error and the walk continues"
    // But if the directory is unreadable, we can't list it. So we get an error and can't continue into it.
    
    int any_failed = (rc != 0);
    
    // Open the directory
    DIR *dp = opendir(dirpath);
    if (!dp) {
        fprintf(stderr, "new_chmod: %s: %s\n", dirpath, strerror(errno));
        return any_failed ? -1 : -1;
    }
    
    // Read all entries
    struct dirent *entry;
    char **names = NULL;
    int count = 0, cap = 0;
    
    while ((entry = readdir(dp)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (count == cap) {
            cap = cap ? cap * 2 : 16;
            names = realloc(names, cap * sizeof(char *));
        }
        names[count] = strdup(entry->d_name);
        count++;
    }
    closedir(dp);
    
    // Sort names in byte order
    qsort(names, count, sizeof(char *), compare_names);
    
    for (int i = 0; i < count; i++) {
        // Build full path
        size_t len = strlen(dirpath) + 1 + strlen(names[i]) + 1;
        char *full = malloc(len);
        snprintf(full, len, "%s/%s", dirpath, names[i]);
        
        // lstat to check if symlink
        struct stat lst;
        if (lstat(full, &lst) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", full, strerror(errno));
            any_failed = 1;
            free(full);
            continue;
        }
        
        if (S_ISLNK(lst.st_mode)) {
            // Skip symlinks during traversal
            free(full);
            continue;
        }
        
        if (S_ISDIR(lst.st_mode)) {
            if (walk_recursive(spec, full) != 0)
                any_failed = 1;
        } else {
            if (apply_to_path(spec, full) != 0)
                any_failed = 1;
        }
        
        free(full);
    }
    
    free(names);
    return any_failed ? -1 : 0;
}
```

