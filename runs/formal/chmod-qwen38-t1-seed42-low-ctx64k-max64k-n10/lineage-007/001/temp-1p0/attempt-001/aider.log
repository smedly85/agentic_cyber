```c
#include <dirent.h>
#include <unistd.h>

// Byte-wise string comparison for qsort
static int byte_compare(const void *a, const void *b) {
    const char *sa = *(const char * const *)a;
    const char *sb = *(const char * const *)b;
    size_t la = strlen(sa), lb = strlen(sb);
    size_t minlen = la < lb ? la : lb;
    int cmp = memcmp(sa, sb, minlen);
    if (cmp != 0) return cmp;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

static int apply_to_path(const mode_spec_t *spec, const char *path) {
    struct stat st;
    if (stat(path, &st) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    int is_dir = S_ISDIR(st.st_mode);
    unsigned long current = (unsigned long)st.st_mode & 07777;
    unsigned long new_mode = apply_mode(spec, current, is_dir);
    if (chmod(path, (mode_t)new_mode) != 0) {
        fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
        return -1;
    }
    return 0;
}

static int walk_recursive(const mode_spec_t *spec, const char *root) {
    int any_failed = 0;
    
    // Explicit stack of paths (to avoid unbounded recursion)
    char **stack = NULL;
    size_t sp = 0, cap = 0;
    
    // Push root
    cap = 16;
    stack = malloc(cap * sizeof(char *));
    if (!stack) return -1;
    stack[sp++] = strdup(root);
    
    while (sp > 0) {
        char *path = stack[--sp];
        
        struct stat st;
        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
            any_failed = 1;
            free(path);
            continue;
        }
        
        if (apply_to_path(spec, path) != 0)
            any_failed = 1;
        
        if (S_ISDIR(st.st_mode)) {
            DIR *dp = opendir(path);
            if (dp) {
                struct dirent *entry;
                char **names = NULL;
                size_t count = 0, ncap = 0;
                
                while ((entry = readdir(dp)) != NULL) {
                    if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
                        continue;
                    
                    // Build full path
                    size_t plen = strlen(path) + 1 + strlen(entry->d_name) + 1;
                    char *full = malloc(plen);
                    snprintf(full, plen, "%s/%s", path, entry->d_name);
                    
                    // lstat to check type
                    struct stat lst;
                    if (lstat(full, &lst) != 0) {
                        fprintf(stderr, "new_chmod: %s: %s\n", full, strerror(errno));
                        any_failed = 1;
                        free(full);
                        continue;
                    }
                    
                    // Skip symlinks during traversal
                    if (S_ISLNK(lst.st_mode)) {
                        free(full);
                        continue;
                    }
                    
                    if (count == ncap) {
                        ncap = ncap ? ncap * 2 : 16;
                        names = realloc(names, ncap * sizeof(char *));
                    }
                    names[count++] = full;
                }
                closedir(dp);
                
                // Sort by name (byte order)
                qsort(names, count, sizeof(char *), byte_compare);
                
                // Push onto stack in REVERSE order (so first-sorted is on top)
                for (size_t j = count; j > 0; j--) {
                    if (sp == cap) {
                        cap *= 2;
                        stack = realloc(stack, cap * sizeof(char *));
                    }
                    stack[sp++] = names[j-1];
                }
                free(names);
            } else {
                fprintf(stderr, "new_chmod: %s: %s\n", path, strerror(errno));
                any_failed = 1;
            }
        }
        
        free(path);
    }
    
    free(stack);
    return any_failed ? -1 : 0;
}
```

