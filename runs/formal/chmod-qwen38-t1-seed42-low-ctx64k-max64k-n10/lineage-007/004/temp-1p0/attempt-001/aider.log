            if (S_ISDIR(st.st_mode)) {
                char *db = strip_trailing_slashes(path);
                if (walk_recursive(&spec, path, db, report_level, silent) != 0)
                    any_failed = 1;
                free(db);
            } else {
                if (apply_to_path(&spec, path, path, report_level, silent) != 0)
                    any_failed = 1;
            }
        } else {
            if (apply_to_path(&spec, path, path, report_level, silent) != 0)
                any_failed = 1;
        }
    }
    return any_failed ? 1 : 0;
}
