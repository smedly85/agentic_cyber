                closedir(dp);
                if (count > 0) {
                    qsort(names, count, sizeof(char *), byte_compare);
                    for (size_t j = count; j > 0; j--) {
                        if (sp == cap) {
                            size_t ncap2 = cap * 2;
                            char **tmp = realloc(stack, ncap2 * sizeof(char *));
                            if (!tmp) {
                                for (size_t k = 0; k < count; k++) free(names[k]);
                                free(names); free(path); free(stack);
                                return -1;
                            }
