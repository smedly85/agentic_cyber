```c
// src/new_chmod/new_chmod.c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>

#define MAX_CLAUSES 256

typedef struct {
    unsigned char classes; /* bit0=u, bit1=g, bit2=o */
    char op;               /* '+', '-', '=' */
    unsigned char perms;   /* bit0=r, bit1=w, bit2=x, bit3=X */
} clause_t;

typedef struct {
    int is_octal;
    mode_t octal_value;
    clause_t clauses[MAX_CLAUSES];
    int num_clauses;
} mode_spec_t;

static int is_octal_digit(char c) {
    return c >= '0' && c <= '7';
}

static int try_parse_octal(const char *s, mode_t *out) {
    size_t len = strlen(s);
    if (len < 1 || len > 4)
        return -1;
    for (size_t i = 0; i < len; i++) {
        if (!is_octal_digit(s[i]))
            return -1;
    }
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        val = (val << 3) | (mode_t)(s[i] - '0');
    }
    *out = val;
    return 0;
}

static int parse_clause(const char *s, size_t len, clause_t *out) {
    if (len == 0)
        return -1;

    unsigned char classes = 0;
    unsigned char perms = 0;
    char op = 0;
    int in_class = 1;

    for (size_t i = 0; i < len; i++) {
        char c = s[i];
        if (in_class) {
            if (c == 'u') {
                classes |= 1;
            } else if (c == 'g') {
                classes |= 2;
            } else if (c == 'o') {
                classes |= 4;
            } else if (c == 'a') {
                classes |= 7;
            } else if (c == '+' || c == '-' || c == '=') {
                if (op != 0)
                    return -1; /* two operators */
                op = c;
                in_class = 0;
            } else {
                return -1; /* invalid char in class position */
            }
        } else {
            if (c == 'r') {
                perms |= 1;
            } else if (c == 'w') {
                perms |= 2;
            } else if (c == 'x') {
                perms |= 4;
            } else if (c == 'X') {
                perms |= 8;
            } else {
                return -1; /* invalid perm letter or second operator */
            }
        }
    }

    if (op == 0)
        return -1; /* no operator */

    out->classes = classes;
    out->op = op;
    out->perms = perms;
    return 0;
}

static int parse_symbolic(const char *s, mode_spec_t *spec) {
    spec->num_clauses = 0;
    size_t len = strlen(s);
    if (len == 0)
        return -1;

    const char *start = s;
    for (size_t i = 0; i <= len; i++) {
        if (i == len || s[i] == ',') {
            size_t seg_len = i - (size_t)(start - s);
            if (seg_len == 0)
                return -1; /* empty clause */
            if (spec->num_clauses >= MAX_CLAUSES)
                return -1;
            if (parse_clause(start, seg_len, &spec->clauses[spec->num_clauses]) != 0)
                return -1;
            spec->num_clauses++;
            start = s + i + 1;
        }
    }
    return 0;
}

static int parse_mode(const char *s, mode_spec_t *spec) {
    spec->is_octal = 0;
    spec->num_clauses = 0;

    /* If all chars are octal digits, it must be octal form */
    int all_octal = 1;
    for (const char *p = s; *p; p++) {
        if (!is_octal_digit(*p)) {
            all_octal = 0;
            break;
        }
    }
    if (all_octal) {
        if (try_parse_octal(s, &spec->octal_value) != 0)
            return -1;
        spec->is_octal = 1;
        return 0;
    }

    return parse_symbolic(s, spec);
}

static mode_t apply_symbolic(mode_t current, int is_dir, const mode_spec_t *spec) {
    mode_t mode = current & 0777;

    for (int i = 0; i < spec->num_clauses; i++) {
        const clause_t *c = &spec->clauses[i];

        int eff_r = (c->perms & 1) ? 1 : 0;
        int eff_w = (c->perms & 2) ? 1 : 0;
        int eff_x = 0;
        if (c->perms & 4)
            eff_x = 1;
        else if (c->perms & 8)
            eff_x = (is_dir || (mode & 0111)) ? 1 : 0;

        mode_t perm_bits = 0;
        if (eff_r) perm_bits |= 4;
        if (eff_w) perm_bits |= 2;
        if (eff_x) perm_bits |= 1;

        for (int cls = 0; cls < 3; cls++) {
            if (!(c->classes & (1u << cls)))
                continue;
            int shift = 6 - cls * 3;
            mode_t class_mask = (mode_t)7 << shift;
            mode_t class_bits = perm_bits << shift;

            if (c->op == '+')
                mode |= class_bits;
            else if (c->op == '-')
                mode &= ~class_bits;
            else /* '=' */
                mode = (mode & ~class_mask) | class_bits;
        }
    }
    return mode & 0777;
}

static void usage(void) {
    fprintf(stderr, "usage: new_chmod MODE FILE...\n");
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        usage();
        return 1;
    }

    const char *mode_str;
    int operand_start;

    if (strcmp(argv[1], "--") == 0) {
        if (argc < 3) {
            usage();
            return 1;
        }
        mode_str = argv[2];
        operand_start = 3;
    } else if (argv[1][0] == '-' && argv[1][1] != '\0') {
        /* Unknown option (starts with - but isn't --) */
        fprintf(stderr, "new_chmod: unknown option '%s'\n", argv[1]);
        usage();
        return 1;
    } else {
        mode_str = argv[1];
        operand_start = 2;
    }

    if (operand_start >= argc) {
        usage();
        return 1;
    }

    mode_spec_t spec;
    memset(&spec, 0, sizeof(spec));
    if (parse_mode(mode_str, &spec) != 0) {
        fprintf(stderr, "new_chmod: invalid mode: %s\n", mode_str);
        return 1;
    }

    int any_failed = 0;

    for (int i = operand_start; i < argc; i++) {
        const char *path = argv[i];
        struct stat st;

        if (stat(path, &st) != 0) {
            fprintf(stderr, "new_chmod: cannot access '%s': %s\n",
                    path, strerror(errno));
            any_failed = 1;
            continue;
        }

        int is_dir = S_ISDIR(st.st_mode);
        mode_t current = st.st_mode & 07777;
        mode_t new_mode;

        if (spec.is_octal) {
            new_mode = spec.octal_value;
        } else {
            new_mode = (current & 07000) | apply_symbolic(current, is_dir, &spec);
        }

        if (chmod(path, new_mode) != 0) {
            fprintf(stderr, "new_chmod: cannot change mode of '%s': %s\n",
                    path, strerror(errno));
            any_failed = 1;
        }
    }

    return any_failed ? 1 : 0;
}
