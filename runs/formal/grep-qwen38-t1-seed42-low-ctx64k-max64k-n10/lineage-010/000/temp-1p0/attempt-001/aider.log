static void die(const char *msg) {
    fprintf(stderr, "new_grep: %s\n", msg);
    exit(2);
}

// Search for `needle` (length `nlen`) in `haystack` (length `hlen`)
static int bytes_contains(const unsigned char *haystack, size_t hlen,
                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return 1; // empty pattern matches everything
    if (nlen > hlen) return 0;
    for (size_t i = 0; i + nlen <= hlen; i++) {
        if (memcmp(haystack + i, needle, nlen) == 0)
            return 1;
    }
    return 0;
}

// Read one line from fd. Returns 1 if a line was read, 0 on EOF.
// On success, *buf points to the line bytes (not including newline), *len is length.
// The line buffer is dynamically allocated and the caller must free it.
// Actually, let me use a reusable buffer approach.

typedef struct {
    unsigned char *buf;
    size_t len;
    size_t cap;
} DynBuf;

static int dynbuf_ensure(DynBuf *d, size_t need) {
    if (d->cap >= need) return 0;
    size_t newcap = d->cap ? d->cap : 256;
    while (newcap < need) {
        if (newcap > SIZE_MAX / 2) {
            return -1; // overflow
        }
        newcap *= 2;
    }
    unsigned char *p = realloc(d->buf, newcap);
    if (!p) return -1;
    d->buf = p;
    d->cap = newcap;
    return 0;
}

// Read one line from fd into d (reusable).
// Returns: 1 = got a line, 0 = EOF with no data, -1 = error
static int read_line(int fd, DynBuf *d) {
    d->len = 0;
    unsigned char c;
    int got_any = 0;
    while (1) {
        ssize_t n = read(fd, &c, 1);
        if (n < 0) return -1;
        if (n == 0) break; // EOF
        got_any = 1;
        if (c == '\n') break;
        if (dynbuf_ensure(d, d->len + 1) != 0) return -1;
        d->buf[d->len++] = c;
    }
    if (!got_any) return 0; // EOF, no line
    return 1;
}

