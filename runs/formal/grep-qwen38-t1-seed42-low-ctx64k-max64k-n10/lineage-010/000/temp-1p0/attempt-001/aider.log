```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>

static void oom(void) {
    fprintf(stderr, "new_grep: out of memory\n");
    exit(2);
}

static void *xrealloc(void *p, size_t n) {
    void *q = realloc(p, n);
    if (!q && n > 0) oom();
    return q;
}

static int bytes_contains(const unsigned char *hay, size_t hlen,
                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    for (size_t i = 0; i + nlen <= hlen; i++) {
        if (memcmp(hay + i, needle, nlen) == 0) return 1;
    }
    return 0;
}

// Process one input stream (fd), writing matching lines to stdout.
// Returns 0 on success, -1 on I/O error.
static int process_stream(int fd,
                          const unsigned char *pattern, size_t pattern_len,
                          const char *prefix) {
    // Read buffer
    enum { RBUF_SIZE = 8192 };
    unsigned char *rbuf = malloc(RBUF_SIZE);
    if (!rbuf) oom();
    
    // Line buffer (dynamic)
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    
    int had_data = 0; // did we read any byte from this stream?
    int rbuf_eof = 0;
    size_t rbuf_pos = 0;
    size_t rbuf_len = 0;
    
    while (1) {
        // Ensure we have data in rbuf
        if (rbuf_pos >= rbuf_len) {
            if (rbuf_eof) break;
            ssize_t n = read(fd, rbuf, RBUF_SIZE);
            if (n < 0) {
                if (errno == EINTR) continue;
                free(rbuf); free(line);
                return -1;
            }
            if (n == 0) { rbuf_eof = 1; break; }
            rbuf_len = (size_t)n;
            rbuf_pos = 0;
        }
        
        had_data = 1;
        unsigned char c = rbuf[rbuf_pos++];
        
        if (c == '\n') {
            // End of line - process it
            if (!bytes_contains(line, line_len, pattern, pattern_len)) {
                line_len = 0;
                continue;
            }
            // Write output
            if (prefix) {
                size_t pfx_len = strlen(prefix);
                if (fwrite(prefix, 1, pfx_len, stdout) != pfx_len) {
                    free(rbuf); free(line);
                    return -1;
                }
                if (fputc(':', stdout) == EOF) {
                    free(rbuf); free(line);
                    return -1;
                }
            }
            if (line_len > 0) {
                if (fwrite(line, 1, line_len, stdout) != line_len) {
                    free(rbuf); free(line);
                    return -1;
                }
            }
            if (fputc('\n', stdout) == EOF) {
                free(rbuf); free(line);
                return -1;
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                size_t newcap = line_cap ? line_cap * 2 : 256;
                if (newcap < line_len + 1) newcap = line_len + 1;
                line = xrealloc(line, newcap);
                line_cap = newcap;
            }
            line[line_len++] = c;
        }
    }
    
    // Handle final line without trailing newline
    if (line_len > 0 || had_data) {
        // Wait, this is tricky. If had_data is true and line_len > 0, we have a final line.
        // If had_data is true and line_len == 0, the last byte was \n so no final line.
        // If had_data is false, empty input, no lines at all.
        if (line_len > 0) {
            if (bytes_contains(line, line_len, pattern, pattern_len)) {
                if (prefix) {
                    size_t pfx_len = strlen(prefix);
                    if (fwrite(prefix, 1, pfx_len, stdout) != pfx_len) {
                        free(rbuf); free(line);
                        return -1;
                    }
                    if (fputc(':', stdout) == EOF) {
                        free(rbuf); free(line);
                        return -1;
                    }
                }
                if (fwrite(line, 1, line_len, stdout) != line_len) {
                    free(rbuf); free(line);
                    return -1;
                }
                if (fputc('\n', stdout) == EOF) {
                    free(rbuf); free(line);
                    return -1;
                }
            }
        }
    }
    
    free(rbuf);
    free(line);
    return 0;
}
