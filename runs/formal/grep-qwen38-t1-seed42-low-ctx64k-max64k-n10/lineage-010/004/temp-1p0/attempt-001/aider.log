```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>
#include <dirent.h>

static void oom(void) {
    fprintf(stderr, "new_grep: out of memory\n");
    exit(2);
}

static void *xrealloc(void *p, size_t n) {
    if (n == 0) { free(p); return NULL; }
    void *q = realloc(p, n);
    if (!q) oom();
    return q;
}

static int bytes_contains(const unsigned char *hay, size_t hlen,
                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    for (size_t i = 0; i <= hlen - nlen; i++) {
        if (memcmp(hay + i, needle, nlen) == 0) return 1;
    }
    return 0;
}

static unsigned char fold_byte(unsigned char c) {
    if (c >= 0x41 && c <= 0x5A) return c + 0x20;
    return c;
}

static int bytes_contains_icase(const unsigned char *hay, size_t hlen,
                                const unsigned char *fneedle, size_t nlen) {
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    for (size_t i = 0; i <= hlen - nlen; i++) {
        int match = 1;
        for (size_t j = 0; j < nlen; j++) {
            if (fold_byte(hay[i + j]) != fneedle[j]) {
                match = 0;
                break;
            }
        }
        if (match) return 1;
    }
    return 0;
}

static int write_selected(const unsigned char *line, size_t len,
                          const char *prefix) {
    if (prefix) {
        size_t plen = strlen(prefix);
        if (fwrite(prefix, 1, plen, stdout) != plen) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (len > 0) {
        if (fwrite(line, 1, len, stdout) != len) return -1;
    }
    if (fputc('\n', stdout) == EOF) return -1;
    return 0;
}

static int process_fd(int fd,
                      const unsigned char *pattern, size_t pattern_len,
                      const char *prefix,
                      int icase, int *found) {
    enum { RBUF_SIZE = 8192 };
    unsigned char *rbuf = malloc(RBUF_SIZE);
    if (!rbuf) oom();

    unsigned char *line = NULL;
    size_t line_len = 0, line_cap = 0;
    size_t rpos = 0, rlen = 0;
    int eof = 0;

    while (!eof) {
        if (rpos >= rlen) {
            ssize_t n;
            do { n = read(fd, rbuf, RBUF_SIZE); } while (n < 0 && errno == EINTR);
            if (n < 0) { free(rbuf); free(line); return -1; }
            if (n == 0) { eof = 1; break; }
            rlen = (size_t)n;
            rpos = 0;
        }

        unsigned char c = rbuf[rpos++];
        if (c == '\n') {
            int matched;
            if (icase)
                matched = bytes_contains_icase(line, line_len, pattern, pattern_len);
            else
                matched = bytes_contains(line, line_len, pattern, pattern_len);
            if (matched) {
                *found = 1;
                if (write_selected(line, line_len, prefix) != 0) {
                    free(rbuf); free(line);
                    return -1;
                }
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                size_t nc = line_cap ? line_cap * 2 : 256;
                if (nc < line_len + 1) nc = line_len + 1;
                line = xrealloc(line, nc);
                line_cap = nc;
            }
            line[line_len++] = c;
        }
    }

    if (line_len > 0) {
        int matched;
        if (icase)
            matched = bytes_contains_icase(line, line_len, pattern, pattern_len);
        else
            matched = bytes_contains(line, line_len, pattern, pattern_len);
        if (matched) {
            *found = 1;
            if (write_selected(line, line_len, prefix) != 0) {
                free(rbuf); free(line);
                return -1;
            }
        }
    }

    free(rbuf);
    free(line);
    return 0;
}

static int compare_names(const void *a, const void *b) {
    const char *sa = *(const char *const *)a;
    const char *sb = *(const char *const *)b;
    size_t la = strlen(sa), lb = strlen(sb);
    size_t min = la < lb ? la : lb;
    int cmp = memcmp(sa, sb, min);
    if (cmp != 0) return cmp;
    return (la > lb) - (la < lb);
}

static void traverse_dir(const char *dir_path, const char *display_base,
                         const unsigned char *pattern, size_t pattern_len,
                         int use_prefix, int icase,
                         int *any_match, int *any_error) {
    DIR *dp = opendir(dir_path);
    if (!dp) {
        fprintf(stderr, "new_grep: %s: %s\n", display_base, strerror(errno));
        *any_error = 1;
        return;
    }

    struct dirent *de;
    char **names = NULL;
    int count = 0, cap = 0;

    while ((de = readdir(dp)) != NULL) {
        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0)
            continue;
        if (count >= cap) {
            cap = cap ? cap * 2 : 16;
            names = xrealloc(names, (size_t)cap * sizeof(char *));
        }
        size_t nlen = strlen(de->d_name);
        char *copy = xrealloc(NULL, nlen + 1);
        memcpy(copy, de->d_name, nlen + 1);
        names[count++] = copy;
    }
    closedir(dp);

    qsort(names, (size_t)count, sizeof(char *), compare_names);

    for (int i = 0; i < count; i++) {
        size_t nlen = strlen(names[i]);

        size_t dplen = strlen(dir_path);
        int need_slash = !(dplen > 0 && dir_path[dplen - 1] == '/');
        char *full_path = xrealloc(NULL, dplen + (need_slash ? 1 : 0) + nlen + 1);
        memcpy(full_path, dir_path, dplen);
        size_t pos = dplen;
        if (need_slash) full_path[pos++] = '/';
        memcpy(full_path + pos, names[i], nlen + 1);

        size_t blen = strlen(display_base);
        int dneed_slash = !(blen > 0 && display_base[blen - 1] == '/');
        char *display = xrealloc(NULL, blen + (dneed_slash ? 1 : 0) + nlen + 1);
        memcpy(display, display_base, blen);
        size_t dpos = blen;
        if (dneed_slash) display[dpos++] = '/';
        memcpy(display + dpos, names[i], nlen + 1);

        struct stat st;
        if (lstat(full_path, &st) != 0) {
            fprintf(stderr, "new_grep: %s: %s\n", display, strerror(errno));
            *any_error = 1;
        } else if (S_ISLNK(st.st_mode)) {
            /* skip symlinks during traversal */
        } else if (S_ISREG(st.st_mode)) {
            int fd = open(full_path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", display, strerror(errno));
                *any_error = 1;
            } else {
                const char *prefix = use_prefix ? display : NULL;
                int found = 0;
                int ret = process_fd(fd, pattern, pattern_len, prefix, icase, &found);
                close(fd);
                if (ret != 0) {
                    fprintf(stderr, "new_grep: %s: read error\n", display);
                    *any_error = 1;
                }
                if (found) *any_match = 1;
            }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full_path, display, pattern, pattern_len,
                         use_prefix, icase, any_match, any_error);
        }

        free(full_path);
        free(display);
        free(names[i]);
    }

    free(names);
}

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
        return 2;
    }

    int prefix_mode = 0;
    int recursive = 0;
    int icase = 0;
    const char *pattern_str;
    const char **files;
    int nfiles;

    int argi = 1;
    int after_ddash = 0;

    while (argi < argc) {
        const char *arg = argv[argi];
        if (after_ddash) break;
        if (strcmp(arg, "--") == 0) {
            after_ddash = 1;
            argi++;
            continue;
        }
        if (strcmp(arg, "--with-filename") == 0) {
            prefix_mode = 1;
            argi++;
            continue;
        }
        if (strcmp(arg, "--no-filename") == 0) {
            prefix_mode = 2;
            argi++;
            continue;
        }
        if (strcmp(arg, "--recursive") == 0) {
            recursive = 1;
            argi++;
            continue;
        }
        if (strcmp(arg, "--ignore-case") == 0) {
            icase = 1;
            argi++;
            continue;
        }
        if (arg[0] == '-' && arg[1] != '\0') {
            for (const char *c = arg + 1; *c; c++) {
                if (*c == 'H') prefix_mode = 1;
                else if (*c == 'h') prefix_mode = 2;
                else if (*c == 'r') recursive = 1;
                else if (*c == 'i') icase = 1;
                else {
                    fprintf(stderr, "new_grep: unknown option: %s\n", arg);
                    return 2;
                }
            }
            argi++;
            continue;
        }
        break;
    }

    if (argi >= argc) {
        fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
        return 2;
    }

    pattern_str = argv[argi];
    argi++;
    files = (const char **)&argv[argi];
    nfiles = argc - argi;

    const unsigned char *pattern = (const unsigned char *)pattern_str;
    size_t pattern_len = strlen(pattern_str);

    unsigned char *folded_pattern = NULL;
    if (icase) {
        folded_pattern = xrealloc(NULL, pattern_len);
        for (size_t k = 0; k < pattern_len; k++)
            folded_pattern[k] = fold_byte(pattern[k]);
    }
    const unsigned char *match_pattern = icase ? folded_pattern : pattern;

    int use_prefix;
    if (prefix_mode == 1) use_prefix = 1;
    else if (prefix_mode == 2) use_prefix = 0;
    else if (nfiles >= 2) use_prefix = 1;
    else if (recursive) {
        use_prefix = 0;
        for (int j = 0; j < nfiles; j++) {
            struct stat st;
            if (stat(files[j], &st) == 0 && S_ISDIR(st.st_mode)) {
                use_prefix = 1;
                break;
            }
        }
    }
    else use_prefix = 0;

    int any_match = 0;
    int any_error = 0;

    if (nfiles == 0) {
        int found = 0;
        if (process_fd(STDIN_FILENO, match_pattern, pattern_len,
                       use_prefix ? "(standard input)" : NULL,
                       icase, &found) != 0) {
            if (ferror(stdout))
                fprintf(stderr, "new_grep: write error\n");
            else
                fprintf(stderr, "new_grep: error reading stdin\n");
            free(folded_pattern);
            return 2;
        }
        any_match = found;
    } else {
        for (int j = 0; j < nfiles; j++) {
            const char *path = files[j];
            struct stat st;
            if (stat(path, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                any_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
