```c
static int write_line(const unsigned char *line, size_t len,
                      bool do_prefix, const char *prefix) {
    if (do_prefix) {
        size_t prefix_len = strlen(prefix);
        if (prefix_len > 0) {
            if (write(STDOUT_FILENO, prefix, prefix_len) != (ssize_t)prefix_len) return -1;
            if (write(STDOUT_FILENO, ":", 1) != 1) return -1;
        }
    }
    if (len > 0) {
        if (write(STDOUT_FILENO, line, len) != (ssize_t)len) return -1;
    }
    if (write(STDOUT_FILENO, "\n", 1) != 1) return -1;
    return 0;
}
```

