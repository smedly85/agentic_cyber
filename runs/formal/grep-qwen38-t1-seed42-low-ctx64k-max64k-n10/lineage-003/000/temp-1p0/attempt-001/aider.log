```c
static int search_stream(inbuf_t *ib, const unsigned char *pat, size_t pat_len,
                         bool do_prefix, const char *prefix) {
    int found = 0;
    int error = 0;
    linebuf_t lb = {0};
    
    while (true) {
        unsigned char c;
        int r = inbuf_read_byte(ib, &c);
        if (r < 0) { error = 1; break; }
        if (r == 0) {
            // EOF
            if (lb.len > 0) {
                // Final line without trailing newline
                if (pattern_matches(lb.data, lb.len, pat, pat_len)) {
                    if (write_line(lb.data, lb.len, do_prefix, prefix) < 0) {
                        error = 1;
                        break;
                    }
                    found = 1;
                }
            }
            break;
        }
        if (c == '\n') {
            // Emit current line
            if (pattern_matches(lb.data, lb.len, pat, pat_len)) {
                if (write_line(lb.data, lb.len, do_prefix, prefix) < 0) {
                    error = 1;
                    break;
                }
                found = 1;
            }
            lb.len = 0;
        } else {
            if (linebuf_append(&lb, c) < 0) {
                error = 1;
                break;
            }
        }
    }
    
    free(lb.data);
    return error ? -1 : found;
}
```

