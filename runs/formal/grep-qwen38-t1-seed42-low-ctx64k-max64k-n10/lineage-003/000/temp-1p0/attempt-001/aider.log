```c
typedef struct {
    unsigned char *data;
    size_t len;
    size_t cap;
} linebuf_t;

static int linebuf_append(linebuf_t *lb, unsigned char c) {
    if (lb->len + 1 > lb->cap) {
        size_t new_cap = lb->cap ? lb->cap * 2 : 256;
        unsigned char *new_data = realloc(lb->data, new_cap);
        if (!new_data) return -1;
        lb->data = new_data;
        lb->cap = new_cap;
    }
    lb->data[lb->len++] = c;
    return 0;
}
```

