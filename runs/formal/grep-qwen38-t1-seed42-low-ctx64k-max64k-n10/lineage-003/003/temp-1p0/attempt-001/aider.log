static int traverse_dir(const char *path, const unsigned char *pat, size_t pat_len,
                        bool do_prefix, int depth) {
    int found = 0;
    int any_error = 0;
    
    if (depth > MAX_DEPTH) {
        fprintf(stderr, "new_grep: %s: maximum recursion depth exceeded\n", path);
        return -2; // error
    }
    
    DIR *d = opendir(path);
    if (!d) {
        fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
        return -2; // error
    }
    
    // Collect entries
    char **names = NULL;
    int n = 0, cap = 0;
    struct dirent *ent;
    while ((ent = readdir(d)) != NULL) {
        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
            continue;
        if (n + 1 > cap) {
            int ncap = cap ? cap * 2 : 16;
            char **tmp = realloc(names, (size_t)ncap * sizeof(char *));
            if (!tmp) { closedir(d); free(names); return -1; }
            names = tmp;
            cap = ncap;
        }
        names[n++] = strdup(ent->d_name);
        if (!names[n-1]) { 
            for (int i = 0; i < n; i++) free(names[i]);
            free(names); closedir(d); return -1; 
        }
    }
    closedir(d);
    
    // Sort
    qsort(names, (size_t)n, sizeof(char *), namecmp);
    
    // Process
    for (int i = 0; i < n; i++) {
        // Build full path
        size_t plen = strlen(path);
        // Strip trailing slashes for joining
        while (plen > 1 && path[plen - 1] == '/') plen--;
        size_t elen = strlen(names[i]);
        size_t total = plen + 1 + elen + 1; // +1 for '/', +1 for null
        char *full = malloc(total);
        if (!full) { for (int j = 0; j < n; j++) free(names[j]); free(names); return -1; }
        memcpy(full, path, plen);
        full[plen] = '/';
        memcpy(full + plen + 1, names[i], elen);
        full[plen + 1 + elen] = '\0';
        
        // Stat the entry (using lstat to check for symlinks)
        struct stat st;
        if (lstat(full, &st) < 0) {
            fprintf(stderr, "new_grep: %s: %s\n", full, strerror(errno));
            any_error = 1;
            free(full);
            continue;
        }
        
        if (S_ISLNK(st.st_mode)) {
            // Skip symlinks
            free(full);
            continue;
        }
        
        if (S_ISREG(st.st_mode)) {
            int fd = open(full, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", full, strerror(errno));
                any_error = 1;
                free(full);
                continue;
            }
            inbuf_t ib;
            ib.fd = fd;
            ib.pos = 0;
            ib.len = 0;
            memset(ib.buf, 0, sizeof(ib.buf));
            int r = search_stream(&ib, pat, pat_len, do_prefix, full);
            close(fd);
            if (r < 0) any_error = 1;
            else if (r > 0) found = 1;
        } else if (S_ISDIR(st.st_mode)) {
            int r = traverse_dir(full, pat, pat_len, do_prefix, depth + 1);
            if (r < -1) any_error = 1; // -2 means error
            else if (r > 0) found = 1;
        }
        
        free(full);
    }
    
    for (int i = 0; i < n; i++) free(names[i]);
    free(names);
    
    if (any_error) return -2;
    return found;
}
```

