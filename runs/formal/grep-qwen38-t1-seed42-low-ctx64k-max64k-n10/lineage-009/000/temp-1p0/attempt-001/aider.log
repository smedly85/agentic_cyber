Let me write the code:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>
#include <sys/stat.h>
#include <unistd.h>

static void die_usage(void) {
    fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
    exit(2);
}

// Read one line (without trailing newline) from stream.
// Returns a malloc'd buffer, sets *out_len.
// Returns NULL on EOF (no more lines) or on read error.
// Sets *got_data to 1 if at least one byte was read into this line.
static uint8_t *read_line(FILE *fp, size_t *out_len) {
    size_t cap = 256;
    size_t len = 0;
    uint8_t *buf = malloc(cap);
    if (!buf) return NULL;
    
    int c;
    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            *out_len = len;
            return buf;
        }
        if (len == cap) {
            cap *= 2;
            uint8_t *nb = realloc(buf, cap);
            if (!nb) { free(buf); return NULL; }
            buf = nb;
        }
        buf[len++] = (uint8_t)c;
    }
    
    // EOF reached
    if (len == 0) {
        free(buf);
        *out_len = 0;
        return NULL;  // no more data
    }
    *out_len = len;
    return buf;
}

// Check if pattern occurs in line
static int line_matches(const uint8_t *line, size_t line_len,
                        const uint8_t *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (pat_len > line_len) return 0;
    return memmem(line, line_len, pat, pat_len) != NULL;
}

int main(int argc, char *argv[]) {
    // Parse arguments
    if (argc < 2) die_usage();
    
    const char *pattern;
    char **files;
    int nfiles;
    
    if (strcmp(argv[1], "--") == 0) {
        if (argc < 3) die_usage();
        pattern = argv[2];
        files = &argv[3];
        nfiles = argc - 3;
    } else if (argv[1][0] == '-' && argv[1][1] != '\0') {
        // Unknown option (not bare '-', not '--')
        fprintf(stderr, "new_grep: unknown option: %s\n", argv[1]);
        exit(2);
    } else {
        pattern = argv[1];
        files = &argv[2];
        nfiles = argc - 2;
    }
    
    size_t pat_len = strlen(pattern);
    uint8_t *pat_bytes = (uint8_t *)pattern;
    
    int prefix = (nfiles >= 2);
    int has_match = 0;
    int has_error = 0;
    
    if (nfiles == 0) {
        // Search stdin
        uint8_t *line;
        size_t line_len;
        while ((line = read_line(stdin, &line_len)) != NULL) {
            if (line_matches(line, line_len, pat_bytes, pat_len)) {
                // Write line + newline
                if (fwrite(line, 1, line_len, stdout) != line_len) {
                    fprintf(stderr, "new_grep: write error\n");
                    free(line);
                    exit(2);
                }
                if (fputc('\n', stdout) == EOF) {
                    fprintf(stderr, "new_grep: write error\n");
                    free(line);
                    exit(2);
                }
                has_match = 1;
            }
            free(line);
        }
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *fname = files[i];
            
            struct stat st;
            if (stat(fname, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", fname, strerror(errno));
                has_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: is a directory\n", fname);
                has_error = 1;
                continue;
            }
            
            FILE *fp = fopen(fname, "rb");
            if (!fp) {
                fprintf(stderr, "new_grep: %s: %s\n", fname, strerror(errno));
                has_error = 1;
                continue;
            }
            
            uint8_t *line;
            size_t line_len;
            while ((line = read_line(fp, &line_len)) != NULL) {
                if (line_matches(line, line_len, pat_bytes, pat_len)) {
                    if (prefix) {
                        if (fputs(fname, stdout) == EOF) {
                            fprintf(stderr, "new_grep: write error\n");
                            free(line); fclose(fp);
                            exit(2);
                        }
                        if (fputc(':', stdout) == EOF) {
                            fprintf(stderr, "new_grep: write error\n");
                            free(line); fclose(fp);
                            exit(2);
                        }
                    }
                    if (fwrite(line, 1, line_len, stdout) != line_len) {
                        fprintf(stderr, "new_grep: write error\n");
                        free(line); fclose(fp);
                        exit(2);
                    }
                    if (fputc('\n', stdout) == EOF) {
                        fprintf(stderr, "new_grep: write error\n");
                        free(line); fclose(fp);
                        exit(2);
                    }
                    has_match = 1;
                }
                free(line);
            }
            
            // Check for read errors
            if (ferror(fp)) {
                fprintf(stderr, "new_grep: %s: read error\n", fname);
                has_error = 1;
            }
            fclose(fp);
        }
    }
    
    fflush(stdout);
    if (ferror(stdout)) {
        fprintf(stderr, "new_grep: write error\n");
        return 2;
    }
    
    if (has_error) return 2;
    if (has_match) return 0;
    return 1;
}
```

