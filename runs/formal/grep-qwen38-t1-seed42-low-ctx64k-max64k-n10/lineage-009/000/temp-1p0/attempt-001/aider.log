#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>
#include <sys/stat.h>

static void usage_error(const char *msg) {
    fprintf(stderr, "new_grep: %s\n", msg);
    fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
    exit(2);
}

static void oom(void) {
    fprintf(stderr, "new_grep: out of memory\n");
    exit(2);
}

static void write_error(void) {
    fprintf(stderr, "new_grep: write error\n");
    exit(2);
}

// Find needle in haystack (both length-based, no NUL assumption)
static int bytes_contains(const uint8_t *hay, size_t hay_len,
                          const uint8_t *needle, size_t needle_len) {
    if (needle_len == 0) return 1;
    if (needle_len > hay_len) return 0;
    for (size_t i = 0; i + needle_len <= hay_len; i++) {
        if (memcmp(hay + i, needle, needle_len) == 0)
            return 1;
    }
    return 0;
}

// Read one line from fp into a malloc'd buffer.
// On success: returns pointer, sets *out_len.
// On EOF with no pending data: returns NULL.
// On allocation failure: calls oom().
static uint8_t *read_line(FILE *fp, size_t *out_len) {
    size_t cap = 256;
    size_t len = 0;
    uint8_t *buf = malloc(cap);
    if (!buf) oom();
    
    int c;
    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            *out_len = len;
            return buf;
        }
        if (len == cap) {
            if (cap > (size_t)-1 / 2) oom();
            cap *= 2;
            uint8_t *nb = realloc(buf, cap);
            if (!nb) { free(buf); oom(); }
            buf = nb;
        }
        buf[len++] = (uint8_t)c;
    }
    
    if (len == 0) {
        free(buf);
        *out_len = 0;
        return NULL;
    }
    *out_len = len;
    return buf;
}

static int search_stream(FILE *fp, const char *prefix_str,
                         int prefix, const uint8_t *pat, size_t pat_len,
                         int *has_match) {
    uint8_t *line;
    size_t line_len;
    
    while ((line = read_line(fp, &line_len)) != NULL) {
        if (bytes_contains(line, line_len, pat, pat_len)) {
            if (prefix && prefix_str) {
                size_t plen = strlen(prefix_str);
                if (fwrite(prefix_str, 1, plen, stdout) != plen) write_error();
                if (fputc(':', stdout) == EOF) write_error();
            }
            if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len)
                write_error();
            if (fputc('\n', stdout) == EOF) write_error();
            *has_match = 1;
        }
        free(line);
    }
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        usage_error("missing PATTERN");
    }
    
    const char *pattern;
    char **files;
    int nfiles;
    
    if (strcmp(argv[1], "--") == 0) {
        if (argc < 3) usage_error("missing PATTERN after --");
        pattern = argv[2];
        files = &argv[3];
        nfiles = argc - 3;
    } else if (argv[1][0] == '-' && argv[1][1] != '\0') {
        usage_error("unknown option");
    } else {
        pattern = argv[1];
        files = &argv[2];
        nfiles = argc - 2;
    }
    
    size_t pat_len = strlen(pattern);
    const uint8_t *pat = (const uint8_t *)pattern;
    int prefix = (nfiles >= 2);
    int has_match = 0;
    int has_error = 0;
    
    if (nfiles == 0) {
        search_stream(stdin, NULL, 0, pat, pat_len, &has_match);
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *fname = files[i];
            
            struct stat st;
            if (stat(fname, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", fname, strerror(errno));
                has_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: is a directory\n", fname);
                has_error = 1;
                continue;
            }
            
            FILE *fp = fopen(fname, "rb");
            if (!fp) {
                fprintf(stderr, "new_grep: %s: %s\n", fname, strerror(errno));
                has_error = 1;
                continue;
            }
            
            search_stream(fp, fname, prefix, pat, pat_len, &has_match);
            
            if (ferror(fp)) {
                fprintf(stderr, "new_grep: %s: read error\n", fname);
                has_error = 1;
            }
            fclose(fp);
        }
    }
    
    fflush(stdout);
    if (ferror(stdout)) {
        fprintf(stderr, "new_grep: write error\n");
        return 2;
    }
    
    if (has_error) return 2;
    if (has_match) return 0;
    return 1;
}
