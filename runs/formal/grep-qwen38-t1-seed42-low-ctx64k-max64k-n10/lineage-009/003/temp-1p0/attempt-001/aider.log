#include <dirent.h>

// Add a recursive flag
int recursive = 0;

// For sorting directory entries
static int cmp_names(const void *a, const void *b) {
    const char *na = *(const char *const *)a;
    const char *nb = *(const char *const *)b;
    return strcmp(na, nb);
}

// Recursive traversal
static void traverse_dir(const char *path, const uint8_t *pat, size_t pat_len, int *has_match, int *has_error) {
    DIR *dp = opendir(path);
    if (!dp) {
        fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
        *has_error = 1;
        return;
    }
    
    // Read all entries
    struct dirent *entry;
    char **names = NULL;
    size_t n = 0, cap = 0;
    
    while ((entry = readdir(dp)) != NULL) {
        // Skip . and ..
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
        if (n == cap) {
            cap = cap ? cap * 2 : 16;
            names = realloc(names, cap * sizeof(char*));
            if (!names) { closedir(dp); oom(); }
        }
        names[n] = strdup(entry->d_name);
        if (!names[n]) { closedir(dp); oom(); }
        n++;
    }
    closedir(dp);
    
    // Sort by name
    qsort(names, n, sizeof(char*), cmp_names);
    
    // Process each entry
    for (size_t i = 0; i < n; i++) {
        // Build full path
        size_t path_len = strlen(path) + 1 + strlen(names[i]);
        char *full = malloc(path_len + 1);
        if (!full) { free(names[i]); free(names); oom(); }
        // Handle trailing slash
        const char *base = path;
        size_t blen = strlen(base);
        int need_slash = (blen == 0 || base[blen - 1] != '/');
        if (need_slash)
            snprintf(full, path_len + 1, "%s/%s", base, names[i]);
        else
            snprintf(full, path_len + 1, "%s%s", base, names[i]);
        
        struct stat st;
        if (lstat(full, &st) != 0) {
            // Skip if we can't stat it
            free(full); free(names[i]); continue;
        }
        
        if (S_ISLNK(st.st_mode)) {
            // Skip symlinks during traversal
        } else if (S_ISREG(st.st_mode)) {
            FILE *fp = fopen(full, "rb");
            if (!fp) {
                fprintf(stderr, "new_grep: %s: %s\n", full, strerror(errno));
                *has_error = 1;
            } else {
                search_stream(fp, full, pat, pat_len, has_match);
                if (ferror(fp)) {
                    fprintf(stderr, "new_grep: %s: read error\n", full);
                    *has_error = 1;
                }
                fclose(fp);
            }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full, pat, pat_len, has_match, has_error);
        }
        
        free(full);
    }
    
    for (size_t i = 0; i < n; i++) free(names[i]);
    free(names);
}
