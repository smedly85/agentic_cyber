                    prefix_mode = 0;
                    continue;
                }
                if (strcmp(argv[i], "--recursive") == 0) {
                    recursive = 1;
                    continue;
                }
                if (argv[i][1] != '-') {
                    for (size_t j = 1; argv[i][j] != '\0'; j++) {
                        if (argv[i][j] == 'H')
                            prefix_mode = 1;
                        else if (argv[i][j] == 'h')
