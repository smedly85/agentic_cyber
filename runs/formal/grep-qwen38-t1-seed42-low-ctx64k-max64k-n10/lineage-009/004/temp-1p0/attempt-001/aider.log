    for (size_t i = 0; i + needle_len <= hay_len; i++) {
        int match = 1;
        for (size_t j = 0; j < needle_len; j++) {
            uint8_t h = ci ? fold_byte(hay[i + j]) : hay[i + j];
            if (h != needle[j]) { match = 0; break; }
