    for (int i = 0; i < count; i++) {
        // Build full path
        size_t dlen = strlen(dir_path);
        size_t nlen = strlen(names[i]);
        char *full_path = malloc(dlen + 1 + nlen + 1);
        memcpy(full_path, dir_path, dlen);
        full_path[dlen] = '/';
        memcpy(full_path + dlen + 1, names[i], nlen + 1);
        
