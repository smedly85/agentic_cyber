                    built_prefix[plen] = '/';
                    memcpy(built_prefix + plen + 1, names[i], nlen + 1);
                    file_prefix = built_prefix;
                }
                int result = search_file(full_path, pattern, pat_len, file_prefix);
                if (result == -1) *has_error = 1;
                else if (result == 0) *found_any = 1;
                free(built_prefix);
            } else if (S_ISDIR(st.st_mode)) {
                const char *child_prefix = NULL;
                char *built_child_prefix = NULL;
                if (prefix) {
                    size_t plen = strlen(prefix);
                    built_child_prefix = malloc(plen + 1 + nlen + 1);
                    memcpy(built_child_prefix, prefix, plen);
                    built_child_prefix[plen] = '/';
