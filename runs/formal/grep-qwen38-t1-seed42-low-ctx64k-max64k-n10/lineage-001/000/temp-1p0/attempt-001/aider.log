        fprintf(stderr, "new_grep: unknown option '%s'\n", argv[1]);
        return 2;
    } else {
        pattern_idx = 1;
    }
    
    const char *pattern_str = argv[pattern_idx];
    size_t pattern_len = strlen(pattern_str);
    const unsigned char *pattern = (const unsigned char *)pattern_str;
    
    int file_count = argc - (pattern_idx + 1);
    char **files = &argv[pattern_idx + 1];
    
    int found_match = 0;
    int had_error = 0;
    
    if (file_count == 0) {
