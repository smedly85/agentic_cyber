```c
static int process_stream(int fd, const unsigned char *pattern, size_t pattern_len,
                          const char *filename, int prefix, int *found_match, int *had_error) {
    enum { CHUNK = 65536 };
    unsigned char *chunk = malloc(CHUNK);
    if (!chunk) return -1;
    
    // We need to handle the case where a line spans chunk boundaries.
    // Strategy: read into chunk, find newlines, process complete lines,
    // keep the incomplete tail for next iteration.
    
    unsigned char *pending = NULL;
    size_t pending_len = 0;
    int eof = 0;
    int error = 0;
    
    while (!eof) {
        ssize_t n = read(fd, chunk, CHUNK);
        if (n < 0) {
            error = 1;
            break;
        }
        if (n == 0) {
            eof = 1;
        }
        
        // Process the data: pending + chunk[0..n-1]
        size_t total = pending_len + n;
        unsigned char *data;
        if (pending_len > 0 && n > 0) {
            data = malloc(total);
            if (!data) { error = 1; break; }
            memcpy(data, pending, pending_len);
            memcpy(data + pending_len, chunk, n);
        } else if (pending_len > 0) {
            data = pending;
            pending = NULL;
        } else if (n > 0) {
            data = chunk; // careful: don't free chunk
            // Actually let's always copy to be safe
            data = malloc(n);
            if (!data) { error = 1; break; }
            memcpy(data, chunk, n);
        } else {
            // n == 0 and pending_len == 0: nothing to do
            if (pending) { free(pending); pending = NULL; }
            break;
        }
        
        // Find the last newline in data[0..total-1]
        // Everything up to and including the last newline is complete lines.
        // Anything after is pending for next iteration.
        
        size_t last_nl = (size_t)-1;
        for (size_t i = total; i > 0; i--) {
            if (data[i-1] == '\n') {
                last_nl = i - 1;
                break;
            }
        }
        
        size_t complete_len;
        if (last_nl != (size_t)-1) {
            complete_len = last_nl + 1; // include the newline
        } else if (eof) {
            complete_len = total; // no newline, but it's EOF, so it's a complete line
        } else {
            complete_len = 0; // no complete line yet
        }
        
        if (complete_len > 0) {
            // Process lines in data[0..complete_len-1]
            size_t pos = 0;
            while (pos < complete_len) {
                // Find end of this line
                size_t line_end = pos;
                while (line_end < complete_len && data[line_end] != '\n') line_end++;
                // line is data[pos..line_end], length = line_end - pos
                size_t line_len = line_end - pos;
                
                // Check if pattern is in this line
                int match = 0;
                if (pattern_len == 0) {
                    match = 1;
                } else if (line_len >= pattern_len) {
                    for (size_t i = 0; i <= line_len - pattern_len; i++) {
                        if (memcmp(data + pos + i, pattern, pattern_len) == 0) {
                            match = 1;
                            break;
                        }
                    }
                }
                
                if (match) {
                    if (prefix) {
                        fputs(filename, stdout);
                        putchar(':');
                    }
                    fwrite(data + pos, 1, line_len, stdout);
                    if (line_end < complete_len) {
                        // line had a newline, it's already in data
                        // wait, line_end points to the \n, so data[pos..line_end-1] is the line content
                        // and data[line_end] is \n. So we should write line_len+1 bytes?
                        // No wait: I defined line as data[pos..line_end] where line_end is the index of \n.
                        // So the line content is data[pos..line_end-1], length line_end-pos = line_len.
                        // The newline is at data[line_end].
                        // If we want to output the line WITH newline, we write line_len bytes + 1 for \n.
                        // But if there's no trailing newline (EOF case), we write line_len bytes + 1 for \n.
                        // Actually, let me reconsider.
                    }
                    // Write newline
                    putchar('\n');
                    *found_match = 1;
                }
                
                pos = line_end + 1; // skip past the newline
            }
        }
        
        // Set up pending for next iteration
        if (pending) { free(pending); }
        if (complete_len < total) {
            pending = malloc(total - complete_len);
            if (!pending) { error = 1; break; }
            memcpy(pending, data + complete_len, total - complete_len);
            pending_len = total - complete_len;
        } else {
            pending = NULL;
            pending_len = 0;
        }
        
        if (data != chunk) free(data);
    }
    
    if (pending) free(pending);
    free(chunk);
    *had_error = error;
    return error ? -1 : 0;
}
