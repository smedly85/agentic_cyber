#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>

static int bytes_contains(const unsigned char *hay, size_t hay_len,
                          const unsigned char *needle, size_t needle_len) {
    if (needle_len == 0) return 1;
    if (hay_len < needle_len) return 0;
    for (size_t i = 0; i <= hay_len - needle_len; i++) {
        if (memcmp(hay + i, needle, needle_len) == 0) return 1;
    }
    return 0;
}

static int write_line(const unsigned char *line, size_t len,
                      const char *filename, int use_prefix) {
    if (use_prefix) {
        if (fputs(filename, stdout) == EOF) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (len > 0 && fwrite(line, 1, len, stdout) != len) return -1;
    if (fputc('\n', stdout) == EOF) return -1;
    return 0;
}

static int search_stream(int fd, const unsigned char *pattern, size_t pattern_len,
                         const char *filename, int use_prefix,
                         int *found_match, int *write_error) {
    *write_error = 0;
    enum { BUFSZ = 65536 };
    unsigned char *rbuf = malloc(BUFSZ);
    size_t line_cap = 256;
    unsigned char *line_buf = malloc(line_cap);
    if (!rbuf || !line_buf) {
        free(rbuf);
        free(line_buf);
        return -1;
    }
    size_t line_len = 0;
    int eof = 0;
    
    while (!eof) {
        ssize_t n = read(fd, rbuf, BUFSZ);
        if (n < 0) {
            free(rbuf);
            free(line_buf);
            return -1;
        }
        if (n == 0) {
            eof = 1;
            break;
        }
        
        for (ssize_t i = 0; i < n; i++) {
            if (rbuf[i] == '\n') {
                if (bytes_contains(line_buf, line_len, pattern, pattern_len)) {
                    if (write_line(line_buf, line_len, filename, use_prefix) != 0) {
                        *write_error = 1;
                        free(rbuf);
                        free(line_buf);
                        return -1;
                    }
                    *found_match = 1;
                }
                line_len = 0;
            } else {
                if (line_len + 1 >= line_cap) {
                    size_t new_cap = line_cap * 2;
                    unsigned char *nb = realloc(line_buf, new_cap);
                    if (!nb) {
                        free(rbuf);
                        free(line_buf);
                        return -1;
                    }
                    line_buf = nb;
                    line_cap = new_cap;
                }
                line_buf[line_len++] = rbuf[i];
            }
        }
    }
    
    if (line_len > 0) {
        if (bytes_contains(line_buf, line_len, pattern, pattern_len)) {
            if (write_line(line_buf, line_len, filename, use_prefix) != 0) {
                *write_error = 1;
                free(rbuf);
                free(line_buf);
                return -1;
            }
            *found_match = 1;
        }
    }
    
    free(rbuf);
    free(line_buf);
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        return 2;
    }
    
    int pattern_idx;
    if (strcmp(argv[1], "--") == 0) {
        if (argc < 3) {
            fprintf(stderr, "new_grep: missing PATTERN\n");
