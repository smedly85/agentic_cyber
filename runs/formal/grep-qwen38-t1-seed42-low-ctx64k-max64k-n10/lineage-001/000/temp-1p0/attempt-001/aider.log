        if (search_stream(STDIN_FILENO, pattern, pattern_len,
                          NULL, 0, &found_match, &write_error) != 0) {
            return 2;
        }
        if (write_error) return 2;
        return found_match ? 0 : 1;
    }
    
    int use_prefix = (file_count >= 2);
    
    for (int i = 0; i < file_count; i++) {
        const char *fname = files[i];
        
        struct stat st;
        if (stat(fname, &st) == 0 && S_ISDIR(st.st_mode)) {
            fprintf(stderr, "new_grep: %s: Is a directory\n", fname);
            had_error = 1;
            continue;
        }
        
        int fd = open(fname, O_RDONLY);
        if (fd < 0) {
            fprintf(stderr, "new_grep: %s: %s\n", fname, strerror(errno));
            had_error = 1;
            continue;
        }
        
        int write_error = 0;
