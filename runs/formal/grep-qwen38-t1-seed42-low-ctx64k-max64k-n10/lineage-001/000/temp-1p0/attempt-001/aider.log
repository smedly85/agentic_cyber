#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <getopt.h>
#include <errno.h>

#define MAX_LINE_LEN 65536

// Simple fixed-string search
int contains_pattern(const char *line, const char *pattern) {
    if (*pattern == '\0') return 1;  // Empty pattern matches everything
    return strstr(line, pattern) != NULL;
}

int main(int argc, char *argv[]) {
    // Parse options - we don't support any options yet
    int opt;
    while ((opt = getopt(argc, argv, "+")) != -1) {
        if (opt == '?') {
            fprintf(stderr, "Usage: grep pattern [file...]\n");
            return 2;
        }
    }
    
    // Reset optind for actual argument parsing
    optind = 1;
    
    // Find the pattern (first non-option argument)
    int pattern_idx = -1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) break;
        if (argv[i][0] == '-' && strlen(argv[i]) > 1) {
            // Skip options
            continue;
        }
        pattern_idx = i;
        break;
    }
    
    if (pattern_idx == -1) {
        fprintf(stderr, "Usage: grep pattern [file...]\n");
        return 2;
    }
    
    const char *pattern = argv[pattern_idx];
    
    // Determine files to search
    int file_count = argc - (pattern_idx + 1);
    char **files = &argv[pattern_idx + 1];
    
    // If no files, read from stdin
    if (file_count == 0) {
        char line[MAX_LINE_LEN];
        while (fgets(line, sizeof(line), stdin) != NULL) {
            if (contains_pattern(line, pattern)) {
                printf("%s", line);
            }
        }
        return 0;
    }
    
    // Search in files
    int exit_code = 1;  // Default to no match
    
    for (int i = 0; i < file_count; i++) {
        FILE *fp = fopen(files[i], "r");
        if (fp == NULL) {
            fprintf(stderr, "%s: %s\n", files[i], strerror(errno));
            exit_code = 2;
            continue;
        }
        
        char line[MAX_LINE_LEN];
        int has_match = 0;
        
        while (fgets(line, sizeof(line), fp) != NULL) {
            if (contains_pattern(line, pattern)) {
                if (file_count > 1) {
                    printf("%s:", files[i]);
                }
                printf("%s", line);
                has_match = 1;
                exit_code = 0;
            }
        }
        
        fclose(fp);
    }
    
    return exit_code;
}
