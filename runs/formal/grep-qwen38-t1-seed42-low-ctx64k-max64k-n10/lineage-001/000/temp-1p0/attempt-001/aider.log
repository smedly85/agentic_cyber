```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>

// Read a line (including trailing newline if present) from fd.
// Returns malloc'd buffer, sets *len. Returns NULL on EOF (no more data) or error.
// If *had_data is set to 0, it means EOF with no data read.
static unsigned char *read_line(int fd, size_t *len, int *had_error) {
    *len = 0;
    *had_error = 0;
    
    size_t cap = 256;
    unsigned char *buf = malloc(cap);
    if (!buf) return NULL;
    
    size_t total = 0;
    int eof = 0;
    
    while (!eof) {
        // Read one byte at a time to find newline (or use larger reads)
        // Actually, let's read in chunks for efficiency
        if (total + 1 >= cap) {
            cap *= 2;
            unsigned char *newbuf = realloc(buf, cap);
            if (!newbuf) {
                free(buf);
                *had_error = 1;
                return NULL;
            }
            buf = newbuf;
        }
        
        ssize_t n = read(fd, buf + total, 1);
        if (n < 0) {
            free(buf);
            *had_error = 1;
            return NULL;
        }
        if (n == 0) {
            eof = 1;
            break;
        }
        
        total++;
        if (buf[total - 1] == '\n') {
            break;
        }
    }
    
    *len = total;
    if (total == 0) {
        free(buf);
        return NULL;
    }
    return buf;
}
