static int search_file(const char *filename, const unsigned char *pattern, size_t pat_len,
                       const char *prefix) {
    struct stat st;
    if (stat(filename, &st) == 0 && S_ISDIR(st.st_mode)) {
        fprintf(stderr, "new_grep: %s: Is a directory\n", filename);
        return -1;
    }
    
    FILE *fp = fopen(filename, "r");
    if (!fp) {
        fprintf(stderr, "new_grep: %s: %s\n", filename, strerror(errno));
        return -1;
    }
    
    int result = search_stream(fp, pattern, pat_len, prefix);
    fclose(fp);
    return result;
}

int main(int argc, char *argv[]) {
    // Parse arguments
    // Accept: new_grep PATTERN [FILE...]
    //          new_grep -- PATTERN [FILE...]
    // Reject: any unknown option (starts with -, not bare -, not --)
    //         no arguments
    
    int start = 1; // index of first argument
    int after_double_dash = 0;
    
    // Check for -- terminator
    if (argc >= 2 && strcmp(argv[1], "--") == 0) {
        start = 2;
        after_double_dash = 1;
    } else {
        // No --; check for unknown options
        // The first non-option arg is the pattern
        // Any arg starting with - (other than bare -) before the pattern is an unknown option
        // Actually, the spec says: "Any argument that begins with -, other than a bare - (an operand) and -- (the terminator), is an unknown option."
        // And: "Reject, before anything is searched: an unknown option, short or long"
        // So if argv[1] starts with - and is not bare - and not --, it's an error.
        if (argc < 2) {
            fprintf(stderr, "Usage: new_grep PATTERN [FILE...]\n");
            return 2;
        }
        if (argv[1][0] == '-' && argv[1][1] != '\0') {
            // Unknown option
            fprintf(stderr, "Usage: new_grep PATTERN [FILE...]\n");
            return 2;
        }
    }
    
    if (start >= argc) {
        fprintf(stderr, "Usage: new_grep PATTERN [FILE...]\n");
        return 2;
    }
    
    const char *pattern = argv[start];
    size_t pat_len = strlen(pattern);
    int file_start = start + 1;
    int file_count = argc - file_start;
    
    // Determine if we need filename prefix
    int show_prefix = (file_count >= 2);
    
    int has_error = 0;
    int found_any = 0;
    
    if (file_count == 0) {
        // Search stdin
        int result = search_stream(stdin, (const unsigned char *)pattern, pat_len, NULL);
        if (result == -1) {
            fprintf(stderr, "new_grep: error reading stdin\n");
            return 2;
        }
        return result; // 0 if found, 1 if not
    }
    
    for (int i = 0; i < file_count; i++) {
        const char *filename = argv[file_start + i];
        int result = search_file(filename, (const unsigned char *)pattern, pat_len,
                                 show_prefix ? filename : NULL);
        if (result == -1) {
            has_error = 1;
        } else if (result == 0) {
            found_any = 1;
        }
    }
    
    if (has_error) return 2;
    return found_any ? 0 : 1;
}
