#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>

typedef struct {
    unsigned char *data;
    size_t len;
    size_t cap;
} buf_t;

static int buf_reserve(buf_t *b, size_t need) {
    if (b->cap >= need) return 0;
    size_t newcap = b->cap ? b->cap : 256;
    while (newcap < need) newcap *= 2;
    if (newcap < 1) newcap = 1; // overflow check
    unsigned char *p = realloc(b->data, newcap);
    if (!p) return -1;
    b->data = p;
    b->cap = newcap;
    return 0;
}

static int buf_push(buf_t *b, unsigned char c) {
    if (buf_reserve(b, b->len + 1) != 0) return -1;
    b->data[b->len++] = c;
    return 0;
}

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t plen) {
    if (plen == 0) return 1;
    if (plen > len) return 0;
    for (size_t i = 0; i <= len - plen; i++) {
        if (memcmp(line + i, pat, plen) == 0) return 1;
    }
    return 0;
}

static int write_line(const char *prefix, size_t prefix_len,
                      const unsigned char *line, size_t len) {
    if (prefix_len > 0) {
        if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (len > 0) {
        if (fwrite(line, 1, len, stdout) != len) return -1;
    }
    if (fputc('\n', stdout) == EOF) return -1;
    return 0;
}

// Returns 1 if a line was read (and stored in buf), 0 if EOF, -1 on error
static int read_line(int fd, buf_t *buf) {
    buf->len = 0;
    
    while (1) {
        unsigned char c;
        ssize_t r;
        do {
            r = read(fd, &c, 1);
        } while (r == -1 && errno == EINTR);
        
        if (r == 0) {
            return buf->len > 0 ? 1 : 0;
        }
        if (r < 0) return -1;
        
        if (c == '\n') return 1;
        
        if (buf_push(buf, c) != 0) return -1;
    }
}

static int process_fd(int fd, const unsigned char *pat, size_t plen,
                      const char *prefix, size_t prefix_len) {
    buf_t line = {0};
    int found = 0;
    
    while (1) {
        int rc = read_line(fd, &line);
        if (rc < 0) { free(line.data); return -1; }
        if (rc == 0) break;
        
        if (line_matches(line.data, line.len, pat, plen)) {
            if (write_line(prefix, prefix_len, line.data, line.len) != 0) {
                free(line.data);
                return -1;
            }
            found = 1;
        }
    }
    
    free(line.data);
    return found;
}

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        return 2;
    }
    
    const char *pattern;
    size_t plen;
    const char **files;
    int nfiles;
    
    if (strcmp(argv[1], "--") == 0) {
        if (argc < 3) {
            fprintf(stderr, "new_grep: missing PATTERN after --\n");
            return 2;
        }
        pattern = argv[2];
        plen = strlen(pattern);
        files = (const char **)&argv[3];
        nfiles = argc - 3;
    } else {
        if (argv[1][0] == '-' && argv[1][1] != '\0') {
            fprintf(stderr, "new_grep: unknown option: %s\n", argv[1]);
            return 2;
        }
        pattern = argv[1];
        plen = strlen(pattern);
        files = (const char **)&argv[2];
        nfiles = argc - 2;
    }
    
    int use_prefix = (nfiles >= 2);
    int any_match = 0;
    int any_error = 0;
    
    if (nfiles == 0) {
        int rc = process_fd(0, (const unsigned char *)pattern, plen, NULL, 0);
        if (rc < 0) {
            fprintf(stderr, "new_grep: error reading standard input\n");
            fflush(stdout);
            return 2;
        }
        any_match = rc;
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *path = files[i];
            
            struct stat st;
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: is a directory\n", path);
                any_error = 1;
                continue;
            }
            
            int fd = open(path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                any_error = 1;
                continue;
            }
            
            const char *prefix = use_prefix ? path : NULL;
            size_t prefix_len = use_prefix ? strlen(path) : 0;
            
            int rc = process_fd(fd, (const unsigned char *)pattern, plen, prefix, prefix_len);
            close(fd);
            
            if (rc < 0) {
                fprintf(stderr, "new_grep: %s: read error\n", path);
                any_error = 1;
            } else if (rc > 0) {
                any_match = 1;
            }
        }
    }
    
    if (fflush(stdout) != 0 || ferror(stdout)) {
        fprintf(stderr, "new_grep: error writing output\n");
        return 2;
    }
    
    if (any_error) return 2;
    return any_match ? 0 : 1;
}
