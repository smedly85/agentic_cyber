static const unsigned char *find_pattern(const unsigned char *haystack, size_t haylen,
                                          const unsigned char *needle, size_t needlen) {
    if (needlen == 0) return haystack;
    if (needlen > haylen) return NULL;
    for (size_t i = 0; i <= haylen - needlen; i++) {
        if (memcmp(haystack + i, needle, needlen) == 0)
            return haystack + i;
    }
    return NULL;
}
```

