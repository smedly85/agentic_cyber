#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <getopt.h>
#include <errno.h>
#include <sys/stat.h>

#define MAX_LINE_LEN 65536

// Simple fixed-string search for byte-oriented matching
int contains_pattern(const char *line, size_t len, const char *pattern) {
    size_t pat_len = strlen(pattern);
    if (pat_len == 0) return 1;  // Empty pattern matches everything
    if (pat_len > len) return 0;
    
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pattern, pat_len) == 0) {
            return 1;
        }
    }
    return 0;
}

int main(int argc, char *argv[]) {
    // Parse options - we don't support any options yet
    int opt;
    while ((opt = getopt(argc, argv, "+")) != -1) {
        if (opt == '?') {
            fprintf(stderr, "Usage: grep pattern [file...]\n");
            return 2;
        }
    }
    
    // Reset optind for actual argument parsing
    optind = 1;
    
    // Find the pattern (first non-option argument before --)
    int pattern_idx = -1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) break;
        if (argv[i][0] == '-' && strlen(argv[i]) > 1) {
            // Skip options
            continue;
        }
        pattern_idx = i;
        break;
    }
    
    if (pattern_idx == -1) {
        fprintf(stderr, "Usage: grep pattern [file...]\n");
        return 2;
    }
    
    const char *pattern = argv[pattern_idx];
    
    // Determine files to search
    int file_count = argc - (pattern_idx + 1);
    char **files = &argv[pattern_idx + 1];
    
    // If no files, read from stdin
    if (file_count == 0) {
        char line[MAX_LINE_LEN];
        int exit_code = 1;  // Default to no match
        size_t len;
        
        while ((len = fread(line, 1, sizeof(line) - 1, stdin)) > 0) {
            // Ensure null termination for safety
            line[len] = '\0';
            
            // Find newlines and process line by line
            char *start = line;
            char *nl;
            while ((nl = strchr(start, '\n')) != NULL) {
                *nl = '\0';
                if (contains_pattern(start, nl - start, pattern)) {
                    printf("%s\n", start);
                    exit_code = 0;
                }
                start = nl + 1;
            }
            // Handle last line without newline
            if (start < line + len) {
                if (contains_pattern(start, line + len - start, pattern)) {
                    printf("%s\n", start);
                    exit_code = 0;
                }
            }
        }
        
        return exit_code;
    }
    
    // Search in files
    int exit_code = 1;  // Default to no match
    int error_occurred = 0;
    
    for (int i = 0; i < file_count; i++) {
        // Check if it's a directory
        struct stat st;
        if (stat(files[i], &st) == 0 && S_ISDIR(st.st_mode)) {
            fprintf(stderr, "%s: Is a directory\n", files[i]);
            exit_code = 2;
            error_occurred = 1;
            continue;
        }
        
        FILE *fp = fopen(files[i], "r");
        if (fp == NULL) {
            fprintf(stderr, "%s: %s\n", files[i], strerror(errno));
            exit_code = 2;
            error_occurred = 1;
            continue;
        }
        
        char line[MAX_LINE_LEN];
        
        while (fgets(line, sizeof(line), fp) != NULL) {
            size_t len = strlen(line);
            // Remove trailing newline for matching but preserve for output
            if (len > 0 && line[len-1] == '\n') {
                line[len-1] = '\0';
                len--;
            }
            
            if (contains_pattern(line, len, pattern)) {
                if (file_count > 1) {
                    printf("%s:", files[i]);
                }
                printf("%s\n", line);
                exit_code = 0;
            }
        }
        
        fclose(fp);
    }
    
    return exit_code;
}
