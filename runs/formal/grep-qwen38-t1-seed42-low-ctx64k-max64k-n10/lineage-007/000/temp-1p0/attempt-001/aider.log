// Read a line from FILE*, returning malloc'd buffer and length.
// Returns NULL on EOF or error.
static char *read_line(FILE *fp, size_t *out_len) {
    size_t capacity = 256;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;

    int c;
    while ((c = fgetc(fp)) != EOF) {
        if (len + 1 >= capacity) {
            capacity *= 2;
            char *tmp = realloc(buf, capacity);
            if (!tmp) { free(buf); return NULL; }
            buf = tmp;
        }
        buf[len++] = (char)c;
        if (c == '\n') break;
    }

    if (len == 0 && c == EOF) {
        free(buf);
        return NULL;
    }

    *out_len = len;
    return buf;
}

