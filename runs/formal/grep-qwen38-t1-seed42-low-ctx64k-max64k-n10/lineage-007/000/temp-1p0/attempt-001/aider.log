Let me write the full implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/stat.h>

static int out_error = 0; // track stdout write errors

static void die_out(void) {
    // write error on stdout
    fprintf(stderr, "new_grep: write error on standard output\n");
    exit(2);
}

typedef struct {
    unsigned char *buf;
    size_t len;
    size_t cap;
} byte_buf;

static int bb_reserve(byte_buf *bb, size_t extra) {
    size_t need = bb->len + extra;
    if (need > bb->cap) {
        size_t newcap = bb->cap ? bb->cap : 256;
        while (newcap < need) {
            if (newcap > SIZE_MAX / 2) { newcap = SIZE_MAX; break; }
            newcap *= 2;
        }
        unsigned char *p = realloc(bb->buf, newcap);
        if (!p) return -1;
        bb->buf = p;
        bb->cap = newcap;
    }
    return 0;
}

// Read one line from f. Returns 1 if a line was read, 0 if EOF with no data.
// On success, bb contains the line bytes (no newline), len is set.
static int read_line(FILE *f, byte_buf *bb) {
    bb->len = 0;
    int c;
    while ((c = fgetc(f)) != EOF) {
        if (c == '\n') return 1;
        if (bb_reserve(bb, 1) != 0) return -1;
        bb->buf[bb->len++] = (unsigned char)c;
    }
    // EOF
    if (bb->len > 0) return 1; // last line without newline
    return 0;
}

// memmem-like: find needle in hay[0..hay_len)
static const unsigned char *find_bytes(const unsigned char *hay, size_t hay_len,
                                        const unsigned char *needle, size_t needle_len) {
    if (needle_len == 0) return hay;
    if (needle_len > hay_len) return NULL;
    for (size_t i = 0; i + needle_len <= hay_len; i++) {
        if (memcmp(hay + i, needle, needle_len) == 0) return hay + i;
    }
    return NULL;
}

static int write_line(FILE *out, const char *prefix, size_t prefix_len,
                      const unsigned char *line, size_t line_len) {
    if (prefix && prefix_len > 0) {
        if (fwrite(prefix, 1, prefix_len, out) != prefix_len) return -1;
        if (fputc(':', out) == EOF) return -1;
    }
    if (line_len > 0) {
        if (fwrite(line, 1, line_len, out) != line_len) return -1;
    }
    if (fputc('\n', out) == EOF) return -1;
    return 0;
}

static void usage(void) {
    fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
}

int main(int argc, char **argv) {
    // Parse arguments
    int after_terminator = 0;
    const char *pattern = NULL;
    size_t pattern_len = 0;
    char **files = NULL;
    int nfiles = 0;
    int file_idx = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        
        if (after_terminator) {
            if (!pattern) {
                pattern = arg;
                pattern_len = strlen(arg);
            } else {
                files = realloc(files, (nfiles + 1) * sizeof(char*));
                if (!files) { fprintf(stderr, "new_grep: out of memory\n"); return 2; }
                files[nfiles++] = arg;
            }
            continue;
        }
        
        if (strcmp(arg, "--") == 0) {
            after_terminator = 1;
            continue;
        }
        
        // Unknown option check: starts with '-' and is not bare '-'
        if (arg[0] == '-' && arg[1] != '\0') {
            usage();
            return 2;
        }
        
        // arg is either "-" (bare) or a non-dash string
        if (!pattern) {
            pattern = arg;
            pattern_len = strlen(arg);
        } else {
            files = realloc(files, (nfiles + 1) * sizeof(char*));
            if (!files) { fprintf(stderr, "new_grep: out of memory\n"); return 2; }
            files[nfiles++] = arg;
        }
    }
    
    if (!pattern) {
        usage();
        return 2;
    }
    
    int has_files = (nfiles > 0);
    int use_prefix = (nfiles >= 2);
    
    int any_match = 0;
    int any_error = 0;
    
    byte_buf bb = {0};
    
    if (!has_files) {
        // Read from stdin
        int rc;
        while ((rc = read_line(stdin, &bb)) > 0) {
            if (find_bytes(bb.buf, bb.len, (const unsigned char*)pattern, pattern_len)) {
                if (write_line(stdout, NULL, 0, bb.buf, bb.len) != 0) {
                    free(bb.buf);
                    fprintf(stderr, "new_grep: write error\n");
                    return 2;
                }
                any_match = 1;
            }
        }
        if (rc < 0) {
            free(bb.buf);
            fprintf(stderr, "new_grep: read error\n");
            return 2;
        }
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *path = files[i];
            
            // Check if it's a directory
            struct stat st;
            if (stat(path, &st) != 0) {
                // Doesn't exist or can't stat
                fprintf(stderr, "new_grep: %s: No such file or directory\n", path);
                any_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: Is a directory\n", path);
                any_error = 1;
                continue;
            }
            
            FILE *f = fopen(path, "rb");
            if (!f) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                any_error = 1;
                continue;
            }
            
            int rc;
            while ((rc = read_line(f, &bb)) > 0) {
                if (find_bytes(bb.buf, bb.len, (const unsigned char*)pattern, pattern_len)) {
                    if (write_line(stdout, path, strlen(path), bb.buf, bb.len) != 0) {
                        fclose(f);
                        free(bb.buf);
                        fprintf(stderr, "new_grep: write error\n");
                        return 2;
                    }
                    any_match = 1;
                }
            }
            if (rc < 0) {
                fclose(f);
                free(bb.buf);
                fprintf(stderr, "new_grep: %s: read error\n", path);
                any_error = 1;
                continue;
            }
            fclose(f);
        }
    }
    
    free(bb.buf);
    free(files);
    
    if (any_error) return 2;
    return any_match ? 0 : 1;
}
```

