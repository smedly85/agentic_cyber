#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define MAX_LINE_LEN 65536
#define MAX_FILES 1024

static int match_pattern(const char *line, const char *pattern) {
    return strstr(line, pattern) != NULL;
}

static int grep_file(const char *filename, const char *pattern, int expect_prefix) {
    FILE *fp;
    char line[MAX_LINE_LEN];
    int found = 0;
    int line_num = 0;
    
    if (strcmp(filename, "-") == 0) {
        fp = stdin;
    } else {
        fp = fopen(filename, "rb");
        if (fp == NULL) {
            fprintf(stderr, "new_grep: %s: No such file or directory\n", filename);
            return 2;
        }
    }
    
    while (fgets(line, sizeof(line), fp) != NULL) {
        line_num++;
        if (match_pattern(line, pattern)) {
            if (expect_prefix && strcmp(filename, "-") != 0) {
                printf("%s:%s", filename, line);
            } else {
                printf("%s", line);
            }
            found = 1;
        }
    }
    
    if (fp != stdin && fp != NULL) {
        fclose(fp);
    }
    
    return found ? 0 : 1;
}

static void print_usage(void) {
    fprintf(stderr, "Usage: new_grep PATTERN [FILE...]\n");
}

int main(int argc, char *argv[]) {
    int i;
    int exit_code = 0;
    int expect_prefix = 0;
    const char *pattern = NULL;
    const char *files[MAX_FILES];
    int file_count = 0;
    
    // Skip program name
    argc--;
    argv++;
    
    // Parse arguments
    while (argc > 0) {
        if (strcmp(argv[0], "--") == 0) {
            // End of options
            argc--;
            argv++;
            break;
        }
        if (argv[0][0] == '-' && strlen(argv[0]) > 1) {
            // Unknown option
            fprintf(stderr, "new_grep: invalid option -- %s\n", argv[0]);
            print_usage();
            return 2;
        }
        break;
    }
    
    if (argc < 1) {
        print_usage();
        return 2;
    }
    
    pattern = argv[0];
    argc--;
    argv++;
    
    // Collect file arguments
    while (argc > 0 && file_count < MAX_FILES) {
        files[file_count++] = argv[0];
        argc--;
        argv++;
    }
    
    // Determine if we need filename prefixes
    if (file_count > 1) {
        expect_prefix = 1;
    }
    
    // If no files given, grep stdin
    if (file_count == 0) {
        return grep_file("-", pattern, 0);
    }
    
    // Process each file
    for (i = 0; i < file_count; i++) {
        int result = grep_file(files[i], pattern, expect_prefix);
        if (result == 2) {
            exit_code = 2;
        } else if (result == 0) {
            exit_code = 0;
        }
    }
    
    return exit_code;
}
```
