static int cmp_names(const void *a, const void *b) {
    const char *sa = *(const char *const *)a;
    const char *sb = *(const char *const *)b;
    // byte-wise comparison
    size_t la = strlen(sa), lb = strlen(sb);
    size_t min = la < lb ? la : lb;
    int c = memcmp(sa, sb, min);
    if (c != 0) return c;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

// Build path: operand + "/" + relative (handle trailing slash on operand)
static char *build_path(const char *operand, const char *relative) {
    size_t olen = strlen(operand);
    // strip trailing slash
    while (olen > 0 && operand[olen - 1] == '/') olen--;
    size_t rlen = strlen(relative);
    char *buf = malloc(olen + 1 + rlen + 1);
    if (!buf) return NULL;
    memcpy(buf, operand, olen);
    buf[olen] = '/';
    memcpy(buf + olen + 1, relative, rlen + 1);
    return buf;
}

