        names[count] = strdup(entry->d_name);
        if (!names[count]) {
            for (int i = 0; i < count; i++) free(names[i]);
            free(names);
            closedir(dp);
            return;
        }
        count++;
    }
    closedir(dp);

    qsort(names, (size_t)count, sizeof(char *), cmp_names);

    for (int i = 0; i < count; i++) {
        char *full = join_path(path, names[i]);
        if (!full) { free(names[i]); continue; }

        struct stat st;
        if (lstat(full, &st) != 0) {
