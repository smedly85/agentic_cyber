static int find_in_line(const unsigned char *line, size_t line_len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (pat_len > line_len) return 0;
    for (size_t i = 0; i <= line_len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0) return 1;
    }
    return 0;
}

// Write line to stdout with optional prefix
static int write_line(const char *prefix, const unsigned char *line, size_t line_len) {
    if (prefix) {
        size_t plen = strlen(prefix);
        if (fwrite(prefix, 1, plen, stdout) != plen) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len) return -1;
    if (fputc('\n', stdout) == EOF) return -1;
    return 0;
}

// Process a stream (fd) searching for pattern, writing matches
// Returns: 0 on success, -1 on I/O error
// Sets *found to 1 if any line matched
static int process_stream(int fd, const unsigned char *pat, size_t pat_len,
                          const char *prefix, int *found) {
    unsigned char *chunk = xmalloc(CHUNK_SIZE);
    unsigned char *line = NULL;
    size_t line_len = 0, line_cap = 0;
    size_t chunk_pos = 0, chunk_len = 0;
    int error = 0;
    
    for (;;) {
        // Refill chunk if needed
        if (chunk_pos >= chunk_len) {
            ssize_t n;
            do {
                n = read(fd, chunk, CHUNK_SIZE);
            } while (n < 0 && errno == EINTR);
            if (n < 0) { error = 1; goto done; }
            if (n == 0) {
                // EOF
                if (line_len > 0) {
                    if (find_in_line(line, line_len, pat, pat_len)) {
                        if (write_line(prefix, line, line_len) != 0) { error = 1; goto done; }
                        *found = 1;
                    }
                }
                goto done;
            }
            chunk_len = (size_t)n;
            chunk_pos = 0;
        }
        
        unsigned char b = chunk[chunk_pos++];
        if (b == 0x0A) {
            // Emit current line
            if (find_in_line(line, line_len, pat, pat_len)) {
                if (write_line(prefix, line, line_len) != 0) { error = 1; goto done; }
                *found = 1;
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                size_t new_cap = line_cap ? line_cap * 2 : 256;
                if (new_cap < line_len + 1) new_cap = line_len + 1;
                line = xrealloc(line, new_cap);
                line_cap = new_cap;
            }
            line[line_len++] = b;
        }
    }
    
done:
    free(chunk);
    free(line);
    return error ? -1 : 0;
}

