#define MAX_DEPTH 4096

static int traverse_dir(const char *dir_path, const unsigned char *pat, size_t pat_len,
                        const char *prefix, int *found, int *error, int depth) {
    if (depth >= MAX_DEPTH) return 0;
    
    DIR *d = opendir(dir_path);
    if (!d) return 0; // shouldn't happen since we already stat'd it
    
    // Collect entries
    struct dirent *ent;
    char **names = NULL;
    int count = 0, cap = 0;
    
    while ((ent = readdir(d)) != NULL) {
        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
        if (count >= cap) {
            cap = cap ? cap * 2 : 16;
            names = xrealloc(names, cap * sizeof(char *));
        }
        names[count++] = strdup(ent->d_name);
        if (!names[count-1]) fail_oom();
    }
    closedir(d);
    
    // Sort
    qsort(names, (size_t)count, sizeof(char *), cmp_names);
    
    // Process each entry
    for (int i = 0; i < count; i++) {
        // Build full path
        // Handle trailing slash: if dir_path ends with '/', don't add another
        size_t dlen = strlen(dir_path);
        int need_sep = (dlen == 0 || dir_path[dlen - 1] != '/');
        size_t path_len = dlen + (need_sep ? 1 : 0) + strlen(names[i]) + 1;
        char *full = xrealloc(NULL, path_len);
        if (need_sep) {
            snprintf(full, path_len, "%s/%s", dir_path, names[i]);
        } else {
            snprintf(full, path_len, "%s%s", dir_path, names[i]);
        }
        
        struct stat st;
        if (lstat(full, &st) != 0) {
            free(full);
            free(names[i]);
            continue;
        }
        
        if (S_ISREG(st.st_mode)) {
            int fd = open(full, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", full, strerror(errno));
                *error = 1;
            } else {
                if (search_fd(fd, pat, pat_len, prefix ? full : NULL, found) != 0) {
                    *error = 1;
                }
                close(fd);
            }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full, pat, pat_len, prefix, found, error, depth + 1);
        }
        // symlinks: skip (lstat already identified them as S_ISLNK)
        
        free(full);
        free(names[i]);
    }
    
    free(names);
    return 0;
}
```

