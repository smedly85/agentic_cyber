            }

            ByteBuf line = {0};
            int rc;
            const char *prefix = use_prefix ? filename : NULL;
            while ((rc = read_line(fp, &line)) == 0) {
                if (fixed_match(line.buf, line.len, (const unsigned char *)pattern, patlen)) {
