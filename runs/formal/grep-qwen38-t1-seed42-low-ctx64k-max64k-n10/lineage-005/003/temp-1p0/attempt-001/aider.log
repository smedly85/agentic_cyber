```c
static int name_compare(const void *a, const void *b) {
    const unsigned char *sa = *(const unsigned char * const *)a;
    const unsigned char *sb = *(const unsigned char * const *)b;
    while (*sa && *sa == *sb) { sa++; sb++; }
    return (*sa < *sb) ? -1 : (*sa > *sb) ? 1 : 0;
}
```

