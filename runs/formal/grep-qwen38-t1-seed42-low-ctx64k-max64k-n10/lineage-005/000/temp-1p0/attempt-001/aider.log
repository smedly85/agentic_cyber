#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <getopt.h>
#include <errno.h>
#include <sys/stat.h>

#define MAX_LINE_LEN 65536
#define MAX_FILES 1024

static char *pattern = NULL;
static char **files = NULL;
static int file_count = 0;
static int use_stdin = 0;

static void print_usage(void) {
    fprintf(stderr, "usage: grep pattern [file...]\n");
}

static int is_fixed_string_match(const char *line, const char *pattern) {
    return strstr(line, pattern) != NULL;
}

static int process_file(const char *filename) {
    FILE *fp;
    char line[MAX_LINE_LEN];
    int found = 0;
    int is_stdin = (strcmp(filename, "-") == 0) || (file_count == 0 && !use_stdin);
    
    if (is_stdin) {
        fp = stdin;
    } else {
        fp = fopen(filename, "r");
        if (fp == NULL) {
            fprintf(stderr, "grep: %s: %s\n", filename, strerror(errno));
            return 2;
        }
    }
    
    struct stat st;
    if (!is_stdin && stat(filename, &st) == 0 && S_ISDIR(st.st_mode)) {
        fprintf(stderr, "grep: %s: Is a directory\n", filename);
        if (fp != stdin) {
            fclose(fp);
        }
        return 2;
    }
    
    if (file_count > 1 || (!is_stdin && file_count > 0)) {
        while (fgets(line, sizeof(line), fp) != NULL) {
            if (is_fixed_string_match(line, pattern)) {
                printf("%s:%s", filename, line);
                found = 1;
            }
        }
    } else {
        while (fgets(line, sizeof(line), fp) != NULL) {
            if (is_fixed_string_match(line, pattern)) {
                printf("%s", line);
                found = 1;
            }
        }
    }
    
    if (!is_stdin) {
        fclose(fp);
    }
    
    return found ? 0 : 1;
}

int main(int argc, char *argv[]) {
    int opt;
    int i;
    int result = 0;
    
    // Parse options
    while ((opt = getopt(argc, argv, "-")) != -1) {
        switch (opt) {
            case '-':
                // Handle -- to stop option parsing
                break;
            case '?':
                print_usage();
                return 2;
        }
    }
    
    // Check minimum arguments
    if (optind >= argc) {
        print_usage();
        return 2;
    }
    
    pattern = argv[optind];
    optind++;
    
    // Collect file arguments
    files = malloc(sizeof(char *) * (argc - optind));
    if (argc > optind) {
        for (i = optind; i < argc; i++) {
            files[file_count++] = argv[i];
        }
    } else {
        use_stdin = 1;
    }
    
    // Process files
    if (file_count == 0) {
        result = process_file("-");
    } else {
        for (i = 0; i < file_count; i++) {
            int r = process_file(files[i]);
            if (r > result) {
                result = r;
            }
        }
    }
    
    free(files);
    return result;
}
