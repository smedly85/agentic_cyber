// Returns: 1 = got a line (in *buf, length *len), 0 = EOF (no more lines), -1 = error
static int read_line(FILE *f, unsigned char **buf, size_t *len, size_t *cap) {
    *len = 0;
    if (*cap == 0) {
        *cap = 8192;
        *buf = malloc(*cap);
        if (!*buf) return -1;
    }
    
    int c;
    while ((c = getc(f)) != EOF) {
        if (c == '\n') return 1;
        if (*len + 1 > *cap) {
            size_t newcap = *cap * 2;
            unsigned char *nb = realloc(*buf, newcap);
            if (!nb) return -1;
            *buf = nb;
            *cap = newcap;
        }
        (*buf)[(*len)++] = (unsigned char)c;
    }
    // EOF
    if (*len > 0) return 1;
    // Check if there was an error
    if (ferror(f)) return -1;
    return 0;
