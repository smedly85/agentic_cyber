// Fixed string search: find `needle` (nlen bytes) in `haystack` (hlen bytes)
// Returns pointer to first occurrence, or NULL
static const unsigned char *fixed_search(const unsigned char *hay, size_t hlen, 
                                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return hay; // empty pattern matches at position 0
    if (nlen > hlen) return NULL;
    for (size_t i = 0; i <= hlen - nlen; i++) {
        if (memcmp(hay + i, needle, nlen) == 0)
            return hay + i;
    }
    return NULL;
}

// Read one line from stream, return in dynamic buffer
// Returns 1 if a line was read (possibly empty), 0 if EOF with no more data
// The line does NOT include the trailing newline
static int read_line(FILE *f, unsigned char **buf, size_t *len, size_t *cap) {
    *len = 0;
    if (*cap == 0) {
        *cap = 4096;
        *buf = malloc(*cap);
        if (!*buf) return -1;
    }
    // memset not needed, we track len
    
    int c;
    while ((c = getc(f)) != EOF) {
        if (c == '\n') {
            return 1;
        }
        if (*len + 1 >= *cap) {
            size_t newcap = *cap * 2;
            unsigned char *newbuf = realloc(*buf, newcap);
            if (!newbuf) return -1;
            *buf = newbuf;
            *cap = newcap;
        }
        (*buf)[*len++] = (unsigned char)c;
    }
    // EOF
    if (*len > 0) return 1;
    return 0;
}
```

