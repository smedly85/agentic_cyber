    int npos = argc - pos_start;
    if (npos < 1) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        return 2;
    }
    
    const char *pattern = argv[pos_start];
    size_t pat_len = strlen(pattern);
    char **files = &argv[pos_start + 1];
    int nfiles = npos - 1;
    
    int use_prefix = (nfiles >= 2);
    int any_match = 0;
    int any_error = 0;
    
    if (nfiles == 0) {
        search_stream(stdin, (const unsigned char *)pattern, pat_len,
                      NULL, 0, &any_match, &any_error);
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *name = files[i];
            struct stat st;
            if (stat(name, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", name, strerror(errno));
                any_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: is a directory\n", name);
                any_error = 1;
                continue;
            }
            FILE *f = fopen(name, "r");
            if (!f) {
                fprintf(stderr, "new_grep: %s: %s\n", name, strerror(errno));
                any_error = 1;
                continue;
            }
            const char *prefix = use_prefix ? name : NULL;
            size_t prefix_len = use_prefix ? strlen(name) : 0;
            search_stream(f, (const unsigned char *)pattern, pat_len,
                          prefix, prefix_len, &any_match, &any_error);
            if (fclose(f) != 0) any_error = 1;
        }
    }
    
    if (fflush(stdout) != 0) any_error = 1;
    
    if (any_error) return 2;
    if (any_match) return 0;
