```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (pat_len > len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0) return 1;
    }
    return 0;
}

static int read_line(FILE *f, unsigned char **buf, size_t *len, size_t *cap) {
    *len = 0;
    if (*cap == 0) {
        *cap = 8192;
        *buf = malloc(*cap);
        if (!*buf) return -1;
    }
    int c;
    while ((c = getc(f)) != EOF) {
        if (c == '\n') return 1;
        if (*len + 1 > *cap) {
            size_t newcap = *cap * 2;
            unsigned char *nb = realloc(*buf, newcap);
            if (!nb) return -1;
            *buf = nb;
            *cap = newcap;
        }
        (*buf)[(*len)++] = (unsigned char)c;
    }
    if (*len > 0) return 1;
    if (ferror(f)) return -1;
    return 0;
}

static int write_selected(const char *prefix, size_t prefix_len,
                          const unsigned char *line, size_t line_len) {
    if (prefix_len > 0) {
        if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (line_len > 0) {
        if (fwrite(line, 1, line_len, stdout) != line_len) return -1;
    }
    return (fputc('\n', stdout) != EOF) ? 0 : -1;
}

static void search_stream(FILE *f, const unsigned char *pat, size_t pat_len,
                          const char *prefix, size_t prefix_len,
                          int *any_match, int *any_error) {
    unsigned char *buf = NULL;
    size_t len = 0, cap = 0;
    int rc;
    while ((rc = read_line(f, &buf, &len, &cap)) > 0) {
        if (line_matches(buf, len, pat, pat_len)) {
            if (write_selected(prefix, prefix_len, buf, len) == -1) {
                *any_error = 1;
                free(buf);
                return;
            }
            *any_match = 1;
        }
    }
    if (rc == -1) *any_error = 1;
    free(buf);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
        return 2;
