Now let me write the complete implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (pat_len > len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0) return 1;
    }
    return 0;
}

static int read_line(FILE *f, unsigned char **buf, size_t *len, size_t *cap) {
    *len = 0;
    if (*cap == 0) {
        *cap = 8192;
        *buf = malloc(*cap);
        if (!*buf) return -1;
    }
    int c;
    while ((c = getc(f)) != EOF) {
        if (c == '\n') return 1;
        if (*len + 1 > *cap) {
            size_t newcap = *cap * 2;
            unsigned char *nb = realloc(*buf, newcap);
            if (!nb) return -1;
            *buf = nb;
            *cap = newcap;
        }
        (*buf)[(*len)++] = (unsigned char)c;
    }
    if (*len > 0) return 1;
    if (ferror(f)) return -1;
    return 0;
}

static int write_selected(const char *prefix, size_t prefix_len,
                          const unsigned char *line, size_t line_len) {
    if (prefix_len > 0) {
        if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) return -1;
        if (fputc(':', stdout) == EOF) return -1;
    }
    if (line_len > 0) {
        if (fwrite(line, 1, line_len, stdout) != line_len) return -1;
    }
    return (fputc('\n', stdout) != EOF) ? 0 : -1;
}

static void search_stream(FILE *f, const unsigned char *pat, size_t pat_len,
                          const char *prefix, size_t prefix_len,
                          int *any_match, int *any_error) {
    unsigned char *buf = NULL;
    size_t len = 0, cap = 0;
    
    int rc;
    while ((rc = read_line(f, &buf, &len, &cap)) != 0) {
        if (rc == -1) {
            *any_error = 1;
            break;
        }
        if (line_matches(buf, len, pat, pat_len)) {
            if (write_selected(prefix, prefix_len, buf, len) == -1) {
                *any_error = 1;
                break;
            }
            *any_match = 1;
        }
    }
    
    free(buf);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
        return 2;
    }
    
    // Find --
    int dd = -1;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--") == 0) { dd = i; break; }
    }
    
    // Check for unknown options before --
    int check_end = (dd != -1) ? dd : argc;
    for (int i = 1; i < check_end; i++) {
        if (argv[i][0] == '-' && strcmp(argv[i], "-") != 0) {
            fprintf(stderr, "new_grep: unknown option '%s'\n", argv[i]);
            return 2;
        }
    }
    
    // Determine positionals
    int pos_start;
    if (dd != -1) {
        pos_start = dd + 1;
    } else {
        pos_start = 1;
    }
    
    int npos = argc - pos_start;
    if (npos < 1) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        return 2;
    }
    
    const char *pattern = argv[pos_start];
    size_t pat_len = strlen(pattern);
    const char **files = &argv[pos_start + 1];
    int nfiles = npos - 1;
    
    int use_prefix = (nfiles >= 2);
    int any_match = 0;
    int any_error = 0;
    
    if (nfiles == 0) {
        search_stream(stdin, (const unsigned char *)pattern, pat_len,
                      NULL, 0, &any_match, &any_error);
    } else {
        for (int i = 0; i < nfiles; i++) {
            const char *name = files[i];
            int fd = open(name, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", name, strerror(errno));
                any_error = 1;
                continue;
            }
            struct stat st;
            if (fstat(fd, &st) == 0 && S_ISDIR(st.st_mode)) {
                close(fd);
                fprintf(stderr, "new_grep: %s: is a directory\n", name);
                any_error = 1;
                continue;
            }
            FILE *f = fdopen(fd, "r");
            if (!f) {
                close(fd);
                fprintf(stderr, "new_grep: %s: %s\n", name, strerror(errno));
                any_error = 1;
                continue;
            }
            const char *prefix = use_prefix ? name : NULL;
            size_t prefix_len = use_prefix ? strlen(name) : 0;
            search_stream(f, (const unsigned char *)pattern, pat_len,
                          prefix, prefix_len, &any_match, &any_error);
            if (fclose(f) != 0) {
                any_error = 1;
            }
        }
    }
    
    if (fflush(stdout) != 0) {
        any_error = 1;
    }
    
    if (any_error) return 2;
    if (any_match) return 0;
    return 1;
}
```

