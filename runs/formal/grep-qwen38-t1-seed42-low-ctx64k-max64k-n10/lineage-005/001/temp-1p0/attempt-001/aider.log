typedef struct {
    unsigned char *buf;
    size_t len;
    size_t cap;
} ByteBuf;

static int buf_reserve(ByteBuf *b, size_t need) {
    if (b->cap >= need) return 0;
    size_t newcap = b->cap ? b->cap : 256;
    while (newcap < need) newcap *= 2;
    unsigned char *p = realloc(b->buf, newcap);
    if (!p) return -1;
    b->buf = p;
    b->cap = newcap;
    return 0;
}

