```c
#define _POSIX_C_SOURCE 200809L

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static void *xrealloc(void *old, size_t size) {
    void *p = realloc(old, size);
    if (!p) {
        fprintf(stderr, "new_grep: out of memory\n");
        exit(2);
    }
    return p;
}

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (len < pat_len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0)
            return 1;
    }
    return 0;
}

static int write_selected(const char *filename,
                          const unsigned char *line, size_t line_len) {
    if (filename) {
        size_t flen = strlen(filename);
        if (write(STDOUT_FILENO, filename, flen) != (ssize_t)flen) return -1;
        if (write(STDOUT_FILENO, ":", 1) != 1) return -1;
    }
    if (line_len > 0) {
        if (write(STDOUT_FILENO, line, line_len) != (ssize_t)line_len) return -1;
    }
    if (write(STDOUT_FILENO, "\n", 1) != 1) return -1;
    return 0;
}

static int process_stream(int fd, const unsigned char *pat, size_t pat_len,
                          const char *filename, int *found) {
    unsigned char *line = NULL;
    size_t line_len = 0, cap = 0;
    unsigned char buf[8192];

    for (;;) {
        ssize_t n;
        do {
            n = read(fd, buf, sizeof(buf));
        } while (n < 0 && errno == EINTR);

        if (n < 0) {
            free(line);
            return -1;
        }
        if (n == 0) {
            if (line_len > 0) {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(filename, line, line_len) < 0) {
                        free(line);
                        return -2;
                    }
                    *found = 1;
                }
            }
            free(line);
            return 0;
        }

        for (ssize_t i = 0; i < n; i++) {
            if (buf[i] == '\n') {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(filename, line, line_len) < 0) {
                        free(line);
                        return -2;
                    }
                    *found = 1;
                }
                line_len = 0;
            } else {
                if (line_len + 1 > cap) {
                    size_t newcap = cap ? cap * 2 : 256;
                    line = xrealloc(line, newcap);
                    cap = newcap;
                }
                line[line_len++] = buf[i];
            }
        }
    }
}

/* --- Recursive traversal --- */

typedef enum { TASK_FILE, TASK_DIR } TaskType;

typedef struct {
    TaskType type;
    char *path;
} Task;

static int name_cmp(const void *a, const void *b) {
    return strcmp((const char *)a, (const char *)b);
}

static char *join_path(const char *base, const char *name) {
    size_t blen = strlen(base);
    while (blen > 0 && base[blen - 1] == '/') blen--;
    size_t nlen = strlen(name);
    char *result = xrealloc(NULL, blen + 1 + nlen + 1);
    memcpy(result, base, blen);
    result[blen] = '/';
    memcpy(result + blen + 1, name, nlen);
    result[blen + 1 + nlen] = '\0';
    return result;
}

static int traverse(const char *root, const unsigned char *pat, size_t pat_len,
                    int use_prefix, int *found, int *had_error) {
    Task *stack = NULL;
    size_t stack_len = 0, stack_cap = 0;

    /* Push initial directory */
    {
        char *root_copy = xrealloc(NULL, strlen(root) + 1);
        strcpy(root_copy, root);
        if (stack_len + 1 > stack_cap) {
            stack_cap = 16;
            stack = xrealloc(stack, stack_cap * sizeof(Task));
        }
        stack[stack_len].type = TASK_DIR;
        stack[stack_len].path = root_copy;
        stack_len++;
    }

    while (stack_len > 0) {
        Task task = stack[--stack_len];

        if (task.type == TASK_FILE) {
            int fd = open(task.path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
                *had_error = 1;
                free(task.path);
                continue;
            }
            int rc = process_stream(fd, pat, pat_len,
                                    use_prefix ? task.path : NULL, found);
            close(fd);
            if (rc == -1) {
                fprintf(stderr, "new_grep: %s: read error\n", task.path);
                *had_error = 1;
            } else if (rc == -2) {
                while (stack_len > 0) free(stack[--stack_len].path);
                free(stack);
                free(task.path);
                return -2;
            }
            free(task.path);
            continue;
        }

        /* TASK_DIR */
        DIR *dir = opendir(task.path);
        if (!dir) {
            fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
            *had_error = 1;
            free(task.path);
            continue;
        }

        char **names = NULL;
        size_t nnames = 0, names_cap = 0;
        struct dirent *ent;
        while ((ent = readdir(dir)) != NULL) {
            if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
                continue;
            if (nnames + 1 > names_cap) {
                names_cap = names_cap ? names_cap * 2 : 16;
                names = xrealloc(names, names_cap * sizeof(char *));
            }
            names[nnames] = xrealloc(NULL, strlen(ent->d_name) + 1);
            strcpy(names[nnames], ent->d_name);
            nnames++;
        }
        closedir(dir);

        if (nnames > 1)
            qsort(names, nnames, sizeof(char *), name_cmp);

        for (size_t i = nnames; i > 0; i--) {
            const char *name = names[i - 1];
            char *full = join_path(task.path, name);
            struct stat st;
            if (lstat(full, &st) != 0) {
                free(full);
                continue;
            }
            if (S_ISLNK(st.st_mode) || (!S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode))) {
                free(full);
                continue;
            }
            TaskType ttype = S_ISDIR(st.st_mode) ? TASK_DIR : TASK_FILE;
            if (stack_len + 1 > stack_cap) {
                stack_cap = stack_cap ? stack_cap * 2 : 16;
                stack = xrealloc(stack, stack_cap * sizeof(Task));
            }
            stack[stack_len].type = ttype;
            stack[stack_len].path = full;
            stack_len++;
        }

        for (size_t i = 0; i < nnames; i++) free(names[i]);
        free(names);
        free(task.path);
    }

    free(stack);
    return 0;
}

int main(int argc, char *argv[]) {
    const char **operands = NULL;
    int nop = 0;
    int seen_terminator = 0;
    int prefix_mode = -1;
    int recursive = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_terminator) {
            if (strcmp(arg, "--") == 0) {
                seen_terminator = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                if (strcmp(arg, "--with-filename") == 0) {
                    prefix_mode = 1;
                    continue;
                }
                if (strcmp(arg, "--no-filename") == 0) {
                    prefix_mode = 0;
                    continue;
                }
                if (strcmp(arg, "--recursive") == 0) {
                    recursive = 1;
                    continue;
                }
                if (arg[1] != '-') {
                    int ok = 1;
                    for (size_t j = 1; arg[j] != '\0'; j++) {
                        if (arg[j] == 'H') prefix_mode = 1;
                        else if (arg[j] == 'h') prefix_mode = 0;
                        else if (arg[j] == 'r') recursive = 1;
                        else { ok = 0; break; }
                    }
                    if (ok) continue;
                }
                fprintf(stderr, "new_grep: unknown option: %s\n", arg);
                fprintf(stderr, "usage: new_grep [-H|-h] [-r] [--] PATTERN [FILE...]\n");
                return 2;
            }
        }
        operands = xrealloc(operands, (size_t)(nop + 1) * sizeof(*operands));
        operands[nop++] = arg;
    }

    if (nop == 0) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        fprintf(stderr, "usage: new_grep [-H|-h] [-r] [--] PATTERN [FILE...]\n");
        return 2;
    }

    const char *pattern = operands[0];
    size_t pat_len = strlen(pattern);
    const char **files = operands + 1;
    int nfiles = nop - 1;

    int found = 0;
    int had_error = 0;

    if (nfiles == 0) {
        const char *name = (prefix_mode == 1) ? "(standard input)" : NULL;
        int rc = process_stream(STDIN_FILENO,
                                (const unsigned char *)pattern, pat_len,
                                name, &found);
        if (rc != 0) had_error = 1;
    } else {
        int use_prefix;
        if (prefix_mode == 0) {
            use_prefix = 0;
        } else if (prefix_mode == 1) {
            use_prefix = 1;
        } else if (nfiles >= 2) {
            use_prefix = 1;
        } else if (recursive) {
            use_prefix = 0;
            for (int i = 0; i < nfiles; i++) {
                struct stat st;
                if (stat(files[i], &st) == 0 && S_ISDIR(st.st_mode)) {
                    use_prefix = 1;
                    break;
                }
            }
        } else {
            use_prefix = 0;
        }

        for (int i = 0; i < nfiles; i++) {
            const char *path = files[i];
            struct stat st;
            if (stat(path, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                had_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                if (!recursive) {
                    fprintf(stderr, "new_grep: %s: is a directory\n", path);
                    had_error = 1;
                    continue;
                }
                int rc = traverse(path, (const unsigned char *)pattern, pat_len,
                                  use_prefix, &found, &had_error);
                if (rc == -2) break;
            } else {
                int fd = open(path, O_RDONLY);
                if (fd < 0) {
                    fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                    had_error = 1;
                    continue;
                }
                int rc = process_stream(fd,
                                        (const unsigned char *)pattern, pat_len,
                                        use_prefix ? path : NULL, &found);
                close(fd);
                if (rc == -1) {
                    fprintf(stderr, "new_grep: %s: read error\n", path);
                    had_error = 1;
                } else if (rc == -2) {
                    had_error = 1;
                    break;
                }
            }
        }
    }

    free(operands);

    if (had_error) return 2;
    return found ? 0 : 1;
}
