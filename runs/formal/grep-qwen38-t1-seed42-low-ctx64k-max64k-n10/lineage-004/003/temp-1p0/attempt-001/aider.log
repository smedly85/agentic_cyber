#define _POSIX_C_SOURCE 200809L

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static void *xrealloc(void *old, size_t size) {
    void *p = realloc(old, size);
    if (!p) {
        fprintf(stderr, "new_grep: out of memory\n");
        exit(2);
    }
    return p;
}

static void *xmalloc(size_t size) {
    return xrealloc(NULL, size);
}

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (len < pat_len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0)
            return 1;
    }
    return 0;
}

/* Returns 0 on success, -1 on write error. */
static int write_selected(const char *filename,
                          const unsigned char *line, size_t line_len) {
    if (filename) {
        size_t flen = strlen(filename);
        if (write(STDOUT_FILENO, filename, flen) != (ssize_t)flen) return -1;
        if (write(STDOUT_FILENO, ":", 1) != 1) return -1;
    }
    if (line_len > 0) {
        if (write(STDOUT_FILENO, line, line_len) != (ssize_t)line_len) return -1;
    }
    if (write(STDOUT_FILENO, "\n", 1) != 1) return -1;
    return 0;
}

/* Returns 0=ok, -1=read error (operand), -2=write error (fatal). */
static int process_stream(int fd, const unsigned char *pat, size_t pat_len,
                          const char *filename, int *found) {
    unsigned char *line = NULL;
    size_t line_len = 0, cap = 0;
    unsigned char buf[8192];

    for (;;) {
        ssize_t n;
        do {
            n = read(fd, buf, sizeof(buf));
        } while (n < 0 && errno == EINTR);

        if (n < 0) {
            free(line);
            return -1;
        }
        if (n == 0) {
            if (line_len > 0) {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(filename, line, line_len) < 0) {
                        free(line);
                        return -2;
                    }
                    *found = 1;
                }
            }
            free(line);
            return 0;
        }

        for (ssize_t i = 0; i < n; i++) {
            if (buf[i] == '\n') {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(filename, line, line_len) < 0) {
                        free(line);
                        return -2;
                    }
                    *found = 1;
                }
                line_len = 0;
            } else {
                if (line_len + 1 > cap) {
                    size_t newcap = cap ? cap * 2 : 256;
                    line = xrealloc(line, newcap);
                    cap = newcap;
                }
                line[line_len++] = buf[i];
            }
        }
    }
}

/* --- Recursive traversal --- */

typedef enum { TASK_FILE, TASK_DIR } TaskType;

typedef struct {
    TaskType type;
    char *path;
} Task;

static int name_cmp(const void *a, const void *b) {
    return strcmp((const char *)a, (const char *)b);
}

/* Build a path string: base + "/" + name, avoiding double slash if base ends with / */
static char *join_path(const char *base, const char *name) {
    size_t blen = strlen(base);
    // Strip trailing slashes
    while (blen > 0 && base[blen - 1] == '/') blen--;
    size_t nlen = strlen(name);
    char *result = xmalloc(blen + 1 + nlen + 1);
    memcpy(result, base, blen);
    result[blen] = '/';
    memcpy(result + blen + 1, name, nlen);
    result[blen + 1 + nlen] = '\0';
    return result;
}

/*
 * Iterative DFS pre-order traversal of a directory tree.
 * Returns 0 if no fatal error, -2 if write error occurred.
 * Sets *found if any line matched.
 * Error diagnostics for unreadable files are written to stderr and *had_error is set.
 */
static int traverse(const char *root, const unsigned char *pat, size_t pat_len,
                    int use_prefix, int *found, int *had_error) {
    Task *stack = NULL;
    size_t stack_len = 0, stack_cap = 0;

    /* Push initial directory */
    {
        char *root_copy = xmalloc(strlen(root) + 1);
        strcpy(root_copy, root);
        if (stack_len + 1 > stack_cap) {
            stack_cap = stack_cap ? stack_cap * 2 : 16;
            stack = xrealloc(stack, stack_cap * sizeof(Task));
        }
        stack[stack_len].type = TASK_DIR;
        stack[stack_len].path = root_copy;
        stack_len++;
    }

    while (stack_len > 0) {
        Task task = stack[--stack_len];

        if (task.type == TASK_FILE) {
            int fd = open(task.path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
                *had_error = 1;
                free(task.path);
                continue;
            }
            int rc = process_stream(fd, pat, pat_len, use_prefix ? task.path : NULL, found);
            close(fd);
            if (rc == -1) {
                fprintf(stderr, "new_grep: %s: read error\n", task.path);
                *had_error = 1;
            } else if (rc == -2) {
                free(task.path);
                // Free remaining stack entries
                while (stack_len > 0) {
                    free(stack[--stack_len].path);
                }
                free(stack);
                return -2;
            }
            free(task.path);
            continue;
        }

        /* TASK_DIR */
        DIR *dir = opendir(task.path);
        if (!dir) {
            fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
            *had_error = 1;
            free(task.path);
            continue;
        }

        /* Read all entries */
        char **names = NULL;
        size_t nnames = 0, names_cap = 0;
        struct dirent *ent;
        while ((ent = readdir(dir)) != NULL) {
            if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
                continue;
            if (nnames + 1 > names_cap) {
                names_cap = names_cap ? names_cap * 2 : 16;
                names = xrealloc(names, names_cap * sizeof(char *));
            }
            names[nnames] = xmalloc(strlen(ent->d_name) + 1);
            strcpy(names[nnames], ent->d_name);
            nnames++;
        }
        closedir(dir);

        /* Sort by byte order */
        if (nnames > 1) {
            qsort(names, nnames, sizeof(char *), name_cmp);
        }

        /* Push tasks in reverse order so first entry is on top of stack */
        for (size_t i = nnames; i > 0; i--) {
            const char *name = names[i - 1];
            struct stat st;
            /* Use lstat to check if it's a symlink */
            if (lstat(join_path(task.path, name), &st) != 0) {
                // Can't stat it, skip
                free(names[i - 1]);
                continue;
            }
            if (S_ISLNK(st.st_mode)) {
                /* Skip symlinks during traversal */
                free(names[i - 1]);
                continue;
            }
            TaskType ttype = S_ISDIR(st.st_mode) ? TASK_DIR : TASK_FILE;
            if (!S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode)) {
                /* Skip other types (sockets, fifos, etc.) */
                free(names[i - 1]);
                continue;
            }
            if (stack_len + 1 > stack_cap) {
                stack_cap = stack_cap ? stack_cap * 2 : 16;
                stack = xrealloc(stack, stack_cap * sizeof(Task));
            }
            stack[stack_len].type = ttype;
            stack[stack_len].path = join_path(task.path, name);
            stack_len++;
        }

        for (size_t i = 0; i < nnames; i++) free(names[i]);
        free(names);
        free(task.path);
    }

    free(stack);
    return 0;
}
