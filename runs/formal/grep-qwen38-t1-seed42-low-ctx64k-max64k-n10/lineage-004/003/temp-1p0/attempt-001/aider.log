#define MAX_DEPTH 1024

static int traverse_dir(const char *dir_path, int depth,
                        const unsigned char *pat, size_t pat_len,
                        int *found, int *had_error) {
    if (depth >= MAX_DEPTH) return 0; // or error?
    
    DIR *d = opendir(dir_path);
    if (!d) {
        // error
        return -1;
    }
    
    // Read all entries
    struct dirent *ent;
    char **names = NULL;
    int n = 0, cap = 0;
    while ((ent = readdir(d)) != NULL) {
        // skip . and ..
        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
        if (n >= cap) { grow }
        names[n++] = strdup(ent->d_name);
    }
    closedir(d);
    
    // Sort names (byte order)
    qsort(names, n, sizeof(*names), cmp_str);
    
    for (int i = 0; i < n; i++) {
        char *full = join_path(dir_path, names[i]);
        struct stat st;
        if (lstat(full, &st) != 0) { free; continue; }
        
        if (S_ISLNK(st.st_mode)) {
            // skip
        } else if (S_ISREG(st.st_mode)) {
            // search this file
            int fd = open(full, O_RDONLY);
            if (fd < 0) { error; }
            else { process_stream(fd, ...); close(fd); }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full, depth + 1, pat, pat_len, found, had_error);
        }
        free(full);
    }
    
    for (int i = 0; i < n; i++) free(names[i]);
    free(names);
    return 0;
}
