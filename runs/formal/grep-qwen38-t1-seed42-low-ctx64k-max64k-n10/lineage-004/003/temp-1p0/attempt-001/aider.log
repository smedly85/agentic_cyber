    {
        char *root_copy = xrealloc(NULL, strlen(root) + 1);
        strcpy(root_copy, root);
        if (stack_len + 1 > stack_cap) {
            stack_cap = 16;
            stack = xrealloc(stack, stack_cap * sizeof(Task));
        }
        stack[stack_len].type = TASK_DIR;
        stack[stack_len].path = root_copy;
        stack_len++;
    }

    while (stack_len > 0) {
        Task task = stack[--stack_len];

        if (task.type == TASK_FILE) {
            int fd = open(task.path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
                *had_error = 1;
                free(task.path);
                continue;
            }
            int rc = process_stream(fd, pat, pat_len,
                                    use_prefix ? task.path : NULL, found);
            close(fd);
            if (rc == -1) {
                fprintf(stderr, "new_grep: %s: read error\n", task.path);
                *had_error = 1;
            } else if (rc == -2) {
                while (stack_len > 0) free(stack[--stack_len].path);
                free(stack);
                free(task.path);
                return -2;
            }
            free(task.path);
            continue;
        }

        /* TASK_DIR */
        DIR *dir = opendir(task.path);
        if (!dir) {
            fprintf(stderr, "new_grep: %s: %s\n", task.path, strerror(errno));
            *had_error = 1;
            free(task.path);
            continue;
        }

        char **names = NULL;
        size_t nnames = 0, names_cap = 0;
        struct dirent *ent;
        while ((ent = readdir(dir)) != NULL) {
            if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
                continue;
            if (nnames + 1 > names_cap) {
                names_cap = names_cap ? names_cap * 2 : 16;
                names = xrealloc(names, names_cap * sizeof(char *));
            }
            names[nnames] = xrealloc(NULL, strlen(ent->d_name) + 1);
            strcpy(names[nnames], ent->d_name);
            nnames++;
        }
        closedir(dir);

        if (nnames > 1)
            qsort(names, nnames, sizeof(char *), name_cmp);

        for (size_t i = nnames; i > 0; i--) {
            const char *name = names[i - 1];
            char *full = join_path(task.path, name);
            struct stat st;
            if (lstat(full, &st) != 0) {
                free(full);
                continue;
            }
            if (S_ISLNK(st.st_mode) || (!S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode))) {
                free(full);
                continue;
            }
            TaskType ttype = S_ISDIR(st.st_mode) ? TASK_DIR : TASK_FILE;
            if (stack_len + 1 > stack_cap) {
                stack_cap = stack_cap ? stack_cap * 2 : 16;
                stack = xrealloc(stack, stack_cap * sizeof(Task));
            }
            stack[stack_len].type = ttype;
            stack[stack_len].path = full;
            stack_len++;
        }

        for (size_t i = 0; i < nnames; i++) free(names[i]);
        free(names);
        free(task.path);
    }

    free(stack);
    return 0;
}

int main(int argc, char *argv[]) {
    const char **operands = NULL;
    int nop = 0;
    int seen_terminator = 0;
    int prefix_mode = -1;
    int recursive = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_terminator) {
            if (strcmp(arg, "--") == 0) {
                seen_terminator = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                if (strcmp(arg, "--with-filename") == 0) {
                    prefix_mode = 1;
                    continue;
                }
                if (strcmp(arg, "--no-filename") == 0) {
                    prefix_mode = 0;
                    continue;
                }
                if (strcmp(arg, "--recursive") == 0) {
                    recursive = 1;
                    continue;
                }
                if (arg[1] != '-') {
                    int ok = 1;
                    for (size_t j = 1; arg[j] != '\0'; j++) {
                        if (arg[j] == 'H') prefix_mode = 1;
                        else if (arg[j] == 'h') prefix_mode = 0;
                        else if (arg[j] == 'r') recursive = 1;
                        else { ok = 0; break; }
                    }
                    if (ok) continue;
                }
                fprintf(stderr, "new_grep: unknown option: %s\n", arg);
                fprintf(stderr, "usage: new_grep [-H|-h] [-r] [--] PATTERN [FILE...]\n");
                return 2;
            }
        }
        operands = xrealloc(operands, (size_t)(nop + 1) * sizeof(*operands));
        operands[nop++] = arg;
    }

    if (nop == 0) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        fprintf(stderr, "usage: new_grep [-H|-h] [-r] [--] PATTERN [FILE...]\n");
        return 2;
    }

    const char *pattern = operands[0];
    size_t pat_len = strlen(pattern);
    const char **files = operands + 1;
    int nfiles = nop - 1;

    int found = 0;
    int had_error = 0;

    if (nfiles == 0) {
        const char *name = (prefix_mode == 1) ? "(standard input)" : NULL;
        int rc = process_stream(STDIN_FILENO,
                                (const unsigned char *)pattern, pat_len,
                                name, &found);
        if (rc != 0) had_error = 1;
    } else {
        int use_prefix;
        if (prefix_mode == 0) {
            use_prefix = 0;
        } else if (prefix_mode == 1) {
            use_prefix = 1;
        } else if (nfiles >= 2) {
            use_prefix = 1;
        } else if (recursive) {
            use_prefix = 0;
            for (int i = 0; i < nfiles; i++) {
                struct stat st;
                if (stat(files[i], &st) == 0 && S_ISDIR(st.st_mode)) {
                    use_prefix = 1;
                    break;
                }
            }
        } else {
            use_prefix = 0;
        }

        for (int i = 0; i < nfiles; i++) {
            const char *path = files[i];
            struct stat st;
            if (stat(path, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                had_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                if (!recursive) {
                    fprintf(stderr, "new_grep: %s: is a directory\n", path);
                    had_error = 1;
                    continue;
                }
                int rc = traverse(path, (const unsigned char *)pattern, pat_len,
                                  use_prefix, &found, &had_error);
                if (rc == -2) break;
            } else {
                int fd = open(path, O_RDONLY);
                if (fd < 0) {
                    fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                    had_error = 1;
                    continue;
                }
                int rc = process_stream(fd,
                                        (const unsigned char *)pattern, pat_len,
                                        use_prefix ? path : NULL, &found);
                close(fd);
                if (rc == -1) {
                    fprintf(stderr, "new_grep: %s: read error\n", path);
                    had_error = 1;
                } else if (rc == -2) {
                    had_error = 1;
                    break;
                }
            }
        }
    }

    free(operands);

    if (had_error) return 2;
    return found ? 0 : 1;
}
