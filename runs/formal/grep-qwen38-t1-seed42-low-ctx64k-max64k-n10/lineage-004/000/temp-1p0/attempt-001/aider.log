```c
#define _POSIX_C_SOURCE 200809L

#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static void die(const char *msg) {
    fprintf(stderr, "new_grep: %s\n", msg);
    exit(2);
}

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (len < pat_len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0)
            return 1;
    }
    return 0;
}

static void *xrealloc(void *old, size_t size) {
    void *p = realloc(old, size);
    if (!p) {
        fprintf(stderr, "new_grep: out of memory\n");
        exit(2);
    }
    return p;
}

static int write_line(int fd, const unsigned char *data, size_t len,
                      const char *prefix, size_t prefix_len, int *error) {
    if (prefix_len > 0) {
        if (write(fd, prefix, prefix_len) != (ssize_t)prefix_len) {
            *error = 1;
            return -1;
        }
    }
    if (len > 0) {
        if (write(fd, data, len) != (ssize_t)len) {
            *error = 1;
            return -1;
        }
    }
    if (write(fd, "\n", 1) != 1) {
        *error = 1;
        return -1;
    }
    return 0;
}

// Process a stream (fd) for pattern, writing matches to out_fd
static int process_stream(int fd, const unsigned char *pat, size_t pat_len,
                          int out_fd, const char *prefix, size_t prefix_len,
                          int *found, int *error) {
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t cap = 0;
    int rc = 0;
    unsigned char buf[8192];
    int at_start = 1; // no bytes read yet

    for (;;) {
        ssize_t n = read(fd, buf, sizeof(buf));
        if (n < 0) {
            if (errno == EINTR) continue;
            *error = 1;
            rc = -1;
            break;
        }
        if (n == 0) {
            // EOF
            if (line_len > 0) {
                // final line without trailing newline
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_line(out_fd, line, line_len, prefix, prefix_len, error) < 0) {
                        rc = -1;
                        break;
                    }
                    *found = 1;
                }
            }
            break;
        }
        at_start = 0;
        for (ssize_t i = 0; i < n; i++) {
            if (buf[i] == '\n') {
                // emit the line
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_line(out_fd, line, line_len, prefix, prefix_len, error) < 0) {
                        *error = 1;
                        free(line);
                        return -1;
                    }
                    *found = 1;
                }
                line_len = 0;
            } else {
                if (line_len + 1 > cap) {
                    cap = cap ? cap * 2 : 256;
                    line = xrealloc(line, cap);
                }
                line[line_len++] = buf[i];
            }
        }
    }
    free(line);
    return rc;
}

int main(int argc, char *argv[]) {
    // Parse arguments
    const char *pattern = NULL;
    const char **files = NULL;
    int nfiles = 0;
    int seen_terminator = 0;

    // Collect operands
    const char **operands = NULL;
    int nop = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_terminator) {
            if (strcmp(arg, "--") == 0) {
                seen_terminator = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                // Unknown option (not bare "-")
                fprintf(stderr, "new_grep: unknown option: %s\n", arg);
                fprintf(stderr, "usage: new_grep [--] PATTERN [FILE...]\n");
                return 2;
            }
        }
        operands = xrealloc(operands, (nop + 1) * sizeof(*operands));
        operands[nop++] = arg;
    }

    if (nop == 0) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        fprintf(stderr, "usage: new_grep [--] PATTERN [FILE...]\n");
        return 2;
    }

    pattern = operands[0];
    size_t pat_len = strlen(pattern);
    files = operands + 1;
    nfiles = nop - 1;

    // Decide prefix
