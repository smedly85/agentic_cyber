#define _POSIX_C_SOURCE 200809L

#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static void *xrealloc(void *old, size_t size) {
    void *p = realloc(old, size);
    if (!p) {
        fprintf(stderr, "new_grep: out of memory\n");
        exit(2);
    }
    return p;
}

static int line_matches(const unsigned char *line, size_t len,
                        const unsigned char *pat, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (len < pat_len) return 0;
    for (size_t i = 0; i <= len - pat_len; i++) {
        if (memcmp(line + i, pat, pat_len) == 0)
            return 1;
    }
    return 0;
}

static int write_selected(int out_fd, const char *filename,
                          const unsigned char *line, size_t line_len,
                          int *had_error) {
    if (filename) {
        size_t flen = strlen(filename);
        if (write(out_fd, filename, flen) != (ssize_t)flen) {
            *had_error = 1;
            return -1;
        }
        if (write(out_fd, ":", 1) != 1) {
            *had_error = 1;
            return -1;
        }
    }
    if (line_len > 0) {
        if (write(out_fd, line, line_len) != (ssize_t)line_len) {
            *had_error = 1;
            return -1;
        }
    }
    if (write(out_fd, "\n", 1) != 1) {
        *had_error = 1;
        return -1;
    }
    return 0;
}

static void process_stream(int fd, const unsigned char *pat, size_t pat_len,
                           const char *filename, int *found, int *had_error) {
    unsigned char *line = NULL;
    size_t line_len = 0, cap = 0;
    unsigned char buf[8192];

    for (;;) {
        ssize_t n;
        do {
            n = read(fd, buf, sizeof(buf));
        } while (n < 0 && errno == EINTR);

        if (n < 0) {
            *had_error = 1;
            free(line);
            return;
        }
        if (n == 0) {
            if (line_len > 0) {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(STDOUT_FILENO, filename, line, line_len, had_error) < 0) {
                        free(line);
                        return;
                    }
                    *found = 1;
                }
            }
            free(line);
            return;
        }

        for (ssize_t i = 0; i < n; i++) {
            if (buf[i] == '\n') {
                if (line_matches(line, line_len, pat, pat_len)) {
                    if (write_selected(STDOUT_FILENO, filename, line, line_len, had_error) < 0) {
                        free(line);
                        return;
                    }
                    *found = 1;
                }
                line_len = 0;
            } else {
                if (line_len + 1 > cap) {
                    size_t newcap = cap ? cap * 2 : 256;
                    line = xrealloc(line, newcap);
                    cap = newcap;
                }
                line[line_len++] = buf[i];
            }
        }
    }
}

int main(int argc, char *argv[]) {
    // Parse arguments
    const char **operands = NULL;
    int nop = 0;
    int seen_terminator = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_terminator) {
            if (strcmp(arg, "--") == 0) {
                seen_terminator = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                fprintf(stderr, "new_grep: unknown option: %s\n", arg);
                fprintf(stderr, "usage: new_grep [--] PATTERN [FILE...]\n");
                return 2;
            }
        }
        operands = xrealloc(operands, (size_t)(nop + 1) * sizeof(*operands));
        operands[nop++] = arg;
    }

    if (nop == 0) {
        fprintf(stderr, "new_grep: missing PATTERN\n");
        fprintf(stderr, "usage: new_grep [--] PATTERN [FILE...]\n");
        return 2;
    }

    const char *pattern = operands[0];
    size_t pat_len = strlen(pattern);
    const char **files = operands + 1;
    int nfiles = nop - 1;

    int found = 0;
    int had_error = 0;

    if (nfiles == 0) {
        process_stream(STDIN_FILENO, (const unsigned char *)pattern, pat_len,
                       NULL, &found, &had_error);
    } else {
        int use_prefix = (nfiles >= 2);
        for (int i = 0; i < nfiles; i++) {
            const char *path = files[i];
            struct stat st;
            if (stat(path, &st) != 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                had_error = 1;
                continue;
            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "new_grep: %s: is a directory\n", path);
                had_error = 1;
                continue;
            }
            int fd = open(path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                had_error = 1;
                continue;
            }
            process_stream(fd, (const unsigned char *)pattern, pat_len,
                           use_prefix ? path : NULL, &found, &had_error);
            close(fd);
            if (had_error) break; // write error, stop
        }
    }

    free(operands);

    if (had_error) return 2;
    return found ? 0 : 1;
}
