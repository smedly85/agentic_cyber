static bool line_matches(const unsigned char *line, size_t len,
                         const unsigned char *pat, size_t plen,
                         bool ignore_case) {
    if (plen == 0) return true;
    if (plen > len) return false;
    
    for (size_t i = 0; i + plen <= len; i++) {
        bool match = true;
        for (size_t j = 0; j < plen; j++) {
            unsigned char c = line[i + j];
            if (ignore_case) c = fold_byte(c);
            if (c != pat[j]) { match = false; break; }
        }
        if (match) return true;
    }
    return false;
}
```

This is cleaner - no allocation per line. The pattern is pre-folded, and we fold each line byte on-the-fly during comparison. This is O(n*m) worst case but avoids allocation.

