static int cmp_names(const void *a, const void *b) {
    const char *x = *(const char *const *)a;
    const char *y = *(const char *const *)b;
    size_t lx = strlen(x), ly = strlen(y);
    size_t min = lx < ly ? lx : ly;
    int c = memcmp(x, y, min);
    if (c) return c;
    if (lx < ly) return -1;
    if (lx > ly) return 1;
    return 0;
}
```

