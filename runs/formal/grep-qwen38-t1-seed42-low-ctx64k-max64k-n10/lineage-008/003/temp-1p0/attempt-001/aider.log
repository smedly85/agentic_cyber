            fclose(fp);
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(fullpath, pat, plen, use_prefix, found, error, depth + 1);
        }
        
        free(fullpath);
        free(entries[i]);
    }
    
    free(entries);
    return 0;
}
