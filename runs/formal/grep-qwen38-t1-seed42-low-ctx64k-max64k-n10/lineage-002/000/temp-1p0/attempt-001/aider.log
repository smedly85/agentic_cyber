                return -1;
            }
            *found = true;
        }
    }

    free(buf);
    return 0;
}

static int search_file(const char *path, const unsigned char *pat, size_t plen,
                       const char *prefix, bool has_prefix, bool *found) {
    struct stat st;
    if (stat(path, &st) != 0) {
        fprintf(stderr, "new_grep: %s: %s\\n", path, strerror(errno));
