// Join base and name, ensuring no double slash
static char *join_path(const char *base, const char *name) {
    // If base ends with '/', don't add another
    size_t blen = strlen(base);
    if (blen > 0 && base[blen - 1] == '/') {
        // base already ends with /
        size_t total = blen + strlen(name) + 1;
        char *result = xmalloc(total);
        memcpy(result, base, blen);
        memcpy(result + blen, name, strlen(name) + 1);
        return result;
    } else {
        size_t total = blen + 1 + strlen(name) + 1;
        char *result = xmalloc(total);
        memcpy(result, base, blen);
        result[blen] = '/';
        memcpy(result + blen + 1, name, strlen(name) + 1);
        return result;
    }
}
