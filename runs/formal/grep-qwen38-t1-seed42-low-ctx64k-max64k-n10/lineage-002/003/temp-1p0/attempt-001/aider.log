#define _POSIX_C_SOURCE 200809L
#include <dirent.h>
#include <errno.h>
#include <limits.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

static void usage_exit(void) {
    fprintf(stderr, "usage: new_grep PATTERN [FILE...]\n");
    exit(2);
}

static void *xrealloc(void *old, size_t size) {
    if (size < 1) size = 1;
    void *p = realloc(old, size);
    if (!p) {
        fprintf(stderr, "new_grep: out of memory\n");
        exit(2);
    }
    return p;
}

static void *xmalloc(size_t size) {
    return xrealloc(NULL, size);
}

// ... rest of existing functions ...

// New: compare function for sorting directory entries by byte order
static int name_compare(const void *a, const void *b) {
    const char *na = *(const char *const *)a;
    const char *nb = *(const char *const *)b;
    size_t la = strlen(na), lb = strlen(nb);
    size_t min = la < lb ? la : lb;
    int c = memcmp(na, nb, min);
    if (c != 0) return c;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

// New: search a directory tree recursively using explicit work list
static int search_tree(const char *operand, const unsigned char *pat, size_t plen,
                       bool has_prefix, bool *found, bool *error) {
    // Build the normalized operand (strip trailing slashes for path joining)
    // but keep it for the prefix name
    size_t op_len = strlen(operand);
    while (op_len > 1 && operand[op_len - 1] == '/') op_len--;
    char *base = xmalloc(op_len + 1);
    memcpy(base, operand, op_len);
    base[op_len] = '\0';
    
    // Work list: array of dynamically allocated path strings
    char **work = NULL;
    size_t wlen = 0, wcap = 0;
    
    // Push the base directory
    {
        if (wlen >= wcap) {
            wcap = wcap ? wcap * 2 : 16;
            work = xrealloc(work, wcap * sizeof(char *));
        }
        work[wlen++] = xstrdup(base); // need xstrdup
    }
    free(base);
    
    while (wlen > 0) {
        char *path = work[--wlen];
        
        struct stat st;
        if (lstat(path, &st) != 0) {
            fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
            free(path);
            *error = true;
            continue;
        }
        
        if (S_ISREG(st.st_mode)) {
            // Search this file
            const char *prefix = has_prefix ? path : NULL;
            FILE *f = fopen(path, "rb");
            if (!f) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                free(path);
                *error = true;
                continue;
            }
            if (search_stream(f, pat, plen, prefix, has_prefix, found) != 0) {
                fclose(f);
                free(path);
                free(work);
                return -1;
            }
            fclose(f);
        } else if (S_ISDIR(st.st_mode)) {
            // Read directory entries, sort, push in reverse
            DIR *d = opendir(path);
            if (!d) {
                fprintf(stderr, "new_grep: %s: %s\n", path, strerror(errno));
                free(path);
                *error = true;
                continue;
            }
            
            // Collect entries
            char **names = NULL;
            size_t ncount = 0, ncap = 0;
            struct dirent *ent;
            while ((ent = readdir(d)) != NULL) {
                if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0)
                    continue;
                if (ncount >= ncap) {
                    ncap = ncap ? ncap * 2 : 16;
                    names = xrealloc(names, ncap * sizeof(char *));
                }
                names[ncount++] = xstrdup(ent->d_name);
            }
            closedir(d);
            
            // Sort by byte order
            if (ncount > 1)
                qsort(names, ncount, sizeof(char *), name_compare);
            
            // Push in reverse order (so first entry is popped first)
            for (size_t i = ncount; i > 0; i--) {
                char *name = names[i - 1];
                free(names[i - 1]);
                
                // Join path and name
                size_t plen2 = strlen(path);
                char *child;
                if (plen2 > 0 && path[plen2 - 1] == '/') {
                    size_t total = plen2 + strlen(name) + 1;
                    child = xmalloc(total);
                    memcpy(child, path, plen2);
                    memcpy(child + plen2, name, strlen(name) + 1);
                } else {
                    size_t total = plen2 + 1 + strlen(name) + 1;
                    child = xmalloc(total);
                    memcpy(child, path, plen2);
                    child[plen2] = '/';
                    memcpy(child + plen2 + 1, name, strlen(name) + 1);
                }
                free(name);
                
                if (wlen >= wcap) {
                    wcap = wcap ? wcap * 2 : 16;
                    work = xrealloc(work, wcap * sizeof(char *));
                }
                work[wlen++] = child;
            }
            free(names);
        }
        // Symlinks and other types: skip
        free(path);
    }
    
    // Free remaining work list entries
    for (size_t i = 0; i < wlen; i++) free(work[i]);
    free(work);
    return 0;
}
```

