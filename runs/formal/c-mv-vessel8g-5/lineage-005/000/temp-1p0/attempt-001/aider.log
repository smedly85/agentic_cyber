2. **`get_basename(const char *path, char *out, size_t out_size)`** — static helper: copy text after last `/` (or whole string if no `/`) into `out`.

3. **`main(int argc, char *argv[])`**:
   - **Argument parsing**: iterate `argv[1..]`. Before seeing `--`: if arg is `--`, set a flag; if arg starts with `-` and length > 1, print "unknown option" diagnostic to stderr, free, return 1; otherwise collect as operand. After `--`: everything is a literal operand.
   - If fewer than 2 operands collected: print diagnostic, return 1.
   - **Multi-source** (operands > 2): last operand is the destination directory. Use `stat()` (follow symlinks) to verify it's a directory; if not, print diagnostic, return 1. For each source (all except last): compute effective dst as `destdir/src-basename` using `snprintf` into a `PATH_MAX` buffer. Call `move_path()`. Track failures.
   - **Single source** (exactly 2 operands): use `stat()` on dst (follows symlinks). If it's a directory, compute effective dst as `dst/src-basename` and call `move_path(src, effective_dst)`. Otherwise call `move_path(src, dst)` directly.
   - Return 0 if all succeeded, 1 if any failed.

**Key constraints for the code:**
- Include: `<stdio.h>`, `<stdlib.h>`, `<string.h>`, `<errno.h>`, `<sys/stat.h>`, `<sys/types.h>`, `<limits.h>`, `<unistd.h>`
- Define `_POSIX_C_SOURCE 200809L` at the top (before includes)
- Use `PATH_MAX` for resolved path buffers, `NAME_MAX + 1` for basename buffers
- All diagnostics go to `stderr`; `stdout` must remain empty
- No `fork`/`exec`, no third-party libraries, no flags beyond what's specified
- The function name `move_path` must appear and be called from `main`
- All per-source failures are reported and processing continues to the next source

**Here is the complete file content to write into `src/c_mv/c_mv.c`:**

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>
#include <unistd.h>

static int move_path(const char *src, const char *dst)
{
    struct stat src_stat, dst_stat;

    if (lstat(src, &src_stat) != 0) {
        fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    int dst_exists = (lstat(dst, &dst_stat) == 0);

    if (dst_exists &&
        src_stat.st_dev == dst_stat.st_dev &&
        src_stat.st_ino == dst_stat.st_ino) {
        fprintf(stderr, "mv: '%s' and '%s' are the same file\n", src, dst);
        return 1;
    }

    if (S_ISDIR(src_stat.st_mode)) {
        char src_real[PATH_MAX];
        char dst_real[PATH_MAX];
        int skip_rename_check = 0;

        if (realpath(src, src_real) == NULL) {
            fprintf(stderr, "mv: cannot resolve '%s': %s\n", src, strerror(errno));
            return 1;
        }

        if (dst_exists) {
            if (realpath(dst, dst_real) == NULL) {
                fprintf(stderr, "mv: cannot resolve '%s': %s\n", dst, strerror(errno));
                return 1;
            }
        } else {
            char parent_buf[PATH_MAX];
            memcpy(parent_buf, dst, PATH_MAX - 1);
            parent_buf[PATH_MAX - 1] = '\0';
            char *slash = strrchr(parent_buf, '/');
            if (slash == NULL) {
                skip_rename_check = 1;
            } else {
                *slash = '\0';
                if (realpath(parent_buf, dst_real) == NULL) {
                    skip_rename_check = 1;
                } else {
                    size_t len = strlen(dst_real);
                    const char *base = slash + 1;
                    size_t blen = strlen(base);
                    if (len + 1 + blen + 1 > PATH_MAX) {
                        skip_rename_check = 1;
                    } else {
                        dst_real[len] = '/';
                        memcpy(dst_real + len + 1, base, blen + 1);
                    }
                }
            }
        }

        if (!skip_rename_check) {
            size_t src_len = strlen(src_real);
            if (src_len < PATH_MAX &&
                strncmp(dst_real, src_real, src_len) == 0 &&
                dst_real[src_len] == '/') {
                fprintf(stderr,
                        "mv: cannot move '%s' into a subdirectory of itself, '%s'\n",
                        src, dst);
                return 1;
            }
        }
    }

    if (dst_exists) {
        if (S_ISDIR(src_stat.st_mode) && !S_ISDIR(dst_stat.st_mode)) {
            fprintf(stderr,
                    "mv: cannot replace non-directory '%s' with directory '%s'\n",
                    dst, src);
            return 1;
        }
        if (!S_ISDIR(src_stat.st_mode) && S_ISDIR(dst_stat.st_mode)) {
            fprintf(stderr,
                    "mv: cannot replace directory '%s' with non-directory '%s'\n",
                    dst, src);
            return 1;
        }
    }

    if (rename(src, dst) != 0) {
        fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n",
                src, dst, strerror(errno));
        return 1;
    }
    return 0;
}

static void get_basename(const char *path, char *out, size_t out_size)
{
    const char *slash = strrchr(path, '/');
    const char *base = (slash != NULL) ? slash + 1 : path;
    size_t len = strlen(base);
    if (len + 1 > out_size)
        len = out_size - 1;
    memcpy(out, base, len);
    out[len] = '\0';
}

int main(int argc, char *argv[])
{
    if (argc < 2) {
        fprintf(stderr, "mv: missing destination operand\n");
        return 1;
    }

    char **operands = malloc(sizeof(char *) * (size_t)(argc - 1));
    if (operands == NULL)
        return 1;
    int noperands = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        if (!after_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                after_ddash = 1;
            } else if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "mv: unknown option -- %s\n", argv[i]);
                free(operands);
                return 1;
            } else {
                operands[noperands++] = argv[i];
            }
        } else {
            operands[noperands++] = argv[i];
        }
    }

    if (noperands < 2) {
        fprintf(stderr, "mv: missing destination operand\n");
        free(operands);
        return 1;
    }

    int rc = 0;

    if (noperands > 2) {
        const char *destdir = operands[noperands - 1];
        struct stat ds;
        if (stat(destdir, &ds) != 0 || !S_ISDIR(ds.st_mode)) {
            fprintf(stderr, "mv: target '%s' is not a directory\n", destdir);
            free(operands);
            return 1;
        }
        for (int i = 0; i < noperands - 1; i++) {
            char base[NAME_MAX + 1];
            get_basename(operands[i], base, sizeof(base));
            char dst[PATH_MAX];
            int n = snprintf(dst, sizeof(dst), "%s/%s", destdir, base);
            if (n < 0 || (size_t)n >= sizeof(dst)) {
                fprintf(stderr, "mv: path too long for '%s'\n", operands[i]);
                rc = 1;
                continue;
            }
            if (move_path(operands[i], dst) != 0)
                rc = 1;
        }
    } else {
        const char *src = operands[0];
        const char *dst = operands[1];
        struct stat dst_stat;
        if (stat(dst, &dst_stat) == 0 && S_ISDIR(dst_stat.st_mode)) {
            char base[NAME_MAX + 1];
            get_basename(src, base, sizeof(base));
            char effective_dst[PATH_MAX];
            int n = snprintf(effective_dst, sizeof(effective_dst), "%s/%s", dst, base);
            if (n >= 0 && (size_t)n < sizeof(effective_dst)) {
                rc = move_path(src, effective_dst);
            } else {
                fprintf(stderr, "mv: path too long for '%s'\n", src);
                rc = 1;
            }
        } else {
            rc = move_path(src, dst);
        }
    }

    free(operands);
    return rc;
}
```

**Summary of behavior implemented:**
- `SOURCE DEST` and `SOURCE... DIRECTORY` invocation forms
- Option rejection (any `-x` before `--` is unknown); `--` terminator; bare `-` is a filename
- Directory-destination basename selection (using `stat` to follow symlinks)
- Same-file detection via device+inode
- Directory-into-itself/descendant detection via `realpath` prefix check
- Type compatibility enforcement (non-dir can't replace dir; dir can't replace non-dir)
- Non-empty destination directory: `rename()` fails with `ENOTEMPTY`, reported as error
- Per-source error continuation without rollback
- Symlinks moved as themselves (via `lstat` + `rename`)
- Arbitrary byte preservation (all string operations are byte-level)
- Exit status 0 on full success, 1 on any failure
- `move_path` is the semantic anchor called from `main`

**Interpretation chosen:** "Existing directory destinations select a source basename" uses `stat()` (follows symlinks) to determine directory-ness, consistent with GNU `mv` behavior. Type compatibility at the effective destination uses `lstat()` (actual filesystem object type).
