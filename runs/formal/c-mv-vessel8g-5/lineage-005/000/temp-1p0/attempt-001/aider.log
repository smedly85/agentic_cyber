    const char *dest = ops[nops - 1];
    int nsrc = nops - 1;

    /* Multiple sources require destination to be an existing directory. */
    if (nsrc > 1) {
        struct stat st;
        if (stat(dest, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "mv: target '%s': Not a directory\n", dest);
            free(ops);
            return 1;
        }
    }

    int any_fail = 0;

    for (int i = 0; i < nsrc; i++) {
        const char *src = ops[i];
        struct stat sst;
        if (lstat(src, &sst) != 0) {
            fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
            any_fail = 1;
            continue;
        }
        int src_is_dir = S_ISDIR(sst.st_mode);

        /* Compute effective destination path. */
        int dest_is_dir = (nsrc > 1); /* already verified for multi-source */
        if (nsrc == 1) {
            struct stat dst;
            if (stat(dest, &dst) == 0 && S_ISDIR(dst.st_mode))
                dest_is_dir = 1;
        }

        char *eff = NULL;
        if (dest_is_dir) {
            size_t dl = strlen(dest);
            while (dl > 1 && dest[dl - 1] == '/')
                dl--;
            const char *bn = base_of(src);
            size_t bl = strlen(bn);
            eff = malloc(dl + 1 + bl + 1);
            if (!eff) {
                fprintf(stderr, "mv: out of memory\n");
                any_fail = 1;
                continue;
            }
            memcpy(eff, dest, dl);
            eff[dl] = '/';
            memcpy(eff + dl + 1, bn, bl);
            eff[dl + 1 + bl] = '\0';
        } else {
            eff = (char *)dest;
        }
        int eff_owned = (eff != (char *)dest);

        /* Identity and descendant checks (both need realpath to resolve). */
        char *rs = realpath(src, NULL);
        char *rd = realpath(eff, NULL);
        if (rs && rd) {
            if (strcmp(rs, rd) == 0) {
                fprintf(stderr, "mv: '%s' and '%s' are the same file\n", src, eff);
                if (eff_owned) free(eff);
                free(rs); free(rd);
                any_fail = 1;
                continue;
            }
            if (src_is_dir) {
                size_t sl = strlen(rs);
                if (strncmp(rs, rd, sl) == 0 && rd[sl] == '/') {
                    fprintf(stderr,
                          "mv: cannot move '%s' to a subdirectory of itself, '%s'\n",
                          src, eff);
                    if (eff_owned) free(eff);
                    free(rs); free(rd);
                    any_fail = 1;
                    continue;
                }
            }
        }
        free(rs);
        free(rd);

        /* Type compatibility: stat the effective destination. */
        {
            struct stat dst;
            if (stat(eff, &dst) == 0) {
                int d_is_dir = S_ISDIR(dst.st_mode);
                if (src_is_dir && !d_is_dir) {
                    fprintf(stderr,
                          "mv: cannot move directory '%s' to non-directory '%s'\n",
                          src, eff);
                    if (eff_owned) free(eff);
                    any_fail = 1;
                    continue;
                }
                if (!src_is_dir && d_is_dir) {
                    fprintf(stderr,
                          "mv: cannot move '%s' to a subdirectory of itself, '%s'\n",
                          src, eff);
                    if (eff_owned) free(eff);
                    any_fail = 1;
                    continue;
                }
            }
        }

        /* Perform the move. */
        if (move_path(src, eff) != 0) {
            fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n",
                    src, eff, strerror(errno));
            if (eff_owned) free(eff);
            any_fail = 1;
            continue;
        }

        if (eff_owned) free(eff);
    }

    free(ops);
    return any_fail ? 1 : 0;
}
