#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>
#include <unistd.h>
#include <libgen.h>

static int move_path(const char *src, const char *dst) {
    struct stat src_stat, dst_stat;
    
    if (lstat(src, &src_stat) != 0) {
        fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }
    
    int dst_exists = (lstat(dst, &dst_stat) == 0);
    
    // Check identical (same inode)
    if (dst_exists && src_stat.st_dev == dst_stat.st_dev && src_stat.st_ino == dst_stat.st_ino) {
        fprintf(stderr, "mv: '%s' and '%s' are the same file\n", src, dst);
        return 1;
    }
    
    // If src is a directory, check dst is not inside src
    if (S_ISDIR(src_stat.st_mode)) {
        char src_real[PATH_MAX], dst_real[PATH_MAX];
        if (realpath(src, src_real) == NULL) {
            // shouldn't happen since lstat succeeded
            return 1;
        }
        if (dst_exists) {
            if (realpath(dst, dst_real) == NULL) {
                // dst exists but can't resolve? unlikely
                return 1;
            }
        } else {
            // dst doesn't exist; try to resolve its parent
            char dst_parent[PATH_MAX];
            strncpy(dst_parent, dst, PATH_MAX - 1);
            dst_parent[PATH_MAX - 1] = '\0';
            char *slash = strrchr(dst_parent, '/');
            if (slash == NULL) {
                // dst is just a filename, can't be inside src unless src is "."
                // But src is a directory, so dst would need to be like "src" which we handled above
                // Actually if dst is a bare name and src is a directory, dst isn't inside src
                // unless src is "." - but then dst would be "." which we'd catch via inode
                // Let's still check
                strcpy(dst_real, dst); // not canonical, but for prefix check
            } else {
                *slash = '\0';
                if (realpath(dst_parent, dst_real) != NULL) {
                    size_t len = strlen(dst_real);
                    if (len < PATH_MAX - 1) {
                        dst_real[len] = '/';
                        const char *base = slash + 1;
                        strncpy(dst_real + len + 1, base, PATH_MAX - len - 2);
                        dst_real[PATH_MAX - 1] = '\0';
                    }
                } else {
                    // Can't resolve parent; use lexical check
                    strcpy(dst_real, dst);
                }
            }
        }
        size_t src_len = strlen(src_real);
        if (strncmp(dst_real, src_real, src_len) == 0 && dst_real[src_len] == '/') {
            fprintf(stderr, "mv: cannot move '%s' into a subdirectory of itself, '%s'\n", src, dst);
            return 1;
        }
    }
    
    // Type compatibility at effective destination
    if (dst_exists) {
        if (S_ISDIR(src_stat.st_mode)) {
            // src is directory
            if (S_ISDIR(dst_stat.st_mode)) {
                // dst is directory: only OK if empty
                // Check if dst is empty
                // We'll let rename() handle this - if dst is non-empty, rename will fail with ENOTEMPTY
                // Actually, let's check explicitly for better diagnostics
                // But we can also just try rename and let the error tell us
                // For now, let rename handle it
            } else {
                // dst is non-directory, src is directory → incompatible
                fprintf(stderr, "mv: cannot overwrite non-directory '%s' with directory '%s'\n", dst, src);
                return 1;
            }
        } else {
            // src is non-directory
            if (S_ISDIR(dst_stat.st_mode)) {
                // dst is directory, src is non-directory → incompatible
                fprintf(stderr, "mv: cannot overwrite directory '%s' with non-directory '%s'\n", dst, src);
                return 1;
            }
        }
    }
    
    // Perform the move
    if (rename(src, dst) != 0) {
        fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n", src, dst, strerror(errno));
        return 1;
    }
    
    return 0;
}
