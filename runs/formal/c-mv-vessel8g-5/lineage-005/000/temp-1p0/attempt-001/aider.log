        return 1;
    }
    
    int is_multi = (noperands > 2);
    int any_failed = 0;
    
    if (is_multi) {
        // Last operand must be an existing directory
        const char *destdir = operands[noperands - 1];
        struct stat dir_stat;
        if (lstat(destdir, &dir_stat) != 0 || !S_ISDIR(dir_stat.st_mode)) {
            fprintf(stderr, "mv: target '%s' is not a directory\n", destdir);
            free(operands);
            return 1;
        }
        
        for (int i = 0; i < noperands - 1; i++) {
            const char *src = operands[i];
            char base[NAME_MAX + 1];
            if (basename_of(src, base, sizeof(base)) != 0) {
                fprintf(stderr, "mv: cannot determine basename of '%s'\n", src);
                any_failed = 1;
                continue;
            }
            char dst[PATH_MAX];
            if (snprintf(dst, sizeof(dst), "%s/%s", destdir, base) >= (int)sizeof(dst)) {
                fprintf(stderr, "mv: path too long for '%s'\n", src);
                any_failed = 1;
                continue;
            }
            if (move_path(src, dst) != 0) {
                any_failed = 1;
            }
        }
    } else {
        // Single source and destination
        const char *src = operands[0];
        const char *dst = operands[1];
        
        struct stat dst_stat;
        if (lstat(dst, &dst_stat) == 0 && S_ISDIR(dst_stat.st_mode)) {
            // Destination is a directory: effective dst = dst/src-basename
            char base[NAME_MAX + 1];
            if (basename_of(src, base, sizeof(base)) == 0) {
                char effective_dst[PATH_MAX];
                if (snprintf(effective_dst, sizeof(effective_dst), "%s/%s", dst, base) < (int)sizeof(effective_dst)) {
                    if (move_path(src, effective_dst) != 0) {
                        any_failed = 1;
                    }
                    goto cleanup;
                }
            }
        }
        
        if (move_path(src, dst) != 0) {
            any_failed = 1;
        }
    }
    
cleanup:
    free(operands);
    return any_failed ? 1 : 0;
}
```

