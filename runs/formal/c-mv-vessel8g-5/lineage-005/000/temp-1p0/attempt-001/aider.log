```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>
#include <unistd.h>

static int move_path(const char *src, const char *dst) {
    struct stat src_stat, dst_stat;

    if (lstat(src, &src_stat) != 0) {
        fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    int dst_exists = (lstat(dst, &dst_stat) == 0);

    /* Same file check (handles hardlinks and identical paths) */
    if (dst_exists &&
        src_stat.st_dev == dst_stat.st_dev &&
        src_stat.st_ino == dst_stat.st_ino) {
        fprintf(stderr, "mv: '%s' and '%s' are the same file\n", src, dst);
        return 1;
    }

    /* Directory-into-itself check */
    if (S_ISDIR(src_stat.st_mode)) {
        char src_real[PATH_MAX];
        char dst_real[PATH_MAX];

        if (realpath(src, src_real) == NULL) {
            fprintf(stderr, "mv: cannot resolve '%s': %s\n", src, strerror(errno));
            return 1;
        }

        if (dst_exists) {
            if (realpath(dst, dst_real) == NULL) {
                fprintf(stderr, "mv: cannot resolve '%s': %s\n", dst, strerror(errno));
                return 1;
            }
        } else {
            /* dst does not exist; resolve its parent directory */
            char parent_buf[PATH_MAX];
            memcpy(parent_buf, dst, PATH_MAX - 1);
            parent_buf[PATH_MAX - 1] = '\0';
            char *slash = strrchr(parent_buf, '/');
            if (slash != NULL) {
                *slash = '\0';
                if (realpath(parent_buf, dst_real) == NULL) {
                    /* Cannot resolve; let rename() report the error */
                    goto do_rename;
                }
                size_t len = strlen(dst_real);
                const char *base = slash + 1;
                size_t base_len = strlen(base);
                if (len + 1 + base_len + 1 > PATH_MAX) {
                    goto do_rename; /* too long, let rename handle it */
                }
                dst_real[len] = '/';
                memcpy(dst_real + len + 1, base, base_len + 1);
            } else {
                /* No directory component in dst; cannot be inside src */
                goto do_rename;
            }
        }

        size_t src_len = strlen(src_real);
        if (src_len < PATH_MAX &&
            strncmp(dst_real, src_real, src_len) == 0 &&
            dst_real[src_len] == '/') {
            fprintf(stderr, "mv: cannot move '%s' into a subdirectory of itself, '%s'\n",
                    src, dst);
            return 1;
        }
    }

    /* Type compatibility at the effective destination */
    if (dst_exists) {
        if (S_ISDIR(src_stat.st_mode) && !S_ISDIR(dst_stat.st_mode)) {
            fprintf(stderr, "mv: cannot replace non-directory '%s' with directory '%s'\n",
                    dst, src);
            return 1;
        }
        if (!S_ISDIR(src_stat.st_mode) && S_ISDIR(dst_stat.st_mode)) {
            fprintf(stderr, "mv: cannot replace directory '%s' with non-directory '%s'\n",
                    dst, src);
            return 1;
        }
    }

do_rename:
    if (rename(src, dst) != 0) {
        fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n", src, dst, strerror(errno));
        return 1;
    }
    return 0;
}

static void get_basename(const char *path, char *out, size_t out_size) {
    const char *slash = strrchr(path, '/');
    const char *base = (slash != NULL) ? slash + 1 : path;
    size_t len = strlen(base);
    if (len + 1 > out_size) len = out_size - 1;
    memcpy(out, base, len);
    out[len] = '\0';
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "mv: missing destination operand\n");
        return 1;
    }

    /* Parse: collect operands, reject unknown options before -- */
    char **operands = malloc(sizeof(char *) * (size_t)(argc - 1));
    if (operands == NULL) return 1;
    int noperands = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        if (!after_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                after_ddash = 1;
            } else if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "mv: unknown option -- %s\n", argv[i]);
                free(operands);
                return 1;
            } else {
                operands[noperands++] = argv[i];
            }
        } else {
            operands[noperands++] = argv[i];
        }
    }

    if (noperands < 2) {
        fprintf(stderr, "mv: missing destination operand\n");
        free(operands);
        return 1;
    }

    int rc = 0;

    if (noperands > 2) {
        /* Multi-source: last operand must be an existing directory */
        const char *destdir = operands[noperands - 1];
        struct stat ds;
        if (lstat(destdir, &ds) != 0 || !S_ISDIR(ds.st_mode)) {
            fprintf(stderr, "mv: target '%s' is not a directory\n", destdir);
            free(operands);
            return 1;
        }
        for (int i = 0; i < noperands - 1; i++) {
            char base[NAME_MAX + 1];
            get_basename(operands[i], base, sizeof(base));
            char dst[PATH_MAX];
            int n = snprintf(dst, sizeof(dst), "%s/%s", destdir, base);
            if (n < 0 || (size_t)n >= sizeof(dst)) {
                fprintf(stderr, "mv: path too long for '%s'\n", operands[i]);
                rc = 1;
                continue;
            }
            if (move_path(operands[i], dst) != 0) {
                rc = 1;
            }
        }
    } else {
        /* Single source and destination */
        const char *src = operands[0];
        const char *dst = operands[1];

        /* Check if dst is a directory (following symlinks) for basename selection */
        struct stat dst_stat;
        if (stat(dst, &dst_stat) == 0 && S_ISDIR(dst_stat.st_mode)) {
            char base[NAME_MAX + 1];
            get_basename(src, base, sizeof(base));
            char effective_dst[PATH_MAX];
            int n = snprintf(effective_dst, sizeof(effective_dst), "%s/%s", dst, base);
            if (n >= 0 && (size_t)n < sizeof(effective_dst)) {
                rc = move_path(src, effective_dst);
            } else {
                fprintf(stderr, "mv: path too long for '%s'\n", src);
                rc = 1;
            }
        } else {
            rc = move_path(src, dst);
        }
    }

    free(operands);
    return rc;
}
