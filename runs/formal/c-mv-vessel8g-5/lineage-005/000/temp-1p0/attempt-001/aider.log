```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>
#include <unistd.h>

static int move_path(const char *src, const char *dst)
{
    return rename(src, dst);
}

static const char *base_of(const char *path)
{
    const char *s = strrchr(path, '/');
    return s ? s + 1 : path;
}

int main(int argc, char *argv[])
{
    int after_ddash = 0;
    int nops = 0;
    const char **ops = malloc((size_t)argc * sizeof *ops);
    if (!ops) return 1;
    
    for (int i = 1; i < argc; i++) {
        if (!after_ddash) {
            if (strcmp(argv[i], "--") == 0) { after_ddash = 1; continue; }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "mv: invalid option -- '%c'\n", argv[i][1]);
                free(ops); return 1;
            }
        }
        ops[nops++] = argv[i];
    }
    
    if (nops < 2) {
        fprintf(stderr, "mv: missing operand\n");
        free(ops); return 1;
    }
    
    const char *dest = ops[nops - 1];
    int nsrc = nops - 1;
    
    if (nsrc > 1) {
        struct stat st;
        if (stat(dest, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "mv: target '%s': Not a directory\n", dest);
            free(ops); return 1;
        }
    }
    
    int failed = 0;
    
    for (int i = 0; i < nsrc; i++) {
        const char *src = ops[i];
        struct stat sst;
        if (lstat(src, &sst) != 0) {
            fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
            failed = 1; continue;
        }
        
        int src_dir = S_ISDIR(sst.st_mode);
        
        /* Determine effective destination */
        int dest_dir = 0;
        if (nsrc > 1) {
            dest_dir = 1; /* already validated */
        } else {
            struct stat dst;
            if (stat(dest, &dst) == 0 && S_ISDIR(dst.st_mode))
                dest_dir = 1;
        }
        
        char *eff = NULL;
        if (dest_dir) {
            size_t dl = strlen(dest);
            while (dl > 1 && dest[dl-1] == '/') dl--; /* keep at least 1 char for "/" */
            const char *base = base_of(src);
            size_t bl = strlen(base);
            eff = malloc(dl + 1 + bl + 1);
            if (!eff) { fprintf(stderr, "mv: out of memory\n"); failed = 1; continue; }
            memcpy(eff, dest, dl);
            eff[dl] = '/';
            memcpy(eff + dl + 1, base, bl);
            eff[dl + 1 + bl] = '\0';
        } else {
            eff = (char *)dest;
        }
        
        /* Identity / descendant check for directories */
        if (src_dir) {
            char *rs = realpath(src, NULL);
            char *rd = realpath(eff, NULL);
            if (rs && rd) {
                size_t sl = strlen(rs);
                if (strncmp(rs, rd, sl) == 0 && (rd[sl] == '\0' || rd[sl] == '/')) {
                    fprintf(stderr, "mv: cannot move '%s' into itself\n", src);
                    free(rs); free(rd);
                    if (eff != (char*)dest) free(eff);
                    failed = 1; continue;
                }
            }
            free(rs); free(rd);
        }
        
        /* Type compatibility: non-dir into existing dir, or dir into existing non-dir */
        /* stat the effective dest to check */
        struct stat dst;
        if (stat(eff, &dst) == 0) {
            int ddir = S_ISDIR(dst.st_mode);
            if (src_dir && !ddir) {
                fprintf(stderr, "mv: cannot overwrite '%s' with directory '%s'\n", eff, src);
                if (eff != (char*)dest) free(eff);
                failed = 1; continue;
            }
            if (!src_dir && ddir) {
                fprintf(stderr, "mv: cannot overwrite directory '%s' with '%s'\n", eff, src);
                if (eff != (char*)dest) free(eff);
                failed = 1; continue;
            }
        }
        
        /* Perform the move */
        if (move_path(src, eff) != 0) {
            fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n", src, eff, strerror(errno));
            if (eff != (char*)dest) free(eff);
            failed = 1; continue;
        }
        
        if (eff != (char*)dest) free(eff);
    }
    
    free(ops);
    return failed ? 1 : 0;
}
