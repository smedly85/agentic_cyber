                        char *real_parent = realpath(parent_copy, NULL);
                        if (real_parent) {
                            size_t plen = strlen(real_parent);
                            size_t src_len = strlen(real_src);
                            if (strncmp(real_parent, real_src, src_len) == 0 &&
                                (real_parent[src_len] == '/' ||
