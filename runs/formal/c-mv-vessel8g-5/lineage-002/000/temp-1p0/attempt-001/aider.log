Looking at the requirements, I need to implement `c_mv.c` from scratch — a POSIX `mv` that handles:
- Single and multi-source moves
- Argument parsing with `--` terminator
- Type compatibility checks (dir vs nondir)
- Directory-into-itself detection
- Identical source/destination detection
- Empty-directory replacement (but not merging)
- Per-source error recovery
- The `move_path` semantic anchor

Here's my implementation plan, then the code:

**Architecture:**
1. Parse args (handle `--`, reject unknown options, accept bare `-`)
2. Determine if dest is a directory (mandatory for multi-source)
3. For each source in order: validate (exists, type compat, identical, descendant, empty-dir), then call `move_path`
4. `move_path` wraps `rename()`

**Key decisions:**
- Use `lstat()` (not `stat()`) to classify types — symlinks are always "nondirectory"
- Use `realpath()` for identity and descendant checks
- Use `opendir`/`readdir` to check if a destination directory is empty
- `rename()` is the core operation (same-filesystem only, per spec)
- No options implemented; any `-X` before `--` is an unknown-option error

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>
#include <dirent.h>

/* move_path: core filesystem operation — moves src to dest via rename() */
static int move_path(const char *src, const char *dest)
{
    if (rename(src, dest) != 0) {
        fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n",
                src, dest, strerror(errno));
        return -1;
    }
    return 0;
}

/* Returns 1 if directory is empty, 0 if not, -1 on error */
static int dir_is_empty(const char *path)
{
    DIR *d = opendir(path);
    if (!d)
        return -1;
    struct dirent *entry;
    while ((entry = readdir(d)) != NULL) {
        if (strcmp(entry->d_name, ".") != 0 &&
            strcmp(entry->d_name, "..") != 0) {
            closedir(d);
            return 0;
        }
    }
    closedir(d);
    return 1;
}

/* Returns pointer to the last path component (after final '/') */
static const char *path_basename(const char *path)
{
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

/* Returns 1 if desc is a proper sub-path of anc (both absolute, no trailing /) */
static int is_proper_descendant(const char *anc, const char *desc)
{
    size_t len = strlen(anc);
    if (strncmp(desc, anc, len) != 0)
        return 0;
    if (len == strlen(desc))
        return 0;
    return desc[len] == '/';
}

int main(int argc, char **argv)
{
    /* --- Parse arguments --- */
    int seen_ddash = 0;

    /* Pass 1: validate and count operands */
    int n_ops = 0;
    for (int i = 1; i < argc; i++) {
        if (!seen_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                seen_ddash = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
