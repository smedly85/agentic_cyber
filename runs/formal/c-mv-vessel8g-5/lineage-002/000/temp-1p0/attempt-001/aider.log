    const char **ops = malloc((size_t)n_ops * sizeof(*ops));
    if (!ops) {
        fprintf(stderr, "mv: out of memory\n");
        return 1;
    }
    n_ops = 0;
    seen_ddash = 0;
    for (int i = 1; i < argc; i++) {
        if (!seen_ddash && strcmp(argv[i], "--") == 0) {
