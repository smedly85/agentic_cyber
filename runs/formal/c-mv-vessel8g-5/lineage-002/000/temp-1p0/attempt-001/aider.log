#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <errno.h>
#include <dirent.h>

/* move_path: core filesystem operation for moving a single path */
static int move_path(const char *src, const char *dest) {
    if (rename(src, dest) != 0) {
        fprintf(stderr, "mv: cannot move '%s' to '%s': %s\n", src, dest, strerror(errno));
        return -1;
    }
    return 0;
}

/* Check if a directory is empty */
static int dir_is_empty(const char *path) {
    DIR *d = opendir(path);
    if (!d) return -1;
    struct dirent *entry;
    while ((entry = readdir(d)) != NULL) {
        if (strcmp(entry->d_name, ".") != 0 && strcmp(entry->d_name, "..") != 0) {
            closedir(d);
            return 0;
        }
    }
    closedir(d);
    return 1;
}

/* Get basename (last component) of a path */
static const char *path_basename(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

/* Check if 'desc' is a proper descendant of 'anc' (both absolute, normalized) */
static int is_proper_descendant(const char *anc, const char *desc) {
    size_t len = strlen(anc);
    if (strncmp(desc, anc, len) != 0) return 0;
    if (len == strlen(desc)) return 0; /* same path */
    return desc[len] == '/';
}

int main(int argc, char **argv) {
    /* Parse arguments */
    int seen_ddash = 0;
    
    /* First pass: validate and count */
    int n_ops = 0;
    for (int i = 1; i < argc; i++) {
        if (!seen_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                seen_ddash = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                fprintf(stderr, "mv: invalid option -- '%c'\n", argv[i][1]);
                return 1;
            }
        }
        n_ops++;
    }
    
    if (n_ops < 2) {
        fprintf(stderr, "mv: missing destination operand\n");
        return 1;
    }
    
    /* Second pass: collect operands */
    const char **ops = malloc((size_t)n_ops * sizeof(char *));
    if (!ops) {
        fprintf(stderr, "mv: out of memory\n");
        return 1;
    }
    n_ops = 0;
    seen_ddash = 0;
    for (int i = 1; i < argc; i++) {
        if (!seen_ddash) {
            if (strcmp(argv[i], "--") == 0) {
                seen_ddash = 1;
                continue;
            }
        }
        ops[n_ops++] = argv[i];
    }
    
    int n_sources = n_ops - 1;
    const char *dest = ops[n_ops - 1];
    
    /* Determine if dest is a directory */
    struct stat st_dest;
    int dest_is_dir = 0;
    int dest_exists = (lstat(dest, &st_dest) == 0);
    
    if (n_sources > 1) {
        if (!dest_exists || !S_ISDIR(st_dest.st_mode)) {
            fprintf(stderr, "mv: target '%s' is not a directory\n", dest);
            free(ops);
            return 1;
        }
        dest_is_dir = 1;
    } else if (dest_exists) {
        dest_is_dir = S_ISDIR(st_dest.st_mode);
    }
    
    int any_failed = 0;
    
    for (int i = 0; i < n_sources; i++) {
        const char *src = ops[i];
        
        /* Check source exists */
        struct stat st_src;
        if (lstat(src, &st_src) != 0) {
            fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
            any_failed = 1;
            continue;
        }
        
        int src_is_dir = S_ISDIR(st_src.st_mode);
        
        /* Compute effective destination */
        char *eff_dest = NULL;
        if (dest_is_dir) {
            const char *base = path_basename(src);
            size_t len = strlen(dest) + 1 + strlen(base) + 1;
            eff_dest = malloc(len);
            if (!eff_dest) {
                fprintf(stderr, "mv: out of memory\n");
                free(ops);
                return 1;
            }
            memcpy(eff_dest, dest, strlen(dest));
            eff_dest[strlen(dest)] = '/';
            memcpy(eff_dest + strlen(dest) + 1, base, strlen(base) + 1);
        } else {
            eff_dest = strdup(dest);
            if (!eff_dest) {
                fprintf(stderr, "mv: out of memory\n");
                free(ops);
                return 1;
            }
        }
        
        /* Check effective destination */
        struct stat st_eff;
        int eff_exists = (lstat(eff_dest, &st_eff) == 0);
        int eff_is_dir = eff_exists && S_ISDIR(st_eff.st_mode);
        
        if (eff_exists) {
            /* Type compatibility */
            if (src_is_dir && !eff_is_dir) {
                fprintf(stderr, "mv: cannot move directory '%s' to non-directory '%s'\n", src, eff_dest);
                free(eff_dest);
                any_failed = 1;
                continue;
            }
            if (!src_is_dir && eff_is_dir) {
                fprintf(stderr, "mv: cannot overwrite directory '%s' with non-directory '%s'\n", eff_dest, src);
                free(eff_dest);
                any_failed = 1;
                continue;
            }
            
            /* Check identical */
            char *real_src = realpath(src, NULL);
            char *real_eff = realpath(eff_dest, NULL);
            if (real_src && real_eff) {
                if (strcmp(real_src, real_eff) == 0) {
                    fprintf(stderr, "mv: '%s' and '%s' are the same file\n", src, eff_dest);
                    free(real_src);
                    free(real_eff);
                    free(eff_dest);
                    any_failed = 1;
                    continue;
                }
                /* Check directory into itself */
                if (src_is_dir && is_proper_descendant(real_src, real_eff)) {
                    fprintf(stderr, "mv: cannot move '%s' into a subdirectory of itself, '%s'\n", src, eff_dest);
                    free(real_src);
                    free(real_eff);
                    free(eff_dest);
                    any_failed = 1;
                    continue;
                }
            }
            free(real_src);
            free(real_eff);
            
            /* If both are directories, check dest is empty */
            if (src_is_dir && eff_is_dir) {
                if (!dir_is_empty(eff_dest)) {
                    fprintf(stderr, "mv: cannot overwrite non-empty directory '%s' with directory '%s'\n", eff_dest, src);
                    free(eff_dest);
                    any_failed = 1;
                    continue;
                }
            }
        } else {
            /* Effective dest doesn't exist */
            /* Check directory into itself (textual check) */
            if (src_is_dir) {
                char *real_src = realpath(src, NULL);
                if (real_src) {
                    /* Try to resolve the parent of eff_dest */
                    char *parent = strdup(eff_dest);
                    char *child = NULL;
                    if (parent) {
                        char *last_slash = strrchr(parent, '/');
                        if (last_slash) {
                            *last_slash = '\0';
                            child = last_slash + 1;
                        }
                        char *real_parent = realpath(parent, NULL);
                        if (real_parent) {
                            /* Construct the real eff_dest */
                            if (child) {
                                size_t plen = strlen(real_parent);
                                size_t clen = strlen(child);
                                char *real_eff = malloc(plen + 1 + clen + 1);
                                if (real_eff) {
                                    memcpy(real_eff, real_parent, plen);
                                    real_eff[plen] = '/';
                                    memcpy(real_eff + plen + 1, child, clen + 1);
                                    if (is_proper_descendant(real_src, real_eff)) {
                                        fprintf(stderr, "mv: cannot move '%s' into a subdirectory of itself, '%s'\n", src, eff_dest);
                                        free(real_src);
                                        free(real_eff);
                                        free(parent);
                                        free(eff_dest);
                                        any_failed = 1;
                                        continue;
                                    }
                                    free(real_eff);
                                }
                            } else {
                                if (is_proper_descendant(real_src, real_parent) || strcmp(real_src, real_parent) == 0) {
                                    fprintf(stderr, "mv: cannot move '%s' into a subdirectory of itself, '%s'\n", src, eff_dest);
                                    free(real_src);
                                    free(parent);
                                    free(eff_dest);
                                    any_failed = 1;
                                    continue;
                                }
                            }
                            free(real_parent);
                        }
                        free(parent);
                    }
                    free(real_src);
                }
            }
        }
        
        /* Perform the move */
        if (move_path(src, eff_dest) != 0) {
            any_failed = 1;
        }
        
        free(eff_dest);
    }
    
    free(ops);
    return any_failed ? 1 : 0;
}
```

