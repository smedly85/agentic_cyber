    /* --- Process each source in order --- */
    int any_failed = 0;

    for (int i = 0; i < n_sources; i++) {
        const char *src = ops[i];

        /* Source must exist */
        struct stat st_src;
        if (lstat(src, &st_src) != 0) {
            fprintf(stderr, "mv: cannot stat '%s': %s\n", src, strerror(errno));
            any_failed = 1;
