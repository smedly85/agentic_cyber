    if (n < 2) {
        if (n == 0)
            fprintf(stderr, XPROG
                ": missing source and destination operands\n");
        else
            fprintf(stderr, XPROG ": missing destination operand\n");
        return 1;
    }

    int multi = (n > 2);
    int rc = 0;

    if (multi) {
        const char *dest_dir = operands[n - 1];
        struct stat sb;
        if (stat(dest_dir, &sb) != 0 || !S_ISDIR(sb.st_mode)) {
            fprintf(stderr, XPROG ": target '%s' is not a directory\n", dest_dir);
            return 1;
        }

        for (int i = 0; i < n - 1; i++) {
            const char *src = operands[i];
            const char *base = path_basename(src);
            char dst[PATH_MAX];
            if (construct_dest(dest_dir, base, dst, sizeof(dst)) != 0) {
                fprintf(stderr, XPROG ": path too long\n");
                rc = 1;
                continue;
            }
            if (move_path(src, dst) != 0)
                rc = 1;
        }
    } else {
        const char *src = operands[0];
        const char *dst = operands[1];

        struct stat sb;
        if (lstat(dst, &sb) == 0 && S_ISDIR(sb.st_mode)) {
            const char *base = path_basename(src);
            char eff_dst[PATH_MAX];
            if (construct_dest(dst, base, eff_dst, sizeof(eff_dst)) != 0) {
                fprintf(stderr, XPROG ": path too long\n");
                return 1;
            }
            if (move_path(src, eff_dst) != 0)
                rc = 1;
        } else {
            if (move_path(src, dst) != 0)
                rc = 1;
        }
    }

    return rc;
}
```

**Key design decisions:**

1. **`move_path`** is the core filesystem operation, called from `main` for each source. It performs `lstat` on both source and destination, checks type compatibility, detects identical paths and directory-into-itself, then calls `rename()`.

2. **Type compatibility** uses `lstat` (not `stat`), so symlinks are treated as non-directories. This correctly implements "a nondirectory source may replace a nondirectory destination symlink itself."

3. **Directory-into-itself** is detected lexically via `dir_is_ancestor_or_self`, which checks if the destination path is the source or starts with `source + "/"`.

