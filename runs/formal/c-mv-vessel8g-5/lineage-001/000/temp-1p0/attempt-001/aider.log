Looking at the requirements, I need to implement a complete `mv`-like utility from scratch in C11. Let me analyze the key requirements:

1. **Argument parsing**: operands before/after `--`, bare `-` is a filename, unknown options are errors
2. **Single source**: `SOURCE DEST` or `SOURCE DIR/` (effective dest = `DIR/basename`)
3. **Multi-source**: `SOURCE... DIRECTORY` (last must be existing dir)
4. **Core move**: `move_path` function using `rename()`, with type compatibility checks, identical-path detection, and directory-into-itself detection
5. **Error handling**: per-source failures continue, invocation-wide errors are fatal before any changes

Here's the implementation for `src/c_mv/c_mv.c`:

```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>

#ifndef PATH_MAX
#define PATH_MAX 4096
#endif

#define XPROG "c_mv"
#define MAX_OPERANDS 256

static const char *path_basename(const char *path)
{
    size_t len = strlen(path);
    while (len > 1 && path[len - 1] == '/')
        len--;
    const char *last_slash = NULL;
    for (const char *p = path + len; p > path; ) {
        p--;
        if (*p == '/') {
            last_slash = p;
            break;
        }
    }
    return last_slash ? last_slash + 1 : path;
}

static int paths_identical(const char *a, const char *b)
{
    char ra[PATH_MAX], rb[PATH_MAX];
    char *pa = realpath(a, ra);
    char *pb = realpath(b, rb);
    if (pa && pb)
        return strcmp(pa, pb) == 0;
    return strcmp(a, b) == 0;
}

static int dir_is_ancestor_or_self(const char *dir, const char *path)
{
    size_t dlen = strlen(dir);
    while (dlen > 1 && dir[dlen - 1] == '/')
        dlen--;
    if (strlen(path) == dlen && strncmp(dir, path, dlen) == 0)
        return 1;
    if (strncmp(dir, path, dlen) == 0 && path[dlen] == '/')
        return 1;
    return 0;
}

static int move_path(const char *src, const char *dst)
{
    struct stat src_sb;
    if (lstat(src, &src_sb) != 0) {
        fprintf(stderr, XPROG ": cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    struct stat dst_sb;
    int dst_exists = (lstat(dst, &dst_sb) == 0);

    if (dst_exists) {
        if (paths_identical(src, dst)) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
        int src_is_dir = S_ISDIR(src_sb.st_mode);
        int dst_is_dir = S_ISDIR(dst_sb.st_mode);
        if (src_is_dir && !dst_is_dir) {
            fprintf(stderr, XPROG
                ": cannot overwrite non-directory '%s' with directory '%s'\n",
                dst, src);
            return 1;
        }
        if (!src_is_dir && dst_is_dir) {
            fprintf(stderr, XPROG
                ": cannot overwrite directory '%s' with non-directory '%s'\n",
                dst, src);
            return 1;
        }
    } else {
        if (paths_identical(src, dst)) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
    }

    if (S_ISDIR(src_sb.st_mode) && dir_is_ancestor_or_self(src, dst)) {
        fprintf(stderr, XPROG ": cannot move directory '%s' into itself\n", src);
        return 1;
    }

    if (rename(src, dst) != 0) {
        fprintf(stderr, XPROG ": cannot move '%s' to '%s': %s\n",
            src, dst, strerror(errno));
        return 1;
    }
    return 0;
}

static int construct_dest(const char *dir, const char *base, char *out, size_t outsz)
{
    size_t dlen = strlen(dir);
    while (dlen > 1 && dir[dlen - 1] == '/')
        dlen--;
    size_t blen = strlen(base);
    if (dlen + 1 + blen + 1 > outsz)
        return -1;
    memcpy(out, dir, dlen);
    out[dlen] = '/';
    memcpy(out + dlen + 1, base, blen + 1);
    return 0;
}

int main(int argc, char *argv[])
{
    const char *operands[MAX_OPERANDS];
    int n = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (after_ddash) {
            if (n >= MAX_OPERANDS) {
                fprintf(stderr, XPROG ": too many operands\n");
                return 1;
            }
            operands[n++] = arg;
        } else if (strcmp(arg, "--") == 0) {
            after_ddash = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            fprintf(stderr, XPROG ": unknown option '%s'\n", arg);
            return 1;
        } else {
            if (n >= MAX_OPERANDS) {
                fprintf(stderr, XPROG ": too many operands\n");
                return 1;
            }
            operands[n++] = arg;
        }
