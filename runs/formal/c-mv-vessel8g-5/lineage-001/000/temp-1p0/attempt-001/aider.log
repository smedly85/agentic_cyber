#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>

#define XPROG "c_mv"

static const char *path_basename(const char *path) {
    size_t len = strlen(path);
    while (len > 1 && path[len - 1] == '/')
        len--;
    const char *last_slash = NULL;
    for (const char *p = path + len; p > path; ) {
        p--;
        if (*p == '/') {
            last_slash = p;
            break;
        }
    }
    return last_slash ? last_slash + 1 : path;
}

static int paths_identical(const char *a, const char *b) {
    char ra[PATH_MAX], rb[PATH_MAX];
    char *pa = realpath(a, ra);
    char *pb = realpath(b, rb);
    if (pa && pb)
        return strcmp(pa, pb) == 0;
    return strcmp(a, b) == 0;
}

static int dir_is_ancestor_or_self(const char *dir, const char *path) {
    size_t dlen = strlen(dir);
    while (dlen > 1 && dir[dlen - 1] == '/')
        dlen--;
    if (strlen(path) == dlen && strncmp(dir, path, dlen) == 0)
        return 1;
    if (strncmp(dir, path, dlen) == 0 && path[dlen] == '/')
        return 1;
    return 0;
}

static int move_path(const char *src, const char *dst) {
    struct stat src_sb;
    if (lstat(src, &src_sb) != 0) {
        fprintf(stderr, XPROG ": cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    struct stat dst_sb;
    int dst_exists = (lstat(dst, &dst_sb) == 0);

    if (dst_exists) {
        if (paths_identical(src, dst)) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
        int src_is_dir = S_ISDIR(src_sb.st_mode);
        int dst_is_dir = S_ISDIR(dst_sb.st_mode);
        if (src_is_dir && !dst_is_dir) {
            fprintf(stderr, XPROG ": cannot overwrite non-directory '%s' with directory '%s'\n", dst, src);
            return 1;
        }
        if (!src_is_dir && dst_is_dir) {
            fprintf(stderr, XPROG ": cannot overwrite directory '%s' with non-directory '%s'\n", dst, src);
            return 1;
        }
    } else {
        if (paths_identical(src, dst)) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
    }

    if (S_ISDIR(src_sb.st_mode) && dir_is_ancestor_or_self(src, dst)) {
        fprintf(stderr, XPROG ": cannot move directory '%s' into itself\n", src);
        return 1;
    }

    if (rename(src, dst) != 0) {
        fprintf(stderr, XPROG ": cannot move '%s' to '%s': %s\n", src, dst, strerror(errno));
        return 1;
    }
    return 0;
}

int main(int argc, char *argv[]) {
    const char *operands[256];
    int n = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (after_ddash) {
            if (n >= 256) {
                fprintf(stderr, XPROG ": too many operands\n");
                return 1;
            }
            operands[n++] = arg;
        } else if (strcmp(arg, "--") == 0) {
            after_ddash = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            fprintf(stderr, XPROG ": unknown option '%s'\n", arg);
            return 1;
        } else {
            if (n >= 256) {
                fprintf(stderr, XPROG ": too many operands\n");
                return 1;
            }
            operands[n++] = arg;
        }
    }

    if (n < 2) {
        if (n == 0)
            fprintf(stderr, XPROG ": missing source and destination operands\n");
        else
            fprintf(stderr, XPROG ": missing destination operand\n");
        return 1;
    }

    int multi = (n > 2);
    int rc = 0;

    if (multi) {
        const char *dest_dir = operands[n - 1];
        struct stat sb;
        if (stat(dest_dir, &sb) != 0) {
            fprintf(stderr, XPROG ": target '%s' is not a directory\n", dest_dir);
            return 1;
        }
        if (!S_ISDIR(sb.st_mode)) {
            fprintf(stderr, XPROG ": target '%s' is not a directory\n", dest_dir);
            return 1;
        }

        for (int i = 0; i < n - 1; i++) {
            const char *src = operands[i];
            const char *base = path_basename(src);
            size_t dlen = strlen(dest_dir);
            while (dlen > 1 && dest_dir[dlen - 1] == '/')
                dlen--;
            char dst[PATH_MAX];
            if (dlen + 1 + strlen(base) + 1 > sizeof(dst)) {
                fprintf(stderr, XPROG ": path too long\n");
                rc = 1;
                continue;
            }
            memcpy(dst, dest_dir, dlen);
            dst[dlen] = '/';
            memcpy(dst + dlen + 1, base, strlen(base) + 1);

            if (move_path(src, dst) != 0)
                rc = 1;
        }
    } else {
        const char *src = operands[0];
        const char *dst = operands[1];

        struct stat sb;
        if (lstat(dst, &sb) == 0 && S_ISDIR(sb.st_mode)) {
            const char *base = path_basename(src);
            size_t dlen = strlen(dst);
            while (dlen > 1 && dst[dlen - 1] == '/')
                dlen--;
            char eff_dst[PATH_MAX];
            if (dlen + 1 + strlen(base) + 1 > sizeof(eff_dst)) {
                fprintf(stderr, XPROG ": path too long\n");
                return 1;
            }
            memcpy(eff_dst, dst, dlen);
            eff_dst[dlen] = '/';
            memcpy(eff_dst + dlen + 1, base, strlen(base) + 1);
            if (move_path(src, eff_dst) != 0)
                rc = 1;
        } else {
            if (move_path(src, dst) != 0)
                rc = 1;
        }
    }

    return rc;
}
