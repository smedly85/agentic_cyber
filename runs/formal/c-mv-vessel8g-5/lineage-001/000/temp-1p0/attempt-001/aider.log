Now for the main function and argument parsing:

```c
int main(int argc, char *argv[]) {
    // Parse arguments
    const char **operands = NULL;
    int n_operands = 0;
    int end_of_options = 0;
    
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (end_of_options) {
            // All remaining are operands
            operands = realloc(operands, (n_operands + 1) * sizeof(*operands));
            operands[n_operands++] = arg;
        } else if (strcmp(arg, "--") == 0) {
            end_of_options = 1;
        } else if (strcmp(arg, "-") == 0) {
            // Bare dash is a filename
            operands = realloc(operands, (n_operands + 1) * sizeof(*operands));
            operands[n_operands++] = arg;
        } else if (arg[0] == '-') {
            // Unknown option
            fprintf(stderr, XPROG ": unknown option '%s'\n", arg);
            return 1;
        } else {
            operands = realloc(operands, (n_operands + 1) * sizeof(*operands));
            operands[n_operands++] = arg;
        }
    }
    
    if (n_operands < 2) {
        fprintf(stderr, XPROG ": missing destination operand\n");
        return 1;
    }
    
    int multi = (n_operands > 2);
    int any_failure = 0;
    
    if (multi) {
        // Last operand must be an existing directory
        const char *last = operands[n_operands - 1];
        struct stat sb;
        if (stat(last, &sb) != 0 || !S_ISDIR(sb.st_mode)) {
            fprintf(stderr, XPROG ": target '%s' is not a directory\n", last);
            return 1;
        }
        for (int i = 0; i < n_operands - 1; i++) {
            const char *src = operands[i];
            const char *base = path_basename(src);
            // Construct dest = last + "/" + base
            size_t llen = strlen(last);
            while (llen > 1 && last[llen-1] == '/') llen--;
            size_t blen = strlen(base);
            char *dst = malloc(llen + 1 + blen + 1);
            memcpy(dst, last, llen);
            dst[llen] = '/';
            memcpy(dst + llen + 1, base, blen + 1);
            
            if (move_path(src, dst) != 0)
                any_failure = 1;
            free(dst);
        }
    } else {
        // Single source, single dest
        const char *src = operands[0];
        const char *dst = operands[1];
        
        // Check if dst is an existing directory
        struct stat sb;
