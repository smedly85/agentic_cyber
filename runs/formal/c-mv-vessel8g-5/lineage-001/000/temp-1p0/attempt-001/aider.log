```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <limits.h>

#define XPROG "c_mv"

static const char *path_basename(const char *path) {
    size_t len = strlen(path);
    while (len > 1 && path[len - 1] == '/')
        len--;
    const char *last_slash = NULL;
    for (const char *p = path + len; p > path; ) {
        p--;
        if (*p == '/') {
            last_slash = p;
            break;
        }
    }
    return last_slash ? last_slash + 1 : path;
}

static int is_same_path(const char *a, const char *b) {
    char ra[PATH_MAX], rb[PATH_MAX];
    char *ra_p = realpath(a, ra);
    char *rb_p = realpath(b, rb);
    if (ra_p && rb_p)
        return strcmp(ra_p, rb_p) == 0;
    return strcmp(a, b) == 0;
}

static int dir_contains(const char *dir, const char *path) {
    // Check if 'path' is 'dir' or a descendant of 'dir'
    size_t dlen = strlen(dir);
    // Remove trailing slash from dir for comparison
    while (dlen > 1 && dir[dlen - 1] == '/')
        dlen--;
    if (strcmp(dir, path) == 0)
        return 1;
    if (strncmp(dir, path, dlen) == 0 && path[dlen] == '/')
        return 1;
    return 0;
}

static int move_path(const char *src, const char *dst) {
    struct stat src_sb;
    if (lstat(src, &src_sb) != 0) {
        fprintf(stderr, XPROG ": cannot stat '%s': %s\n", src, strerror(errno));
        return 1;
    }

    // Check if destination exists
    struct stat dst_sb;
    int dst_exists = (lstat(dst, &dst_sb) == 0);

    if (dst_exists) {
        // Identical source and destination
        if (is_same_path(src, dst)) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
        // Type compatibility
        int src_dir = S_ISDIR(src_sb.st_mode);
        int dst_dir = S_ISDIR(dst_sb.st_mode);
        if (src_dir && !dst_dir) {
            fprintf(stderr, XPROG ": cannot overwrite non-directory '%s' with directory '%s'\n", dst, src);
            return 1;
        }
        if (!src_dir && dst_dir) {
            fprintf(stderr, XPROG ": cannot overwrite directory '%s' with non-directory '%s'\n", dst, src);
            return 1;
        }
    } else {
        // Check identical (lexical, since dst doesn't exist realpath may fail)
        if (strcmp(src, dst) == 0) {
            fprintf(stderr, XPROG ": '%s' and '%s' are the same file\n", src, dst);
            return 1;
        }
    }

    // Check directory moved into itself or its descendant
    if (S_ISDIR(src_sb.st_mode) && dst_exists && S_ISDIR(dst_sb.st_mode)) {
        if (dir_contains(src, dst)) {
            fprintf(stderr, XPROG ": cannot move directory '%s' into itself\n", src);
            return 1;
        }
    }
    // Also check if dst would be inside src (even if dst doesn't exist yet)
    if (S_ISDIR(src_sb.st_mode)) {
        if (dir_contains(src, dst)) {
            fprintf(stderr, XPROG ": cannot move directory '%s' into itself\n", src);
            return 1;
        }
    }

    if (rename(src, dst) != 0) {
        fprintf(stderr, XPROG ": cannot move '%s' to '%s': %s\n", src, dst, strerror(errno));
        return 1;
    }
    return 0;
}
```

