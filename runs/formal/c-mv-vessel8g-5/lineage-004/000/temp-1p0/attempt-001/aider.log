Let me write a helper that canonicalizes a path as much as possible:

```c
static char *canonicalize(const char *path) {
    char *result = realpath(path, NULL);
    if (result) return result;
    /* Path doesn't exist. Try to canonicalize the existing prefix. */
    /* Find the longest existing ancestor. */
    char *copy = strdup(path);
    if (!copy) return NULL;
    /* Walk up, removing the last component until realpath succeeds */
    for (;;) {
        char *slash = strrchr(copy, '/');
        if (!slash || slash == copy) { free(copy); return NULL; }
        *slash = '\0';
        result = realpath(copy, NULL);
        if (result) { free(copy); return result; }
    }
}
```

