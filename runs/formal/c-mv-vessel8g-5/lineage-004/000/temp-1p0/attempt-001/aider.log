```c
#define _POSIX_C_SOURCE 200809L

#include <dirent.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

/* Core filesystem move operation. */
static int move_path(const char *src, const char *dst)
{
    return rename(src, dst);
}

/* Return a pointer to the basename within path (after last '/'). */
static const char *path_basename(const char *path)
{
    const char *slash = strrchr(path, '/');
    if (slash == NULL)
        return path;
    /* Handle trailing slash: "dir/" → basename is "dir" */
    if (slash[1] == '\0') {
        /* Find the previous slash or start */
        const char *prev = NULL;
        for (const char *p = slash - 1; p >= path; p--) {
            if (*p == '/') {
                prev = p;
                break;
            }
        }
        if (prev == NULL)
            return path;
        return prev + 1;
    }
    return slash + 1;
}

/* Join two path components with '/'. Returns malloc'd string. */
static char *path_join(const char *dir, const char *name)
{
    size_t dl = strlen(dir);
    size_t nl = strlen(name);
    int need_slash = (dl > 0 && dir[dl - 1] != '/');
    size_t total = dl + (size_t)need_slash + nl + 1;
    char *buf = malloc(total);
    if (buf == NULL)
        return NULL;
    memcpy(buf, dir, dl);
    size_t pos = dl;
    if (need_slash)
        buf[pos++] = '/';
    memcpy(buf + pos, name, nl + 1);
    return buf;
}

/* Return 1 if directory is nonempty, 0 if empty, -1 on error. */
static int dir_nonempty(const char *path)
{
    DIR *d = opendir(path);
    if (d == NULL)
        return -1;
    struct dirent *e;
    int result = 0;
    while ((e = readdir(d)) != NULL) {
        if (strcmp(e->d_name, ".") != 0 && strcmp(e->d_name, "..") != 0) {
            result = 1;
            break;
        }
    }
    closedir(d);
    return result;
}

/* Check if 'path' equals 'ancestor' or is inside it. Both should be canonical absolute paths. */
static int is_within(const char *ancestor, const char *path)
{
    size_t al = strlen(ancestor);
    if (strncmp(ancestor, path, al) != 0)
        return 0;
    if (path[al] == '\0')
        return 1;
    if (path[al] == '/')
        return 1;
    return 0;
}

/* Try to canonicalize a path. Returns malloc'd canonical string or NULL. */
static char *canonicalize_path(const char *path)
{
    char *r = realpath(path, NULL);
    if (r != NULL)
        return r;
    /* Path doesn't exist; try its parent directory. */
    char *copy = strdup(path);
    if (copy == NULL)
        return NULL;
    char *slash = strrchr(copy, '/');
    if (slash != NULL && slash != copy) {
        *slash = '\0';
        r = realpath(copy, NULL);
    }
    free(copy);
    return r;
}

int main(int argc, char **argv)
{
    /* ---- Phase 1: Parse command line ---- */
    size_t max_ops = (argc > 1) ? (size_t)(argc - 1) : 1;
    const char **operands = malloc(max_ops * sizeof(*operands));
    if (operands == NULL) {
        fprintf(stderr, "c_mv: out of memory\n");
        return 1;
    }
    int nops = 0;
    int after_ddash = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!after_ddash) {
            if (strcmp(arg, "--") == 0) {
                after_ddash = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                fprintf(stderr, "c_mv: unrecognized option: %s\n", arg);
                free(operands);
                return 1;
            }
        }
        operands[nops++] = arg;
    }

    if (nops < 2) {
        fprintf(stderr, "c_mv: missing destination operand\n");
        free(operands);
        return 1;
    }

    int nsrc = nops - 1;

    /* Multi-source: last operand must be an existing directory. */
    if (nops > 2) {
        const char *last = operands[nops - 1];
        struct stat st;
        if (stat(last, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_mv: %s: not a directory\n", last);
            free(operands);
            return 1;
        }
    }

    /* ---- Phase 2: Validate all sources before any filesystem changes ---- */
    char **eff_dest = malloc((size_t)nsrc * sizeof(*eff_dest));
    if (eff_dest == NULL) {
        fprintf(stderr, "c_mv: out of memory\n");
        free(operands);
        return 1;
    }

    int validation_failed = 0;

    for (int i = 0; i < nsrc; i++) {
        const char *src = operands[i];
        char *ed = NULL;

        if (nops == 2) {
            const char *dst = operands[1];
            struct stat st;
            if (stat(dst, &st) == 0 && S_ISDIR(st.st_mode))
                ed = path_join(dst, path_basename(src));
            else
                ed = strdup(dst);
        } else {
            const char *dd = operands[nops - 1];
            ed = path_join(dd, path_basename(src));
        }

        if (ed == NULL) {
            fprintf(stderr, "c_mv: out of memory\n");
            eff_dest[i] = NULL;
            validation_failed = 1;
            continue;
        }
        eff_dest[i] = ed;

        /* Source must exist. */
        struct stat ss;
        if (lstat(src, &ss) != 0) {
            fprintf(stderr, "c_mv: %s: %s\n", src, strerror(errno));
            validation_failed = 1;
            continue;
        }

        /* Identical source and destination (lexical). */
        if (strcmp(src, ed) == 0) {
            fprintf(stderr, "c_mv: %s: source and destination are identical\n", src);
            validation_failed = 1;
            continue;
        }

        /* Identical source and destination (via inode). */
        {
            struct stat a, b;
            if (stat(src, &a) == 0 && stat(ed, &b) == 0) {
                if (a.st_dev == b.st_dev && a.st_ino == b.st_ino) {
                    fprintf(stderr, "c_mv: %s: source and destination are identical\n", src);
                    validation_failed = 1;
                    continue;
                }
            }
        }

        /* Type compatibility at the effective destination. */
        struct stat ds;
        if (lstat(ed, &ds) == 0) {
            if (S_ISDIR(ss.st_mode) && !S_ISDIR(ds.st_mode)) {
                fprintf(stderr, "c_mv: cannot move directory %s to non-directory %s\n", src, ed);
                validation_failed = 1;
                continue;
            }
            if (!S_ISDIR(ss.st_mode) && S_ISDIR(ds.st_mode)) {
                fprintf(stderr, "c_mv: cannot move non-directory %s to directory %s\n", src, ed);
                validation_failed = 1;
                continue;
            }
            if (S_ISDIR(ss.st_mode) && S_ISDIR(ds.st_mode)) {
                int ne = dir_nonempty(ed);
                if (ne > 0) {
                    fprintf(stderr, "c_mv: cannot move directory %s into non-empty directory %s\n", src, ed);
                    validation_failed = 1;
                    continue;
                }
            }
        }

        /* Directory moved into itself or its descendant. */
        if (S_ISDIR(ss.st_mode)) {
            char *src_canon = canonicalize_path(src);
            char *dst_canon = canonicalize_path(ed);
            if (src_canon != NULL && dst_canon != NULL) {
                if (is_within(src_canon, dst_canon)) {
                    fprintf(stderr, "c_mv: cannot move directory %s into itself or its subdirectory\n", src);
                    validation_failed = 1;
                }
            }
            free(src_canon);
            free(dst_canon);
        }
    }

    if (validation_failed) {
        for (int i = 0; i < nsrc; i++)
            free(eff_dest[i]);
        free(eff_dest);
        free(operands);
        return 1;
    }

    /* ---- Phase 3: Execute moves in operand order ---- */
    int any_move_failed = 0;

    for (int i = 0; i < nsrc; i++) {
        if (move_path(operands[i], eff_dest[i]) != 0) {
            fprintf(stderr, "c_mv: cannot move %s to %s: %s\n",
                    operands[i], eff_dest[i], strerror(errno));
            any_move_failed = 1;
            /* Continue with remaining sources. */
        }
    }

    /* Cleanup. */
    for (int i = 0; i < nsrc; i++)
        free(eff_dest[i]);
    free(eff_dest);
    free(operands);

    return any_move_failed ? 1 : 0;
}
