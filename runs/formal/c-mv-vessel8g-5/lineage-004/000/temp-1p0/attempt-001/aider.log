/* Concatenate two paths with a / separator */
static char *path_join(const char *dir, const char *name) {
    size_t dl = strlen(dir), nl = strlen(name);
    int slash = (dl > 0 && dir[dl-1] != '/') ? 1 : 0;
    char *buf = malloc(dl + slash + nl + 1);
    if (!buf) return NULL;
    memcpy(buf, dir, dl);
    size_t pos = dl;
    if (slash) buf[pos++] = '/';
    memcpy(buf + pos, name, nl + 1);
    return buf;
}

/* Check if a directory is nonempty */
static int dir_nonempty(const char *path) {
    DIR *d = opendir(path);
    if (!d) return -1;
    struct dirent *e;
    int result = 0;
    while ((e = readdir(d)) != NULL) {
