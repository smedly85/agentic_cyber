```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <sys/stat.h>
#include <limits.h>
#include <dirent.h>
#include <stdbool.h>

static int move_path(const char *src, const char *dst) {
    if (rename(src, dst) != 0) {
        return -1;
    }
    return 0;
}

static const char *get_basename(const char *path) {
    const char *slash = strrchr(path, '/');
    if (slash == NULL) return path;
    return slash + 1;
}

static char *concat_path(const char *dir, const char *name) {
    // Handle case where dir already ends with /
    size_t dir_len = strlen(dir);
    int need_slash = (dir_len > 0 && dir[dir_len - 1] != '/');
    size_t name_len = strlen(name);
    size_t total = dir_len + (need_slash ? 1 : 0) + name_len + 1;
    char *result = malloc(total);
    if (!result) return NULL;
    memcpy(result, dir, dir_len);
    size_t pos = dir_len;
    if (need_slash) {
        result[pos++] = '/';
    }
    memcpy(result + pos, name, name_len + 1);
    return result;
}

static int dir_is_nonempty(const char *path) {
    DIR *dir = opendir(path);
    if (dir == NULL) return -1;
    struct dirent *entry;
    int nonempty = 0;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") != 0 && strcmp(entry->d_name, "..") != 0) {
            nonempty = 1;
            break;
        }
    }
    closedir(dir);
    return nonempty;
}

static int is_same_or_descendant(const char *ancestor, const char *descendant) {
    size_t len = strlen(ancestor);
    if (strncmp(ancestor, descendant, len) != 0) return 0;
    if (descendant[len] == '\0') return 1;
    if (descendant[len] == '/') return 1;
    return 0;
}

static char *get_dir_component(const char *path) {
    const char *last_slash = strrchr(path, '/');
    if (last_slash == NULL) return strdup(".");
    if (last_slash == path) return strdup("/");
    size_t len = last_slash - path;
    char *result = malloc(len + 1);
    if (!result) return NULL;
    memcpy(result, path, len);
    result[len] = '\0';
    return result;
}

int main(int argc, char **argv) {
    // Phase 1: Parse arguments
    int num_operands = 0;
    const char **operands = malloc(sizeof(char *) * argc);
    if (!operands) {
        fprintf(stderr, "c_mv: out of memory\n");
        return 1;
    }
    
    int seen_ddash = 0;
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!seen_ddash) {
            if (strcmp(arg, "--") == 0) {
                seen_ddash = 1;
            } else if (strcmp(arg, "-") == 0) {
                operands[num_operands++] = arg;
            } else if (arg[0] == '-' && arg[1] != '\0') {
                fprintf(stderr, "c_mv: unknown option: %s\n", arg);
                free(operands);
                return 1;
            } else {
                operands[num_operands++] = arg;
            }
        } else {
            operands[num_operands++] = arg;
        }
    }
    
    // Check minimum operands
    if (num_operands < 2) {
        fprintf(stderr, "c_mv: missing destination operand\n");
        free(operands);
        return 1;
    }
    
    // Phase 2: Determine effective destinations and validate
    
    // For multi-source, last operand must be an existing directory
    if (num_operands > 2) {
        const char *dest_dir = operands[num_operands - 1];
        struct stat st;
        if (stat(dest_dir, &st) != 0) {
            fprintf(stderr, "c_mv: %s: not a directory\n", dest_dir);
            free(operands);
            return 1;
        }
        if (!S_ISDIR(st.st_mode)) {
            fprintf(stderr, "c_mv: %s: not a directory\n", dest_dir);
            free(operands);
            return 1;
        }
    }
    
    // For each source, determine effective dest and validate
    char **effective_dests = malloc(sizeof(char *) * (num_operands - 1));
    struct stat *src_stats = malloc(sizeof(struct stat) * (num_operands - 1));
    if (!effective_dests || !src_stats) {
        fprintf(stderr, "c_mv: out of memory\n");
        free(operands);
        return 1;
    }
    
    int any_error = 0;
    const char *num_sources = (num_operands == 2) ? "1" : "multiple";
    
    for (int i = 0; i < num_operands - 1; i++) {
        const char *src = operands[i];
        char *eff_dest = NULL;
        
        // Determine effective destination
        if (num_operands == 2) {
            const char *dest = operands[1];
            struct stat dest_st;
            if (stat(dest, &dest_st) == 0 && S_ISDIR(dest_st.st_mode)) {
                // dest is a directory, effective dest is dest/basename(src)
                eff_dest = concat_path(dest, get_basename(src));
            } else {
                // dest is not a directory (or doesn't exist), effective dest is dest
                eff_dest = strdup(dest);
            }
        } else {
            const char *dest_dir = operands[num_operands - 1];
            eff_dest = concat_path(dest_dir, get_basename(src));
        }
        
        if (!eff_dest) {
            fprintf(stderr, "c_mv: out of memory\n");
            // cleanup...
            return 1;
        }
        
        effective_dests[i] = eff_dest;
        
        // Check source exists
        struct stat src_st;
        if (lstat(src, &src_st) != 0) {
            fprintf(stderr, "c_mv: %s: %s\n", src, strerror(errno));
            any_error = 1;
            continue;
        }
        src_stats[i] = src_st;
        
        // Check identical source and destination
        if (strcmp(src, eff_dest) == 0) {
            fprintf(stderr, "c_mv: %s and %s are the same file\n", src, eff_dest);
            any_error = 1;
            continue;
        }
        
        // Check via stat (follows symlinks)
        struct stat src_stat_follow, dest_stat_follow;
        if (stat(src, &src_stat_follow) == 0 && stat(eff_dest, &dest_stat_follow) == 0) {
            if (src_stat_follow.st_dev == dest_stat_follow.st_dev &&
                src_stat_follow.st_ino == dest_stat_follow.st_ino) {
                fprintf(stderr, "c_mv: %s and %s are the same file\n", src, eff_dest);
                any_error = 1;
                continue;
            }
        }
        
        // Type compatibility check
        struct stat dest_lstat;
        if (lstat(eff_dest, &dest_lstat) == 0) {
            if (S_ISDIR(src_st.st_mode) && !S_ISDIR(dest_lstat.st_mode)) {
                fprintf(stderr, "c_mv: cannot replace %s (non-directory) with directory %s\n", eff_dest, src);
                any_error = 1;
                continue;
            }
            if (!S_ISDIR(src_st.st_mode) && S_ISDIR(dest_lstat.st_mode)) {
                fprintf(stderr, "c_mv: cannot replace directory %s with non-directory %s\n", eff_dest, src);
                any_error = 1;
                continue;
            }
            if (S_ISDIR(src_st.st_mode) && S_ISDIR(dest_lstat.st_mode)) {
                // Check if dest is nonempty
                int nonempty = dir_is_nonempty(eff_dest);
                if (nonempty > 0) {
                    fprintf(stderr, "c_mv: cannot move directory %s into non-empty directory %s\n", src, eff_dest);
                    any_error = 1;
                    continue;
                }
            }
        }
        
        // Directory into itself check
        if (S_ISDIR(src_st.st_mode)) {
            char *src_real = realpath(src, NULL);
            char *dest_dir_comp = get_dir_component(eff_dest);
            if (src_real && dest_dir_comp) {
                char *dest_real = realpath(dest_dir_comp, NULL);
                if (dest_real) {
                    if (is_same_or_descendant(src_real, dest_real)) {
                        fprintf(stderr, "c_mv: cannot move directory %s into itself or its subdirectory %s\n", src, eff_dest);
                        any_error = 1;
                    }
                    free(dest_real);
                }
                free(dest_dir_comp);
            }
            free(src_real);
        }
    }
    
    // If any validation error, don't proceed with moves
    if (any_error) {
        for (int i = 0; i < num_operands - 1; i++) {
            free(effective_dests[i]);
        }
        free(effective_dests);
        free(src_stats);
        free(operands);
        return 1;
    }
    
    // Phase 3: Execute moves
    int move_failed = 0;
    for (int i = 0; i < num_operands - 1; i++) {
        if (move_path(operands[i], effective_dests[i]) != 0) {
            fprintf(stderr, "c_mv: cannot move %s to %s: %s\n",
                    operands[i], effective_dests[i], strerror(errno));
            move_failed = 1;
            // Continue with next source
        }
    }
    
    // Cleanup
    for (int i = 0; i < num_operands - 1; i++) {
        free(effective_dests[i]);
    }
    free(effective_dests);
    free(src_stats);
    free(operands);
    
    return move_failed ? 1 : 0;
}
