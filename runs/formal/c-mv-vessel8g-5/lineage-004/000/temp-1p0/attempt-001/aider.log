```c
// Check if 'child' is the same as or inside 'parent'
static int is_same_or_inside(const char *parent_real, const char *child_real) {
    size_t len = strlen(parent_real);
    if (strncmp(parent_real, child_real, len) != 0) return 0;
    if (child_real[len] == '\0') return 1; // same
    if (child_real[len] == '/') return 1; // inside
    return 0;
}
```

