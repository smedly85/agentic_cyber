static char *canonicalize(const char *path) {
    char *result = realpath(path, NULL);
    if (result) return result;
    /* Try the directory component */
    char *copy = strdup(path);
    if (!copy) return NULL;
    char *slash = strrchr(copy, '/');
    if (slash && slash != copy) {
        *slash = '\0';
        result = realpath(copy, NULL);
    }
    free(copy);
    return result;
    /* If both fail, we can't determine the relationship */
}
