		struct stat ds;
		int dest_exists = 0;
		if (lstat(eff_dest[i], &ds) == 0) {
			dest_exists = 1;
			if (S_ISDIR(ss.st_mode) && !S_ISDIR(ds.st_mode)) {
				fprintf(stderr, "c_mv: cannot move directory %s to non-directory %s\n", src, eff_dest[i]);
				any_move_failed = 1;
