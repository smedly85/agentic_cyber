```python
#!/usr/bin/env python3
"""Bounded grep: fixed-byte-substring line matcher."""
import os
import sys


def search_stream(data: bytes, pattern: bytes) -> list[bytes]:
    """Return lines (without delimiters) from data that contain pattern.
    Lines are delimited by 0x0A; a trailing 0x0A does not create an extra
    empty line. An empty pattern matches every line."""
    if not data:
        return []
    parts = data.split(b'\n')
    if parts and parts[-1] == b'':
        parts.pop()
    if not pattern:
        return parts
    return [p for p in parts if pattern in p]


def main() -> None:
    argv = sys.argv[1:]
    
    # --- parse ---
    i = 0
    pattern = None
    files: list[str] = []
    
    while i < len(argv):
        arg = argv[i]
        if arg == '--':
            i += 1
            continue
        if pattern is None:
            if arg.startswith('-') and len(arg) > 1:
                _usage_error(f"unsupported option: {arg}")
            pattern = os.fsencode(arg)
        else:
            files.append(arg)
        i += 1
    
    if pattern is None:
        _usage_error("missing PATTERN")
    
    need_prefix = len(files) >= 2
    found = False
    had_error = False
    
    try:
        if not files:
            data = sys.stdin.buffer.read()
            lines = search_stream(data, pattern)
            _emit(lines, b'', need_prefix, files)
            found = bool(lines)
        else:
            for fname in files:
                try:
                    fd = os.open(fname, os.O_RDONLY)
                except OSError as e:
                    _diagnose(fname, e)
                    had_error = True
                    continue
                try:
                    chunks = []
                    while True:
                        chunk = os.read(fd, 1 << 20)
                        if not chunk:
                            break
                        chunks.append(chunk)
                    data = b''.join(chunks)
                except OSError as e:
                    _diagnose(fname, e)
                    had_error = True
                finally:
                    os.close(fd)
                lines = search_stream(data, pattern)
                if lines:
                    prefix = os.fsencode(fname) + b':' if need_prefix else b''
                    _emit(lines, prefix, need_prefix, files)
                    found = True
    except (OSError, BrokenPipeError, MemoryError):
        sys.exit(2)
    
    if had_error:
        sys.exit(2)
    sys.exit(0 if found else 1)


def _emit(lines: list[bytes], prefix: bytes, need_prefix: bool, files: list[str]) -> None:
    out = sys.stdout.buffer
    for line in lines:
        out.write(prefix + line + b'\n')
    out.flush()


def _diagnose(fname: str, exc: OSError) -> None:
    name = os.fsencode(fname)
    if isinstance(exc, IsADirectoryError):
        msg = b"Is a directory"
    elif isinstance(exc, FileNotFoundError):
        msg = b"No such file or directory"
    elif isinstance(exc, PermissionError):
        msg = b"Permission denied"
    else:
        msg = os.fsencode(str(exc))
    sys.stderr.buffer.write(name + b": " + msg + b"\n")
    sys.stderr.buffer.flush()


def _usage_error(msg: str) -> None:
    sys.stderr.buffer.write(msg.encode('utf-8', 'surrogateescape') + b"\n")
    sys.stderr.buffer.write(b"usage: py_grep PATTERN [FILE...]\n")
    sys.stderr.buffer.flush()
    sys.exit(2)
```

