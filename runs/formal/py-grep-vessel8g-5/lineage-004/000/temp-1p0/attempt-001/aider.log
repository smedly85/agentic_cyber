#!/usr/bin/env python3
import sys

def search_stream(data: bytes, pattern: bytes) -> list[bytes]:
    """Core line-selection: return lines from data that contain pattern."""
    if not data:
        return []
    lines = data.split(b'\n')
    # If input ends with newline, last element is empty - it's not a line
    if lines and lines[-1] == b'':
        lines = lines[:-1]
    if not pattern:
        return lines
