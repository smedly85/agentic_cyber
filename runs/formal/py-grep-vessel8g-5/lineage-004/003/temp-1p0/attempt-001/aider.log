```python
def main() -> None:
    argv = sys.argv[1:]

    # ---- argument parsing ----
    i = 0
    pattern: bytes | None = None
    files: list[str] = []
    no_options = False
    filename_mode: bool | None = None

    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            no_options = True
            i += 1
            continue
        if not no_options and arg.startswith("-") and len(arg) > 1:
            if arg == "--with-filename":
                filename_mode = True
                i += 1
                continue
            if arg == "--no-filename":
                filename_mode = False
                i += 1
                continue
            # short option (possibly clustered)
            if arg.startswith("--"):
                _usage_error(b"py_grep: unsupported option: " + os.fsencode(arg))
            cluster = arg[1:]  # strip leading '-'
            for ch in cluster:
                if ch == "H":
                    filename_mode = True
                elif ch == "h":
                    filename_mode = False
                else:
                    _usage_error(b"py_grep: unsupported option: " + os.fsencode("-" + ch))
            i += 1
            continue
        if pattern is None:
            pattern = os.fsencode(arg)
        else:
            files.append(arg)
        i += 1

    if pattern is None:
        _usage_error(b"py_grep: missing PATTERN")

    if filename_mode is True:
        need_prefix = True
    elif filename_mode is False:
        need_prefix = False
    else:
        need_prefix = len(files) >= 2

    found = False
    had_error = False

    # ---- search ----
    if not files:
        data = sys.stdin.buffer.read()
        lines = search_stream(data, pattern)
        if lines:
            prefix = b"(standard input):" if need_prefix else b""
            _write_lines(lines, prefix)
            found = True
    else:
        for fname in files:
            try:
                with open(fname, "rb") as f:
                    data = f.read()
            except MemoryError:
                sys.exit(2)
            except OSError as e:
                _diagnose(fname, e)
                had_error = True
                continue
            lines = search_stream(data, pattern)
            if lines:
                prefix = os.fsencode(fname) + b":" if need_prefix else b""
                _write_lines(lines, prefix)
                found = True

    # ---- exit status ----
    if had_error:
        sys.exit(2)
    sys.exit(0 if found else 1)
```

