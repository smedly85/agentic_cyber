def _traverse(dirpath: str, pattern: bytes, need_prefix: bool) -> bool:
    """Traverse dirpath in pre-order (entries in ascending raw-byte order).
    Returns True if any line was selected."""
    found = False
    try:
        entries = os.listdir(dirpath)
    except OSError as e:
        _diagnose(dirpath, e)
        return False
    
    # Sort by raw bytes of the name
    entries.sort(key=os.fsencode)
    
    for name in entries:
        full = dirpath.rstrip("/") + "/" + name if dirpath != "/" else dirpath + name
        # Avoid doubled separator
        if dirpath.endswith("/") and dirpath != "/":
            full = dirpath + name
        else:
            full = dirpath + "/" + name
        
        try:
            if os.path.islink(full):
                continue  # skip symlinks during traversal
            if os.path.isdir(full):
                found = _traverse(full, pattern, need_prefix) or found
            elif os.path.isfile(full):
                try:
                    with open(full, "rb") as f:
                        data = f.read()
                except OSError as e:
                    _diagnose(full, e)
                    continue
                lines = search_stream(data, pattern)
                if lines:
                    if need_prefix:
                        prefix = os.fsencode(full) + b":"
                    else:
                        prefix = b""
                    _write_lines(lines, prefix)
                    found = True
        except OSError:
            continue
    return found
```

