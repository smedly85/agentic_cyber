The cleanest iterative pre-order traversal:

```python
def traverse_dir(operand: str, pattern: bytes, do_prefix: bool) -> tuple[int, bool]:
    """Iterative pre-order traversal of a directory tree."""
    count = 0
    had_error = False
    # Stack of paths; we'll classify each when we pop it
    stack = [operand]
    
    while stack:
        path = stack.pop()
        # Classify: is it a dir or file? (we skip symlinks)
        try:
            if os.path.islink(path):
                continue
            if not os.path.isdir(path):
                # It's a regular file (or something else - only search regular files)
                if os.path.isfile(path):
                    if do_prefix:
                        prefix = path.encode('utf-8', 'surrogateescape') + b':'
                    else:
                        prefix = b''
                    with open(path, 'rb') as f:
                        count += search_stream(pattern, f, prefix)
                continue
        except OSError as e:
            _diagnose(path, e)
            had_error = True
            continue
        
        # It's a directory - list and push children in reverse
        try:
            entries = os.listdir(path)
        except OSError as e:
            _diagnose(path, e)
            had_error = True
            continue
        
        entries.sort(key=lambda name: name.encode('utf-8', 'surrogateescape'))
        
        # Push in reverse so the first entry is processed first (LIFO stack)
        for entry in reversed(entries):
            full_path = os.path.join(path, entry)
            stack.append(full_path)
    
    return count, had_error
```

