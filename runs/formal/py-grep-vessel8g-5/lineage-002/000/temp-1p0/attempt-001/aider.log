```python
#!/usr/bin/env python3
"""Bounded grep: fixed byte substring search over lines."""
import sys


def search_stream(pattern: bytes, stream, prefix: bytes) -> int:
    """Search a binary stream line-by-line for `pattern`.
    Write each matched line (with trailing newline) to sys.stdout.buffer.
    Returns the number of matched lines."""
    out = sys.stdout.buffer
    count = 0
    while True:
        line = stream.readline()
        if not line:
            break
        content = line[:-1] if line.endswith(b'\n') else line
        if pattern in content:
            out.write(prefix + content + b'\n')
            count += 1
    return count


def main() -> int:
    args = sys.argv[1:]
    
    # Parse: -- ends options; anything starting with - (except - and --) is an option
    operands: list[str] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == '--':
            # Everything after is an operand
            operands.extend(args[i+1:])
            break
        elif arg.startswith('-') and arg != '-':
            # Unsupported option
            sys.stderr.write("py_grep: unsupported option: %s\n" % arg)
            return 2
        else:
            operands.append(arg)
        i += 1
    
    if not operands:
        sys.stderr.write("py_grep: missing PATTERN\n")
        return 2
    
    pattern_str = operands[0]
    file_operands = operands[1:]
    
    pattern = pattern_str.encode('utf-8', 'surrogateescape')
    
    total_matches = 0
    had_error = False
    
    if not file_operands:
        # Search stdin
        count = search_stream(pattern, sys.stdin.buffer, b'')
        total_matches += count
    else:
        # Determine prefix mode
        multi = len(file_operands) >= 2
        for operand in file_operands:
            # Encode the operand as bytes for the prefix
            operand_bytes = operand.encode('utf-8', 'surrogateescape')
            if multi:
                prefix = operand_bytes + b':'
            else:
                prefix = b''
            
            try:
                f = open(operand, 'rb')
            except (OSError, ValueError) as e:
                sys.stderr.write("py_grep: %s: %s\n" % (operand, e.strerror or "error"))
                had_error = True
                continue
            
            try:
                # Check if it's a directory
                import os
                if os.path.isdir(operand):
                    sys.stderr.write("py_grep: %s: Is a directory\n" % operand)
                    had_error = True
                    f.close()
                    continue
                count = search_stream(pattern, f, prefix)
                total_matches += count
            except OSError as e:
                sys.stderr.write("py_grep: %s: %s\n" % (operand, e.strerror or "error"))
                had_error = True
            finally:
                try:
                    f.close()
                except OSError:
                    pass
    
    if had_error:
        return 2
    elif total_matches > 0:
        return 0
    else:
        return 1


if __name__ == '__main__':
    sys.exit(main())
```

