```python
#!/usr/bin/env python3
"""Bounded fixed-string grep: search lines of files or stdin for a byte substring."""

import os
import sys


def search_stream(stream, pattern):
    """Read a binary stream, yielding each 0x0A-delimited line (without the
    delimiter) that contains `pattern`. An empty pattern matches every line.
    A final unterminated line is still a line."""
    buf = b""
    while True:
        chunk = stream.read(65536)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            idx = buf.index(b"\n")
            line = buf[:idx]
            buf = buf[idx + 1:]
            if pattern in line:
                yield line
    if buf:
        if pattern in buf:
            yield buf


def main():
    args = sys.argv[1:]
    i = 0
    pattern_str = None
    files = []

    while i < len(args):
        token = args[i]
        if pattern_str is None:
            if token == "--":
                i += 1
                continue
            if token.startswith("-") and len(token) > 1:
                sys.stderr.buffer.write(
                    f"py_grep: unrecognized option '{token}'\n".encode()
                    + b"Usage: py_grep PATTERN [FILE...]\n"
                )
                sys.stderr.buffer.flush()
                sys.exit(2)
            pattern_str = token
        else:
            files.append(token)
        i += 1

    if pattern_str is None:
        sys.stderr.buffer.write(
            b"py_grep: no PATTERN supplied\n"
            b"Usage: py_grep PATTERN [FILE...]\n"
        )
        sys.stderr.buffer.flush()
        sys.exit(2)

    pattern = os.fsencode(pattern_str)
    matched = False
    had_error = False
    multi = len(files) >= 2
    out = sys.stdout.buffer

    if not files:
        # Search standard input
        try:
            for line in search_stream(sys.stdin.buffer, pattern):
                out.write(line + b"\n")
                matched = True
        except (OSError, MemoryError) as exc:
            had_error = True
            sys.stderr.buffer.write(
                f"py_grep: stdin: {exc.strerror or exc}\n".encode("utf-8", "replace")
            )
        out.flush()
    else:
        for name in files:
            path = os.fsencode(name)
            try:
                if os.path.isdir(path):
                    sys.stderr.buffer.write(
                        f"py_grep: {name}: Is a directory\n".encode("utf-8", "replace")
                    )
                    had_error = True
                    continue
                with open(path, "rb") as fh:
                    for line in search_stream(fh, pattern):
                        if multi:
                            out.write(path + b":" + line + b"\n")
                        else:
                            out.write(line + b"\n")
                        matched = True
            except PermissionError:
                sys.stderr.buffer.write(
                    f"py_grep: {name}: Permission denied\n".encode("utf-8", "replace")
                )
                had_error = True
            except FileNotFoundError:
                sys.stderr.buffer.write(
                    f"py_grep: {name}: No such file or directory\n".encode("utf-8", "replace")
                )
                had_error = True
            except (OSError, MemoryError) as exc:
                msg = getattr(exc, "strerror", None) or str(exc)
                sys.stderr.buffer.write(
                    f"py_grep: {name}: {msg}\n".encode("utf-8", "replace")
                )
                had_error = True
        out.flush()

    if had_error:
        sys.exit(2)
    sys.exit(0 if matched else 1)


if __name__ == "__main__":
    try:
        main()
    except (OSError, MemoryError) as exc:
        msg = getattr(exc, "strerror", None) or str(exc)
        try:
            sys.stderr.buffer.write(f"py_grep: {msg}\n".encode("utf-8", "replace"))
            sys.stderr.buffer.flush()
        except Exception:
            pass
        sys.exit(2)
    except Exception as exc:
        try:
            sys.stderr.buffer.write(f"py_grep: internal error: {exc}\n".encode("utf-8", "replace"))
            sys.stderr.buffer.flush()
        except Exception:
            pass
        sys.exit(2)
```

