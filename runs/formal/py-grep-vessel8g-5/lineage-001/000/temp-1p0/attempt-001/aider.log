#!/usr/bin/env python3
import sys
import os

def search_stream(stream, pattern):
    """Read lines from a binary stream, yield each line (without trailing 0x0A)
    that contains pattern. Empty pattern matches every line."""
    buf = b""
    while True:
        chunk = stream.read(65536)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            if pattern in line:
                yield line
    # Final unterminated line
