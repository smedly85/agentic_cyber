#!/usr/bin/env python3
"""Bounded fixed-string grep: search lines for a byte substring."""

import os
import sys


def search_stream(stream, pattern):
    """Read a binary stream line by line (0x0A-delimited) and yield each
    line (without its trailing 0x0A) that contains `pattern`.
    An empty pattern matches every line.
    A final unterminated line (no trailing 0x0A) is still a line."""
    buf = b""
    while True:
        try:
            chunk = stream.read(65536)
        except (OSError, MemoryError):
            # Treat as end-of-data; caller handles errors
            chunk = b""
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            idx = buf.index(b"\n")
            line = buf[:idx]
            buf = buf[idx + 1:]
            if pattern in line:
                yield line
    if buf:
        if pattern in buf:
            yield buf
