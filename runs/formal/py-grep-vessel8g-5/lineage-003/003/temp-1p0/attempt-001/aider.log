#!/usr/bin/env python3
"""py_grep: bounded fixed-string grep (checkpoint 003)."""
import os
import stat
import sys


def search_stream(data: bytes, pattern: bytes) -> list[bytes]:
    """Return lines from data that contain pattern as a fixed byte substring.

    Lines are delimited by 0x0A. A final unterminated line is a line.
    An empty pattern matches every line. Empty input yields no lines.
    """
    if not data:
        return []
    parts = data.split(b'\n')
    if parts[-1] == b'':
        parts = parts[:-1]
    return [line for line in parts if pattern in line]


def traverse(base_path: str, pattern: bytes, display_base: str, use_prefix: bool,
             out, state: dict) -> None:
    """Iterative pre-order DFS traversal of base_path.
    
    state is a dict with keys: had_error (bool), found_match (bool)
    """
    # Stack of (fs_dir_path, display_dir_path, entries_iterator)
    def get_sorted_entries(path):
        try:
            entries = os.listdir(path)
        except PermissionError:
            state['had_error'] = True
            sys.stderr.write(f"py_grep: {path}: Permission denied\n")
            return []
        except FileNotFoundError:
            state['had_error'] = True
            sys.stderr.write(f"py_grep: {path}: No such file or directory\n")
            return []
        except OSError:
            state['had_error'] = True
            sys.stderr.write(f"py_grep: {path}: cannot read\n")
            return []
        return sorted(entries, key=os.fsencode)
    
    stack = [(base_path, display_base, iter(get_sorted_entries(base_path)))]
    
    while stack:
        fs_dir, disp_dir, it = stack[-1]
        try:
            entry = next(it)
        except StopIteration:
            stack.pop()
            continue
        except RecursionError:
            # shouldn't happen with iterative approach
            state['had_error'] = True
            continue
        
        fs_path = fs_dir + '/' + entry
        disp_path = disp_dir + '/' + entry
        
        try:
            st = os.lstat(fs_path)
        except OSError:
            # entry disappeared or can't be stat'd; skip
            continue
        
        if stat.S_ISLNK(st.st_mode):
            continue
        elif stat.S_ISDIR(st.st_mode):
            stack.append((fs_path, disp_path, iter(get_sorted_entries(fs_path))))
        elif stat.S_ISREG(st.st_mode):
            try:
                with open(fs_path, 'rb') as f:
                    data = f.read()
            except (OSError, MemoryError):
                state['had_error'] = True
                sys.stderr.write(f"py_grep: {disp_path}: cannot read\n")
                continue
            matched = search_stream(data, pattern)
            if matched:
                prefix = (display_base_display + b':') if use_prefix else b''
                # Wait, I need the display path encoded as bytes
                prefix = (os.fsencode(disp_path) + b':') if use_prefix else b''
                for line in matched:
                    out.write(prefix + line + b'\n')
