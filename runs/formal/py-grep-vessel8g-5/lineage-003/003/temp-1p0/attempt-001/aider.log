                    state['had_error'] = True
                    continue
                matched = search_stream(data, pattern_bytes)
                prefix = (os.fsencode(fname) + b':') if use_prefix else b''
                for line in matched:
                    out.write(prefix + line + b'\n')
                    state['found_match'] = True
