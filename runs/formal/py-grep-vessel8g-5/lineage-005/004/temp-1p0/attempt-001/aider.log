#!/usr/bin/env python3
"""Bounded fixed-string byte grep (checkpoint 000)."""
import os
import stat
import sys


def search_stream(pattern: bytes, stream, outfile, prefix: bytes, ignore_case: bool = False) -> int:
    """Read newline-delimited lines from stream; write each line containing
    pattern to outfile (with prefix), normalized to end with a single newline.
    Returns the number of lines emitted."""
    count = 0
    if ignore_case:
        pattern_lc = pattern.lower()
    else:
        pattern_lc = None
    while True:
        line = stream.readline()
        if not line:
            break
        if pattern_lc is not None:
            if pattern_lc in line.lower():
                if not line.endswith(b'\n'):
                    line += b'\n'
                outfile.write(prefix + line)
                count += 1
        else:
            if pattern in line:
                if not line.endswith(b'\n'):
                    line += b'\n'
                outfile.write(prefix + line)
                count += 1
    return count


def _diagnose(path, exc):
    """Write a diagnostic for an I/O error on path to stderr."""
    if isinstance(exc, FileNotFoundError):
        msg = "No such file or directory"
    elif isinstance(exc, PermissionError):
        msg = "Permission denied"
    elif isinstance(exc, IsADirectoryError):
        msg = "Is a directory"
    else:
        msg = exc.strerror if exc.strerror else 'I/O error'
    sys.stderr.write(f"py_grep: {path}: {msg}\n")


def _recursive_traverse(dir_path, pattern, outfile, prefix_enabled, ignore_case=False):
    """Iterative pre-order DFS. Returns (matched, had_error)."""
    matched = 0
    had_error = False
    stack = [('dir', dir_path)]
    while stack:
        kind, path = stack.pop()
        if kind == 'file':
            prefix = os.fsencode(path) + b':' if prefix_enabled else b''
            try:
                with open(path, 'rb') as f:
                    matched += search_stream(pattern, f, outfile, prefix, ignore_case)
            except OSError as e:
                _diagnose(path, e)
                had_error = True
        elif kind == 'dir':
            try:
                entries = os.listdir(path)
            except OSError as e:
                _diagnose(path, e)
                had_error = True
                continue
            entries.sort(key=lambda name: os.fsencode(name))
            actions = []
            for name in entries:
                child = os.path.join(path, name)
                try:
                    st = os.lstat(child)
                except OSError:
                    continue
                if stat.S_ISLNK(st.st_mode):
                    continue
                elif stat.S_ISDIR(st.st_mode):
                    actions.append(('dir', child))
                elif stat.S_ISREG(st.st_mode):
                    actions.append(('file', child))
            for action in reversed(actions):
                stack.append(action)
    return matched, had_error


