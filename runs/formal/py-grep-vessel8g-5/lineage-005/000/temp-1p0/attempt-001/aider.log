Looking at the requirements, I need to create a bounded fixed-string byte grep from scratch. Let me analyze the key constraints:

1. Fixed byte substring matching (not regex), case-sensitive
2. Byte-oriented I/O, arbitrary bytes in data and paths
3. `search_stream` must be the semantic anchor for core line-selection
4. Exit codes: 0 (match, no error), 1 (no match, no error), 2 (any error)
5. No external processes, stdlib only
6. Prefix logic based on operand count (≥2 → prefix with `operand:`)
7. Errors on individual files don't stop remaining files from being searched
8. The engine invokes it with `argv[0] = "grep"` and `executable = build/py_grep.py`

Here's the complete implementation:

```python
#!/usr/bin/env python3
"""Bounded fixed-string byte grep (checkpoint 000)."""
import os
import sys


def search_stream(pattern: bytes, stream, outfile, prefix: bytes) -> int:
    """Read newline-delimited lines from stream; write each line containing
    pattern to outfile (with prefix), normalized to end with a single newline.
    Returns the number of lines emitted."""
    count = 0
    while True:
        line = stream.readline()
        if not line:
            break
        if pattern in line:
            if not line.endswith(b'\n'):
                line += b'\n'
            outfile.write(prefix + line)
            count += 1
    return count


def main() -> int:
    args = sys.argv[1:]
    pattern_str = None
    files: list = []
    after_ddash = False

    for arg in args:
        if not after_ddash:
            if arg == '--':
                after_ddash = True
                continue
            if arg.startswith('-') and len(arg) > 1 and pattern_str is None:
                sys.stderr.write(f"py_grep: unsupported option: {arg}\n")
                sys.stderr.write("usage: py_grep PATTERN [FILE...]\n")
                return 2
        if pattern_str is None:
            pattern_str = arg
        else:
            files.append(arg)

    if pattern_str is None:
        sys.stderr.write("py_grep: missing PATTERN\n")
        sys.stderr.write("usage: py_grep PATTERN [FILE...]\n")
        return 2

    pattern = os.fsencode(pattern_str)
    total_matched = 0
    had_error = False
    outfile = sys.stdout.buffer
    needs_prefix = len(files) >= 2

    try:
        if not files:
            total_matched = search_stream(pattern, sys.stdin.buffer, outfile, b'')
        else:
            for path in files:
                prefix = os.fsencode(path) + b':' if needs_prefix else b''
                try:
                    with open(path, 'rb') as f:
                        total_matched += search_stream(pattern, f, outfile, prefix)
                except IsADirectoryError:
                    sys.stderr.write(f"py_grep: {path}: Is a directory\n")
                    had_error = True
                except FileNotFoundError:
                    sys.stderr.write(f"py_grep: {path}: No such file or directory\n")
                    had_error = True
                except PermissionError:
                    sys.stderr.write(f"py_grep: {path}: Permission denied\n")
                    had_error = True
                except OSError as e:
                    reason = e.strerror if e.strerror else 'I/O error'
                    sys.stderr.write(f"py_grep: {path}: {reason}\n")
                    had_error = True
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        had_error = True
    except MemoryError:
        sys.stderr.write("py_grep: out of memory\n")
        had_error = True
    except OSError as e:
        reason = e.strerror if e.strerror else 'I/O error'
        sys.stderr.write(f"py_grep: {reason}\n")
        had_error = True

    if had_error:
        return 2
    return 0 if total_matched > 0 else 1


if __name__ == '__main__':
    sys.exit(main())
```

**Files changed:** `src/py_grep/py_grep.py` (created from scratch)

**Behavior implemented:**
- Fixed byte-substring matching via `pattern in line` (empty pattern matches all lines naturally since `b'' in any_bytes` is `True`)
- Byte-oriented I/O throughout (`sys.stdin.buffer`, `sys.stdout.buffer`, `open(..., 'rb')`, `os.fsencode`)
- `search_stream` as the semantic anchor: main calls it for all line-selection work
- Newline-delimited lines; final unterminated line handled; output normalized to always end with `\n`
- Prefix decision based on operand count (≥2) made before any file is opened
- `-` treated as an ordinary pathname (never stdin)
- `--` ends option parsing; any other unrecognized option before PATTERN → usage error, exit 2
- No PATTERN → usage error, exit 2
- Individual file errors (missing, directory, unreadable) diagnosed to stderr by name, remaining operands still searched
- Exit 0/1/2 per spec; successful run produces empty stderr
- BrokenPipeError, MemoryError, and OSError handled without uncaught tracebacks
- No external processes, subprocesses, or third-party libraries

**Interpretation chosen:** `-` before PATTERN position is treated as the PATTERN itself (it is the first non-option operand per the spec's "The first non-option operand is PATTERN"). After PATTERN is established, `-` is an ordinary file operand. This is consistent with the spec stating `-` is "an ordinary pathname, not standard input."
