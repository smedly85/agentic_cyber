def recursive_traverse(dir_path, pattern, outfile, prefix_enabled):
    """Iterative pre-order DFS. Returns (matched_count, had_error)."""
    matched = 0
    had_error = False
    import stat as stat_mod
    
    # Stack of items to process. Each item is either:
    #   ('dir', path) - needs listing
    #   ('file', path) - needs searching
    # Process in pre-order: for a dir, its children (in sorted order) are
    # processed before siblings that come after it.
    
    # We use a stack, processing items by popping. To get pre-order with
    # sorted entries, we push entries in REVERSE order.
    
    stack = [('dir', dir_path)]
    while stack:
        kind, path = stack.pop()
        if kind == 'file':
            prefix = os.fsencode(path) + b':' if prefix_enabled else b''
            try:
                with open(path, 'rb') as f:
                    matched += search_stream(pattern, f, outfile, prefix)
            except IsADirectoryError:
                # shouldn't happen since we checked
                pass
            except FileNotFoundError:
                sys.stderr.write(f"py_grep: {path}: No such file or directory\n")
                had_error = True
            except PermissionError:
                sys.stderr.write(f"py_grep: {path}: Permission denied\n")
                had_error = True
            except OSError as e:
                reason = e.strerror if e.strerror else 'I/O error'
                sys.stderr.write(f"py_grep: {path}: {reason}\n")
                had_error = True
        elif kind == 'dir':
            try:
                entries = os.listdir(path)
            except PermissionError:
                sys.stderr.write(f"py_grep: {path}: Permission denied\n")
                had_error = True
                continue
            except OSError as e:
                reason = e.strerror if e.strerror else 'I/O error'
                sys.stderr.write(f"py_grep: {path}: {reason}\n")
                had_error = True
                continue
            
            entries.sort(key=lambda name: os.fsencode(name))
            
            # Build list of actions for this directory's children
            actions = []
            for name in entries:
                child = os.path.join(path, name)
                try:
                    st = os.lstat(child)
                except OSError:
                    continue
                if stat_mod.S_ISLNK(st.st_mode):
                    continue  # skip symlinks
                elif stat_mod.S_ISDIR(st.st_mode):
                    actions.append(('dir', child))
                elif stat_mod.S_ISREG(st.st_mode):
                    actions.append(('file', child))
                # else: skip special files
            
            # Push in reverse order for LIFO → correct pre-order
            for action in reversed(actions):
                stack.append(action)
    
    return matched, had_error
```

