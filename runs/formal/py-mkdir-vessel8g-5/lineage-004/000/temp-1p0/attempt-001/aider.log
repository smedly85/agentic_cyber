```python
#!/usr/bin/env python3
"""mkdir - create directories"""

import os
import sys


def main():
    args = sys.argv[1:]
    
    # Parse: identify options and operands
    # Supported: only '--' as terminator
    # '-' is an operand
    # Anything else starting with '-' is an unknown option
    
    operands = []
    seen_ddash = False
    
    for arg in args:
        if not seen_ddash:
            if arg == '--':
                seen_ddash = True
            elif arg == '-':
                operands.append(arg)
            elif arg.startswith('-'):
                # Unknown option
                if arg.startswith('--') and len(arg) > 2:
                    # Long option
                    print(f"mkdir: unrecognized option '{arg}'", file=sys.stderr)
                    print("Try 'mkdir --help' for more information.", file=sys.stderr)
                else:
                    # Short option: -X or -XYZ
                    opt_char = arg[1] if len(arg) > 1 else ''
                    print(f"mkdir: invalid option -- '{opt_char}'", file=sys.stderr)
                    print("Try 'mkdir --help' for more information.", file=sys.stderr)
                sys.exit(1)
            else:
                operands.append(arg)
        else:
            operands.append(arg)
    
    if not operands:
        print("mkdir: missing operand", file=sys.stderr)
        print("Try 'mkdir --help' for more information.", file=sys.stderr)
        sys.exit(1)
    
    # Process operands in order
    exit_code = 0
    for operand in operands:
        try:
            os.mkdir(operand)
        except FileExistsError:
            print(f"mkdir: cannot create directory '{operand}': File exists", file=sys.stderr)
            exit_code = 1
        except FileNotFoundError:
            print(f"mkdir: cannot create directory '{operand}': No such file or directory", file=sys.stderr)
            exit_code = 1
        except NotADirectoryError:
            print(f"mkdir: cannot create directory '{operand}': Not a directory", file=sys.stderr)
            exit_code = 1
        except PermissionError:
            print(f"mkdir: cannot create directory '{operand}': Permission denied", file=sys.stderr)
            exit_code = 1
        except OSError as e:
            print(f"mkdir: cannot create directory '{operand}': {e.strerror or e}", file=sys.stderr)
            exit_code = 1
    
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
```

