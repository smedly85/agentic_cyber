```python
#!/usr/bin/env python3
"""Create directories."""

import errno
import os
import stat
import sys


def _fail(path, msg):
    print(f"mkdir: cannot create directory '{path}': {msg}", file=sys.stderr)


def _fail_notadir(path):
    _fail(path, "Not a directory")


def _fail_errno(path, e):
    msg = e.strerror if e.strerror else os.strerror(e.errno)
    _fail(path, msg)


def mkdir_plain(path):
    """Create a single directory (no parent creation). Returns 0 or 1."""
    try:
        os.mkdir(path, 0o777)
    except OSError as e:
        _fail_errno(path, e)
        return 1
    return 0


def mkdir_parents(path):
    """Create path and all missing parent directories. Returns 0 or 1."""
    is_abs = os.path.isabs(path)
    parts = [p for p in path.split('/') if p and p != '.']
    
    if not parts:
        # Path is just '/' or './' or similar - already exists
        return 0
    
    current = ''
    last = len(parts) - 1
    for i, part in enumerate(parts):
        if current == '':
            current = ('/' if is_abs else '') + part
        else:
            current = current + '/' + part
        
        try:
            st = os.lstat(current)
        except (FileNotFoundError, OSError):
            # Component doesn't exist - create it
            try:
                os.mkdir(current, 0o777)
            except OSError as e:
                _fail_errno(path, e)
                return 1
            if i != last:
                # Intermediate: ensure owner has at least wx
                try:
                    mode = os.stat(current).st_mode & 0o7777
                    if not (mode & 0o300):
                        os.chmod(current, mode | 0o300)
                except OSError:
                    pass
            continue
        
        # Component exists - must be a directory or symlink to directory
        if stat.S_ISDIR(st.st_mode):
