```python
def mkdir_parents(path):
    """Create path and all missing parents. Returns 0 on success, 1 on error."""
    # Normalize to handle repeated slashes, trailing slashes, dot components
    # but preserve the logical path
    parts = path.split('/')
    
    # Build up the path
    current = ''
    for i, part in enumerate(parts):
        if part == '' or part == '.':
            continue
        if current == '':
            current = part if not os.path.isabs(path) else '/' + part
        else:
            current = current + '/' + part
        
        # Check if current exists
        try:
            st = os.lstat(current)
        except OSError:
            # Doesn't exist, create it
            try:
                os.mkdir(current, 0o777)
            except OSError as e:
                print(f"mkdir: cannot create directory '{path}': {e.strerror}", file=sys.stderr)
                return 1
            # Ensure owner wx for intermediate (and final) dirs
            if i < len(parts) - 1:  # intermediate
                try:
                    os.chmod(current, os.stat(current).st_mode & 0o7777 | 0o300)
                except OSError:
                    pass
            continue
        
        # It exists - check if it's a directory
        if stat.S_ISDIR(st.st_mode):
            continue
        elif stat.S_ISLNK(st.st_mode):
            # Check if it resolves to a directory
            try:
                st2 = os.stat(current)  # follows symlink
                if stat.S_ISDIR(st2.st_mode):
                    continue
            except OSError:
                pass
            # Symlink to non-directory or broken symlink
            print(f"mkdir: cannot create directory '{path}': Not a directory", file=sys.stderr)
            return 1
        else:
            # Regular file or other non-directory
            print(f"mkdir: cannot create directory '{path}': Not a directory", file=sys.stderr)
            return 1
    
    return 0
```

