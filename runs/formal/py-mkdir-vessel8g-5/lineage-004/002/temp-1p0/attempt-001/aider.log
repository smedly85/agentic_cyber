    """Parse a numeric mode string. Returns (value, num_digits) or raises ValueError."""
    if not s:
        raise ValueError("empty")
    for ch in s:
        if ch not in '01234567':
            raise ValueError(f"invalid digit '{ch}'")
    value = int(s, 8)
    if value > 0o7777:
        raise ValueError("out of range")
    return value, len(s)


