                    break
                i += 1
                mode_str = args[i]
            elif arg.startswith('-m') and len(arg) > 2:
                mode_str = arg[2:]
            elif arg == '--mode':
                if i + 1 >= len(args):
                    parse_error = "mkdir: invalid mode ''"
                    break
                i += 1
                mode_str = args[i]
            elif arg.startswith('--mode='):
                mode_str = arg[7:]
            elif arg == '-':
                operands.append(arg)
            elif arg.startswith('-'):
                if arg.startswith('--') and len(arg) > 2:
