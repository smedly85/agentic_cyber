def resolve_mode(mode_str):
    """Resolve a mode string to either a numeric or symbolic mode spec.
    Returns a tuple that can be applied to a created directory."""
    if not mode_str:
        raise ValueError("empty mode")
    
    # Try numeric first
    try:
        value, num_digits = parse_numeric_mode(mode_str)
        return ('numeric', value, num_digits)
    except ValueError:
        pass
    
    # Must be symbolic
    # (we'll evaluate it at apply time since we need umask)
    return ('symbolic', mode_str)


def apply_mode(path, mode_spec, umask):
    """Apply the mode spec to a created directory at path."""
    kind = mode_spec[0]
    current_mode = os.stat(path).st_mode & 0o7777
    
    if kind == 'numeric':
        _, value, num_digits = mode_spec
        if num_digits <= 4:
            final = (value & 0o777) | (current_mode & 0o7000) | (value & 0o7000)
        else:
            final = value & 0o7777
        os.chmod(path, final)
    else:
        _, mode_str = mode_spec
        mode, special_addressed = parse_symbolic_mode(mode_str, umask)
        # Special bits not addressed: preserve from current
        if special_addressed:
            # Use evaluated special bits for addressed ones, preserve others
            final_special = (mode & 0o7000) | (current_mode & 0o7000 & ~special_addressed)
        else:
            final_special = current_mode & 0o7000
        final = (mode & 0o777) | final_special
        os.chmod(path, final)
