            # Empty permissions (e.g. "o=", "a=", "=")
            if op != '=':
                raise ValueError("empty permissions with non-= op")
            perm_chars = ''
            is_copy = False
            copy_src = ''
        else:
            rest = clause[i:]
            # Check for permission-copy (single u/g/o with =)
