    _eval_symbolic(mode_str, 0)
    return ('symbolic', mode_str)


def _apply_mode_to_path(path, mode_spec, umask):
    """Apply a mode spec to an already-created directory."""
    current = os.lstat(path).st_mode & 0o7777
    kind = mode_spec[0]

    if kind == 'numeric':
