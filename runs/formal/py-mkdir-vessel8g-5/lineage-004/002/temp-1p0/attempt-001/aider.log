# Mode resolution and application
# ---------------------------------------------------------------------------

def _resolve_mode(mode_str):
    """Validate and classify a mode string. Returns a spec tuple.
    Raises ValueError if invalid."""
    if not mode_str:
        raise ValueError("empty mode")
