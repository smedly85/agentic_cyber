    Returns (mode_0_7777, special_bits_addressed_mask)."""
    # GNU special-bit-only behavior: expressions containing only s/t
    # (no r, w, x, X) use 0755 as the ordinary-permission starting point,
    # so +t / a+t yield 0755+sticky regardless of umask.
    has_ordinary = any(c in mode_str for c in 'rwxX')
    has_special = any(c in mode_str for c in 'st')
    if not has_ordinary and has_special:
