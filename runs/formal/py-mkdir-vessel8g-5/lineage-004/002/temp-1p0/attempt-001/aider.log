                        # Actually, s with who=u → setuid, who=g → setgid, who=a/omitted → both
                        pass  # handle below
                    perm_bits |= 0o6000  # tentative, will adjust
                elif ch == 't':
                    perm_bits |= 0o1000
                else:
                    raise ValueError(f"invalid permission char '{ch}'")
        
        # Determine who mask
        if not who:
            who_mask = 0o777
            who_explicit = False
        else:
            who_mask = 0
            if 'u' in who: who_mask |= 0o700
            if 'g' in who: who_mask |= 0o070
            if 'o' in who: who_mask |= 0o007
            if 'a' in who: who_mask = 0o777
            who_explicit = True
        
        if is_copy:
            # Copy source class's rwx to target
            src = copy_source
            if src == 'u': src_bits = (mode >> 6) & 0o7
            elif src == 'g': src_bits = (mode >> 3) & 0o7
            else: src_bits = mode & 0o7
            # Apply to target
            if who_mask & 0o700: mode = (mode & ~0o700) | (src_bits << 6)
            if who_mask & 0o070: mode = (mode & ~0o070) | (src_bits << 3)
            if who_mask & 0o007: mode = (mode & ~0o007) | src_bits
            continue
        
        # Handle 's' specially based on who
        if 's' in perms_str:
            # Remove the tentative 0o6000 and set correctly
            perm_bits &= ~0o6000
            if 'u' in who or (not who):
                perm_bits |= 0o4000
            if 'g' in who or (not who):
                perm_bits |= 0o2000
            if 'a' in who:
                perm_bits |= 0o6000
        
        # Separate ordinary and special
        ordinary = perm_bits & 0o777
        special = perm_bits & 0o7000
        
        if op == '+':
            if who_explicit:
                mode |= ordinary & who_mask
            else:
                mode |= ordinary & ~umask & 0o777
            mode |= special
            special_bits_addressed |= special
        
        elif op == '-':
            if who_explicit:
                mode &= ~(ordinary & who_mask)
            else:
                mode &= ~(ordinary & ~umask & 0o777)
            mode &= ~special
            special_bits_addressed |= special
        
        elif op == '=':
            if who_explicit:
                mode = (mode & ~who_mask) | (ordinary & who_mask)
            else:
                mode = (mode & ~0o777) | (ordinary & ~umask & 0o777)
            # Special bits: set the ones in this clause
            mode |= special
            special_bits_addressed |= special
            # Sticky clearing: if who covers o and op is =, clear sticky unless t was specified
            covers_o = ('o' in who) or ('a' in who) or (not who)
            if covers_o and 't' not in perms_str:
                mode &= ~0o1000
    
    return mode, special_bits_addressed
```

