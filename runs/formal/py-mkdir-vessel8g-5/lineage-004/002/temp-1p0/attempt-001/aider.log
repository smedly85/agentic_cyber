        who_str = clause[:i]
        who_mask, who_explicit = _parse_who(who_str)

        if i >= len(clause):
            raise ValueError("no operator")
        op = clause[i]
        if op not in '+-=':
            raise ValueError(f"bad operator {op}")
        i += 1

