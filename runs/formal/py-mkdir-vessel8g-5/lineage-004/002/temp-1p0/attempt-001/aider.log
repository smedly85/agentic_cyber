        source_bits = (mode >> shift(source_class)) & 0o7
        # Set target's rwx to source's rwx
        mode = (mode & ~target_mask) | (source_bits replicated to target)
        continue
    
    # Compute the permission bits from the permission string
    perm_bits = 0
