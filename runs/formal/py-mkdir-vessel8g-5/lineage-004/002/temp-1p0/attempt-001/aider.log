```python
def evaluate_symbolic_mode(mode_str, umask):
    """Evaluate a symbolic mode string. Returns the final mode (0o7777 range)."""
    clauses = mode_str.split(',')
    mode = 0o777  # starting point: a=rwx
    special_bits_addressed = 0  # bitmask of special bits that were explicitly set/cleared
    
    for clause in clauses:
        clause = clause.strip()
        if not clause:
            raise ValueError("empty clause")
        
        # Parse who
        who = ''
        i = 0
        while i < len(clause) and clause[i] in 'ugoa':
            who += clause[i]
            i += 1
        
        if i >= len(clause):
            raise ValueError("no operator in clause")
        
        op = clause[i]
        if op not in '+-=':
            raise ValueError(f"invalid operator '{op}'")
        i += 1
        
        if i >= len(clause):
            raise ValueError("no permissions in clause")
        
        perms_str = clause[i:]
        if not perms_str:
            # Empty assignment: valid only for '='
            if op != '=':
                raise ValueError("empty permissions with non-= operator")
            perm_bits = 0
            is_copy = False
        elif len(perms_str) == 1 and perms_str in 'ugo':
            # Permission copy
            if op != '=':
                raise ValueError("permission copy only valid with =")
            is_copy = True
            copy_source = perms_str
            perm_bits = 0
        else:
            is_copy = False
            perm_bits = 0
            for ch in perms_str:
                if ch == 'r': perm_bits |= 0o444
                elif ch == 'w': perm_bits |= 0o222
                elif ch == 'x' or ch == 'X': perm_bits |= 0o111
                elif ch == 's':
                    # s depends on who
