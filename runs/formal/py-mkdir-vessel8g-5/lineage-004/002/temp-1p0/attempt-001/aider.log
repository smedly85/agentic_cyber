        if ch == 'r': perm_bits |= 0o444
        elif ch == 'w': perm_bits |= 0o222
        elif ch == 'x' or ch == 'X': perm_bits |= 0o111
        elif ch == 's':
            # s depends on who
            if who includes u: perm_bits |= 0o4000
            if who includes g: perm_bits |= 0o2000
            if who is 'a' or omitted: perm_bits |= 0o6000
        elif ch == 't':
            perm_bits |= 0o1000
    
