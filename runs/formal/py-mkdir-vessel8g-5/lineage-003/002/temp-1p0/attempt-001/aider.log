_S_IWOTH = 0o002
_S_IXOTH = 0o001
_S_ISUID = 0o4000
_S_ISGID = 0o2000
_S_ISVTX = 0o1000

_WHO_U = 0o700
_WHO_G = 0o070
_WHO_O = 0o007
_WHO_A = 0o777

_ALL_SPECIAL = 0o7000


def _parse_numeric(s: str) -> int:
    if not s:
