#!/usr/bin/env python3
"""Create directories (mkdir with -p and -m)."""

import os
import stat
import sys


def _stderr(data: bytes) -> None:
    os.write(2, data)


# --- Mode constants ---

_S_IRUSR = 0o400
_S_IWUSR = 0o200
_S_IXUSR = 0o100
_S_IRGRP = 0o040
_S_IWGRP = 0o020
_S_IXGRP = 0o010
_S_IROTH = 0o004
_S_IWOTH = 0o002
_S_IXOTH = 0o001
_S_ISUID = 0o4000
_S_ISGID = 0o2000
_S_ISVTX = 0o1000

_WHO_U = 0o700
_WHO_G = 0o070
_WHO_O = 0o007
_WHO_A = 0o777

_ALL_RWX = 0o777
_ALL_SPECIAL = 0o7000


def _parse_numeric(s: str) -> int:
    if not s:
        raise ValueError("empty mode")
    if any(c not in '01234567' for c in s):
        raise ValueError(f"invalid mode '{s}'")
    val = int(s, 8)
    if val > 0o7777:
