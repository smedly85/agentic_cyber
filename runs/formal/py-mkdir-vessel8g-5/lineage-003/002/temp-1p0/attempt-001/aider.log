            copy_from = _WHO_G
            perm_bits |= _U_X | _G_X | _O_X
        elif c == 'o':
            copy_from = _WHO_O
            perm_bits |= _U_X | _G_X | _O_X
        else:
            raise ValueError(f"invalid permission in mode clause: {c!r}")
        i += 1
    
    # Resolve copy
    if copy_from:
        # Copy the source class's rwx to the destination (who_mask)
        source_rwx = mode & copy_from
        # Apply to selected who classes
        # For each class in who_mask, set its rwx to source_rwx's corresponding bits
        # Actually, "permission-copy u/g/o" means: copy the source class's 
        # ordinary read/write/execute bits to the selected classes
