```python
def parse_args(argv):
    parents = False
    mode_str = None  # the mode string (last one wins)
    operands = []
    saw_terminator = False
    first_error = None
    
    i = 0
    while i < len(argv):
        arg = argv[i]
        if saw_terminator:
            operands.append(arg)
        elif arg == '--':
            saw_terminator = True
        elif arg == '-':
            operands.append(arg)
        elif arg == '-p' or arg == '--parents':
            parents = True
        elif arg == '-m' or arg.startswith('-m') and len(arg) > 2 and not arg.startswith('--'):
            if len(arg) > 2:
                mode_str = arg[2:]  # -mMODE
            else:
                # -m MODE (next arg is mode)
                i += 1
                if i >= len(argv):
                    first_error = b"mkdir: option requires an argument -- 'm'\n"
                    break
                mode_str = argv[i]
        elif arg == '--mode' or arg.startswith('--mode='):
            if arg == '--mode':
                i += 1
                if i >= len(argv):
                    first_error = b"mkdir: option '--mode' requires an argument\n"
                    break
                mode_str = argv[i]
            else:
                mode_str = arg[7:]  # after '--mode='
        elif arg.startswith('--'):
            first_error = (
                b"mkdir: unrecognized option '" + os.fsencode(arg) + b"'\n"
                b"Try 'mkdir --help' for more information.\n"
            )
            break
        elif arg.startswith('-'):
            first_error = (
                b"mkdir: invalid option -- '" + os.fsencode(arg[1]) + b"'\n"
                b"Try 'mkdir --help' for more information.\n"
            )
            break
        else:
            operands.append(arg)
        i += 1
    
    return parents, mode_str, operands, first_error
```

