#!/usr/bin/env python3
"""Create directories (mkdir with -p and -m)."""

import os
import stat
import sys


def _stderr(data: bytes) -> None:
    os.write(2, data)


# --- Mode parsing ---

# Permission bit constants
_U_R, _U_W, _U_X = 0o400, 0o200, 0o100
_G_R, _G_W, _G_X = 0o040, 0o020, 0o010
_O_R, _O_W, _O_X = 0o004, 0o002, 0o001
_SETUID, _SETGID, _STICKY = 0o4000, 0o2000, 0o1000

# Who selectors
_WHO_U = 0o700
_WHO_G = 0o070
_WHO_O = 0o007
_WHO_A = 0o777


def _parse_numeric_mode(s: str) -> int:
    """Parse a numeric (octal) mode string. Returns mode int."""
    if not s:
        raise ValueError("empty mode")
    # All characters must be octal digits
    if any(c not in '01234567' for c in s):
        raise ValueError(f"invalid mode: {s}")
    val = int(s, 8)
    if val > 0o7777:
        raise ValueError(f"mode out of range: {s}")
    return val


def _parse_symbolic_mode(mode_str: str, umask: int) -> int:
    """Parse and evaluate a symbolic mode string. Returns final mode int."""
    mode = 0o777  # a=rwx starting point
    
    for clause in mode_str.split(','):
        if not clause:
            raise ValueError(f"empty clause in mode: {mode_str}")
        mode = _apply_clause(mode, clause, umask)
    
    return mode


def _apply_clause(mode: int, clause: str, umask: int) -> int:
    """Apply one symbolic mode clause to the current mode."""
    i = 0
    
    # Parse who
    who_omitted = True
    who_mask = 0  # bitmask of which classes are selected
    if i < len(clause) and clause[i] in 'ugoa':
        who_omitted = False
        c = clause[i]
        if c == 'u':
            who_mask = _WHO_U
        elif c == 'g':
            who_mask = _WHO_G
        elif c == 'o':
            who_mask = _WHO_O
        else:  # 'a'
            who_mask = _WHO_A
        i += 1
    
    # Parse operator
    if i >= len(clause):
        raise ValueError(f"missing operator in mode clause: {clause}")
    op = clause[i]
    if op not in '+-=':
        raise ValueError(f"invalid operator in mode clause: {clause}")
    i += 1
    
    # Parse permissions
    perm_bits = 0      # rwx bits to add/remove/set
    special_bits = 0   # setuid/setgid/sticky bits
    copy_from = 0      # which class to copy from (0 = no copy)
    has_cond_x = False # whether X was specified
    
    while i < len(clause):
        c = clause[i]
        if c == 'r':
            perm_bits |= _U_R | _G_R | _O_R
        elif c == 'w':
            perm_bits |= _U_W | _G_W | _O_W
        elif c == 'x':
            perm_bits |= _U_X | _G_X | _O_X
        elif c == 'X':
            perm_bits |= _U_X | _G_X | _O_X
            has_cond_x = True
        elif c == 's':
            special_bits |= _SETUID | _SETGID
        elif c == 't':
            special_bits |= _STICKY
        elif c == 'u':
            copy_from = _WHO_U
            perm_bits |= _U_X | _G_X | _O_X  # copy includes rwx
            # Actually, copy means: copy the source's rwx to the dest
