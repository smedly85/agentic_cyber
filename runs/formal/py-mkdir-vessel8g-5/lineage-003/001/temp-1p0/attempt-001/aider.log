```python
#!/usr/bin/env python3
"""Create directories (mkdir base functionality + -p/--parents)."""

import os
import stat
import sys


def _stderr(data: bytes) -> None:
    os.write(2, data)


def _is_dir_or_link_to_dir(path: bytes) -> bool:
    """Check if path is a directory or a symlink resolving to a directory."""
    if os.path.islink(path):
        return os.path.isdir(path)  # follows the symlink
    return os.path.isdir(path)


def _create_parents(path: bytes) -> bool:
    """Create all parent components of `path` (not the final component).
    Returns True on success."""
    # Determine if absolute
    components = path.split(b'/')
    if path.startswith(b'/'):
        prefix = b'/'
        # First component after / is the actual first dir
        for comp in components[1:]:
            if comp == b'' or comp == b'.':
                continue
            prefix = prefix + comp if prefix == b'/' else prefix + b'/' + comp
            _ensure_component(prefix, final=False)
    else:
        prefix = b''
        for comp in components:
            if comp == b'' or comp == b'.':
                continue
            prefix = comp if prefix == b'' else prefix + b'/' + comp
            _ensure_component(prefix, final=False)
    return True


def _ensure_component(prefix: bytes, final: bool) -> None:
    """Ensure `prefix` exists as a directory. Raises OSError on failure."""
    if os.path.lexists(prefix):
        if not _is_dir_or_link_to_dir(prefix):
            raise NotADirectoryError(prefix)
        return
    os.mkdir(prefix, 0o777)
    if not final:
        st = os.lstat(prefix)
        mode = stat.S_IMODE(st.st_mode) | 0o700
        os.chmod(prefix, mode)


def main() -> None:
    argv = sys.argv[1:]
    
    parents = False
    operands: list[str] = []
    saw_terminator = False
    first_error: bytes | None = None

    for arg in argv:
        if saw_terminator:
            operands.append(arg)
        elif arg == '--':
            saw_terminator = True
        elif arg == '-':
            operands.append(arg)
        elif arg == '-p' or arg == '--parents':
            parents = True
        elif arg.startswith('--'):
            first_error = (
                b"mkdir: unrecognized option '"
                + os.fsencode(arg)
                + b"'\nTry 'mkdir --help' for more information.\n"
            )
            break
        elif arg.startswith('-'):
            first_error = (
                b"mkdir: invalid option -- '"
                + os.fsencode(arg[1])
                + b"'\nTry 'mkdir --help' for more information.\n"
            )
            break
        else:
            operands.append(arg)

    if first_error is not None:
        _stderr(first_error)
        sys.exit(1)

    if not operands:
        _stderr(b"mkdir: missing operand\nTry 'mkdir --help' for more information.\n")
        sys.exit(1)

    any_failed = False
    for operand in operands:
        path = os.fsencode(operand)
        try:
            if parents:
                # Ensure all parent components exist
                _create_parents(path)
                # Create the final component
                _ensure_component(path, final=True)
            else:
                os.mkdir(path, 0o777)
        except OSError as e:
            if e.errno is not None:
                err_str = os.strerror(e.errno).encode('utf-8')
            else:
                err_str = b"Unknown error"
            msg = (
                b"mkdir: cannot create directory '"
                + os.fsencode(operand)
                + b"': "
                + err_str
                + b"\n"
            )
            _stderr(msg)
            any_failed = True

    sys.exit(1 if any_failed else 0)


if __name__ == '__main__':
    main()
```

