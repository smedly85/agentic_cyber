def _create_parents(path: bytes) -> None:
    """Create all parent components of `path`. Raises OSError on failure."""
    normalized = os.path.normpath(path)
    
    # Split into non-empty, non-dot components
    is_abs = normalized.startswith(b'/')
    parts = normalized.split(b'/')
    # Remove empty strings and '.'
    parts = [p for p in parts if p not in (b'', b'.')]
    
    if not parts:
        return  # root or '.' - nothing to do
    
    # Build up prefixes for all but the last
    prefix = b'/' if is_abs else b''
    for comp in parts[:-1]:
        if prefix == b'':
            prefix = comp
        elif prefix == b'/':
            prefix = b'/' + comp
        else:
            prefix = prefix + b'/' + comp
        _ensure_intermediate(prefix)


def main_p(operand: str) -> None:
    """Implement mkdir -p for one operand. Raises OSError on failure."""
    path = os.fsencode(operand)
    _create_parents(path)
    _ensure_final(path)
```

