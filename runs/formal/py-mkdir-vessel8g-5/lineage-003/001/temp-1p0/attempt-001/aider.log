def _ensure_parents(path_bytes: bytes) -> bool:
    """Ensure all parent components of path_bytes exist as directories.
    Returns True on success, False on failure."""
    # Split into components
    # Build up path, checking/creating each component
    
    components = path_bytes.split(b'/')
    # Filter out empty strings (from //) but keep track for absolute paths
    
    prefix = b''
    if path_bytes.startswith(b'/'):
        prefix = b'/'
    
    for comp in components:
        if comp == b'' or comp == b'.':
            continue
        if prefix == b'':
            prefix = comp
        else:
            prefix = prefix + b'/' + comp
        
        # Check if prefix exists
        if os.path.lexists(prefix):
            # Check if it's a directory or symlink to directory
            if os.path.isdir(prefix):
                continue
