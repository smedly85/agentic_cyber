#!/usr/bin/env python3
"""py_mkdir: create directories"""
import os
import sys

def main():
    args = sys.argv[1:]
    
    # Parse arguments
    operands = []
    after_ddash = False
    
    for arg in args:
        if not after_ddash:
            if arg == '--':
                after_ddash = True
                continue
            if arg == '-':
                operands.append(arg)
                continue
            if arg.startswith('-') and len(arg) > 1:
                # Unknown option
                # Need to format the error
                if arg.startswith('--'):
                    sys.stderr.write(f"mkdir: unrecognized option '{arg}'\n")
                else:
                    sys.stderr.write(f"mkdir: invalid option -- '{arg[1]}'\n")
                sys.stderr.write("Try 'mkdir --help' for more information.\n")
                sys.exit(1)
            else:
                operands.append(arg)
        else:
            operands.append(arg)
    
    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.exit(1)
    
    # Create directories
    any_failed = False
    for operand in operands:
        try:
            # Paths are byte strings
            if isinstance(operand, str):
                path = os.fsencode(operand)
            else:
                path = operand
            os.mkdir(path, 0o777)
        except OSError as e:
            any_failed = True
            # Format the operand for display
            display = os.fsdecode(operand) if isinstance(operand, bytes) else operand
            sys.stderr.write(f"mkdir: cannot create directory '{display}': {e.strerror}\n")
        except Exception as e:
            any_failed = True
            display = os.fsdecode(operand) if isinstance(operand, bytes) else operand
            sys.stderr.write(f"mkdir: cannot create directory '{display}': {e}\n")
    
    sys.exit(1 if any_failed else 0)

if __name__ == '__main__':
    main()
```

