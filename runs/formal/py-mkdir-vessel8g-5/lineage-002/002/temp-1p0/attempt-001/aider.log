#!/usr/bin/env python3
"""Create directories (checkpoint 002: parents, mode)."""
import os
import sys


def main():
    args = sys.argv[1:]
    
    # Parse arguments
    operands = []
    parents = False
    mode_str = None
    after_ddash = False
    i = 0
    
    while i < len(args):
        arg = args[i]
        if after_ddash:
            operands.append(arg)
        elif arg == '--':
            after_ddash = True
        elif arg == '-p' or arg == '--parents':
            parents = True
        elif arg == '-m':
            # Next arg is the mode
            i += 1
            if i >= len(args):
                _error_invalid_mode('')
            mode_str = args[i]
        elif arg.startswith('-m') and len(arg) > 2:
            mode_str = arg[2:]
        elif arg == '--mode':
            # Next arg is the mode
            i += 1
            if i >= len(args):
                _error_invalid_mode('')
            mode_str = args[i]
        elif arg.startswith('--mode='):
            mode_str = arg[7:]
        elif arg == '-':
            operands.append(arg)
        elif arg.startswith('-') and arg != '-':
            # Unknown option
            if arg.startswith('--'):
                sys.stderr.write(f"mkdir: unrecognized option '{arg}'\n")
            else:
                sys.stderr.write(f"mkdir: invalid option -- '{arg[1]}'\n")
            sys.stderr.write("Try 'mkdir --help' for more information.\n")
            sys.stderr.flush()
            sys.exit(1)
        else:
            operands.append(arg)
        i += 1
    
    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.stderr.flush()
        sys.exit(1)
    
    # Validate and compute mode
    desired_mode = None
    if mode_str is not None:
        desired_mode = _parse_mode(mode_str)
    
    # Get umask
    umask = os.umask(0)
    os.umask(umask)
    
    # If no -m, the mode for new final dirs is 0777 & ~umask
    # (os.mkdir with mode=0o777 will apply umask automatically)
    
    any_failed = False
    for operand in operands:
        try:
            if parents:
                _mkdir_p(operand, desired_mode, umask)
            else:
                if desired_mode is not None:
                    os.mkdir(operand, 0o777)
                    os.chmod(operand, desired_mode)
                else:
                    os.mkdir(operand, 0o777)
        except FileExistsError:
            any_failed = True
            strerror = os.strerror(17) or "File exists"
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': {strerror}\n")
            sys.stderr.flush()
        except NotADirectoryError:
            any_failed = True
            strerror = os.strerror(20) or "Not a directory"
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': {strerror}\n")
            sys.stderr.flush()
        except PermissionError:
            any_failed = True
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': Permission denied\n")
            sys.stderr.flush()
        except OSError as e:
            any_failed = True
            strerror = e.strerror or os.strerror(e.errno) or "Unknown error"
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': {strerror}\n")
            sys.stderr.flush()
    
    sys.exit(0 if not any_failed else 1)
```

