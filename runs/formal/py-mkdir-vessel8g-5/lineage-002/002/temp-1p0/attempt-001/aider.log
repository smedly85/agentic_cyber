def _parse_mode(mode_str):
    if not mode_str:
        raise ValueError("empty")
    
    # Check if it's numeric (all digits 0-7)
    if all(c in '01234567' for c in mode_str):
        val = int(mode_str, 8)
        if val > 0o7777:
            raise ValueError("out of range")
        return val
    
    # Symbolic mode
    return _evaluate_symbolic(mode_str)

def _evaluate_symbolic(mode_str):
    # Get current umask
    umask = os.umask(0)
    os.umask(umask)
    
    # Initialize: a=rwx
    mode = 0o777
    # Special bits: 0 (none initially)
    # Track explicitly-set classes
    explicit_classes = set()
    
    clauses = mode_str.split(',')
    for clause in clauses:
        if not clause:
            raise ValueError(f"empty clause in '{mode_str}'")
        
        # Parse who
        who = ''
        idx = 0
        while idx < len(clause) and clause[idx] in 'ugoa':
            who += clause[idx]
            idx += 1
        
        if idx >= len(clause):
            raise ValueError(f"missing operator in '{mode_str}'")
        
        op = clause[idx]
        if op not in '+-=':
            raise ValueError(f"invalid operator in '{mode_str}'")
        idx += 1
        
        perms = clause[idx:]
        
        # Validate perms
        if op == '=' and not perms:
            pass  # empty assignment is valid for =
        elif not perms:
            raise ValueError(f"missing permissions in '{mode_str}'")
        
        for c in perms:
            if c not in 'rwxXstugo':
                raise ValueError(f"invalid permission '{c}' in '{mode_str}'")
        
        # Determine if this is a permission-copy
        # In GNU, if perms is exactly one of 'u', 'g', 'o' (single char), it's a copy
        # But if who contains that letter, it's ambiguous... actually in GNU, the who
        # and perm are in different positions, so 'u+u' means "for u, copy u's bits to u" (no-op)
        # and 'g+u' means "for g, copy u's bits to g"
        is_copy = len(perms) == 1 and perms in 'ugo'
        
        # Determine target classes
        if who:
            has_explicit = True
            if 'a' in who:
                targets = {'u', 'g', 'o'}
            else:
                targets = set(who)
        else:
            has_explicit = False
            targets = {'u', 'g', 'o'}
        
        # Determine permission bits
        if is_copy:
            # Copy the source class's rwx bits
            source = perms  # 'u', 'g', or 'o'
            source_bits = (mode >> {'u': 6, 'g': 3, 'o': 0}[source]) & 0o7
            # For each target, apply the operation with source_bits
            for cls in targets:
                mode = _apply_to_class(mode, cls, op, source_bits, umask, has_explicit)
            # Mark as explicitly set if has_explicit
            if has_explicit:
                explicit_classes.update(targets)
        else:
            # Regular permission bits
            perm_bits = 0
            has_s = False
            has_t = False
            for c in perms:
                if c == 'r':
                    perm_bits |= 0o4
                elif c == 'w':
                    perm_bits |= 0o2
                elif c == 'x' or c == 'X':
                    perm_bits |= 0o1
                elif c == 's':
                    has_s = True
                elif c == 't':
                    has_t = True
            
            # Apply ordinary bits
            if perm_bits or op == '=':
                for cls in targets:
                    mode = _apply_to_class(mode, cls, op, perm_bits, umask, has_explicit)
                if has_explicit:
                    explicit_classes.update(targets)
            
            # Apply special bits
            if has_s or has_t:
                mode = _apply_special(mode, who, op, has_s, has_t)
    
    # Apply umask to classes not explicitly set
    for cls in ('u', 'g', 'o'):
        if cls not in explicit_classes:
            shift = {'u': 6, 'g': 3, 'o': 0}[cls]
            class_umask = (umask >> shift) & 0o7
            mask = 0o7 << shift
            mode = (mode & ~mask) | ((mode & mask) & ~class_umask)
    
    # Ensure the result is within 0o7777
    mode &= 0o7777
    return mode

def _apply_to_class(mode, cls, op, bits, umask, explicit):
    shift = {'u': 6, 'g': 3, 'o': 0}[cls]
    mask = 0o7 << shift
    current = (mode >> shift) & 0o7
    
    if not explicit:
        class_umask = (umask >> shift) & 0o7
        if op == '+':
            allowed = (~class_umask) & 0o7
            new_bits = (current | bits) & (current | allowed)
            # Actually: new bits = current | (bits & allowed)
            new_bits = current | (bits & allowed)
        elif op == '-':
            allowed = (~class_umask) & 0o7
            # Remove bits, but only those not protected by umask
            new_bits = current & ~(bits & allowed)
        else:  # '='
            new_bits = bits & (~class_umask) & 0o7
    else:
        if op == '+':
            new_bits = current | bits
        elif op == '-':
            new_bits = current & ~bits
        else:  # '='
            new_bits = bits
    
    new_bits &= 0o7
    mode = (mode & ~mask) | (new_bits << shift)
    return mode

def _apply_special(mode, who, op, has_s, has_t):
    # s: setuid for u, setgid for g
    if has_s:
        if not who or 'u' in who or 'a' in who:
            if op == '+':
                mode |= 0o4000
            elif op == '-':
                mode &= ~0o4000
            else:  # '='
                mode |= 0o4000
        if not who or 'g' in who or 'a' in who:
            if op == '+':
                mode |= 0o2000
            elif op == '-':
                mode &= ~0o2000
            else:
                mode |= 0o2000
    
    # t: sticky (for o, including a or omitted)
    if has_t:
        if not who or 'o' in who or 'a' in who:
            if op == '+':
                mode |= 0o1000
            elif op == '-':
                mode &= ~0o1000
            else:
                mode |= 0o1000
    
    return mode
