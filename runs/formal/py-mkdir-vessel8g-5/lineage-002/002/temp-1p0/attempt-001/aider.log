#!/usr/bin/env python3
"""Create directories (checkpoint 002: parents, mode)."""
import os
import sys


def _error(msg):
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()
    sys.exit(1)


def _invalid_mode(mode_str):
    _error(f"mkdir: invalid mode '{mode_str}'")


def _parse_mode(mode_str):
    """Parse a mode string (numeric or symbolic). Returns int mode (0..0o7777).
    Raises ValueError on invalid input."""
    if not mode_str:
        raise ValueError("empty")
    if all(c in '01234567' for c in mode_str):
        val = int(mode_str, 8)
        if val > 0o7777:
            raise ValueError("range")
        return val
    return _evaluate_symbolic(mode_str)


def _evaluate_symbolic(mode_str):
    """Evaluate a symbolic mode string per GNU Coreutils 9.11 directory semantics.
    Returns the resulting mode as an int (up to 0o7777)."""
    umask = os.umask(0)
    os.umask(umask)

    mode = 0o777  # a=rwx point of departure
    explicit_classes = set()  # classes whose ordinary bits were set via explicit-who

    clauses = mode_str.split(',')
    for clause in clauses:
        if not clause:
            raise ValueError("empty clause")

        # Parse who
        who = ''
        idx = 0
        while idx < len(clause) and clause[idx] in 'ugoa':
            who += clause[idx]
            idx += 1

        if idx >= len(clause):
            raise ValueError("missing operator")

        op = clause[idx]
        if op not in '+-=':
            raise ValueError("bad operator")
        idx += 1

        perms = clause[idx:]

        # Validate permission characters
        for c in perms:
            if c not in 'rwxXstugo':
                raise ValueError(f"bad perm char {c}")

        # Determine if this is a permission-copy (single u/g/o after operator)
        is_copy = len(perms) == 1 and perms in 'ugo'

        # Target classes
        has_explicit = bool(who)
        if who and 'a' in who:
            targets = {'u', 'g', 'o'}
        elif who:
            targets = set(who)
        else:
            targets = {'u', 'g', 'o'}

        if is_copy:
            source_cls = perms
            src_shift = {'u': 6, 'g': 3, 'o': 0}[source_cls]
            source_bits = (mode >> src_shift) & 0o7
            for cls in targets:
                mode = _apply_ordinary(mode, cls, op, source_bits, umask, has_explicit)
            if has_explicit:
                explicit_classes.update(targets)
        else:
            perm_bits = 0
            has_s = False
            has_t = False
            for c in perms:
                if c == 'r':
                    perm_bits |= 0o4
                elif c == 'w':
                    perm_bits |= 0o2
                elif c in 'xX':
                    perm_bits |= 0o1
                elif c == 's':
                    has_s = True
                elif c == 't':
                    has_t = True

            # Apply ordinary permission bits
            if perm_bits or op == '=':
                for cls in targets:
                    mode = _apply_ordinary(mode, cls, op, perm_bits, umask, has_explicit)
                if has_explicit:
                    explicit_classes.update(targets)

            # Apply special bits (s, t) — never filtered by umask
            if has_s or has_t:
                mode = _apply_special(mode, who, op, has_s, has_t)

    # Final step: apply umask to ordinary bits of classes NOT explicitly set
    for cls in ('u', 'g', 'o'):
        if cls not in explicit_classes:
            shift = {'u': 6, 'g': 3, 'o': 0}[cls]
            class_umask = (umask >> shift) & 0o7
            mask = 0o7 << shift
            mode = (mode & ~mask) | ((mode & mask) & ~class_umask)

    return mode & 0o7777


def _apply_ordinary(mode, cls, op, bits, umask, explicit):
    """Apply an operator to one class's ordinary (rwx) bits."""
    shift = {'u': 6, 'g': 3, 'o': 0}[cls]
    mask = 0o7 << shift
    current = (mode >> shift) & 0o7

    if not explicit:
        class_umask = (umask >> shift) & 0o7
        allowed = (~class_umask) & 0o7
        if op == '+':
            new = current | (bits & allowed)
        elif op == '-':
            new = current & ~(bits & allowed)
        else:
            new = bits & allowed
    else:
        if op == '+':
            new = current | bits
        elif op == '-':
            new = current & ~bits
        else:
            new = bits

    new &= 0o7
    return (mode & ~mask) | (new << shift)


def _apply_special(mode, who, op, has_s, has_t):
    """Apply special-bit operations (s, t).