def _mkdir_p(operand, desired_mode, umask):
    # Normalize the path (remove trailing slashes, resolve .)
    # But keep .. as-is (they have semantic meaning)
    
    # Actually, the simplest correct approach:
    # Build cumulative paths by iterating through components
    
    is_abs = operand.startswith('/')
    parts = [p for p in operand.split('/') if p != '']
    # Remove '.' components
    parts = [p for p in parts if p != '.']
    
    if not parts:
        # Path is "/", ".", or empty
        if os.path.isdir(operand):
            return
        raise OSError(20, "Not a directory", operand)
    
    # Build cumulative paths
    paths = []
    for i in range(len(parts)):
        if is_abs:
            paths.append('/' + '/'.join(parts[:i+1]))
        else:
            paths.append('/'.join(parts[:i+1]))
    
    # Process all but last as intermediates
    for p in paths[:-1]:
        if os.path.isdir(p):
            continue
        if os.path.lexists(p):
            raise NotADirectoryError(20, "Not a directory", p)
        os.mkdir(p, 0o777)
        # Ensure owner wx (should already be the case)
        st = os.stat(p)
        if not (st.st_mode & 0o300) == 0o300:
            os.chmod(p, st.st_mode | 0o300)
    
    # Final path
    final = paths[-1]
    if os.path.isdir(final):
        return
    if os.path.lexists(final):
        raise NotADirectoryError(20, "Not a directory", final)
    os.mkdir(final, 0o777)
    if desired_mode is not None:
        os.chmod(final, desired_mode)
