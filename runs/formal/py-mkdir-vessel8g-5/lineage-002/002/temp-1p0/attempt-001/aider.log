def _apply_op(mode, cls, op, perm_bits, umask, explicit_who):
    """Apply an operator to a specific class. Returns new mode and whether class is 'explicitly set'."""
    shift = _class_shift(cls)
    mask = _class_mask(cls)
    current = (mode >> shift) & 0o7
    target_bits = perm_bits & 0o7  # only rwx
    
    if not explicit_who:
        # Apply umask filtering
        class_umask = (umask >> shift) & 0o7
        if op == '+':
            # Can only add bits not protected by umask
            allowed = ~class_umask & 0o7
            new_bits = current | (target_bits & allowed)
        elif op == '-':
            # Can only remove bits not protected by umask
            allowed = ~class_umask & 0o7
            new_bits = current & ~(target_bits & allowed)
        else:  # '='
            # Set to target_bits filtered by umask
            new_bits = target_bits & ~class_umask & 0o7
    else:
        if op == '+':
            new_bits = current | target_bits
        elif op == '-':
            new_bits = current & ~target_bits
        else:  # '='
            new_bits = target_bits
    
    new_bits &= 0o7
    mode = (mode & ~mask) | (new_bits << shift)
    return mode
```

