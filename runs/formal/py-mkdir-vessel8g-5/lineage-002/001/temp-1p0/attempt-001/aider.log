```python
#!/usr/bin/env python3
"""Create directories (checkpoint 001: parents)."""
import os
import sys


def _create_with_parents(path: str, umask: int) -> None:
    """Create path and all missing parent components."""
    is_abs = path.startswith('/')
    parts = [p for p in path.split('/') if p and p != '.']
    if not parts:
        # Refers to '.' or '/' — already exists
        return

    prefix = '/' if is_abs else ''
    current = ''
    for i, part in enumerate(parts):
        if current:
            current = current + '/' + part
        else:
            current = part
        full = prefix + current

        if os.path.isdir(full):
            continue
        if os.path.lexists(full):
            raise NotADirectoryError(
                20, "Not a directory", path
            )

        is_last = (i == len(parts) - 1)
        if is_last:
            mode = 0o777 & ~umask
        else:
            mode = (0o777 & ~umask) | 0o700
        os.mkdir(full, mode)


def main():
    args = sys.argv[1:]
    operands = []
    after_ddash = False
    parents = False

    for arg in args:
        if not after_ddash:
            if arg == '--':
                after_ddash = True
            elif arg == '-p':
                parents = True
            elif arg == '--parents':
                parents = True
            elif arg.startswith('-') and len(arg) > 1:
                if arg.startswith('--'):
                    sys.stderr.write(f"mkdir: unrecognized option '{arg}'\n")
                else:
                    sys.stderr.write(f"mkdir: invalid option -- '{arg[1]}'\n")
                sys.stderr.write("Try 'mkdir --help' for more information.\n")
                sys.exit(1)
            else:
                operands.append(arg)
        else:
            operands.append(arg)

    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.exit(1)

    umask = os.umask()
    any_failed = False
    for operand in operands:
        try:
            if parents:
                _create_with_parents(operand, umask)
            else:
                os.mkdir(operand, 0o777)
        except OSError as e:
            any_failed = True
            msg = e.strerror or os.strerror(e.errno) or "Unknown error"
            sys.stderr.write(
                f"mkdir: cannot create directory '{operand}': {msg}\n"
            )
        except MemoryError:
            any_failed = True
            sys.stderr.write(
                f"mkdir: cannot create directory '{operand}': Cannot allocate memory\n"
            )
        except Exception as e:
            any_failed = True
            sys.stderr.write(
                f"mkdir: cannot create directory '{operand}': {e}\n"
            )

    sys.exit(1 if any_failed else 0)


if __name__ == '__main__':
    try:
        main()
    except SystemExit:
        raise
    except Exception:
        sys.exit(1)
```

