#!/usr/bin/env python3
"""Create directories (checkpoint 001: parents)."""
import os
import sys


def _makedirs_p(path: str) -> None:
    """Create path and all missing parent components (mkdir -p semantics).
    Existing directories (including symlinks to directories) succeed.
    Existing non-directories raise an error."""
    if os.path.isdir(path):
        return
    if os.path.lexists(path):
        raise NotADirectoryError(20, "Not a directory", path)
    parent = os.path.dirname(path)
    if parent and parent not in ('.',):
        _makedirs_p(parent)
    # Re-check in case of race or if parent creation made path exist
    if os.path.isdir(path):
        return
    os.mkdir(path, 0o777)


def main() -> None:
    args = sys.argv[1:]
    operands = []
    after_ddash = False
    parents = False

    for arg in args:
        if after_ddash:
            operands.append(arg)
        elif arg == '--':
            after_ddash = True
        elif arg == '-p' or arg == '--parents':
            parents = True
        elif arg.startswith('-') and arg != '-':
            if arg.startswith('--'):
                sys.stderr.write(f"mkdir: unrecognized option '{arg}'\n")
            else:
                sys.stderr.write(f"mkdir: invalid option -- '{arg[1]}'\n")
            sys.stderr.write("Try 'mkdir --help' for more information.\n")
            sys.stderr.flush()
            sys.exit(1)
        else:
            operands.append(arg)

    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.stderr.flush()
        sys.exit(1)

    any_failed = False
    for operand in operands:
        try:
            if parents:
                _makedirs_p(operand)
            else:
                os.mkdir(operand, 0o777)
        except OSError as e:
            any_failed = True
            msg = e.strerror or os.strerror(e.errno) or "Unknown error"
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': {msg}\n")
            sys.stderr.flush()
        except Exception:
            any_failed = True
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': Unknown error\n")
            sys.stderr.flush()

    sys.exit(0 if not any_failed else 1)


if __name__ == '__main__':
    main()
