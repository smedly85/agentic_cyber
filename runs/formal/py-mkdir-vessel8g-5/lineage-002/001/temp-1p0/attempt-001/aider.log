```python
#!/usr/bin/env python3
"""Create directories (checkpoint 001: parents)."""
import os
import sys


def _error(operand: str, e: OSError) -> None:
    """Write a GNU-compatible error message to stderr."""
    strerror = e.strerror or os.strerror(e.errno) or "Unknown error"
    sys.stderr.write(f"mkdir: cannot create directory '{operand}': {strerror}\n")
    sys.stderr.flush()


def main() -> None:
    args = sys.argv[1:]
    
    # Parse arguments
    operands = []
    after_ddash = False
    parents = False
    error = False
    
    for arg in args:
        if after_ddash:
            operands.append(arg)
        elif arg == '--':
            after_ddash = True
        elif arg == '-p' or arg == '--parents':
            parents = True
        elif arg.startswith('-') and arg != '-':
            # Unknown option
            if arg.startswith('--'):
                sys.stderr.write(f"mkdir: unrecognized option '{arg}'\n")
            else:
                sys.stderr.write(f"mkdir: invalid option -- '{arg[1]}'\n")
            sys.stderr.write("Try 'mkdir --help' for more information.\n")
            sys.stderr.flush()
            sys.exit(1)
        else:
            operands.append(arg)
    
    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.stderr.flush()
        sys.exit(1)
    
    any_failed = False
    for operand in operands:
        try:
            if parents:
                os.makedirs(operand, mode=0o777, exist_ok=True)
            else:
                os.mkdir(operand, 0o777)
        except FileExistsError as e:
            any_failed = True
            _error(operand, e)
        except NotADirectoryError as e:
            any_failed = True
            _error(operand, e)
        except PermissionError as e:
            any_failed = True
            _error(operand, e)
        except OSError as e:
            any_failed = True
            _error(operand, e)
    
    sys.exit(1 if any_failed else 0)


if __name__ == '__main__':
    main()
```

