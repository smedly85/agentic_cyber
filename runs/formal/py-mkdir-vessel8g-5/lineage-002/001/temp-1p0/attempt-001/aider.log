```python
def _makedirs_p(path: str) -> None:
    """Create path and all missing parents (like GNU mkdir -p).
    Existing directories (including symlinks to directories) are OK.
    Existing non-directories cause an error."""
    # Normalize: remove trailing slashes, resolve . components
    # But keep .. as-is (it's a valid path component)
    # Actually, let's just walk the path components
    
    # Split into components, keeping empty strings for leading slash
    parts = path.split('/')
    
    # Build up the path component by component
    current = ''
    for i, part in enumerate(parts):
        if part == '' or part == '.':
            # Skip empty (from leading slash or //) and dot components
            # But we still need to track the current path
            if part == '' and i == 0:
                current = '/'  # absolute path
            elif part == '' :
                pass  # repeated slash, skip
            else:
                # dot component, skip
                pass
            continue
        
        if i == 0 and not path.startswith('/'):
            current = part
        elif current == '/' or current == '':
            current = '/' + part if path.startswith('/') else part
        else:
            current = current + '/' + part
        
        # Check if current path exists
        if os.path.isdir(current):
            # Exists and is a directory (or symlink to dir) - OK
            continue
        if os.path.lexists(current):
            # Exists but is not a directory - error
            raise NotADirectoryError(20, "Not a directory", path)
        
        # Doesn't exist - create it
        os.mkdir(current, 0o777)
```

