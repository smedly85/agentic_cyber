    if req_w:
        ord_bits |= 0o222
    if req_x:
        ord_bits |= 0o111
    ord_bits &= who_mask
    
    # Special bits requested
    spec_bits = 0
    if req_s:
        if 'u' in who_set or 'a' in who_set or not who_explicit:
            spec_bits |= 0o4000
        if 'g' in who_set or 'a' in who_set or not who_explicit:
