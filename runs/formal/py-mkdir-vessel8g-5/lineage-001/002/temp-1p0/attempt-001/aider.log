            spec_bits |= 0o4000
        if 'g' in who_set:
            spec_bits |= 0o2000
        if 'a' in who_set or not who_explicit:
            spec_bits |= 0o6000
    if req_t:
        if 'o' in who_set or 'a' in who_set or not who_explicit:
            spec_bits |= 0o1000

    if op == '+':
