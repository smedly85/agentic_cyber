    def _apply_copy(op: str, source: str, who_mask: int, who_explicit: bool, umask: int) -> None:
        nonlocal ordinary
        # Copy source class's rwX bits to the target who
        # For directories, X = x, so we copy r, w, x
        if source == 'u':
            src_bits = ordinary & 0o700
        elif source == 'g':
            src_bits = ordinary & 0o070
        else:  # o
            src_bits = ordinary & 0o007
        
        # Map source bits to the target who_mask
        # u→ugo: rwx bits from u mapped to each selected class
        # g→u: rw bits from g mapped to u
        # etc.
        # The copy maps: source_r → target_r, source_w → target_w, source_x → target_x
        # for each class in the target
        
        # Actually, permission copy in GNU:
        # "u+g" means: for each of u,g,o (the target), add the bits that g has
        #   Specifically: u gets g's r, w, x (if g has them)
        # "g+u" means: g gets u's r, w, x
        # "ug+o" means: both u and g get o's r, w, x
        
        # So the mapping is: for each bit in source (r=4, w=2, x=1),
        #   if source has that bit, add it to each target class
        
        # source bits in a single class (e.g., g's bits are in positions 4,5,6 for r,w,x)
        # We need to extract the pattern and apply to target classes
        
        # g's bits: 0o070 → pattern in 3 bits: (g_r, g_w, g_x) = bits 5,4,3
        # u's bits: 0o700 → pattern in 3 bits: (u_r, u_w, u_x) = bits 8,7,6
