    # Regular permission chars
    req_r = 'r' in rest
    req_w = 'w' in rest
    req_x = ('x' in rest) or ('X' in rest)
    req_s = 's' in rest
    req_t = 't' in rest

    if not (req_r or req_w or req_x or req_s or req_t):
        raise ValueError(f"bad permission: {clause!r}")

    ord_bits = 0
    if req_r:
        ord_bits |= 0o444
    if req_w:
        ord_bits |= 0o222
    if req_x:
        ord_bits |= 0o111
    ord_bits &= who_mask

    spec_bits = 0
