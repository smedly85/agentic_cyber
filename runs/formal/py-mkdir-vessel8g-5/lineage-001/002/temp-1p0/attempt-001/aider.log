def _apply_clause(clause: str, ordinary: int, special: int, umask: int) -> tuple[int, int]:
    if not clause:
        raise ValueError("empty clause")
    
    # Parse who
    i = 0
    who_set = set()
    while i < len(clause) and clause[i] in 'ugoa':
        who_set.add(clause[i])
        i += 1
    
    who_explicit = bool(who_set)
    if 'a' in who_set:
        who_mask = 0o777
    else:
        who_mask = 0
        if 'u' in who_set:
            who_mask |= 0o700
        if 'g' in who_set:
            who_mask |= 0o070
        if 'o' in who_set:
            who_mask |= 0o007
        if who_mask == 0:
            who_mask = 0o777  # shouldn't reach here if who_explicit
    
    rest = clause[i:]
    
    # Parse operator
    if not rest or rest[0] not in '+-=':
        raise ValueError(f"missing operator in {clause!r}")
    op = rest[0]
    rest = rest[1:]
    
    # Special bits owned by this who
    if 'u' in who_set or 'a' in who_set or not who_explicit:
        special_clear_for_eq = 0o4000
    else:
        special_clear_for_eq = 0
    if 'g' in who_set or 'a' in who_set or not who_explicit:
        special_clear_for_eq |= 0o2000
    if 'o' in who_set or 'a' in who_set or not who_explicit:
        special_clear_for_eq |= 0o1000
    
    if not rest:
        # Empty assignment (e.g., "o=" or "a=")
        if op == '=':
            ordinary &= ~who_mask
            special &= ~special_clear_for_eq
        # + or - with no perms is a no-op
        return ordinary, special
    
    # Check for permission copy (single u/g/o)
    if len(rest) == 1 and rest in 'ugo':
        return _apply_copy(op, rest, who_mask, who_explicit, ordinary, special, umask, special_clear_for_eq)
    
    # Parse permission characters
    req_r = 'r' in rest
    req_w = 'w' in rest
    req_x = ('x' in rest) or ('X' in rest)  # For dirs, X = x
    req_s = 's' in rest
    req_t = 't' in rest
    
    # Validate: must have at least one valid permission char
    if not (req_r or req_w or req_x or req_s or req_t):
        raise ValueError(f"invalid permission in {clause!r}")
    
    # Ordinary bits requested
    ord_bits = 0
    if req_r:
