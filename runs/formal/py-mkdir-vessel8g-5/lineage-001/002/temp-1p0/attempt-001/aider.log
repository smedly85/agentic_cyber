def _apply_copy(op, source, who_mask, who_explicit, ordinary, special, umask, special_clear_for_eq):
    # Copy source class's rwX bits to target
    if source == 'u':
        pattern = (ordinary >> 6) & 0o7
    elif source == 'g':
        pattern = (ordinary >> 3) & 0o7
    else:  # o
        pattern = ordinary & 0o7
    
    # Apply to target classes
    target_bits = 0
    if who_mask & 0o700:
        target_bits |= pattern << 6
    if who_mask & 0o070:
        target_bits |= pattern << 3
    if who_mask & 0o007:
        target_bits |= pattern
    
    if op == '+':
        if who_explicit:
            ordinary |= target_bits
        else:
            ordinary |= (target_bits & ~umask)
    elif op == '-':
        if who_explicit:
            ordinary &= ~target_bits
        else:
            ordinary &= ~(target_bits & ~umask)
    elif op == '=':
        if who_explicit:
            ordinary = (ordinary & ~who_mask) | target_bits
        else:
            ordinary = target_bits & ~umask
        special &= ~special_clear_for_eq
    
    return ordinary, special
