#!/usr/bin/env python3
"""mkdir: Create directories (checkpoint 002)."""

import os
import stat
import sys


def _fail(msg: str) -> None:
    sys.stderr.write(msg + "\n")
    sys.stderr.write("Try 'mkdir --help' for more information.\n")
    sys.exit(1)


def _diagnose(operand: str, e: OSError) -> None:
    if isinstance(e, FileExistsError):
        reason = "File exists"
    elif isinstance(e, FileNotFoundError):
        reason = "No such file or directory"
    elif isinstance(e, NotADirectoryError):
        reason = "Not a directory"
    elif isinstance(e, PermissionError):
        reason = "Permission denied"
    else:
        reason = e.strerror or "error"
    sys.stderr.write(f"mkdir: cannot create directory '{operand}': {reason}\n")


def _ensure_owner_wx(path: bytes) -> None:
    st = os.lstat(path)
    mode = stat.S_IMODE(st.st_mode)
    if (mode & 0o300) != 0o300:
        os.chmod(path, mode | 0o300)


# --- Mode parsing ---

def _parse_mode_arg(value: str) -> int:
    """Parse a mode argument (numeric or symbolic) into an integer mode.
    Raises ValueError for invalid modes."""
    if not value:
        raise ValueError("empty")
    # Try numeric first
    if all(c in '01234567' for c in value):
        mode = int(value, 8)
        if mode > 0o7777:
            raise ValueError(f"out of range: {value}")
        return mode
    # Symbolic
    return _parse_symbolic(value)


def _parse_symbolic(expr: str) -> int:
    """Parse a symbolic mode expression and return the resulting mode integer."""
    umask = os.umask(0)  # Get and reset umask... wait, this changes umask!
    # Actually, we need to get the CURRENT umask without changing it.
    # os.umask(0) sets umask to 0 and returns the old value.
    # We need to restore it.
    old_umask = os.umask(0)
    os.umask(old_umask)  # Restore
    ...
