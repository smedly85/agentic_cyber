    argv = sys.argv[1:]

    operands: list[str] = []
    seen_ddash = False
    unknown_opt: str | None = None
    parents = False
    mode_str: str | None = None

    i = 0
    while i < len(argv):
        arg = argv[i]
        if seen_ddash:
            operands.append(arg)
        elif arg == "--":
            seen_ddash = True
        elif arg == "-":
            operands.append(arg)
        elif arg.startswith("--"):
