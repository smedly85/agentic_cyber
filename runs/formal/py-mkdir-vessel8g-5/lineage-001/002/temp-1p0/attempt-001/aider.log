            os.chmod(path_bytes, final)


def _mkdir_p(operand: str, mode: int | None, enforce_exact: bool,
             umask: int) -> bool:
    raw = os.fsencode(operand)
    parts = [p for p in raw.split(b'/') if p]
    if not parts:
        # Empty or just slashes — try to create at cwd
        try:
            _create_dir(raw, mode, enforce_exact, umask)
        except OSError as e:
            _diagnose(operand, e)
            return False
        return True

    last = len(parts) - 1
    for i, part in enumerate(parts):
        prefix = b'/'.join(parts[:i + 1])
        is_final = (i == last)
        try:
            st = os.lstat(prefix)
        except OSError:
            try:
                if is_final and mode is not None:
                    _create_dir(prefix, mode, enforce_exact, umask)
                else:
                    _create_dir(prefix, None, False, umask)
            except OSError as e:
                _diagnose(operand, e)
                return False
            if not is_final:
                try:
                    _ensure_owner_wx(prefix)
                except OSError as e:
                    _diagnose(operand, e)
                    return False
        else:
            if stat.S_ISDIR(st.st_mode):
                continue
            if stat.S_ISLNK(st.st_mode):
                try:
                    st2 = os.stat(prefix)
                except OSError:
                    _diagnose(operand, NotADirectoryError())
                    return False
                if not stat.S_ISDIR(st2.st_mode):
                    _diagnose(operand, NotADirectoryError())
                    return False
            else:
                _diagnose(operand, NotADirectoryError())
                return False
    return True


def _mkdir_simple(operand: str, mode: int | None, enforce_exact: bool,
                  umask: int) -> bool:
    raw = os.fsencode(operand)
    try:
        _create_dir(raw, mode, enforce_exact, umask)
    except OSError as e:
        _diagnose(operand, e)
        return False
    return True


def main() -> None:
    argv = sys.argv[1:]

    operands: list[str] = []
    seen_ddash = False
    unknown_opt: str | None = None
    parents = False
    mode_str: str | None = None

    i = 0
    while i < len(argv):
        arg = argv[i]
        if seen_ddash:
            operands.append(arg)
        elif arg == "--":
            seen_ddash = True
        elif arg == "-":
            operands.append(arg)
        elif arg.startswith("--"):
            if arg == "--parents" or arg == "-p":
                parents = True
            elif arg == "--mode":
                if i + 1 >= len(argv):
                    _missing_mode_arg(False)
                i += 1
                mode_str = argv[i]
            elif arg.startswith("--mode="):
                mode_str = arg[len("--mode="):]
            elif unknown_opt is None:
                unknown_opt = arg
        elif arg.startswith("-"):
            if arg == "-p":
                parents = True
            elif arg.startswith("-m") and len(arg) > 2:
                mode_str = arg[2:]
            elif arg == "-m":
                if i + 1 >= len(argv):
                    _missing_mode_arg(True)
                i += 1
                mode_str = argv[i]
            elif unknown_opt is None:
                unknown_opt = arg
        else:
            operands.append(arg)
        i += 1

    if unknown_opt is not None:
        opt = unknown_opt
        if opt.startswith("--"):
            _fail(f"mkdir: unrecognized option '{opt}'")
        else:
            ch = opt[1] if len(opt) > 1 else ""
            _fail(f"mkdir: invalid option -- '{ch}'")

    if not operands:
        _fail("mkdir: missing operand")

    # Parse mode before any mutation
    mode: int | None = None
    enforce_exact = False
    if mode_str is not None:
        try:
            mode, enforce_exact = _parse_mode(mode_str)
        except (ValueError, TypeError):
            _invalid_mode(mode_str)

    umask = _get_umask()

    all_ok = True
    for operand in operands:
        if parents:
            if not _mkdir_p(operand, mode, enforce_exact, umask):
                all_ok = False
        else:
            if not _mkdir_simple(operand, mode, enforce_exact, umask):
                all_ok = False

    sys.exit(0 if all_ok else 1)


if __name__ == "__main__":
    main()
