            ordinary |= ord_bits
        else:
            ordinary |= (ord_bits & ~umask)
        special |= spec_bits
    elif op == '-':
        if who_explicit:
            ordinary &= ~ord_bits
        else:
            ordinary &= ~(ord_bits & ~umask)
        special &= ~spec_bits
    else:  # '='
        if who_explicit:
            ordinary = (ordinary & ~who_mask) | ord_bits
        else:
