#!/usr/bin/env python3
"""mkdir: Create directories."""

import os
import sys

def main():
    argv = sys.argv[1:]
    
    # Parse arguments
    operands = []
    seen_ddash = False
    unknown_option = None
    
    for arg in argv:
        if seen_ddash:
            operands.append(arg)
        elif arg == '--':
            seen_ddash = True
        elif arg == '-':
            operands.append(arg)
        elif arg.startswith('-'):
            if unknown_option is None:
                unknown_option = arg
        else:
            operands.append(arg)
    
    if unknown_option is not None:
        opt = unknown_option
        if opt.startswith('--'):
            sys.stderr.write(f"mkdir: unrecognized option '{opt}'\n")
        else:
            # single char after '-'
            ch = opt[1] if len(opt) > 1 else ''
            sys.stderr.write(f"mkdir: invalid option -- '{ch}'\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.exit(1)
    
    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.exit(1)
    
    # Create directories
    exit_status = 1  # will be set to 0 if all succeed
    
    all_ok = True
    for operand in operands:
        path_bytes = os.fsencode(operand)
        try:
            os.mkdir(path_bytes)
        except FileExistsError:
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': File exists\n")
            all_ok = False
        except FileNotFoundError:
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': No such file or directory\n")
            all_ok = False
        except NotADirectoryError:
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': Not a directory\n")
            all_ok = False
        except PermissionError:
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': Permission denied\n")
            all_ok = False
        except OSError as e:
            sys.stderr.write(f"mkdir: cannot create directory '{operand}': {e.strerror or 'error'}\n")
            all_ok = False
    
    sys.exit(0 if all_ok else 1)

if __name__ == "__main__":
    main()
```

