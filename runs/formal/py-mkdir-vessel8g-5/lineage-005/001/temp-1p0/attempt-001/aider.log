#!/usr/bin/env python3
"""mkdir - create directories"""
import os
import sys


def _err(msg: str) -> None:
    sys.stderr.write(msg + "\n")


def _get_umask() -> int:
    """Get the current process umask without changing it."""
    umask = os.umask(0)
    os.umask(umask)
    return umask


def _path_exists_is_dir(path: str) -> bool:
    """Check if path exists and is a directory (follows symlinks)."""
    try:
        return os.path.isdir(path)
    except (OSError, ValueError):
        return False


def _path_exists(path: str) -> bool:
    try:
        os.lstat(path)
        return True
    except (OSError, ValueError):
        return False


def _create_dir_p(path: str, umask: int) -> int:
    """Create directory with -p semantics. Returns 0 on success, 1 on failure."""
    # Split into components, ignoring empty and '.' components
    parts = [p for p in path.split('/') if p and p != '.']
    
    # If all components were filtered out (e.g., path is '/' or './'), 
    # the path is the current directory which already exists
    if not parts:
        return 0
    
    current = ''
    for i, part in enumerate(parts):
        current = current + '/' + part if current else part
        is_last = (i == len(parts) - 1)
        
        # Check if current path exists
        if os.path.lexists(current):
            if os.path.isdir(current):
                continue
            else:
                _err(f"mkdir: cannot create directory '{path}': Not a directory")
                return 1
        else:
            # Create the directory
            if is_last:
                mode = 0o777 & ~umask
            else:
                mode = 0o777 & ~umask
                # Ensure owner has at least rwx (write + search)
                mode |= 0o700
            
            try:
                os.mkdir(current, mode)
            except FileExistsError:
                # Race condition or it was created between check and create
                if os.path.isdir(current):
                    continue
                _err(f"mkdir: cannot create directory '{path}': File exists")
                return 1
            except PermissionError:
                _err(f"mkdir: cannot create directory '{path}': Permission denied")
                return 1
            except OSError as e:
                msg = e.strerror if e.strerror else os.strerror(e.errno) if e.errno else "Unknown error"
                _err(f"mkdir: cannot create directory '{path}': {msg}")
                return 1
    
    return 0


def main() -> int:
    args = sys.argv[1:]
    operands: list[str] = []
    after_dd = False
    parents = False

    for arg in args:
        if not after_dd:
            if arg == '--':
                after_dd = True
                continue
            if arg.startswith('-') and len(arg) > 1:
                if arg == '-p' or arg == '--parents':
                    parents = True
                    continue
                if arg.startswith('--'):
                    _err(f"mkdir: unrecognized option '{arg}'")
                else:
                    _err(f"mkdir: invalid option -- '{arg[1]}'")
                _err("Try 'mkdir --help' for more information.")
                return 1
        operands.append(arg)

    if not operands:
        _err("mkdir: missing operand")
        _err("Try 'mkdir --help' for more information.")
        return 1

    umask = _get_umask()
    rc = 0
    for path in operands:
        if parents:
            r = _create_dir_p(path, umask)
        else:
            try:
                os.mkdir(path, 0o777)
            except FileExistsError:
                _err(f"mkdir: cannot create directory '{path}': File exists")
                r = 1
            except FileNotFoundError:
                _err(f"mkdir: cannot create directory '{path}': No such file or directory")
                r = 1
            except PermissionError:
                _err(f"mkdir: cannot create directory '{path}': Permission denied")
                r = 1
            except NotADirectoryError:
                _err(f"mkdir: cannot create directory '{path}': Not a directory")
                r = 1
            except OSError as e:
                msg = e.strerror if e.strerror else os.strerror(e.errno) if e.errno else "Unknown error"
                _err(f"mkdir: cannot create directory '{path}': {msg}")
                r = 1
        if r != 0:
            rc = 1

    return rc


if __name__ == '__main__':
    sys.exit(main())
```

