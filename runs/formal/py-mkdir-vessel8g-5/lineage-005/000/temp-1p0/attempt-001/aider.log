        except FileExistsError:
            sys.stderr.write(f"mkdir: cannot create directory '{path}': File exists\n")
            exit_code = 1
        except FileNotFoundError:
            sys.stderr.write(f"mkdir: cannot create directory '{path}': No such file or directory\n")
