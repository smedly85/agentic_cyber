```python
#!/usr/bin/env python3
"""mkdir - create directories"""
import os
import sys


def _error(msg: str) -> None:
    sys.stderr.write(msg + "\n")


def main() -> int:
    args = sys.argv[1:]
    operands: list[str] = []
    after_dd = False

    for arg in args:
        if not after_dd:
            if arg == '--':
                after_dd = True
                continue
            if arg.startswith('-') and len(arg) > 1:
                # Unknown option
                if arg.startswith('--'):
                    _error(f"mkdir: unrecognized option '{arg}'")
                else:
                    _error(f"mkdir: invalid option -- '{arg[1]}'")
                _error("Try 'mkdir --help' for more information.")
                return 1
        operands.append(arg)

    if not operands:
        _error("mkdir: missing operand")
        _error("Try 'mkdir --help' for more information.")
        return 1

    rc = 0
    for path in operands:
        try:
            os.mkdir(path, 0o777)
        except FileExistsError:
            _error(f"mkdir: cannot create directory '{path}': File exists")
            rc = 1
        except FileNotFoundError:
            _error(f"mkdir: cannot create directory '{path}': No such file or directory")
            rc = 1
        except PermissionError:
            _error(f"mkdir: cannot create directory '{path}': Permission denied")
            rc = 1
        except NotADirectoryError:
            _error(f"mkdir: cannot create directory '{path}': Not a directory")
            rc = 1
        except OSError as e:
            _error(f"mkdir: cannot create directory '{path}': {e.strerror}")
            rc = 1

    return rc


if __name__ == '__main__':
    sys.exit(main())
```

