            # else: it's an operand (bare '-' is an operand)
            operands.append(arg)
        else:
            operands.append(arg)
    
    if not operands:
        sys.stderr.write("mkdir: missing operand\n")
        sys.stderr.write("Try 'mkdir --help' for more information.\n")
        sys.exit(1)
    
    # Process operands
