#!/usr/bin/env python3
"""mkdir - create directories"""
import os
import sys


def _err(msg: str) -> None:
    sys.stderr.write(msg + "\n")


def main() -> int:
    args = sys.argv[1:]
    operands: list[str] = []
    after_dd = False

    for arg in args:
        if not after_dd:
            if arg == '--':
                after_dd = True
                continue
            if arg.startswith('-') and len(arg) > 1:
                if arg.startswith('--'):
                    _err(f"mkdir: unrecognized option '{arg}'")
                else:
                    _err(f"mkdir: invalid option -- '{arg[1]}'")
                _err("Try 'mkdir --help' for more information.")
                return 1
        operands.append(arg)

    if not operands:
        _err("mkdir: missing operand")
        _err("Try 'mkdir --help' for more information.")
        return 1

    rc = 0
    for path in operands:
        try:
            os.mkdir(path, 0o777)
        except FileExistsError:
            _err(f"mkdir: cannot create directory '{path}': File exists")
            rc = 1
        except FileNotFoundError:
            _err(f"mkdir: cannot create directory '{path}': No such file or directory")
            rc = 1
        except PermissionError:
            _err(f"mkdir: cannot create directory '{path}': Permission denied")
            rc = 1
        except NotADirectoryError:
            _err(f"mkdir: cannot create directory '{path}': Not a directory")
            rc = 1
        except OSError as e:
            msg = e.strerror if e.strerror else os.strerror(e.errno) if e.errno else "Unknown error"
            _err(f"mkdir: cannot create directory '{path}': {msg}")
            rc = 1

    return rc


if __name__ == '__main__':
    sys.exit(main())
```

**Rationale for each design decision:**

1. **`os.mkdir(path, 0o777)`** — creates a single directory (not `os.makedirs`). The mode `0o777` is masked by the kernel's umask, matching GNU mkdir behavior. The engine pins umask via `preexec_fn`.

2. **Option parsing before mutation** — the loop collects all operands and checks for unknown options before any `os.mkdir` call. This satisfies "parse supported options before mutation, including options following operands."

3. **`--` handling** — once seen, all subsequent arguments (including `-x` or `--foo`) are literal operands. Multiple `--` are fine; the first one triggers the flag, the rest become operands.

4. **Bare `-`** — `len('-') == 1`, so the `len(arg) > 1` check lets it through as an operand.

5. **Error messages** — follow GNU coreutils 9.11 `die()` format: `mkdir: cannot create directory 'PATH': STRERROR`. The specific errno-to-string mapping matches what the kernel returns via the exception's `strerror`.

6. **Continue after per-operand errors** — the loop doesn't break on failure; it sets `rc = 1` and moves to the next operand.

7. **stdout is empty** — nothing is ever written to `sys.stdout`.

8. **Byte-string paths** — Python's `sys.argv` uses surrogateescape on Linux, so non-UTF-8 bytes round-trip correctly through `os.mkdir()` and into the stderr diagnostic.

9. **No external dependencies** — only `os` and `sys` from the standard library. No subprocesses, no ctypes.

10. **Symlink traversal** — the OS kernel follows directory symlinks in parent path components during `mkdir`. If the final component exists as a symlink, `os.mkdir` raises `FileExistsError` (we don't replace it). If a parent component is a regular file, `NotADirectoryError` is raised.

