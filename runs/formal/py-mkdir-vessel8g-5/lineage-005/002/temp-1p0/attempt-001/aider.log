    """Parse a mode string (numeric or symbolic). Returns (mode, valid)."""
    if not mode_str:
        return (0, False)
    
    # Try numeric first
    if all(c in '01234567' for c in mode_str):
        try:
            val = int(mode_str, 8)
        except ValueError:
            return (0, False)
        if val > 0o7777:
