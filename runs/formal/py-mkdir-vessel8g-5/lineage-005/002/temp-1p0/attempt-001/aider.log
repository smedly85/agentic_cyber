```python
def main() -> int:
    args = sys.argv[1:]
    operands = []
    after_dd = False
    parents = False
    mode_str = None  # None means no -m given
    
    i = 0
    while i < len(args):
        arg = args[i]
        if not after_dd:
            if arg == '--':
                after_dd = True
                i += 1
                continue
            if arg == '-':
                operands.append(arg)
                i += 1
                continue
            if arg.startswith('-') and len(arg) > 1:
                if arg == '-p' or arg == '--parents':
                    parents = True
                elif arg == '-m' or arg == '--mode':
                    # Next arg is the mode
                    i += 1
                    if i >= len(args):
                        _err(f"mkdir: option requires an argument -- '{arg[0] if len(arg)==2 else 'm'}'")
                        # Actually, let me match GNU's error message
                        _err("Try 'mkdir --help' for more information.")
                        return 1
                    mode_str = args[i]
                elif arg.startswith('-m') and len(arg) > 2:
                    mode_str = arg[2:]
                elif arg.startswith('--mode='):
                    mode_str = arg[7:]
                else:
                    # Unknown option
                    if arg.startswith('--'):
                        _err(f"mkdir: unrecognized option '{arg}'")
                    else:
                        _err(f"mkdir: invalid option -- '{arg[1]}'")
                    _err("Try 'mkdir --help' for more information.")
                    return 1
            else:
                operands.append(arg)
        else:
            operands.append(arg)
        i += 1
    
    if not operands:
        _err("mkdir: missing operand")
        _err("Try 'mkdir --help' for more information.")
        return 1
    
    # Validate mode before any filesystem operations
    umask = _get_umask()
    mode = None  # None means use default (0o777 & ~umask)
    if mode_str is not None:
        mode = _parse_mode(mode_str, umask)
        if mode is None:
            _err(f"mkdir: invalid mode: '{mode_str}'")
            _err("Try 'mkdir --help' for more information.")
            return 1
    
    # Create directories
    rc = 0
    for path in operands:
        if parents:
            r = _create_dir_p(path, umask, mode)
        else:
            r = _create_dir(path, mode)
        if r != 0:
            rc = 1
    
    return rc
```

