    who_omitted = (who_str == '')
    if who_omitted:
        who = set('ugo')  # for determining which bits to consider
    
    perms = _parse_perms(perms_str)
    if perms is None:
        return None
    
    # Permission copy
    if isinstance(perms, str):
        return _apply_copy(op, who, who_omitted, perms, mode, umask)
    
    # Regular permissions
    return _apply_regular(op, who, who_omitted, perms, mode, umask)


