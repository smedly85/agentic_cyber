#!/usr/bin/env python3
"""mkdir - create directories"""
import os
import sys


def _err(msg: str) -> None:
    sys.stderr.write(msg + "\n")


def _get_umask() -> int:
    mask = os.umask(0)
    os.umask(mask)
    return mask


# --- Mode parsing helpers ---

def _r_bit(w):
    return {'u': 0o400, 'g': 0o040, 'o': 0o004}[w]

def _w_bit(w):
    return {'u': 0o200, 'g': 0o020, 'o': 0o002}[w]

def _x_bit(w):
    return {'u': 0o100, 'g': 0o010, 'o': 0o001}[w]

def _rwx_mask(w):
    return _r_bit(w) | _w_bit(w) | _x_bit(w)


def _parse_who(who_str):
    """Parse who part. Returns set of {'u','g','o'} or empty set if omitted.
    Returns None if invalid."""
    if not who_str:
        return set()
    if 'a' in who_str:
        # Validate remaining chars are valid who chars
        for c in who_str:
            if c not in 'ugoa':
                return None
        return set('ugo')
    result = set()
    for c in who_str:
        if c in 'ugo':
            result.add(c)
        else:
            return None
    if not result:
        return None
    return result


def _apply_regular(op, who, who_omitted, perms, mode, umask):
    """Apply a regular (non-copy) permission clause."""
    affected = who if not who_omitted else set('ugo')

    # Compute the ordinary bits specified by perms for each affected who
    spec_ordinary = 0
    for w in affected:
        if 'r' in perms:
            spec_ordinary |= _r_bit(w)
        if 'w' in perms:
            spec_ordinary |= _w_bit(w)
        if 'x' in perms or 'X' in perms:
            spec_ordinary |= _x_bit(w)

    # Determine special bits specified
    spec_setuid = ('s' in perms) and ('u' in affected)
    spec_setgid = ('s' in perms) and ('g' in affected)
    spec_sticky = ('t' in perms) or (('s' in perms) and ('o' in affected))

    if op == '+':
        new_ordinary = mode & 0o777
        new_special = mode & 0o7000
        if who_omitted:
            # Only add ordinary bits not protected by umask
            add_ordinary = spec_ordinary & (~umask & 0o777)
            new_ordinary |= add_ordinary
            # Special bits always added
            if spec_setuid:
                new_special |= 0o4000
            if spec_setgid:
                new_special |= 0o2000
            if spec_sticky:
                new_special |= 0o1000
        else:
            new_ordinary |= spec_ordinary
            if spec_setuid:
                new_special |= 0o4000
            if spec_setgid:
                new_special |= 0o2000
            if spec_sticky:
                new_special |= 0o1000
        return (new_ordinary | new_special) & 0o7777

    elif op == '-':
        new_ordinary = mode & 0o777
        new_special = mode & 0o7000
        if who_omitted:
            # Only remove ordinary bits not protected by umask
            rem_ordinary = spec_ordinary & (~umask & 0o777)
            new_ordinary &= ~rem_ordinary
            # Special bits always removed
            if spec_setuid:
                new_special &= ~0o4000
            if spec_setgid:
                new_special &= ~0o2000
            if spec_sticky:
                new_special &= ~0o1000
        else:
            new_ordinary &= ~spec_ordinary
            if spec_setuid:
                new_special &= ~0o4000
            if spec_setgid:
                new_special &= ~0o2000
            if spec_sticky:
                new_special &= ~0o1000
        return (new_ordinary | new_special) & 0o7777

    else:  # op == '='
        # Set affected who's ordinary bits to exactly spec_ordinary
        # Preserve non-affected who's ordinary bits
        new_ordinary = 0
        if who_omitted:
            # All who are affected; filter by umask
            new_ordinary = spec_ordinary & (~umask & 0o777)
        else:
            for w in affected:
                for bit_fn in (_r_bit, _w_bit, _x_bit):
                    if bit_fn(w) & spec_ordinary:
                        new_ordinary |= bit_fn(w)
            for w in set('ugo') - affected:
                new_ordinary |= (mode & _rwx_mask(w))

        # Special bits for =
        new_special = 0
        # setuid: set if explicitly specified; otherwise preserved
        if spec_setuid:
            new_special |= 0o4000
        elif not (('s' in perms) and ('u' in affected)):
            # s not in perms at all, OR s in perms but u not in affected → preserved
            new_special |= (mode & 0o4000)
        # If s IS in perms and u IS in affected, setuid is explicitly set (handled above)
        # If s IS in perms but u NOT in affected, setuid is preserved (handled above)
        # If s NOT in perms, setuid is preserved (handled above)

        # setgid: set if explicitly specified; otherwise preserved
        if spec_setgid:
            new_special |= 0o2000
        elif not (('s' in perms) and ('g' in affected)):
            new_special |= (mode & 0o2000)

        # sticky: set if t in perms or (s in perms and o in affected); otherwise cleared
        if spec_sticky:
            new_special |= 0o1000
        # else: sticky is cleared (not preserved)

        return (new_ordinary | new_special) & 0o7777


def _apply_copy(op, who, who_omitted, source, mode, umask):
    """Apply a permission-copy clause (e.g., u+g, a=u)."""
    # Get source's rwx bits from current mode
    src_bits = mode & _rwx_mask(source)

    # Determine target bits to apply (map source's rwx to each target who's position)
    target_bits = 0
    for w in who:
        if 'r' and (src_bits & _r_bit(source)):
            target_bits |= _r_bit(w)
        if src_bits & _w_bit(source):
            target_bits |= _w_bit(w)
        if src_bits & _x_bit(source):
            target_bits |= _x_bit(w)

    if who_omitted:
        target_bits &= (~umask & 0o777)

    if op == '+':
        return (mode | target_bits) & 0o7777
    elif op == '-':
        return (mode & ~target_bits) & 0o7777
    else:  # '='
        # Clear all affected who's rwx, then set to target_bits
        clear_mask = 0
        for w in who:
            clear_mask |= _rwx_mask(w)
        new_ordinary = (mode & 0o777) & ~clear_mask | target_bits
        new_special = mode & 0o7000
        return (new_ordinary | new_special) & 0o7777


def _apply_clause(clause, mode, umask):
    """Apply one comma-separated clause. Returns new mode or None if invalid."""
    if not clause:
        return None

    # Find the operator (first occurrence of +, -, or =)
    op = None
    op_idx = -1
    for i, c in enumerate(clause):
        if c in '+-=':
            op = c
            op_idx = i
            break
    if op is None:
        return None

    who_str = clause[:op_idx]
    perms_str = clause[op_idx + 1:]

    # Parse who
    who = _parse_who(who_str)
    if who is None:
        return None
    who_omitted = (who_str == '')
    if who_omitted:
        who = set('ugo')

    # Parse perms
    if not perms_str:
        # Empty perms: valid for = (clears), no-op for + and -
        # But need at least who to be non-empty for it to make sense
        # Per spec: "Empty assignments clear selected ordinary permissions"
        # So empty perms is valid (it's an empty assignment)
        perms = set()
    elif len(perms_str) == 1 and perms_str in 'ugo':
        # Permission copy
        return _apply_copy(op, who, who_omitted, perms_str, mode, umask)
    else:
        valid_chars = set('rwxXst')
        if not set(perms_str).issubset(valid_chars):
            return None
        perms = set(perms_str)

    return _apply_regular(op, who, who_omitted, perms, mode, umask)


def _parse_mode(mode_str, umask):
    """Parse a mode string. Returns the mode as int, or None if invalid."""
    if not mode_str:
        return None

    # Try numeric (all octal digits)
    if all(c in '01234567' for c in mode_str):
        try:
            val = int(mode_str, 8)
        except ValueError:
            return None
        if val > 0o7777:
            return None
        return val & 0o7777

    # Symbolic mode
    # Starting mode: 0o777 masked by umask (the default directory mode)
    mode = 0o777 & ~umask

    clauses = mode_str.split(',')
    for clause in clauses:
        new_mode = _apply_clause(clause, mode, umask)
        if new_mode is None:
            return None
        mode = new_mode

    return mode


# --- Directory creation ---

def _create_dir(path, mode):
    """Create a single directory (no -p). mode is the exact desired mode,
    or None for default (0o777 masked by umask)."""
    try:
        if mode is None:
            os.mkdir(path, 0o777)
        else:
            os.mkdir(path, 0o777)
            os.chmod(path, mode)
        return 0
    except FileExistsError:
        _err(f"mkdir: cannot create directory '{path}': File exists")
        return 1
    except FileNotFoundError:
        _err(f"mkdir: cannot create directory '{path}': No such file or directory")
        return 1
    except PermissionError:
        _err(f"mkdir: cannot create directory '{path}': Permission denied")
        return 1
    except NotADirectoryError:
        _err(f"mkdir: cannot create directory '{path}': Not a directory")
        return 1
    except OSError as e:
        msg = e.strerror if e.strerror else (os.strerror(e.errno) if e.errno else "Unknown error")
        _err(f"mkdir: cannot create directory '{path}': {msg}")
        return 1


def _create_dir_p(path, umask, mode):
    """Create directory path with -p semantics. mode is the exact desired mode
    for the FINAL directory (None for default). Returns 0 or 1."""
    # Normalize: handle trailing slashes, dot components
    # Use os.path normalization but preserve the original for error messages
    normalized = path
    if not normalized.startswith('/'):
        # relative path
        parts = [p for p in normalized.split('/') if p and p != '.']
        if not parts:
            return 0
        normalized = '/'.join(parts)
    else:
        parts = [p for p in normalized.split('/') if p and p != '.']
        if not parts:
            return 0
        normalized = '/' + '/'.join(parts)

    is_absolute = normalized.startswith('/')
    comp_parts = [p for p in normalized.split('/') if p and p != '.']

    if not comp_parts:
        return 0

    current = ''
    for i, part in enumerate(comp_parts):
        if current:
            current = current + '/' + part
        else:
            current = ('/' if is_absolute else '') + part
            if is_absolute:
                current = '/' + part
            else:
                current = part

        is_last = (i == len(comp_parts) - 1)

        try:
            exists = os.path.lexists(current)
        except (OSError, ValueError):
            exists = False

        if exists:
            try:
                if os.path.isdir(current):
                    continue
            except (OSError, ValueError):
                pass
            _err(f"mkdir: cannot create directory '{path}': Not a directory")
            return 1

        # Create this component
        try:
            os.mkdir(current, 0o777)
        except FileExistsError:
            try:
                if os.path.isdir(current):
                    continue
            except (OSError, ValueError):
                pass
            _err(f"mkdir: cannot create directory '{path}': File exists")
            return 1
        except PermissionError:
            _err(f"mkdir: cannot create directory '{path}': Permission denied")
            return 1
        except FileNotFoundError:
            _err(f"mkdir: cannot create directory '{path}': No such file or directory")
            return 1
        except NotADirectoryError:
            _err(f"mkdir: cannot create directory '{path}': Not a directory")
            return 1
        except OSError as e:
            msg = e.strerror if e.strerror else (os.strerror(e.errno) if e.errno else "Unknown error")
            _err(f"mkdir: cannot create directory '{path}': {msg}")
            return 1

        if not is_last:
            # Intermediate: ensure owner write and search
            inter_mode = (0o777 & ~umask) | 0o300
            try:
                os.chmod(current, inter_mode)
            except OSError:
                pass
        else:
            # Final directory: apply the requested mode
            if mode is not None:
                try:
                    os.chmod(current, mode)
                except OSError:
                    pass
            # If mode is None, the default (0o777 & ~umask) is already set by the kernel

    return 0


def main() -> int:
    args = sys.argv[1:]
    operands = []
    after_dd = False
    parents = False
    mode_str = None

    i = 0
    while i < len(args):
