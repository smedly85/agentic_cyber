#!/usr/bin/env python3
"""mkdir - create directories"""
import os
import sys


def _err(msg: str) -> None:
    sys.stderr.write(msg + "\n")


def _get_umask() -> int:
    mask = os.umask(0)
    os.umask(mask)
    return mask


# --- Mode parsing ---

def _r_bit(who: str) -> int:
    return {'u': 0o400, 'g': 0o040, 'o': 0o004}[who]

def _w_bit(who: str) -> int:
    return {'u': 0o200, 'g': 0o020, 'o': 0o002}[who]

def _x_bit(who: str) -> int:
    return {'u': 0o100, 'g': 0o010, 'o': 0o001}[who]

def _rwx_mask(who: str) -> int:
    return _r_bit(who) | _w_bit(who) | _x_bit(who)


def _parse_who(who_str: str) -> set | None:
    """Parse the who part. Returns set of 'u','g','o' or None if invalid."""
    if not who_str:
        return set()  # empty means omitted
    if 'a' in who_str:
        return set('ugo')
    result = set()
    for c in who_str:
        if c in 'ugo':
            result.add(c)
        else:
            return None
    return result if result else None


def _parse_perms(perms_str: str) -> set | str | None:
    """Parse the perms part. Returns a set of permission chars, or a single
    char 'u'/'g'/'o' for copy, or None if invalid."""
    if not perms_str:
        return None
    # Permission copy: single u, g, or o
    if len(perms_str) == 1 and perms_str in 'ugo':
        return perms_str
    # Regular permissions
    valid = set('rwxXst')
    if not set(perms_str).issubset(valid):
        return None
    return set(perms_str)


def _apply_clause(clause: str, mode: int, umask: int) -> int | None:
    """Apply one clause to the mode. Returns new mode or None if invalid."""
    # Find operator
    op = None
    op_idx = -1
    for i, c in enumerate(clause):
        if c in '+-=':
            op = c
            op_idx = i
            break
    if op is None:
        return None
    
    who_str = clause[:op_idx]
    perms_str = clause[op_idx + 1:]
    
    who = _parse_who(who_str)
