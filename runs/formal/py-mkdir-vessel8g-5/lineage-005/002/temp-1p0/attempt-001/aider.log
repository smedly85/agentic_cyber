def _r_bit(w):
    return {'u': 0o400, 'g': 0o040, 'o': 0o004}[w]

def _w_bit(w):
    return {'u': 0o200, 'g': 0o020, 'o': 0o002}[w]

def _x_bit(w):
    return {'u': 0o100, 'g': 0o010, 'o': 0o001}[w]

