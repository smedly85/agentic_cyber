def _parse_clause(clause: str, mode: int, umask: int) -> int | None:
    # Find the operator
    op = None
    op_idx = -1
    for i, c in enumerate(clause):
        if c in '+-=':
            op = c
            op_idx = i
            break
    if op is None:
        return None  # invalid
    
    who_str = clause[:op_idx]
    perms_str = clause[op_idx+1:]
    
    if not perms_str:
        return None  # no permissions specified
    
    # Parse who
    if who_str == '':
        who_omitted = True
        who = None  # will be determined by umask for + and -
    else:
        who_omitted = False
        who = set()
        for c in who_str:
            if c in 'ugo':
                who.add(c)
            elif c == 'a':
                who = set('ugo')
                break
            else:
                return None  # invalid who character
        # If who_str has both 'a' and others, it's still just 'ugo'
        # Actually, in GNU, "ua" is the same as "a"
        # Let me handle this: if 'a' is in who_str, who = {u,g,o}
        if 'a' in who_str:
            who = set('ugo')
        else:
            who = set(c for c in who_str if c in 'ugo')
            if not who:
                return None
    
    # Parse permissions
    # Check if it's a permission copy (single u/g/o)
    if len(perms_str) == 1 and perms_str in 'ugo':
        # Permission copy
        return _apply_copy(op, who, who_omitted, perms_str, mode, umask)
    
    # Regular permissions
    perms = set(perms_str)
    # Validate
    valid_chars = set('rwxXst')
    if not perms.issubset(valid_chars):
        return None
    # X is only valid with = or + (not -)? Actually in GNU, X is valid with any op.
    # For mkdir (always directories), X == x
    
    return _apply_perms(op, who, who_omitted, perms, mode, umask)
```

