```python
def parse_symbolic_mode(mode_str: str, umask: int) -> tuple[int, bool]:
    """Parse a symbolic mode string. Returns (mode, valid)."""
    # Starting mode
    mode = 0o777 & ~umask
    
    # Split into clauses by comma
    clauses = mode_str.split(',')
    
    for clause in clauses:
        if not clause:
            return (0, False)  # empty clause is invalid
        result = apply_clause(clause, mode, umask)
        if result is None:
            return (0, False)
        mode = result
    
    return (mode, True)
```

