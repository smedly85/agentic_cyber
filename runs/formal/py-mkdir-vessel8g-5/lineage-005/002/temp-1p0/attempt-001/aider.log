```python
def _apply_perms(op, who, who_omitted, perms, mode, umask):
    # Determine which bits to affect
    # Ordinary bits: r(0o400), w(0o200), x(0o100) for each of u, g, o
    # Special bits: s (setuid 0o4000 for u, setgid 0o2000 for g), t (sticky 0o1000)
    
    # Map perms to bits for each who
    # r -> 0o400 (u), 0o40 (g), 0o4 (o)
    # w -> 0o200 (u), 0o20 (g), 0o2 (o)
    # x/X -> 0o100 (u), 0o10 (g), 0o1 (o)  [X == x for directories]
    # s -> 0o4000 (u), 0o2000 (g)
    # t -> 0o1000 (o, or a, or omitted)
    
    affected = set(who) if who else set('ugo')
    
    # Determine the bits to set/clear based on perms
    bits_to_affect = 0
    
    for p in perms:
        if p == 'r':
            for w in affected:
                bits_to_affect |= _r_bit(w)
        elif p == 'w':
            for w in affected:
                bits_to_affect |= _w_bit(w)
        elif p in 'xX':
            for w in affected:
                bits_to_affect |= _x_bit(w)
        elif p == 's':
            if 'u' in affected:
