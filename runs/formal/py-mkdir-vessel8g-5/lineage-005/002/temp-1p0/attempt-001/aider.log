def _copy_bits(mode: int, source: str, target: str) -> int:
    """Copy source's rwx bits to target's rwx position."""
    src_mask = _rwx_mask(source)
    tgt_mask = _rwx_mask(target)
    # For each of r, w, x: if source has it, set it in target
    result = 0
    for src_bit, tgt_bit in [(_r_bit(source), _r_bit(target)),
                             (_w_bit(source), _w_bit(target)),
                             (_x_bit(source), _x_bit(target))]:
        if mode & src_bit:
            result |= tgt_bit
    return result
```

