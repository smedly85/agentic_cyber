static char *read_line(FILE *fp, size_t *len_out) {
    size_t capacity = 4096;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;

    while (1) {
        int c = fgetc(fp);
        if (c == EOF) {
            if (ferror(fp)) {
                free(buf);
                return NULL;
            }
            break;
        }
        if (c == '\n') {
            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            char *new_buf = realloc(buf, new_cap);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    buf[len] = '\0';
    *len_out = len;
    return buf;
}

int main() {
    char *pattern = "test";
    size_t pat_len = strlen(pattern);
    
    size_t len;
    char *line;
    
    while ((line = read_line(stdin, &len)) != NULL) {
        printf("read line: '%s' (len=%zu)\n", line, len);
        if (pat_len == 0 || memmem(line, len, pattern, pat_len) != NULL) {
            fwrite(line, 1, len, stdout);
            putc('\n', stdout);
        }
        free(line);
    }
    
    return 0;
}
EOF
