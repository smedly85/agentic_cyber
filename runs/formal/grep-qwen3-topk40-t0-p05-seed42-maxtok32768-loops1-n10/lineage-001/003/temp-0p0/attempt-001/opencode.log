+            for (size_t i = 0; i < count; i++) free(names[i]);
+            free(names);
+            closedir(dp);
+            return -1;
+        }
+        strcpy(names[count], entry->d_name);
+        count++;
+    }
+    closedir(dp);
+
+    qsort(names, count, sizeof(char *), compare_names);
+
+    int result = 0;
+    for (size_t i = 0; i < count; i++) {
+        char *fullpath;
