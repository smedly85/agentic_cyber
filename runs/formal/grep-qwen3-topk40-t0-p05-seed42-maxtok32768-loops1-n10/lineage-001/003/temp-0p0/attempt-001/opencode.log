+        
+        if (count >= capacity) {
+            capacity = capacity ? capacity * 2 : 16;
+            char **new_names = realloc(names, capacity * sizeof(char *));
+            if (!new_names) {
+                for (size_t i = 0; i < count; i++) free(names[i]);
+                free(names);
+                closedir(dp);
+                return -1;
+            }
+            names = new_names;
+        }
+        
+        size_t len = strlen(entry->d_name);
