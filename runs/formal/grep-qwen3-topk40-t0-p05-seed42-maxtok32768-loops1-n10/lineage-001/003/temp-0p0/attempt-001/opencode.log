+            size_t dirlen = strlen(dirpath);
+            size_t namelen = strlen(names[i]);
+            fullpath = malloc(dirlen + namelen + 1);
+            if (!fullpath) {
+                result = -1;
+                break;
+            }
+            strcpy(fullpath, dirpath);
+            strcat(fullpath, names[i]);
+        } else {
+            size_t dirlen = strlen(dirpath);
+            size_t namelen = strlen(names[i]);
+            fullpath = malloc(dirlen + 1 + namelen + 1);
+            if (!fullpath) {
+                result = -1;
