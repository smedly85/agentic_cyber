#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define INITIAL_LINE_CAPACITY 256

typedef struct {
    char *data;
    size_t len;
    size_t capacity;
} LineBuffer;

static bool line_buffer_init(LineBuffer *buf) {
    buf->data = malloc(INITIAL_LINE_CAPACITY);
    if (!buf->data) return false;
    buf->len = 0;
    buf->capacity = INITIAL_LINE_CAPACITY;
    fprintf(stderr, "DEBUG: buffer init at %p\n", (void*)buf->data);
    return true;
}

static void line_buffer_free(LineBuffer *buf) {
    free(buf->data);
}

static bool line_buffer_grow(LineBuffer *buf, size_t needed) {
    size_t new_cap = buf->capacity;
    while (new_cap - buf->len < needed) {
        if (new_cap > SIZE_MAX / 2) return false;
        new_cap *= 2;
    }
    char *new_data = realloc(buf->data, new_cap);
    if (!new_data) return false;
    buf->data = new_data;
    buf->capacity = new_cap;
    fprintf(stderr, "DEBUG: buffer grown to %zu at %p\n", new_cap, (void*)buf->data);
    return true;
}

static int read_line(LineBuffer *buf, FILE *fp) {
    fprintf(stderr, "DEBUG: read_line start, len=%zu, cap=%zu\n", buf->len, buf->capacity);
    buf->len = 0;
    
    for (;;) {
        int c = fgetc(fp);
        fprintf(stderr, "DEBUG: fgetc returned %d\n", c);
        if (c == EOF) {
            if (ferror(fp)) return -1;
            if (buf->len == 0) return 0;
            break;
        }
        
        if (c == '\n') break;
        
        if (buf->len + 1 >= buf->capacity) {
            fprintf(stderr, "DEBUG: need to grow\n");
            if (!line_buffer_grow(buf, 1)) return -2;
        }
        buf->data[buf->len++] = (char)c;
        fprintf(stderr, "DEBUG: stored char %c at pos %zu\n", c, buf->len-1);
    }
    
    if (buf->len + 1 >= buf->capacity) {
        if (!line_buffer_grow(buf, 1)) return -2;
    }
    buf->data[buf->len] = '\0';
    fprintf(stderr, "DEBUG: read_line done, len=%zu\n", buf->len);
    return 1;
}

static bool pattern_matches(const char *pattern, size_t pat_len,
                            const char *line, size_t line_len) {
    fprintf(stderr, "DEBUG: pattern_matches pat_len=%zu, line_len=%zu\n", pat_len, line_len);
    if (pat_len == 0) return true;
    if (pat_len > line_len) return false;
    
    for (size_t i = 0; i <= line_len - pat_len; i++) {
        bool match = true;
        for (size_t j = 0; j < pat_len; j++) {
            if (line[i + j] != pattern[j]) {
                match = false;
                break;
            }
        }
        if (match) return true;
    }
    return false;
}

static void write_line(const char *line, size_t len) {
    fprintf(stderr, "DEBUG: write_line len=%zu\n", len);
    fwrite(line, 1, len, stdout);
    fputc('\n', stdout);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: new_grep PATTERN [FILE...]\n");
        return 2;
    }
    
    const char *pattern = argv[1];
    size_t pat_len = strlen(pattern);
    fprintf(stderr, "DEBUG: pattern='%s', pat_len=%zu\n", pattern, pat_len);
    
    LineBuffer line_buf;
    if (!line_buffer_init(&line_buf)) {
        fprintf(stderr, "Memory allocation failed\n");
        return 2;
    }
    
    for (;;) {
        int result = read_line(&line_buf, stdin);
        fprintf(stderr, "DEBUG: read_line returned %d\n", result);
        if (result < 0) {
            fprintf(stderr, "Error reading input\n");
            break;
        }
        if (result == 0) break;
        
        fprintf(stderr, "DEBUG: checking match, line='%s'\n", line_buf.data);
        if (pattern_matches(pattern, pat_len, line_buf.data, line_buf.len)) {
            write_line(line_buf.data, line_buf.len);
        }
    }
    
    line_buffer_free(&line_buf);
    return 0;
}
