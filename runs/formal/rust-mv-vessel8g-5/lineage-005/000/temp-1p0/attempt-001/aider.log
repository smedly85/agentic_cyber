```rust
use std::ffi::OsStr;
use std::fs;
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::MetadataExt;
use std::path::{Path, PathBuf};
use std::process;

fn main() {
    let args: Vec<std::ffi::OsString> = std::env::args_os().skip(1).collect();
    
    // Parse: find -- separator, identify options and operands
    let mut operands: Vec<std::ffi::OsString> = Vec::new();
    let mut seen_separator = false;
    
    for arg in &args {
        if !seen_separator && arg == "--" {
            seen_separator = true;
            continue;
        }
        if !seen_separator {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                // Unknown option
                eprintln!("mv: unrecognized option: {}", arg.to_string_lossy());
                process::exit(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("mv: missing destination operand");
        process::exit(1);
    }
    
    // Determine mode: single source or multi-source
    let last = operands.last().unwrap();
    let last_path = Path::new(last);
    
    let is_multi = operands.len() > 2;
    
    if is_multi {
        // Last must be an existing directory
        let meta = match fs::symlink_metadata(last_path) {
            Ok(m) => m,
            Err(e) => {
                eprintln!("mv: cannot stat {}: {}", last.to_string_lossy(), e);
                process::exit(1);
            }
        };
        if !meta.is_dir() {
            eprintln!("mv: target {}: not a directory", last.to_string_lossy());
            process::exit(1);
        }
    }
    
    // For each source, determine the effective destination
    // and validate before making any changes
    
    let sources: Vec<(PathBuf, PathBuf)> = if is_multi {
        let dir = PathBuf::from(last);
        let srcs: Vec<&std::ffi::OsString> = &operands[..operands.len() - 1];
        srcs.iter().map(|src| {
            let src_path = PathBuf::from(src);
            let base = src_path.file_name().unwrap_or_else(|| src_path.as_os_str());
            let dest = dir.join(base);
            (src_path, dest)
        }).collect()
    } else {
        let src = PathBuf::from(&operands[0]);
        let dest = PathBuf::from(&operands[1]);
        let dest_meta = fs::symlink_metadata(&dest);
        
        if dest_meta.as_ref().map(|m| m.is_dir()).unwrap_or(false) {
            let base = src.file_name().unwrap_or_else(|| src.as_os_str());
            (src, dest.join(base))
        } else {
            (src, dest)
        }
    };
    
    // Validate all before making changes
    for (src, dest) in &sources {
        // Check source exists
        let src_meta = match fs::symlink_metadata(src) {
            Ok(m) => m,
            Err(e) => {
                eprintln!("mv: cannot stat {}: {}", src.to_string_lossy(), e);
                process::exit(1);
            }
        };
        
        // Check identical source/destination
        let src_real = fs::canonicalize(src);
        let dest_real = fs::canonicalize(dest);
        if let (Ok(sr), Ok(dr)) = (&src_real, &dest_real) {
            if sr == dr {
                eprintln!("mv: '{}' and '{}' are the same file", src.to_string_lossy(), dest.to_string_lossy());
                process::exit(1);
            }
        }
        
        // Check type compatibility
        let dest_exists = fs::symlink_metadata(dest).is_ok();
        if dest_exists {
            let dest_meta = fs::symlink_metadata(dest).unwrap();
            if src_meta.is_dir() {
                if !dest_meta.is_dir() {
                    eprintln!("mv: cannot move directory '{}' to non-directory '{}'", src.to_string_lossy(), dest.to_string_lossy());
                    process::exit(1);
                }
                // dest is a directory: check if empty
                let mut entries = fs::read_dir(dest).unwrap();
                if entries.next().is_some() {
                    eprintln!("mv: cannot move directory '{}' into non-empty directory '{}'", src.to_string_lossy(), dest.to_string_lossy());
                    process::exit(1);
                }
            } else {
                if dest_meta.is_dir() {
                    eprintln!("mv: cannot replace directory '{}' with non-directory '{}'", dest.to_string_lossy(), src.to_string_lossy());
                    process::exit(1);
                }
            }
        }
        
        // Check directory into itself
        if src_meta.is_dir() {
            if let Ok(src_real) = fs::canonicalize(src) {
                // Check if dest is inside src
                let dest_check = if dest.exists() {
                    fs::canonicalize(dest)
                } else {
                    // Check parent
                    fs::canonicalize(dest.parent().unwrap_or(Path::new(".")))
                };
                if let Ok(dc) = dest_check {
                    if dc.starts_with(&src_real) {
                        eprintln!("mv: cannot move directory '{}' into itself or a subdirectory thereof", src.to_string_lossy());
                        process::exit(1);
                    }
                }
            }
        }
    }
    
    // Execute moves
    let mut had_error = false;
    for (src, dest) in &sources {
        if let Err(e) = move_path(src, dest) {
            eprintln!("mv: cannot move '{}' to '{}': {}", src.to_string_lossy(), dest.to_string_lossy(), e);
            had_error = true;
        }
    }
    
    if had_error {
        process::exit(1);
    }
}

fn move_path(source: &Path, destination: &Path) -> std::io::Result<()> {
    fs::rename(source, destination)
}
```

