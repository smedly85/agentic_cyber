use std::ffi::OsString;
use std::fs;
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process;

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let mut operands: Vec<OsString> = Vec::new();
    let mut after_separator = false;

    for arg in &args {
        if !after_separator {
            if arg.as_bytes() == b"--" {
                after_separator = true;
                continue;
            }
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                eprintln!(
                    "mv: unrecognized option: {}",
                    String::from_utf8_lossy(bytes)
                );
                process::exit(1);
            }
        }
        operands.push(arg.clone());
    }

    if operands.len() < 2 {
        eprintln!("mv: missing destination");
        process::exit(1);
    }

    let is_multi = operands.len() > 2;

    if is_multi {
        let last = Path::new(operands.last().unwrap());
        match fs::symlink_metadata(last) {
            Ok(m) if m.is_dir() => {}
            Ok(_) => {
                eprintln!("mv: target '{}': not a directory", last.to_string_lossy());
                process::exit(1);
            }
            Err(e) => {
                eprintln!(
                    "mv: cannot access '{}': {}",
                    last.to_string_lossy(),
                    e
                );
                process::exit(1);
            }
        }
    }

    let mut moves: Vec<(PathBuf, PathBuf)> = Vec::new();

    if is_multi {
        let dir = Path::new(operands.last().unwrap());
        for src in &operands[..operands.len() - 1] {
            let src_path = PathBuf::from(src);
            let base = src_path.file_name().unwrap_or(src.as_os_str());
            moves.push((src_path, dir.join(base)));
        }
    } else {
        let src = PathBuf::from(&operands[0]);
        let dest_raw = PathBuf::from(&operands[1]);
        let dest = if fs::symlink_metadata(&dest_raw)
            .map(|m| m.is_dir())
            .unwrap_or(false)
        {
            let base = src.file_name().unwrap_or(src.as_os_str());
            dest_raw.join(base)
        } else {
            dest_raw
        };
        moves.push((src, dest));
    }

    let mut had_error = false;

    for (src, dest) in &moves {
        if let Err(detail) = validate_and_move(src, dest) {
            eprintln!("mv: {}", detail);
            had_error = true;
        }
    }

    if had_error {
        process::exit(1);
    }
}

fn validate_and_move(src: &Path, dest: &Path) -> Result<(), String> {
    let src_meta = fs::symlink_metadata(src)
        .map_err(|e| format!("cannot stat '{}': {}", src.to_string_lossy(), e))?;

    if let (Ok(sr), Ok(dr)) = (fs::canonicalize(src), fs::canonicalize(dest)) {
        if sr == dr {
            return Err(format!(
                "'{}' and '{}' are the same file",
                src.to_string_lossy(),
                dest.to_string_lossy()
            ));
        }
    }

    if let Ok(dest_meta) = fs::symlink_metadata(dest) {
        if src_meta.is_dir() {
            if !dest_meta.is_dir() {
                return Err(format!(
                    "cannot move directory '{}' to non-directory '{}'",
                    src.to_string_lossy(),
                    dest.to_string_lossy()
                ));
            }
            match fs::read_dir(dest) {
                Ok(mut rd) => {
                    if rd.next().is_some() {
                        return Err(format!(
                            "cannot move directory '{}' into non-empty directory '{}'",
                            src.to_string_lossy(),
                            dest.to_string_lossy()
                        ));
                    }
                }
                Err(e) => {
                    return Err(format!(
                        "cannot read directory '{}': {}",
                        dest.to_string_lossy(),
                        e
                    ));
                }
            }
        } else if dest_meta.is_dir() {
            return Err(format!(
                "cannot replace directory '{}' with non-directory '{}'",
                dest.to_string_lossy(),
                src.to_string_lossy()
            ));
        }
    }

    if src_meta.is_dir() {
        let src_real = fs::canonicalize(src)
            .map_err(|e| format!("cannot resolve '{}': {}", src.to_string_lossy(), e))?;
        let dest_ref = if dest.exists() {
            fs::canonicalize(dest)
                .map_err(|e| format!("cannot resolve '{}': {}", dest.to_string_lossy(), e))?
        } else {
            let parent = dest.parent().unwrap_or_else(|| Path::new("."));
            fs::canonicalize(parent).map_err(|e| {
                format!(
                    "cannot resolve '{}': {}",
                    parent.to_string_lossy(),
                    e
                )
            })?
        };
        if dest_ref.starts_with(&src_real) {
            return Err(format!(
                "cannot move directory '{}' into itself or a subdirectory thereof",
                src.to_string_lossy()
            ));
        }
    }

    move_path(src, dest).map_err(|e| {
        format!(
            "cannot move '{}' to '{}': {}",
            src.to_string_lossy(),
            dest.to_string_lossy(),
            e
        )
    })
}

fn move_path(source: &Path, destination: &Path) -> std::io::Result<()> {
    fs::rename(source, destination)
}
