fn find_existing_ancestor(path: &Path) -> Option<PathBuf> {
    let mut current = path.to_path_buf();
    while current.as_os_str().len() > 0 {
        if current.exists() || current.symlink_metadata().is_ok() {
            if let Ok(canon) = fs::canonicalize(&current) {
                return Some(canon);
            }
        }
        current = current.parent()?.to_path_buf();
