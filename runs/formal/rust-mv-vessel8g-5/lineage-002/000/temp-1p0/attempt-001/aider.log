fn check_into_itself(source: &Path, dest: &Path) -> Result<(), String> {
    if let Ok(src_canon) = fs::canonicalize(source) {
        // Try to find a canonical form of dest
        if let Ok(dst_canon) = fs::canonicalize(dest) {
            if dst_canon == src_canon {
                return Err(format!("'{}' and '{}' are the same file", source.display(), destination.display()));
            }
            if dst_canon.starts_with(&src_canon) {
                return Err(format!("cannot move '{}' into a subdirectory of itself", source.display()));
            }
            return Ok(());
