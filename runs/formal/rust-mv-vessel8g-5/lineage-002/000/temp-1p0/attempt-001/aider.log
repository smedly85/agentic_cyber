```rust
use std::ffi::{OsStr, OsString};
use std::fs;
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().collect();
    
    // Parse arguments
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in args.iter().skip(1) {
        if !after_ddash {
            if arg == OsStr::new("--") {
                after_ddash = true;
                continue;
            }
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                eprintln!("rust_mv: unknown option '--{}'", 
                    String::from_utf8_lossy(&bytes[1..]));
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("rust_mv: missing operand(s)");
        return ExitCode::from(1);
    }
    
    // Determine source-destination pairs
    let n = operands.len();
    let pairs: Vec<(PathBuf, PathBuf)>;
    
    if n == 2 {
        let source = &operands[0];
        let dest = &operands[1];
        
        // Check if dest is an existing directory
        let effective_dest = if let Ok(meta) = fs::symlink_metadata(dest) {
            if meta.is_dir() {
                let base = source.file_name().unwrap_or(OsStr::new("."));
                dest.join(base)
            } else {
                dest.clone()
            }
        } else {
            dest.clone()
        };
        
        pairs = vec![(source.clone(), effective_dest)];
    } else {
        // Multi-source: last operand must be an existing directory
        let dir = &operands[n - 1];
        match fs::symlink_metadata(dir) {
            Ok(meta) if meta.is_dir() => {}
            _ => {
                eprintln!("rust_mv: target '{}' is not a directory", 
                    dir.to_string_lossy());
                return ExitCode::from(1);
            }
        }
        
        pairs = (0..n - 1).map(|i| {
            let source = &operands[i];
            let base = source.file_name().unwrap_or(OsStr::new("."));
            (source.clone(), dir.join(base))
        }).collect();
    }
    
    // Perform moves
    let mut any_failed = false;
    for (source, dest) in &pairs {
        if let Err(msg) = move_path(source, dest) {
            eprintln!("rust_mv: {}", msg);
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn move_path(source: &Path, destination: &Path) -> Result<(), String> {
    // Source must exist
    let src_meta = fs::symlink_metadata(source)
        .map_err(|e| format!("cannot stat '{}': {}", source.display(), e))?;
    
    let src_is_dir = src_meta.is_dir();
    
    // Check destination
    match fs::symlink_metadata(destination) {
        Ok(dst_meta) => {
            let dst_is_dir = dst_meta.is_dir();
            
            // Identity check
            if let (Ok(src_canon), Ok(dst_canon)) = 
                (fs::canonicalize(source), fs::canonicalize(destination)) {
                if src_canon == dst_canon {
                    return Err(format!("'{}' and '{}' are the same file", 
                        source.display(), destination.display()));
                }
                if src_is_dir && dst_canon.starts_with(&src_canon) {
                    return Err(format!(
                        "cannot move '{}' into a subdirectory of itself", 
                        source.display()));
                }
            }
            
            // Type compatibility
            if !src_is_dir && dst_is_dir {
                return Err(format!(
                    "cannot overwrite directory '{}' with non-directory '{}'",
                    destination.display(), source.display()));
            }
            if src_is_dir && !dst_is_dir {
                return Err(format!(
                    "cannot overwrite non-directory '{}' with directory '{}'",
                    destination.display(), source.display()));
            }
            if src_is_dir && dst_is_dir {
                // Check if dest is nonempty
                let mut reader = fs::read_dir(destination)
                    .map_err(|e| format!("cannot read directory '{}': {}", 
                        destination.display(), e))?;
                if reader.next().is_some() {
                    return Err(format!("target '{}' is a non-empty directory", 
                        destination.display()));
                }
            }
        }
        Err(_) => {
            // Destination doesn't exist
            // Still check "into itself" for directories
            if src_is_dir {
                if let Ok(src_canon) = fs::canonicalize(source) {
                    // Walk up to find an existing ancestor of destination
                    let mut ancestor = destination.to_path_buf();
                    while ancestor.as_os_str().len() > 0 {
                        if let Ok(a_canon) = fs::canonicalize(&ancestor) {
                            if a_canon == src_canon || a_canon.starts_with(&src_canon) {
                                return Err(format!(
                                    "cannot move '{}' into a subdirectory of itself",
                                    source.display()));
                            }
                            break;
                        }
                        ancestor = ancestor.parent()
                            .map(|p| p.to_path_buf())
                            .unwrap_or_default();
                    }
                }
            }
        }
    }
    
    // Perform the move
    fs::rename(source, destination)
        .map_err(|e| format!("cannot move '{}' to '{}': {}", 
            source.display(), destination.display(), e))?;
    
    Ok(())
}
```

