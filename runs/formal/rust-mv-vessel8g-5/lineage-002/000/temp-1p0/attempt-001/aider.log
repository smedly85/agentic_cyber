```rust
use std::ffi::OsStr;
use std::fs;
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().collect();
    
    // Parse: split at --, check for unknown options
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in args.iter().skip(1) {
        if !after_ddash && arg == OsStr::new("--") {
            after_ddash = true;
            continue;
        }
        if !after_ddash {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                // Unknown option
                eprintln!("rust_mv: unknown option: {}", arg.to_string_lossy());
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    // Need at least 2 operands
    if operands.len() < 2 {
        eprintln!("rust_mv: missing destination operand");
        return ExitCode::from(1);
    }
    
    // Determine sources and effective destinations
    let n = operands.len();
    let (sources, destinations): (Vec<&OsStr>, Vec<OsString>) = if n == 2 {
        let source = &operands[0];
        let dest = &operands[1];
        // If dest is an existing directory, effective dest is dest/basename(source)
        let metadata = fs::symlink_metadata(dest);
        if let Ok(m) = metadata {
            if m.is_dir() {
                let base = source.file_name().unwrap_or(OsStr::new("."));
                let effective = dest.join(base);
                (vec![source], vec![effective])
            } else {
                (vec![source], vec![dest.clone()])
            }
        } else {
            // dest doesn't exist, use as-is
            (vec![source], vec![dest.clone()])
        }
    } else {
        // Multi-source: last operand must be existing directory
        let dir = &operands[n - 1];
        match fs::symlink_metadata(dir) {
            Ok(m) if m.is_dir() => {}
            _ => {
                eprintln!("rust_mv: target '{}' is not a directory", dir.to_string_lossy());
                return ExitCode::from(1);
            }
        }
        let mut srcs = Vec::new();
        let mut dsts = Vec::new();
        for i in 0..n - 1 {
            let source = &operands[i];
            let base = source.file_name().unwrap_or(OsStr::new("."));
            let effective = dir.join(base);
            srcs.push(source);
            dsts.push(effective);
        }
        (srcs, dsts)
    };
    
    // Now perform moves
    let mut any_failed = false;
    for (source, dest) in sources.iter().zip(destinations.iter()) {
        if let Err(e) = move_path(Path::new(source), Path::new(dest)) {
            eprintln!("rust_mv: {}", e);
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn move_path(source: &Path, destination: &Path) -> Result<(), String> {
    // Check source exists
    let src_meta = fs::symlink_metadata(source)
        .map_err(|e| format!("cannot stat '{}': {}", source.display(), e))?;
    
    let src_is_dir = src_meta.is_dir();
    
    // Check destination
    let dst_meta = fs::symlink_metadata(destination);
    
    match dst_meta {
        Ok(dm) => {
            let dst_is_dir = dm.is_dir();
            
            // Identical check
            // Try to canonicalize both
            if let (Ok(src_canon), Ok(dst_canon)) = (fs::canonicalize(source), fs::canonicalize(destination)) {
                if src_canon == dst_canon {
                    return Err(format!("'{}' and '{}' are the same file", source.display(), destination.display()));
                }
                // Directory into itself check
                if src_is_dir && dst_canon.starts_with(&src_canon) && dst_canon != src_canon {
                    return Err(format!("cannot move '{}' into a subdirectory of itself", source.display()));
                }
            }
            
            // Type compatibility
            if src_is_dir && !dst_is_dir {
                return Err(format!("cannot overwrite non-directory '{}' with directory '{}'", destination.display(), source.display()));
            }
            if !src_is_dir && dst_is_dir {
                return Err(format!("cannot overwrite directory '{}' with non-directory '{}'", destination.display(), source.display()));
            }
            // Directory into nonempty directory
            if src_is_dir && dst_is_dir {
                // Check if dest is nonempty
                // (If it were empty, rename would succeed)
                let mut entries = fs::read_dir(destination)
                    .map_err(|e| format!("cannot read directory '{}': {}", destination.display(), e))?;
                if entries.next().is_some() {
                    return Err(format!("target '{}' is a non-empty directory", destination.display()));
                }
            }
        }
        Err(_) => {
            // Destination doesn't exist - check if parent exists
            // (rename will naturally fail with a clear error)
            // But we should check "directory into itself" even when dest doesn't exist
            if src_is_dir {
                if let Ok(src_canon) = fs::canonicalize(source) {
                    // Check if destination is lexically inside source
                    // We can try to canonicalize the parent
                    if let Some(parent) = destination.parent() {
                        if !parent.as_os_str().is_empty() {
                            if let Ok(parent_canon) = fs::canonicalize(parent) {
                                if parent_canon == src_canon || parent_canon.starts_with(&src_canon) {
                                    return Err(format!("cannot move '{}' into a subdirectory of itself", source.display()));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Perform the rename
    fs::rename(source, destination)
        .map_err(|e| format!("cannot move '{}' to '{}': {}", source.display(), destination.display(), e))?;
    
    Ok(())
}
```

