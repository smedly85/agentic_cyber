```rust
use std::ffi::OsString;
use std::io;
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse: separate options from operands
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if !after_ddash {
            if arg == OsString::from("--") {
                after_ddash = true;
                continue;
            }
            if arg == OsString::from("-") {
                operands.push(arg.clone());
                continue;
            }
            let bytes = arg.as_bytes();
            if bytes.first() == Some(&b'-') && bytes.len() > 1 {
                eprintln!("rust_mv: unknown option: {}", arg.to_string_lossy());
                std::process::exit(1);
            }
        }
        operands.push(arg.clone());
    }
    
    // Validate operand count
    if operands.len() < 2 {
        eprintln!("rust_mv: missing operand");
        std::process::exit(1);
    }
    
    // Determine sources and destination
    let sources: Vec<OsString>;
    let dest: OsString;
    let dest_is_dir_mode: bool; // true if we're in "multiple sources" mode
    
    if operands.len() == 2 {
        sources = vec![operands[0].clone()];
        dest = operands[1].clone();
        dest_is_dir_mode = false;
    } else {
        dest = operands[operands.len() - 1].clone();
        // Invocation-wide: last must be an existing directory
        if !Path::new(&dest).is_dir() {
            eprintln!("rust_mv: target '{}' is not a directory", dest.to_string_lossy());
            std::process::exit(1);
        }
        sources = operands[..operands.len() - 1].to_vec();
        dest_is_dir_mode = true;
    }
    
    let mut any_failed = false;
    
    for source in &sources {
        let source_path = Path::new(source);
        
        // Compute effective destination
        let effective_dest: PathBuf;
        if dest_is_dir_mode {
            let basename = source_path.file_name().unwrap_or(source.as_os_str());
            effective_dest = Path::new(&dest).join(basename);
        } else {
            // Single source: check if dest is a directory (follow symlinks)
            let dest_path = Path::new(&dest);
            let dest_is_dir = dest_path.is_dir(); // follows symlinks
            if dest_is_dir {
                let basename = source_path.file_name().unwrap_or(source.as_os_str());
                effective_dest = dest_path.join(basename);
            } else {
                effective_dest = dest_path.to_path_buf();
            }
        }
        
        // Perform the move
        match move_path(source_path, &effective_dest) {
            Ok(()) => {}
            Err(e) => {
                eprintln!("rust_mv: cannot move '{}' to '{}': {}",
                    source.to_string_lossy(),
                    effective_dest.to_string_lossy(),
                    e);
                any_failed = true;
            }
        }
    }
    
    if any_failed {
        std::process::exit(1);
    }
}

fn move_path(source: &Path, destination: &Path) -> io::Result<()> {
    // Source must exist
    let src_meta = std::fs::symlink_metadata(source)
        .map_err(|e| io::Error::new(io::ErrorKind::NotFound, 
            format!("cannot stat '{}': {}", source.to_string_lossy(), e)))?;
    
    let src_is_dir = src_meta.file_type().is_dir();
    
    // Check if destination exists
    let dest_meta = std::fs::symlink_metadata(destination).ok();
    
    if let Some(dest_meta) = &dest_meta {
        // Identical check (same inode)
        if src_meta.dev() == dest_meta.dev() && src_meta.ino() == dest_meta.ino() {
            return Err(io::Error::new(io::ErrorKind::Other,
                format!("'{}' and '{}' are the same file", 
                    source.to_string_lossy(), destination.to_string_lossy())));
        }
        
        let dest_is_dir = dest_meta.file_type().is_dir();
        
        // Type compatibility
        if src_is_dir && !dest_is_dir {
            return Err(io::Error::new(io::ErrorKind::Other,
                format!("cannot move directory '{}' to non-directory '{}'",
                    source.to_string_lossy(), destination.to_string_lossy())));
        }
        if !src_is_dir && dest_is_dir {
            return Err(io::Error::new(io::ErrorKind::Other,
                format!("cannot move non-directory '{}' to directory '{}'",
                    source.to_string_lossy(), destination.to_string_lossy())));
        }
        
        // Both directories: check empty
        if src_is_dir && dest_is_dir {
            let mut read_dir = std::fs::read_dir(destination)?;
            if read_dir.next().is_some() {
                return Err(io::Error::new(io::ErrorKind::Other,
                    format!("directory '{}' is not empty", destination.to_string_lossy())));
            }
        }
    }
    
    // Into-self check (only if source is a directory)
    if src_is_dir && is_proper_ancestor(source, destination) {
        return Err(io::Error::new(io::ErrorKind::Other,
            format!("cannot move directory '{}' into itself", source.to_string_lossy())));
    }
    
    // Perform the rename
    std::fs::rename(source, destination)
}

fn is_proper_ancestor(ancestor: &Path, descendant: &Path) -> bool {
    let a = normalize_components(ancestor);
    let d = normalize_components(descendant);
    if a.is_empty() || d.len() <= a.len() {
        return false;
    }
    d[..a.len()] == a
}

fn normalize_components(p: &Path) -> Vec<OsString> {
    let mut result: Vec<OsString> = Vec::new();
    for component in p.components() {
        match component {
            std::path::Component::CurDir => {}
            std::path::Component::ParentDir => {
                if !result.is_empty() {
                    result.pop();
                }
            }
            other => result.push(other.as_os_str().to_owned()),
        }
    }
    result
}
```

