```rust
fn is_proper_descendant(parent: &Path, child: &Path) -> bool {
    let p = normalize_path(parent);
    let c = normalize_path(child);
    if p.is_empty() { return false; }
    if c.len() <= p.len() { return false; }
    c[..p.len()] == p
}
```

