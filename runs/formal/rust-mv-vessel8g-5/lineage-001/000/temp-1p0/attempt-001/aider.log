fn normalize_path(p: &Path) -> Vec<std::ffi::OsString> {
    let mut result = Vec::new();
    for component in p.components() {
        match component {
            std::path::Component::CurDir => {}
            std::path::Component::ParentDir => {
                result.pop();
            }
            other => result.push(other.as_os_str().to_owned()),
        }
    }
    result
}
```

