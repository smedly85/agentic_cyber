use std::ffi::{OsStr, OsString};
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

/// Core filesystem move: renames src to dst atomically.
fn move_path(src: &Path, dst: &Path) -> std::io::Result<()> {
    std::fs::rename(src, dst)
}

/// Returns true if `path` exists and is a directory (following symlinks).
fn is_directory(path: &Path) -> bool {
    match path.metadata() {
        Ok(m) => m.is_dir(),
        Err(_) => false,
    }
}

/// Returns true if `path` exists and is a symlink.
fn is_symlink(path: &Path) -> bool {
    match path.symlink_metadata() {
        Ok(m) => m.file_type().is_symlink(),
        Err(_) => false,
    }
}

/// Check if `child` is the same as or a descendant of `parent` (lexically).
fn is_same_or_descendant(parent: &Path, child: &Path) -> bool {
    let p = parent.as_os_str().as_bytes();
    let c = child.as_os_str().as_bytes();
    if c.len() < p.len() {
        return false;
    }
    if c.len() == p.len() {
        return c == p;
    }
    c[..p.len()] == p && c[p.len()] == b'/'
}

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Phase 1: Parse arguments, separating options from operands.
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if !after_ddash {
            let bytes = arg.as_bytes();
            if bytes == b"--" {
                after_ddash = true;
                continue;
            }
            if bytes.len() > 1 && bytes[0] == b'-' {
                eprintln!(
                    "error: unknown option '{}'",
                    arg.to_string_lossy()
                );
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    // Phase 2: Validate operand count and multi-source destination.
    if operands.len() < 2 {
        eprintln!("error: missing operand");
        return ExitCode::from(1);
    }
    
    let multi_source = operands.len() > 2;
    
    if multi_source {
        let dir = Path::new(&operands[operands.len() - 1]);
        if !is_directory(dir) {
            eprintln!(
                "error: '{}' is not a directory",
                dir.to_string_lossy()
            );
            return ExitCode::from(1);
        }
    }
    
    // Phase 3: Process each source.
    let mut any_failed = false;
    let source_count = if multi_source { operands.len() - 1 } else { 1 };
    let dest_arg = if multi_source {
        Some(Path::new(&operands[operands.len() - 1]))
    } else {
        Some(Path::new(&operands[1]))
    };
    
    for i in 0..source_count {
        let src = Path::new(&operands[i]);
        
        // Determine effective destination
        let dst: PathBuf = if multi_source {
            // dest is guaranteed to be a directory
            let dest = dest_arg.as_ref().unwrap();
            match src.file_name() {
                Some(basename) => dest.join(basename),
                None => {
                    eprintln!("error: cannot determine basename for '{}'", src.to_string_lossy());
                    any_failed = true;
                    continue;
                }
            }
        } else {
            let dest = dest_arg.as_ref().unwrap();
            if is_directory(dest) {
                match src.file_name() {
                    Some(basename) => dest.join(basename),
                    None => {
                        eprintln!("error: cannot determine basename for '{}'", src.to_string_lossy());
                        any_failed = true;
                        continue;
                    }
                }
            } else {
                dest.to_path_buf()
            }
        };
        
        // Check and perform the move
        match perform_move(src, &dst) {
            Ok(()) => {}
            Err(msg) => {
                eprintln!("error: {}", msg);
                any_failed = true;
            }
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn perform_move(src: &Path, dst: &Path) -> Result<(), String> {
    // 1. Check source exists
    let src_meta = match src.symlink_metadata() {
        Ok(m) => m,
        Err(e) => return Err(format!("'{}': {}", src.to_string_lossy(), describe_io_error(&e, "no such file or directory"))),
    };
    
    let src_is_dir = src_meta.is_dir();
    let src_is_symlink = src_meta.file_type().is_symlink();
    
    // 2. Check identical source and destination
    // Use canonicalize if both exist; otherwise fall back to textual comparison
    let same_path = if src.as_os_str() == dst.as_os_str() {
        true
    } else {
        match (std::fs::canonicalize(src), std::fs::canonicalize(dst)) {
            (Ok(cs), Ok(cd)) => cs == cd,
            _ => false,
        }
    };
    if same_path {
        return Err(format!(
            "error: '{}' and '{}' are the same file",
            src.to_string_lossy(),
            dst.to_string_lossy()
        ));
    }
    
    // 3. If source is a directory, check destination is not a descendant
    if src_is_dir {
        if is_same_or_descendant(src, dst) && src.as_os_str() != dst.as_os_str() {
            return Err(format!(
                "error: cannot move directory '{}' into itself or its subdirectory '{}'",
                src.to_string_lossy(),
                dst.to_string_lossy()
            ));
        }
    }
    
    // 4. Type compatibility checks (for better diagnostics)
    // Check destination
    if let Ok(dst_meta) = dst.symlink_metadata() {
        let dst_is_dir = dst_meta.is_dir();
        let dst_is_symlink = dst_meta.file_type().is_symlink();
        
        if src_is_dir {
            if dst_is_dir {
                // Directory onto directory: only OK if dst is empty
                // (rename will handle this, but we can pre-check for better error)
                // Actually, let rename handle it - it will give ENOTEMPTY if non-empty
            } else if dst_is_symlink {
                // dst is a symlink; resolve it to check what it points to
                if let Ok(resolved) = dst.metadata() {
                    if resolved.is_dir() {
                        // Symlink to directory: rename of dir over symlink-to-dir
                        // Let rename handle it
                    }
                }
                // Otherwise it's a symlink to a file or broken: 
                // directory cannot replace a non-directory → ENOTDIR
                // Let rename handle it
            } else {
                // dst is a regular file: directory cannot replace it → ENOTDIR
                // Let rename handle it, but provide better diagnostic
            }
        } else {
            // Source is non-directory (file or symlink)
            if dst_is_dir {
                // Non-directory cannot replace a directory → ENOTDIR
                return Err(format!(
                    "error: cannot overwrite directory '{}' with non-directory '{}'",
                    dst.to_string_lossy(),
                    src.to_string_lossy()
                ));
            }
            if dst_is_symlink {
                // Check what the symlink points to
                if let Ok(resolved) = dst.metadata() {
                    if resolved.is_dir() {
                        return Err(format!(
                            "error: cannot overwrite directory '{}' with non-directory '{}'",
                            dst.to_string_lossy(),
                            src.to_string_lossy()
                        ));
                    }
                }
                // Symlink to file or broken: OK, rename will replace the symlink
            }
        }
    }
    
    // 5. Perform the rename
    match move_path(src, dst) {
        Ok(()) => Ok(()),
        Err(e) => Err(format!(
            "error: cannot move '{}' to '{}': {}",
            src.to_string_lossy(),
            dst.to_string_lossy(),
            io_error_message(&e)
        )),
    }
}
