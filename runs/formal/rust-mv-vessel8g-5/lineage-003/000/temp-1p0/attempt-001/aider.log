use std::ffi::OsStr;
use std::ffi::OsString;
use std::io;
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

fn move_path(src: &OsStr, dst: &OsStr) -> io::Result<()> {
    std::fs::rename(src, dst)
}

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().collect();
    let args = &args[1..]; // skip program name
    
    // Parse: find -- separator, identify options vs operands
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    for arg in args {
        if !after_ddash && arg == OsStr::new("--") {
            after_ddash = true;
            continue;
        }
        if !after_ddash {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                // Unknown option
                eprintln!("error: unknown option");
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    // Validate operand count
    if operands.len() < 2 {
        eprintln!("error: missing operand");
        return ExitCode::from(1);
    }
    
    let sources: Vec<&OsString>;
    let dest_dir: Option<&OsString>;
    
    if operands.len() == 2 {
        sources = vec![&operands[0]];
        dest_dir = None;
    } else {
        // 3+ operands: last is directory
        sources = operands[..operands.len() - 1].to_vec();
        dest_dir = Some(&operands[operands.len() - 1]);
    }
    
    // For multi-source, validate dest is a directory
    if let Some(dir) = dest_dir {
        let dir_path = Path::new(dir);
        match dir_path.symlink_metadata() {
            Ok(meta) => {
                if !meta.is_dir() {
                    // Could be symlink to dir?
                    if meta.file_type().is_symlink() {
                        match dir_path.metadata() {
                            Ok(m) => {
                                if !m.is_dir() {
                                    eprintln!("error: '{}' is not a directory", dir.to_string_lossy());
                                    return ExitCode::from(1);
                                }
                            }
                            Err(_) => {
                                eprintln!("error: '{}' is not a directory", dir.to_string_lossy());
                                return ExitCode::from(1);
                            }
                        }
                    } else {
                        eprintln!("error: '{}' is not a directory", dir.to_string_lossy());
                        return ExitCode::from(1);
                    }
                }
            }
            Err(_) => {
                eprintln!("error: '{}' is not a directory", dir.to_string_lossy());
                return ExitCode::from(1);
            }
        }
    }
    
    // Process each source
    let mut any_failed = false;
    
    for src in &sources {
        let src_path = Path::new(src);
        
        // Determine effective destination
        let dst = if let Some(dir) = dest_dir {
            // Multi-source: dst = dir / src_basename
            let basename = src_path.file_name().unwrap_or(OsStr::new(""));
            dir.join(basename) // Hmm, but dir is OsString, need PathBuf
        } else {
            Path::new(&operands[1]).to_path_buf()
        };
        
        // ... do the move
    }
}
```

