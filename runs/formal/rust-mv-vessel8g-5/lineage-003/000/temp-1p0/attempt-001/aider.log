```rust
use std::ffi::{OsStr, OsString};
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

fn move_path(src: &Path, dst: &Path) -> std::io::Result<()> {
    std::fs::rename(src, dst)
}

fn is_directory(path: &Path) -> bool {
    path.metadata().map(|m| m.is_dir()).unwrap_or(false)
}

fn same_or_descendant(parent: &Path, child: &Path) -> bool {
    let p = parent.as_os_str().as_bytes();
    let c = child.as_os_str().as_bytes();
    if c.len() < p.len() {
        return false;
    }
    c[..p.len()] == p && (c.len() == p.len() || c[p.len()] == b'/')
}

fn io_err_msg(e: &std::io::Error) -> String {
    e.to_string()
}

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    for arg in &args {
        if !after_ddash {
            let b = arg.as_bytes();
            if b == b"--" {
                after_ddash = true;
                continue;
            }
            if b.len() > 1 && b[0] == b'-' {
                eprintln!("mv: invalid option -- {}", arg.to_string_lossy());
                return ExitCode::from(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("mv: missing operand");
        return ExitCode::from(1);
    }
    
    let n = operands.len();
    let multi = n > 2;
    
    // Multi-source: last must be existing directory
    if multi {
        let dir = Path::new(&operands[n - 1]);
        if !is_directory(dir) {
            eprintln!("mv: target '{}' is not a directory", dir.to_string_lossy());
            return ExitCode::from(1);
        }
    }
    
    let mut any_failed = false;
    let num_sources = if multi { n - 1 } else { 1 };
    
    for i in 0..num_sources {
        let src = Path::new(&operands[i]);
        
        let dst: PathBuf = if multi {
            let dir = Path::new(&operands[n - 1]);
            let base = src.file_name().unwrap_or(OsStr::new(""));
            dir.join(base)
        } else {
            let dest = Path::new(&operands[1]);
            if is_directory(dest) {
                let base = src.file_name().unwrap_or(OsStr::new(""));
                dest.join(base)
            } else {
                dest.to_path_buf()
            }
        };
        
        if let Err(msg) = do_move(src, &dst) {
            eprintln!("{}", msg);
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}

fn do_move(src: &Path, dst: &Path) -> Result<(), String> {
    // Source must exist
    let src_meta = match src.symlink_metadata() {
        Ok(m) => m,
        Err(_) => return Err(format!("mv: cannot stat '{}': No such file or directory", src.to_string_lossy())),
    };
    
    let src_is_dir = src_meta.is_dir();
    
    // Identical check
    if src.as_os_str() == dst.as_os_str() {
        return Err(format!("mv: '{}' and '{}' are the same file", src.to_string_lossy(), dst.to_string_lossy()));
    }
    // Canonical comparison
    if let (Ok(cs), Ok(cd)) = (std::fs::canonicalize(src), std::fs::canonicalize(dst)) {
        if cs == cd {
            return Err(format!("mv: '{}' and '{}' are the same file", src.to_string_lossy(), dst.to_string_lossy()));
        }
    }
    
    // Directory into itself
    if src_is_dir && dst.as_os_str().as_bytes().len() > src.as_os_str().as_bytes().len() {
        let sb = src.as_os_str().as_bytes();
        let db = dst.as_os_str().as_bytes();
        if db[..sb.len()] == sb && db[sb.len()] == b'/' {
            return Err(format!("mv: cannot move directory '{}' into itself", src.to_string_lossy()));
        }
    }
    
    // Perform rename
    match move_path(src, dst) {
        Ok(()) => Ok(()),
        Err(e) => Err(format!("mv: cannot move '{}' to '{}': {}", src.to_string_lossy(), dst.to_string_lossy(), e)),
    }
}
```

