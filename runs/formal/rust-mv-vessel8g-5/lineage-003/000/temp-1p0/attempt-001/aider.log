```rust
use std::ffi::{OsStr, OsString};
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

/// Core filesystem move operation.
fn move_path(src: &Path, dst: &Path) -> std::io::Result<()> {
    std::fs::rename(src, dst)
}

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse arguments
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if !after_ddash && arg.as_bytes() == b"--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && arg.as_bytes().len() > 1 && arg.as_bytes()[0] == b'-' {
            eprintln!("error: unknown option '{}'", arg.to_string_lossy());
            return ExitCode::from(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("error: missing operand");
        return ExitCode::from(1);
    }
    
    let (sources, dest) = if operands.len() == 2 {
        (vec![&operands[0]], Some(Path::new(&operands[1])))
    } else {
        let last = Path::new(&operands[operands.len() - 1]);
        // Validate last is a directory
        if !is_directory(last) {
            eprintln!("error: '{}' is not a directory", last.to_string_lossy());
            return ExitCode::from(1);
        }
        (operands[..operands.len() - 1].to_vec(), Some(last))
    };
    
    let mut any_failed = false;
    
    for src in sources {
        let src_path = Path::new(src);
        let dst_path = if let Some(dest) = &dest {
            if dest_is_directory(dest) {
                let basename = src_path.file_name().unwrap_or(OsStr::new(""));
                dest.join(basename)
            } else {
                dest.to_path_buf()
            }
        } else {
            unreachable!()
        };
        
        // Perform checks and move
        if let Err(e) = do_move(src_path, &dst_path) {
            eprintln!("error: {}", e);
            any_failed = true;
        }
    }
    
    if any_failed {
