fn parse_args(args: &[String]) -> Result<Vec<OsString>, String> {
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in args {
        if !after_ddash && arg == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && arg.starts_with('-') && arg.len() > 1 {
            return Err(format!("unknown option: {}", arg));
        }
        operands.push(OsString::from(arg.as_bytes()));
    }
    
    if operands.len() < 2 {
        return Err("missing operands".to_string());
    }
    
    Ok(operands)
}
```

