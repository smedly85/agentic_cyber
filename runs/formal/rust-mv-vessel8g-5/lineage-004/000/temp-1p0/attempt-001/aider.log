```rust
fn perform_move(src: &Path, dest: &Path, src_display: &OsStr) -> bool {
    // Source must exist
    let src_meta = match std::fs::symlink_metadata(src) {
        Ok(m) => m,
        Err(e) => {
            eprintln!("rust_mv: {}: {}", display_os(src_display), e);
            return false;
        }
    };
    
    let src_is_dir = src_meta.file_type().is_dir();
    
    // Check identical source/destination
    // Canonicalize both (if they exist)
    let src_canon = std::fs::canonicalize(src);
    let dest_exists = std::fs::symlink_metadata(dest).is_ok();
    let dest_canon = std::fs::canonicalize(dest);
    
    if let (Ok(sc), Ok(dc)) = (&src_canon, &dest_canon) {
        if sc == dc {
            eprintln!("rust_mv: '{}' and '{}' are the same file", display_os(src_display), display_os(dest));
            return false;
        }
    }
    
    // If source is a directory:
    if src_is_dir {
        // Check dest is not inside source
        if let Ok(sc) = &src_canon {
            // If dest exists, canonicalize it
            // If dest doesn't exist, canonicalize its parent
            let dest_check = if dest_exists {
                dest_canon.clone().unwrap()
            } else {
                // canonicalize parent of dest
                let parent = dest.parent().unwrap_or(Path::new("."));
                std::fs::canonicalize(parent)
            };
            if let Ok(dc) = dest_check {
                if dc == *sc || dc.starts_with(sc) {
                    eprintln!("rust_mv: cannot move '{}' into itself or a subdirectory", display_os(src_display));
                    return false;
                }
            }
        }
        
        // If dest exists, it must be a directory and empty
        if dest_exists {
            if let Ok(dm) = std::fs::symlink_metadata(dest) {
                if !dm.file_type().is_dir() {
                    eprintln!("rust_mv: cannot overwrite non-directory '{}' with directory '{}'", display_os(dest), display_os(src_display));
                    return false;
                }
                // Must be empty
                if let Ok(mut entries) = std::fs::read_dir(dest) {
                    if entries.next().is_some() {
                        eprintln!("rust_mv: cannot move directory '{}' into non-empty directory '{}'", display_os(src_display), display_os(dest));
                        return false;
                    }
                }
            }
        }
    } else {
        // Source is not a directory
        // If dest exists, it must NOT be a directory
        if dest_exists {
            if let Ok(dm) = std::fs::symlink_metadata(dest) {
                if dm.file_type().is_dir() {
                    eprintln!("rust_mv: cannot overwrite directory '{}' with non-directory '{}'", display_os(dest), display_os(src_display));
                    return false;
                }
            }
        }
    }
    
    // Check parent of dest exists
    if let Some(parent) = dest.parent() {
        if !parent.as_os_str().is_empty() {
            if std::fs::symlink_metadata(parent).is_err() {
                eprintln!("rust_mv: cannot move to '{}': No such file or directory", display_os(dest));
                return false;
            }
        }
    }
    
    // Perform the move
    if let Err(e) = move_path(src, dest) {
        eprintln!("rust_mv: cannot move '{}' to '{}': {}", display_os(src_display), display_os(dest), e);
        return false;
    }
    
    true
}
```

