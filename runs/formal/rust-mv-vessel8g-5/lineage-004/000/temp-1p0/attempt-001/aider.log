```rust
fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse: find --, check for unknown options before it
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    for arg in &args {
        if !after_ddash && *arg == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && is_option(arg) {
            eprintln!("rust_mv: unknown option: {}", display_os(arg));
            return ExitCode::from(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("rust_mv: missing operands");
        return ExitCode::from(1);
    }
    
    // Determine mode: single source or multi-source
    let (sources, dest) = if operands.len() == 2 {
        // single source, dest may be dir or file
        (vec![operands[0].clone()], operands[1].clone())
    } else {
        // multi-source: last must be existing directory
        let last = &operands[operands.len() - 1];
        let last_path = Path::new(last);
        let metadata = match std::fs::symlink_metadata(last_path) {
            Ok(m) => m,
            Err(_) => {
                eprintln!("rust_mv: {}: not a directory", display_os(last));
                return ExitCode::from(1);
            }
        };
        if !metadata.file_type().is_dir() {
            eprintln!("rust_mv: {}: not a directory", display_os(last));
            return ExitCode::from(1);
        }
        (operands[..operands.len()-1].to_vec(), last.clone())
    };
    
    // Process each source
    let mut any_failed = false;
    for source in &sources {
        let src_path = Path::new(source);
        
        // Determine effective destination
        let dest_path = if sources.len() == 1 {
            let d = Path::new(&dest);
            let d_meta = std::fs::symlink_metadata(d);
            if d_meta.map(|m| m.file_type().is_dir()).unwrap_or(false) {
                d.join(src_path.file_name().unwrap_or(OsStr::new("")))
            } else {
                d.to_path_buf()
            }
        } else {
            Path::new(&dest).join(src_path.file_name().unwrap_or(OsStr::new("")))
        };
        
        if !perform_move(src_path, &dest_path, source) {
            any_failed = true;
        }
    }
    
    if any_failed {
        ExitCode::from(1)
    } else {
        ExitCode::SUCCESS
    }
}
```

