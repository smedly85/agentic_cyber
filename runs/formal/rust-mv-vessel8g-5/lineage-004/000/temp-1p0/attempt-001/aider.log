```rust
use std::ffi::{OsStr, OsString};
use std::os::unix::ffi::OsStrExt;
use std::path::{Path, PathBuf};
use std::process::ExitCode;

fn display_os(os: &OsStr) -> String {
    os.to_string_lossy().into_owned()
}

fn is_option(arg: &OsStr) -> bool {
    let bytes = arg.as_bytes();
    bytes.len() > 1 && bytes[0] == b'-'
}

fn move_path(src: &Path, dest: &Path) -> std::io::Result<()> {
    std::fs::rename(src, dest)
}

fn main() -> ExitCode {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse arguments
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    for arg in &args {
        if !after_ddash && arg.as_bytes() == b"--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && is_option(arg) {
            eprintln!("rust_mv: unknown option: {}", display_os(arg));
            return ExitCode::from(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("rust_mv: missing required operand");
        return ExitCode::from(1);
    }
    
    // Determine sources and destination
    let sources: Vec<OsString>;
    let dest_dir: Option<OsString>; // Some if multi-source (dest is a directory)
    
    if operands.len() == 2 {
        sources = vec![operands[0].clone()];
        dest_dir = None;
    } else {
        let last = &operands[operands.len() - 1];
        let last_path = Path::new(last);
        match std::fs::symlink_metadata(last_path) {
            Ok(m) if m.file_type().is_dir() => {}
            _ => {
                eprintln!("rust_mv: {}: target directory does not exist or is not a directory", display_os(last));
                return ExitCode::from(1);
            }
        }
        sources = operands[..operands.len() - 1].to_vec();
        dest_dir = Some(last.clone());
    }
    
    let mut any_failed = false;
    
    for source in &sources {
        let src_path = Path::new(source);
        
        // Get file name of source for constructing effective dest
        let file_name = match src_path.file_name() {
            Some(fn_) => fn_.to_os_string(),
            None => {
                eprintln!("rust_mv: cannot determine file name for: {}", display_os(source));
                any_failed = true;
                continue;
            }
        };
        
        // Determine effective destination
        let effective_dest: PathBuf;
        if let Some(dir) = &dest_dir {
            effective_dest = Path::new(dir).join(&file_name);
        } else {
            let dest_path = Path::new(&operands[1]);
            let dest_is_dir = std::fs::symlink_metadata(dest_path)
                .map(|m| m.file_type().is_dir())
                .unwrap_or(false);
            if dest_is_dir {
                effective_dest = dest_path.join(&file_name);
            } else {
                effective_dest = dest_path.to_path_buf();
            }
        }
        
        if !perform_move(src_path, &effective_dest, source) {
            any_failed = true;
        }
