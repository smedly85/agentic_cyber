#define CHUNK_SIZE 4096

static char *read_line(FILE *fp, size_t *len_out) {
    size_t capacity = CHUNK_SIZE;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;

    while (1) {
        int c = fgetc(fp);
        printf("fgetc returned: %d\n", c);
        if (c == EOF) {
            printf("EOF detected\n");
            if (ferror(fp)) {
                printf("ferror is set\n");
                free(buf);
                return NULL;
            }
            break;
        }
        if (c == '\n') {
            printf("newline found\n");
            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            char *new_buf = realloc(buf, new_cap);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    printf("Line length: %zu\n", len);
    buf[len] = '\0';
    *len_out = len;
    return buf;
}

int main() {
    size_t len;
    char *line = read_line(stdin, &len);
    if (!line) {
        printf("read_line returned NULL\n");
        return 1;
    }
    printf("Line: '%s'\n", line);
    free(line);
    return 0;
}
