#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CHUNK_SIZE 4096

static char *read_line(FILE *fp, size_t *len_out) {
    size_t capacity = CHUNK_SIZE;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;

    while (1) {
        int c = fgetc(fp);
        fprintf(stderr, "DEBUG: read byte %d\n", c);
        if (c == EOF) {
            fprintf(stderr, "DEBUG: got EOF, len=%zu, feof=%d, ferror=%d\n", len, feof(fp), ferror(fp));
            if (ferror(fp)) {
                free(buf);
                return NULL;
            }
            break;
        }
        if (c == '\n') {
            fprintf(stderr, "DEBUG: got newline\n");
            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            char *new_buf = realloc(buf, new_cap);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    fprintf(stderr, "DEBUG: returning line of len=%zu\n", len);
    buf[len] = '\0';
    *len_out = len;
    return buf;
}

int main(int argc, char *argv[]) {
    size_t pat_len = strlen(argv[1]);
    
    while (1) {
        size_t line_len;
        char *line = read_line(stdin, &line_len);
        fprintf(stderr, "DEBUG: got line, line=%p, len=%zu\n", line, line_len);
        if (!line) break;
        
        fprintf(stderr, "DEBUG: processing line: %s (len=%zu)\n", line, line_len);
        
        if (memmem(line, line_len, argv[1], pat_len)) {
            printf("%s", line);
        }
        free(line);
    }
    
    return 0;
}
