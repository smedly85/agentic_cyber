            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            char *new_buf = realloc(buf, new_cap);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    fprintf(stderr, "DEBUG: returning line of len=%zu\n", len);
    buf[len] = '\0';
    *len_out = len;
