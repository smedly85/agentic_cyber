        size_t line_len;
        char *line = read_line(stdin, &line_len);
        fprintf(stderr, "DEBUG: got line=%p, len=%zu\n", line, line_len);
        if (!line) break;
        
        if (matches(line, line_len, argv[1], pat_len)) {
            printf("MATCH: %s", line);
        }
        free(line);
    }
    
    return 0;
}
