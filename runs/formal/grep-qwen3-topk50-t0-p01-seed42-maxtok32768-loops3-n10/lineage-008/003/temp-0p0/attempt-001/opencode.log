        if (stat(filename, &st) != 0) {
            fprintf(stderr, "%s: %s\n", filename, strerror(errno));
            return 2;
        }
    } else {
        if (lstat(filename, &st) != 0) {
            fprintf(stderr, "%s: %s\n", filename, strerror(errno));
            return 2;
        }
    }

    if (S_ISLNK(st.st_mode)) {
        if (from_traversal) {
            return 1;
        }
    }

    if (S_ISDIR(st.st_mode)) {
        printf("DEBUG: Is directory, calling search_directory\n");
        char *dir_path = NULL;
        size_t len = strlen(filename);
        if (len > 0 && filename[len - 1] == '/') {
            dir_path = strdup(filename);
        } else {
            dir_path = malloc(len + 2);
            strcpy(dir_path, filename);
            strcat(dir_path, "/");
        }
        int result = search_directory(dir_path, pattern, prefix_filename, recursive);
        free(dir_path);
        return result;
    }

    if (!S_ISREG(st.st_mode)) {
        return 1;
    }

    printf("DEBUG: Is regular file\n");
    return 0;
}

