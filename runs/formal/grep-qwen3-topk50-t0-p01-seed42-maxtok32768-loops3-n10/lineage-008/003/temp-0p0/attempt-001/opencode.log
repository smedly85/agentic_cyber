            free(buf);
            return NULL;
        }
        if (c == '\n') {
            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            if (new_cap <= capacity) {
                free(buf);
                return NULL;
            }
            char *new_buf = realloc(buf, new_cap);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    buf[len] = '\0';
    *len_out = len;
    return buf;
}

static int matches(const char *line, size_t line_len, const char *pattern, size_t pat_len) {
    if (pat_len == 0) return 1;
    if (pat_len > line_len) return 0;
    return memmem(line, line_len, pattern, pat_len) != NULL;
}

static void free_string_array(char **arr, int count) {
    for (int i = 0; i < count; i++) {
        free(arr[i]);
    }
    free(arr);
}

static int compare_strings(const void *a, const void *b) {
    const char *s1 = *(const char **)a;
    const char *s2 = *(const char **)b;
    return strcmp(s1, s2);
}

int search_directory(const char *dirname, const char *pattern, size_t pat_len, int prefix_filename, int recursive) {
    printf("search_directory(%s)\n", dirname);
    
    DIR *dir = opendir(dirname);
    if (!dir) {
        fprintf(stderr, "%s: %s\n", dirname, strerror(errno));
        return 2;
    }

    struct dirent *entry;
    int entry_count = 0;
    char **names = NULL;

    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
            continue;
        }
        names = realloc(names, sizeof(char *) * (entry_count + 1));
        if (!names) {
            closedir(dir);
            return 2;
        }
        names[entry_count] = strdup(entry->d_name);
        if (!names[entry_count]) {
            free_string_array(names, entry_count);
            free(names);
            closedir(dir);
            return 2;
        }
        printf("Added: %s\n", names[entry_count]);
        entry_count++;
    }

    closedir(dir);

    if (entry_count > 0) {
        qsort(names, entry_count, sizeof(char *), compare_strings);
    }

    for (int i = 0; i < entry_count; i++) {
        char *name = names[i];
        
        size_t dir_len = strlen(dirname);
        size_t name_len = strlen(name);

        printf("Processing: %s\n", name);

        char *full_path;
        if (dirname[dir_len - 1] == '/') {
            full_path = malloc(dir_len + name_len + 1);
            strcpy(full_path, dirname);
            strcat(full_path, name);
        } else {
            full_path = malloc(dir_len + 1 + name_len + 1);
            strcpy(full_path, dirname);
            strcat(full_path, "/");
            strcat(full_path, name);
        }
        
        printf("full_path: %s\n", full_path);
        
        struct stat st;
        if (lstat(full_path, &st) != 0) {
            fprintf(stderr, "%s: %s\n", full_path, strerror(errno));
            free(full_path);
            continue;
        }

        if (S_ISLNK(st.st_mode)) {
            printf("Is symlink\n");
            free(full_path);
            continue;
        }

        if (S_ISDIR(st.st_mode)) {
            printf("Is directory, recursing...\n");
            int result = search_directory(full_path, pattern, pat_len, prefix_filename, recursive);
            printf("Result: %d\n", result);
        } else if (S_ISREG(st.st_mode)) {
            printf("Is regular file, opening...\n");
            
            FILE *fp = fopen(full_path, "rb");
            if (!fp) {
                fprintf(stderr, "%s: %s\n", full_path, strerror(errno));
                free(full_path);
                continue;
            }
            
            int matched = 0;
            while (1) {
                size_t line_len;
                char *line = read_line(fp, &line_len);
                printf("read_line returned: %p\n", (void*)line);
                if (!line && ferror(fp)) {
                    fprintf(stderr, "%s: %s\n", full_path, strerror(errno));
                    free(full_path);
                    return 2;
                }
                if (!line) break;

                printf("About to call matches\n");
                if (matches(line, line_len, pattern, pat_len)) {
                    matched = 1;
                    printf("Matched: %.*s\n", (int)line_len, line);
                }
                free(line);
            }
            
            fclose(fp);
        }

        free(full_path);
    }

    free_string_array(names, entry_count);
    free(names);

    return 0;
}

int search_file(const char *filename, const char *pattern, size_t pat_len, int prefix_filename, int recursive, int from_traversal) {
    printf("search_file(%s)\n", filename);
    
    struct stat st;
    int use_stat = !from_traversal;
    
    if (use_stat) {
        if (stat(filename, &st) != 0) {
            fprintf(stderr, "%s: %s\n", filename, strerror(errno));
            return 2;
        }
    } else {
        if (lstat(filename, &st) != 0) {
            fprintf(stderr, "%s: %s\n", filename, strerror(errno));
            return 2;
        }
    }

    if (S_ISLNK(st.st_mode)) {
        if (from_traversal) {
            return 1;
        }
    }

    if (S_ISDIR(st.st_mode)) {
        char *dir_path = NULL;
        size_t len = strlen(filename);
        if (len > 0 && filename[len - 1] == '/') {
            dir_path = strdup(filename);
        } else {
            dir_path = malloc(len + 2);
            strcpy(dir_path, filename);
            strcat(dir_path, "/");
        }
        printf("Calling search_directory with %s\n", dir_path);
        int result = search_directory(dir_path, pattern, pat_len, prefix_filename, recursive);
        free(dir_path);
        return result;
    }

    if (!S_ISREG(st.st_mode)) {
        return 1;
    }

    FILE *fp = fopen(filename, "rb");
    if (!fp) {
        fprintf(stderr, "%s: %s\n", filename, strerror(errno));
        return 2;
    }
    
    int matched = 0;
    while (1) {
        size_t line_len;
        char *line = read_line(fp, &line_len);
        printf("read_line returned: %p\n", (void*)line);
        if (!line && ferror(fp)) {
            fprintf(stderr, "%s: %s\n", filename, strerror(errno));
            return 2;
        }
        if (!line) break;

        printf("About to call matches\n");
        if (matches(line, line_len, pattern, pat_len)) {
            matched = 1;
            printf("Matched: %.*s\n", (int)line_len, line);
        }
        free(line);
    }
    
    fclose(fp);
    return matched ? 0 : 1;
}

