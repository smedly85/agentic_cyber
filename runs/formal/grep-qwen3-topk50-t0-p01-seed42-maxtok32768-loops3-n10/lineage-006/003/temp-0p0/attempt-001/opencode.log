+            *error_occurred = 1;
+            free(names[i]);
+            continue;
+        }
+
+        if (S_ISLNK(st.st_mode)) {
+            free(names[i]);
+            continue;
+        }
+
+        if (S_ISDIR(st.st_mode)) {
+            search_directory(path, pattern, pat_len, prefix_filename, error_occurred);
+        } else if (S_ISREG(st.st_mode)) {
+            search_file(path, pattern, pat_len, prefix_filename, error_occurred);
+        }
+        free(names[i]);
+    }
+
+    free(names);
+}
