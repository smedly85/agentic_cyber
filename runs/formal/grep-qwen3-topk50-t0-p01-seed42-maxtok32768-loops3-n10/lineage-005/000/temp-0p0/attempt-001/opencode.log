#define CHUNK_SIZE 4096

static char *read_line(FILE *fp, size_t *len_out) {
    size_t capacity = CHUNK_SIZE;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;

    while (1) {
        int c = fgetc(fp);
        printf("fgetc: %d\n", c);
        if (c == EOF) {
            printf("EOF\n");
            if (feof(fp)) break;
            free(buf);
            return NULL;
        }
        if (c == '\n') {
            printf("newline\n");
            break;
        }
        if (len >= capacity - 1) {
            size_t new_cap = capacity * 2;
            char *new_buf = realloc(buf, new_cap);
            printf("realloc: %p\n", new_buf);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
            capacity = new_cap;
        }
        buf[len++] = (char)c;
    }

    buf[len] = '\0';
    *len_out = len;
    return buf;
}

int main() {
    size_t line_len;
    char *line = read_line(stdin, &line_len);
    printf("read: '%s' len=%zu\n", line, line_len);
    free(line);
    return 0;
}
