```c
int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                  const unsigned char *prefix, size_t prefix_len, int *found) {
    unsigned char *line = NULL;
    size_t line_len = 0, line_cap = 0;
    int error = 0;
    
    int c;
    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            // Process the line
            if (line_len > 0 || line_cap > 0) {
                // Check if pattern matches
                if (pattern_len == 0 || contains_pattern(line, line_len, pattern, pattern_len)) {
                    // Output
                    if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) error = 1;
                    if (fwrite(line, 1, line_len, stdout) != line_len) error = 1;
                    if (fputc('\n', stdout) != '\n') error = 1;
                    *found = 1;
                }
                line_len = 0;
            }
        } else {
            if (line_len + 1 >= line_cap) {
                size_t new_cap = line_cap ? line_cap * 2 : 4096;
                unsigned char *new_line = realloc(line, new_cap);
                if (!new_line) { free(line); return -1; }
                line = new_line;
                line_cap = new_cap;
            }
            line[line_len++] = (unsigned char)c;
        }
    }
    
    // Handle final unterminated line
    if (line_len > 0) {
        if (pattern_len == 0 || contains_pattern(line, line_len, pattern, pattern_len)) {
            if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) error = 1;
            if (fwrite(line, 1, line_len, stdout) != line_len) error = 1;
            if (fputc('\n', stdout) != '\n') error = 1;
            *found = 1;
        }
    }
    
    free(line);
    return error ? -1 : 0;
}
```

