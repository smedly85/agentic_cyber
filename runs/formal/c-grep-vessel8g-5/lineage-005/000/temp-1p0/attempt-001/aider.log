    int i = 1;
    
    // Skip options
    while (i < argc) {
        if (strcmp(argv[i], "--") == 0) { i++; break; }
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "c_grep: unsupported option '%s'\n", argv[i]);
            return 2;
        }
        break;
    }
    
    if (i >= argc) {
        fprintf(stderr, "c_grep: missing PATTERN\n");
        return 2;
    }
    
    const unsigned char *pattern = (const unsigned char *)argv[i];
    size_t pattern_len = strlen(argv[i]);
    i++;
    
    int nfiles = argc - i;
    int multi = (nfiles >= 2);
    int found = 0;
    int had_error = 0;
    
    if (nfiles == 0) {
        int local_found = 0;
        int rc = search_stream(stdin, pattern, pattern_len, NULL, 0, &local_found);
        if (local_found) found = 1;
        if (rc == -1) had_error = 1;
    } else {
        for (int j = 0; j < nfiles; j++) {
            const char *filename = argv[i + j];
            
            struct stat st;
            if (stat(filename, &st) == 0 && S_ISDIR(st.st_mode)) {
                fprintf(stderr, "c_grep: %s: Is a directory\n", filename);
                had_error = 1;
                continue;
            }
            
            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", filename, strerror(errno));
                had_error = 1;
                continue;
            }
            
            const unsigned char *prefix = NULL;
            size_t prefix_len = 0;
            unsigned char *heap_prefix = NULL;
            if (multi) {
                size_t fn_len = strlen(filename);
                heap_prefix = malloc(fn_len + 1);
                if (!heap_prefix) {
                    fclose(fp);
                    had_error = 1;
                    continue;
                }
                memcpy(heap_prefix, filename, fn_len);
                heap_prefix[fn_len] = ':';
                prefix = heap_prefix;
                prefix_len = fn_len + 1;
            }
            
            int local_found = 0;
            int rc = search_stream(fp, pattern, pattern_len, prefix, prefix_len, &local_found);
            if (local_found) found = 1;
            if (rc == -1) had_error = 1;
            
            free(heap_prefix);
            fclose(fp);
        }
    }
    
    if (had_error) return 2;
    return found ? 0 : 1;
}
