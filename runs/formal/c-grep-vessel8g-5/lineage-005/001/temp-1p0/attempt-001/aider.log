```c
int main(int argc, char *argv[])
{
    int want_filename = 0;
    int i = 1;
    int pattern_set = 0;
    int pattern_idx = -1;
    int file_start = -1;
    int end_options = 0;

    for (; i < argc; i++) {
        if (end_options) {
            if (!pattern_set) {
                pattern_set = 1;
                pattern_idx = i;
            } else if (file_start == -1) {
                file_start = i;
            }
            continue;
        }

        const char *arg = argv[i];

        if (strcmp(arg, "--") == 0) {
            end_options = 1;
            continue;
        }

        if (arg[0] == '-' && arg[1] != '\0') {
            if (strcmp(arg, "--with-filename") == 0) {
                want_filename = 1;
                continue;
            }
            size_t len = strlen(arg);
            int valid = (len >= 2);
            for (size_t k = 1; k < len && valid; k++) {
                if (arg[k] != 'H')
                    valid = 0;
            }
            if (valid) {
                want_filename = 1;
                continue;
            }
            fprintf(stderr, "c_grep: unsupported option '%s'\n", arg);
            return 2;
        }

        if (!pattern_set) {
            pattern_set = 1;
            pattern_idx = i;
        } else if (file_start == -1) {
            file_start = i;
        }
    }

    if (!pattern_set) {
        fprintf(stderr, "c_grep: missing PATTERN\n");
        return 2;
    }

    const unsigned char *pattern = (const unsigned char *)argv[pattern_idx];
    size_t pattern_len = strlen(argv[pattern_idx]);

    int nfiles = (file_start == -1) ? 0 : argc - file_start;
    int multi = (nfiles >= 2);
    int found = 0;
    int had_error = 0;

    if (nfiles == 0) {
        /* stdin */
        const unsigned char *prefix = NULL;
        size_t prefix_len = 0;
        if (want_filename) {
            prefix = (const unsigned char *)"(standard input):";
            prefix_len = strlen("(standard input):");
        }
        int local_found = 0;
        int rc = search_stream(stdin, pattern, pattern_len, prefix, prefix_len, &local_found);
        if (local_found)
            found = 1;
        if (rc == -1)
            had_error = 1;
    } else {
        for (int j = 0; j < nfiles; j++) {
            const char *filename = argv[file_start + j];

            struct stat st;
            if (stat(filename, &st) == 0 && S_ISDIR(st.st_mode)) {
                fprintf(stderr, "c_grep: %s: Is a directory\n", filename);
                had_error = 1;
                continue;
            }

            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", filename, strerror(errno));
                had_error = 1;
                continue;
            }

            unsigned char *prefix_buf = NULL;
            size_t prefix_len = 0;
            if (want_filename || multi) {
                size_t fn_len = strlen(filename);
                prefix_buf = malloc(fn_len + 1);
                if (!prefix_buf) {
                    fclose(fp);
                    had_error = 1;
                    continue;
                }
                memcpy(prefix_buf, filename, fn_len);
                prefix_buf[fn_len] = ':';
                prefix_len = fn_len + 1;
            }

            int local_found = 0;
            int rc = search_stream(fp, pattern, pattern_len,
                                   prefix_buf, prefix_len, &local_found);
            if (local_found)
                found = 1;
            if (rc == -1)
                had_error = 1;

            free(prefix_buf);
            fclose(fp);
        }
    }

    if (had_error)
        return 2;
    return found ? 0 : 1;
}
```

