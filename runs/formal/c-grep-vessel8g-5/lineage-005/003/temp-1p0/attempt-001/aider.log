int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                  const unsigned char *prefix, size_t prefix_len, int *found)
{
	unsigned char *line = NULL;
	size_t line_len = 0, line_cap = 0;
	int error = 0;

	for (;;) {
		int c = fgetc(fp);
		if (c == EOF) {
			if (ferror(fp))
				error = 1;
			break;
		}
