					     prefix_enabled, &found, &had_error);
			} else {
				search_one_file(filename, pattern, pattern_len,
						prefix_enabled, &found, &had_error);
			}
		}
	}

	if (had_error)
		return 2;
	return found ? 0 : 1;
}
