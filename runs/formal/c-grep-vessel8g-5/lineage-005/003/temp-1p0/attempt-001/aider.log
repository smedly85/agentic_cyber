Actually, let me use a proper comparison:
```c
static int cmp_strings(const void *a, const void *b) {
    const char *sa = *(const char * const *)a;
    const char *sb = *(const char * const *)b;
    // Compare byte by byte (raw byte order)
    size_t i = 0;
    while (sa[i] && sb[i] && sa[i] == sb[i])
        i++;
    if ((unsigned char)sa[i] < (unsigned char)sb[i]) return -1;
    if ((unsigned char)sa[i] > (unsigned char)sb[i]) return 1;
    return 0;
}
```

This handles the raw byte comparison correctly (treating bytes as unsigned).

