			if (line_contains(line, line_len, pattern, pattern_len)) {
				if (prefix_len && fwrite(prefix, 1, prefix_len, stdout) != prefix_len)
					error = 1;
				if (line_len && fwrite(line, 1, line_len, stdout) != line_len)
					error = 1;
				if (fputc('\n', stdout) == EOF)
					error = 1;
				*found = 1;
			}
			line_len = 0;
		} else {
			if (line_len + 1 > line_cap) {
				size_t new_cap;
				if (line_cap == 0)
					new_cap = 8192;
				else if (line_cap > (SIZE_MAX - 1) / 2) {
					free(line);
					return -1;
				} else
					new_cap = line_cap * 2;
				unsigned char *tmp = realloc(line, new_cap);
				if (!tmp) {
					free(line);
					return -1;
				}
				line = tmp;
				line_cap = new_cap;
			}
			line[line_len++] = (unsigned char)c;
		}
	}

	/* Final unterminated line */
	if (line_len > 0) {
		if (line_contains(line, line_len, pattern, pattern_len)) {
			if (prefix_len && fwrite(prefix, 1, prefix_len, stdout) != prefix_len)
				error = 1;
			if (fwrite(line, 1, line_len, stdout) != line_len)
				error = 1;
			if (fputc('\n', stdout) == EOF)
				error = 1;
			*found = 1;
		}
	}

	free(line);
	return error ? -1 : 0;
}

int main(int argc, char *argv[])
{
	int filename_mode = 0;  /* 0=unset, 1=force(-H), -1=suppress(-h) */
	int recursive = 0;
