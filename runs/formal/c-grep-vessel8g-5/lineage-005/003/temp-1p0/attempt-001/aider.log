Looking at the current code, I need to add `-r`/`--recursive` support with directory traversal. Here are the precise changes:

**1. Add `#include <dirent.h>` after the existing `#include <sys/stat.h>` line.**

**2. Add these new static functions before `main`:**

```c
static int cmp_entry_names(const void *a, const void *b)
{
	const char *sa = *(const char * const *)a;
	const char *sb = *(const char * const *)b;
	size_t i = 0;
	while (sa[i] != '\0' && sb[i] != '\0' && sa[i] == sb[i])
		i++;
	return (int)(unsigned char)sb[i] - (int)(unsigned char)sa[i];
}

static char *join_path(const char *base, const char *suffix)
{
	size_t base_len = strlen(base);
	size_t suffix_len = strlen(suffix);
	int need_slash = (base_len > 0 && base[base_len - 1] != '/');
	size_t total = base_len + (need_slash ? 1 : 0) + suffix_len + 1;
	char *result = malloc(total);
	if (!result)
		return NULL;
	memcpy(result, base, base_len);
	size_t pos = base_len;
	if (need_slash)
		result[pos++] = '/';
	memcpy(result + pos, suffix, suffix_len + 1);
	return result;
}

static void search_one_file(const char *path,
			    const unsigned char *pattern, size_t pattern_len,
			    int prefix_enabled, int *found, int *had_error)
{
	struct stat st;
	if (stat(path, &st) != 0) {
		fprintf(stderr, "c_grep: %s: %s\n", path, strerror(errno));
		*had_error = 1;
		return;
	}
	if (S_ISDIR(st.st_mode)) {
		fprintf(stderr, "c_grep: %s: Is a directory\n", path);
		*had_error = 1;
		return;
	}

	FILE *fp = fopen(path, "rb");
	if (!fp) {
		fprintf(stderr, "c_grep: %s: %s\n", path, strerror(errno));
		*had_error = 1;
		return;
	}

	unsigned char *prefix_buf = NULL;
	size_t prefix_len = 0;
	if (prefix_enabled) {
		size_t fn_len = strlen(path);
		prefix_buf = malloc(fn_len + 1);
		if (!prefix_buf) {
			fclose(fp);
			*had_error = 1;
			return;
		}
		memcpy(prefix_buf, path, fn_len);
		prefix_buf[fn_len] = ':';
		prefix_len = fn_len + 1;
	}

	int local_found = 0;
	int rc = search_stream(fp, pattern, pattern_len,
			       prefix_buf, prefix_len, &local_found);
	if (local_found)
		*found = 1;
	if (rc == -1)
		*had_error = 1;

	free(prefix_buf);
	fclose(fp);
}

static void traverse_dir(const char *dir_path,
			 const unsigned char *pattern, size_t pattern_len,
			 int prefix_enabled, int *found, int *had_error)
{
	DIR *dp = opendir(dir_path);
	if (!dp) {
		fprintf(stderr, "c_grep: %s: %s\n", dir_path, strerror(errno));
		*had_error = 1;
		return;
	}

	char **names = NULL;
	size_t count = 0, cap = 0;
	struct dirent *de;
	while ((de = readdir(dp)) != NULL) {
		if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0)
			continue;
		if (count >= cap) {
			size_t new_cap = cap == 0 ? 32 : cap * 2;
			char **tmp = realloc(names, new_cap * sizeof(*tmp));
			if (!tmp) {
				for (size_t i = 0; i < count; i++)
					free(names[i]);
				free(names);
				closedir(dp);
				*had_error = 1;
				return;
			}
			names = tmp;
			cap = new_cap;
		}
		size_t nlen = strlen(de->d_name);
		char *copy = malloc(nlen + 1);
		if (!copy) {
			for (size_t i = 0; i < count; i++)
				free(names[i]);
			free(names);
			closedir(dp);
			*had_error = 1;
			return;
		}
		memcpy(copy, de->d_name, nlen + 1);
		names[count++] = copy;
	}
	closedir(dp);

