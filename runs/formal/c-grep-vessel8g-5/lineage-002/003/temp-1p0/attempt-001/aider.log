```c
static int traverse_dir(const char *path, const char *display,
                        const unsigned char *pattern, size_t pattern_len,
                        int use_prefix, int *any_match, int *any_error)
{
    DIR *d = opendir(path);
    if (!d) {
        fprintf(stderr, "c_grep: %s: cannot open directory\n", path);
        *any_error = 1;
        return;
    }
    
    struct dirent **entries = NULL;
    int n = 0;
    struct dirent *ent;
    while ((ent = readdir(d)) != NULL) {
        // collect entries
        n++;
        entries = realloc(entries, n * sizeof(*entries));
        if (!entries) { closedir(d); *any_error = 1; return; }
        entries[n-1] = *ent;
    }
    
    // Sort by d_name in raw-byte ascending order
    qsort(entries, n, sizeof(*entries), compare_dirent);
    
    for (int i = 0; i < n; i++) {
        // Skip . and ..
        if (strcmp(entries[i].d_name, ".") == 0 || strcmp(entries[i].d_name, "..") == 0)
            continue;
        
        // Build full path
        char full_path[4096];
        join_path(full_path, sizeof(full_path), path, entries[i].d_name);
        
        // Build display path
        char disp_path[4096];
        join_path(disp_path, sizeof(disp_path), display, entries[i].d_name);
        
        struct stat st;
        if (lstat(full_path, &st) != 0) {
            fprintf(stderr, "c_grep: %s: cannot stat\n", full_path);
            *any_error = 1;
            continue;
        }
        
        if (S_ISLNK(st.st_mode)) continue; // skip symlinks
        if (S_ISREG(st.st_mode)) {
            // Search this file
            FILE *fp = fopen(full_path, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: cannot open\n", full_path);
                *any_error = 1;
                continue;
            }
            unsigned char *pfx = NULL;
            size_t pfx_len = 0;
            if (use_prefix) {
                pfx_len = strlen(disp_path) + 1;
                pfx = malloc(pfx_len);
                if (!pfx) { fclose(fp); *any_error = 1; continue; }
                memcpy(pfx, disp_path, strlen(disp_path));
                pfx[strlen(disp_path)] = ':';
            }
            int rc = search_stream(fp, pattern, pattern_len, pfx, pfx_len);
            free(pfx);
            fclose(fp);
            if (rc == 0) *any_match = 1;
            else if (rc < 0) *any_error = 1;
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full_path, disp_path, pattern, pattern_len,
                         use_prefix, any_match, any_error);
        }
        // else: skip (special files)
    }
    
    free(entries);
    closedir(d);
}
```

