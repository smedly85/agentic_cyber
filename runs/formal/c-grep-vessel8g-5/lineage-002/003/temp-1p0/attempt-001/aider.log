```c
static int join_path_safe(char *out, size_t out_cap, const char *base, const char *rel) {
    size_t base_len = strlen(base);
    size_t rel_len = strlen(rel);
    size_t needed;
    int need_slash;
    if (base_len > 0 && base[base_len - 1] == '/') {
        needed = base_len + rel_len + 1; // +1 for NUL
        need_slash = 0;
    } else {
        needed = base_len + 1 + rel_len + 1; // +1 for slash, +1 for NUL
        need_slash = 1;
    }
    if (needed > out_cap) return -1;
    if (need_slash) {
        memcpy(out, base, base_len);
        out[base_len] = '/';
        memcpy(out + base_len + 1, rel, rel_len + 1);
    } else {
        memcpy(out, base, base_len);
        memcpy(out + base_len, rel, rel_len + 1);
    }
    return 0;
}
```

