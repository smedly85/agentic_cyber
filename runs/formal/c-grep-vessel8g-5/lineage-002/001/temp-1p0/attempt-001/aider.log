            }
            if (S_ISDIR(st.st_mode)) {
                fprintf(stderr, "c_grep: %s: is a directory\n", name);
                any_error = 1;
                continue;
            }
            FILE *fp = fopen(name, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: cannot open\n", name);
                any_error = 1;
                continue;
            }
            unsigned char *pfx = NULL;
            size_t pfx_len = 0;
            if (use_prefix) {
                pfx_len = strlen(name) + 1;
                pfx = malloc(pfx_len);
                if (!pfx) {
                    fclose(fp);
                    any_error = 1;
                    continue;
                }
                memcpy(pfx, name, strlen(name));
                pfx[strlen(name)] = ':';
            }
            int rc = search_stream(fp, (const unsigned char *)pattern, plen,
                                   pfx, pfx_len);
            free(pfx);
            fclose(fp);
            if (rc == 0)
                any_match = 1;
            else if (rc < 0)
                any_error = 1;
        }
        free(files);
    }

    if (any_error)
        return 2;
    return any_match ? 0 : 1;
}
