Let me now write the full implementation:

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Fixed byte substring search. Returns pointer to first occurrence or NULL.
   Empty needle matches at position 0. */
static const unsigned char *find_sub(const unsigned char *hay, size_t hay_len,
                                     const unsigned char *needle, size_t needle_len)
{
    if (needle_len == 0)
        return hay;
    if (needle_len > hay_len)
        return NULL;
    for (size_t i = 0; i <= hay_len - needle_len; i++) {
        if (memcmp(hay + i, needle, needle_len) == 0)
            return hay + i;
    }
    return NULL;
}

/* Emit a matched line with optional prefix, followed by newline.
   Returns 0 on success, -1 on write error. */
static int emit_line(const unsigned char *prefix, size_t prefix_len,
                     const unsigned char *line, size_t line_len)
{
    if (prefix_len > 0 && fwrite(prefix, 1, prefix_len, stdout) != prefix_len)
        return -1;
    if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len)
        return -1;
    if (fputc('\n', stdout) == EOF)
        return -1;
    return 0;
}

/* Core line-selection: read lines from fp, emit those containing pattern.
   Returns: 0 if at least one match found, 1 if no match, -1 on I/O error. */
int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                  const unsigned char *prefix, size_t prefix_len)
{
    int matched = 0;
    unsigned char *buf = NULL;
    size_t buf_len = 0, buf_cap = 0;

    buf_cap = 8192;
    buf = malloc(buf_cap);
    if (!buf)
        return -1;

    int c;
    while ((c = fgetc(fp)) != EOF) {
        unsigned char ch = (unsigned char)c;
        if (ch == 0x0A) {
            /* End of line */
            if (find_sub(buf, buf_len, pattern, pattern_len) != NULL) {
                matched = 1;
                if (emit_line(prefix, prefix_len, buf, buf_len) != 0) {
                    free(buf);
                    return -1;
                }
            }
            buf_len = 0;
        } else {
            if (buf_len >= buf_cap) {
                size_t new_cap = buf_cap * 2;
                /* Check for overflow */
                if (new_cap < buf_cap) {
                    free(buf);
                    return -1;
                }
                unsigned char *newbuf = realloc(buf, new_cap);
                if (!newbuf) {
                    free(buf);
                    return -1;
                }
                buf = newbuf;
                buf_cap = new_cap;
            }
            buf[buf_len++] = ch;
        }
    }

    /* Final unterminated line */
    if (buf_len > 0) {
        if (find_sub(buf, buf_len, pattern, pattern_len) != NULL) {
            matched = 1;
            if (emit_line(prefix, prefix_len, buf, buf_len) != 0) {
                free(buf);
                return -1;
            }
        }
    }

    free(buf);
    return matched ? 0 : 1;
}

int main(int argc, char *argv[])
{
    /* Parse arguments */
    const char *pattern = NULL;
    const char **files = NULL;
    size_t nfiles = 0;
    size_t files_cap = 0;
    int options_done = 0;

    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (!options_done) {
            if (strcmp(arg, "--") == 0) {
                options_done = 1;
                continue;
            }
            if (arg[0] == '-' && arg[1] != '\0') {
                /* Unsupported option (not `-` which is a filename) */
                fprintf(stderr, "c_grep: unsupported option '%s'\n", arg);
                fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
                return 2;
            }
        }
        /* Positional argument */
        if (pattern == NULL) {
            pattern = arg;
        } else {
            if (nfiles >= files_cap) {
                size_t new_cap = files_cap ? files_cap * 2 : 4;
                const char **newfiles = realloc(files, new_cap * sizeof *newfiles);
                if (!newfiles) {
                    free(files);
                    fprintf(stderr, "c_grep: out of memory\n");
                    return 2;
                }
                files = newfiles;
                files_cap = new_cap;
            }
            files[nfiles++] = arg;
        }
    }

    if (pattern == NULL) {
        fprintf(stderr, "c_grep: missing PATTERN\n");
        fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
        return 2;
    }

    size_t pattern_len = strlen(pattern);
    int any_match = 0;
    int any_error = 0;

    if (nfiles == 0) {
        /* Search stdin, no prefix */
        int rc = search_stream(stdin, (const unsigned char *)pattern, pattern_len,
                              NULL, 0);
        if (rc == 0)
            any_match = 1;
        else if (rc == -1)
            any_error = 1;
    } else {
        int use_prefix = (nfiles >= 2);
        for (size_t i = 0; i < nfiles; i++) {
            const char *name = files[i];
            FILE *fp = fopen(name, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: cannot open\n", name);
                any_error = 1;
                continue;
            }
            /* Check if it's a directory */
            /* Actually, fopen on a directory may succeed on some systems.
               Let's use access() or fstat() to check. */
            /* On Linux, opening a directory for reading succeeds but read fails.
               Let's just try to read and handle the error. */
            
            unsigned char *prefix_buf = NULL;
            size_t prefix_len = 0;
            if (use_prefix) {
                prefix_len = strlen(name) + 1; /* name + ':' */
                prefix_buf = malloc(prefix_len);
                if (!prefix_buf) {
                    fclose(fp);
                    fprintf(stderr, "c_grep: out of memory\n");
                    any_error = 1;
                    continue;
                }
                memcpy(prefix_buf, name, strlen(name));
                prefix_buf[strlen(name)] = ':';
            }
            
            int rc = search_stream(fp, (const unsigned char *)pattern, pattern_len,
                                  prefix_buf, prefix_len);
            free(prefix_buf);
            fclose(fp);
            
            if (rc == 0)
                any_match = 1;
            else if (rc == -1) {
                any_error = 1;
            }
        }
        free(files);
    }

    if (any_error)
        return 2;
    return any_match ? 0 : 1;
}
