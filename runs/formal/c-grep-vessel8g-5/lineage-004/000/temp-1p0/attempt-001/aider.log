int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                  const char *prefix, size_t prefix_len, int *had_error) {
    int matched = 0;
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    int c;
    
    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            // Process the line
            if (pattern_len == 0 || contains(line, line_len, pattern, pattern_len)) {
                if (prefix_len > 0) {
                    fwrite(prefix, 1, prefix_len, stdout);
                }
                if (line_len > 0) {
                    fwrite(line, 1, line_len, stdout);
                }
                fputc('\n', stdout);
                matched++;
            }
            line_len = 0;
        } else {
            if (line_len + 1 >= line_cap) {
                size_t new_cap = line_cap ? line_cap * 2 : 4096;
                unsigned char *new_line = realloc(line, new_cap);
                if (!new_line) {
                    free(line);
                    *had_error = 1;
                    return matched;
                }
                line = new_line;
                line_cap = new_cap;
            }
            line[line_len++] = (unsigned char)c;
        }
    }
    
    // Final unterminated line
    if (line_len > 0) {
        if (pattern_len == 0 || contains(line, line_len, pattern, pattern_len)) {
            if (prefix_len > 0) {
                fwrite(prefix, 1, prefix_len, stdout);
            }
            fwrite(line, 1, line_len, stdout);
            fputc('\n', stdout);
            matched++;
        }
    }
    
    free(line);
    return matched;
}
```

