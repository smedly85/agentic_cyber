#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdbool.h>

static int contains_bytes(const unsigned char *haystack, size_t hlen,
                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    size_t limit = hlen - nlen;
    for (size_t i = 0; i <= limit; i++) {
        if (memcmp(haystack + i, needle, nlen) == 0) return 1;
    }
    return 0;
}

static int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                         const char *prefix, size_t prefix_len, int *had_error) {
    int matched = 0;
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    
    for (;;) {
        int c = fgetc(fp);
        if (c == EOF) {
            if (ferror(fp)) {
                *had_error = 1;
                free(line);
                return matched;
            }
            break;
        }
        if (c == '\n') {
            if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
                size_t total = prefix_len + line_len + 1;
                if (prefix_len > 0 && fwrite(prefix, 1, prefix_len, stdout) != prefix_len) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                if (fputc('\n', stdout) == EOF) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                matched++;
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                if (line_cap > (SIZE_MAX - 4096) / 2) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                size_t new_cap = line_cap ? line_cap * 2 : 4096;
                unsigned char *new_line = realloc(line, new_cap);
                if (!new_line) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                line = new_line;
                line_cap = new_cap;
            }
            line[line_len++] = (unsigned char)c;
        }
    }
    
    // Final unterminated line (line_len > 0 means we have data)
    if (line_len > 0) {
        if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
            if (prefix_len > 0 && fwrite(prefix, 1, prefix_len, stdout) != prefix_len) {
                *had_error = 1;
                free(line);
                return matched;
            }
            if (fwrite(line, 1, line_len, stdout) != line_len) {
                *had_error = 1;
                free(line);
                return matched;
            }
            if (fputc('\n', stdout) == EOF) {
                *had_error = 1;
                free(line);
                return matched;
            }
            matched++;
        }
    }
    
    free(line);
    return matched;
}
