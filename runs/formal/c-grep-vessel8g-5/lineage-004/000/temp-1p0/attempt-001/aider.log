#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdbool.h>

/* Forward declaration - semantic anchor */
static int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                         const char *prefix, size_t prefix_len);

static int contains_bytes(const unsigned char *haystack, size_t hlen,
                          const unsigned char *needle, size_t nlen) {
    if (nlen == 0) return 1;
    if (nlen > hlen) return 0;
    size_t limit = hlen - nlen;
    for (size_t i = 0; i <= limit; i++) {
        if (memcmp(haystack + i, needle, nlen) == 0) return 1;
    }
    return 0;
}

static int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                         const char *prefix, size_t prefix_len) {
    int matched = 0;
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    int c;
    
    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
                if (prefix_len > 0 && fwrite(prefix, 1, prefix_len, stdout) != prefix_len) {
                    free(line);
                    return matched; // write error, but we'll handle exit code in main
                }
                if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len) {
                    free(line);
                    return matched;
                }
                if (fputc('\n', stdout) == EOF) {
                    free(line);
                    return matched;
                }
                matched++;
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                size_t new_cap = line_cap ? line_cap * 2 : 4096;
                // Check for overflow
                if (new_cap < 4096) new_cap = 4096; // overflow
                unsigned char *new_line = realloc(line, new_cap);
                if (!new_line) {
                    free(line);
                    return matched; // allocation error
                }
                line = new_line;
                line_cap = new_cap;
            }
            line[line_len++] = (unsigned char)c;
        }
    }
    
    // Final unterminated line
    if (line_len > 0) {
        if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
            if (prefix_len > 0) fwrite(prefix, 1, prefix_len, stdout);
            fwrite(line, 1, line_len, stdout);
            fputc('\n', stdout);
            matched++;
        }
    }
    
    free(line);
    return matched;
}
```

