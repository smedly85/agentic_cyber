static int search_stream(FILE *fp, const unsigned char *pattern, size_t pattern_len,
                         const char *prefix, size_t prefix_len, int *had_error)
{
    int matched = 0;
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;

    for (;;) {
        int c = fgetc(fp);
        if (c == EOF) break;
        if (c == '\n') {
            if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
                if (prefix_len > 0 &&
                    fwrite(prefix, 1, prefix_len, stdout) != prefix_len) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                if (line_len > 0 &&
                    fwrite(line, 1, line_len, stdout) != line_len) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                if (fputc('\n', stdout) == EOF) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                matched++;
            }
            line_len = 0;
        } else {
            if (line_len + 1 > line_cap) {
                if (line_cap > SIZE_MAX / 2) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                size_t new_cap = line_cap ? line_cap * 2 : 4096;
                unsigned char *new_line = realloc(line, new_cap);
                if (!new_line) {
                    *had_error = 1;
                    free(line);
                    return matched;
                }
                line = new_line;
                line_cap = new_cap;
            }
            line[line_len++] = (unsigned char)c;
        }
    }

    if (ferror(fp)) {
        *had_error = 1;
    }

    if (line_len > 0) {
        if (pattern_len == 0 || contains_bytes(line, line_len, pattern, pattern_len)) {
            if (prefix_len > 0 &&
                fwrite(prefix, 1, prefix_len, stdout) != prefix_len) {
                *had_error = 1;
                free(line);
                return matched;
            }
            if (fwrite(line, 1, line_len, stdout) != line_len) {
                *had_error = 1;
                free(line);
                return matched;
            }
            if (fputc('\n', stdout) == EOF) {
                *had_error = 1;
                free(line);
                return matched;
            }
            matched++;
        }
    }

    free(line);
    return matched;
}

