```c
static int search_recursive(const char *dir_path, size_t dir_path_len,
                            const unsigned char *pattern, size_t pattern_len,
                            int use_prefix, int *had_error)
{
    int matched = 0;
    DIR *dp = opendir(dir_path);
    if (!dp) {
        fprintf(stderr, "c_grep: %s: %s\n", dir_path, strerror(errno));
        *had_error = 1;
        return 0;
    }

    struct dirent **entries = NULL;
    size_t entry_count = 0;
    size_t entry_cap = 0;

    struct dirent *dent;
    while ((dent = readdir(dp)) != NULL) {
        if (strcmp(dent->d_name, ".") == 0 || strcmp(dent->d_name, "..") == 0)
            continue;
        if (entry_count >= entry_cap) {
            size_t new_cap = entry_cap ? entry_cap * 2 : 16;
            struct dirent **new_entries = realloc(entries, new_cap * sizeof *entries);
            if (!new_entries) {
                *had_error = 1;
                for (size_t i = 0; i < entry_count; i++) free(entries[i]);
                free(entries);
                closedir(dp);
                return matched;
            }
            entries = new_entries;
            entry_cap = new_cap;
        }
        struct dirent *copy = malloc(sizeof *copy);
        if (!copy) {
            *had_error = 1;
            for (size_t i = 0; i < entry_count; i++) free(entries[i]);
            free(entries);
            closedir(dp);
            return matched;
        }
        *copy = *dent;
        entries[entry_count++] = copy;
    }
    closedir(dp);

    if (entry_count > 1) {
        qsort(entries, entry_count, sizeof *entries, cmp_dirent_name);
    }

    // Determine if dir_path ends with '/'
    int has_trailing_slash = (dir_path_len > 0 && dir_path[dir_path_len - 1] == '/');
    size_t sep_len = has_trailing_slash ? 0 : 1;

    for (size_t i = 0; i < entry_count; i++) {
        const char *name = entries[i]->d_name;
        size_t name_len = strlen(name);
        
        // Build full path
        size_t full_len = dir_path_len + sep_len + name_len;
        char *full_path = malloc(full_len + 1);
        if (!full_path) {
            *had_error = 1;
            free(entries[i]);
            continue;
        }
        memcpy(full_path, dir_path, dir_path_len);
        if (sep_len > 0) full_path[dir_path_len] = '/';
        memcpy(full_path + dir_path_len + sep_len, name, name_len);
        full_path[full_len] = '\0';

        struct stat sb;
        if (lstat(full_path, &sb) != 0) {
            fprintf(stderr, "c_grep: %s: %s\n", full_path, strerror(errno));
            *had_error = 1;
            free(full_path);
            free(entries[i]);
            continue;
        }

        if (S_ISLNK(sb.st_mode)) {
            // Skip symlinks during traversal
            free(full_path);
            free(entries[i]);
            continue;
        }

        if (S_ISREG(sb.st_mode)) {
            int fd = open(full_path, O_RDONLY);
            if (fd < 0) {
                fprintf(stderr, "c_grep: %s: %s\n", full_path, strerror(errno));
                *had_error = 1;
                free(full_path);
                free(entries[i]);
                continue;
            }
            FILE *fp = fdopen(fd, "r");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", full_path, strerror(errno));
                close(fd);
                free(full_path);
                free(entries[i]);
                continue;
            }

            const char *prefix = NULL;
            size_t prefix_len = 0;
            char *prefix_buf = NULL;
            if (use_prefix) {
                prefix_buf = malloc(full_len + 2);
                if (!prefix_buf) {
                    fprintf(stderr, "c_grep: %s: memory allocation failed\n", full_path);
                    *had_error = 1;
                    fclose(fp);
                    free(full_path);
                    free(entries[i]);
                    continue;
                }
                memcpy(prefix_buf, full_path, full_len);
                prefix_buf[full_len] = ':';
                prefix_buf[full_len + 1] = '\0';
                prefix = prefix_buf;
                prefix_len = full_len + 1;
            }

            matched += search_stream(fp, pattern, pattern_len, prefix, prefix_len, had_error);
            free(prefix_buf);
            fclose(fp);
        } else if (S_ISDIR(sb.st_mode)) {
            matched += search_recursive(full_path, full_len, pattern, pattern_len,
                                        use_prefix, had_error);
        }
        // Other types (fifo, socket, device) are silently skipped

        free(full_path);
        free(entries[i]);
    }

    free(entries);
    return matched;
}
