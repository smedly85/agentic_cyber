#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <fcntl.h>

/* search_stream: core line-selection behavior
   Returns 1 if any line was selected, 0 if not.
   Returns -1 on allocation error.
   pattern: fixed byte substring to match
   plen: length of pattern
   prefix: string to prepend to each matched line (may be NULL)
   prefix_len: length of prefix (may be 0)
   fp: the input stream
*/
static int search_stream(FILE *fp, const unsigned char *pattern, size_t plen,
                         const char *prefix, size_t prefix_len) {
    int found = 0;
    size_t cap = 0, len = 0;
    unsigned char *buf = NULL;
    int c;

    while ((c = fgetc(fp)) != EOF) {
        if (c == '\n') {
            /* process line in buf[0..len) */
            if (plen == 0 || (len >= plen && memmem(buf, len, pattern, plen) != NULL)) {
                if (prefix_len > 0) {
                    if (fwrite(prefix, 1, prefix_len, stdout) == 0)
                        goto io_error;
                }
                if (len > 0) {
                    if (fwrite(buf, 1, len, stdout) == 0)
                        goto io_error;
                }
                if (fputc('\n', stdout) == EOF)
                    goto io_error;
                found = 1;
            }
            len = 0;
        } else {
            if (len + 1 > cap) {
                size_t newcap = cap ? cap * 2 : 4096;
                unsigned char *newbuf = realloc(buf, newcap);
                if (!newbuf) {
                    free(buf);
                    return -1;
                }
                buf = newbuf;
                cap = newcap;
            }
            buf[len++] = (unsigned char)c;
        }
    }

    /* final unterminated line */
    if (len > 0) {
        if (plen == 0 || memmem(buf, len, pattern, plen) != NULL) {
            if (prefix_len > 0) {
                if (fwrite(prefix, 1, prefix_len, stdout) == 0)
                    goto io_error;
            }
            if (fwrite(buf, 1, len, stdout) == 0)
                goto io_error;
            if (fputc('\n', stdout) == EOF)
                goto io_error;
            found = 1;
        }
    }

    free(buf);
    return found;

io_error:
    free(buf);
    return -1;
}
