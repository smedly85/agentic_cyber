```c
int main(int argc, char *argv[]) {
    /* Parse: skip options (only -- is supported), collect non-options */
    const char **non_opts = NULL;
    int non_opt_count = 0;
    
    int i = 1;
    int after_ddash = 0;
    
    while (i < argc) {
        if (!after_ddash && strcmp(argv[i], "--") == 0) {
            after_ddash = 1;
            i++;
            continue;
        }
        if (!after_ddash && argv[i][0] == '-' && argv[i][1] != '\0') {
            /* unsupported option */
            fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
            return 2;
        }
        /* It's a non-option */
        non_opts = realloc(non_opts, (non_opt_count + 1) * sizeof(*non_opts));
        if (!non_opts) return 2;
        non_opts[non_opt_count++] = argv[i];
        i++;
    }
    
    if (non_opt_count < 1) {
        fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
        free((void*)non_opts);
        return 2;
    }
    
    const char *pattern = non_opts[0];
    size_t plen = strlen(pattern);
    int file_count = non_opt_count - 1;
    
    int any_found = 0;
    int any_error = 0;
    
    if (file_count == 0) {
        /* Search stdin */
        int r = search_stream(stdin, (const unsigned char*)pattern, plen, NULL, 0);
        if (r < 0) any_error = 1;
        else if (r) any_found = 1;
    } else {
        int multi = (file_count >= 2);
        for (int f = 0; f < file_count; f++) {
            const char *path = non_opts[1 + f];
            
            if (multi) {
                /* Need prefix: path + ":" */
                size_t pathlen = strlen(path);
                char *prefix = malloc(pathlen + 2);
                if (!prefix) { any_error = 1; free((void*)non_opts); return 2; }
                memcpy(prefix, path, pathlen);
                prefix[pathlen] = ':';
                prefix[pathlen + 1] = '\0';
                
                FILE *fp = fopen(path, "rb");
                if (!fp) {
                    fprintf(stderr, "c_grep: %s: %s\n", path, strerror(errno));
                    any_error = 1;
                    free(prefix);
                    continue;
                }
                int r = search_stream(fp, (const unsigned char*)pattern, plen, prefix, pathlen + 1);
                free(prefix);
                if (r < 0) {
                    fprintf(stderr, "c_grep: %s: read error\n", path);
                    any_error = 1;
                } else if (r) any_found = 1;
                fclose(fp);
            } else {
                /* Single file, no prefix */
                FILE *fp = fopen(path, "rb");
                if (!fp) {
                    fprintf(stderr, "c_grep: %s: %s\n", path, strerror(errno));
                    any_error = 1;
                    continue;
                }
                int r = search_stream(fp, (const unsigned char*)pattern, plen, NULL, 0);
                if (r < 0) {
                    fprintf(stderr, "c_grep: %s: read error\n", path);
                    any_error = 1;
                } else if (r) any_found = 1;
                fclose(fp);
            }
        }
    }
    
    free((void*)non_opts);
    
    if (any_error) return 2;
    if (any_found) return 0;
    return 1;
}
```

