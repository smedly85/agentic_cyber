            if (r < 0) {
                fprintf(stderr, "c_grep: %s: read error\n", path);
                any_error = 1;
            } else if (r) {
                any_found = 1;
            }
            fclose(fp);
            free(prefix);
        }
    }

    free(args);

    if (any_error) return 2;
    if (any_found) return 0;
    return 1;
}
