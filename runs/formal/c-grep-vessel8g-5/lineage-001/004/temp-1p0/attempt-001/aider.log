            any_error = 1;
        } else if (r) {
            any_found = 1;
        }
    } else {
        int multi;
        if (with_filename == 1) {
            multi = 1;
        } else if (with_filename == 0) {
            multi = 0;
        } else if (recursive) {
            int any_dir = 0;
            for (int i = 1; i < count; i++) {
                struct stat st;
                if (stat(args[i], &st) == 0 && S_ISDIR(st.st_mode)) {
                    any_dir = 1;
