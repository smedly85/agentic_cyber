```c
static int traverse_dir(const char *base,
                        const unsigned char *pattern, size_t plen,
                        int multi, int *found, int *error) {
    DIR *dp = opendir(base);
    if (!dp) {
        fprintf(stderr, "c_grep: %s: %s\n", base, strerror(errno));
        *error = 1;
        return;
    }
    
    /* Collect entry names */
    char **names = NULL;
    size_t n = 0, cap = 0;
    struct dirent *de;
    int alloc_fail = 0;
    
    while ((de = readdir(dp)) != NULL) {
        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0)
            continue;
        size_t len = strlen(de->d_name);
        char *dup = malloc(len + 1);
        if (!dup) { alloc_fail = 1; break; }
        memcpy(dup, de->d_name, len + 1);
        if (n == cap) {
            cap = cap ? cap * 2 : 16;
            char **tmp = realloc(names, cap * sizeof(*tmp));
            if (!tmp) { free(dup); alloc_fail = 1; break; }
            names = tmp;
        }
        names[n++] = dup;
    }
    closedir(dp);
    
    if (alloc_fail) {
        fprintf(stderr, "c_grep: %s: cannot allocate memory\n", base);
        *error = 1;
        for (size_t i = 0; i < n; i++) free(names[i]);
        free(names);
        return;
    }
    
    /* Sort: ascending raw-byte order */
    /* Use qsort with strcmp comparator (C locale = byte order) */
    
    for (size_t i = 0; i < n; i++) {
        /* Build full path */
        size_t blen = strlen(base);
        int slash = (blen == 0 || base[blen-1] != '/');
        size_t elen = strlen(names[i]);
        size_t flen = blen + (slash ? 1 : 0) + elen + 1;
        char *full = malloc(flen);
        if (!full) {
            fprintf(stderr, "c_grep: %s: cannot allocate memory\n", names[i]);
            *error = 1;
            continue;
        }
        size_t off = 0;
        memcpy(full, base, blen); off = blen;
        if (slash) full[off++] = '/';
        memcpy(full + off, names[i], elen + 1);
        
        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
            *error = 1;
        } else if (S_ISLNK(st.st_mode)) {
            /* skip */
        } else if (S_ISREG(st.st_mode)) {
            FILE *fp = fopen(full, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
                *error = 1;
            } else {
                int r;
                if (multi) {
                    char *prefix = malloc(flen + 1);
                    if (prefix) {
                        memcpy(prefix, full, flen - 1);
                        prefix[flen - 1] = ':';
                        prefix[flen] = '\0';
                        r = search_stream(fp, pattern, plen, prefix, flen);
                        free(prefix);
                    } else {
                        r = search_stream(fp, pattern, plen, NULL, 0);
                    }
                } else {
                    r = search_stream(fp, pattern, plen, NULL, 0);
                }
                if (r < 0) {
                    fprintf(stderr, "c_grep: %s: read error\n", full);
                    *error = 1;
                } else if (r) {
                    *found = 1;
                }
                fclose(fp);
            }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full, pattern, plen, multi, found, error);
        }
        
        free(full);
    }
    
    for (size_t i = 0; i < n; i++) free(names[i]);
    free(names);
}
```

