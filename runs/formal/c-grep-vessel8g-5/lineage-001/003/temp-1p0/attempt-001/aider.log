static int traverse_dir(const char *base,
                        const unsigned char *pattern, size_t plen,
                        int multi,
                        int *any_found, int *any_error) {
    DIR *dp = opendir(base);
    if (!dp) {
        fprintf(stderr, "c_grep: %s: %s\n", base, strerror(errno));
        *any_error = 1;
        return;
    }

    /* Collect entries */
    char **names = NULL;
    size_t ncount = 0, ncap = 0;
    struct dirent *de;
    while ((de = readdir(dp)) != NULL) {
        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0)
            continue;
        size_t len = strlen(de->d_name) + 1;
        char *dup = malloc(len);
        if (!dup) {
            fprintf(stderr, "c_grep: %s: cannot allocate memory\n", base);
            *any_error = 1;
            closedir(dp);
            /* free names array */
            for (size_t i = 0; i < ncount; i++) free(names[i]);
            free(names);
            return;
        }
        memcpy(dup, de->d_name, len);
        if (ncount == ncap) {
            ncap = ncap ? ncap * 2 : 16;
            char **nn = realloc(names, ncap * sizeof(*nn));
            if (!nn) {
                free(dup);
                fprintf(stderr, "c_grep: %s: cannot allocate memory\n", base);
                *any_error = 1;
                closedir(dp);
                for (size_t i = 0; i < ncount; i++) free(names[i]);
                free(names);
                return;
            }
            names = nn;
        }
        names[ncount++] = dup;
    }
    closedir(dp);

    /* Sort by raw-byte name */
    qsort(names, ncount, sizeof(*names), cmp_name);

    /* Process each entry */
    int base_len = strlen(base);
    int need_slash = (base_len > 0 && base[base_len - 1] != '/');

    for (size_t i = 0; i < ncount; i++) {
        size_t entry_len = strlen(names[i]);
        size_t full_len = base_len + (need_slash ? 1 : 0) + entry_len + 1;
        char *full = malloc(full_len);
        if (!full) {
            fprintf(stderr, "c_grep: cannot allocate memory\n");
            *any_error = 1;
            continue;
        }
        memcpy(full, base, base_len);
        size_t off = base_len;
        if (need_slash) { full[off++] = '/'; }
        memcpy(full + off, names[i], entry_len + 1);

        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
            *any_error = 1;
            free(full);
            continue;
        }

        if (S_ISLNK(st.st_mode)) {
            /* Skip symlinks during traversal */
            free(full);
            continue;
        } else if (S_ISREG(st.st_mode)) {
            FILE *fp = fopen(full, "rb");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
                *any_error = 1;
            } else {
                const char *prefix = multi ? full : NULL;
                size_t prefix_len = multi ? strlen(full) + 1 : 0;
                /* Need to build prefix with colon */
                ...
            }
        } else if (S_ISDIR(st.st_mode)) {
            traverse_dir(full, pattern, plen, multi, any_found, any_error);
        }
        /* Other types (FIFO, socket, device): skip */
        
        free(full);
        free(names[i]);
    }
    free(names);
}
```

