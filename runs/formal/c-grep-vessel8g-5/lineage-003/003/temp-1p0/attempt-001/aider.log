```c
/* Build a path by appending `name` to `base`, avoiding a doubled separator
   if `base` already ends with '/'. Returns a malloc'd string or NULL. */
static char *build_path(const char *base, const char *name) {
    size_t blen = strlen(base);
    size_t nlen = strlen(name);
    int need_slash = (blen > 0 && base[blen - 1] != '/');
    size_t total = blen + (need_slash ? 1 : 0) + nlen + 1;
    char *result = malloc(total);
    if (!result)
        return NULL;
    memcpy(result, base, blen);
    size_t pos = blen;
    if (need_slash)
        result[pos++] = '/';
    memcpy(result + pos, name, nlen + 1);
    return result;
}

/* qsort comparator: ascending raw-byte order. */
static int compare_names(const void *a, const void *b) {
    const char *sa = *(const char *const *)a;
    const char *sb = *(const char *const *)b;
    size_t la = strlen(sa);
    size_t lb = strlen(sb);
    size_t min = la < lb ? la : lb;
    int cmp = (min > 0) ? memcmp(sa, sb, min) : 0;
    if (cmp != 0)
        return cmp < 0 ? -1 : 1;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

/* Pre-order recursive traversal of `dir_path`.
   Searches regular files, descends into directories, skips symlinks.
   Entries are visited in ascending raw-byte name order. */
static void recursive_search(const char *dir_path, const char *pattern,
                             int use_prefix,
                             int *overall_match, int *overall_error) {
    DIR *dp = opendir(dir_path);
    if (!dp) {
        fprintf(stderr, "c_grep: %s: %s\n", dir_path, strerror(errno));
        *overall_error = 1;
        return;
    }

    char **names = NULL;
    int n = 0, cap = 0;

    while (1) {
        errno = 0;
        struct dirent *entry = readdir(dp);
        if (!entry) {
            if (errno != 0) {
                fprintf(stderr, "c_grep: %s: %s\n", dir_path, strerror(errno));
                *overall_error = 1;
                for (int i = 0; i < n; i++) free(names[i]);
                free(names);
                closedir(dp);
                return;
            }
            break;
        }
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;
        if (n == cap) {
            int ncap = cap ? cap * 2 : 64;
            char **nn = realloc(names, (size_t)ncap * sizeof(char *));
            if (!nn) {
                for (int i = 0; i < n; i++) free(names[i]);
                free(names);
                closedir(dp);
                *overall_error = 1;
                return;
            }
            names = nn;
            cap = ncap;
        }
        names[n] = strdup(entry->d_name);
        if (!names[n]) {
            for (int i = 0; i < n; i++) free(names[i]);
            free(names);
            closedir(dp);
            *overall_error = 1;
            return;
        }
        n++;
    }
    closedir(dp);

    qsort(names, (size_t)n, sizeof(char *), compare_names);

    for (int i = 0; i < n; i++) {
        char *full = build_path(dir_path, names[i]);
        if (!full) {
            *overall_error = 1;
            for (int j = i; j < n; j++) free(names[j]);
            free(names);
            return;
        }

        struct stat st;
        if (lstat(full, &st) != 0) {
            fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
            *overall_error = 1;
            free(full);
            continue;
        }

        if (S_ISLNK(st.st_mode)) {
            /* Skip symlinks encountered during traversal. */
            free(full);
            continue;
        }

        if (S_ISREG(st.st_mode)) {
            FILE *fp = fopen(full, "r");
            if (!fp) {
                fprintf(stderr, "c_grep: %s: %s\n", full, strerror(errno));
                *overall_error = 1;
            } else {
                const char *pfx = use_prefix ? full : NULL;
                size_t pfx_len = use_prefix ? strlen(full) : 0;
                int r = search_stream(fp, pattern, pfx, pfx_len);
                fclose(fp);
                if (r < 0)
                    *overall_error = 1;
                else if (r > 0)
                    *overall_match = 1;
            }
        } else if (S_ISDIR(st.st_mode)) {
            recursive_search(full, pattern, use_prefix,
                             overall_match, overall_error);
        }
        /* Other types (fifo, socket, device) are skipped. */

        free(full);
    }

    for (int i = 0; i < n; i++) free(names[i]);
    free(names);
}
