```c
static char *build_path(const char *base, const char *name) {
    size_t base_len = strlen(base);
    size_t name_len = strlen(name);
    int needs_slash = (base_len > 0 && base[base_len - 1] != '/');
    size_t total = base_len + (needs_slash ? 1 : 0) + name_len + 1;
    char *result = malloc(total);
    if (!result) return NULL;
    memcpy(result, base, base_len);
    size_t pos = base_len;
    if (needs_slash) result[pos++] = '/';
    memcpy(result + pos, name, name_len + 1);
    return result;
}
```

