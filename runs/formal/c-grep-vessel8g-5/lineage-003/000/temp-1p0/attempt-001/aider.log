```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <limits.h>

static int line_matches(const unsigned char *line, size_t line_len,
                        const unsigned char *pattern, size_t pattern_len) {
    if (pattern_len == 0) return 1;
    if (line_len < pattern_len) return 0;
    for (size_t i = 0; i + pattern_len <= line_len; i++) {
        if (memcmp(line + i, pattern, pattern_len) == 0) return 1;
    }
    return 0;
}

int search_stream(FILE *stream, const char *pattern, const char *prefix,
                  size_t prefix_len) {
    size_t pattern_len = strlen(pattern);
    int has_match = 0;
    int had_error = 0;

    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;

    unsigned char buf[8192];
    size_t buf_len;

    while ((buf_len = fread(buf, 1, sizeof(buf), stream)) > 0) {
        size_t pos = 0;
        while (pos < buf_len) {
            if (buf[pos] == '\n') {
                if (line_matches(line, line_len, (const unsigned char *)pattern, pattern_len)) {
                    if (prefix && prefix_len > 0) {
                        if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) had_error = 1;
                        if (fputc(':', stdout) == EOF) had_error = 1;
                    }
                    if (line_len > 0) {
                        if (fwrite(line, 1, line_len, stdout) != line_len) had_error = 1;
                    }
                    if (fputc('\n', stdout) == EOF) had_error = 1;
                    has_match = 1;
                }
                line_len = 0;
                pos++;
            } else {
                if (line_len == line_cap) {
                    size_t new_cap;
                    if (line_cap == 0) new_cap = 4096;
                    else if (line_cap > SIZE_MAX / 2) { new_cap = 0; }
                    else new_cap = line_cap * 2;
                    if (new_cap == 0) {
                        free(line);
                        had_error = 1;
                        goto cleanup;
                    }
                    unsigned char *nl = realloc(line, new_cap);
                    if (!nl) {
                        free(line);
                        line = NULL;
                        line_cap = 0;
                        had_error = 1;
                        goto cleanup;
                    }
                    line = nl;
                    line_cap = new_cap;
                }
                line[line_len++] = buf[pos++];
            }
        }
    }

    if (ferror(stream)) had_error = 1;

    // Final unterminated line
    if (!had_error && line_len > 0) {
        if (line_matches(line, line_len, (const unsigned char *)pattern, pattern_len)) {
            if (prefix && prefix_len > 0) {
                if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) had_error = 1;
                if (fputc(':', stdout) == EOF) had_error = 1;
            }
            if (line_len > 0) {
                if (fwrite(line, 1, line_len, stdout) != line_len) had_error = 1;
            }
            if (fputc('\n', stdout) == EOF) had_error = 1;
            has_match = 1;
        }
    }

cleanup:
    free(line);
    if (had_error) return -1;
    return has_match ? 1 : 0;
}

int main(int argc, char *argv[]) {
    // Parse arguments
    int i = 1;
    int options_done = 0;
    const char *pattern = NULL;
    char **files = NULL;
    int nfiles = 0;

    for (; i < argc; i++) {
        if (!options_done && argv[i][0] == '-' && strlen(argv[i]) > 1) {
            if (strcmp(argv[i], "--") == 0) {
                options_done = 1;
                continue;
            }
            // Unsupported option
            fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
            return 2;
        }
        if (pattern == NULL) {
            pattern = argv[i];
        } else {
            char **nf = realloc(files, (size_t)(nfiles + 1) * sizeof(char *));
            if (!nf) {
                free(files);
                fprintf(stderr, "c_grep: memory allocation failed\n");
                return 2;
            }
            files = nf;
            files[nfiles++] = argv[i];
        }
