int search_stream(FILE *stream, const char *pattern, const char *prefix, size_t prefix_len) {
    size_t pattern_len = strlen(pattern);
    int has_match = 0;
    
    // Read line by line, handling arbitrary bytes
    char *line = NULL;
    size_t line_cap = 0;
    size_t line_len = 0;
    int c;
    
    // Read byte by byte to handle arbitrary bytes (including NUL)
    while ((c = fgetc(stream)) != EOF) {
        if (c == '\n') {
            // We have a complete line
            if (matches(line, line_len, pattern, pattern_len)) {
                if (prefix) {
                    fwrite(prefix, 1, prefix_len, stdout);
                    fputc(':', stdout);
                }
                fwrite(line, 1, line_len, stdout);
                fputc('\n', stdout);
                has_match = 1;
            }
            line_len = 0;
        } else {
            if (line_len == line_cap) {
                line_cap = line_cap ? line_cap * 2 : 256;
                char *new_line = realloc(line, line_cap);
                if (!new_line) {
                    free(line);
                    return has_match; // allocation failure
                }
                line = new_line;
            }
            line[line_len++] = (char)c;
        }
    }
    
    // Final unterminated line
    if (line_len > 0) {
        if (matches(line, line_len, pattern, pattern_len)) {
            if (prefix) {
                fwrite(prefix, 1, prefix_len, stdout);
                fputc(':', stdout);
            }
            fwrite(line, 1, line_len, stdout);
            fputc('\n', stdout);
            has_match = 1;
        }
    }
    
    free(line);
    return has_match;
}
