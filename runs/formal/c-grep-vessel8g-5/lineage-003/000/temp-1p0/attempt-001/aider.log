```c
int main(int argc, char *argv[]) {
    // Parse arguments
    int i = 1;
    int options_done = 0;
    
    // Find pattern and files
    char *pattern = NULL;
    char **files = NULL;
    int nfiles = 0;
    
    for (; i < argc; i++) {
        if (!options_done) {
            if (strcmp(argv[i], "--") == 0) {
                options_done = 1;
                continue;
            }
            if (argv[i][0] == '-' && strlen(argv[i]) > 1) {
                // Unsupported option
                fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
                return 2;
            }
        }
        if (pattern == NULL) {
            pattern = argv[i];
        } else {
            // file operand
            files = realloc(files, (nfiles + 1) * sizeof(char*));
            files[nfiles++] = argv[i];
        }
    }
    
    if (pattern == NULL) {
        fprintf(stderr, "usage: c_grep PATTERN [FILE...]\n");
        return 2;
    }
    
    // Now search
    int has_match = 0;
    int had_error = 0;
    
    if (nfiles == 0) {
        // Search stdin
        has_match |= search_stream(stdin, pattern, NULL, 0);
    } else {
        int prefix = (nfiles >= 2);
        for (int f = 0; f < nfiles; f++) {
            FILE *fp = fopen(files[f], "r");
            if (!fp) {
                // Check if it's a directory
                struct stat st;
                if (stat(files[f], &st) == 0 && S_ISDIR(st.st_mode)) {
                    fprintf(stderr, "c_grep: %s: Is a directory\n", files[f]);
                } else {
                    fprintf(stderr, "c_grep: %s: %s\n", files[f], strerror(errno));
                }
                had_error = 1;
                continue;
            }
            char *prefix_str = prefix ? files[f] : NULL;
            int plen = prefix ? (int)strlen(files[f]) : 0;
            has_match |= search_stream(fp, pattern, prefix_str, plen);
            fclose(fp);
        }
    }
    
    free(files);
    
    if (had_error) return 2;
    return has_match ? 0 : 1;
}
```

