int search_stream(FILE *stream, const char *pattern, const char *prefix, size_t prefix_len) {
    size_t pattern_len = strlen(pattern);
    int has_match = 0;
    int had_error = 0;
    
    // Accumulate current line
    unsigned char *line = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    
    // Read buffer
    unsigned char buf[8192];
    size_t buf_len = 0;
    
    while (1) {
        // Process buffer for newlines
        size_t pos = 0;
        while (pos < buf_len) {
            if (buf[pos] == '\n') {
                // Emit line
                if (line_matches(line, line_len, pattern, pattern_len)) {
                    if (prefix) {
                        if (fwrite(prefix, 1, prefix_len, stdout) != prefix_len) had_error = 1;
                        if (fputc(':', stdout) == EOF) had_error = 1;
                    }
                    if (line_len > 0 && fwrite(line, 1, line_len, stdout) != line_len) had_error = 1;
                    if (fputc('\n', stdout) == EOF) had_error = 1;
                    has_match = 1;
                }
                line_len = 0;
                pos++;
            } else {
                if (line_len == line_cap) {
                    size_t new_cap = line_cap ? line_cap * 2 : 4096;
                    unsigned char *new_line = realloc(line, new_cap);
                    if (!new_line) { free(line); line = NULL; line_cap = 0; return has_match; }
                    line = new_line;
                    line_cap = new_cap;
                }
                line[line_len++] = buf[pos++];
            }
        }
        buf_len = 0;
        
        size_t n = fread(buf, 1, sizeof(buf), stream);
        if (n == 0) break; // EOF or error
        if (ferror(stream)) had_error = 1;
        buf_len = n;
    }
    
    // Final unterminated line
    if (line_len > 0) {
        if (line_matches(line, line_len, pattern, pattern_len)) {
            if (prefix) {
                fwrite(prefix, 1, prefix_len, stdout);
                fputc(':', stdout);
            }
            fwrite(line, 1, line_len, stdout);
            fputc('\n', stdout);
            has_match = 1;
        }
    }
    
    free(line);
    return has_match;
}
