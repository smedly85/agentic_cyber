        except OSError:
            print(f"'{dest_base}' is not a directory", file=sys.stderr)
            sys.exit(1)

    # Now process each source
    exit_code = 0
    for source in sources:
        # Determine effective destination
        if os.path.isdir(dest_base):
            # dest_base is a directory → effective dest is dest_base/basename
            basename = os.path.basename(source)
            if basename == '':
                # source ends with / or is /
                basename = os.path.basename(source.rstrip('/')) or source
            effective_dest = os.path.join(dest_base, basename)
        else:
