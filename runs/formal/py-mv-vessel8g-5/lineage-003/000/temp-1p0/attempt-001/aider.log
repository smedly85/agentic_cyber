                seen_ddash = True
            elif arg == '-':
                operands.append(arg)
            elif arg.startswith('-'):
                print(f"unknown option: {arg}", file=sys.stderr)
                sys.exit(1)
            else:
                operands.append(arg)
        else:
            operands.append(arg)

    if len(operands) < 2:
        print("missing operand", file=sys.stderr)
        sys.exit(1)

    # Determine sources and destinations
    if len(operands) == 2:
        sources = [operands[0]]
        dest_base = operands[1]
    else:
        sources = operands[:-1]
        dest_base = operands[-1]

    # For multi-source: last operand must be an existing directory
    if len(operands) > 2:
        try:
            dest_stat = os.stat(dest_base)  # follow symlinks? No, lstat
            # Actually, for the purpose of checking "is a directory", we should use stat
            # (follow symlinks) or lstat? 
            # If dest_base is a symlink to a directory, is it a valid directory target?
            # GNU mv: if the last arg is a symlink to a directory, it's treated as a directory
