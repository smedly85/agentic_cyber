Looking at the requirements, I need to implement a complete `mv` utility from scratch. Let me analyze the key requirements:

1. Accept `SOURCE DEST` or `SOURCE... DIRECTORY`
2. Options before `--` (any unknown option → error), after `--` all literal
3. Core move via `move_path` (semantic anchor)
4. Type-compatibility checks, identity checks, directory-into-itself checks
5. Per-source error handling with continue-on-failure
6. `os.rename` for same-filesystem moves (cross-filesystem excluded)
7. No subprocesses, stdlib only

Here's the implementation:

```python
#!/usr/bin/env python3
"""mv - move (rename) files and directories."""

import os
import stat
import sys


def move_path(source: str, dest: str) -> None:
    """Perform a single filesystem move. Raises OSError on any failure."""
    src_stat = os.lstat(source)
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)
    src_real = os.path.realpath(source)

    try:
        dst_stat = os.lstat(dest)
    except FileNotFoundError:
        dst_stat = None

    if dst_stat is not None:
        dst_is_dir = stat.S_ISDIR(dst_stat.st_mode)
        dst_real = os.path.realpath(dest)

        if src_real == dst_real:
            raise OSError("same file")

        if src_is_dir and not dst_is_dir:
            raise OSError(
                f"cannot replace non-directory '{dest}' with directory"
            )

        if not src_is_dir and dst_is_dir:
            raise OSError(
                f"cannot replace directory '{dest}' with non-directory"
            )

        if src_is_dir and dst_is_dir:
            if os.listdir(dest):
                raise OSError(
                    f"cannot overwrite non-empty directory '{dest}'"
                )

    if src_is_dir:
        dst_real = os.path.realpath(dest)
        if dst_real == src_real or dst_real.startswith(src_real + os.sep):
            raise OSError("cannot move directory into itself")

    os.rename(source, dest)


def main() -> int:
    args = sys.argv[1:]
    operands: list[str] = []
    seen_ddash = False

    for arg in args:
        if not seen_ddash:
            if arg == '--':
                seen_ddash = True
            elif arg == '-':
                operands.append(arg)
            elif arg.startswith('-'):
                print(f"mv: unknown option: {arg}", file=sys.stderr)
                return 1
            else:
                operands.append(arg)
        else:
            operands.append(arg)

    if len(operands) < 2:
        print("mv: missing operand", file=sys.stderr)
        return 1

    if len(operands) == 2:
        sources = [operands[0]]
        dest_base = operands[1]
    else:
        sources = operands[:-1]
        dest_base = operands[-1]
        try:
            if not os.path.isdir(dest_base):
                print(f"mv: '{dest_base}' is not a directory", file=sys.stderr)
                return 1
        except OSError:
            print(f"mv: '{dest_base}' is not a directory", file=sys.stderr)
            return 1

    dest_is_dir = os.path.isdir(dest_base)

    exit_code = 0
    for source in sources:
        if dest_is_dir:
            name = os.path.basename(source)
            if not name:
                name = source
            effective_dest = os.path.join(dest_base, name)
        else:
            effective_dest = dest_base

        try:
            move_path(source, effective_dest)
        except OSError as exc:
            print(f"mv: {source}: {exc}", file=sys.stderr)
            exit_code = 1
        except Exception as exc:
            print(f"mv: {source}: {exc}", file=sys.stderr)
            exit_code = 1

    return exit_code


if __name__ == '__main__':
    sys.exit(main())
```

**Key design decisions:**

1. **`move_path`** is the semantic anchor — it performs all validation (identity, type compatibility, non-empty directory, directory-into-itself) before calling `os.rename`. All checks use `os.lstat` (doesn't follow symlinks) for type detection and `os.path.realpath` for identity/descendant comparison.

2. **Option parsing**: Any argument starting with `-` (except bare `-`) before `--` is rejected as an unknown option. After `--`, everything is a literal operand.

3. **Multi-source validation**: When 3+ operands are given, the last must be an existing directory (checked via `os.path.isdir` which follows symlinks, so a symlink-to-dir is valid). This is an invocation-wide error.

4. **Effective destination**: If `dest_base` is a directory, each source is placed at `dest_base/basename(source)`. Otherwise the dest is used as-is.

5. **Per-source error handling**: Each source is processed independently. Failures (missing source, type mismatch, permission errors, etc.) are reported to stderr and contribute to exit code 1, but processing continues.

6. **`os.rename`** handles the actual move atomically on the same filesystem, preserving inode, permissions, and content. Cross-filesystem moves are out of scope per the spec.

7. **No destination parent creation**: If the parent of the effective destination doesn't exist, `os.rename` will raise `OSError` (ENOENT), which is caught and reported as a per-source failure.
