#!/usr/bin/env python3
"""mv - move (rename) files and directories."""

import os
import stat
import sys


def move_path(source: str, dest: str) -> None:
    """Perform a single filesystem move. Raises OSError on any failure."""
    src_stat = os.lstat(source)
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)
    src_real = os.path.realpath(source)

    try:
        dst_stat = os.lstat(dest)
    except FileNotFoundError:
        dst_stat = None

    if dst_stat is not None:
        dst_is_dir = stat.S_ISDIR(dst_stat.st_mode)
        dst_real = os.path.realpath(dest)

        if src_real == dst_real:
            raise OSError(f"same file")

        if src_is_dir and not dst_is_dir:
            raise OSError(f"cannot replace non-directory '{dest}' with directory")

        if not src_is_dir and dst_is_dir:
            raise OSError(f"cannot replace directory '{dest}' with non-directory")

        if src_is_dir and dst_is_dir:
            if os.listdir(dest):
                raise OSError(f"cannot overwrite non-empty directory '{dest}'")

    if src_is_dir:
        dst_real = os.path.realpath(dest)
        if dst_real == src_real or dst_real.startswith(src_real + os.sep):
            raise OSError(f"cannot move directory into itself")

    os.rename(source, dest)


def main() -> int:
    args = sys.argv[1:]
    operands: list[str] = []
    seen_ddash = False

    for arg in args:
        if not seen_ddash:
            if arg == '--':
                seen_ddash = True
            elif arg == '-':
                operands.append(arg)
            elif arg.startswith('-'):
                print(f"unknown option: {arg}", file=sys.stderr)
                return 1
            else:
                operands.append(arg)
        else:
            operands.append(arg)

    if len(operands) < 2:
        print("mv: missing operand", file=sys.stderr)
        return 1

    if len(operands) == 2:
        sources = [operands[0]]
        dest_base = operands[1]
    else:
        sources = operands[:-1]
        dest_base = operands[-1]
        if not os.path.isdir(dest_base):
            print(f"mv: '{dest_base}' is not a directory", file=sys.stderr)
            return 1

    dest_is_dir = os.path.isdir(dest_base)

    exit_code = 0
    for source in sources:
        if dest_is_dir:
            name = os.path.basename(source.rstrip('/')) if source != '/' else '/'
            # Actually os.path.basename handles trailing slashes
            name = os.path.basename(source)
            if name == '':
                name = source  # e.g., source is '/'
            effective_dest = os.path.join(dest_base, name)
        else:
            effective_dest = dest_base

        try:
            move_path(source, effective_dest)
        except OSError as e:
            print(f"mv: {source}: {e}", file=sys.stderr)
            exit_code = 1

    return exit_code


if __name__ == '__main__':
    sys.exit(main())
