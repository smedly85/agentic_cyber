    """Perform a filesystem move. Raises OSError on failure."""
    src_stat = os.lstat(source)
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)

    # Resolve real paths for identity/descendant checks
    src_real = os.path.realpath(source)
    
    # Check if destination exists
    try:
        dst_stat = os.lstat(dest)
        dst_exists = True
    except (FileNotFoundError, OSError):
        dst_exists = False

    if dst_exists:
        dst_real = os.path.realpath(dest)
        dst_is_dir = stat.S_ISDIR(dst_stat.st_mode)

        # Identity check
        if src_real == dst_real:
            raise OSError(f"'{source}' and '{dest}' are the same file")

        # Type compatibility
