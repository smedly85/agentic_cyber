                raise

    # Directory into itself/descendant check
    if src_is_dir:
        dst_real = os.path.realpath(dest)
        if dst_real == src_real or dst_real.startswith(src_real + os.sep):
            raise OSError(f"cannot move directory '{source}' into itself or its descendant '{dest}'")

    os.rename(source, dest)


def main() -> None:
