```python
#!/usr/bin/env python3
"""GNU mv base implementation (checkpoint 000)."""
import os
import stat
import sys


class MoveError(Exception):
    pass


def _lstat_or_raise(path, context):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        raise MoveError(f"cannot {context} '{path}': No such file or directory")
    except OSError as e:
        raise MoveError(f"cannot {context} '{path}': {e.strerror or str(e)}")


def _same_file(a, b):
    try:
        sa = os.stat(a)
        sb = os.stat(b)
        return (sa.st_dev, sa.st_ino) == (sb.st_dev, sb.st_ino)
    except OSError:
        return False


def _is_inside(child, parent):
    """Check if child path is inside parent directory (using real paths)."""
    child_real = os.path.realpath(child)
    parent_real = os.path.realpath(parent)
    if child_real == parent_real:
        return True
    prefix = parent_real + os.sep
    return child_real.startswith(prefix)


def move_path(source, destination):
    """Perform a single move operation. Raises MoveError on failure."""
    # Source must exist
    src_stat = _lstat_or_raise(source, "stat")
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)
    
    # Destination status
    try:
        dst_stat = os.lstat(destination)
