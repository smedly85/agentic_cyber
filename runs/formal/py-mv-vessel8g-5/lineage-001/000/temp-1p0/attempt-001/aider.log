```python
#!/usr/bin/env python3
import os
import sys
import stat

class MoveError(Exception):
    pass

def _is_directory(path):
    """Check if path is a directory (following symlinks)."""
    try:
        return stat.S_ISDIR(os.stat(path).st_mode)
    except OSError:
        return False

def _is_symlink(path):
    return os.path.islink(path)

def _same_file(a, b):
    """Check if two paths refer to the same file."""
    try:
        sa = os.stat(a)
        sb = os.stat(b)
        return (sa.st_dev, sa.st_ino) == (sb.st_dev, sb.st_ino)
    except OSError:
        return False

def _is_descendant(child, parent):
    """Check if child is a descendant of parent (or the same)."""
    # Normalize both paths
    child_norm = os.path.normpath(child)
    parent_norm = os.path.normpath(parent)
    if child_norm == parent_norm:
        return True
    # Check if child is inside parent
    prefix = parent_norm + os.sep
    return child_norm.startswith(prefix)

def move_path(source, destination):
    """Core filesystem move operation."""
    # Check source exists
    try:
        src_stat = os.lstat(source)
    except FileNotFoundError:
        raise MoveError(f"cannot move '{source}': No such file or directory")
    except OSError as e:
        raise MoveError(f"cannot move '{source}': {e.strerror}")
    
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)
    src_is_symlink = stat.S_ISLNK(src_stat.st_mode)
    
    # Check destination
    try:
        dst_stat = os.lstat(destination)
        dst_exists = True
    except FileNotFoundError:
        dst_stat = None
        dst_exists = False
    except OSError as e:
        raise MoveError(f"cannot move to '{destination}': {e.strerror}")
    
    dst_is_dir = dst_exists and stat.S_ISDIR(dst_stat.st_mode)
    dst_is_symlink = dst_exists and stat.S_ISLNK(dst_stat.st_mode)
    
    # Identical source and destination
    if _same_file(source, destination):
        raise MoveError(f"cannot move '{source}' to itself")
    
    # Type compatibility checks
    if dst_exists:
        if src_is_dir and not dst_is_dir:
            # Directory source cannot replace nondirectory destination
            raise MoveError(f"cannot move '{source}' to '{destination}': target is not a directory")
        if not src_is_dir and dst_is_dir:
            # Nondirectory source cannot replace directory destination
            # (even empty directory)
            raise MoveError(f"cannot move '{source}' to '{destination}': target is a directory")
        if src_is_dir and dst_is_dir:
            # Check if destination is empty
            try:
                entries = os.listdir(destination)
                if entries:
                    raise MoveError(f"cannot move '{source}' to '{destination}': target is not an empty directory")
            except OSError as e:
                if isinstance(e, MoveError):
                    raise
                raise MoveError(f"cannot move '{source}' to '{destination}': {e.strerror}")
    
    # Directory moved into itself or descendant
    if src_is_dir and dst_exists:
        # Actually, this check should be regardless of dst_exists
        # If dest is inside source
        if _is_descendant(destination, source):
            raise MoveError(f"cannot move '{source}' into a subdirectory of itself, '{destination}'")
    
    # Actually, let me also check if destination (even if not existing) is inside source
    # e.g., mv /a /a/b/c where /a is a directory
    if src_is_dir:
        src_norm = os.path.normpath(os.path.abspath(source))
        dst_norm = os.path.normpath(os.path.abspath(destination))
        if dst_norm == src_norm or dst_norm.startswith(src_norm + os.sep):
            raise MoveError(f"cannot move '{source}' into a subdirectory of itself, '{destination}'")
    
    # Perform the move
    try:
        os.rename(source, destination)
    except OSError as e:
        raise MoveError(f"cannot move '{source}' to '{destination}': {e.strerror}")
```

