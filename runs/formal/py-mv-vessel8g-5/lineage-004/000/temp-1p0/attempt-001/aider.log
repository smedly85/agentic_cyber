```python
#!/usr/bin/env python3
"""py_mv - GNU mv compatible move utility, checkpoint 000."""

import os
import stat
import sys


def parse_args(argv):
    """Parse command-line arguments, handling -- and option recognition."""
    # Find --
    dashdash = None
    for i, arg in enumerate(argv):
        if arg == '--':
            dashdash = i
            break
    
    if dashdash is not None:
        opt_part = argv[:dashdash]
        operand_part = argv[dashdash + 1:]
    else:
        opt_part = argv
        operand_part = []
    
    # Before --, recognize options (tokens starting with - that aren't just -)
    operands = []
    for arg in opt_part:
        if arg.startswith('-') and arg != '-':
            # Unknown option
            return None, f"unknown option: {arg}"
        operands.append(arg)
    
    # After --, everything is a literal operand
    operands.extend(operand_part)
    
    return operands, None


def lstat_safe(path):
    """Safely lstat a path, returning (st, None) or (None, error_message)."""
    try:
        return os.lstat(path), None
    except FileNotFoundError:
        return None, f"cannot stat '{path}': No such file or directory"
    except PermissionError:
        return None, f"cannot stat '{path}': Permission denied"
    except OSError as e:
        return None, f"cannot stat '{path}': {e.strerror or e}"


def is_dir(st):
    return stat.S_ISDIR(st.st_mode)


def is_file_or_symlink(st):
    return stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode)


def validate_move(src_path, dest_path):
    """Validate a single move. Returns (ok, error_message)."""
    # lstat source
    src_st, err = lstat_safe(src_path)
    if err:
        return False, err
    
    # lstat destination (may not exist)
    try:
        dest_st = os.lstat(dest_path)
    except FileNotFoundError:
        dest_st = None
    except PermissionError:
        return False, f"cannot stat '{dest_path}': Permission denied"
    except OSError as e:
        return False, f"cannot stat '{dest_path}': {e.strerror or e}"
    
    # Check identical source/destination
    if os.path.realpath(src_path) == os.path.realpath(dest_path):
        return False, f"'{src_path}' and '{dest_path}' are the same file"
    
    src_is_dir = is_dir(src_st)
    
    if dest_st is not None:
        dest_is_dir = is_dir(dest_st)
        
        if src_is_dir and not dest_is_dir:
            return False, f"cannot overwrite non-directory '{dest_path}' with directory '{src_path}'"
        if not src_is_dir and dest_is_dir:
            return False, f"cannot overwrite directory '{dest_path}' with non-directory '{src_path}'"
        if src_is_dir and dest_is_dir:
            # Check if dest is non-empty (can't merge)
            try:
                entries = os.listdir(dest_path)
                if entries:
                    return False, f"directory '{dest_path}' is not empty"
            except PermissionError:
                return False, f"cannot read directory '{dest_path}': Permission denied"
            except OSError as e:
                return False, f"cannot read directory '{dest_path}': {e.strerror or e}"
    
    # Check if dest is within source (directory moved into itself)
    if src_is_dir:
        src_real = os.path.realpath(src_path)
        dest_real = os.path.realpath(dest_path)
        if dest_real.startswith(src_real + os.sep) or dest_real == src_real:
            return False, f"cannot move '{src_path}' into a subdirectory of itself, '{dest_path}'"
    
    return True, None


def move_path(src, dest):
    """Core filesystem move operation. Returns (ok, error_message)."""
    try:
        os.rename(src, dest)
        return True, None
    except PermissionError:
        return False, f"cannot move '{src}' to '{dest}': Permission denied"
    except FileNotFoundError:
        return False, f"cannot move '{src}' to '{dest}': No such file or directory"
    except OSError as e:
        return False, f"cannot move '{src}' to '{dest}': {e.strerror or e}"


def main():
    if len(sys.argv) < 2:
        print("missing operand", file=sys.stderr)
        sys.exit(1)
    
    argv = sys.argv[1:]
    operands, err = parse_args(argv)
    if err:
        print(err, file=sys.stderr)
        sys.exit(1)
    
    if len(operands) < 2:
        print("missing operand", file=sys.stderr)
        sys.exit(1)
    
    # Determine mode: multi-source or single
    if len(operands) >= 3:
        # Multi-source: last must be existing directory
        dest_dir = operands[-1]
        sources = operands[:-1]
        
        # Validate dest_dir is an existing directory
        try:
            dest_st = os.lstat(dest_dir)
        except FileNotFoundError:
            print(f"invalid target directory: '{dest_dir}': No such file or directory", file=sys.stderr)
            sys.exit(1)
        except PermissionError:
            print(f"invalid target directory: '{dest_dir}': Permission denied", file=sys.stderr)
            sys.exit(1)
        except OSError as e:
            print(f"invalid target directory: '{dest_dir}': {e.strerror or e}", file=sys.stderr)
            sys.exit(1)
        
        if not stat.S_ISDIR(dest_st.st_mode):
            print(f"invalid target directory: '{dest_dir}': Not a directory", file=sys.stderr)
            sys.exit(1)
        
        # Compute effective destinations
        moves = []
        for src in sources:
            basename = os.path.basename(src)
            eff_dest = os.path.join(dest_dir, basename)
            moves.append((src, eff_dest))
    else:
        # Single source
        src = operands[0]
        dest = operands[1]
        
        # Check if dest is an existing directory
        try:
            dest_st = os.lstat(dest)
            if stat.S_ISDIR(dest_st.st_mode):
                basename = os.path.basename(src)
                eff_dest = os.path.join(dest, basename)
                moves = [(src, eff_dest)]
            else:
                moves = [(src, dest)]
        except (FileNotFoundError, PermissionError, OSError):
            # Dest doesn't exist or can't stat it - use as-is
            moves = [(src, dest)]
    
    # Pre-validate all moves before making any changes
    errors = []
    for src, dest in moves:
        ok, err = validate_move(src, dest)
        if not ok:
            errors.append(err)
    
    if errors:
        for e in errors:
            print(e, file=sys.stderr)
        sys.exit(1)
    
    # Execute moves in order, continuing on failure
    failed = False
    for src, dest in moves:
        ok, err = move_path(src, dest)
        if not ok:
            print(err, file=sys.stderr)
            failed = True
    
    sys.exit(1 if failed else 0)


if __name__ == '__main__':
    main()
```

