```python
def _parse_operands(argv):
    """Split argv into (policy, operands); accept -f/--force/-i/--interactive before --."""
    operands = []
    policy = None  # None=base, "force", "interactive"
    seen_separator = False
    for arg in argv:
        if not seen_separator and arg == "--":
            seen_separator = True
            continue
        if not seen_separator:
            if arg in ("-f", "--force"):
                policy = "force"
                continue
            if arg in ("-i", "--interactive"):
                policy = "interactive"
                continue
            if arg.startswith("-") and arg != "-":
                raise ValueError(f"unknown option -- {arg}")
        operands.append(arg)
    return policy, operands
```

This naturally handles the "last occurrence wins" rule because we just keep overwriting `policy`.

