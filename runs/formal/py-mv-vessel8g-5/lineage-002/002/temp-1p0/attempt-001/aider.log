def _check_and_move(src, eff_dest, src_stat, policy=None):
    src_is_dir = stat.S_ISDIR(src_stat.st_mode)
    
    try:
        dest_stat = os.lstat(eff_dest)
    except OSError:
        dest_stat = None
    
    if dest_stat is not None:
        # Identical source and destination (same inode)
        if src_stat.st_dev == dest_stat.st_dev and src_stat.st_ino == dest_stat.st_ino:
            raise _MoveError(f"'{src}' and '{eff_dest}' are the same file")
        
        dest_is_dir = stat.S_ISDIR(dest_stat.st_mode)
        if src_is_dir and not dest_is_dir:
            raise _MoveError(f"cannot replace non-directory '{eff_dest}' with directory '{src}'")
        if not src_is_dir and dest_is_dir:
            raise _MoveError(f"cannot replace directory '{eff_dest}' with non-directory '{src}'")
        if src_is_dir and dest_is_dir:
            try:
                if os.listdir(eff_dest):
                    raise _MoveError(f"cannot overwrite non-empty directory '{eff_dest}'")
            except _MoveError:
                raise
            except OSError:
                pass
        
        # Interactive prompt (only when dest exists and we'd be replacing)
        if policy == "interactive":
            sys.stderr.write(f"mv: overwrite '{eff_dest}'? ")
            sys.stderr.flush()
            line = sys.stdin.readline()
            stripped = line.lstrip()
            if not stripped or stripped[0] not in ('y', 'Y'):
                raise _MoveError(f"not replacing '{eff_dest}'")
        
        # Write-protected check (suppressed by force or by interactive confirmation)
        if policy is None:  # base mode only
            if not stat.S_ISDIR(dest_stat.st_mode) and not (dest_stat.st_mode & stat.S_IWUSR):
                raise _MoveError(f"cannot overwrite write-protected file '{eff_dest}'")
    
    # Moving a directory into itself or its descendant
    if src_is_dir:
        src_abs = os.path.abspath(src)
        dest_abs = os.path.abspath(eff_dest)
        if dest_abs == src_abs:
            raise _MoveError(f"'{src}' and '{eff_dest}' are the same file")
        if dest_abs.startswith(src_abs + os.sep):
            raise _MoveError(f"cannot move directory '{src}' into its subdirectory '{eff_dest}'")
    
    # Perform the move
    try:
        move_path(src, eff_dest)
    except OSError as e:
        errno_msg = os.strerror(e.errno) if e.errno else str(e)
        raise _MoveError(f"cannot move '{src}' to '{eff_dest}': {errno_msg}") from e
```

