```python
#!/usr/bin/env python3
"""py_mv - move files (checkpoint 000: base)."""

import os
import stat
import sys


def move_path(source: str, destination: str) -> None:
    """Perform the core filesystem move operation."""
    os.rename(source, destination)


def _fail(msg: str) -> NoReturn:
    print(f"py_mv: {msg}", file=sys.stderr)
    sys.exit(1)


def _parse_operands(argv: list[str]) -> list[str]:
    """Parse argv into operands. Raises ValueError for unknown options."""
    operands = []
    seen_sep = False
    for arg in argv:
        if not seen_sep and arg == '--':
            seen_sep = True
            continue
        if not seen_sep and arg.startswith('-') and arg != '-':
            raise ValueError(f"unknown option '{arg}'")
        operands.append(arg)
    return operands


def _effective_destination(source: str, dest: str, multi: bool) -> str:
    """Compute the effective destination path for a source."""
    if multi:
        # dest is guaranteed to be an existing directory
        return os.path.join(dest, os.path.basename(source))
    # Single source: check if dest is an existing directory
    try:
        st = os.lstat(dest)
    except OSError:
        return dest  # dest doesn't exist, use as-is
    if stat.S_ISDIR(st.st_mode):
        return os.path.join(dest, os.path.basename(source))
    return dest


def main() -> None:
    # Parse operands
    try:
        operands = _parse_operands(sys.argv[1:])
    except ValueError as e:
        print(f"py_mv: {e}", file=sys.stderr)
        sys.exit(1)

    # Invocation-wide validation
    if len(operands) < 2:
        if len(operands) == 0:
            print("py_mv: missing operand", file=sys.stderr)
        else:
            print("py_mv: missing destination operand", file=sys.stderr)
        sys.exit(1)

    sources = operands[:-1]
    dest = operands[-1]
    multi = len(sources) > 1

    # Multi-source: dest must be existing directory
    if multi:
        try:
            st = os.lstat(dest)
        except OSError:
            print(f"py_mv: cannot move to '{dest}': No such file or directory", file=sys.stderr)
            sys.exit(1)
        if not stat.S_ISDIR(st.st_mode):
            print(f"py_mv: target '{dest}' is not a directory", file=sys.stderr)
            sys.exit(1)

    # Process each source in order
    exit_status = 0
    for src in sources:
        try:
            _move_one(src, dest, multi)
        except _MoveError as e:
            print(f"py_mv: {e}", file=sys.stderr)
            exit_status = 1

    sys.exit(exit_status)


class _MoveError(Exception):
    """Per-source move failure."""
    pass


def _move_one(src: str, dest: str, multi: bool) -> None:
    """Move a single source, raising _MoveError on failure."""
    # Check source exists
    try:
        src_stat = os.lstat(src)
    except OSError as e:
        raise _MoveError(f"cannot stat '{src}': {os.strerror(e.errno)}") from e

    src_is_dir = stat.S_ISDIR(src_stat.st_mode)

    # Compute effective destination
    eff_dest = _effective_destination(src, dest, multi)

    # Check for identical source and destination
    # Need to compare resolved paths (but not following symlinks for the "into self" check)
