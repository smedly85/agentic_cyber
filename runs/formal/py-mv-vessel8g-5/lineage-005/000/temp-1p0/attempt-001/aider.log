#!/usr/bin/env python3
import os
import sys


def move_path(src, dst):
    """Core filesystem move: rename src to dst on the same filesystem."""
    os.rename(src, dst)


def _resolve(path):
    """Return the resolved absolute path (following symlinks)."""
    return os.path.realpath(path)


def _is_within(child, parent):
    """True if child equals parent or is a descendant of parent."""
    if child == parent:
        return True
    prefix = parent if parent.endswith('/') else parent + '/'
    return child.startswith(prefix)


def _process_one(src, dst):
    """Move src to dst. Returns True on success, False on failure."""
    try:
        # Source must exist (use lexists to also catch broken symlinks)
        if not os.path.lexists(src):
            print(f"py_mv: cannot move '{src}': No such file or directory", file=sys.stderr)
            return False

        # Identical source and destination
        src_real = _resolve(src)
        dst_real = _resolve(dst)
        if src_real == dst_real:
            print(f"py_mv: '{src}' and '{dst}' are the same file", file=sys.stderr)
            return False

        # Directory moved into itself or a descendant
        if os.path.isdir(src) and not os.path.islink(src):
            if _is_within(dst_real, src_real):
                print(f"py_mv: cannot move '{src}' into a subdirectory of itself, '{dst}'", file=sys.stderr)
                return False

        # Type compatibility pre-checks for better diagnostics
        src_is_dir = os.path.isdir(src) and not os.path.islink(src)
        dst_exists = os.path.lexists(dst)
        dst_is_dir = dst_exists and os.path.isdir(dst) and not os.path.islink(dst)

        if src_is_dir and dst_exists and not dst_is_dir:
            print(f"py_mv: cannot overwrite non-directory '{dst}' with directory '{src}'", file=sys.stderr)
            return False
        if not src_is_dir and dst_is_dir:
            print(f"py_mv: cannot overwrite directory '{dst}' with non-directory '{src}'", file=sys.stderr)
            return False

        # Perform the move
        move_path(src, dst)
        return True

    except OSError as e:
        print(f"py_mv: cannot move '{src}' to '{dst}': {e.strerror or str(e)}", file=sys.stderr)
        return False


def main():
    args = sys.argv[1:]

    # Parse arguments: handle --, reject unknown options
    operands = []
    after_ddash = False
    for arg in args:
        if not after_ddash and arg == '--':
            after_ddash = True
            continue
        if not after_ddash and arg.startswith('-') and len(arg) > 1:
            print(f"py_mv: unrecognized option: {arg}", file=sys.stderr)
            sys.exit(1)
        operands.append(arg)

    # Need at least 2 operands
    if len(operands) < 2:
        print("py_mv: missing operand", file=sys.stderr)
        sys.exit(1)

    # Determine sources and destinations
    if len(operands) > 2:
        # Multi-source: last operand must be an existing directory
        dest_dir = operands[-1]
        sources = operands[:-1]
        if not os.path.isdir(dest_dir):
            print(f"py_mv: target '{dest_dir}' is not a directory", file=sys.stderr)
            sys.exit(1)
        pairs = []
        for src in sources:
            base = os.path.basename(os.path.normpath(src))
            pairs.append((src, os.path.join(dest_dir, base)))
    else:
        # Single source: SOURCE DEST
        src = operands[0]
        dst = operands[1]
        if os.path.isdir(dst):
            base = os.path.basename(os.path.normpath(src))
            dst = os.path.join(dst, base)
        pairs = [(src, dst)]

    # Process in order, continue on failure
    any_failure = False
    for src, dst in pairs:
        if not _process_one(src, dst):
            any_failure = True

    sys.exit(1 if any_failure else 0)


if __name__ == '__main__':
    main()
```

