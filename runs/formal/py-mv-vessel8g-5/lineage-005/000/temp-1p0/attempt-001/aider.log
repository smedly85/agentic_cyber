```python
#!/usr/bin/env python3
"""py_mv — move/rename utility (checkpoint 000: base)."""
import os
import sys


def move_path(src, dst):
    """Perform the core filesystem move operation.
    
    Raises OSError on failure.
    """
    os.rename(src, dst)


def _is_within(child, parent):
    """Check if child is the same as or within parent (both must be absolute, resolved)."""
    if child == parent:
        return True
    # Ensure proper prefix matching
    parent_slash = parent if parent.endswith('/') else parent + '/'
    return child.startswith(parent_slash)


def main():
    args = sys.argv[1:]
    
    # Parse: find --, check for unknown options before it
    operands = []
    seen_ddash = False
    for arg in args:
        if not seen_ddash and arg == '--':
            seen_ddash = True
            continue
        if not seen_ddash and arg.startswith('-') and arg != '-':
            print(f"py_mv: unknown option: {arg}", file=sys.stderr)
            sys.exit(1)
        operands.append(arg)
    
    if len(operands) < 2:
        print("py_mv: missing operand", file=sys.stderr)
        sys.exit(1)
    
    # Determine sources and destination
    if len(operands) > 2:
        # Multi-source: last must be existing directory
        dest_dir = operands[-1]
        sources = operands[:-1]
        if not os.path.isdir(dest_dir):
            print(f"py_mv: target '{dest_dir}' is not a directory", file=sys.stderr)
            sys.exit(1)
    else:
        # Single source: SOURCE DEST
        sources = [operands[0]]
        dest = operands[1]
        if os.path.isdir(dest):
            # Effective destination is dest/basename(source)
            basename = os.path.basename(os.path.normpath(sources[0]))
            if basename in ('', '.'):
                # This would be a source of "." or absolute path edge case
                print(f"py_mv: cannot move '{sources[0]}' into itself", file=sys.stderr)
                sys.exit(1)
            dest = os.path.join(dest, basename)
    
    # Process each source
    any_failure = False
    
    if len(operands) > 2:
        for src in sources:
            effective_dest = os.path.join(dest_dir, os.path.basename(os.path.normpath(src)))
            if not _process_one(src, effective_dest):
                any_failure = True
    else:
        if not _process_one(sources[0], dest):
            any_failure = True
    
    sys.exit(1 if any_failure else 0)


def _process_one(src, dst):
    """Process a single move. Returns True on success, False on failure."""
    # Check source exists
    if not os.path.lexists(src):
        print(f"py_mv: cannot stat '{src}': No such file or directory", file=sys.stderr)
        return False
    
    # Check for identical paths
    src_real = os.path.realpath(src)
    dst_real = os.path.realpath(dst)
    if src_real == dst_real:
        print(f"py_mv: '{src}' and '{dst}' are the same file", file=sys.stderr)
        return False
    
    # Check if source is a directory and destination is within it
    if os.path.isdir(src):
        # Check if dst is src or inside src
        if dst_real == src_real or _is_within(dst_real, src_real):
            print(f"py_mv: cannot move '{src}' into a subdirectory of itself, '{dst}'", file=sys.stderr)
            return False
    
    # Type compatibility checks (pre-check for better diagnostics)
    src_is_dir = os.path.isdir(src)
    dst_is_dir = os.path.isdir(dst)
    
    if src_is_dir and dst_is_dir:
        # Both directories: dest must be empty (os.rename will enforce this)
        pass
    elif src_is_dir and not dst_is_dir:
        # Directory source, non-directory dest
        # If dst exists as a file/symlink → incompatible
        if os.path.lexists(dst):
            print(f"py_mv: cannot overwrite non-directory '{dst}' with directory '{src}'", file=sys.stderr)
            return False
    elif not src_is_dir and dst_is_dir:
        # Non-directory source, directory dest
        if os.path.lexists(dst):
            print(f"py_mv: cannot overwrite directory '{dst}' with non-directory '{src}'", file=sys.stderr)
            return False
    
    # Perform the move
    try:
        move_path(src, dst)
    except OSError as e:
        print(f"py_mv: cannot move '{src}' to '{dst}': {e.strerror or e}", file=sys.stderr)
        return False
    
    return True
```

