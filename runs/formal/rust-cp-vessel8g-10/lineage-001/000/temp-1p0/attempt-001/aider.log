    if dst_symlink_meta.file_type().is_symlink() {
        // Follow the symlink
        let target_meta = match fs::metadata(dst) {
            Ok(m) => m,
            Err(_) => return Err(io::Error::new(io::ErrorKind::NotFound, "dangling symlink")),
        };
        if target_meta.is_dir() {
            return Err(io::Error::new(io::ErrorKind::IsADirectory, "destination is a directory"));
        }
        // target is a regular file, OK to write through
    }
    
    // Destination exists (regular file or symlink to regular file)
    // Open for writing (truncate)
    let mut dst_file = fs::OpenOptions::new()
        .write(true)
        .truncate(true)
        .open(dst)?;
    
    io::copy(&mut src_file, &mut dst_file)?;
    dst_file.flush()?;
    Ok(())
}

fn copy_to_new(src_file: fs::File, src_meta: fs::Metadata, dst: &Path) -> io::Result<()> {
