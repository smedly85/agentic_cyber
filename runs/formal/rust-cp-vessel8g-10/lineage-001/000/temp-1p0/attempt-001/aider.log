fn copy_path(src: &Path, dst: &Path) -> io::Result<()> {
    // Open source for reading (follows symlinks)
    let src_file = fs::File::open(src)?;
    
    // Check if destination exists
    let dst_meta = match fs::metadata(dst) {  // follows symlinks
        Ok(m) => Some(m),
        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
        Err(e) => return Err(e),
    };
    
    // If destination exists and is a directory → error (incompatible type)
    if let Some(m) = &dst_meta {
        if m.is_dir() {
            return Err(io::Error::new(io::ErrorKind::Other, "destination is a directory"));
        }
    }
    
    // Determine permissions for new file
    let src_meta = fs::metadata(src)?;  // follows symlinks
    let dst_permissions = if dst_meta.is_some() {
        dst_meta.unwrap().permissions()  // retain existing
    } else {
        let src_perm = src_meta.permissions();
        let umask = 0o022;
        let new_perm = src_perm.mode() & !umask;
        fs::Permissions::from_mode(new_perm)
    };
    
    // Open destination for writing (create or truncate)
    let mut dst_file = fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .open(dst)?;
    
    // If new file, set permissions
    if dst_meta.is_none() {
        dst_file.set_permissions(dst_permissions)?;
    }
    
    // Copy contents
    io::copy(&mut src_file, &mut dst_file)?;
    
    Ok(())
}
```

