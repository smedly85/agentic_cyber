```rust
fn main() {
    let args: Vec<OsString> = std::env::args_os().collect();
    let user_args = &args[1..];
    
    // Parse arguments
    let operands = match parse_operands(user_args) {
        Ok(op) => op,
        Err(msg) => {
            eprintln!("{}", msg);
            std::process::exit(1);
        }
    };
    
    if operands.len() < 2 {
        eprintln!("error: requires at least SOURCE and DEST operands");
        std::process::exit(1);
    }
    
    // Determine (source, dest) pairs
    let pairs: Vec<(OsString, OsString)> = if operands.len() == 2 {
        let src = &operands[0];
        let dst = &operands[1];
        let effective_dst = if Path::new(dst).is_dir() {
            let base = Path::new(src).file_name().map(|f| dst.join(f)).unwrap_or_else(|| dst.clone());
            vec![(src.clone(), base)]
        } else {
            vec![(src.clone(), dst.clone())]
        };
        effective_dst
    } else {
        let dir = &operands[operands.len() - 1];
        if !Path::new(dir).is_dir() {
            eprintln!("error: {} is not a directory", os_to_string(dir));
            std::process::exit(1);
        }
        let mut pairs = Vec::new();
        for src in &operands[..operands.len() - 1] {
            let base = Path::new(src).file_name().map(|f| dir.join(f)).unwrap_or_else(|| dir.clone());
            pairs.push((src.clone(), base));
        }
        pairs
    };
    
    // Validate: no source is a directory, no self-copy
    for (src, dst) in &pairs {
        // Check source is not a directory
        let src_path = Path::new(src);
        if let Ok(meta) = fs::metadata(src_path) {  // follows symlinks
            if meta.is_dir() {
                eprintln!("error: {} is a directory", os_to_string(src));
                std::process::exit(1);
            }
        }
        
        // Check self-copy
        if let (Ok(src_canon), Ok(dst_canon)) = (fs::canonicalize(src_path), fs::canonicalize(Path::new(dst))) {
            if src_canon == dst_canon {
                eprintln!("error: {} and {} are the same file", os_to_string(src), os_to_string(dst));
                std::process::exit(1);
            }
        }
    }
    
    // Perform copies
    let mut had_error = false;
    for (src, dst) in &pairs {
        if let Err(e) = copy_path(Path::new(src), Path::new(dst)) {
            eprintln!("error: {}: {}", os_to_string(src), e);
            had_error = true;
        }
    }
    
    std::process::exit(if had_error { 1 } else { 0 });
}
```

