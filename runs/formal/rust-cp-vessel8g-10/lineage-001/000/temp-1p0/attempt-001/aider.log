```rust
use std::env;
use std::ffi::{OsStr, OsString};
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;

fn main() {
    let args: Vec<OsString> = env::args_os().collect();
    let user_args: &[OsString] = &args[1..];
    
    let operands = match parse_operands(user_args) {
        Ok(op) => op,
        Err(msg) => {
            eprintln!("{}", msg);
            std::process::exit(1);
        }
    };
    
    if operands.len() < 2 {
        eprintln!("error: requires at least SOURCE and DEST");
        std::process::exit(1);
    }
    
    // Build (source, dest) pairs
    let pairs: Vec<(OsString, OsString)>;
    
    if operands.len() == 2 {
        let src = &operands[0];
        let dst = &operands[1];
        if Path::new(dst).is_dir() {
            let base = basename(src);
            pairs = vec![(src.clone(), dst.join(&base))];
        } else {
            pairs = vec![(src.clone(), dst.clone())];
        }
    } else {
        let dir = &operands[operands.len() - 1];
        if !Path::new(dir).is_dir() {
            eprintln!("error: {} is not a directory", os_display(dir));
            std::process::exit(1);
        }
        let mut p = Vec::new();
        for src in &operands[..operands.len() - 1] {
            let base = basename(src);
            p.push((src.clone(), dir.join(&base)));
        }
        pairs = p;
    }
    
    // Invocation-wide validation: reject directory sources, reject self-copy
    for (src, dst) in &pairs {
        let src_path = Path::new(src);
        let dst_path = Path::new(dst);
        
        // Check if source is a directory (following symlinks)
        if let Ok(meta) = fs::metadata(src_path) {
            if meta.is_dir() {
                eprintln!("error: {} is a directory", os_display(src));
                std::process::exit(1);
            }
        }
        
        // Check self-copy
        if let (Ok(s_canon), Ok(d_canon)) = (fs::canonicalize(src_path), fs::canonicalize(dst_path)) {
            if s_canon == d_canon {
                eprintln!("error: '{}' and '{}' are the same file", os_display(src), os_display(dst));
                std::process::exit(1);
            }
        }
    }
    
    // Perform copies
    let mut had_error = false;
    for (src, dst) in &pairs {
        if let Err(e) = copy_path(Path::new(src), Path::new(dst)) {
            eprintln!("error: {}: {}", os_display(src), e);
            had_error = true;
        }
    }
    
    if had_error {
        std::process::exit(1);
    }
}

fn parse_operands(args: &[OsString]) -> Result<Vec<OsString>, String> {
    let mut operands = Vec::new();
    let mut after_separator = false;
    
    for arg in args {
        if !after_separator && arg.as_os_str() == OsStr::new("--") {
            after_separator = true;
            continue;
        }
        if !after_separator {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                return Err(format!("error: unknown option '{}'", os_display(arg.as_os_str())));
            }
        }
        operands.push(arg.clone());
    }
    
    Ok(operands)
}

fn basename(path: &OsStr) -> OsString {
    Path::new(path).file_name()
        .map(|f| f.to_os_string())
        .unwrap_or_else(|| path.to_os_string())
}

fn os_display(s: &OsStr) -> String {
    s.to_string_lossy().into_owned()
}

fn copy_path(src: &Path, dst: &Path) -> io::Result<()> {
    let src_file = fs::File::open(src)?;
    let src_meta = src_file.metadata()?;
    let mode = src_meta.permissions().mode() & 0o777;
    
    let mut dst_file = fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .mode(mode)
        .open(dst)?;
    
    io::copy(&mut src_file, &mut dst_file)?;
    dst_file.flush()?;
    Ok(())
}
```

