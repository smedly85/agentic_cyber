fn copy_path(src: &Path, dst: &Path, force: bool) -> io::Result<()> {
    let mut src_file = fs::File::open(src)?;
    let mode = src_file.metadata()?.permissions().mode() & 0o777;

    // Check destination type
    if let Ok(dst_meta) = fs::symlink_metadata(dst) {
        if dst_meta.is_dir() {
            return Err(io::Error::new(
                io::ErrorKind::Unsupported,
                format!("{}: is a directory", dst.display()),
            ));
        }
        if dst_meta.file_type().is_symlink() {
            match fs::metadata(dst) {
                Ok(target) => {
                    if !target.is_file() {
                        return Err(io::Error::new(
                            io::ErrorKind::Unsupported,
                            format!("{}: not a regular file", dst.display()),
                        ));
                    }
                }
                Err(_) => {
                    // Dangling symlink
                    if !force {
                        return Err(io::Error::new(
                            io::ErrorKind::NotFound,
                            format!("{}: dangling symlink", dst.display()),
                        ));
                    }
                    // With force: remove the dangling symlink and create a new file
                    fs::remove_file(dst)?;
                    let dst_file = fs::OpenOptions::new()
                        .write(true)
                        .create(true)
                        .mode(mode)
                        .open(dst)?;
                    io::copy(&mut src_file, &mut dst_file)?;
                    return Ok(());
                }
            }
        }
    }

    // Try to open for writing
    let result = fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .mode(mode)
        .open(dst);

    let dst_file = match result {
        Ok(f) => f,
        Err(e) if force => {
            // With force: if dst exists and is not a directory, remove and recreate
            match fs::symlink_metadata(dst) {
                Ok(meta) => {
                    if meta.is_dir() {
                        return Err(e); // Already checked above, but just in case
                    }
                    fs::remove_file(dst)?;
                }
                Err(_) => {
                    return Err(e); // Doesn't exist; parent permission issue
                }
            }
            fs::OpenOptions::new()
                .write(true)
                .create(true)
                .mode(mode)
                .open(dst)?
        }
        Err(e) => return Err(e),
    };

    io::copy(&mut src_file, &mut dst_file)?;
    Ok(())
}
