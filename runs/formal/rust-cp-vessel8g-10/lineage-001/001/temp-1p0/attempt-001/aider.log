            }
            fs::OpenOptions::new()
                .write(true)
                .create(true)
                .mode(mode)
                .open(dst)?
        }
        Err(e) => return Err(e),
    };

    io::copy(&mut src_file, &mut dst_file)?;
    Ok(())
}
