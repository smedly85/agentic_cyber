fn recreate_symlink(src: &Path, dst: &Path) -> CopyOutcome {
    let target = match fs::read_link(src) {
        Ok(t) => t,
        Err(e) => return CopyOutcome::Error(e.to_string()),
    };
    if let Ok(existing) = dst.symlink_metadata() {
        if existing.is_dir() {
            return CopyOutcome::Error(format!("{}: is a directory", dst.display()));
        }
        if let Err(e) = fs::remove_file(dst) {
            return CopyOutcome::Error(e.to_string());
        }
    }
    match symlink(&target, dst) {
        Ok(()) => CopyOutcome::Success,
        Err(e) => CopyOutcome::Error(e.to_string()),
    }
}
