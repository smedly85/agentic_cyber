                if let Ok(src_meta) = fs::metadata(src_path) {
                    if src_meta.is_dir() && s.is_prefix_of(&d) {
                        eprintln!(
                            "error: cannot copy directory '{}' into itself or a subdirectory",
                            os_display(src)
                        );
                        std::process::exit(1);
                    }
                }
            }
        }
    }

    let mut had_error = false;
    for (src, dst) in &pairs {
