fn is_self_recursive(src: &Path, dst: &Path) -> bool {
    let src_canon = match fs::canonicalize(src) {
        Ok(p) => p,
        Err(_) => return false, // can't determine, let the copy fail naturally
    };
    
    let dst_canon = match fs::canonicalize(dst) {
        Ok(p) => p,
        Err(_) => {
            // dst doesn't exist; check if it would be inside src
            // Get absolute dst path
            let dst_abs = if dst.is_absolute() {
                dst.to_path_buf()
            } else {
                // resolve relative to cwd
                std::env::current_dir().map(|cwd| cwd.join(dst)).unwrap_or_else(|_| dst.to_path_buf())
            };
            // Normalize (remove .., .)
            let mut normalized = std::path::PathBuf::new();
            for component in dst_abs.components() {
                match component {
                    std::path::Component::ParentDir => { normalized.pop(); }
                    std::path::Component::CurDir => {}
                    _ => { normalized.push(component.as_os_str()); }
                }
            }
            normalized.starts_with(&src_canon)
        }
    };
    
    dst_canon == src_canon 
        || src_canon.starts_with(&dst_canon) 
        || dst_canon.starts_with(&src_canon)
}
```

