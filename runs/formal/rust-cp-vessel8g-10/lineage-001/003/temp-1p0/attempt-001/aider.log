fn copy_dir_recursive(src: &Path, dst: &Path, force: bool, interactive: bool) -> CopyOutcome {
    // Ensure the destination directory exists.
    if !dst.symlink_metadata().is_ok() {
        // Missing: create as the tree root.
        let src_meta = match fs::metadata(src) {
            Ok(m) => m,
            Err(e) => return CopyOutcome::Error(e.to_string()),
        };
        let mode = src_meta.permissions().mode() & 0o777;
        if let Err(e) = DirBuilder::new().mode(mode).create(dst) {
            return CopyOutcome::Error(e.to_string());
        }
    } else {
        // Exists: must be a directory (or symlink to one).
        let dst_meta = match fs::metadata(dst) {
            Ok(m) => m,
            Err(e) => return CopyOutcome::Error(e.to_string()),
        };
        if !dst_meta.is_dir() {
            return CopyOutcome::Error(format!("{}: not a directory", dst.display()));
        }
    }

    // Iterate over source entries.
    let entries = match fs::read_dir(src) {
        Ok(e) => e,
        Err(e) => return CopyOutcome::Error(e.to_string()),
    };
    for entry in entries {
        let entry = match entry {
            Ok(e) => e,
            Err(e) => return CopyOutcome::Error(e.to_string()),
        };
        let entry_path = entry.path();
        let entry_name = entry.file_name();
        let dest_entry = dst.join(&entry_name);

        let file_type = match entry.file_type() {
            Ok(ft) => ft,
            Err(e) => return CopyOutcome::Error(e.to_string()),
        };

        if file_type.is_symlink() {
            // Recreate the symlink with identical target bytes; do not follow.
            let target = match fs::read_link(&entry_path) {
                Ok(t) => t,
                Err(e) => return CopyOutcome::Error(e.to_string()),
            };
            // Remove existing destination entry if present (non-directory).
            if let Ok(existing) = dest_entry.symlink_metadata() {
                if existing.is_dir() {
                    return CopyOutcome::Error(format!("{}: is a directory", dest_entry.display()));
                }
                if let Err(e) = fs::remove_file(&dest_entry) {
                    return CopyOutcome::Error(e.to_string());
                }
            }
            if let Err(e) = fs::symlink(&target, &dest_entry) {
                return CopyOutcome::Error(e.to_string());
            }
        } else if file_type.is_dir() {
            match copy_dir_recursive(&entry_path, &dest_entry, force, interactive) {
                CopyOutcome::Success => {}
                CopyOutcome::Declined => return CopyOutcome::Declined,
                CopyOutcome::Error(msg) => return CopyOutcome::Error(msg),
            }
        } else if file_type.is_file() {
            match copy_path(&entry_path, &dest_entry, force, interactive) {
                CopyOutcome::Success => {}
                CopyOutcome::Declined => return CopyOutcome::Declined,
                CopyOutcome::Error(msg) => return CopyOutcome::Error(msg),
            }
        }
        // Other file types are excluded by scope.
    }

    CopyOutcome::Success
}
```

### Summary of semantic choices made

- **Recursive destination resolution**: When `dst` does not exist it becomes the tree root (no basename appended). When `dst` is an existing directory, the tree root is `dst/basename(src)`. This matches GNU `cp -r` behavior.
- **Symlinks in recursive trees**: Always recreated via `read_link` + `symlink`; never followed, regardless of whether they are dangling, cyclic, or point to directories.
- **Self-copy / directory-into-itself**: Detected after pair resolution using `canonicalize` + `is_prefix_of`. Exits immediately with status 1 before any filesystem mutation.
- **Error propagation in recursive copy**: The first error (or decline) in a tree stops that tree's copy and propagates to the top-level loop, which records the failure and moves to the next source operand. No rollback is performed.
- **New directory permissions**: Set via `DirBuilder::mode(source_mode)`; the OS applies the process umask (022 in the test environment), yielding `source_mode & !umask` as required.
