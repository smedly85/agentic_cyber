                if meta.is_dir() {
                    eprintln!("error: {} is a directory", os_display(src));
                    std::process::exit(1);
                }
            }
        }
        if let (Ok(s), Ok(d)) = (fs::canonicalize(src_path), fs::canonicalize(Path::new(dst))) {
            if s == d {
                eprintln!(
                    "error: '{}' and '{}' are the same file",
                    os_display(src),
                    os_display(dst)
                );
                std::process::exit(1);
            }
