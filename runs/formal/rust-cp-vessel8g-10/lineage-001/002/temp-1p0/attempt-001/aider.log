use std::env;
use std::ffi::{OsStr, OsString};
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::OpenOptionsExt;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;

enum CopyOutcome {
    Success,
    Declined,
    Error(String),
}

fn main() {
    let args: Vec<OsString> = env::args_os().collect();
    let user_args: &[OsString] = &args[1..];

    let (operands, force, interactive) = match parse_operands(user_args) {
        Ok(v) => v,
        Err(msg) => {
            eprintln!("{}", msg);
            std::process::exit(1);
        }
    };

    if operands.len() < 2 {
        eprintln!("error: requires at least SOURCE and DEST");
        std::process::exit(1);
    }

    let pairs: Vec<(OsString, OsString)> = if operands.len() == 2 {
        let src = &operands[0];
        let dst = &operands[1];
        if Path::new(dst).is_dir() {
            vec![(src.clone(), Path::new(dst).join(basename(src)).into_os_string())]
        } else {
            vec![(src.clone(), dst.clone())]
        }
    } else {
        let dir = &operands[operands.len() - 1];
        if !Path::new(dir).is_dir() {
            eprintln!("error: {} is not a directory", os_display(dir));
            std::process::exit(1);
        }
        operands[..operands.len() - 1]
            .iter()
            .map(|src| (src.clone(), Path::new(dir).join(basename(src)).into_os_string()))
            .collect()
    };

    // Invocation-wide validation: directory sources and self-copy
    for (src, dst) in &pairs {
        let src_path = Path::new(src);
        if let Ok(meta) = fs::metadata(src_path) {
            if meta.is_dir() {
                eprintln!("error: {} is a directory", os_display(src));
                std::process::exit(1);
            }
        }
        if let (Ok(s), Ok(d)) = (fs::canonicalize(src_path), fs::canonicalize(Path::new(dst))) {
            if s == d {
                eprintln!(
                    "error: '{}' and '{}' are the same file",
                    os_display(src),
                    os_display(dst)
                );
                std::process::exit(1);
            }
        }
    }

    // Perform copies in operand order; continue on per-source failure
    let mut had_error = false;
    for (src, dst) in &pairs {
        match copy_path(Path::new(src), Path::new(dst), force, interactive) {
            CopyOutcome::Success => {}
            CopyOutcome::Declined => {
                had_error = true;
            }
            CopyOutcome::Error(msg) => {
                eprintln!("error: {}: {}", os_display(src), msg);
                had_error = true;
            }
        }
    }

    if had_error {
        std::process::exit(1);
    }
}

fn parse_operands(args: &[OsString]) -> Result<(Vec<OsString>, bool, bool), String> {
    let mut operands = Vec::new();
    let mut force = false;
    let mut interactive = false;
    let mut after_separator = false;

    for arg in args {
        if !after_separator && arg.as_os_str() == OsStr::new("--") {
            after_separator = true;
            continue;
        }
        if !after_separator {
            let bytes = arg.as_bytes();
            if bytes.len() > 1 && bytes[0] == b'-' {
                if arg.as_os_str() == OsStr::new("-f") || arg.as_os_str() == OsStr::new("--force") {
                    force = true;
                    continue;
                }
                if arg.as_os_str() == OsStr::new("-i") || arg.as_os_str() == OsStr::new("--interactive") {
                    interactive = true;
                    continue;
                }
                return Err(format!(
                    "error: unknown option '{}'",
                    os_display(arg.as_os_str())
                ));
            }
        }
        operands.push(arg.clone());
    }

    Ok((operands, force, interactive))
}

fn basename(path: &OsStr) -> OsString {
    Path::new(path)
        .file_name()
        .map(|f| f.to_os_string())
        .unwrap_or_else(|| path.to_os_string())
}

fn os_display(s: &OsStr) -> String {
    s.to_string_lossy().into_owned()
}

fn prompt_yes() -> bool {
    let mut stdin = std::io::stdin().lock();
    let mut line = Vec::new();
    let mut byte = [0u8; 1];
    loop {
        match stdin.read(&mut byte) {
            Ok(0) => break,
            Ok(1) => {
                if byte[0] == b'\n' {
                    break;
                }
                line.push(byte[0]);
            }
            Err(_) => break,
        }
    }
    line.first() == Some(&b'y') || line.first() == Some(&b'Y')
}

fn copy_path(src: &Path, dst: &Path, force: bool, interactive: bool) -> CopyOutcome {
    let src_file = match fs::File::open(src) {
        Ok(f) => f,
        Err(e) => return CopyOutcome::Error(e.to_string()),
    };
    let mode = match src_file.metadata() {
        Ok(m) => m.permissions().mode() & 0o777,
        Err(e) => return CopyOutcome::Error(e.to_string()),
    };

    // Inspect destination via lstat
    if let Ok(dst_meta) = fs::symlink_metadata(dst) {
        if dst_meta.is_dir() {
            return CopyOutcome::Error(format!("{}: is a directory", dst.display()));
        }

        // Destination exists and is not a directory; prompt if interactive
        if interactive {
            eprint!("cp: overwrite '{}'? ", dst.display());
            let _ = std::io::stderr().flush();
            if !prompt_yes() {
                return CopyOutcome::Declined;
            }
        }

        if dst_meta.file_type().is_symlink() {
            match fs::metadata(dst) {
                Ok(target) => {
                    if !target.is_file() {
                        return CopyOutcome::Error(format!("{}: not a regular file", dst.display()));
                    }
                    let mut dst_file = match fs::OpenOptions::new()
                        .write(true)
                        .truncate(true)
                        .open(dst)
                    {
                        Ok(f) => f,
                        Err(e) => return CopyOutcome::Error(e.to_string()),
                    };
                    if let Err(e) = io::copy(&mut src_file, &mut dst_file) {
                        return CopyOutcome::Error(e.to_string());
                    }
                    return CopyOutcome::Success;
                }
                Err(_) => {
                    // Dangling symlink
                    if !force {
                        return CopyOutcome::Error(format!("{}: dangling symlink", dst.display()));
                    }
                    if let Err(e) = fs::remove_file(dst) {
                        return CopyOutcome::Error(e.to_string());
                    }
                }
            }
        }
    }

    // Open destination for writing (truncates existing files, creates new ones)
    let dst_file = match fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .mode(mode)
        .open(dst)
    {
        Ok(f) => f,
        Err(e) if force => {
            if let Ok(meta) = fs::symlink_metadata(dst) {
                if meta.is_dir() {
                    return CopyOutcome::Error(e.to_string());
                }
                if let Err(re) = fs::remove_file(dst) {
                    return CopyOutcome::Error(re.to_string());
                }
            }
            match fs::OpenOptions::new()
                .write(true)
                .create(true)
                .truncate(true)
                .mode(mode)
                .open(dst)
            {
                Ok(f) => f,
                Err(e) => return CopyOutcome::Error(e.to_string()),
            }
        }
        Err(e) => return CopyOutcome::Error(e.to_string()),
    };

    if let Err(e) = io::copy(&mut src_file, &mut dst_file) {
        return CopyOutcome::Error(e.to_string());
    }
    CopyOutcome::Success
}
```

**Files changed:** `src/rust_cp/rust_cp.rs`

**Behavior implemented:**

- **`-i`/`--interactive`**: Parsed as an option before `--`. Before overwriting an existing non-directory destination, a prompt `cp: overwrite 'DEST'? ` is written to stderr and one line is consumed from stdin. Only a first byte of ASCII `y` (0x79) or `Y` (0x59) affirms; leading whitespace, empty input, EOF, and any other first byte all decline. Decline preserves the destination, contributes exit status 1, prints no additional error, and processing continues to the next source. No prompt is issued when the destination does not exist.

- **`-f` + `-i` interaction**: When both flags are set, the interactive prompt is issued before any force-removal or truncation. If the user declines, no destructive action occurs. If affirmed, the force logic proceeds (remove-and-recreate on open failure).

- **`-f`/`--force`** (preserved): Idempotent overwrite of existing regular destinations retaining their permissions; on open failure for an existing non-directory destination, removes the entry and creates a replacement with source rwx bits masked by umask; does not bypass source/parent permissions or replace directories.

**Interpretation chosen:** "Only an initial ASCII y or Y affirms" is interpreted as the first byte of the consumed line (excluding the trailing newline) must be `y` or `Y`; this means leading whitespace causes a decline since the first byte is not `y`/`Y`.
