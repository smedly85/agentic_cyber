use std::env;
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::fs::OpenOptionsExt;
use std::os::unix::fs::PermissionsExt;
use std::path::Path;
use std::process;

fn copy_path(src: &Path, dst: &Path) -> io::Result<()> {
    // Open source for reading
    let src_file = fs::File::open(src)?;
    let src_meta = src_file.metadata()?;
    
    // Check if dest exists
    let dst_meta = match fs::metadata(dst) {
        Ok(m) => Some(m),
        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
        Err(e) => return Err(e),
    };
    
    let dst_file = if dst_meta.is_some() {
        // Overwrite existing
        fs::OpenOptions::new()
            .write(true)
            .truncate(true)
            .open(dst)?
    } else {
        // Create new file with source permissions (umask applied by kernel)
        fs::OpenOptions::new()
            .write(true)
            .create(true)
            .mode(src_meta.mode())
            .open(dst)?
    };
    
    // Copy contents
    io::copy(&src_file, &dst_file)?;
    
    Ok(())
}
```

