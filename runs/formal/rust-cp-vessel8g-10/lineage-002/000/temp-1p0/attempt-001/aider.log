Now let me write the full implementation:

```rust
use std::env;
use std::ffi::OsString;
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
use std::path::Path;
use std::process;

fn copy_path(src: &Path, dst: &Path) -> io::Result<()> {
    let src_meta = fs::metadata(src)?;
    if !src_meta.is_file() {
        return Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "source is not a regular file",
        ));
    }

    // Validate destination
    match fs::symlink_metadata(dst) {
        Ok(dst_lmeta) => {
            if dst_lmeta.is_dir() {
                return Err(io::Error::new(
                    io::ErrorKind::InvalidInput,
                    "destination is a directory",
                ));
            }
            if dst_lmeta.is_symlink() {
                // Check that the symlink target is a valid regular file
                let dst_meta = fs::metadata(dst)?;
                if !dst_meta.is_file() {
                    return Err(io::Error::new(
                        io::ErrorKind::InvalidInput,
                        "destination is not a regular file",
                    ));
                }
            }
        }
        Err(e) if e.kind() == io::ErrorKind::NotFound => {
            // Will create new
        }
        Err(e) => return Err(e),
    }

    // Self-copy check (before any destructive changes)
    if is_same_file(src, dst) {
        return Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "source and destination are the same file",
        ));
    }

    // Open source
    let src_file = fs::File::open(src)?;

    // Open/create destination
    let dst_file = if fs::symlink_metadata(dst).is_ok() {
        // Dest exists (regular file or symlink to regular file)
        fs::OpenOptions::new()
            .write(true)
            .truncate(true)
            .open(dst)?
    } else {
        // Create new file with source permissions (kernel applies umask)
        let mode = src_meta.mode();
        fs::OpenOptions::new()
            .write(true)
            .create(true)
            .mode(mode)
            .open(dst)?
    };

    // Copy data
    let mut reader = src_file;
    let mut writer = dst_file;
    io::copy(&mut reader, &mut writer)?;
    writer.flush()?;

    Ok(())
}

fn is_same_file(a: &Path, b: &Path) -> bool {
    match (fs::metadata(a), fs::metadata(b)) {
        (Ok(ma), Ok(mb)) => ma.dev() == mb.dev() && ma.ino() == mb.ino(),
        _ => false,
    }
}

fn display_path(p: &Path) -> String {
    p.to_string_lossy().into_owned()
}

fn main() {
    let args: Vec<OsString> = env::args_os().skip(1).collect();
    
    // Parse arguments
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in &args {
        if !after_ddash && arg == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && arg.to_string_lossy().starts_with('-') && *arg != "-" {
            eprintln!("rust_cp: unknown option: {}", arg.to_string_lossy());
            process::exit(1);
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("rust_cp: missing operand");
        process::exit(1);
    }

    let last = &operands[operands.len() - 1];
    let sources: Vec<&OsString> = if operands.len() == 2 {
        vec![&operands[0]]
    } else {
        // Last operand must be an existing directory
        let last_path = Path::new(last);
        if !last_path.is_dir() {
            eprintln!("rust_cp: {} is not a directory", display_path(last_path));
            process::exit(1);
        }
        operands[0..operands.len() - 1].iter().collect()
    };

    let mut had_error = false;

    for source in &sources {
        let src_path = Path::new(source);
        
        // Determine destination
        let dst_path: std::path::PathBuf = if operands.len() == 2 {
            Path::new(last).to_path_buf()
        } else {
            let filename = src_path.file_name().unwrap_or_else(|| src_path.as_os_str());
            last.join(filename)
        };
        
        match copy_path(src_path, &dst_path) {
            Ok(()) => {}
            Err(e) => {
                eprintln!("rust_cp: {} -> {}: {}", 
                    display_path(src_path),
                    display_path(&dst_path),
                    e);
                had_error = true;
            }
        }
    }

    if had_error {
        process::exit(1);
    }
}
```

