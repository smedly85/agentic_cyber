fn copy_file_contents(src: &Path, dest: &Path) -> io::Result<()> {
    let src_file = File::open(src)?;
    let dest_file = OpenOptions::new()
        .write(true)
        .truncate(true)
        .open(dest)?;
    io::copy(&src_file, &dest_file)?;
    dest_file.flush()?;
    Ok(())
}

fn copy_file_contents_new(src: &Path, dest: &Path, mode: u32) -> io::Result<()> {
    let src_file = File::open(src)?;
    let dest_file = OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .mode(mode)
        .open(dest)?;
    io::copy(&src_file, &dest_file)?;
    dest_file.flush()?;
    Ok(())
}
```

