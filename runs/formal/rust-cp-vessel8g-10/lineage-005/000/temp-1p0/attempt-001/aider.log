fn main() {
    let args: Vec<String> = env::args().collect();
    let operands = match parse_args(&args[1..]) {
        Ok(o) => o,
        Err(e) => { eprintln!("{}", e); process::exit(1); }
    };
    
    let sources: Vec<String> = if operands.len() == 2 {
        vec![operands[0].clone()]
    } else {
        // Last operand must be a directory
        let dir = Path::new(&operands[operands.len()-1]);
        if !dir.is_dir() {
            eprintln!("{}: not a directory", operands[operands.len()-1]);
            process::exit(1);
        }
        operands[..operands.len()-1].to_vec()
    };
    
    let dest: String = if operands.len() == 2 {
        operands[1].clone()
    } else {
        String::new() // will be computed per source
    };
    
    let mut any_failed = false;
    
    for src in &sources {
        let src_path = Path::new(src);
        
        // Determine destination
        let dest_path: PathBuf = if operands.len() == 2 {
            PathBuf::from(&operands[1])
        } else {
            // DIRECTORY/source-basename
