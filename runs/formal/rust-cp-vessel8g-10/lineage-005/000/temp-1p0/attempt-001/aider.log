```rust
use std::ffi::OsString;
use std::fs::{self, File, OpenOptions};
use std::io::{self, Read, Write};
use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
use std::path::{Path, PathBuf};
use std::process;

fn main() {
    let args: Vec<OsString> = std::env::args_os().collect();
    
    // Parse: handle -- separator, reject unknown options
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    for arg in &args[1..] {
        if !after_ddash && arg == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash {
            let bytes = arg.as_bytes(); // hmm, OsString doesn't have as_bytes directly on all platforms
            // On Unix, we can check if it starts with '-'
            let s = arg.to_string_lossy();
            if s.len() > 1 && s.starts_with('-') {
                eprintln!("rust_cp: unknown option: {}", s);
                process::exit(1);
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        eprintln!("rust_cp: missing operand");
        process::exit(1);
    }
    
    // Determine sources and destination
    let multi = operands.len() > 2;
    let dest_dir: Option<&Path> = if multi {
        let d = Path::new(operands.last().unwrap());
        if !d.is_dir() {
            eprintln!("rust_cp: {}: not a directory", d.display());
            process::exit(1);
        }
        Some(d)
    } else {
        None
    };
    
    let sources: Vec<&Path> = if multi {
        operands[..operands.len()-1].iter().map(|o| Path::new(o.as_os_str())).collect()
    } else {
        vec![Path::new(operands[0].as_os_str())]
    };
    
    let single_dest: Option<&Path> = if !multi {
        Some(Path::new(operands[1].as_os_str()))
    } else {
        None
    };
    
    let mut any_failed = false;
    
    for src in &sources {
        // Determine effective destination
        let effective_dest: PathBuf;
        if let Some(dir) = dest_dir {
            let basename = src.file_name().unwrap_or(src.as_os_str());
            effective_dest = dir.join(basename);
        } else {
            let dest = single_dest.unwrap();
            if dest.is_dir() {
                let basename = src.file_name().unwrap_or(src.as_os_str());
                effective_dest = dest.join(basename);
            } else {
                effective_dest = dest.to_path_buf();
            }
        }
        
        if let Err(e) = copy_path(src, &effective_dest) {
            eprintln!("rust_cp: {}: {}", src.display(), e);
            any_failed = true;
        }
    }
    
    if any_failed {
        process::exit(1);
    }
}

fn copy_path(src: &Path, dest: &Path) -> io::Result<()> {
    // Resolve source (follow symlinks)
    let src_resolved = fs::canonicalize(src)?;
    let src_meta = fs::metadata(&src_resolved)?;
    
    if src_meta.is_dir() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "is a directory"));
    }
    if !src_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "is not a regular file"));
    }
    
    // Get source permissions
    let src_mode = src_meta.permissions().mode() & 0o777;
    
    // Resolve destination
    let dest_resolved = match fs::canonicalize(dest) {
        Ok(p) => p,
        Err(e) => {
            // Could be dangling symlink or non-existent
            if let Ok(link_meta) = fs::symlink_metadata(dest) {
                if link_meta.file_type().is_symlink() {
                    return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a dangling symlink"));
                }
                // If symlink_metadata succeeds but canonicalize fails, it might be a broken link
                // Actually if symlink_metadata succeeds, the path exists. If canonicalize fails, it's dangling.
                // But we already checked is_symlink above.
            }
            // Path doesn't exist at all - check parent
            let parent = dest.parent().unwrap_or_else(|| Path::new("."));
            if !parent.is_dir() {
                return Err(io::Error::new(io::ErrorKind::NotFound, "no such file or directory"));
            }
            // Create new file
            let src_file = File::open(&src_resolved)?;
            let mut dest_file = OpenOptions::new()
                .write(true)
                .create(true)
                .truncate(true)
                .mode(src_mode)
                .open(dest)?;
            io::copy(&src_file, &mut dest_file)?;
            dest_file.flush()?;
            return Ok(());
        }
    };
    
    // Destination exists
    let dest_meta = fs::metadata(&dest_resolved)?;
    if dest_meta.is_dir() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a directory"));
    }
    if !dest_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is not a regular file"));
    }
    
    // Self-copy check (inode comparison)
    if src_meta.dev() == dest_meta.dev() && src_meta.ino() == dest_meta.ino() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "are the same file"));
    }
    
    // Overwrite existing destination (retain its permissions)
    let src_file = File::open(&src_resolved)?;
    let mut dest_file = OpenOptions::new()
        .write(true)
        .truncate(true)
        .open(&dest_resolved)?;
    io::copy(&src_file, &mut dest_file)?;
    dest_file.flush()?;
    Ok(())
}
```

