fn copy_file_contents(src: &Path, dest: &Path, mode: Option<u32>) -> io::Result<()> {
    let src_file = File::open(src)?;
    let mut opts = OpenOptions::new();
    opts.write(true).truncate(true).create(true);
    if let Some(m) = mode {
        opts.mode(m);
    }
    let mut dest_file = opts.open(dest)?;
    io::copy(&src_file, &mut dest_file)?;
    dest_file.flush()?;
    Ok(())
}
```

