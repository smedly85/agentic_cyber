            // Create new file with source permissions (masked by umask via kernel)
            let src_mode = src_meta.permissions().mode() & 0o777;
            copy_file_contents_new(&src_resolved, dest, src_mode)?;
        }
        Err(e) => return Err(e),
    }
    Ok(())
}
```

