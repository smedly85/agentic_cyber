fn copy_path(src: &Path, dest: &Path) -> io::Result<()> {
    // Resolve source
    let src_resolved = fs::canonicalize(src)?;
    let src_meta = fs::metadata(&src_resolved)?; // follows symlinks
    if src_meta.is_dir() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "source is a directory"));
    }
    if !src_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "source is not a regular file"));
    }
    
    // Resolve destination
    let dest_resolved_result = fs::canonicalize(dest);
    
    match dest_resolved_result {
        Ok(dest_resolved) => {
            let dest_meta = fs::metadata(&dest_resolved)?;
            if dest_meta.is_dir() {
                return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a directory"));
            }
            if !dest_meta.is_file() {
                return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is not a regular file"));
            }
            // Self-copy check
            if src_resolved == dest_resolved {
                return Err(io::Error::new(io::ErrorKind::InvalidInput, "source and destination are the same file"));
            }
            // Overwrite existing file
            copy_file_contents(&src_resolved, &dest_resolved)?;
            // Retain existing dest permissions (don't chmod)
        }
        Err(e) if e.kind() == io::ErrorKind::NotFound => {
            // Check if it's a dangling symlink
            if let Ok(link_meta) = fs::symlink_metadata(dest) {
                if link_meta.file_type().is_symlink() {
                    return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a dangling symlink"));
                }
            }
            // New file - check parent exists
            let parent = dest.parent().unwrap_or(Path::new("."));
            if !parent.is_dir() {
                return Err(io::Error::new(io::ErrorKind::NotFound, "destination parent does not exist"));
