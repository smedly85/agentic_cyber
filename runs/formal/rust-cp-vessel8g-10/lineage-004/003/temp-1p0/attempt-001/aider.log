                }
            }
            Err(e) => return fail(e),
        }
    } else {
        match fs::OpenOptions::new()
            .write(true)
            .create(true)
            .mode(source_perms)
            .open(dest)
        {
            Ok(f) => f,
            Err(e) => return fail(e),
        }
    };

    if let Err(e) = io::copy(&mut src_file, &mut dst_file) {
        return fail(e);
    }

    CopyResult::Success
}

fn is_copy_into_self(source: &Path, dest: &Path) -> bool {
    let canonical_source = match source.canonicalize() {
