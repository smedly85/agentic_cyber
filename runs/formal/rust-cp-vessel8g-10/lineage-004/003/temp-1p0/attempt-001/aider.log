fn would_copy_into_self(source: &Path, dest: &Path) -> bool {
    let canonical_source = match source.canonicalize() {
        Ok(p) => p,
        Err(_) => return false, // can't check, let it fail later
    };
    
    if dest.exists() {
        let canonical_dest = match dest.canonicalize() {
            Ok(p) => p,
            Err(_) => return false,
        };
        canonical_dest == canonical_source || canonical_dest.starts_with(&canonical_source)
    } else {
        // dest doesn't exist; check if it's lexically inside source
        // Try to canonicalize the parent
        let dest_parent = dest.parent().unwrap_or(dest);
        let canonical_parent = match dest_parent.canonicalize() {
            Ok(p) => p,
            Err(_) => return false,
        };
        // The dest would be canonical_parent / last_component
        // Check if canonical_parent is inside canonical_source
        canonical_parent == canonical_source || canonical_parent.starts_with(&canonical_source)
    }
}
