        }
        Err(ref e) if e.kind() == io::ErrorKind::NotFound => {
            dest_is_file = false;
            dst_meta = None;
            if fs::symlink_metadata(dest).is_ok() {
                return CopyResult::Failed("destination is a dangling symlink".to_string());
            }
        }
        Err(e) => return fail(e),
    }

