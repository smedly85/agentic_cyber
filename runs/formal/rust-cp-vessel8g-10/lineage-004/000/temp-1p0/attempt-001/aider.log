            eprintln!("error: {} is not a directory", dest_dir.to_string_lossy());
            process::exit(1);
        }
        pairs = operands[..operands.len() - 1].iter().map(|src| {
            let basename = Path::new(src).file_name().unwrap_or(src.as_os_str());
            let dest = Path::new(dest_dir).join(basename);
