```rust
use std::ffi::{OsStr, OsString};
use std::fs;
use std::io;
use std::os::unix::fs::MetadataExt;
use std::os::unix::fs::OpenOptionsExt;
use std::path::Path;
use std::process;

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();
    
    // Parse arguments
    let operands = parse_operands(&args);
    let operands = match operands {
        Ok(o) => o,
        Err(msg) => {
            eprintln!("{}", msg);
            process::exit(1);
        }
    };
    
    // Build (source, dest) pairs
    let pairs: Vec<(OsString, OsString)>;
    if operands.len() == 2 {
        pairs = vec![(operands[0].clone(), operands[1].clone())];
    } else {
        let dest_dir = operands[operands.len() - 1].clone();
        if !Path::new(&dest_dir).is_dir() {
            eprintln!("error: {} is not an existing directory", dest_dir.to_string_lossy());
            process::exit(1);
        }
        pairs = operands[..operands.len() - 1].iter().map(|src| {
            let basename = Path::new(src).file_name().map(|f| f.to_owned()).unwrap_or_else(|| src.clone());
            let dest = Path::new(&dest_dir).join(&basename);
            (src.clone(), dest)
        }).collect();
    };
    
    // Execute copies in order, continue on failure
    let mut any_failed = false;
    for (src, dst) in &pairs {
        match copy_path(Path::new(src), Path::new(dst)) {
            Ok(()) => {}
            Err(e) => {
                eprintln!("{}: {}: {}", src.to_string_lossy(), dst.to_string_lossy(), e);
                any_failed = true;
            }
        }
    }
    
    process::exit(if any_failed { 1 } else { 0 });
}

fn parse_operands(args: &[OsString]) -> Result<Vec<OsString>, String> {
    let mut operands = Vec::new();
    let mut after_ddash = false;
    
    for arg in args {
        let os = arg.as_os_str();
        if !after_ddash && os == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && os != "-" && os.starts_with("-") {
            return Err(format!("unknown option: {}", os.to_string_lossy()));
        }
        operands.push(arg.clone());
    }
    
    if operands.len() < 2 {
        return Err("missing operand".to_string());
    }
    
    Ok(operands)
}

fn copy_path(source: &Path, dest: &Path) -> io::Result<()> {
    // Validate source: must resolve to a regular file
    let source_meta = fs::metadata(source)?;
    if !source_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "not a regular file"));
    }
    
    // Validate destination
    let dest_is_file = match fs::metadata(dest) {
        Ok(m) if m.is_file() => true,
        Ok(m) if m.is_dir() => {
            return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a directory"));
        }
        Ok(_) => {
            return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is not a regular file"));
        }
        Err(ref e) if e.kind() == io::ErrorKind::NotFound => {
            match fs::symlink_metadata(dest) {
                Ok(_) => {
                    return Err(io::Error::new(io::ErrorKind::InvalidInput, "destination is a dangling symlink"));
                }
                Err(_) => false,
            }
        }
        Err(e) => return Err(e),
    };
    
    // Self-copy detection
    if dest_is_file {
        let dst_meta = fs::metadata(dest).unwrap();
        if source_meta.dev() == dst_meta.dev() && source_meta.ino() == dst_meta.ino() {
            return Err(io::Error::new(io::ErrorKind::InvalidInput, "source and destination are the same file"));
        }
    }
    
    // Open source for reading
    let mut src_file = fs::File::open(source)?;
    let source_perms = source_meta.mode() & 0o777;
    
    // Open/create destination
    let dst_file = if dest_is_file {
        fs::OpenOptions::new().write(true).truncate(true).open(dest)?
    } else {
        fs::OpenOptions::new().write(true).create(true).mode(source_perms).open(dest)?
    };
    
    // Copy contents
    io::copy(&mut src_file, &mut dst_file)?;
    
    Ok(())
}
```

