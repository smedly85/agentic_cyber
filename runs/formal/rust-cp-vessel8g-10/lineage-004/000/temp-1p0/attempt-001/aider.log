use std::ffi::OsString;
use std::fs;
use std::io;
use std::os::unix::fs::MetadataExt;
use std::os::unix::fs::OpenOptionsExt;
use std::path::Path;
use std::process;

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let operands = match parse_operands(&args) {
        Ok(o) => o,
        Err(msg) => {
            eprintln!("{}", msg);
            process::exit(1);
        }
    };

    // Build (source, dest) pairs
    let pairs: Vec<(OsString, OsString)>;
    if operands.len() == 2 {
        pairs = vec![(operands[0].clone(), operands[1].clone())];
    } else {
        let dest_dir = operands[operands.len() - 1].clone();
        if !Path::new(&dest_dir).is_dir() {
            eprintln!("error: {} is not an existing directory", dest_dir.to_string_lossy());
            process::exit(1);
        }
        pairs = operands[..operands.len() - 1]
            .iter()
            .map(|src| {
                let basename = Path::new(src)
                    .file_name()
                    .map(|f| f.to_owned())
                    .unwrap_or_else(|| src.clone());
                let dest = Path::new(&dest_dir).join(&basename);
                (src.clone(), dest)
            })
            .collect();
    }

    // Execute copies in operand order; continue after per-source failures
    let mut any_failed = false;
    for (src, dst) in &pairs {
        if let Err(e) = copy_path(Path::new(src), Path::new(dst)) {
            eprintln!(
                "{}: {}: {}",
                src.to_string_lossy(),
                dst.to_string_lossy(),
                e
            );
            any_failed = true;
        }
    }

    process::exit(if any_failed { 1 } else { 0 });
}

fn parse_operands(args: &[OsString]) -> Result<Vec<OsString>, String> {
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;

    for arg in args {
        if !after_ddash && arg == "--" {
            after_ddash = true;
            continue;
        }
        if !after_ddash && arg != "-" && arg.starts_with("-") {
            return Err(format!("unknown option: {}", arg.to_string_lossy()));
        }
        operands.push(arg.clone());
    }

    if operands.len() < 2 {
        return Err("missing operand".to_string());
    }

    Ok(operands)
}

/// Core filesystem copy operation: copies a regular file from `source` to `dest`.
/// Follows symlinks on both sides, detects self-copy by device+inode,
/// retains existing dest permissions on overwrite, applies source permissions
/// (masked by umask) on creation.
fn copy_path(source: &Path, dest: &Path) -> io::Result<()> {
    // Validate source: must resolve to a regular file
    let source_meta = fs::metadata(source)?;
    if !source_meta.is_file() {
        return Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "source is not a regular file",
        ));
    }

    // Validate destination and determine if it exists as a regular file
    let dest_is_file: bool;
    let dst_meta: Option<fs::Metadata>;

    match fs::metadata(dest) {
        Ok(m) if m.is_file() => {
            dest_is_file = true;
            dst_meta = Some(m);
        }
        Ok(m) if m.is_dir() => {
            return Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "destination is a directory",
            ));
        }
        Ok(_) => {
            return Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "destination is not a regular file",
            ));
        }
        Err(ref e) if e.kind() == io::ErrorKind::NotFound => {
            dest_is_file = false;
            dst_meta = None;
            // Distinguish dangling symlink from non-existent path
            if fs::symlink_metadata(dest).is_ok() {
                return Err(io::Error::new(
                    io::ErrorKind::InvalidInput,
                    "destination is a dangling symlink",
                ));
            }
        }
        Err(e) => return Err(e),
    }

    // Self-copy detection via device + inode (catches hard links and aliases)
    if let Some(dm) = &dst_meta {
        if source_meta.dev() == dm.dev() && source_meta.ino() == dm.ino() {
            return Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "source and destination are the same file",
            ));
        }
    }

    // Open source for reading
    let mut src_file = fs::File::open(source)?;
    let source_perms = source_meta.mode() & 0o777;

    // Open or create destination
    let dst_file = if dest_is_file {
        // Overwrite: truncate, retain existing permissions
        fs::OpenOptions::new().write(true).truncate(true).open(dest)?
    } else {
        // Create new: OS applies source_perms & ~umask
        fs::OpenOptions::new()
            .write(true)
            .create(true)
            .mode(source_perms)
            .open(dest)?
    };

    // Copy contents
    io::copy(&mut src_file, &mut dst_file)?;

    Ok(())
}
```

**Key design decisions:**

1. **`copy_path` is the semantic anchor** — called directly from `main`'s loop, contains all core filesystem logic.
2. **No umask setting needed** — the test harness (`engine.py`) sets `umask=0o022` in the process environment. For new files, `OpenOptionsExt::mode(source_perms)` causes the kernel to apply `source_perms & ~umask`, giving correct permissions. For existing files, we open with truncate only, preserving their rwx bits.
3. **Self-copy via `dev()+ino()`** — catches hard links, symlinks-to-self, and bind-mount aliases; checked before any write.
4. **Per-source continuation** — the loop in `main` catches errors, prints a diagnostic identifying both operands, and continues to the next pair.
5. **Invocation-wide validation first** — arg parsing, operand count, and multi-source directory check all happen before `copy_path` is ever called.
6. **`OsString` throughout** — preserves arbitrary non-NUL bytes including invalid UTF-8 in pathnames.
7. **No panics** — all fallible operations use `?` or explicit `match`; no `.unwrap()`/`.expect()` on fallible paths.

**Files changed:** `src/rust_cp/rust_cp.rs` (created from empty).

**Behavior implemented:**
- `SOURCE DEST` and `SOURCE... DIRECTORY` operand forms
- `--` terminator; unknown options rejected; bare `-` treated as filename
- Regular file copy with byte-for-byte content preservation
- Source symlinks followed to regular files; destination symlinks followed to regular files; dangling dest symlinks rejected
- Directory sources rejected; directory destinations (in 2-operand form) rejected
- Self-copy (including hard links and aliases) rejected before any destructive change
- New files: source rwx & ~umask; existing files: rwx retained
- Per-source error continuation with status 1; success gives status 0, empty stdout/stderr
- Missing destination parents not created (natural OS behavior)
- Arbitrary non-NUL pathname bytes preserved via `OsString`
