fn copy_path(source: &Path, dest: &Path) -> io::Result<()> {
    // 1. Validate source: must be a regular file (following symlinks)
    let source_meta = fs::metadata(source)?; // follows symlinks
    if !source_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::InvalidInput, "source is not a regular file"));
    }
    
    // 2. Validate dest
    let dest_meta = fs::symlink_metadata(dest);
    match dest_meta {
        Ok(dm) => {
            if dm.is_symlink() {
                // Follow the symlink
                let resolved = fs::metadata(dest)?; // follows symlink, will fail if dangling
                if !resolved.is_file() {
                    return Err(...);
                }
            } else if dm.is_dir() {
                return Err(...); // incompatible type
            } else if dm.is_file() {
                // regular file, will overwrite
            } else {
                return Err(...); // special file
            }
        }
        Err(e) if e.kind() == io::ErrorKind::NotFound => {
            // dest doesn't exist, will create
        }
        Err(e) => return Err(e),
    }
    
    // 3. Self-copy check
    let source_canon = fs::canonicalize(source)?;
    // For dest, only check if it exists (otherwise can't be self-copy)
    if let Ok(dest_meta) = fs::metadata(dest) {
        if dest_meta.is_file() {
            let dest_canon = fs::canonicalize(dest)?;
            if source_canon == dest_canon {
                return Err(io::Error::new(io::ErrorKind::InvalidInput, "self-copy detected"));
            }
        }
    }
    
    // 4. Copy
    let source_perms = source_meta.mode() & 0o777;
    let dest_existed = fs::symlink_metadata(dest).map(|m| m.is_file() || (m.is_symlink() && fs::metadata(dest).map(|r| r.is_file()).unwrap_or(false))).unwrap_or(false);
    
    // Open source
    let mut src = fs::File::open(source)?;
    
    // Open dest
    let dst = if dest_existed {
        fs::OpenOptions::new().write(true).truncate(true).open(dest)?
    } else {
        use std::os::unix::fs::OpenOptionsExt;
        fs::OpenOptions::new().write(true).create(true).mode(source_perms).open(dest)?
    };
    
    // Copy bytes
    io::copy(&mut src, &mut dst)?;
    
    Ok(())
}
```

