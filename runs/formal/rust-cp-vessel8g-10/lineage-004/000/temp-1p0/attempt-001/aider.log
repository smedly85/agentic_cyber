fn parse_args(args: Vec<OsString>) -> Result<Vec<OsString>, String> {
    let mut operands: Vec<OsString> = Vec::new();
    let mut after_ddash = false;
    
    for arg in args {
        if !after_ddash && arg == OsString::from("--") {
            after_ddash = true;
            continue;
