        return Err(format!("{} and {} are the same file", src.to_string_lossy(), dest.to_string_lossy()));
    }

    let src_perm = src_meta.permissions().mode();

    if dest_is_new {
        let mut file = fs::OpenOptions::new()
            .write(true)
            .create_new(true)
            .mode(src_perm & 0o777)
            .open(dest)
            .map_err(|e| format!("{}: {}", dest.to_string_lossy(), e))?;

