fn parse_operands(args: &[std::ffi::OsString]) -> Result<Vec<std::ffi::OsString>, String> {
    let mut operands = Vec::new();
    let mut after_ddash = false;
    for arg in args {
        if !after_ddash {
            let s = arg.to_string_lossy();
            if s == "--" {
                after_ddash = true;
                continue;
            }
            // Unknown option: starts with '-' and is not just '-'
            if s.starts_with('-') && s != "-" {
                return Err(format!("unknown option: {}", s));
            }
        }
        operands.push(arg.clone());
    }
    if operands.len() < 2 {
        return Err("missing operand".to_string());
    }
    Ok(operands)
}
```

