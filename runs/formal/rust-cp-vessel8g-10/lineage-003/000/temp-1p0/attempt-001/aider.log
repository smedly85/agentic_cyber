fn get_umask(dir: &Path) -> u32 {
    // Create a temp file in dir, check its mode, delete it
    let name = format!(".umask_probe_{}", std::process::id());
    let path = dir.join(&name);
    if let Err(_) = std::fs::File::create(&path) {
        return 0o022; // fallback
    }
    let meta = std::fs::metadata(&path).unwrap();
    let mode = meta.permissions().mode();
    std::fs::remove_file(&path).ok();
    // Created with 0o666 & !umask, so umask bits within 0o666:
    0o666 & !mode
}
```

