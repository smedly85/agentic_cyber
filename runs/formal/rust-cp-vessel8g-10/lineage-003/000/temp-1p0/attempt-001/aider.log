use std::ffi::OsString;
use std::fs;
use std::io;
use std::os::unix::fs::MetadataExt;
use std::os::unix::fs::OpenOptionsExt;
use std::os::unix::fs::PermissionsExt;
use std::path::{Path, PathBuf};
use std::process;

fn copy_path(src: &Path, dest: &Path) -> Result<(), String> {
    // Resolve source (follows symlinks)
    let src_meta = fs::metadata(src)
        .map_err(|e| format!("{}: {}", src.display(), e))?;
    
    if src_meta.is_dir() {
        return Err(format!("{}: is a directory", src.display()));
    }
    
    // Determine dest status
    let dest_symlink_meta = match fs::symlink_metadata(dest) {
        Ok(m) => Some(m),
        Err(e) if e.kind() == io::ErrorKind::NotFound => None,
        Err(e) => return Err(format!("{}: {}", dest.display(), e)),
    };
    
    let dest_is_new = match &dest_symlink_meta {
        Some(meta) => {
            if meta.file_type().is_symlink() {
                // Follow the symlink
                match fs::metadata(dest) {
                    Ok(m) => {
                        if m.is_dir() {
                            return Err(format!("{}: is a directory", dest.display()));
                        }
                        false
                    }
                    Err(_) => {
                        return Err(format!("{}: dangling symbolic link", dest.display()));
                    }
                }
            } else if meta.is_dir() {
                return Err(format!("{}: is a directory", dest.display()));
            } else {
                false
            }
        }
        None => true,
    };
    
    // Self-copy check (before any destructive changes)
    if !dest_is_new {
        if let Ok(dest_meta) = fs::metadata(dest) {
            if src_meta.dev() == dest_meta.dev() && src_meta.ino() == dest_meta.ino() {
                return Err(format!(
                    "{} and {}: are the same file",
                    src.display(),
