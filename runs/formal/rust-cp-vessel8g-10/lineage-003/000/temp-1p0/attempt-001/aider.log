```rust
fn copy_path(src: &Path, dest: &Path) -> Result<(), String> {
    // 1. Resolve source - must be regular file (or symlink to regular file)
    let src_meta = fs::metadata(src).map_err(|e| {
        format!("{}: {}", src.display(), e)
    })?;
    if src_meta.is_dir() {
        return Err(format!("{}: is a directory", src.display()));
    }
    
    // 2. Check dest
    let dest_symlink_meta = fs::symlink_metadata(dest);
    let dest_is_new = match &dest_symlink_meta {
        Ok(meta) => {
            if meta.is_symlink() {
                // Check if it's dangling
                match fs::metadata(dest) {
                    Ok(m) => {
                        if m.is_dir() {
                            return Err(format!("{}: is a directory", dest.display()));
                        }
                        false // not new
                    }
                    Err(_) => {
                        return Err(format!("{}: dangling symbolic link", dest.display()));
                    }
                }
            } else if meta.is_dir() {
                return Err(format!("{}: is a directory", dest.display()));
            } else {
                false // existing regular file, not new
            }
        }
        Err(e) if e.kind() == io::ErrorKind::NotFound => true, // new file
        Err(e) => return Err(format!("{}: {}", dest.display(), e)),
    };
    
    // 3. Self-copy check
    if !dest_is_new {
        if let Ok(dest_meta) = fs::metadata(dest) {
            if src_meta.dev() == dest_meta.dev() && src_meta.ino() == dest_meta.ino() {
                return Err(format!("{} and {}: are the same file", src.display(), dest.display()));
            }
        }
    }
    
    // 4. Copy
    if dest_is_new {
        // Create with appropriate permissions
        let mode = src_meta.permissions().mode() & 0o777;
        fs::OpenOptions::new()
            .write(true)
            .create_new(true)
            .mode(mode)
            .open(dest)
            .and_then(|mut f| {
                let mut src_f = fs::File::open(src)?;
                io::copy(&mut src_f, &mut f)?;
                f.flush()?;
                Ok(())
            })
            .map_err(|e| format!("{}: {}", dest.display(), e))?;
    } else {
        // Overwrite existing
        let mut dst = fs::OpenOptions::new()
            .write(true)
            .truncate(true)
            .open(dest)
            .map_err(|e| format!("{}: {}", dest.display(), e))?;
        let mut src_f = fs::File::open(src)
            .map_err(|e| format!("{}: {}", src.display(), e))?;
        io::copy(&mut src_f, &mut dst).map_err(|e| format!("{}: {}", dest.display(), e))?;
        dst.flush().map_err(|e| format!("{}: {}", dest.display(), e))?;
    }
    
    Ok(())
}
```

