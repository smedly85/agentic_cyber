    let mut after_ddash = false;
    
    for arg in &args {
        if !after_ddash {
            if arg == OsString::from("--") {
                after_ddash = true;
                continue;
            }
            // Check if it looks like an option
            if arg != OsString::from("-") {
                let s = arg.to_string_lossy();
                if s.starts_with('-') {
                    // Unknown option
                    eprintln!("{}: unknown option", s);
                    process::exit(1);
                }
            }
        }
        operands.push(arg.clone());
    }
    
    if operands.is_empty() {
        eprintln!("missing operand");
        process::exit(1);
    }
    
    if operands.len() == 1 {
        eprintln!("missing destination operand");
        process::exit(1);
    }
    
    // Resolve targets
