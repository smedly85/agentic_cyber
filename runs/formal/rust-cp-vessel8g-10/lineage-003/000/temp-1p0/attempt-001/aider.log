```rust
use std::ffi::OsString;
use std::fs;
use std::io::{self, Read, Write};
use std::os::unix::ffi::OsStrExt;
use std::os::unix::fs::{MetadataExt, PermissionsExt};
use std::path::{Path, PathBuf};
use std::process;

fn main() {
    let args: Vec<OsString> = std::env::args_os().skip(1).collect();

    let operands = match parse_operands(&args) {
        Ok(o) => o,
        Err(msg) => {
            eprintln!("{}", msg);
            process::exit(1);
        }
    };

    let targets = match resolve_targets(&operands) {
        Ok(t) => t,
        Err(msg) => {
            eprintln!("{}", msg);
            process::exit(1);
        }
    };

    let mut any_failed = false;
    for (src, dest) in &targets {
        if let Err(e) = copy_path(src, dest) {
            eprintln!("{}", e);
            any_failed = true;
        }
    }

    process::exit(if any_failed { 1 } else { 0 });
}

fn parse_operands(args: &[OsString]) -> Result<Vec<OsString>, String> {
    let mut operands = Vec::new();
    let mut after_ddash = false;
    for arg in args {
        if !after_ddash {
            let bytes = arg.as_bytes();
            if bytes == b"--" {
                after_ddash = true;
                continue;
            }
            if bytes.len() > 1 && bytes[0] == b'-' {
                return Err(format!("{}: unknown option", arg.to_string_lossy()));
            }
        }
        operands.push(arg.clone());
    }
    if operands.len() < 2 {
        return Err("missing operand".to_string());
    }
    Ok(operands)
}

fn resolve_targets(operands: &[OsString]) -> Result<Vec<(PathBuf, PathBuf)>, String> {
    let last = Path::new(&operands[operands.len() - 1]);

    if operands.len() == 2 {
        let src = PathBuf::from(&operands[0]);
        let dest = if last.is_dir() {
            let basename = src.file_name().ok_or_else(|| {
                format!("{}: cannot determine basename", operands[0].to_string_lossy())
            })?;
            last.join(basename)
        } else {
            PathBuf::from(&operands[1])
        };
        Ok(vec![(src, dest)])
    } else {
        if !last.is_dir() {
            return Err(format!(
                "{}: not a directory",
                operands[operands.len() - 1].to_string_lossy()
            ));
        }
        let mut targets = Vec::new();
        for s in &operands[..operands.len() - 1] {
            let src = PathBuf::from(s);
            let basename = src.file_name().ok_or_else(|| {
                format!("{}: cannot determine basename", s.to_string_lossy())
            })?;
            targets.push((src, last.join(basename)));
        }
        Ok(targets)
    }
}

fn get_umask(dir: &Path) -> u32 {
    let probe = dir.join(format!(".umask_probe_{}", std::process::id()));
    let result = (|| -> io::Result<u32> {
        fs::File::create(&probe)?;
        let mode = fs::metadata(&probe)?.permissions().mode();
        Ok(0o666 & !mode)
    })();
    let _ = fs::remove_file(&probe);
    result.unwrap_or(0o022)
}

fn copy_path(src: &Path, dest: &Path) -> io::Result<()> {
    let src_meta = fs::metadata(src).map_err(|e| {
        io::Error::new(e.kind(), format!("{}: {}", src.to_string_lossy(), e))
    })?;

    if !src_meta.is_file() {
        return Err(io::Error::new(
            io::ErrorKind::Other,
            format!("{}: not a regular file", src.to_string_lossy()),
        ));
    }

    let dest_meta = fs::metadata(dest);

    match &dest_meta {
        Ok(dm) => {
            if dm.is_dir() {
                return Err(io::Error::new(
                    io::ErrorKind::Other,
                    format!("{}: is a directory", dest.to_string_lossy()),
                ));
            }
            if !dm.is_file() {
                return Err(io::Error::new(
                    io::ErrorKind::Other,
                    format!("{}: not a regular file", dest.to_string_lossy()),
                ));
            }
            if dm.dev() == src_meta.dev() && dm.ino() == src_meta.ino() {
                return Err(io::Error::new(
                    io::ErrorKind::Other,
                    format!(
                        "'{}' and '{}' are the same file",
                        src.to_string_lossy(),
                        dest.to_string_lossy()
                    ),
                ));
            }
        }
        Err(_) => {
            if let Ok(sm) = fs::symlink_metadata(dest) {
                if sm.file_type().is_symlink() {
                    return Err(io::Error::new(
                        io::ErrorKind::NotFound,
                        format!("{}: dangling symbolic link", dest.to_string_lossy()),
                    ));
                }
            }
        }
    }

    let is_new = dest_meta.is_err();
    let umask = if is_new {
        let parent = dest.parent().unwrap_or(Path::new("."));
        Some(get_umask(parent))
    } else {
        None
    };

    let mut src_file = fs::File::open(src)?;
    let mut dest_file = fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .open(dest)?;

    io::copy(&mut src_file, &mut dest_file)?;

    if let Some(mask) = umask {
        let source_mode = src_meta.permissions().mode() & 0o777;
        let new_mode = source_mode & !mask;
        fs::set_permissions(dest, fs::Permissions::from_mode(new_mode))?;
    }

    Ok(())
}
```

