            let resolved = fs::canonicalize(dest).map_err(|e| {
                io::Error::new(io::ErrorKind::NotFound, 
                    format!("{}: dangling symlink", dest.display()))
            })?;
            if !resolved.is_file() {
                return Err(io::Error::new(
                    io::ErrorKind::NotADirectory,
                    format!("{}: not a regular file", dest.display())
                ));
            }
        } else if meta.is_dir() {
            return Err(io::Error::new(
                io::ErrorKind::IsADirectory,
                format!("{}: is a directory", dest.display())
            ));
        }
