        })?;

        file.flush().map_err(|e| {
            format!("{}: {}", dest.to_string_lossy(), e)
        })?;
    }

    Ok(())
}

fn resolve_targets(operands: &[OsString]) -> Result<Vec<(PathBuf, PathBuf)>, String> {
    let last = Path::new(&operands[operands.len() - 1]);

    if operands.len() == 2 {
