```rust
fn copy_path(src: &Path, dest: &Path) -> io::Result<()> {
    // Resolve source (follow symlinks)
    let src_meta = fs::metadata(src)?; // follows symlinks
    if !src_meta.is_file() {
        return Err(io::Error::new(io::ErrorKind::Other, "source is not a regular file"));
    }
    
    // Check if dest exists
    let dest_meta = fs::metadata(dest); // follows symlinks
    
    // Self-copy check
    if let Ok(dm) = &dest_meta {
        if dm.is_file() && dm.dev() == src_meta.dev() && dm.ino() == src_meta.ino() {
            return Err(io::Error::new(io::ErrorKind::Other, "source and destination are the same file"));
        }
    }
    
    // If dest exists, it must be a regular file (or symlink to one)
    if let Ok(dm) = &dest_meta {
        if dm.is_dir() {
            return Err(io::Error::new(io::ErrorKind::Other, "destination is a directory"));
        }
        if !dm.is_file() {
            return Err(io::Error::new(io::ErrorKind::Other, "destination is not a regular file"));
        }
    }
    
    // Determine if dest is new
    let is_new = dest_meta.is_err();
    
    // Open source for reading
    let mut src_file = fs::File::open(src)?;
    
    // Open dest for writing
    let mut dest_file = fs::OpenOptions::new()
        .write(true)
        .create(true)
        .truncate(true)
        .open(dest)?;
    
    // Copy
    io::copy(&mut src_file, &mut dest_file)?;
    
    // Set permissions for new files
    if is_new {
        let umask = get_umask(dest.parent().unwrap_or(Path::new(".")));
        let source_perms = src_meta.permissions().mode() & 0o777;
        let new_perms = source_perms & !umask;
        fs::set_permissions(dest, fs::Permissions::from_mode(new_perms))?;
    }
    
    Ok(())
}
```

