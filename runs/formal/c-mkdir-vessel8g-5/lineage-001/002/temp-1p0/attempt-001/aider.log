        /* Parse permissions */
        int p_r = 0, p_w = 0, p_x = 0;
        int p_s = 0, p_t = 0;
        int copy_u = 0, copy_g = 0, copy_o = 0;

        while (*p && *p != ',') {
            switch (*p) {
            case 'r': p_r = 1; break;
            case 'w': p_w = 1; break;
            case 'x': p_x = 1; break;
            case 'X': p_x = 1; break;
            case 's': p_s = 1; break;
            case 't': p_t = 1; break;
            case 'u': copy_u = 1; break;
            case 'g': copy_g = 1; break;
            case 'o': copy_o = 1; break;
            default: return (mode_t)-1;
            }
            p++;
        }

        /* Compute the permission bits for this clause */
        mode_t perm = 0;

        /* Ordinary permissions */
        if (p_r || p_w || p_x) {
            if (who_u || (!has_who)) {
                if (p_r) perm |= 0400;
                if (p_w) perm |= 0200;
                if (p_x) perm |= 0100;
            }
            if (who_g || (!has_who)) {
                if (p_r) perm |= 040;
                if (p_w) perm |= 020;
                if (p_x) perm |= 010;
            }
            if (who_o || (!has_who)) {
                if (p_r) perm |= 004;
                if (p_w) perm |= 002;
                if (p_x) perm |= 001;
            }
