        if (has_who) {
            mode_t wm = 0;
            if (who_u) wm |= 07000;
            if (who_g) wm |= 02070;
            if (who_o) wm |= 01007;

            if (op == '+') {
                mode |= (perm & wm);
            } else if (op == '-') {
                mode &= ~(perm & wm);
            } else { /* '=' */
                /* Ordinary bits: replace in selected classes */
                mode_t ordinary_mask = wm & 0777;
                mode = (mode & ~ordinary_mask) | (perm & ordinary_mask);

                /* Special bits */
                if (p_s || p_t) {
