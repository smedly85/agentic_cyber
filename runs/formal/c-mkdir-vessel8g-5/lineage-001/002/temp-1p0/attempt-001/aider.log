            continue;
        } else {
            is_operand = 1;
        }

        if (!is_operand)
            continue;

        if (has_p) {
            if (ensure_parents(argv[i], &final_mode, has_m) != 0) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        argv[i], strerror(errno));
                exit_status = 1;
            } else {
