#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

static int ensure_parents(const char *path, mode_t *final_mode, int has_mode)
{
    if (path[0] == '\0') {
        errno = ENOENT;
        return 1;
    }
    size_t len = strlen(path);
    char *tmp = malloc(len + 1);
    if (!tmp) {
        errno = ENOMEM;
        return 1;
    }
    memcpy(tmp, path, len + 1);
    int is_abs = (path[0] == '/');
    int rc = 0;

    for (size_t i = 0; i <= len && !rc; i++) {
        if (i < len && path[i] != '/')
            continue;
        if (is_abs && i == 0)
            continue;

        memcpy(tmp, path, i);
        tmp[i] = '\0';
        const char *prefix = tmp;

        if (prefix[0] == '\0')
            continue;
        if (prefix[0] == '/' && prefix[1] == '\0')
            continue;

        struct stat st;
        if (lstat(prefix, &st) == 0) {
            if (S_ISDIR(st.st_mode))
                continue;
            if (S_ISLNK(st.st_mode)) {
                if (stat(prefix, &st) == 0 && S_ISDIR(st.st_mode))
                    continue;
            }
            errno = ENOTDIR;
            rc = 1;
            break;
        } else if (errno != ENOENT) {
            rc = 1;
            break;
        }

        if (mkdir(prefix, 0777) != 0) {
            int e = errno;
            if (e == EEXIST) {
                if (lstat(prefix, &st) == 0) {
                    if (S_ISDIR(st.st_mode))
                        continue;
                    if (S_ISLNK(st.st_mode) &&
                        stat(prefix, &st) == 0 && S_ISDIR(st.st_mode))
                        continue;
                }
                errno = ENOTDIR;
            }
            rc = 1;
            break;
        }

        if (lstat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
            mode_t m = st.st_mode & 07777;
            if (!(m & (S_IWUSR | S_IXUSR))) {
                if (chmod(prefix, m | S_IWUSR | S_IXUSR) != 0) {
                    rc = 1;
                    break;
                }
            }
        }
    }

    free(tmp);
    return rc;
}

