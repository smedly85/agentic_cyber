   static int is_sticky_only(const char *str)
   {
       /* Returns 1 if the string contains only 't' as a special bit,
          and no ordinary bits (r, w, x, X). This triggers the GNU
          special-bit-only behavior where the base is 0755 instead of 0777.
          Per spec: "Do not generalize this sticky-only behavior into a
          masked starting mode for other symbolic expressions." */
       int has_ordinary = 0, has_t = 0, has_other_special = 0;
       for (const char *p = str; *p; p++) {
           switch (*p) {
           case 'r': case 'w': case 'x': case 'X':
               has_ordinary = 1;
               break;
           case 't':
               has_t = 1;
               break;
           case 's':
               has_other_special = 1;
               break;
           default:
               break;
           }
       }
       return has_t && !has_ordinary && !has_other_special;
   }
   ```

