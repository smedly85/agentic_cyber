```c
mode_t compute_perm(mode_t current_mode, int who_u, int who_g, int who_o, 
                    int p_r, int p_w, int p_x, int p_s, int p_t,
                    int copy_u, int copy_g, int copy_o) {
    mode_t result = 0;
    
    // Ordinary permissions
    if (p_r || p_w || p_x) {
        if (who_u) {
            if (p_r) result |= 0400;
            if (p_w) result |= 0200;
            if (p_x) result |= 0100;
        }
        if (who_g) {
            if (p_r) result |= 040;
            if (p_w) result |= 020;
            if (p_x) result |= 010;
        }
        if (who_o) {
            if (p_r) result |= 04;
            if (p_w) result |= 02;
            if (p_x) result |= 01;
        }
    }
    
    // Special bits
    if (p_s) {
        if (who_u) result |= 04000;
        if (who_g) result |= 02000;
        if (who_o) result |= 01000;
    }
    if (p_t) {
        result |= 01000;  // sticky, regardless of who
    }
    
    // Permission copy
    if (copy_u) {
        // Copy owner's rwx to selected classes
        mode_t src = current_mode & 0700;
        if (who_u) result |= src;
        if (who_g) result |= (src >> 3);
        if (who_o) result |= (src >> 6);
    }
    if (copy_g) {
        mode_t src = current_mode & 0070;
        if (who_u) result |= (src << 3);
        if (who_g) result |= src;
        if (who_o) result |= (src << 6);
    }
    if (copy_o) {
        mode_t src = current_mode & 0007;
        if (who_u) result |= (src << 6);
        if (who_g) result |= (src << 3);
        if (who_o) result |= src;
    }
    
    return result;
}
```

