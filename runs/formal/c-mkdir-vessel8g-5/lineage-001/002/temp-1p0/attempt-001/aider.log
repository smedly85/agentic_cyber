            }
            if (strcmp(a, "--mode") == 0) {
                if (i + 1 < argc) {
                    mode_str = argv[++i];
                } else {
                    fprintf(stderr, "mkdir: option '--mode' requires an argument\n");
                    fprintf(stderr, "Try 'mkdir --help' for more information.\n");
                    free(operands);
                    return 1;
                }
                continue;
            }
            if (strncmp(a, "--mode=", 7) == 0) {
