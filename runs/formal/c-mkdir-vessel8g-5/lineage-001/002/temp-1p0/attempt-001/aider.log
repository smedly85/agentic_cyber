Now let me write the full C code. I'll restructure the existing code:

```c
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

#define PROGNAM "mkdir"

/* --- Mode parsing --- */

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static mode_t parse_numeric(const char *s) {
    if (!*s) return (mode_t)-1;
    mode_t val = 0;
    while (*s) {
        if (!is_octal_digit(*s)) return (mode_t)-1;
        val = (val << 3) | (*s - '0');
        if (val > 07777) return (mode_t)-1;
        s++;
    }
    return val;
}

/* Parse a symbolic mode string. umask is the process umask. */
static mode_t parse_symbolic(const char *str, mode_t umask) {
    if (!*str) return (mode_t)-1;
    
    mode_t mode = 0777 & ~umask;
    const char *p = str;
    int first = 1;
    
    while (1) {
        /* Parse who */
        int who_u = 0, who_g = 0, who_o = 0;
        int has_who = 0;
        
        if (*p == 'a') {
            who_u = who_g = who_o = 1;
            has_who = 1;
            p++;
        } else {
            while (*p == 'u' || *p == 'g' || *p == 'o') {
                if (*p == 'u') who_u = 1;
                else if (*p == 'g') who_g = 1;
                else who_o = 1;
                has_who = 1;
                p++;
            }
        }
        
        /* Parse operator */
        if (*p != '+' && *p != '-' && *p != '=')
            return (mode_t)-1;
        char op = *p++;
        
        /* Parse permissions */
        int p_r = 0, p_w = 0, p_x = 0;
        int p_s = 0, p_t = 0;
        int copy_u = 0, copy_g = 0, copy_o = 0;
        int has_perm = 0;
        
        while (*p && *p != ',') {
            switch (*p) {
            case 'r': p_r = 1; has_perm = 1; break;
            case 'w': p_w = 1; has_perm = 1; break;
            case 'x': p_x = 1; has_perm = 1; break;
            case 'X': p_x = 1; has_perm = 1; break;  /* X = x for directories */
            case 's': p_s = 1; has_perm = 1; break;
            case 't': p_t = 1; has_perm = 1; break;
            case 'u': copy_u = 1; has_perm = 1; break;
            case 'g': copy_g = 1; has_perm = 1; break;
            case 'o': copy_o = 1; has_perm = 1; break;
            default: return (mode_t)-1;
            }
            p++;
        }
        
        /* Compute the permission bits for this clause */
        mode_t perm = 0;
        
        /* Ordinary permissions */
        if (p_r || p_w || p_x) {
            if (who_u || (!has_who)) {
                if (p_r) perm |= 0400;
                if (p_w) perm |= 0200;
                if (p_x) perm |= 0100;
            }
            if (who_g || (!has_who)) {
                if (p_r) perm |= 040;
                if (p_w) perm |= 020;
                if (p_x) perm |= 010;
            }
            if (who_o || (!has_who)) {
                if (p_r) perm |= 004;
                if (p_w) perm |= 002;
                if (p_x) perm |= 001;
            }
        }
        
        /* Special bits from s */
        if (p_s) {
            if (who_u || (!has_who)) perm |= 04000;
            if (who_g || (!has_who)) perm |= 02000;
            if (who_o || (!has_who)) perm |= 01000;
        }
        
        /* Special bits from t (always sticky, regardless of who) */
        if (p_t) perm |= 01000;
        
        /* Permission copy */
        if (copy_u) {
            mode_t src = mode & 0700;
            if (who_u || !has_who) perm |= src;
            if (who_g || !has_who) perm |= (src >> 3);
            if (who_o || !has_who) perm |= (src >> 6);
        }
        if (copy_g) {
            mode_t src = mode & 0070;
            if (who_u || !has_who) perm |= (src << 3);
            if (who_g || !has_who) perm |= src;
            if (who_o || !has_who) perm |= (src << 6);
        }
        if (copy_o) {
            mode_t src = mode & 0007;
            if (who_u || !has_who) perm |= (src << 6);
            if (who_g || !has_who) perm |= (src << 3);
            if (who_o || !has_who) perm |= src;
        }
        
        /* Apply the operation */
        if (has_who) {
            mode_t wm = 0;
            if (who_u) wm |= 07000;
            if (who_g) wm |= 02070;
            if (who_o) wm |= 01007;
            
            if (op == '+') {
                mode |= (perm & wm);
            } else if (op == '-') {
                mode &= ~(perm & wm);
            } else { /* '=' */
                /* Ordinary bits: replace in selected classes */
                mode_t ordinary_mask = wm & 0777;
                mode = (mode & ~ordinary_mask) | (perm & ordinary_mask);
                
                /* Special bits */
                int special = 04000 | 02000 | 01000;
                mode_t sel_special = wm & special;
                if (p_s || p_t) {
                    /* Explicitly addressed: set what's in perm, clear rest of selected */
                    mode = (mode & ~sel_special) | (perm & sel_special);
                } else {
                    /* Not addressed: preserve setuid/setgid, clear sticky */
                    mode_t preserve = sel_special & (04000 | 02000);  /* setuid+setgid */
                    mode_t clear = sel_special & 01000;  /* sticky */
                    mode &= ~clear;
                    /* setuid/setgid are already preserved (we only cleared ordinary) */
                    /* But we need to make sure we didn't accidentally clear them */
                    /* Actually, ordinary_mask doesn't include special bits, so they're fine */
                    (void)preserve;
                }
            }
        } else {
            /* Omitted who */
            if (op == '+') {
                /* Ordinary: add perm_ordinary & ~umask */
                /* Special: add perm_special (no umask) */
                mode_t ordinary = perm & 0777;
                mode_t special = perm & 07000;
                mode |= (ordinary & ~umask) | special;
            } else if (op == '-') {
                mode_t ordinary = perm & 0777;
                mode_t special = perm & 07000;
                mode &= ~((ordinary & ~umask) | special);
            } else { /* '=' */
                /* Ordinary: replace ALL ordinary with perm_ordinary & ~umask */
                mode_t new_ordinary = (perm & 0777) & ~umask;
                mode = (mode & 07000) | new_ordinary;
                
                /* Special bits */
                if (p_s || p_t) {
                    mode_t special = perm & 07000;
                    mode = (mode & 0777) | special;
                } else {
                    /* Preserve setuid/setgid, clear sticky */
                    mode = (mode & (0777 | 04000 | 02000));  /* clear sticky, keep rest */
                }
            }
        }
        
        /* Skip comma or end */
        if (*p == ',') {
            p++;
            first = 0;
            continue;
        }
        break;
    }
    
    return mode;
}

/* Parse a mode string (numeric or symbolic). Returns mode or (mode_t)-1 on error. */
static mode_t parse_mode_str(const char *str, mode_t umask) {
    if (!str || !*str) return (mode_t)-1;
    
    /* Try numeric */
    int all_octal = 1;
    for (const char *c = str; *c; c++) {
        if (*c < '0' || *c > '7') { all_octal = 0; break; }
    }
    if (all_octal) {
        mode_t v = parse_numeric(str);
        if (v != (mode_t)-1) return v;
        /* numeric but > 07777, fall through to error */
        return (mode_t)-1;
    }
    
    /* Symbolic */
    return parse_symbolic(str, umask);
}
