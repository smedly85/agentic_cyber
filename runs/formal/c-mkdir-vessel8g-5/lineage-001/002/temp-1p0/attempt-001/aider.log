#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <stdlib.h>

#define PROGNAM "mkdir"

static int mkdir_parents(const char *path, mode_t mode)
{
    size_t len = strlen(path);
    char *copy = malloc(len + 1);
    if (!copy)
        return -1;
    memcpy(copy, path, len + 1);

    int rc = 0;

    /* Create each intermediate prefix (delimited by '/'). */
    for (size_t i = 1; i < len; i++) {
        if (copy[i] != '/')
            continue;
        copy[i] = '\0';
        /* Skip empty string and root — they always exist as directories. */
        if (copy[0] == '\0' || strcmp(copy, "/") == 0) {
            copy[i] = '/';
            continue;
        }
        if (mkdir(copy, 0777) != 0) {
            if (errno == EEXIST) {
                struct stat st;
                if (stat(copy, &st) != 0 || !S_ISDIR(st.st_mode)) {
                    errno = ENOTDIR;
                    rc = -1;
                    break;
                }
            } else {
                rc = -1;
                break;
            }
        }
        copy[i] = '/';
    }

    /* Create (or verify) the final component. */
    if (rc == 0) {
        if (mkdir(copy, mode) != 0) {
            if (errno == EEXIST) {
                struct stat st;
                if (stat(copy, &st) != 0 || !S_ISDIR(st.st_mode))
                    rc = -1;
                /* errno stays EEXIST — matches GNU for final-component conflict */
            } else {
                rc = -1;
            }
        }
    }

    free(copy);
    return rc;
}

/* Parse a mode string (numeric or symbolic). Returns mode or (mode_t)-1 on error. */
static mode_t parse_mode_str(const char *str, mode_t umask)
{
    if (!str || !*str)
        return (mode_t)-1;

    /* Try numeric */
    int all_octal = 1;
    for (const char *c = str; *c; c++) {
        if (*c < '0' || *c > '7') {
            all_octal = 0;
            break;
        }
    }
    if (all_octal) {
        mode_t val = 0;
        for (const char *c = str; *c; c++) {
            val = (val << 3) | (*c - '0');
            if (val > 07777)
                return (mode_t)-1;
        }
        return val;
    }

    /* Symbolic mode parsing */
    mode_t mode = 0777 & ~umask;
    const char *p = str;

    while (*p) {
        /* Parse who */
        int who_u = 0, who_g = 0, who_o = 0;
        int has_who = 0;

        if (*p == 'a') {
            who_u = who_g = who_o = 1;
            has_who = 1;
            p++;
        } else {
            while (*p == 'u' || *p == 'g' || *p == 'o') {
                if (*p == 'u') who_u = 1;
                else if (*p == 'g') who_g = 1;
                else who_o = 1;
                has_who = 1;
                p++;
