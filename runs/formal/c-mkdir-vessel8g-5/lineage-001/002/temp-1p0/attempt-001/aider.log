   Actually, wait. Let me reconsider the operand collection. The issue is that in the current code, Phase 1 parses options and the `-m`/`--mode` option consumes the next argument. But the operand-counting loop and Phase 2 loop start fresh from i=1 and don't know which arguments were consumed.

   The cleanest solution: do a single pass that both parses options AND collects operands.

   Let me restructure main():

   ```c
   int main(int argc, char *argv[]) {
       int has_p = 0;
       char *mode_str = NULL;
       int after_ddash = 0;
       
       // Single pass: parse options and collect operands
       char **operands = malloc(argc * sizeof(char *));
       if (!operands) return 1;
       int operand_count = 0;
       
       for (int i = 1; i < argc; i++) {
           if (after_ddash) {
               operands[operand_count++] = argv[i];
               continue;
           }
           const char *a = argv[i];
           if (strcmp(a, "--") == 0) {
               after_ddash = 1;
               continue;
           }
           if (a[0] == '-' && a[1] != '\0') {
               // It's an option
               if (strcmp(a, "-p") == 0 || strcmp(a, "--parents") == 0) {
                   has_p = 1;
               } else if (strcmp(a, "-m") == 0) {
                   if (i + 1 >= argc) {
                       fprintf(stderr, "mkdir: option '-m' requires an argument\n");
                       fprintf(stderr, "Try 'mkdir --help' for more information.\n");
                       free(operands);
                       return 1;
                   }
                   mode_str = argv[++i];
               } else if (a[1] == 'm' && a[2] != '\0') {
                   mode_str = &a[2];
               } else if (strcmp(a, "--mode") == 0) {
                   if (i + 1 >= argc) {
                       fprintf(stderr, "mkdir: option '--mode' requires an argument\n");
                       fprintf(stderr, "Try 'mkdir --help' for more information.\n");
                       free(operands);
                       return 1;
                   }
                   mode_str = argv[++i];
               } else if (strncmp(a, "--mode=", 7) == 0) {
                   mode_str = &a[7];
               } else {
                   // Unknown option
                   if (a[1] == '-') {
                       fprintf(stderr, "mkdir: unrecognized option '%s'\n", a);
                   } else {
                       fprintf(stderr, "mkdir: invalid option -- '%c'\n", a[1]);
                   }
                   fprintf(stderr, "Try 'mkdir --help' for more information.\n");
                   free(operands);
                   return 1;
               }
           } else {
               // It's an operand
               operands[operand_count++] = a;
           }
       }
       
       if (operand_count == 0) {
           fprintf(stderr, "mkdir: missing operand\n");
           fprintf(stderr, "Try 'mkdir --help' for more information.\n");
           free(operands);
           return 1;
       }
       
       // Parse mode if specified
       int has_m = (mode_str != NULL);
       mode_t final_mode = 0;
       if (has_m) {
           mode_t um = umask(0);
           (void)umask(um);
           if (parse_mode(mode_str, um, &final_mode) != 0) {
               fprintf(stderr, "mkdir: invalid mode '%s'\n", mode_str);
               free(operands);
               return 1;
           }
       }
       
       // Create directories
       int exit_status = 0;
       for (int i = 0; i < operand_count; i++) {
           const char *path = operands[i];
           if (has_p) {
               if (mkdir_p(path, final_mode, has_m) != 0) {
                   fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
                   exit_status = 1;
               }
           } else {
               if (mkdir(path, 0777) != 0) {
                   int e = errno;
                   if (e == EEXIST) {
                       struct stat st;
                       if (lstat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
                           fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", path);
                       } else if (lstat(path, &st) == 0 && S_ISLNK(st.st_mode) &&
                                  stat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
                           fprintf(stderr, "mkdir: cannot create directory '%s': File exists\n", path);
                       } else {
                           fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(e));
                       }
                   } else {
                       fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(e));
                   }
                   exit_status = 1;
               } else {
                   if (has_m) {
                       if (chmod(path, final_mode) != 0) {
                           fprintf(stderr, "mkdir: cannot change permissions of '%s': %s\n", path, strerror(errno));
                           exit_status = 1;
                       }
                   }
               }
           }
       }
       
       free(operands);
       return exit_status;
   }
   ```

   This is much cleaner. The key change is that we do a single pass and collect operands, skipping option values.

   Now for the `mkdir_p` fix (tmp restoration):

   ```c
   static int mkdir_p(const char *path, mode_t final_mode, int has_mode)
   {
       size_t len = strlen(path);
       char *tmp = malloc(len + 1);
       if (!tmp) { errno = ENOMEM; return 1; }
       memcpy(tmp, path, len + 1);
       
       int rc = 0;
       int is_abs = (path[0] == '/');
       size_t prev_i = 0;
       
       for (size_t i = 0; i <= len && !rc; i++) {
           if (i < len && path[i] != '/') continue;
           if (is_abs && i == 0) continue;
           
           if (prev_i) tmp[prev_i] = path[prev_i];  // restore previous zero
           tmp[i] = '\0';
           prev_i = i;
           
           const char *prefix = tmp;
           if (prefix[0] == '\0') continue;
           if (prefix[0] == '/' && prefix[1] == '\0') continue;
           
           int is_final = (i == len);
           struct stat st;
           
           if (lstat(prefix, &st) == 0) {
               if (S_ISDIR(st.st_mode)) continue;
               if (S_ISLNK(st.st_mode) && stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
               errno = ENOTDIR;
               rc = 1;
               break;
           } else if (errno != ENOENT) {
               rc = 1;
               break;
           }
           
           if (mkdir(prefix, 0777) != 0) {
               int e = errno;
               if (e == EEXIST) {
                   if (lstat(prefix, &st) == 0) {
                       if (S_ISDIR(st.st_mode)) continue;
                       if (S_ISLNK(st.st_mode) && stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
                   }
                   errno = ENOTDIR;
               }
               rc = 1;
               break;
           }
           
           if (is_final) {
               if (has_mode) {
                   if (chmod(prefix, final_mode) != 0) { rc = 1; break; }
               }
           } else {
               if (lstat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
                   mode_t m = st.st_mode & 07777;
                   if (!(m & (S_IWUSR | S_IXUSR))) {
                       if (chmod(prefix, m | S_IWUSR | S_IXUSR) != 0) { rc = 1; break; }
                   }
               }
           }
       }
       
       free(tmp);
       return rc;
   }
   ```

