            if (op == '+') {
                /* Ordinary: add perm_ordinary & ~umask */
                /* Special: add perm_special (no umask) */
                mode_t ordinary = perm & 0777;
                mode_t special = perm & 07000;
                mode |= (ordinary & ~umask) | special;
            } else if (op == '-') {
                mode_t ordinary = perm & 0777;
                mode_t special = perm & 07000;
                mode &= ~((ordinary & ~umask) | special);
            } else { /* '=' */
                /* Ordinary: replace ALL ordinary with perm_ordinary & ~umask */
                mode_t new_ordinary = (perm & 0777) & ~umask;
                mode = (mode & 07000) | new_ordinary;

