static int create_path_p(const char *path, mode_t final_mode, int has_mode)
{
    // path is the full path to create (with -p semantics)
    // final_mode is the mode for the final directory (if has_mode)
    // Intermediate dirs get 0777 & ~umask
    
    // Walk through the path components and create each one
    // Return 0 on success, 1 on failure
    
    char *tmp = strdup(path);
    if (!tmp) { errno = ENOMEM; return 1; }
    
    int rc = 0;
    int last_created = 0; // whether the last component was newly created
    
    // For each component boundary (each '/'), try to ensure that prefix is a dir
    for (char *p = tmp + (tmp[0] == '/'); *p; p++) {
        if (*p != '/' && p != tmp) continue;
        
        char saved = *p;
        *p = '\0';
        const char *prefix = tmp;
        
        // Skip empty and root
        if (prefix[0] == '\0' || (prefix[0] == '/' && prefix[1] == '\0')) {
            *p = saved;
            continue;
        }
        
        struct stat st;
        if (lstat(prefix, &st) == 0) {
            // Exists
            if (S_ISDIR(st.st_mode)) {
                // It's a directory - OK for intermediate, OK for final
                *p = saved;
                continue;
            }
            if (S_ISLNK(st.st_mode)) {
                if (stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
                    *p = saved;
                    continue;
                }
            }
            errno = ENOTDIR;
            rc = 1;
            break;
        } else if (errno != ENOENT) {
            rc = 1;
            break;
        }
        
        // Doesn't exist - create it
        int is_final = (saved == '\0'); // if this is the last component
        
        mode_t mode_to_use;
        if (is_final && has_mode) {
            mode_to_use = final_mode;
        } else {
            mode_to_use = 0777; // will be masked by umask in mkdir
        }
        
        if (mkdir(prefix, mode_to_use) != 0) {
            int e = errno;
