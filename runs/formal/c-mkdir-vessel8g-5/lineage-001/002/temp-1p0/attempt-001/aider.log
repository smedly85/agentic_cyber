                }
                exit_status = 1;
            } else {
                if (has_m) {
                    if (chmod(path, final_mode) != 0) {
                        fprintf(stderr, "mkdir: cannot change permissions of '%s': %s\n",
                                path, strerror(errno));
                        exit_status = 1;
                    }
