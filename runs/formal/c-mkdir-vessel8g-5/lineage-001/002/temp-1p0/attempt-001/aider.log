   Let me rewrite `eval_symbolic`:

   ```c
   static int eval_symbolic(const char *expr, mode_t umask, mode_t *result)
   {
       // Pre-scan: determine if this is "special-bit-only" (no rwx, no '=')
       int has_rwx = 0;
       int has_equal = 0;
       for (const char *p = expr; *p; p++) {
           if (*p == 'r' || *p == 'w' || *p == 'x' || *p == 'X') has_rwx = 1;
           if (*p == '=') has_equal = 1;
       }
       int special_only = !has_rwx && !has_equal;
       
       mode_t mode = special_only ? 0755 : 0777;
       
       const char *p = expr;
       while (*p) {
           const char *end = strchr(p, ',');
           size_t len = end ? (size_t)(end - p) : strlen(p);
           
           if (len == 0) return -1;
           
           size_t pos = 0;
           int has_who = 0;
           int who = 0;
           
           // Parse who (can be multiple chars)
           while (pos < len) {
               char c = p[pos];
               if (c == 'u') { who |= 1; has_who = 1; pos++; }
               else if (c == 'g') { who |= 2; has_who = 1; pos++; }
               else if (c == 'o') { who |= 4; has_who = 1; pos++; }
               else if (c == 'a') { who = 7; has_who = 1; pos++; }
               else break;
           }
           
           if (pos >= len) return -1;
           char op = p[pos++];
           if (op != '+' && op != '-' && op != '=') return -1;
           
           const char *perms = p + pos;
           size_t plen = len - pos;
           
           int has_r = 0, has_w = 0, has_x = 0, has_s = 0, has_t = 0;
           int copy_src = 0;
           
           for (size_t i = 0; i < plen; i++) {
               char pc = perms[i];
               if (pc == 'r') has_r = 1;
               else if (pc == 'w') has_w = 1;
               else if (pc == 'x' || pc == 'X') has_x = 1;
               else if (pc == 's') has_s = 1;
               else if (pc == 't') has_t = 1;
               else if (pc == 'u') { if (copy_src) return -1; copy_src = 1; }
               else if (pc == 'g') { if (copy_src) return -1; copy_src = 2; }
               else if (pc == 'o') { if (copy_src) return -1; copy_src = 3; }
               else return -1;
           }
           
           // Compute permission bits
           mode_t pbits = 0;
           if (copy_src) {
               int shift = (copy_src == 1) ? 6 : (copy_src == 2) ? 3 : 0;
               int val = (int)((mode >> shift) & 7);
               if (has_who) {
                   if (who & 1) pbits |= (mode_t)val << 6;
                   if (who & 2) pbits |= (mode_t)val << 3;
                   if (who & 4) pbits |= (mode_t)val;
               } else {
                   pbits = (mode_t)val << 6 | (mode_t)val << 3 | (mode_t)val;
               }
           } else {
               if (has_r) pbits |= 0444;
               if (has_w) pbits |= 0222;
               if (has_x) pbits |= 0111;
               if (has_who) {
                   mode_t wm = 0;
                   if (who & 1) wm |= 0700;
                   if (who & 2) wm |= 0070;
                   if (who & 4) wm |= 0007;
                   pbits &= wm;
               }
           }
           
           // Apply operation
           if (op == '+') {
               if (has_who) {
                   mode |= pbits;
                   if (has_s) {
                       if (who & 1) mode |= 04000;
                       if (who & 2) mode |= 02000;
                   }
                   if (has_t && (who & 4)) mode |= 01000;
               } else {
                   mode |= pbits & ~umask & 0777;
                   if (has_s) mode |= 06000;
                   if (has_t) mode |= 01000;
               }
           } else if (op == '-') {
               if (has_who) {
                   mode &= ~pbits;
                   if (has_s) {
                       if (who & 1) mode &= ~04000;
                       if (who & 2) mode &= ~02000;
                   }
                   if (has_t && (who & 4)) mode &= ~01000;
               } else {
                   mode &= ~(pbits & ~umask & 0777);
                   if (has_s) mode &= ~06000;
                   if (has_t) mode &= ~01000;
               }
           } else { // '='
               if (has_who) {
                   mode_t wm = 0;
                   if (who & 1) wm |= 0700;
                   if (who & 2) wm |= 0070;
                   if (who & 4) wm |= 0007;
                   
                   mode_t new_ord = (mode & ~wm) | (plen ? (pbits & 0777) : 0);
                   mode_t special = mode & 07000;
                   
                   if (has_s && (who & 1)) special |= 04000;
                   if (has_s && (who & 2)) special |= 02000;
                   
                   if (who & 4) {
                       if (has_t) special |= 01000;
                       else special &= ~01000;
                   }
                   
                   // For u and g: preserve setuid/setgid unless explicitly addressed
                   // Actually, the spec says: "Ordinary assignments preserve directory set-user-ID and set-group-ID bits unless explicitly addressed"
                   // So if who doesn't include u, preserve 04000. If who doesn't include g, preserve 02000.
                   if (!(who & 1)) special |= mode & 04000;  // preserve setuid if u not selected
                   if (!(who & 2)) special |= mode & 02000;  // preserve setgid if g not selected
                   
                   mode = (new_ord & 0777) | (special & 07000);
               } else {
                   mode_t filtered = plen ? (pbits & ~umask & 0777) : 0;
                   mode = (mode & 07000) | filtered;
               }
           }
           
           if (end) p = end + 1;
           else break;
       }
       
       *result = mode & 07777;
       return 0;
   }
   ```

