static int ensure_path_parents(const char *path) {
    // We need to create all intermediate directories
    // Build up the path component by component
    
    size_t len = strlen(path);
    if (len == 0) return 0;
    
    char *tmp = malloc(len + 1);
    if (!tmp) return -1;
    memcpy(tmp, path, len + 1);
    
    int result = 0;
    
    // If absolute path, first component starts at index 1 (after /)
    // If relative, first component starts at index 0
    size_t start = (path[0] == '/') ? 1 : 0;
    
    for (size_t i = start; i <= len; i++) {
        if (i < len && path[i] != '/') continue;
        if (i == start) continue; // skip empty first component for absolute paths
        
        // Check for dot or dot-dot components
        // Actually, the simplest approach: just use the path prefix and lstat/mkdir
        
        tmp[i] = '\0';
        const char *prefix = tmp;
        
        // Skip if prefix is just "/" or "" or "." or "./"
        // Actually let's just check if it's a meaningful path
        
        struct stat st;
        if (lstat(prefix, &st) == 0) {
            // It exists
            if (S_ISDIR(st.st_mode)) {
                continue; // directory, fine
            }
            if (S_ISLNK(st.st_mode)) {
                // Check if it resolves to a directory
                if (stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
                    continue; // symlink to directory, fine
                }
                // symlink to non-directory
                result = -1;
                break;
            }
            // Non-directory, non-symlink
            result = -1;
            break;
        }
        
        // It doesn't exist (or lstat failed for other reasons)
        if (mkdir(prefix, 0777) != 0) {
            int e = errno;
            if (e == EEXIST) {
                // Race: it appeared, re-check
                if (lstat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
                if (lstat(prefix, &st) == 0 && S_ISLNK(st.st_mode)) {
                    if (stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
                }
                result = -1;
                break;
            }
            result = -1;
            break;
        }
        
        // Ensure owner has write and search (execute)
        // Check current mode
        if (lstat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
            mode_t mode = st.st_mode & 07777;
            if (!(mode & (S_IWUSR | S_IXUSR))) {
                mode_t newmode = mode | S_IWUSR | S_IXUSR;
                if (chmod(prefix, newmode) != 0) {
                    result = -1;
                    break;
                }
            }
        }
    }
    
    free(tmp);
    return result;
}
```

