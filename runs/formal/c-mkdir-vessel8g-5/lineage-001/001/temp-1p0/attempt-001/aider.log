```c
static int ensure_parents(const char *path) {
    size_t len = strlen(path);
    char *tmp = malloc(len + 1);
    if (!tmp) return 1;
    memcpy(tmp, path, len + 1);
    
    int rc = 0;
    int is_abs = (path[0] == '/');
    
    // Iterate: at each slash position (or end), truncate and ensure
    for (size_t i = 0; i <= len; i++) {
        if (i < len && path[i] != '/') continue;
        // i == len (end of string) or path[i] == '/'
        
        if (is_abs && i == 0) continue; // skip leading '/'
        
        tmp[i] = '\0';
        const char *prefix = tmp;
        
        // Skip empty string or just "/"
        if (prefix[0] == '\0') continue;
        if (prefix[0] == '/' && prefix[1] == '\0') continue;
        
        // Check if prefix is "." or "./"  (i.e., just dot)
        // Actually, "." will lstat fine and be a directory, so no special handling needed
        
        struct stat st;
        if (lstat(prefix, &st) == 0) {
            if (S_ISDIR(st.st_mode)) continue;
            if (S_ISLNK(st.st_mode)) {
                if (stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
            }
            rc = 1; // not a directory
            break;
        } else if (errno != ENOENT) {
            // Some other error (EACCES, etc.)
            rc = 1;
            break;
        }
        
        // Doesn't exist, create it
        if (mkdir(prefix, 0777) != 0) {
            int e = errno;
            if (e == EEXIST) {
                // Re-check
                if (lstat(prefix, &st) == 0) {
                    if (S_ISDIR(st.st_mode)) continue;
                    if (S_ISLNK(st.st_mode) && stat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) continue;
                }
            }
            rc = 1;
            break;
        }
        
        // Ensure owner w and x
        if (lstat(prefix, &st) == 0 && S_ISDIR(st.st_mode)) {
            mode_t m = st.st_mode & 07777;
            if (!(m & (S_IWUSR | S_IXUSR))) {
                if (chmod(prefix, m | S_IWUSR | S_IXUSR) != 0) {
                    rc = 1;
                    break;
                }
            }
        }
    }
    
    free(tmp);
    return rc;
}
