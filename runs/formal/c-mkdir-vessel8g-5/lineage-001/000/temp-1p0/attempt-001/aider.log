#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>

#define PROGNAM "mkdir"

static void fail_usage(const char *msg) {
    fprintf(stderr, "%s: %s\n", PROGNAM, msg);
    fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
    exit(1);
}

int main(int argc, char *argv[]) {
    // Phase 1: Parse arguments
    int num_operands = 0;
    const char **operands = NULL;
    int operands_cap = 0;
    int in_positional = 0;
    
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        
        if (in_positional) {
            // All remaining are operands
            if (num_operands == operands_cap) {
                operands_cap = operands_cap ? operands_cap * 2 : 4;
                operands = realloc(operands, operands_cap * sizeof(char*));
                if (!operands) {
                    fprintf(stderr, "%s: %s\n", PROGNAM, strerror(ENOMEM));
                    return 1;
                }
            }
            operands[num_operands++] = arg;
        } else if (strcmp(arg, "--") == 0) {
            in_positional = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            // Unknown option
            if (arg[1] == '-') {
                // Long option: --foo
                fprintf(stderr, "%s: unrecognized option '%s'\n", PROGNAM, arg);
                fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
            } else {
                // Short option: -p or -abc
                fprintf(stderr, "%s: invalid option -- '%c'\n", PROGNAM, arg[1]);
                fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
            }
            free(operands);
            return 1;
        } else {
            // Operand (includes bare "-")
            if (num_operands == operands_cap) {
                operands_cap = operands_cap ? operands_cap * 2 : 4;
                operands = realloc(operands, operands_cap * sizeof(char*));
                if (!operands) {
                    fprintf(stderr, "%s: %s\n", PROGNAM, strerror(ENOMEM));
                    return 1;
                }
            }
            operands[num_operands++] = arg;
        }
    }
    
    if (num_operands == 0) {
        fprintf(stderr, "%s: missing operand\n", PROGNAM);
        fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
        free(operands);
        return 1;
    }
    
    // Phase 2: Create directories
    int any_failed = 0;
    for (int i = 0; i < num_operands; i++) {
        if (mkdir(operands[i], 0777) != 0) {
            any_failed = 1;
            fprintf(stderr, "%s: cannot create directory '%s': %s\n",
                    PROGNAM, operands[i], strerror(errno));
        }
    }
    
    free(operands);
    return any_failed ? 1 : 0;
}
```

