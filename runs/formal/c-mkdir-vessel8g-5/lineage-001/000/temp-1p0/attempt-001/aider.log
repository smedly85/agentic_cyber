        } else if (arg[0] == '-' && arg[1] != '\0') {
            /* unreachable: phase 1 already rejected unknown options */
            continue;
        } else {
            if (mkdir(arg, 0777) != 0) {
                any_failed = 1;
                fprintf(stderr, "%s: cannot create directory '%s': %s\n",
                        PROGNAM, arg, strerror(errno));
            }
        }
    }

    return any_failed;
}
