#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>

#define PROGNAM "mkdir"

int main(int argc, char *argv[]) {
    // Phase 1: Validate - scan all args, check for unknown options
    int in_positional = 0;
    int operand_count = 0;
    
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        
        if (in_positional) {
            operand_count++;
        } else if (strcmp(arg, "--") == 0) {
            in_positional = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            // Unknown option
            if (arg[1] == '-') {
                fprintf(stderr, "%s: unrecognized option '%s'\n", PROGNAM, arg);
            } else {
                fprintf(stderr, "%s: invalid option -- '%c'\n", PROGNAM, arg[1]);
            }
            fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
            return 1;
        } else {
            operand_count++;
        }
    }
    
    if (operand_count == 0) {
        fprintf(stderr, "%s: missing operand\n", PROGNAM);
        fprintf(stderr, "Try '%s --help' for more information.\n", PROGNAM);
        return 1;
    }
    
    // Phase 2: Create directories in order
    in_positional = 0;
    int any_failed = 0;
    
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        
        if (in_positional) {
            if (mkdir(arg, 0777) != 0) {
                any_failed = 1;
                fprintf(stderr, "%s: cannot create directory '%s': %s\n",
                        PROGNAM, arg, strerror(errno));
            }
        } else if (strcmp(arg, "--") == 0) {
            in_positional = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            // Can't happen (validated in phase 1), but skip
            continue;
        } else {
            if (mkdir(arg, 0777) != 0) {
                any_failed = 1;
                fprintf(stderr, "%s: cannot create directory '%s': %s\n",
                        PROGNAM, arg, strerror(errno));
            }
        }
    }
    
    return any_failed ? 1 : 0;
}
```

