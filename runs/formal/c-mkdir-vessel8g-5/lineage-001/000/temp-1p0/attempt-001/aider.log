```c
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

int main(int argc, char *argv[]) {
    // Phase 1: Parse arguments, collect operands, detect unknown options
    const char **operands = NULL;
    size_t noperands = 0;
    int after_ddash = 0;
    int exit_status = 0;
    
    // First pass: validate and collect
    for (int i = 1; i < argc; i++) {
        if (after_ddash) {
            // Everything after -- is an operand
            // (we'll collect below)
            continue;
        }
        const char *arg = argv[i];
        if (strcmp(arg, "--") == 0) {
            after_ddash = 1;
            continue;
        }
        if (arg[0] == '-' && arg[1] != '\0') {
            // Unknown option
            fprintf(stderr, "mkdir: invalid option -- '%c'\n", arg[1]);
            fprintf(stderr, "Try 'mkdir --help' for more information.\n");
            return 1;
        }
        // Otherwise it's an operand (including bare "-")
    }
    
    // Second pass: collect operands
    operands = malloc(sizeof(char *) * (argc > 1 ? argc - 1 : 1));
    if (!operands) {
        // Out of memory - but we have no operands to report
        return 1;
    }
    
    after_ddash = 0;
    noperands = 0;
    for (int i = 1; i < argc; i++) {
        if (after_ddash) {
            operands[noperands++] = argv[i];
            continue;
        }
        if (strcmp(argv[i], "--") == 0) {
            after_ddash = 1;
            continue;
        }
        // At this point it's an operand (we validated in first pass)
        operands[noperands++] = argv[i];
    }
    
    if (noperands == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        fprintf(stderr, "Try 'mkdir --help' for more information.\n");
        free(operands);
        return 1;
    }
    
    // Phase 2: Create each directory
    for (size_t i = 0; i < noperands; i++) {
        if (mkdir(operands[i], 0777) != 0) {
            int saved_errno = errno;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    operands[i], strerror(saved_errno));
            exit_status = 1;
        }
    }
    
    free(operands);
    return exit_status;
}
```

