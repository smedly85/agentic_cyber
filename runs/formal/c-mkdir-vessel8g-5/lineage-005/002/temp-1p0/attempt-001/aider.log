static int parse_symbolic_mode(const char *s, size_t len, mode_t umask, mode_t *out) {
    mode_t mode = 0777 & (mode_t)~umask;
    
    const char *p = s;
    const char *end = s + len;
    
    while (p < end) {
        // Parse one clause
        // Skip leading comma
        if (*p == ',') { p++; if (p >= end) return 0; }
        
        // Parse who (one or more of u, g, o, a)
        int who = 0;
        int explicit_who = 0;
        while (p < end && *p != '+' && *p != '-' && *p != '=' && *p != ',') {
            char c = *p;
            if (c == 'u') who |= 1;
            else if (c == 'g') who |= 2;
            else if (c == 'o') who |= 4;
            else if (c == 'a') who |= 7;
            else return 0; // invalid char in who position
            explicit_who = 1;
            p++;
        }
        if (who == 0) who = 7; // default to all if no who specified
        
        // Parse operator
        if (p >= end || (*p != '+' && *p != '-' && *p != '=')) return 0;
        int op;
        if (*p == '+') op = 0;
        else if (*p == '-') op = 1;
        else op = 2;
        p++;
        
        // Parse permissions
        const char *perms_start = p;
        while (p < end && *p != ',') p++;
        size_t perms_len = p - perms_start;
        
        // Evaluate clause
        eval_clause(&mode, who, explicit_who, op, perms_start, perms_len, umask);
    }
    
    *out = mode;
    return 1;
}
```

