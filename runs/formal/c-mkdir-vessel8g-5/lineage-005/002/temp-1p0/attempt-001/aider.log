                i++;
                const char *ms = argv[i]; size_t ml = strlen(ms);
                mode_t pm;
                if (!parse_mode(ms, ml, cur_umask, &pm)) { diag_invalid_mode(ms, ml); return 1; }
                explicit_mode = pm; have_mode = 1;
            } else if (a[1] == 'm' && a[2] != '\0') {
