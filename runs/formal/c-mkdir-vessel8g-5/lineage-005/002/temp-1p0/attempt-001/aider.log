// --- Mode parsing ---

static int mode_invalid(const char *s, size_t len) {
    if (len == 0) return 1;
    // Check if numeric
    int all_octal = 1;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') { all_octal = 0; break; }
    }
    if (all_octal) return 0; // valid numeric mode
    
    // Must be symbolic: must contain at least one valid symbolic character
    // and must not have any invalid characters
    for (size_t i = 0; i < len; i++) {
        char c = s[i];
        if (c == ',' || c == '+' || c == '-' || c == '=') continue;
        if (c == 'u' || c == 'g' || c == 'o' || c == 'a') continue;
        if (c == 'r' || c == 'w' || c == 'x' || c == 'X') continue;
        if (c == 's' || c == 't') continue;
        return 1; // invalid character
    }
    // Additional validation: each clause must have an operator
    // (will be caught during evaluation)
    return 0;
}
