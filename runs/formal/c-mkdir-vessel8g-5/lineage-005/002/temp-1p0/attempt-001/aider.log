static int parse_numeric_mode(const char *s, size_t len, ParsedMode *pm) {
    // s is the mode string, len is its length
    // Must be 1-8 octal digits
    if (len < 1 || len > 8) return -1;
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return -1;
        val = val * 8 + (s[i] - '0');
    }
    if (val > 07777) return -1;
    pm->value = (mode_t)val;
    pm->has_explicit_special = (len >= 5);
    return 0;
}

