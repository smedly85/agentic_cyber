static int check_path(const char *path) {
    struct stat st;
    if (lstat(path, &st) == 0) {
        if (S_ISDIR(st.st_mode))
            return 1;
        if (S_ISLNK(st.st_mode)) {
            if (stat(path, &st) == 0)
                return S_ISDIR(st.st_mode) ? 1 : 0;
            return 0;
        }
        return 0;
    }
    if (errno == ENOENT)
        return -1;
    return -2;
}

