static void eval_clause(mode_t *mode, int who, int explicit_who, int op, const char *perms, mode_t umask) {
    // ... parse perms into perm_bits, special_bits, has_s, has_t, copy_src ...
    
    mode_t effective_perm = perm_bits;
    mode_t effective_special = special_bits;
    
    if (!explicit_who) {
        // Umask restrictions for + and -
        if (op == 0 || op == 1) { // + or -
            effective_perm &= (mode_t)~umask;
            // Special bits are NOT restricted by umask
        } else { // =
            effective_perm &= (mode_t)~umask;
            // Special bits: handled below
        }
    }
    
    if (op == 0) { // +
        *mode |= (effective_perm | effective_special);
    } else if (op == 1) { // -
        *mode &= ~(effective_perm | effective_special);
    } else { // =
        // Clear ordinary bits in who
        mode_t who_ordinary = 0;
        if (who & 1) who_ordinary |= 0700;
        if (who & 2) who_ordinary |= 0070;
        if (who & 4) who_ordinary |= 0007;
        
        *mode &= ~who_ordinary;
        *mode |= (effective_perm & who_ordinary);
        
        // Special bits for '=':
        // setuid: set if (who has u) and has_s
        if ((who & 1) && has_s) *mode |= 04000;
        // setgid: set if (who has g) and has_s
        if ((who & 2) && has_s) *mode |= 02000;
        // sticky: if who has o (or a), set if has_s or has_t, else clear
        if (who & 4) {
            if (has_s || has_t) *mode |= 01000;
            else *mode &= ~01000;
        }
    }
}
