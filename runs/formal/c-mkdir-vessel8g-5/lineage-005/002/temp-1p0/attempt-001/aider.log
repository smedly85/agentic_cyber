        if (op == '+') mode |= (perm & who);
        else if (op == '-') mode &= ~(perm & who);
        else if (op == '=') {
            mode &= ~who;
            mode |= (perm & who);
        }
        
        mode_str++; // skip comma
    }
    
    *pmode = mode;
    return 0;
}
```

