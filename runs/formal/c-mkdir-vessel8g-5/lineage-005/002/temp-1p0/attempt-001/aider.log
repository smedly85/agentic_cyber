```c
int
parse_mode (char const *mode, int *pmode, int umask, bool is_directory)
{
    int mode = *pmode;
    
    while (*mode_str) {
        int who = 0;
        int perm = 0;
        int op = 0;
        
        // Parse who
        while (*mode_str && strchr("ugoa", *mode_str)) {
            switch (*mode_str) {
            case 'u': who |= 0700; break;
            case 'g': who |= 0070; break;
            case 'o': who |= 0007; break;
            case 'a': who |= 0777; break;
            }
            mode_str++;
        }
        
        // Parse op
        if (*mode_str == '+' || *mode_str == '-' || *mode_str == '=') {
            op = *mode_str++;
        }
        
        // Parse perm
        while (*mode_str && *mode_str != ',') {
            switch (*mode_str) {
            case 'r': perm |= 0400; break;
            case 'w': perm |= 0200; break;
            case 'x': perm |= 0100; break;
            case 'X': if (is_directory) perm |= 0100; break;
            case 's': perm |= 04000; break;  // setuid
            case 't': if (is_directory) perm |= 01000; break;
            case 'u': /* copy u bits */ break;
            case 'g': /* copy g bits */ break;
            case 'o': /* copy o bits */ break;
            }
            mode_str++;
