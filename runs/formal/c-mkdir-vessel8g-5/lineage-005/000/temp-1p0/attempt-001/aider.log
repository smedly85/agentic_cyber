```c
static void
diagnostic_create_failure(const char *name, size_t len, int errnum)
{
    fprintf(stderr, "mkdir: cannot create directory ");
    write_quoted(name, len);
    fprintf(stderr, ": %s\n", strerror(errnum));
}

static void
diagnostic_unknown_option(const char *opt, size_t len)
{
    fprintf(stderr, "mkdir: unrecognized option ");
    write_quoted(opt, len);
    fprintf(stderr, "\nTry 'mkdir --help' for more information.\n");
}

static void
diagnostic_missing_operand(void)
{
    fprintf(stderr, "mkdir: missing operand\n"
            "Try 'mkdir --help' for more information.\n");
}
