#define PROGRAM_NAME "mkdir"

int main(int argc, char *argv[]) {
    int i = 1;
    int all_ok = 1;
    int have_operands = 0;

    // Parse arguments
    // Only supported option is --
    // Any other -x is unknown
    // Bare - is an operand

    while (i < argc) {
        char *arg = argv[i];
        
        if (strcmp(arg, "--") == 0) {
            i++;
            break;
        }
        
        if (arg[0] == '-' && arg[1] != '\0') {
            // Unknown option
            fprintf(stderr, "mkdir: invalid option -- '%c'\n", arg[1]);
            fprintf(stderr, "Try 'mkdir --help' for more information.\n");
            return 1;
