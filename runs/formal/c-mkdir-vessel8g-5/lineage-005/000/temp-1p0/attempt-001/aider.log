static void
write_quoted(const char *s, size_t len)
{
    fputc('\'', stderr);
    for (size_t i = 0; i < len; i++)
    {
        unsigned char c = (unsigned char)s[i];
        if (c == '\'')
            fputs("'\\''", stderr);
        else if (c >= 0x20 && c <= 0x7e)
            fputc(c, stderr);
        else
            fprintf(stderr, "\\%03o", (int)c);
    }
    fputc('\'', stderr);
}
```

