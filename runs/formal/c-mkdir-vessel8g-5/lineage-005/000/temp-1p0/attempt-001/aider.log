#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static int
quote_and_print(const char *s, size_t len)
{
    /* Print shell-quoted string to stdout (used in diagnostics to stderr) */
    int rc = 0;
    rc |= fputc('\'', stderr);
    for (size_t i = 0; i < len; i++)
    {
        unsigned char c = (unsigned char)s[i];
        if (c == '\'')
        {
            rc |= fputs("'\\''", stderr);
        }
        else if (c >= 0x20 && c <= 0x7e)
        {
            rc |= fputc(c, stderr);
        }
        else
        {
            char buf[8];
            int n = snprintf(buf, sizeof buf, "\\%03o", (int)c);
            if (n > 0 && (size_t)n < sizeof buf)
                rc |= fputs(buf, stderr);
            else
                rc = 1;
        }
    }
    rc |= fputc('\'', stderr);
    return rc;
}
```

