                mode_t m = S_IMODE(st2.st_mode);
                if ((m & 0300) != 0300) {
                    chmod(buf, m | 0300);
                }
            }
        }
    }
    
done:
    free(buf);
    return rc;
}

int main(int argc, char **argv) {
    int parents = 0;
    int seen_dd = 0;
    int n_op = 0;

    // First pass: parse options, count operands, detect errors
    for (int i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (seen_dd) {
            n_op++;
        } else if (strcmp(a, "--") == 0) {
            seen_dd = 1;
        } else if (a[0] == '-' && strcmp(a, "-") != 0) {
            if (strcmp(a, "-p") == 0 || strcmp(a, "--parents") == 0) {
                parents = 1;
            } else {
                diag_unknown_option(a, strlen(a));
                return 1;
            }
        } else {
            n_op++;
        }
    }

    if (n_op == 0) {
        diag_missing_operand();
        return 1;
    }

    // Second pass: create directories
    seen_dd = 0;
    int rc = 0;

    for (int i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (seen_dd) {
            int r = parents ? create_parents(a) : (mkdir(a, 0777) == 0 ? 0 : -1);
            if (r != 0) {
                rc = 1;
                diag_create_fail(a, strlen(a), errno);
            }
        } else if (strcmp(a, "--") == 0) {
            seen_dd = 1;
        } else if (a[0] == '-' && strcmp(a, "-") != 0) {
            continue;
        } else {
            int r = parents ? create_parents(a) : (mkdir(a, 0777) == 0 ? 0 : -1);
            if (r != 0) {
                rc = 1;
                diag_create_fail(a, strlen(a), errno);
            }
        }
    }

    return rc;
}
