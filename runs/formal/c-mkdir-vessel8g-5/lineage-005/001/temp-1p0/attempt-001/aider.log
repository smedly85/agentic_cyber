int main(int argc, char *argv[]) {
    int parents = 0;
    int end_of_options = 0;
    
    // First pass: parse options and validate
    // We need to collect operands and detect errors
    // Options can appear anywhere (before --)
    
    // Let's do a two-pass approach:
    // Pass 1: identify options and validate
    // Pass 2: collect operands
    
    int n_operands = 0;
    
    for (int i = 1; i < argc; i++) {
        if (!end_of_options) {
            if (strcmp(argv[i], "--") == 0) {
