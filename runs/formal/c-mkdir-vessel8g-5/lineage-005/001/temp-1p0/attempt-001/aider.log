## Instructions for `src/c_mkdir/c_mkdir.c`

**Interpretation chosen:** Combined short options (e.g., `-px`) are not required; only exact `-p` and `--parents` are recognized. A broken symlink in a path component is treated as a non-directory (failure), consistent with the "existing nondirectories still fail" requirement.

### Changes

1. **Add `#include <stdlib.h>`** (for `malloc`/`free`).

2. **Add a `create_parents` function** after the existing `diag_*` helpers and before `main`:

```c
static int create_parents(const char *path) {
    size_t len = strlen(path);
    if (len == 0) { errno = ENOENT; return -1; }

    char *buf = malloc(len + 1);
    if (!buf) { errno = ENOMEM; return -1; }

    /* Determine the end position of the last valid (non-empty, non-dot)
       component so we can tell intermediate dirs from the final one. */
    size_t last_comp_end = 0;
    {
        size_t scan = (path[0] == '/') ? 1 : 0;
        while (scan < len) {
            while (scan < len && path[scan] == '/') scan++;
            if (scan >= len) break;
            size_t cs = scan;
            while (scan < len && path[scan] != '/') scan++;
            size_t cl = scan - cs;
            if (cl > 0 && !(cl == 1 && path[cs] == '.'))
                last_comp_end = scan;
        }
    }

    int rc = 0;
    size_t pos = (path[0] == '/') ? 1 : 0;

    while (pos < len) {
        while (pos < len && path[pos] == '/') pos++;
        if (pos >= len) break;

        size_t comp_start = pos;
        while (pos < len && path[pos] != '/') pos++;
        size_t comp_len = pos - comp_start;

        if (comp_len == 0) continue;
        if (comp_len == 1 && path[comp_start] == '.') continue;

        memcpy(buf, path, pos);
        buf[pos] = '\0';

        struct stat st;
        if (stat(buf, &st) == 0) {
            if (S_ISDIR(st.st_mode)) continue;
            errno = ENOTDIR; rc = -1; goto done;
        } else if (errno == ENOENT) {
            /* Could be a broken symlink: lstat will reveal it. */
            struct stat st_l;
            if (lstat(buf, &st_l) == 0) {
                errno = ENOTDIR; rc = -1; goto done;
            }
            /* Truly absent: fall through to create. */
        } else {
            rc = -1; goto done;
        }

        if (mkdir(buf, 0777) != 0) { rc = -1; goto done; }

        /* Intermediate components: ensure owner has write+search (0300). */
        if (pos != last_comp_end) {
            struct stat st2;
            if (stat(buf, &st2) == 0) {
                mode_t m = S_IMODE(st2.st_mode);
                if ((m & 0300) != 0300)
                    chmod(buf, m | 0300);
            }
        }
    }

done:
    free(buf);
    return rc;
}
```

3. **Modify `main`** — add a `parents` flag, recognize `-p`/`--parents` in both passes, and dispatch to `create_parents` when the flag is set. Replace the entire `main` body with:

```c
int main(int argc, char **argv) {
    int parents = 0;
    int seen_dd = 0;
    int n_op = 0;

