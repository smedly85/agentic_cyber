```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>

static void fail_usage(const char *arg) {
    fprintf(stderr, "mkdir: unrecognized option '%s'\n", arg);
    fprintf(stderr, "Try 'mkdir --help' for more information.\n");
}

static void fail_missing_operand(void) {
    fprintf(stderr, "mkdir: missing operand\n");
    fprintf(stderr, "Try 'mkdir --help' for more information.\n");
}

/* Check if path exists. Returns:
   1 if exists as directory (or symlink to dir)
   0 if exists as non-directory
  -1 if doesn't exist
  -2 on error (other than ENOENT)
*/
static int path_check_dir(const char *path) {
    struct stat st;
    if (lstat(path, &st) == 0) {
        if (S_ISDIR(st.st_mode)) return 1;
        if (S_ISLNK(st.st_mode)) {
            if (stat(path, &st) == 0) {
                return S_ISDIR(st.st_mode) ? 1 : 0;
            }
            // Broken symlink or error following it
            return 0; // treat as non-directory for our purposes
        }
        return 0;
    }
    if (errno == ENOENT) return -1;
    return -2;
}

/* Create path and all missing intermediate directories (mkdir -p semantics).
   Returns 0 on success, -1 on failure.
   On failure, errno is set appropriately. */
static int mkdir_parents(const char *path, mode_t final_mode, mode_t inter_mode) {
    size_t len = strlen(path);
    
    if (len == 0) {
        errno = ENOENT;
        return -1;
    }
    
    // "/" is always a directory
    if (len == 1 && path[0] == '/') return 0;
    
    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return -1;
    }
    
    int ok = 0; // 0 = not done yet, 1 = success
    
    // Process intermediate components
    for (size_t i = 0; i < len; i++) {
        if (path[i] != '/') continue;
        if (i == 0) continue; // leading slash of absolute path
        if (i == len - 1) continue; // trailing slash, no new component
        
        buf[i] = '\0';
        const char *prefix = buf;
        
        int chk = path_check_dir(prefix);
        if (chk == 1) {
            // Already a directory, good
            continue;
        } else if (chk == 0) {
            // Exists but not a directory
            errno = ENOTDIR;
            goto done;
        } else if (chk == -1) {
            // Doesn't exist, create it
            if (mkdir(prefix, inter_mode) != 0) {
                int saved = errno;
                // Check if it appeared due to race
                int chk2 = path_check_dir(prefix);
                if (chk2 == 1) continue;
                errno = saved;
                goto done;
            }
        } else {
            // Error (chk == -2)
            goto done;
        }
    }
    
    // Handle the final component
    // Use the original path (stripped of trailing slashes for cleanliness, but OS handles it)
    {
        // Strip trailing slashes to get the clean final path
        char *final = buf; // reuse buf
        memcpy(final, path, len);
        final[len] = '\0';
        // Strip trailing slashes
        while (len > 1 && final[len - 1] == '/') {
            final[--len] = '\0';
        }
        
        int chk = path_check_dir(final);
        if (chk == 1) {
            // Already exists as directory, success (idempotent)
            ok = 1;
        } else if (chk == 0) {
            // Exists but not a directory
