        if (comp_len == 1 && path[comp_start] == '.') continue;
        
        memcpy(buf, path, pos);
        buf[pos] = '\0';
        
        struct stat st;
        if (stat(buf, &st) == 0) {
            if (S_ISDIR(st.st_mode)) {
                continue;
            } else {
                errno = ENOTDIR;
                rc = -1;
                goto done;
            }
        } else if (errno != ENOENT) {
            rc = -1;
            goto done;
        }
        
