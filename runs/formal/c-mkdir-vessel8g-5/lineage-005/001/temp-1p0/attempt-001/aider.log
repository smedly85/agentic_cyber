    umask(umask_val); // restore
    
    mode_t final_mode = 0777 & ~umask_val;
    mode_t inter_mode = (0777 & ~umask_val) | 0300;
    
    int all_ok = 1;
    for (int k = 0; k < n_operands; k++) {
        const char *path = argv[operands[k]];
