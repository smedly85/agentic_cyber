    }

    /* Ensure the final component */
    if (ok) {
        int chk = check_path(path);
        if (chk == 1) {
            /* already a directory: idempotent success */
        } else if (chk == 0) {
            errno = ENOTDIR;
            ok = 0;
        } else if (chk == -2) {
            ok = 0;
        } else {
