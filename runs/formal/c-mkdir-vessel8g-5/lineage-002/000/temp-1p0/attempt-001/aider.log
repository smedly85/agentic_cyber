#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

static int has_operand;

static void die_unknown_option(const char *arg) {
    if (arg[0] == '-' && arg[1] == '-' && arg[2] != '\0') {
        fprintf(stderr, "mkdir: unrecognized option '%s'\n", arg);
    } else if (arg[0] == '-' && arg[1] != '\0') {
        fprintf(stderr, "mkdir: invalid option -- '%c'\n", arg[1]);
    }
    fprintf(stderr, "Try 'mkdir --help' for more information.\n");
    exit(1);
}

int main(int argc, char *argv[]) {
    // Phase 1: Parse arguments
    int args_done = 0;  // set when we see --
    char **operands = NULL;
    int n_operands = 0;
    int max_operands = 0;
    
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        
        if (args_done) {
            // Everything after -- is an operand
            if (n_operands == max_operands) {
                max_operands = max_operands ? max_operands * 2 : 8;
                operands = realloc(operands, max_operands * sizeof(char*));
                if (!operands) {
                    fprintf(stderr, "mkdir: memory allocation failed\n");
                    return 1;
                }
            }
            operands[n_operands++] = (char *)arg;
            continue;
        }
        
        if (arg[0] == '-' && arg[1] == '\0') {
            // Bare '-' is an operand
        } else if (arg[0] == '-' && arg[1] == '-' && arg[2] == '\0') {
            // '--' is the option terminator
            args_done = 1;
            continue;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            // Unknown option
            die_unknown_option(arg);
        }
        // else: regular operand (doesn't start with -)
        
        // Add to operands
        if (n_operands == max_operands) {
            max_operands = max_operands ? max_operands * 2 : 8;
            operands = realloc(operands, max_operands * sizeof(char*));
            if (!operands) {
                fprintf(stderr, "mkdir: memory allocation failed\n");
                return 1;
            }
        }
        operands[n_operands++] = (char *)arg;
    }
    
    if (n_operands == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        fprintf(stderr, "Try 'mkdir --help' for more information.\n");
        return 1;
    }
    
    // Phase 2: Create directories
    int rc = 0;
    for (int i = 0; i < n_operands; i++) {
        if (mkdir(operands[i], 0777) != 0) {
            int e = errno;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    operands[i], strerror(e));
            rc = 1;
        }
    }
    
    free(operands);
    return rc;
}
```

