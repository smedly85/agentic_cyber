int main(int argc, char *argv[]) {
    int parents = 0;
    int n_operands = 0;
    int after_ddash = 0;
    int i;

    if (argc < 2) {
        fprintf(stderr, "mkdir: missing operand\n"
                        "Try 'mkdir --help' for more information.\n");
        return 1;
