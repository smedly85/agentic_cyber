            while (j < len) {
                size_t k = j;
                while (k < len && buf[k] != '/')
                    k++;
                size_t next_len = k - j;
                if (!(next_len == 1 && buf[j] == '.')) {
                    is_last = 0;
                    break;
                }
                j = k;
            }
        }

        char saved = buf[comp_end];
        buf[comp_end] = '\0';
        int rc = ensure_dir(buf, !is_last);
        buf[comp_end] = saved;
        if (rc != 0) {
            result = -1;
            break;
        }

        // Advance past the slash (which is at comp_end in the original string)
        // before the next iteration
        i = comp_end + 1;
    }

    free(buf);
    return result;
}

int main(int argc, char *argv[]) {
    int parents = 0;
    int n_operands = 0;
    int after_ddash = 0;
    int i;

    if (argc < 2) {
        fprintf(stderr, "mkdir: missing operand\n"
                        "Try 'mkdir --help' for more information.\n");
        return 1;
    }

    for (i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (after_ddash == 0 && strcmp(arg, "--") == 0) {
            after_ddash = 1;
            continue;
        }
        if (after_ddash == 0 && arg[0] == '-' && arg[1] != '\0') {
            if (strcmp(arg, "-p") == 0 || strcmp(arg, "--parents") == 0) {
                parents = 1;
                continue;
            }
            if (arg[1] == '-') {
                fprintf(stderr, "mkdir: unrecognized option '%s'\n"
                                "Try 'mkdir --help' for more information.\n",
                        arg);
            } else {
                fprintf(stderr, "mkdir: invalid option -- '%c'\n"
                                "Try 'mkdir --help' for more information.\n",
                        arg[1]);
            }
            return 1;
        }
        n_operands++;
    }

    if (n_operands == 0) {
        fprintf(stderr, "mkdir: missing operand\n"
                        "Try 'mkdir --help' for more information.\n");
        return 1;
    }

    after_ddash = 0;
    int all_ok = 1;

    for (i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (after_ddash == 0 && strcmp(arg, "--") == 0) {
            after_ddash = 1;
            continue;
        }
        if (after_ddash == 0 && arg[0] == '-' && arg[1] != '\0')
            continue;

        errno = 0;
        int rc;
        if (parents)
            rc = create_parents(arg);
        else
            rc = (mkdir(arg, 0777) == -1) ? -1 : 0;

        if (rc != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    arg, strerror(errno));
            all_ok = 0;
        }
    }

    return all_ok ? 0 : 1;
}
