#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

static int ensure_dir(const char *path, int ensure_owner_wx) {
    struct stat lst;
    if (lstat(path, &lst) == 0) {
        if (S_ISDIR(lst.st_mode))
            return 0;
        if (S_ISLNK(lst.st_mode)) {
            struct stat st;
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
                return 0;
            errno = ENOTDIR;
            return -1;
        }
        errno = ENOTDIR;
        return -1;
    }
    if (errno != ENOENT)
        return -1;

    if (mkdir(path, 0777) == -1)
        return -1;

    if (ensure_owner_wx) {
        struct stat st;
        if (stat(path, &st) == 0 && !(st.st_mode & 0300))
            chmod(path, (st.st_mode & 07777) | 0300);
    }
    return 0;
}

static int create_parents(const char *path) {
