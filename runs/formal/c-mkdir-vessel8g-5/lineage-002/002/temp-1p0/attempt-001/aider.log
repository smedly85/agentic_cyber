    mode_t value;
    int special_preserve; // 1: preserve unspecified special bits (numeric ≤4 digits)
} parsed_mode_t;

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int parse_numeric(const char *s, size_t len, parsed_mode_t *result) {
    if (len == 0) return -1;
    for (size_t i = 0; i < len; i++) {
        if (!is_octal_digit(s[i])) return -1;
    }
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        val = val * 8 + (unsigned)(s[i] - '0');
        if (val > 07777) return -1;
    }
    result->value = (mode_t)val;
    result->special_preserve = (len <= 4) ? 1 : 0;
    return 0;
}

static int eval_symbolic_clause(const char *s, size_t len, mode_t *mode, mode_t umask);

static int parse_symbolic(const char *s, size_t len, mode_t umask, parsed_mode_t *result) {
    if (len == 0) return -1;
    mode_t mode = 0777;
    size_t start = 0;
    for (size_t i = 0; i <= len; i++) {
        if (i == len || s[i] == ',') {
            if (eval_symbolic_clause(s + start, i - start, &mode, umask) != 0)
                return -1;
            start = i + 1;
        }
    }
    result->value = mode & 07777;
    result->special_preserve = 0;
    return 0;
}

static int parse_mode_string(const char *s, size_t len, mode_t umask, parsed_mode_t *result) {
    if (len == 0) return -1;
    if (is_octal_digit(s[0]))
        return parse_numeric(s, len, result);
    return parse_symbolic(s, len, umask, result);
}

