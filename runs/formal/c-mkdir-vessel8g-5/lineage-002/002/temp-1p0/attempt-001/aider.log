```c
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

#define MAX_PATH_LEN 4096

/* ==================== Mode parsing ==================== */

typedef struct {
    mode_t value;
    int special_preserve;
} parsed_mode_t;

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int parse_numeric(const char *s, size_t len, parsed_mode_t *result) {
    if (len == 0) return -1;
    for (size_t i = 0; i < len; i++)
        if (!is_octal_digit(s[i])) return -1;
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        val = val * 8 + (unsigned long)(s[i] - '0');
        if (val > 07777) return -1;
    }
    result->value = (mode_t)val;
    result->special_preserve = (len <= 4) ? 1 : 0;
    return 0;
}

static int eval_clause(const char *s, size_t len, mode_t *mode, mode_t umask) {
    if (len == 0) return -1;
    size_t pos = 0;
    int who_u = 0, who_g = 0, who_o = 0, who_omitted = 1;
    
    while (pos < len && (s[pos]=='u'||s[pos]=='g'||s[pos]=='o'||s[pos]=='a')) {
        switch (s[pos]) {
            case 'u': who_u = 1; break;
            case 'g': who_g = 1; break;
            case 'o': who_o = 1; break;
            case 'a': who_u = who_g = who_o = 1; break;
        }
        who_omitted = 0;
        pos++;
    }
    
    if (pos >= len) return -1;
    char op = s[pos];
    if (op != '+' && op != '-' && op != '=') return -1;
    pos++;
    
    // Determine target mask for explicit who
    mode_t target_mask = 0;
    if (who_u) target_mask |= 0700;
    if (who_g) target_mask |= 0070;
    if (who_o) target_mask |= 0007;
    
    if (pos >= len) {
        // Empty permission (e.g., "o=")
        if (op != '=') return -1;
        mode_t clear_mask = who_omitted ? 0777 : target_mask;
        if (who_omitted)
            *mode &= ~(clear_mask & (~umask & 0777));
        else
            *mode &= ~clear_mask;
        if (who_omitted || who_o)
            *mode &= ~01000;
        return 0;
    }
    
    // Check for permission copy
    int copy_src = 0;
    if (len - pos == 1 && (s[pos]=='u'||s[pos]=='g'||s[pos]=='o')) {
        copy_src = s[pos];
    } else {
        for (size_t i = pos; i < len; i++) {
            char c = s[i];
            if (c!='r'&&c!='w'&&c!='x'&&c!='X'&&c!='s'&&c!='t') return -1;
        }
    }
    
    if (copy_src) {
        // Permission copy
        unsigned int src_bits;
        switch (copy_src) {
            case 'u': src_bits = (*mode & 0700) >> 6; break;
            case 'g': src_bits = (*mode & 0070) >> 3; break;
            case 'o': src_bits = (*mode & 0007); break;
        }
        mode_t full_src = (mode_t)((src_bits << 6) | (src_bits << 3) | src_bits);
        
        if (op == '+') {
            if (who_omitted)
                *mode |= (full_src & (~umask & 0777));
            else
                *mode |= (full_src & target_mask);
        } else if (op == '-') {
            if (who_omitted)
                *mode &= ~(full_src & (~umask & 0777));
            else
                *mode &= ~(full_src & target_mask);
        } else {
            if (who_omitted) {
                *mode = (*mode & 07000) | (full_src & (~umask & 0777));
                *mode &= ~01000;
            } else {
                *mode = (*mode & ~target_mask) | (full_src & target_mask);
                if (who_o) *mode &= ~01000;
            }
        }
        return 0;
    }
    
    // Regular permissions
    mode_t perm_bits = 0;
    mode_t special_set = 0;
    int has_special = 0;
    
    for (size_t i = pos; i < len; i++) {
        switch (s[i]) {
            case 'r': perm_bits |= 0444; break;
            case 'w': perm_bits |= 0222; break;
            case 'x': case 'X': perm_bits |= 0111; break;
            case 's':
                has_special = 1;
                if (who_u || who_omitted) special_set |= 04000;
                if (who_g || who_omitted) special_set |= 02000;
                if (who_o || who_omitted) special_set |= 01000;
                break;
            case 't':
                has_special = 1;
                special_set |= 01000;
                break;
        }
    }
    
    if (op == '+') {
        if (who_omitted)
            *mode |= (perm_bits & (~umask & 0777));
        else
            *mode |= (perm_bits & target_mask);
        if (has_special)
            *mode |= special_set;
    } else if (op == '-') {
        if (who_omitted)
            *mode &= ~(perm_bits & (~umask & 0777));
        else
            *mode &= ~(perm_bits & target_mask);
        if (has_special)
            *mode &= ~special_set;
    } else { /* '=' */
        if (who_omitted) {
            *mode = (*mode & 07000) | (perm_bits & (~umask & 0777));
            *mode &= ~01000;
        } else {
            *mode = (*mode & ~target_mask) | (perm_bits & target_mask);
            if (who_o) *mode &= ~01000;
        }
        
        if (has_special) {
            if (who_omitted) {
                *mode = (*mode & 0777) | special_set;
            } else {
                // For explicit who with '=':
                // setuid: set if (who_u && special_set&04000), else preserved
                // setgid: set if (who_g && special_set&02000), else preserved
                // sticky: if who_o → set if special_set&01000, else cleared; else preserved
                mode_t new_special = 0;
                if (who_u) {
                    if (special_set & 04000) new_special |= 04000;
                    else new_special |= (*mode & 04000);
                } else {
                    new_special |= (*mode & 04000);
                }
                if (who_g) {
                    if (special_set & 02000) new_special |= 02000;
                    else new_special |= (*mode & 02000);
                } else {
                    new_special |= (*mode & 02000);
                }
                if (who_o) {
                    if (special_set & 01000) new_special |= 01000;
                } else {
                    new_special |= (*mode & 01000);
                }
                *mode = (*mode & 0777) | new_special;
            }
        }
    }
    
    return 0;
