static int ensure_dir(const char *path, int ensure_owner_wx) {
    struct stat lst;
    if (lstat(path, &lst) == 0) {
        if (S_ISDIR(lst.st_mode))
            return 0;
        if (S_ISLNK(lst.st_mode)) {
            struct stat st;
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
                return 0;
            errno = ENOTDIR;
            return -1;
        }
        errno = ENOTDIR;
        return -1;
    }
    if (errno != ENOENT)
        return -1;

    if (mkdir(path, 0777) == -1)
        return -1;

    if (ensure_owner_wx) {
        struct stat st;
        if (stat(path, &st) == 0 && !(st.st_mode & 0300))
            chmod(path, (st.st_mode & 07777) | 0300);
    }
    return 0;
}

static int create_parents(const char *path, mode_t final_mode, int has_final_mode) {
    size_t len = strlen(path);
    if (len == 0) {
        errno = ENOENT;
        return -1;
    }

    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return -1;
    }
    memcpy(buf, path, len + 1);

    int result = 0;
    size_t i = 0;

    while (i < len && buf[i] == '/')
        i++;
    if (i >= len) {
        free(buf);
        return 0;
    }

    while (i < len) {
        size_t comp_start = i;
        while (i < len && buf[i] != '/')
            i++;
        size_t comp_end = i;
        size_t comp_len = comp_end - comp_start;

        if (comp_len == 1 && buf[comp_start] == '.') {
            while (i < len && buf[i] == '/')
                i++;
            continue;
        }

        int is_last = 1;
        {
            size_t j = i;
            while (j < len && buf[j] == '/')
                j++;
            while (j < len) {
                size_t k = j;
                while (k < len && buf[k] != '/')
                    k++;
                size_t next_len = k - j;
                if (!(next_len == 1 && buf[j] == '.')) {
                    is_last = 0;
                    break;
                }
                j = k;
            }
        }

        char saved = buf[comp_end];
        buf[comp_end] = '\0';
        
