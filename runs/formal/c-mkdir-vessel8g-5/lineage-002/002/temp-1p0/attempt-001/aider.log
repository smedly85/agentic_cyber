static int parse_mode_str(const char *s, mode_t *result, int *digits) {
    // Returns 1 on success, 0 on failure
    if (s == NULL || s[0] == '\0') return 0;
    
    // Check if numeric: all digits 0-7
    int all_numeric = 1;
    for (const char *p = s; *p; p++) {
        if (*p < '0' || *p > '7') {
            all_numeric = 0;
            break;
        }
    }
    
    if (all_numeric) {
        // Parse as octal
        // Count digits
        size_t len = strlen(s);
        if (len > 8) return 0; // too long
        *digits = (int)len;
        unsigned long val = strtoul(s, NULL, 8);
        if (val > 07777) return 0;
        *result = (mode_t)val;
        return 1;
    }
    
    // Symbolic mode
    // ... complex parsing ...
}
```

For symbolic mode parsing, I need to handle:
- Comma-separated clauses
- Each clause: [who][operator][permissions]
- who: u, g, o, a, or omitted
- operator: +, -, =
- permissions: r, w, x, X, s, t, u, g, o (copy), or empty (for =)

Let me write a symbolic mode evaluator:

```c
static int parse_symbolic_mode(const char *s, mode_t *result) {
    mode_t mode = 0777; // starting point: a=rwx
    const char *p = s;
    
    while (*p) {
        // Parse one clause
        // who
        int who_u = 0, who_g = 0, who_o = 0;
        if (*p == 'u') { who_u = 1; p++; }
        else if (*p == 'g') { who_g = 1; p++; }
        else if (*p == 'o') { who_o = 1; p++; }
        else if (*p == 'a') { who_u = 1; who_g = 1; who_o = 1; p++; }
        
        int who_omitted = !who_u && !who_g && !who_o;
        
        // operator
        char op;
        if (*p == '+' || *p == '-' || *p == '=') {
            op = *p++;
        } else {
            return 0; // missing operator
        }
        
        // permissions
        int perm_r = 0, perm_w = 0, perm_x = 0, perm_s = 0, perm_t = 0;
        int copy_from = -1; // -1 = no copy, 0=u, 1=g, 2=o
        int has_perm = 0;
        
        while (*p && *p != ',') {
            switch (*p) {
                case 'r': perm_r = 1; has_perm = 1; break;
                case 'w': perm_w = 1; has_perm = 1; break;
                case 'x': case 'X': perm_x = 1; has_perm = 1; break;
                case 's': perm_s = 1; has_perm = 1; break;
                case 't': perm_t = 1; has_perm = 1; break;
                case 'u': copy_from = 0; has_perm = 1; break;
                case 'g': copy_from = 1; has_perm = 1; break;
                case 'o': copy_from = 2; has_perm = 1; break;
                default: return 0;
            }
            p++;
        }
        
        // For = with no permissions (empty assignment), has_perm is 0, that's OK
        // For + and - with no permissions, that's an error
        if (op != '=' && !has_perm) return 0;
        
        // Apply the operation
        // Determine which bits are affected
        int aff_u = who_u || who_omitted;
        int aff_g = who_g || who_omitted;
        int aff_o = who_o || who_omitted;
        
        // Compute the permission bits for the selected who
        mode_t perm_bits = 0;
        if (copy_from >= 0) {
            // Permission copy
            mode_t src_bits;
            if (copy_from == 0) src_bits = mode & 0700;
            else if (copy_from == 1) src_bits = mode & 0070;
            else src_bits = mode & 0007;
            
            if (aff_u) perm_bits |= (src_bits & 0700);
            if (aff_g) perm_bits |= (src_bits << 3) & 0070;
            if (aff_o) perm_bits |= (src_bits << 6) & 0007;
        } else {
            if (perm_r) {
                if (aff_u) perm_bits |= 0400;
                if (aff_g) perm_bits |= 0040;
                if (aff_o) perm_bits |= 0004;
            }
            if (perm_w) {
                if (aff_u) perm_bits |= 0200;
                if (aff_g) perm_bits |= 0020;
                if (aff_o) perm_bits |= 0002;
            }
            if (perm_x) {
                if (aff_u) perm_bits |= 0100;
                if (aff_g) perm_bits |= 0010;
                if (aff_o) perm_bits |= 0001;
            }
        }
        
        // Special bits
        mode_t special_set = 0;   // bits to set
        mode_t special_clear = 0; // bits to clear
        
        if (perm_s) {
            if (who_omitted || who_u) special_set |= 04000; // setuid
            if (who_omitted || who_g) special_set |= 02000; // setgid
