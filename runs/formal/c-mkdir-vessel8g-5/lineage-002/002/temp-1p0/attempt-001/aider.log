    return c >= '0' && c <= '7';
}

static int parse_numeric_mode(const char *s, int len, parsed_mode_t *result) {
    // s is the mode string, len is its length
    // Must be all octal digits, value 0-7777
    if (len == 0) return -1;
    for (int i = 0; i < len; i++) {
        if (!is_octal_digit(s[i])) return -1;
    }
    // Parse value
    unsigned long val = 0;
    for (int i = 0; i < len; i++) {
        val = val * 8 + (s[i] - '0');
        if (val > 07777) return -1;
    }
    result->value = (mode_t)val;
    result->special_preserve = (len <= 4) ? 1 : 0;
    return 0;
}

