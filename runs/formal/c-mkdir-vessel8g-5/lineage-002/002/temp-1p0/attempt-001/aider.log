            }
            if (strcmp(arg, "--mode") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "mkdir: option '--mode' requires an argument\n"
                                    "Try 'mkdir --help' for more information.\n");
                    return 1;
                }
                i++;
