```c
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

#define MAX_PATH_LEN 4096

/* ==================== Mode parsing ==================== */

typedef struct {
    mode_t value;           // Final mode (0-07777)
    int special_preserve;   // 1 if unspecified special bits should be preserved
} parsed_mode_t;

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int parse_numeric(const char *s, size_t len, parsed_mode_t *result) {
    if (len == 0) return -1;
    for (size_t i = 0; i < len; i++) {
        if (!is_octal_digit(s[i])) return -1;
    }
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        val = val * 8 + (unsigned)(s[i] - '0');
        if (val > 07777) return -1;
    }
    result->value = (mode_t)val;
    result->special_preserve = (len <= 4) ? 1 : 0;
    return 0;
}

// Symbolic mode evaluation
// mode starts at 0777 (a=rwx)
// umask is the process umask

static int eval_clause(const char *s, size_t len, mode_t *mode, mode_t umask) {
    if (len == 0) return -1;
    
    size_t pos = 0;
    
    // Parse who
    int who_u = 0, who_g = 0, who_o = 0, who_omitted = 1;
    while (pos < len && (s[pos]=='u'||s[pos]=='g'||s[pos]=='o'||s[pos]=='a')) {
        switch (s[pos]) {
            case 'u': who_u = 1; break;
            case 'g': who_g = 1; break;
            case 'o': who_o = 1; break;
            case 'a': who_u = who_g = who_o = 1; break;
        }
        who_omitted = 0;
        pos++;
    }
    
    // Parse operator
    if (pos >= len) return -1; // No operator
    char op = s[pos];
    if (op != '+' && op != '-' && op != '=') return -1;
    pos++;
    
    // Parse permission
    if (pos >= len) {
        // Empty permission (valid for =, e.g., "o=")
        if (op != '=') return -1;
        // Empty assignment: clear selected ordinary permissions
        // Special bits: preserve setuid/setgid, clear sticky (if selected)
        mode_t clear_mask = 0;
        if (who_u) clear_mask |= 0700;
        if (who_g) clear_mask |= 0070;
        if (who_o) clear_mask |= 0007;
        if (who_omitted) clear_mask = 0777;
        
        if (who_omitted) {
            // Umask-restricted: only clear bits not in umask
            mode_t can_clear = clear_mask & (~umask & 0777);
            *mode &= ~can_clear;
            // Sticky: cleared (omitted who includes o)
            // setuid/setgid: preserved
        } else {
            *mode &= ~clear_mask;
            if (who_o) *mode &= ~01000; // clear sticky if o is selected
            // setuid/setgid preserved
        }
        return 0;
    }
    
    // Check if it's a permission copy (single u/g/o)
    int copy_src = 0;
    if (len - pos == 1 && (s[pos]=='u'||s[pos]=='g'||s[pos]=='o')) {
        copy_src = s[pos];
    } else {
        // Parse permission characters
        for (size_t i = pos; i < len; i++) {
            char c = s[i];
            if (c!='r'&&c!='w'&&c!='x'&&c!='X'&&c!='s'&&c!='t') return -1;
        }
    }
    
    // Determine the permission bits and special bits from the clause
    mode_t perm_bits = 0;  // ordinary permission bits (0-0777)
    mode_t special_set = 0; // special bits to set
    int has_special = 0;   // whether any special bit is addressed
    
    if (copy_src) {
        // Permission copy: copy source's ordinary rwx to target
        // This is handled differently below
    } else {
        for (size_t i = pos; i < len; i++) {
            char c = s[i];
            switch (c) {
                case 'r': perm_bits |= 0444; break;
                case 'w': perm_bits |= 0222; break;
                case 'x': case 'X': perm_bits |= 0111; break;
                case 's':
                    has_special = 1;
                    if (who_u) special_set |= 04000;
                    if (who_g) special_set |= 02000;
                    if (who_o) special_set |= 01000;
                    if (who_omitted) special_set |= 07000;
                    break;
                case 't':
                    has_special = 1;
                    special_set |= 01000;
                    break;
            }
        }
    }
    
    // Apply the operation
    if (copy_src) {
        // Permission copy
        mode_t src_bits = 0;
        switch (copy_src) {
            case 'u': src_bits = (*mode & 0700) >> 6; break;
            case 'g': src_bits = (*mode & 0070) >> 3; break;
            case 'o': src_bits = (*mode & 0007); break;
        }
        // Expand src_bits to full mask
        mode_t full_src = (src_bits << 6) | (src_bits << 3) | src_bits;
        
        if (op == '+') {
            if (who_omitted) {
                *mode |= (full_src & (~umask & 0777));
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                *mode |= (full_src & target_mask);
            }
        } else if (op == '-') {
            if (who_omitted) {
                mode_t can_remove = full_src & (~umask & 0777);
                *mode &= ~can_remove;
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                *mode &= ~(full_src & target_mask);
            }
        } else { // '='
            if (who_omitted) {
                mode_t new_ordinary = full_src & (~umask & 0777);
                *mode = (*mode & 07000) | new_ordinary;
                // sticky: cleared (omitted who includes o)
                *mode &= ~01000;
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                // Clear target bits, set to src
                *mode = (*mode & ~target_mask) | (full_src & target_mask);
                if (who_o) *mode &= ~01000; // clear sticky if o selected
            }
        }
    } else {
        // Regular permission bits
        if (op == '+') {
            if (who_omitted) {
                *mode |= (perm_bits & (~umask & 0777));
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                *mode |= (perm_bits & target_mask);
            }
        } else if (op == '-') {
            if (who_omitted) {
                mode_t can_remove = perm_bits & (~umask & 0777);
                *mode &= ~can_remove;
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                *mode &= ~(perm_bits & target_mask);
            }
        } else { // '='
            if (who_omitted) {
                mode_t new_ordinary = perm_bits & (~umask & 0777);
                *mode = (*mode & 07000) | new_ordinary;
                *mode &= ~01000; // clear sticky
            } else {
                mode_t target_mask = 0;
                if (who_u) target_mask |= 0700;
                if (who_g) target_mask |= 0070;
                if (who_o) target_mask |= 0007;
                *mode = (*mode & ~target_mask) | (perm_bits & target_mask);
                if (who_o) *mode &= ~01000; // clear sticky if o selected
            }
        }
        
        // Apply special bits
        if (has_special) {
            if (op == '+') {
                *mode |= special_set;
            } else if (op == '-') {
                *mode &= ~special_set;
            } else { // '='
                // For '=': special bits in special_set are SET
                // setuid/setgid: preserved unless addressed
                // sticky: cleared unless addressed
                // 
                // If who includes u: setuid is addressed → set if in special_set, else preserved
                // If who includes g: setgid is addressed → set if in special_set, else preserved
                // If who includes o or a: sticky is addressed → set if in special_set, else cleared
                //
                // Actually, I think for '=' the special bits work like this:
                // - If the clause has 's' or 't', those bits are SET
                // - setuid: set if (who_u && special_set & 04000), else preserved
                // - setgid: set if (who_g && special_set & 02000), else preserved
                // - sticky: if (who_o || who_omitted) → set if (special_set & 01000), else cleared
                //           if (!who_o && !who_omitted) → preserved
                
                if (who_omitted) {
                    // All special bits addressed
                    *mode = (*mode & 0777) | special_set;
                } else {
                    mode_t new_special = 0;
                    // setuid
                    if (who_u) {
                        if (special_set & 04000) new_special |= 04000;
                        else new_special |= (*mode & 04000); // preserve
                    } else {
                        new_special |= (*mode & 04000); // preserve
                    }
                    // setgid
                    if (who_g) {
                        if (special_set & 02000) new_special |= 02000;
                        else new_special |= (*mode & 02000); // preserve
                    } else {
                        new_special |= (*mode & 02000); // preserve
                    }
                    // sticky
                    if (who_o) {
                        if (special_set & 01000) new_special |= 01000;
                        // else: cleared
                    } else {
                        new_special |= (*mode & 01000); // preserve
                    }
                    *mode = (*mode & 0777) | new_special;
                }
            }
        }
    }
    
    return 0;
}

static int parse_symbolic(const char *s, size_t len, mode_t umask, parsed_mode_t *result) {
    if (len == 0) return -1;
    
    mode_t mode = 0777; // a=rwx starting point
    
    // Split by commas and evaluate each clause
    size_t start = 0;
    for (size_t i = 0; i <= len; i++) {
        if (i == len || s[i] == ',') {
            if (eval_clause(s + start, i - start, &mode, umask) != 0)
                return -1;
            start = i + 1;
        }
    }
    
    result->value = mode & 07777;
    result->special_preserve = 0; // symbolic modes explicitly determine special bits
    return 0;
}

static int parse_mode_string(const char *s, size_t len, mode_t umask, parsed_mode_t *result) {
    if (len == 0) return -1; // empty mode string is invalid
    
    // Try numeric first
    if (is_octal_digit(s[0])) {
        int rc = parse_numeric(s, len, result);
        if (rc == 0) return 0;
        // If numeric parsing failed, fall through to symbolic
        // Actually, if it starts with a digit, it should be numeric.
        // Let me just return error.
        return -1;
    }
    
    // Otherwise, symbolic
    return parse_symbolic(s, len, umask, result);
}
