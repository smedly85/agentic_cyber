    if (n_operands == 0) {
        fprintf(stderr, "mkdir: missing operand\n"
                        "Try 'mkdir --help' for more information.\n");
        return 1;
    }
    
    // Process operands
    int all_ok = 1;
    for (int i = 0; i < n_operands; i++) {
        const char *path = operands[i];
        errno = 0;
        int rc;
        if (parents) {
            rc = create_parents(path, mode_val, has_mode, mode_digits);
