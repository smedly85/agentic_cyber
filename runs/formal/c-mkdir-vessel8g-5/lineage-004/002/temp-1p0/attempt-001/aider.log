        if (eff_u) rem |= perm_bits & 0700;
        if (eff_g) rem |= perm_bits & 0070;
        if (eff_o) rem |= perm_bits & 0007;
        rem |= special;
        if (who_omitted)
            rem = (rem & ~umask_ordinary) | (rem & (S_ISUID | S_ISGID | S_ISVTX));
        *result &= ~rem;
