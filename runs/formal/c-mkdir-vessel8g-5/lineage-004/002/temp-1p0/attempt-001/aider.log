                    continue;
                if (arg[1] == 'm' && arg[2] != '\0')
                    continue;
                if (strcmp(arg, "-m") == 0) { i++; continue; }
                if (strncmp(arg, "--mode=", 7) == 0)
                    continue;
                if (strcmp(arg, "--mode") == 0) { i++; continue; }
                continue;
