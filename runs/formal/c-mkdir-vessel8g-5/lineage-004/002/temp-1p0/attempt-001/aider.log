    }
    return 0;
}

static int create_parents(const char *path, mode_t um, const ParsedMode *pm)
{
    size_t len = strlen(path);
    if (len == 0) {
        errno = ENOENT;
        return -1;
    }

    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return -1;
    }
    memcpy(buf, path, len + 1);

    int result = 0;

    for (size_t i = 0; i < len; i++) {
        if (buf[i] != '/')
            continue;
        buf[i] = '\0';
        if (buf[0] == '\0' || strcmp(buf, ".") == 0) {
            buf[i] = '/';
            continue;
