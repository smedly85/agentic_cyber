Let me code this up:

```c
static int create_dir_with_mode(const char *path, mode_t desired, int preserve_special)
{
    if (mkdir(path, 0777) != 0)
        return -1;
    
    struct stat st;
    if (stat(path, &st) != 0)
        return -1; // shouldn't happen
    
    mode_t actual = st.st_mode & 07777;
    mode_t final;
    
    if (preserve_special) {
        // ≤4 digit numeric: preserve inherited special bits, add user's
        final = (actual & 07000) | (desired & 0777) | (desired & 07000);
    } else {
        // Symbolic or 5+ digit: exact mode
        final = desired & 07777;
    }
    
    if (final != actual)
        (void)chmod(path, final);
    
    return 0;
}
```

