Let me restructure `ensure_dir`:

```c
static int ensure_dir(const char *path, mode_t um, int is_final, const ParsedMode *pm)
{
    struct stat st;
    if (stat(path, &st) == 0) {
        if (S_ISDIR(st.st_mode))
            return 0;  // already exists, don't modify
        errno = ENOTDIR;
        return -1;
    }
    if (errno != ENOENT)
        return -1;

    if (mkdir(path, 0777) != 0) {
        if (errno == EEXIST) {
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
                return 0;
            errno = ENOTDIR;
        }
        return -1;
    }

    if (is_final) {
        if (pm && pm->has_mode) {
            // Apply explicit mode (with inheritance logic)
            if (apply_explicit_mode(path, pm) != 0)
                return -1;
        }
        // If no explicit mode, leave as mkdir gave it (0777 & ~um)
    } else {
        // Intermediate: ensure owner write and search
        if (chmod(path, (0777 & ~um) | 0300) != 0)
            return -1;
    }
    return 0;
}
```

And `apply_explicit_mode`:
```c
static int apply_explicit_mode(const char *path, const ParsedMode *pm)
{
    struct stat st;
    if (lstat(path, &st) != 0)
        return -1;
    
    mode_t inherited_special = st.st_mode & (S_ISUID | S_ISGID | S_ISVTX);
    mode_t final;
    
    if (pm->is_numeric) {
        if (pm->num_digits <= 4) {
            // Preserve unspecified set-ID bits
            final = pm->value | (inherited_special & ~pm->value);
        } else {
            final = pm->value;
        }
    } else {
        // Symbolic: preserve inherited special bits for untouched classes
        final = pm->value;
        if (!pm->uid_touched) final |= inherited_special & S_ISUID;
        if (!pm->gid_touched) final |= inherited_special & S_ISGID;
        if (!pm->sticky_touched) final |= inherited_special & S_ISVTX;
    }
    
    return chmod(path, final);
}
```

