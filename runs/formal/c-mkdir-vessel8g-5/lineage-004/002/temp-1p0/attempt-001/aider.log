```c
static int parse_one_clause(const char **pp, mode_t umask, mode_t *result,
                           int *uid_touched, int *gid_touched, int *sticky_touched)
{
    const char *p = *pp;
    
    // Parse who
    int who_u = 0, who_g = 0, who_o = 0;
    int who_omitted = 1;
    
    while (*p) {
        if (*p == 'u') { who_u = 1; who_omitted = 0; p++; }
        else if (*p == 'g') { who_g = 1; who_omitted = 0; p++; }
        else if (*p == 'o') { who_o = 1; who_omitted = 0; p++; }
        else if (*p == 'a') { who_u = who_g = who_o = 1; who_omitted = 0; p++; }
        else break;
    }
    
    // Parse operator
    char op = *p++;
    if (op != '+' && op != '-' && op != '=')
        return -1;  // invalid
    
    // Parse permissions
    int perm_r = 0, perm_w = 0, perm_x = 0;
    int perm_X = 0;  // conditional x
    int perm_s = 0;  // setuid/setgid/sticky
    int perm_t = 0;  // sticky
    int copy_u = 0, copy_g = 0, copy_o = 0;  // permission copy
    int perm_omitted = 1;
    
    while (*p) {
        if (*p == 'r') { perm_r = 1; perm_omitted = 0; p++; }
        else if (*p == 'w') { perm_w = 1; perm_omitted = 0; p++; }
        else if (*p == 'x') { perm_x = 1; perm_omitted = 0; p++; }
        else if (*p == 'X') { perm_X = 1; perm_omitted = 0; p++; }
        else if (*p == 's') { perm_s = 1; perm_omitted = 0; p++; }
        else if (*p == 't') { perm_t = 1; perm_omitted = 0; p++; }
        else if (*p == 'u') { copy_u = 1; perm_omitted = 0; p++; }
        else if (*p == 'g') { copy_g = 1; perm_omitted = 0; p++; }
        else if (*p == 'o') { copy_o = 1; perm_omitted = 0; p++; }
        else break;  // next clause separator or end
    }
    
    *pp = p;
    
    // Now apply the operation
    // ...
    return 0;
}
