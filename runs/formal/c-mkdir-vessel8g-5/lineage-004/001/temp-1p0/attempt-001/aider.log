And `ensure_dir`:
```c
static int ensure_dir(const char *path, mode_t um, int is_final) {
    struct stat st;
    if (stat(path, &st) == 0) {
        if (S_ISDIR(st.st_mode)) return 1;  // exists as dir (or symlink to dir)
        errno = ENOTDIR;
        return 0;  // exists as non-directory
    }
    
    if (errno != ENOENT) {
        // Some other error (EACCES, ELOOP, etc.)
        return 0;
    }
    
    // Doesn't exist — create it
    if (mkdir(path, 0777) != 0) {
        if (errno == EEXIST) {
            // Race: it was created between our stat and mkdir
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 1;
            errno = ENOTDIR;
            return 0;
        }
        return 0;  // EACCES, ENOSPC, etc.
    }
    
    // Ensure owner write+search for intermediates
    if (!is_final) {
        mode_t desired = (0777 & ~um) | 0300;
        if (chmod(path, desired) != 0) {
            return 0;
        }
    }
    
    return 1;
}
```

