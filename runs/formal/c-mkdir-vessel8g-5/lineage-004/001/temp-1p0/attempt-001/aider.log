static int create_parents(const char *path, mode_t um) {
    size_t len = strlen(path);
    if (len == 0) return 0;
    
    // Allocate a mutable copy
    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return -1;
    }
    memcpy(buf, path, len + 1);
    
    int result = 0;
    int is_final = 0;
    
    // Walk through the path, at each '/' boundary, try to ensure that prefix is a directory
    for (size_t i = 0; i < len; i++) {
        if (buf[i] == '/') {
            buf[i] = '\0';
            
            // Skip empty prefixes and "."
            if (buf[0] == '\0' || strcmp(buf, ".") == 0) {
                buf[i] = '/';
                continue;
            }
            
            if (!ensure_dir(buf, um, 0)) {  // 0 = intermediate
                result = -1;
                // Should we continue or stop? GNU stops at the first error for this operand
                break;
            }
            buf[i] = '/';
        }
    }
    
    // Handle the final component
    // Skip if it's "." or empty
    if (!result && (strcmp(buf, ".") != 0 && buf[0] != '\0')) {
        if (!ensure_dir(buf, um, 1)) {  // 1 = final
            result = -1;
        }
    }
    
    free(buf);
    return result;
}
