        /* Build prefix operand[0..i) and create it as intermediate */
        if (i == 0)
            continue;  /* absolute path root, skip */
        
        /* Need to create a directory at operand[0..i) */
        /* We need a NUL-terminated copy of the prefix */
        char *prefix = malloc(i + 1);
        if (!prefix) {
            errno = ENOMEM;
            return -1;
