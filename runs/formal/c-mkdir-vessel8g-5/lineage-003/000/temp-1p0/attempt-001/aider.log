                    // Long option: --foo
                    fprintf(stderr, "%s: unrecognized option '%s'\n", prog, argv[i]);
                } else {
                    // Short option: -x
                    fprintf(stderr, "%s: invalid option -- '%c'\n", prog, argv[i][1]);
                }
                fprintf(stderr, "Try '%s --help' for more information.\n", prog);
                return 1;
            }
        }
        // It's an operand (or option_terminated is set)
        has_operand = 1;
        int rc = mkdir(argv[i], 0777);
        if (rc != 0) {
            int err = errno;
            fprintf(stderr, "%s: cannot create directory '%s': %s\n", prog, argv[i], strerror(err));
            all_ok = 0;
        }
    }
    
    if (!has_operand) {
        fprintf(stderr, "%s: missing operand\n", prog);
        fprintf(stderr, "Try '%s --help' for more information.\n", prog);
        return 1;
    }
    
    return all_ok ? 0 : 1;
}
```

