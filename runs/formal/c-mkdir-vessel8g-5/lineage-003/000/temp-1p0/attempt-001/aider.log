#include <unistd.h>

int main(int argc, char *argv[]) {
    const char *prog = "mkdir";
    int all_ok = 1;
    int i;
    int option_terminated = 0;
    
    if (argc < 2) {
        fprintf(stderr, "%s: missing operand\n", prog);
        fprintf(stderr, "Try '%s --help' for more information.\n", prog);
        return 1;
    }
    
    // Parse arguments
    // Only -- is a valid option
    // - (single dash) is an operand
    // -- is the option terminator
    // Everything else starting with - (and not --) is an unknown option
    
    int has_operand = 0;
    
    for (i = 1; i < argc; i++) {
        if (!option_terminated) {
            if (strcmp(argv[i], "--") == 0) {
                option_terminated = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // It's a dash-prefixed argument that's not just "-"
                // Since we don't support any options, this is an error
                if (argv[i][1] == '-' && argv[i][2] == '\0') {
