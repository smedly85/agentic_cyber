#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char *argv[])
{
    // Phase 1: Validate options (no mutation yet)
    int opt_done = 0;
    for (int i = 1; i < argc; i++) {
        if (opt_done)
            break;
        if (strcmp(argv[i], "--") == 0) {
            opt_done = 1;
        } else if (argv[i][0] == '-' && argv[i][1] != '\0' &&
                   !(argv[i][1] == '\0')) {
            // It's a dash-prefixed argument that's not bare '-' and not '--'
            // This is an invalid option
            if (strcmp(argv[i], "-") != 0) {
                fprintf(stderr, "mkdir: invalid option -- '%c'\n", argv[i][1]);
                fprintf(stderr, "Try 'mkdir --help' for more information.\n");
                return 1;
            }
        }
    }
    
    // Phase 2: Collect operands
    // An operand is any argument that is not an invalid option and not `--`
    // (before the first --). After --, everything is an operand.
    
    // Let's collect operand pointers
    const char *operands[4096]; // reasonable limit
    int nops = 0;
    opt_done = 0;
    for (int i = 1; i < argc; i++) {
        if (!opt_done) {
            if (strcmp(argv[i], "--") == 0) {
                opt_done = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1] != '\0') {
                // invalid option (already checked, but skip)
                continue;
            }
        }
        // It's an operand
        if (nops < 4096)
            operands[nops++] = argv[i];
    }
    
    if (nops == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        fprintf(stderr, "Try 'mkdir --help' for more information.\n");
        return 1;
    }
    
    // Phase 3: Process operands in order
    int all_ok = 1;
    for (int i = 0; i < nops; i++) {
        if (mkdir(operands[i], 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    operands[i], strerror(errno));
            all_ok = 0;
        }
    }
    
    return all_ok ? 0 : 1;
}
```

