Let me now write the complete implementation:

```c
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>

int main(int argc, char *argv[])
{
    const char *prog = "mkdir";
    
    /* Phase 1: Parse options and collect operands. */
    int use_parents = 0;
    int terminated = 0;
    int n_operands = 0;
    const char *operands[256];
    
    for (int i = 1; i < argc; i++) {
        if (terminated) {
            if (n_operands >= 256) {
                fprintf(stderr, "%s: too many operands\n", prog);
                return 1;
            }
            operands[n_operands++] = argv[i];
            continue;
        }
        if (strcmp(argv[i], "--") == 0) {
            terminated = 1;
            continue;
        }
        if (strcmp(argv[i], "-p") == 0 || strcmp(argv[i], "--parents") == 0) {
            use_parents = 1;
            continue;
        }
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            if (argv[i][1] == '-')
                fprintf(stderr, "%s: unrecognized option '%s'\n", prog, argv[i]);
            else
                fprintf(stderr, "%s: invalid option -- '%c'\n", prog, argv[i][1]);
            fprintf(stderr, "Try '%s --help' for more information.\n", prog);
            return 1;
        }
        // operand (includes bare "-")
        if (n_operands >= 256) {
            fprintf(stderr, "%s: too many operands\n", prog);
            return 1;
        }
        operands[n_operands++] = argv[i];
    }
    
    if (n_operands == 0) {
        fprintf(stderr, "%s: missing operand\n", prog);
        fprintf(stderr, "Try '%s --help' for more information.\n", prog);
        return 1;
    }
    
    /* Phase 2: Create directories. */
    int all_ok = 1;
    
    for (int i = 0; i < n_operands; i++) {
        const char *path = operands[i];
        
        if (use_parents) {
            if (mkdir_parents(path) != 0) {
                all_ok = 0;
            }
        } else {
            if (mkdir(path, 0777) != 0) {
                fprintf(stderr, "%s: cannot create directory '%s': %s\n",
                        prog, path, strerror(errno));
                all_ok = 0;
            }
        }
    }
    
    return all_ok ? 0 : 1;
}
```

Now I need to implement `mkdir_parents`:

```c
static int mkdir_parents(const char *path)
{
    size_t path_len = strlen(path);
    char *buf = malloc(path_len + 1);
    if (!buf) {
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n", path, strerror(errno));
        return -1;
    }
    
    int is_abs = (path[0] == '/');
    buf[0] = '\0';
    if (is_abs) {
        buf[0] = '/';
        buf[1] = '\0';
    }
    
    size_t i = 0;
    // Skip leading slashes
    while (i < path_len && path[i] == '/') i++;
    
    int failed = 0;
    
    for (; i < path_len; ) {
        // Find end of current component
        size_t j = i;
        while (j < path_len && path[j] != '/') j++;
        
        size_t comp_len = j - i;
        
        if (comp_len == 0) {
            // shouldn't happen due to skipping, but just in case
            i = j + 1;
            continue;
        }
        
        // Skip "." components
        if (comp_len == 1 && path[i] == '.') {
            i = j;
            while (i < path_len && path[i] == '/') i++;
            continue;
        }
        
        // Append this component to buf
        size_t buf_len = strlen(buf);
        if (buf_len == 0 || buf[buf_len - 1] != '/') {
            buf[buf_len] = '/';
            buf[buf_len + 1] = '\0';
            buf_len++;
        }
        memcpy(buf + buf_len, path + i, comp_len);
        buf[buf_len + comp_len] = '\0';
        
        // Determine if this is the final component
        size_t k = j;
        while (k < path_len && path[k] == '/') k++;
        int is_final = (k >= path_len);
        
        // Try to create
        if (mkdir(buf, 0777) == 0) {
            // Created successfully
            if (!is_final) {
                // Ensure owner has write and search (execute) permission
                mode_t mask = umask(0);
                umask(mask);
                chmod(buf, (0777 & ~mask) | 0300);
            }
        } else if (errno == EEXIST) {
            // Already exists — check if it's a directory
            struct stat st;
            if (stat(buf, &st) != 0 || !S_ISDIR(st.st_mode)) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        path, strerror(errno)); // errno from stat or S_ISDIR check
                // Hmm, errno might be wrong here. If stat succeeded but it's not a dir,
                // what errno should I use?
                // GNU uses ENOTDIR in this case.
                // Actually, let me set errno = ENOTDIR for this case
                failed = 1;
                free(buf);
                return -1;
            }
            // It's a directory, OK — continue
        } else {
            // Other error (ENOTDIR, EACCES, etc.)
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
            failed = 1;
            free(buf);
            return -1;
        }
        
        // Advance past this component and any following slashes
        i = j;
        while (i < path_len && path[i] == '/') i++;
    }
    
    free(buf);
    return failed ? -1 : 0;
}
```

