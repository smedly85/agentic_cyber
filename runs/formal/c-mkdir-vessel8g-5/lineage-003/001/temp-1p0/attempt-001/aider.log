#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

// Forward declarations
static int create_parents(const char *path);
static int is_directory(const char *path);

int main(int argc, char *argv[])
{
    int parents = 0;
    int opt_done = 0;
    
    // Phase 1: Parse options (no filesystem mutation)
    // Collect operands
    const char *operands[256]; // or use dynamic allocation
    int n_operands = 0;
    
    for (int i = 1; i < argc; i++) {
        if (opt_done) {
            if (n_operands >= 256) { /* error */ }
            operands[n_operands++] = argv[i];
            continue;
        }
        if (strcmp(argv[i], "--") == 0) {
            opt_done = 1;
            continue;
        }
        if (strcmp(argv[i], "-p") == 0 || strcmp(argv[i], "--parents") == 0) {
            parents = 1;
            continue;
        }
        if (argv[i][0] == '-' && argv[i][1] != '\0') {
            fprintf(stderr, "mkdir: unrecognized option '%s'\n", argv[i]);
            fprintf(stderr, "Try 'mkdir --help' for more information.\n");
            return 1;
        }
        // It's an operand
        if (n_operands >= 256) { /* error */ }
        operands[n_operands++] = argv[i];
    }
    
    if (n_operands == 0) {
        fprintf(stderr, "mkdir: missing operand\n");
        fprintf(stderr, "Try 'mkdir --help' for more information.\n");
        return 1;
    }
    
    // Phase 2: Create directories
    int all_ok = 1;
    for (int i = 0; i < n_operands; i++) {
        int rc;
        if (parents) {
            rc = create_parents(operands[i]);
        } else {
            if (mkdir(operands[i], 0777) != 0) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        operands[i], strerror(errno));
                rc = 1;
            } else {
                rc = 0;
            }
        }
        if (rc != 0)
            all_ok = 0;
    }
    
    return all_ok ? 0 : 1;
}
```

