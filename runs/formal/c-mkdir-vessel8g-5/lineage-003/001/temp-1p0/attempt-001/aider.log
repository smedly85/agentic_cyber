static int create_parents(const char *path)
{
    size_t len = strlen(path);
    if (len == 0) return 1; // shouldn't happen
    
    // We need to walk through the path component by component
    // Build up the sub-path and check/create at each component boundary
    
    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        return 1;
    }
    
    int is_final = 0;
    int rc = 0;
    size_t i = 0;
    
    // Handle the case where path starts with '/'
    // We process character by character, and at each '/' we have a component boundary
    
    // Actually, let me think about this differently.
    // I'll iterate through the path and at each '/' (or end of string), 
    // I have a sub-path to check/create.
    
    for (i = 0; i <= len; i++) {
        if (i == len || path[i] == '/') {
            // We have a component ending at position i
            // The sub-path is path[0..i-1]
            if (i == 0) continue; // leading '/'
            
            // Skip empty components (e.g., '//')
            // Check if the sub-path from the last non-empty component is empty
            // Actually, let me just check if the sub-path is just "/" or empty
            if (i == 1 && path[0] == '/') continue; // just "/"
            
            // Check for repeated slashes: if path[i-1] is also '/', skip
            // But we still need to process the non-empty parts
            
            // Build the sub-path
            memcpy(buf, path, i);
            buf[i] = '\0';
            
            // Skip if this is just slashes
            int all_slashes = 1;
            for (size_t j = 0; j < i; j++) {
                if (path[j] != '/') { all_slashes = 0; break; }
            }
            if (all_slashes) continue;
            
            // Now check if buf (the sub-path) exists and is a directory
            struct stat st;
            if (lstat(buf, &st) == 0) {
                // It exists
                if (S_ISDIR(st.st_mode)) {
                    continue; // OK, it's a directory
                }
                if (S_ISLNK(st.st_mode)) {
                    // Check if it resolves to a directory
                    struct stat st2;
                    if (stat(buf, &st2) == 0 && S_ISDIR(st2.st_mode)) {
                        continue; // OK, symlink to directory
                    }
                }
                // It exists but is not a directory
                errno = ENOTDIR;
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        path, strerror(ENOTDIR));
                rc = 1;
                goto done;
            } else if (errno == ENOENT) {
                // Doesn't exist, create it
                if (mkdir(buf, 0777) != 0) {
                    fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                            path, strerror(errno));
                    rc = 1;
                    goto done;
                }
                // If not the final component, ensure owner w+x
                if (i < len) {
                    // This is an intermediate directory
                    // Check if owner has w+x
                    if (lstat(buf, &st) == 0) {
                        mode_t mode = st.st_mode;
                        if (!(mode & (S_IWUSR | S_IXUSR))) {
                            chmod(buf, mode | S_IWUSR | S_IXUSR);
                        }
                    }
                }
            } else {
                // Some other error (permission denied, etc.)
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        path, strerror(errno));
                rc = 1;
                goto done;
            }
        }
    }
    
done:
    free(buf);
    return rc;
}
