```c
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static int create_parents(const char *path)
{
    size_t len = strlen(path);
    if (len == 0)
        return 1;

    char *buf = malloc(len + 1);
    if (!buf) {
        errno = ENOMEM;
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                path, strerror(ENOMEM));
        return 1;
    }

    int rc = 0;

    for (size_t i = 1; i <= len; i++) {
        if (i < len && path[i] != '/')
            continue;

        // Component boundary at position i
        memcpy(buf, path, i);
        buf[i] = '\0';

        // Skip if all slashes (e.g., "/", "//", etc.)
        int all_slashes = 1;
        for (size_t j = 0; j < i; j++) {
            if (path[j] != '/') { all_slashes = 0; break; }
        }
        if (all_slashes)
            continue;

        struct stat st;
        if (lstat(buf, &st) == 0) {
            if (S_ISDIR(st.st_mode))
                continue;
            if (S_ISLNK(st.st_mode)) {
                struct stat st2;
                if (stat(buf, &st2) == 0 && S_ISDIR(st2.st_mode))
                    continue;
            }
            // Exists but not a directory
            if (i == len)
                errno = EEXIST;
            else
                errno = ENOTDIR;
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
            rc = 1;
            free(buf);
            return rc;
        }

        if (errno != ENOENT) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
            rc = 1;
            free(buf);
            return rc;
        }

        // Doesn't exist, create it
        if (mkdir(buf, 0777) != 0) {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
            rc = 1;
            free(buf);
            return rc;
        }

        // If intermediate, ensure owner has write + execute
        if (i < len) {
            if (lstat(buf, &st) == 0) {
                mode_t m = st.st_mode;
                if (!(m & (S_IWUSR | S_IXUSR)))
                    chmod(buf, m | S_IWUSR | S_IXUSR);
            }
        }
    }

    free(buf);
    return rc;
}
```

