static int mkdir_parents(const char *path)
{
    size_t path_len = strlen(path);
    char *buf = malloc(path_len + 1);
    if (!buf) {
        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                path, strerror(ENOMEM));
        return -1;
    }

    int is_abs = (path[0] == '/');
    if (is_abs) {
        buf[0] = '/';
        buf[1] = '\0';
    } else {
        buf[0] = '\0';
    }

    size_t i = 0;
    while (i < path_len && path[i] == '/') i++;

    for (; i < path_len; ) {
        size_t j = i;
        while (j < path_len && path[j] != '/') j++;
        size_t comp_len = j - i;

        if (comp_len == 1 && path[i] == '.') {
            i = j;
            while (i < path_len && path[i] == '/') i++;
            continue;
        }

        // Append component to buf
        size_t blen = strlen(buf);
        if (blen > 0 && buf[blen - 1] != '/') {
            buf[blen] = '/';
            blen++;
        }
        memcpy(buf + blen, path + i, comp_len);
        buf[blen + comp_len] = '\0';

        // Check if this is the final component
        size_t k = j;
        while (k < path_len && path[k] == '/') k++;
        int is_final = (k >= path_len);

        if (mkdir(buf, 0777) == 0) {
            if (!is_final) {
                mode_t mask = umask(0);
                umask(mask);
                chmod(buf, (0777 & ~mask) | 0300);
            }
        } else if (errno == EEXIST) {
            struct stat st;
            if (stat(buf, &st) == 0 && S_ISDIR(st.st_mode)) {
                /* already exists as directory, OK */
            } else {
                if (stat(buf, &st) != 0) {
                    /* stat failed (e.g., broken symlink) - errno is set */
                } else {
                    errno = ENOTDIR;
                }
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        path, strerror(errno));
                free(buf);
                return -1;
            }
        } else {
            fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                    path, strerror(errno));
            free(buf);
            return -1;
        }

        i = j;
        while (i < path_len && path[i] == '/') i++;
    }

    free(buf);
    return 0;
}
