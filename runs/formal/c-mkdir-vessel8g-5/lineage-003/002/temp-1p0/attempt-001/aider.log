/* ---- Mode parsing ---- */

#define WHO_U 1
#define WHO_G 2
#define WHO_O 4
#define WHO_A 7

typedef enum { OP_ADD, OP_REMOVE, OP_ASSIGN } Op;

typedef struct {
    unsigned who;
    int who_omitted;
    Op op;
    int perm_r, perm_w, perm_x; /* X is same as x for dirs */
    int perm_s, perm_t;
    int copy_src; /* 0=none, 1=u, 2=g, 3=o */
    int empty;
} Clause;

static int try_parse_numeric(const char *s, size_t len, mode_t *out) {
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
    }
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        val = val * 8 + (unsigned)(s[i] - '0');
        if (val > 077777) return 0;
    }
    *out = (mode_t)val;
    return 1;
}

static int is_numeric(const char *s, size_t len) {
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
    }
    return 1;
}

/* Parse one clause. Returns new position, or -1 on error. */
static long parse_clause(const char *s, size_t len, size_t pos, Clause *cl) {
    memset(cl, 0, sizeof(*cl));
    
    /* Parse who */
    size_t start = pos;
    while (pos < len) {
        switch (s[pos]) {
            case 'u': cl->who |= WHO_U; pos++; break;
            case 'g': cl->who |= WHO_G; pos++; break;
            case 'o': cl->who |= WHO_O; pos++; break;
            case 'a': cl->who |= WHO_A; pos++; break;
            default: goto who_done;
        }
    }
who_done:
    if (pos == start) {
        cl->who_omitted = 1;
        cl->who = WHO_A;
    }
    
    /* Parse operator */
    if (pos >= len) return -1;
    switch (s[pos]) {
        case '+': cl->op = OP_ADD; break;
        case '-': cl->op = OP_REMOVE; break;
        case '=': cl->op = OP_ASSIGN; break;
        default: return -1;
    }
    pos++;
    
    /* Parse permissions */
    if (pos >= len || s[pos] == ',') {
        /* Empty permissions */
        if (cl->op == OP_ADD || cl->op == OP_REMOVE) return -1;
        cl->empty = 1;
        return pos;
    }
    
    while (pos < len && s[pos] != ',') {
        switch (s[pos]) {
            case 'r': cl->perm_r = 1; break;
            case 'w': cl->perm_w = 1; break;
            case 'x': case 'X': cl->perm_x = 1; break;
            case 's': cl->perm_s = 1; break;
            case 't': cl->perm_t = 1; break;
            case 'u': cl->copy_src = 1; break;
            case 'g': cl->copy_src = 2; break;
            case 'o': cl->copy_src = 3; break;
            default: return -1;
        }
        pos++;
    }
    
    int has_explicit = cl->perm_r || cl->perm_w || cl->perm_x || cl->perm_s || cl->perm_t;
    if (has_explicit && cl->copy_src) return -1;
    
    return pos;
}

/* Apply a clause to the current mode */
static void apply_clause(mode_t *mode, const Clause *cl, mode_t umask_val, int *had_ordinary) {
    mode_t m = *mode;
    unsigned who = cl->who;
    int use_umask = cl->who_omitted;
    
    if (cl->copy_src) {
        /* Permission copy */
        unsigned int src;
        switch (cl->copy_src) {
            case 1: src = (m >> 6) & 7; break;
            case 2: src = (m >> 3) & 7; break;
            case 3: src = m & 7; break;
        }
        int shifts[3] = {6, 3, 0};
        for (int c = 0; c < 3; c++) {
            unsigned cb = 1u << c;
            if (!(who & cb)) continue;
            int sh = shifts[c];
            mode_t cmask = (mode_t)7 << sh;
            mode_t val = (mode_t)src << sh;
            switch (cl->op) {
                case OP_ADD: m |= val; break;
                case OP_REMOVE: m &= ~val; break;
                case OP_ASSIGN: m = (m & ~cmask) | val; break;
            }
        }
        *had_ordinary = 1;
        *mode = m;
        return;
    }
    
    /* Compute the permission bits this clause specifies */
    mode_t perms = 0;
    if (cl->perm_r) perms |= 0444;
    if (cl->perm_w) perms |= 0222;
    if (cl->perm_x) perms |= 0111;
    
    /* Special bits */
    mode_t special = 0;
    if (cl->perm_s) {
        if (who & WHO_U) special |= 04000;
        if (who & WHO_G) special |= 02000;
    }
    if (cl->perm_t) special |= 01000;
    
    /* Apply ordinary permissions per class */
    int shifts[3] = {6, 3, 0};
    for (int c = 0; c < 3; c++) {
        unsigned cb = 1u << c;
        if (!(who & cb)) continue;
        int sh = shifts[c];
        mode_t cmask = (mode_t)7 << sh;
        mode_t cperms = perms & cmask;
        
        if (use_umask) {
            mode_t uclass = umask_val & cmask;
            switch (cl->op) {
                case OP_ADD: m |= (cperms & ~uclass); break;
                case OP_REMOVE: m &= ~(cperms & ~uclass); break;
                case OP_ASSIGN: m = (m & ~cmask) | (cperms & ~uclass); break;
            }
        } else {
            switch (cl->op) {
                case OP_ADD: m |= cperms; break;
                case OP_REMOVE: m &= ~cperms; break;
                case OP_ASSIGN: m = (m & ~cmask) | cperms; break;
            }
        }
    }
    
    /* Apply special bits */
    switch (cl->op) {
        case OP_ADD:
            m |= special;
            break;
        case OP_REMOVE:
            m &= ~special;
            break;
        case OP_ASSIGN:
            /* Preserve setuid/setgid unless explicitly addressed */
            if (cl->perm_s) {
                if (who & WHO_U) {
                    if (special & 04000) m |= 04000;
                    else m &= ~04000;
                }
                if (who & WHO_G) {
                    if (special & 02000) m |= 02000;
                    else m &= ~02000;
                }
            }
            /* sticky: cleared if who includes o */
            if (cl->perm_t) {
                if (special & 01000) m |= 01000;
                else m &= ~01000;
            } else {
                if (who & WHO_O) m &= ~01000;
            }
            break;
    }
    
    /* Track ordinary permissions usage */
    if (cl->perm_r || cl->perm_w || cl->perm_x || cl->empty) {
        *had_ordinary = 1;
    }
    
    *mode = m;
}

/* Parse a full symbolic mode string */
static int parse_symbolic(const char *s, size_t len, mode_t umask_val, mode_t *out) {
    if (len == 0) return 0;
    
    mode_t mode = 0777; /* a=rwx as point of departure */
    int had_ordinary = 0;
    
    size_t pos = 0;
    while (pos <= len) {
        Clause cl;
        long next = parse_clause(s, len, pos, &cl);
        if (next < 0) return 0;
        apply_clause(&mode, &cl, umask_val, &had_ordinary);
        pos = (size_t)next;
        if (pos >= len) break;
        if (s[pos] == ',') { pos++; }
        else return 0;
    }
    
    /* Special-bit-only rule */
    if (!had_ordinary) {
        mode = (mode & ~0777) | 0755;
    }
    
    *out = mode;
    return 1;
}

/* Main mode parser */
static int parse_mode(const char *s, mode_t umask_val, mode_t *out) {
    size_t len = strlen(s);
    if (len == 0) return 0;
    if (is_numeric(s, len)) {
        return try_parse_numeric(s, len, out);
    }
    return parse_symbolic(s, len, umask_val, out);
}

