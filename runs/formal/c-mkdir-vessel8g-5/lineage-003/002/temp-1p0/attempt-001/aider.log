```c
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

/* ---- Mode parsing ---- */

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int parse_numeric(const char *s, size_t len, mode_t *out)
{
    if (len == 0 || len > 8) return 0;
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        if (!is_octal_digit(s[i])) return 0;
        val = (val << 3) | (unsigned)(s[i] - '0');
    }
    *out = val & 07777;
    return 1;
}

/* Symbolic mode clause parsing */

typedef enum { CLS_U, CLS_G, CLS_O, CLS_A } cls_t;
typedef enum { OP_PLUS, OP_MINUS, OP_EQ } op_t;

/* Parse a single clause like "ug+rwx", "o=", "a-s", etc. */
/* Returns 1 on success, 0 on failure. */
static int parse_clause(const char *s, size_t len,
                        unsigned *who_mask, op_t *op,
                        mode_t *perm_bits, int *has_copy, cls_t *copy_from)
{
    if (len == 0) return 0;
    
    unsigned who = 0;
    size_t pos = 0;
    
    /* Parse who */
    while (pos < len) {
        char c = s[pos];
        if (c == 'u') who |= 1;
        else if (c == 'g') who |= 2;
        else if (c == 'o') who |= 4;
        else if (c == 'a') who |= 7;
        else break;
        pos++;
    }
    
    if (who == 0) who = 7; /* default: a */
    
    /* Parse op */
    if (pos >= len) return 0;
    char opc = s[pos];
    if (opc == '+') *op = OP_PLUS;
    else if (opc == '-') *op = OP_MINUS;
    else if (opc == '=') *op = OP_EQ;
    else return 0;
    pos++;
    
    /* Parse perms */
    mode_t bits = 0;
    int copy = 0;
    cls_t from = CLS_U;
    
    if (pos >= len) {
        /* Empty perms: only valid for '=' */
        if (*op != OP_EQ) return 0;
        *who_mask = who;
        *perm_bits = 0;
        *has_copy = 0;
        return 1;
    }
    
    while (pos < len) {
        char c = s[pos];
        if (c == 'r') {
            bits |= S_IRUSR | S_IRGRP | S_IROTH;
        } else if (c == 'w') {
            bits |= S_IWUSR | S_IWGRP | S_IWOTH;
        } else if (c == 'x') {
            bits |= S_IXUSR | S_IXGRP | S_IXOTH;
        } else if (c == 'X') {
            /* X = execute for directories; since we always create dirs, same as x */
            bits |= S_IXUSR | S_IXGRP | S_IXOTH;
        } else if (c == 's') {
            bits |= S_ISUID | S_ISGID;
        } else if (c == 't') {
            bits |= S_ISVTX;
        } else if (c == 'u' || c == 'g' || c == 'o') {
            /* Permission copy */
            if (copy) return 0; /* only one copy allowed */
            copy = 1;
            from = (c == 'u') ? CLS_U : (c == 'g') ? CLS_G : CLS_O;
            /* The copy bits will be resolved at evaluation time */
            bits = 0; /* will be set later based on current mode */
        } else {
            return 0;
        }
        pos++;
    }
    
    *who_mask = who;
    *perm_bits = bits;
    *has_copy = copy;
    *copy_from = from;
    return 1;
}
```

