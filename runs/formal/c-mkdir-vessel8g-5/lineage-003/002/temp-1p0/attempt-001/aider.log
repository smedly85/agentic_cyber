static int eval_symbolic(const char *str, size_t len, mode_t umask, mode_t *result)
{
    mode_t mode = 0777; /* starting point: a=rwx */
    
    size_t pos = 0;
    while (pos < len) {
        /* Find end of this clause (next comma or end) */
        size_t start = pos;
        while (pos < len && str[pos] != ',') pos++;
        size_t clen = pos - start;
        if (pos < len) pos++; /* skip comma */
        
        if (clen == 0) return 0; /* empty clause is invalid */
        
        /* Parse clause */
        unsigned who = 0;
        op_t op;
        mode_t bits = 0;
        int has_copy = 0;
        cls_t copy_from = CLS_U;
        
        size_t p = 0;
        while (p < clen) {
            char c = str[start + p];
            if (c == 'u') who |= 1;
            else if (c == 'g') who |= 2;
            else if (c == 'o') who |= 4;
            else if (c == 'a') who |= 7;
            else break;
            p++;
        }
        if (who == 0) who = 7;
        
        if (p >= clen) return 0;
        char opc = str[start + p];
        if (opc == '+') op = OP_PLUS;
        else if (opc == '-') op = OP_MINUS;
        else if (opc == '=') op = OP_EQ;
        else return 0;
        p++;
        
        int explicit_who = 0;
        /* Check if who was explicitly specified */
        /* We need to track this separately */
        
        mode_t class_mask; /* which classes are targeted */
        if (who & 1) class_mask |= S_IRUSR | S_IWUSR | S_IXUSR | S_ISUID;
        if (who & 2) class_mask |= S_IRGRP | S_IWGRP | S_IXGRP | S_ISGID;
        if (who & 4) class_mask |= S_IROTH | S_IWOTH | S_IXOTH | S_ISVTX;
        
        /* Parse perms */
        int perm_empty = 1;
