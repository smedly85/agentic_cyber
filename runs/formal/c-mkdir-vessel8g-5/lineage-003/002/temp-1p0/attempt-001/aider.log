    int valid;
    mode_t value;
    int has_mode;  /* whether -m was specified */
} ModeSpec;

/* Parse a numeric mode string (all digits, 1-8 octal digits) */
static int parse_numeric_mode(const char *s, size_t len, mode_t *out)
{
    if (len == 0 || len > 8) return 0;
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        char c = s[i];
        if (c < '0' || c > '7') return 0;
        val = (val << 3) | (c - '0');
    }
    *out = val & 07777;
    return 1;
}
