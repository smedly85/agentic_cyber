    if (strcmp(argv[i], "-m") == 0) {
        /* -m VALUE */
        if (i + 1 >= argc) {
            fprintf(stderr, "mkdir: option requires an argument -- 'm'\n");
            return 1;
        }
        i++;
        mode_str = argv[i];
        mode_set = 1;
        continue;
    }
    if (strncmp(argv[i], "--mode=", 7) == 0) {
        /* --mode=VALUE */
        mode_str = argv[i] + 7;
        mode_set = 1;
        continue;
    }
    if (strcmp(argv[i], "--mode") == 0) {
        /* --mode VALUE */
        if (i + 1 >= argc) {
