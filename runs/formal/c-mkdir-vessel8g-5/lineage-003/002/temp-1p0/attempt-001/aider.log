```c
static long parse_clause(const char *s, size_t len, size_t i, Clause *cl) {
    memset(cl, 0, sizeof(*cl));
    cl->who = 0;
    
    // Parse who (u, g, o, a) - optional
    size_t start = i;
    while (i < len && (s[i] == 'u' || s[i] == 'g' || s[i] == 'o' || s[i] == 'a')) {
        switch (s[i]) {
            case 'u': cl->who |= WHO_U; break;
            case 'g': cl->who |= WHO_G; break;
            case 'o': cl->who |= WHO_O; break;
            case 'a': cl->who |= WHO_A; break;
        }
        i++;
    }
    if (i > start) {
        cl->who_omitted = 0;
    } else {
        cl->who_omitted = 1;
        cl->who = WHO_A;
    }
    
    // Parse operator
    if (i >= len || (s[i] != '+' && s[i] != '-' && s[i] != '=')) return -1;
    switch (s[i]) {
        case '+': cl->op = OP_ADD; break;
        case '-': cl->op = OP_REMOVE; break;
        case '=': cl->op = OP_ASSIGN; break;
    }
    i++;
    
    // Parse permissions (or empty)
    if (i >= len) {
        cl->empty = 1;
        return i; // valid empty assignment
    }
    
    while (i < len && s[i] != ',') {
        switch (s[i]) {
            case 'r': cl->perm_r = 1; break;
            case 'w': cl->perm_w = 1; break;
            case 'x': cl->perm_x = 1; break;
            case 'X': cl->perm_X = 1; break;
            case 's': cl->perm_s = 1; break;
            case 't': cl->perm_t = 1; break;
            case 'u': cl->copy_src = 1; break; // permission copy from u
            case 'g': cl->copy_src = 2; break; // permission copy from g
            case 'o': cl->copy_src = 3; break; // permission copy from o
            default: return -1; // invalid character
        }
        i++;
    }
    
    // Check for ambiguity: if we have both explicit perms and copy, it's an error
    // Actually in GNU, you can't mix them in the same clause
    int has_explicit = cl->perm_r || cl->perm_w || cl->perm_x || cl->perm_X || cl->perm_s || cl->perm_t;
    if (has_explicit && cl->copy_src) return -1;
    if (cl->copy_src && cl->empty) return -1;
    
    return i;
}
```

