/* --- Mode parsing --- */

/* Parse a numeric mode: all digits, octal, 0000-7777 */
static int parse_numeric(const char *s, size_t len, mode_t *out) {
    if (len == 0 || len > 8) return 0; // too long for 7777
    unsigned long val = 0;
    for (size_t i = 0; i < len; i++) {
        if (s[i] < '0' || s[i] > '7') return 0;
        val = val * 8 + (unsigned)(s[i] - '0');
    }
    if (val > 07777) return 0;
    *out = (mode_t)val;
    return 1;
}

/* Determine if a string is a valid numeric mode */
static int is_numeric_mode(const char *s, size_t len) {
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++) {
