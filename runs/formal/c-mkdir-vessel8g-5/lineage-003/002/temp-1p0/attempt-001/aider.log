/* ==================== Mode parsing ==================== */

#define WHO_U 1u
#define WHO_G 2u
#define WHO_O 4u
#define WHO_A 7u

typedef enum { OP_ADD, OP_REMOVE, OP_ASSIGN } Op;

typedef struct {
    unsigned who;
    int who_omitted;
    Op op;
    int perm_r, perm_w, perm_x;
    int perm_s, perm_t;
    int copy_src;   /* 0=none, 1=u, 2=g, 3=o */
    int empty;
} Clause;

static int is_numeric_str(const char *s, size_t len)
{
    if (len == 0) return 0;
    for (size_t i = 0; i < len; i++)
        if (s[i] < '0' || s[i] > '7') return 0;
    return 1;
}

