```c
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

/* ---- Symbolic mode evaluation ---- */

static mode_t get_process_umask(void)
{
    mode_t um = umask(0);
    umask(um);
    return um;
}

static int is_octal_digit(char c) { return c >= '0' && c <= '7'; }

static int try_parse_numeric(const char *s, size_t len, mode_t *out)
{
    if (len == 0 || len > 8) return 0;
    mode_t val = 0;
    for (size_t i = 0; i < len; i++) {
        if (!is_octal_digit(s[i])) return 0;
        val = (val << 3) | (unsigned)(s[i] - '0');
    }
    *out = val & 07777;
    return 1;
}

static int eval_symbolic(const char *s, size_t len, mode_t umask, mode_t *result)
{
    if (len == 0) return 0;
    mode_t mode = 0777;
    size_t pos = 0;
    
    while (pos < len) {
        size_t start = pos;
        while (pos < len && s[pos] != ',') pos++;
        size_t clen = pos - start;
        if (pos < len) pos++;
        
        if (clen == 0) return 0;
        
        /* Parse who */
        unsigned who = 0;
        int explicit_who = 0;
        size_t p = 0;
        while (p < clen) {
            char c = s[start + p];
            if (c == 'u') { who |= 1; explicit_who = 1; }
            else if (c == 'g') { who |= 2; explicit_who = 1; }
            else if (c == 'o') { who |= 4; explicit_who = 1; }
            else if (c == 'a') { who |= 7; explicit_who = 1; }
            else break;
            p++;
        }
        if (who == 0) who = 7;
        
        /* Parse op */
        if (p >= clen) return 0;
        char opc = s[start + p];
        int op; /* 0=+, 1=-, 2== */
        if (opc == '+') op = 0;
        else if (opc == '-') op = 1;
        else if (opc == '=') op = 2;
        else return 0;
        p++;
        
        /* Parse perms */
        mode_t bits = 0;
        int has_copy = 0;
        int copy_from = -1; /* 0=u, 1=g, 2=o */
        int perm_empty = 1;
        
        while (p < clen) {
            char c = s[start + p];
            if (c == 'r') bits |= S_IRUSR | S_IRGRP | S_IROTH;
            else if (c == 'w') bits |= S_IWUSR | S_IWGRP | S_IWOTH;
            else if (c == 'x' || c == 'X') bits |= S_IXUSR | S_IXGRP | S_IXOTH;
            else if (c == 's') bits |= S_ISUID | S_ISGID;
            else if (c == 't') bits |= S_ISVTX;
            else if (c == 'u' || c == 'g' || c == 'o') {
                if (has_copy) return 0;
                has_copy = 1;
                copy_from = (c == 'u') ? 0 : (c == 'g') ? 1 : 2;
                bits = 0; /* will resolve from current mode */
            }
            else return 0;
            perm_empty = 0;
            p++;
        }
        
        if (perm_empty && op != 2) return 0;
        
        /* Resolve copy bits from current mode */
        if (has_copy) {
            mode_t src;
            if (copy_from == 0) src = mode & (S_IRUSR | S_IWUSR | S_IXUSR);
            else if (copy_from == 1) src = mode & (S_IRGRP | S_IWGRP | S_IXGRP);
            else src = mode & (S_IROTH | S_IWOTH | S_IXOTH);
            /* Copy to target classes */
            bits = 0;
            if (who & 1) bits |= (src & 00700) >> 3; /* map to u position... */
            /* Actually, copy means: the target classes get the source's rwx */
            /* Let me think about this differently */
        }
        
        /* Apply operation */
        /* ... */
    }
    
    *result = mode & 07777;
    return 1;
}
```

