```c
static void apply_clause(mode_t *mode, const Clause *cl, mode_t umask_val, int *had_ordinary) {
    mode_t m = *mode;
    
    // Determine effective who
    unsigned who = cl->who;
    if (cl->who_omitted) who = WHO_A;
    
    // Handle permission copy
    if (cl->copy_src) {
        // Get source class's ordinary permissions
        mode_t src_perms;
        switch (cl->copy_src) {
            case 1: src_perms = m & 0700; break; // u
            case 2: src_perms = (m & 0070) | ((m & 0070) >> 3) | ((m & 0070) << 3); break; // g → replicate to all
            case 3: src_perms = m & 0007; break; // o
        }
        // Actually, for copy, we need to apply the source's perms to the target classes
        // u+g: u gets g's perms added
        // The source perms are the 3 bits for that class
        
        mode_t src;
        switch (cl->copy_src) {
            case 1: src = (m >> 6) & 7; break; // u's 3 bits
            case 2: src = (m >> 3) & 7; break; // g's 3 bits
            case 3: src = m & 7; break; // o's 3 bits
        }
        
        // Apply to target classes
        // For each target class, apply the operation with the source's 3-bit value
        unsigned target_classes = who;
        
        for (unsigned bit = 0; bit < 3; bit++) {
            unsigned class_bit = 1u << bit; // 1=u, 2=g, 4=o
            if (!(target_classes & class_bit)) continue;
            int shift = (2 - bit) * 3; // u=18, g=15... wait no
            
            // u bits are at positions 9-11 (0700), g at 6-8 (0070), o at 3-5 (0007)
            // shift for u = 6, for g = 3, for o = 0
        }
        
        // This is getting complicated. Let me use a different approach.
        
        // For each target class:
        int shifts[3] = {6, 3, 0}; // u, g, o
        for (int c = 0; c < 3; c++) {
            unsigned class_mask = 1u << c; // WHO_U, WHO_G, WHO_O
            if (!(who & class_mask)) continue;
            int shift = shifts[c];
            mode_t class_mask_bits = (mode_t)7 << shift;
            
            switch (cl->op) {
                case OP_ADD:
                    m |= (src << shift);
                    break;
                case OP_REMOVE:
                    m &= ~(src << shift);
                    break;
                case OP_ASSIGN:
                    m = (m & ~class_mask_bits) | (src << shift);
                    break;
            }
        }
        *had_ordinary = 1;
        *mode = m;
        return;
    }
    
    // Handle explicit permissions
    mode_t perms = 0;
    if (cl->perm_r) perms |= 0444;
    if (cl->perm_w) perms |= 0222;
    if (cl->perm_x) perms |= 0111;
    if (cl->perm_X) perms |= 0111; // X = x for directories
    
    // Special bits
    mode_t special = 0;
    if (cl->perm_s) {
        if (who & WHO_U) special |= MODE_SETUID;
        if (who & WHO_G) special |= MODE_SETGID;
    }
    if (cl->perm_t) {
        special |= MODE_STICKY;
    }
    
    // Determine which classes are affected by ordinary perms
    unsigned ordinary_who = who; // all target classes get ordinary perms
    
    // Apply umask filtering for omitted who
    int umask_filter = cl->who_omitted;
    
    // For each class, apply the operation
    int shifts[3] = {6, 3, 0}; // u, g, o
    for (int c = 0; c < 3; c++) {
        unsigned class_bit = 1u << c;
        if (!(ordinary_who & class_bit)) continue;
        int shift = shifts[c];
        mode_t class_mask = (mode_t)7 << shift;
        mode_t class_perms = perms & class_mask;
        
        if (umask_filter) {
            mode_t umask_class = umask_val & class_mask;
            switch (cl->op) {
                case OP_ADD:
                    // Only add bits not in umask
                    m |= (class_perms & ~umask_class);
                    break;
                case OP_REMOVE:
                    // Only remove bits not in umask
                    m &= ~(class_perms & ~umask_class);
                    break;
                case OP_ASSIGN:
                    // Set to (class_perms & ~umask_class), clearing others in this class
                    m = (m & ~class_mask) | (class_perms & ~umask_class);
                    break;
            }
        } else {
            switch (cl->op) {
                case OP_ADD:
                    m |= class_perms;
                    break;
                case OP_REMOVE:
                    m &= ~class_perms;
                    break;
                case OP_ASSIGN:
                    m = (m & ~class_mask) | class_perms;
                    break;
            }
        }
    }
    
    // Apply special bits
    switch (cl->op) {
        case OP_ADD:
            m |= special;
            break;
        case OP_REMOVE:
            m &= ~special;
            break;
        case OP_ASSIGN:
            // For =, special bits are preserved unless explicitly addressed
            // If the clause has s or t, they are explicitly addressed
            if (cl->perm_s) {
                // s was explicitly addressed: set the specified ones, clear the others
                // But only for the classes in who
                if (who & WHO_U) {
