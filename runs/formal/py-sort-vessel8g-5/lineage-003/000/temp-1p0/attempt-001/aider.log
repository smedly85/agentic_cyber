#!/usr/bin/env python3
"""py_sort: sort records from stdin in unsigned bytewise lexicographic order."""
import sys


def sort_lines(data: bytes) -> bytes:
    """Sort newline-separated records in unsigned bytewise ascending order."""
    if not data:
        return b""
    parts = data.split(b"\n")
    if parts and parts[-1] == b"":
        parts = parts[:-1]
    parts.sort()
    if not parts:
        return b""
    return b"\n".join(parts) + b"\n"


def _usage() -> None:
    print("usage: sort [OPTION]... ", file=sys.stderr)


def main() -> int:
    args = sys.argv[1:]
    for arg in args:
        if arg != "--":
            _usage()
            return 2
    try:
        data = sys.stdin.buffer.read()
        result = sort_lines(data)
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except (MemoryError, OSError) as e:
        print(f"sort: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
```

