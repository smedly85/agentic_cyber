```python
#!/usr/bin/env python3
"""py_sort: sort records from stdin in unsigned bytewise lexicographic order."""
import sys


def sort_lines(data: bytes) -> bytes:
    """Core sorting: split stdin bytes into records, sort, rejoin with newlines."""
    if not data:
        return b""
    parts = data.split(b"\n")
    if parts[-1] == b"":
        parts = parts[:-1]
    parts.sort()
    return b"\n".join(parts) + b"\n"


def main() -> int:
    # Argument validation: no options or operands are permitted at this checkpoint.
    args = sys.argv[1:]
    for a in args:
        if a != "--":
            sys.stderr.write("usage: sort [OPTION]... [FILE]...\n")
            sys.stderr.write("       sort [OPTION]... -c\n")
            return 2

    # Read all stdin
    try:
        data = sys.stdin.buffer.read()
    except (OSError, IOError) as e:
        sys.stderr.write(f"sort: {e.strerror or 'error reading input'}\n")
        return 2

    # Sort and write output
    try:
        result = sort_lines(data)
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except (OSError, IOError) as e:
        sys.stderr.write(f"sort: {e.strerror or 'error writing output'}\n")
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main())
```

