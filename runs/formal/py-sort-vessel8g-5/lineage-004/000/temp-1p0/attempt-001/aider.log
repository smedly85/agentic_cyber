```python
#!/usr/bin/env python3
"""py_sort — sort records read from stdin in unsigned bytewise lexicographic order.

Checkpoint 000: base sort, no options, no file operands.
"""
import sys


def sort_lines(data: bytes) -> bytes:
    """Split stdin bytes into newline-delimited records, sort them in
    unsigned bytewise lexicographic order, and rejoin with trailing newline.

    - Empty input → empty output.
    - A trailing newline in input does not create an extra empty record.
    - A final nonempty unterminated record is still a record.
    - Duplicates are preserved.
    - Record contents are never modified.
    """
    if not data:
        return b""
    parts = data.split(b"\n")
    if parts[-1] == b"":
        parts = parts[:-1]
    parts.sort()
    return b"\n".join(parts) + b"\n"


def _usage() -> bytes:
    return b"sort: unrecognized operand or option\nTry 'sort --help' for more information.\n"


def main() -> int:
    # --- argument validation ---
    # At this checkpoint no options are implemented. The only recognized
    # token is "--" (end-of-options marker). Any other token is either an
    # unknown option or an operand and must be rejected.
    for arg in sys.argv[1:]:
        if arg != "--":
            sys.stderr.buffer.write(_usage())
            sys.stderr.buffer.flush()
            return 2

    # --- read all of stdin as bytes ---
    try:
        data = sys.stdin.buffer.read()
    except (OSError, ValueError):
        sys.stderr.buffer.write(b"sort: error reading input\n")
        sys.stderr.buffer.flush()
        return 2

    # --- sort ---
    try:
        result = sort_lines(data)
    except Exception:
        sys.stderr.buffer.write(b"sort: internal error\n")
        sys.stderr.buffer.flush()
        return 2

    # --- write output ---
    try:
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except (OSError, ValueError):
        sys.stderr.buffer.write(b"sort: error writing output\n")
        sys.stderr.buffer.flush()
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main())
```

### Key design decisions

| Concern | Decision |
|---|---|
| **Record splitting** | `data.split(b"\n")`; drop the last element only if it is `b""` (i.e. input ended with a newline). Empty input → zero records. |
| **Sort order** | Python's default `bytes` comparison is unsigned bytewise lexicographic — exactly LC_ALL=C order. No locale involvement. |
| **Output format** | `b"\n".join(records) + b"\n"` — every record is followed by a newline; empty record list → empty output. |
| **`sort_lines` anchor** | Exposed as a module-level function; `main` calls it directly. |
| **Argument handling** | Loop over `sys.argv[1:]`; `--` is the only accepted token. Anything else → usage on stderr, exit 2. |
| **No subprocesses** | Pure in-process byte manipulation; no `subprocess`, `os.system`, `ctypes`, or shell invocation. |
| **Error safety** | All I/O wrapped in try/except for `OSError`/`ValueError`; no uncaught tracebacks. |
| **Stderr on success** | Nothing is written to stderr on the happy path. |
