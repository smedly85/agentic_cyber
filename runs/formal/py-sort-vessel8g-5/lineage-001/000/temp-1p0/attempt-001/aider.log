#!/usr/bin/env python3
"""py_sort - checkpoint 000: basic byte-wise lexicographic sort of stdin records."""

import sys


def _usage() -> str:
    return "usage: sort [OPTION]... [FILE]...\nTry 'sort --help' for more information.\n"


def _parse_args(argv: list[str]) -> None:
    """Validate arguments. This checkpoint supports no options.
    Raises SystemExit(2) on any unknown option or operand."""
    i = 0
    seen_ddash = False
    while i < len(argv):
        arg = argv[i]
        if seen_ddash:
            # Anything after -- is an operand
            _fail_operand(arg)
        if arg == "--":
            seen_ddash = True
        elif arg.startswith("-") and len(arg) > 1:
            # Unknown option
            _fail_option(arg)
        else:
            # Operand (includes bare "-")
            _fail_operand(arg)
        i += 1


def _fail_option(arg: str) -> None:
    sys.stderr.write(f"sort: unknown option '{arg}'\n")
    sys.stderr.write(_usage())
    sys.exit(2)


def _fail_operand(arg: str) -> None:
    sys.stderr.write(f"sort: extra operand '{arg}'\n")
    sys.stderr.write(_usage())
    sys.exit(2)


def sort_lines(data: bytes) -> bytes:
    """Core sorting: split records on newline, sort bytewise, rejoin with newlines.
    
    Returns the sorted output as bytes.
    """
    if not data:
        return b""
    
    # Split into records: split on b"\n"
    # If the data ends with b"\n", the last element from split will be b"" which
    # we should NOT include as a record.
    # If it doesn't end with b"\n", the last element IS a record.
    
    # Using split: b"abc\n".split(b"\n") -> [b"abc", b""]
    #              b"abc".split(b"\n") -> [b"abc"]
    #              b"\n".split(b"\n") -> [b"", b""]
    #              b"\n\n".split(b"\n") -> [b"", b"", b""]
    
    # So: if data ends with \n, drop the last empty element.
    #     If data doesn't end with \n, keep all elements.
    
    records = data.split(b"\n")
    if records and data.endswith(b"\n"):
        records = records[:-1]
    
    records.sort()
    return b"".join(r + b"\n" for r in records)


def main() -> None:
    # Parse args (argv[1:])
    _parse_args(sys.argv[1:])
    
    # Read stdin as bytes
    try:
        data = sys.stdin.buffer.read()
    except (OSError, MemoryError) as e:
        sys.stderr.write(f"sort: error reading input: {e}\n")
        sys.exit(2)
    
    # Sort
    try:
        result = sort_lines(data)
    except (MemoryError, OSError) as e:
        sys.stderr.write(f"sort: error: {e}\n")
        sys.exit(2)
    
    # Write output
    try:
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except (OSError, MemoryError) as e:
        sys.stderr.write(f"sort: error writing output: {e}\n")
        sys.exit(2)


if __name__ == "__main__":
    main()
```

