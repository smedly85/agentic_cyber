```python
#!/usr/bin/env python3
"""py_sort checkpoint 000: sort stdin records bytewise (C locale)."""

import sys


def _usage() -> str:
    return "usage: sort [OPTION]...\n\n       Sort lines of FILEs, or standard input, using the following "
           "comparison\n       keys.  With no options, use the entire line as the key.\n"


def _die_option(arg: str) -> None:
    sys.stderr.write(f"sort: invalid option -- '{arg[1]}'\n")
    sys.stderr.write(_usage())
    raise SystemExit(2)


def _die_operand(arg: str) -> None:
    sys.stderr.write(f"sort: extra operand '{arg}'\n")
    sys.stderr.write(_usage())
    raise SystemExit(2)


def _parse_args(argv: list) -> None:
    """Validate command-line arguments.

    This checkpoint supports no options.  Any option-like token is an
    unknown option; any positional token is a disallowed operand.
    '--' is recognised as the end-of-options marker but does not permit
    operands that follow it.
    """
    after_ddash = False
    for arg in argv:
        if after_ddash:
            _die_operand(arg)
        if arg == "--":
            after_ddash = True
        elif len(arg) > 1 and arg[0] == "-":
            _die_option(arg)
        else:
            # Includes bare "-" and any bareword (file operand)
            _die_operand(arg)


def sort_lines(data: bytes) -> bytes:
    """Split *data* into newline-delimited records, sort bytewise ascending,
    and return the sorted bytes with each record terminated by newline.

    This is the core semantic anchor for the checkpoint's sorting behaviour.
    """
    if not data:
        return b""

    records = data.split(b"\n")
    # When the input ends with a newline, split produces a trailing
    # empty string that is NOT a record.
    if data.endswith(b"\n"):
        records = records[:-1]

    # Unsigned bytewise lexicographic ascending == C-locale sort.
    # Python's bytes comparison is exactly unsigned bytewise.
    records.sort()

    out = bytearray()
    for r in records:
        out.extend(r)
        out.append(0x0A)
    return bytes(out)


def main() -> None:
    _parse_args(sys.argv[1:])

    try:
        data = sys.stdin.buffer.read()
    except (OSError, MemoryError) as exc:
        sys.stderr.write(f"sort: error reading input: {exc}\n")
        raise SystemExit(2)

    try:
        result = sort_lines(data)
    except (OSError, MemoryError) as exc:
        sys.stderr.write(f"sort: error: {exc}\n")
        raise SystemExit(2)

    try:
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except (OSError, MemoryError) as exc:
        sys.stderr.write(f"sort: error writing output: {exc}\n")
        raise SystemExit(2)


if __name__ == "__main__":
    main()
```

