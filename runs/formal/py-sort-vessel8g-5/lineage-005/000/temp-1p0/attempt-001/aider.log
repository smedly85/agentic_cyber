```python
#!/usr/bin/env python3
"""py_sort - sort records from stdin in bytewise lexicographic order."""

import sys


def sort_lines(data: bytes) -> bytes:
    """Sort newline-separated byte records in unsigned bytewise lexicographic ascending order.
    
    Records may be empty, contain NUL bytes, or be any arbitrary byte sequence.
    A final nonempty unterminated record is treated as a record.
    Empty input produces empty output.
    Each output record is followed by a newline.
    """
    if not data:
        return b""
    
    records = data.split(b"\n")
    if data.endswith(b"\n"):
        records = records[:-1]
    
    records.sort()
    
    if not records:
        return b""
    
    return b"\n".join(records) + b"\n"


def main() -> int:
    args = sys.argv[1:]
    
    past_options = False
    for arg in args:
        if not past_options and arg == "--":
            past_options = True
            continue
        # At this point, arg is either an unknown option or an operand.
        # Both are errors.
        sys.stderr.write("usage: sort [OPTION...]\n")
        return 2
    
    try:
        data = sys.stdin.buffer.read()
    except (OSError, MemoryError) as e:
        sys.stderr.write(f"sort: error reading input: {e}\n")
        return 2
    
    try:
        result = sort_lines(data)
    except MemoryError:
        sys.stderr.write("sort: out of memory\n")
        return 2
    
    try:
        out = sys.stdout.buffer
        out.write(result)
        out.flush()
    except (OSError, BrokenPipeError) as e:
        sys.stderr.write(f"sort: error writing output: {e}\n")
        try:
            # Close stdout to avoid further errors in atexit
            sys.stdout.close()
        except Exception:
            pass
        return 2
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
```

