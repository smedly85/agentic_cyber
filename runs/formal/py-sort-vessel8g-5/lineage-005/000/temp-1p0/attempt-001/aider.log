#!/usr/bin/env python3
import sys
import os

def sort_lines(data: bytes) -> bytes:
    """Sort newline-separated byte records in unsigned bytewise lexicographic order."""
    if not data:
        return b""
    # Split into records. A record is everything between newlines.
    # "Empty input produces empty output."
    # "A final nonempty unterminated record is still a record."
    # "Emit every output record followed by newline."
    # "Records are arbitrary byte strings separated by newline, including empty records"
    
    # Split by b"\n"
    records = data.split(b"\n")
    # If data ends with \n, the last element is b"" (the empty string after the final newline)
    # We should NOT include that trailing empty record.
    # But if data is b"a\n", split gives [b"a", b""] - we want just [b"a"]
    # If data is b"a\n\n", split gives [b"a", b"", b""] - we want [b"a", b""] (two records: "a" and empty)
    # If data is b"\n", split gives [b"", b""] - we want [b""] (one empty record)
    # If data is b"a" (no trailing newline), split gives [b"a"] - we want [b"a"]
    
    # So: if data ends with b"\n", drop the last empty element from split
    if data.endswith(b"\n"):
        records = records[:-1]
    
    # Sort in unsigned bytewise lexicographic order
    records.sort()  # Python bytes comparison is unsigned bytewise lexicographic
    
    # Join back with newlines, each record followed by newline
    return b"\n".join(records) + b"\n" if records else b""

def main() -> int:
    # Parse arguments
    args = sys.argv[1:]
    
    # Process arguments:
    # - `--` ends option parsing (but doesn't permit operands)
    # - Unknown options → error
    # - Any operands → error
    
