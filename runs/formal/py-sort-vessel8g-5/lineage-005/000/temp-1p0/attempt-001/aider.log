    for arg in args:
        if arg == "--" and not seen_double_dash:
            seen_double_dash = True
            continue
        # At this point, any argument is either:
        # - An unknown option (starts with -)
        # - An operand
        # Both are errors
        # Write usage to stderr, exit 2
        sys.stderr.write(f"usage: sort\n")  # or similar
        return 2
    
    # Read all of stdin
    try:
        data = sys.stdin.buffer.read()
    except Exception as e:
        sys.stderr.write(f"sort: {e}\n")
        return 2
    
    # Sort
    result = sort_lines(data)
    
    # Write output
    try:
        sys.stdout.buffer.write(result)
        sys.stdout.buffer.flush()
    except Exception as e:
        sys.stderr.write(f"sort: {e}\n")
        return 2
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
```

