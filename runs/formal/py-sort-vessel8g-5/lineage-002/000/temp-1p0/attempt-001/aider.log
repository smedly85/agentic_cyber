```python
#!/usr/bin/env python3
"""py_sort — sort records from standard input in LC_ALL=C bytewise order."""

import sys


def sort_lines(data: bytes) -> bytes:
    """Sort newline-delimited byte records in unsigned lexicographic order.

    Splits *data* on 0x0A, sorts the resulting records (preserving
    duplicates), and re-joins them each terminated by 0x0A.
    Empty input yields empty output.
    """
    if not data:
        return b""
    parts = data.split(b"\n")
    if data.endswith(b"\n"):
        records = parts[:-1]  # drop trailing empty
    else:
        records = parts       # last part is an unterminated record
    records.sort()
    if not records:
        return b""
    return b"\n".join(records) + b"\n"


def _usage() -> None:
    msg = (
        "usage: py_sort [--]\n"
        "Sort newline-delimited records from stdin in LC_ALL=C order.\n"
        "This checkpoint accepts no options or file operands.\n"
    )
    try:
        sys.stderr.write(msg)
        sys.stderr.flush()
    except (OSError, ValueError):
        pass


def main() -> int:
    args = sys.argv[1:]

    # Argument validation: no options or operands are supported.
    for i, arg in enumerate(args):
        if arg == "--":
            # -- ends option parsing; anything after is an operand.
            if i + 1 < len(args):
                _usage()
                return 2
            break
        if arg.startswith("-"):
            _usage()
            return 2
        # bare operand
        _usage()
        return 2

    # Read all stdin bytes.
    try:
        data = sys.stdin.buffer.read()
    except (OSError, MemoryError):
        _usage()
        return 2

    # Sort and emit.
    try:
        out = sort_lines(data)
        sys.stdout.buffer.write(out)
        sys.stdout.buffer.flush()
    except (OSError, MemoryError):
        return 2

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BaseException:
        # Catch-all: never emit a traceback.
        try:
            sys.stderr.write("py_sort: internal error\n")
            sys.stderr.flush()
        except (OSError, ValueError):
            pass
        sys.exit(2)
```

