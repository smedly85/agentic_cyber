```python
#!/usr/bin/env python3
"""py_sort - sort records from stdin in LC_ALL=C bytewise order."""

import sys


def sort_lines(data: bytes) -> bytes:
    """Sort newline-separated records in unsigned bytewise lexicographic order.
    
    Returns the sorted output as bytes, with each record followed by newline.
    """
    if not data:
        return b""
    
    # Split into records by newline
    # If the data ends with \n, the last split element is b"" which is not a record
    # If the data doesn't end with \n, the last split element is the unterminated record
    parts = data.split(b"\n")
    
    # If data ends with newline, the last element is empty and not a record
    if data.endswith(b"\n"):
        records = parts[:-1]
    else:
        records = parts
    
    # Sort in unsigned bytewise lexicographic order
    records.sort()
    
    # Join with newline, each record followed by newline
    if not records:
        return b""
    
    return b"\n".join(records) + b"\n"


def main() -> int:
    args = sys.argv[1:]
    
    # Parse arguments
    # No options are implemented at this checkpoint
    # -- ends option parsing but does not permit operands
    # Unknown options or any operands produce error
    
    for arg in args:
        if arg == "--":
            # Bare -- is OK, but any subsequent arg is an operand
            # We need to check if there are more args after --
            idx = args.index("--")
            remaining = args[idx+1:]
            if remaining:
                _usage_error()
                return 2
            break
        elif arg.startswith("-"):
            # Unknown option
            _usage_error()
            return 2
        else:
            # Operand
            _usage_error()
            return 2
    
    # Read all of stdin
    try:
        data = sys.stdin.buffer.read()
    except (OSError, MemoryError):
        _usage_error()
        return 2
    
    try:
        output = sort_lines(data)
        sys.stdout.buffer.write(output)
        sys.stdout.buffer.flush()
    except (OSError, MemoryError):
        return 2
    
    return 0


def _usage_error() -> None:
    sys.stderr.write("usage: py_sort [OPTION]...\n")
    sys.stderr.write("Sort records from stdin in LC_ALL=C bytewise order.\n")
    sys.stderr.write("No options or file operands are supported.\n")
    sys.stderr.flush()


if __name__ == "__main__":
    sys.exit(main())
```

