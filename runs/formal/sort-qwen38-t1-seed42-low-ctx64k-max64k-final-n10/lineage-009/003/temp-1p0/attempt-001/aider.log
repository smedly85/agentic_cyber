```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char *data;
    size_t len;
    size_t input_idx;
} Line;

static int use_reverse = 0;
static int use_fold = 0;
static int use_unique = 0;

static int fold_char(unsigned char c) {
    if (c >= 'A' && c <= 'Z') return c + ('a' - 'A');
    return c;
}

static int cmp_bytes(const unsigned char *a, size_t la,
                     const unsigned char *b, size_t lb) {
    size_t min = la < lb ? la : lb;
    if (min > 0) {
        int r = memcmp(a, b, min);
        if (r != 0) return r;
    }
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

static int cmp_fold(const unsigned char *a, size_t la,
                    const unsigned char *b, size_t lb) {
    size_t min = la < lb ? la : lb;
    for (size_t i = 0; i < min; i++) {
        unsigned char ca = fold_char(a[i]);
        unsigned char cb = fold_char(b[i]);
        if (ca != cb) return (int)ca - (int)cb;
    }
    if (la != lb) return (la < lb) ? -1 : 1;
    // Folded values are identical; use original bytes as deterministic secondary
    return cmp_bytes(a, la, b, lb);
}

static int folded_equal(const unsigned char *a, size_t la,
                        const unsigned char *b, size_t lb) {
    if (la != lb) return 0;
    for (size_t i = 0; i < la; i++) {
        if (fold_char(a[i]) != fold_char(b[i])) return 0;
    }
    return 1;
}

static int lines_equal(Line *a, Line *b) {
    if (use_fold) return folded_equal(a->data, a->len, b->data, b->len);
    if (a->len != b->len) return 0;
    return memcmp(a->data, b->data, a->len) == 0;
}

static int line_cmp(void *pa, void *pb) {
    Line *a = (Line *)pa;
    Line *b = (Line *)pb;
    int r;
    if (use_fold)
        r = cmp_fold(a->data, a->len, b->data, b->len);
    else
        r = cmp_bytes(a->data, a->len, b->data, b->len);
    if (use_reverse) r = -r;
    return r;
}
