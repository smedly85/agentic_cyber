```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char *data;
    size_t len;
    size_t input_idx;
} Line;

static int use_reverse = 0;
static int use_fold = 0;
static int use_unique = 0;

static unsigned char fold_char(unsigned char c) {
    if (c >= 'A' && c <= 'Z') return c + ('a' - 'A');
    return c;
}

static int cmp_bytes(const unsigned char *a, size_t la,
                     const unsigned char *b, size_t lb) {
    size_t min = la < lb ? la : lb;
    if (min > 0) {
        int r = memcmp(a, b, min);
        if (r != 0) return r;
    }
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

static int cmp_fold(const unsigned char *a, size_t la,
                    const unsigned char *b, size_t lb) {
    size_t min = la < lb ? la : lb;
    for (size_t i = 0; i < min; i++) {
        unsigned char ca = fold_char(a[i]);
        unsigned char cb = fold_char(b[i]);
        if (ca != cb) return (int)ca - (int)cb;
    }
    if (la != lb) return (la < lb) ? -1 : 1;
    return cmp_bytes(a, la, b, lb);
}

static int folded_equal(const unsigned char *a, size_t la,
                        const unsigned char *b, size_t lb) {
    if (la != lb) return 0;
    for (size_t i = 0; i < la; i++) {
        if (fold_char(a[i]) != fold_char(b[i])) return 0;
    }
    return 1;
}

static int lines_equal(Line *a, Line *b) {
    if (use_fold) return folded_equal(a->data, a->len, b->data, b->len);
    if (a->len != b->len) return 0;
    return memcmp(a->data, b->data, a->len) == 0;
}

static int line_cmp(void *pa, void *pb) {
    Line *a = (Line *)pa;
    Line *b = (Line *)pb;
    int r;
    if (use_fold)
        r = cmp_fold(a->data, a->len, b->data, b->len);
    else
        r = cmp_bytes(a->data, a->len, b->data, b->len);
    if (use_reverse) r = -r;
    return r;
}

static void usage(void) {
    fprintf(stderr, "usage: new_sort [-r] [-f] [-u]\n");
}

int main(void) {
    // Parse arguments
    int i;
    for (i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (arg[0] != '-' || arg[1] == '\0') {
            // Not an option (operand) or just "-"
            usage();
            return 2;
        }
        if (arg[1] == '-') {
            // Long option
            if (strcmp(arg, "--reverse") == 0) {
                use_reverse = 1;
            } else if (strcmp(arg, "--ignore-case") == 0) {
                use_fold = 1;
            } else if (strcmp(arg, "--unique") == 0) {
                use_unique = 1;
            } else {
                usage();
                return 2;
            }
        } else {
            // Short option(s)
            for (const char *p = arg + 1; *p; p++) {
                switch (*p) {
                case 'r': use_reverse = 1; break;
                case 'f': use_fold = 1; break;
                case 'u': use_unique = 1; break;
                default:
                    usage();
                    return 2;
                }
            }
        }
    }
    
    // Read all lines from stdin
    Line *lines = NULL;
    size_t count = 0, cap = 0;
    
    for (;;) {
        int c;
        unsigned char *buf = NULL;
        size_t len = 0, bcap = 0;
        int got_newline = 0;
        
        while ((c = fgetc(stdin)) != EOF) {
            if (c == '\n') { got_newline = 1; break; }
            if (len == bcap) {
                bcap = bcap ? bcap * 2 : 256;
                unsigned char *nb = realloc(buf, bcap);
                if (!nb) { free(buf); return 1; }
                buf = nb;
            }
            buf[len++] = (unsigned char)c;
        }
        
        if (len == 0 && c == EOF) {
            free(buf);
            break;
        }
        
        if (count == cap) {
            cap = cap ? cap * 2 : 256;
            Line *nl = realloc(lines, cap * sizeof(Line));
            if (!nl) { free(buf); free(lines); return 1; }
            lines = nl;
        }
        lines[count].data = buf;
        lines[count].len = len;
        lines[count].input_idx = count;
        count++;
        
        (void)got_newline;
    }
    
    // Sort
    if (count > 1) {
        qsort(lines, count, sizeof(Line), line_cmp);
    }
    
    // Deduplicate if -u
    if (use_unique && count > 0) {
        size_t out = 0;
        size_t i = 0;
        while (i < count) {
            size_t j = i;
            Line best = lines[i];
            while (j < count && lines_equal(&lines[i], &lines[j])) {
                if (lines[j].input_idx < best.input_idx) {
                    best = lines[j];
                }
                j++;
            }
            lines[out++] = best;
            i = j;
        }
        count = out;
    }
    
    // Output
    for (size_t i = 0; i < count; i++) {
        fwrite(lines[i].data, 1, lines[i].len, stdout);
        fputc('\n', stdout);
    }
    
    // Cleanup
    for (size_t i = 0; i < count; i++) {
        free(lines[i].data);
    }
    free(lines);
    
    return 0;
}
