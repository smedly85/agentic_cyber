```c
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

struct line {
    unsigned char *data;
    size_t len;
};

static int compare_lines(const void *a, const void *b) {
    const struct line *la = *(const struct line *const *)a;
    const struct line *lb = *(const struct line *const *)b;
    size_t minlen = la->len < lb->len ? la->len : lb->len;
    int cmp = memcmp(la->data, lb->data, minlen);
    if (cmp != 0) return cmp;
    if (la->len < lb->len) return -1;
    if (la->len > lb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc != 1) {
        fprintf(stderr, "usage: new_sort\n");
        return 2;
    }
    
    // Dynamic line collection
    struct line **lines = NULL;
    size_t line_count = 0;
    size_t line_cap = 0;
    
    // Current line buffer
    unsigned char *line_buf = NULL;
    size_t line_len = 0;
    size_t line_cap_bytes = 0;
    
    // Read chunk buffer
    enum { CHUNK = 8192 };
    unsigned char *chunk = malloc(CHUNK);
    if (!chunk) {
        fprintf(stderr, "new_sort: out of memory\n");
        return 1;
    }
    
    int eof = 0;
    while (!eof) {
        size_t n = fread(chunk, 1, CHUNK, stdin);
        if (n == 0) {
            if (ferror(stdin)) {
                fprintf(stderr, "new_sort: read error\n");
                goto fail;
            }
            eof = 1;
            break;
        }
        for (size_t i = 0; i < n; i++) {
            if (chunk[i] == '\n') {
                // Finalize current line
                if (line_len > 0 || line_buf != NULL) {
                    // Store the line
                    if (line_count >= line_cap) {
                        size_t new_cap = line_cap ? line_cap * 2 : 64;
                        struct line **new_lines = realloc(lines, new_cap * sizeof(*new_lines));
                        if (!new_lines) {
                            fprintf(stderr, "new_sort: out of memory\n");
                            goto fail;
                        }
                        lines = new_lines;
                        line_cap = new_cap;
                    }
                    struct line *l = malloc(sizeof(*l));
                    if (!l) {
                        fprintf(stderr, "new_sort: out of memory\n");
                        goto fail;
                    }
                    if (line_len == 0) {
                        l->data = NULL;
                        l->len = 0;
                    } else {
                        l->data = malloc(line_len);
                        if (!l->data) {
                            free(l);
                            fprintf(stderr, "new_sort: out of memory\n");
                            goto fail;
                        }
                        memcpy(l->data, line_buf, line_len);
                        l->len = line_len;
                    }
                    lines[line_count++] = l;
                    line_len = 0;
                }
            } else {
                // Append byte to current line
                if (line_len >= line_cap_bytes) {
                    size_t new_cap = line_cap_bytes ? line_cap_bytes * 2 : 256;
                    unsigned char *new_buf = realloc(line_buf, new_cap);
                    if (!new_buf) {
                        fprintf(stderr, "new_sort: out of memory\n");
                        goto fail;
                    }
                    line_buf = new_buf;
                    line_cap_bytes = new_cap;
                }
                line_buf[line_len++] = chunk[i];
            }
        }
    }
    
    // Handle final line without trailing newline
    if (line_len > 0) {
        if (line_count >= line_cap) {
            size_t new_cap = line_cap ? line_cap * 2 : 64;
            struct line **new_lines = realloc(lines, new_cap * sizeof(*new_lines));
            if (!new_lines) {
                fprintf(stderr, "new_sort: out of memory\n");
                goto fail;
            }
            lines = new_lines;
            line_cap = new_cap;
        }
        struct line *l = malloc(sizeof(*l));
        if (!l) {
            fprintf(stderr, "new_sort: out of memory\n");
            goto fail;
        }
        l->data = malloc(line_len);
        if (!l->data) {
            free(l);
            fprintf(stderr, "new_sort: out of memory\n");
            goto fail;
        }
        memcpy(l->data, line_buf, line_len);
        l->len = line_len;
        lines[line_count++] = l;
    }
    
    free(chunk);
    chunk = NULL;
    
    // Sort
    if (line_count > 1) {
        qsort(lines, line_count, sizeof(*lines), compare_lines);
    }
    
    // Write output
    for (size_t i = 0; i < line_count; i++) {
        if (lines[i]->len > 0) {
            if (fwrite(lines[i]->data, 1, lines[i]->len, stdout) != lines[i]->len) {
                fprintf(stderr, "new_sort: write error\n");
                goto fail_cleanup;
            }
        }
        if (fputc('\n', stdout) == EOF) {
            fprintf(stderr, "new_sort: write error\n");
            goto fail_cleanup;
        }
    }
    
    if (fflush(stdout) == EOF) {
        fprintf(stderr, "new_sort: write error\n");
        goto fail_cleanup;
    }
    
    // Cleanup
    for (size_t i = 0; i < line_count; i++) {
        free(lines[i]->data);
        free(lines[i]);
    }
    free(lines);
    free(line_buf);
    return 0;

