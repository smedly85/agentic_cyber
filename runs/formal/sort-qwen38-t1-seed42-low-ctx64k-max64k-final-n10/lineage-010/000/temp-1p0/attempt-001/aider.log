#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Line;

static void die(const char *msg) {
    fprintf(stderr, "new_sort: %s\n", msg);
    exit(1);
}

// Comparator: returns <0, 0, or >0
static int cmp_lines(const void *a, const void *b) {
    const Line *la = *(const Line * const *)a;
    const Line *lb = *(const Line * const *)b;
    size_t minlen = la->len < lb->len ? la->len : lb->len;
    for (size_t i = 0; i < minlen; i++) {
        if (la->data[i] < lb->data[i]) return -1;
        if (la->data[i] > lb->data[i]) return 1;
    }
    if (la->len < lb->len) return -1;
    if (la->len > lb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc != 1) {
        fprintf(stderr, "usage: new_sort\n");
        return 2;
    }

    // Dynamic array of lines
    Line *lines = NULL;
    size_t line_count = 0;
    size_t line_cap = 0;

    // Read lines from stdin
    int ch;
    unsigned char *buf = NULL;
    size_t buf_len = 0;
    size_t buf_cap = 0;

    // Read first byte
    ch = fgetc(stdin);

    while (ch != EOF) {
        // Reset current line buffer
        buf_len = 0;

        // Read until newline or EOF
        while (ch != EOF && ch != '\n') {
            if (buf_len == buf_cap) {
                size_t new_cap = buf_cap ? buf_cap * 2 : 256;
                // Check overflow
                if (new_cap < buf_cap) die("allocation size overflow");
                unsigned char *tmp = realloc(buf, new_cap);
                if (!tmp) die("memory allocation failure");
                buf = tmp;
                buf_cap = new_cap;
            }
            buf[buf_len++] = (unsigned char)ch;
            ch = fgetc(stdin);
            if (ch == EOF && ferror(stdin)) die("input error");
        }

        // Check if we have a line (buf_len > 0) or if we just hit EOF with empty
        // Actually, if ch == EOF and buf_len == 0, there's no more line
        // But if ch == '\n' and buf_len == 0, that's an empty line - we should store it

        // Store the line if we have one, or if we hit a newline (empty line)
        if (buf_len > 0 || ch == '\n') {
            // Add to lines array
            if (line_count == line_cap) {
                size_t new_cap = line_cap ? line_cap * 2 : 64;
                if (new_cap < line_cap) die("allocation size overflow");
                Line *tmp = realloc(lines, new_cap * sizeof(Line));
                if (!tmp) die("memory allocation failure");
                lines = tmp;
                line_cap = new_cap;
            }

            // Copy the line data
            unsigned char *line_data = malloc(buf_len ? buf_len : 1);
            if (!line_data) die("memory allocation failure");
            if (buf_len > 0) {
                memcpy(line_data, buf, buf_len);
            }
            lines[line_count].data = line_data;
            lines[line_count].len = buf_len;
            line_count++;
        }

        if (ch == EOF) break;
        // ch == '\n', continue reading next line
        ch = fgetc(stdin);
        if (ch == EOF) {
            // No more input, and we already handled the line above
            // But wait - if the last line didn't end with newline, we already stored it
            break;
        }
    }

    // Check for input error at end
    if (ch == EOF && ferror(stdin)) die("input error");

    // Sort
    if (line_count > 1) {
        qsort(lines, line_count, sizeof(Line), cmp_lines);
    }

    // Write output
    for (size_t i = 0; i < line_count; i++) {
        if (lines[i].len > 0) {
            if (fwrite(lines[i].data, 1, lines[i].len, stdout) != lines[i].len) {
                die("output error");
            }
        }
        if (fputc('\n', stdout) == EOF) {
            die("output error");
        }
    }

    if (fflush(stdout) != 0) {
        die("output error");
    }

    // Cleanup
    for (size_t i = 0; i < line_count; i++) {
        free(lines[i].data);
    }
    free(lines);
    free(buf);

    return 0;
}
