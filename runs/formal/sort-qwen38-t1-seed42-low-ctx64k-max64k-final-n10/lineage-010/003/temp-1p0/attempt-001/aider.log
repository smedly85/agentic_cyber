                    lines[k].data = NULL;
                }
            }
            lines[out_count] = lines[best];
            out_count++;
            i = j;
        }
        line_count = out_count;
    }

    for (size_t i = 0; i < line_count; i++) {
        if (lines[i].len > 0) {
            if (fwrite(lines[i].data, 1, lines[i].len, stdout) != lines[i].len) {
                die("output error");
            }
        }
        if (fputc('\n', stdout) == EOF) {
            die("output error");
        }
    }

    if (fflush(stdout) != 0) {
        die("output error");
    }

    for (size_t i = 0; i < line_count; i++) {
        free(lines[i].data);
    }
    free(lines);
    free(buf);

    return 0;
}
