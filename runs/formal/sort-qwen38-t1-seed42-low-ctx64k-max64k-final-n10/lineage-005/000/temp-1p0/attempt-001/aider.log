#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

// Line storage
typedef struct {
    unsigned char *data;
    size_t len;
} line_t;

// Dynamic array of lines
typedef struct {
    line_t *items;
    size_t count;
    size_t cap;
} line_array_t;

// Read a single line from FILE* into a dynamically allocated buffer
// Returns 0 on success, 1 on EOF (no more data), -1 on error
// *data points to malloc'd buffer, *len is length (excluding newline)
static int read_line(FILE *fp, unsigned char **data, size_t *len) {
    size_t cap = 256;
    size_t used = 0;
    unsigned char *buf = malloc(cap);
    if (!buf) return -1;
    
    int c;
    while ((c = fgetc(fp)) != EOF) {
        if (used == cap) {
            // Check for overflow
            if (cap > SIZE_MAX / 2) {
                free(buf);
                return -1;
            }
            size_t new_cap = cap * 2;
            unsigned char *tmp = realloc(buf, new_cap);
            if (!tmp) {
                free(buf);
                return -1;
            }
            buf = tmp;
            cap = new_cap;
        }
        if (c == '\n') {
            *data = buf;
            *len = used;
            return 0;
        }
        buf[used++] = (unsigned char)c;
    }
    
    if (used > 0) {
        // Final line without trailing newline
        *data = buf;
        *len = used;
        return 0;
    }
    
    free(buf);
    return 1; // EOF, no data
}

// Comparator: bytewise unsigned comparison
static int cmp_lines(const void *a, const void *b) {
    const line_t *la = *(const line_t *const *)a;
    const line_t *lb = *(const line_t *const *)b;
    size_t minlen = la->len < lb->len ? la->len : lb->len;
    int cmp = memcmp(la->data, lb->data, minlen);
    if (cmp != 0) return cmp;
    if (la->len < lb->len) return -1;
    if (la->len > lb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc != 1) {
        fprintf(stderr, "usage: new_sort\n");
        return 2;
    }
    
    line_array_t arr = {0};
    FILE *in = stdin;
    
    int rc = 0;
    while (1) {
        unsigned char *data;
        size_t len;
        int r = read_line(in, &data, &len);
        if (r == -1) {
            // Error reading
            fprintf(stderr, "new_sort: error reading input\n");
            rc = 1;
            break;
        }
        if (r == 1) {
            // EOF, done
            break;
        }
        
        // Check overflow for count
        if (arr.count == SIZE_MAX) {
            fprintf(stderr, "new_sort: out of memory\n");
            rc = 1;
            break;
        }
        
        // Grow array if needed
        if (arr.count == arr.cap) {
            size_t new_cap;
            if (arr.cap == 0) new_cap = 16;
            else if (arr.cap > SIZE_MAX / 2) {
                fprintf(stderr, "new_sort: out of memory\n");
                rc = 1;
                break;
            } else {
                new_cap = arr.cap * 2;
            }
            line_t *tmp = realloc(arr.items, new_cap * sizeof(line_t));
            if (!tmp) {
                fprintf(stderr, "new_sort: out of memory\n");
                rc = 1;
                break;
            }
            arr.items = tmp;
            arr.cap = new_cap;
        }
        
        arr.items[arr.count].data = data;
        arr.items[arr.count].len = len;
        arr.count++;
    }
    
    if (rc == 0 && arr.count > 1) {
        qsort(arr.items, arr.count, sizeof(line_t), cmp_lines);
    }
    
    if (rc == 0) {
        // Write output
        for (size_t i = 0; i < arr.count; i++) {
            if (arr.items[i].len > 0) {
                if (fwrite(arr.items[i].data, 1, arr.items[i].len, stdout) != arr.items[i].len) {
                    fprintf(stderr, "new_sort: error writing output\n");
                    rc = 1;
                    break;
                }
            }
            if (fputc('\n', stdout) == EOF) {
                fprintf(stderr, "new_sort: error writing output\n");
                rc = 1;
                break;
            }
        }
        if (rc == 0 && fflush(stdout) != 0) {
            fprintf(stderr, "new_sort: error writing output\n");
            rc = 1;
        }
    }
    
    // Cleanup
    for (size_t i = 0; i < arr.count; i++) {
        free(arr.items[i].data);
    }
    free(arr.items);
    
    return rc;
}
