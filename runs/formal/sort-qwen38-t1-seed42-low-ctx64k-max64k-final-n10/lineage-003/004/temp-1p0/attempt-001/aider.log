#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    const unsigned char *data;
    size_t len;
    size_t pos;
} Line;

static int reverse_flag = 0;
static int fold_flag = 0;
static int unique_flag = 0;
static int check_flag = 0;

static unsigned char casefold(unsigned char c) {
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 'A';
    return c;
}

static int unique_equal(const Line *a, const Line *b) {
    if (a->len != b->len) return 0;
    if (fold_flag) {
        for (size_t i = 0; i < a->len; i++)
            if (casefold(a->data[i]) != casefold(b->data[i]))
                return 0;
    } else {
        if (a->len > 0 && memcmp(a->data, b->data, a->len) != 0)
            return 0;
    }
    return 1;
}

static int line_cmp(const void *pa, const void *pb) {
    const Line *a = (const Line *)pa;
    const Line *b = (const Line *)pb;
    int dir = reverse_flag ? -1 : 1;
    size_t minlen = a->len < b->len ? a->len : b->len;
    for (size_t i = 0; i < minlen; i++) {
        unsigned char fa = fold_flag ? casefold(a->data[i]) : a->data[i];
        unsigned char fb = fold_flag ? casefold(b->data[i]) : b->data[i];
        if (fa != fb)
            return (fa < fb ? -1 : 1) * dir;
    }
    if (a->len < b->len) return -dir;
    if (a->len > b->len) return dir;
    if (fold_flag) {
        for (size_t i = 0; i < a->len; i++) {
            if (a->data[i] != b->data[i])
                return (a->data[i] < b->data[i] ? -1 : 1) * dir;
        }
    }
    return 0;
}

int main(int argc, char *argv[]) {
    for (int i = 1; i < argc; i++) {
        const char *arg = argv[i];
        if (strcmp(arg, "--reverse") == 0) {
            reverse_flag = 1;
        } else if (strcmp(arg, "--ignore-case") == 0) {
            fold_flag = 1;
        } else if (strcmp(arg, "--unique") == 0) {
            unique_flag = 1;
        } else if (strcmp(arg, "--check") == 0) {
            check_flag = 1;
        } else if (arg[0] == '-' && arg[1] != '\0') {
            if (arg[1] == '-') {
                fprintf(stderr, "usage: new_sort [-r | --reverse] [-f | --ignore-case] [-u | --unique] [-c | --check]\n");
                return 2;
            }
            for (const char *p = arg + 1; *p; p++) {
                if (*p == 'r') {
                    reverse_flag = 1;
                } else if (*p == 'f') {
                    fold_flag = 1;
                } else if (*p == 'u') {
                    unique_flag = 1;
                } else if (*p == 'c') {
                    check_flag = 1;
                } else {
                    fprintf(stderr, "usage: new_sort [-r | --reverse] [-f | --ignore-case] [-u | --unique] [-c | --check]\n");
                    return 2;
                }
            }
        } else {
            fprintf(stderr, "usage: new_sort [-r | --reverse] [-f | --ignore-case] [-u | --unique] [-c | --check]\n");
            return 2;
        }
    }

    unsigned char *buf = NULL;
    size_t buf_len = 0;
    size_t buf_cap = 0;
    unsigned char rbuf[8192];
    size_t n;
    int read_err = 0;

    while ((n = fread(rbuf, 1, sizeof(rbuf), stdin)) > 0) {
        if (buf_len + n > buf_cap) {
            size_t new_cap;
            if (buf_cap > SIZE_MAX / 2) {
                if (buf_len + n > SIZE_MAX) { read_err = 1; break; }
                new_cap = buf_len + n;
            } else {
                new_cap = buf_cap ? buf_cap * 2 : sizeof(rbuf);
                if (new_cap < buf_len + n) new_cap = buf_len + n;
            }
            unsigned char *tmp = realloc(buf, new_cap);
            if (!tmp) { read_err = 1; break; }
            buf = tmp;
            buf_cap = new_cap;
        }
        memcpy(buf + buf_len, rbuf, n);
        buf_len += n;
    }
    if (ferror(stdin)) read_err = 1;

    if (read_err) {
        fprintf(stderr, "new_sort: %s\n",
                ferror(stdin) ? "read error" : "out of memory");
        free(buf);
        return 1;
    }

    size_t line_count = 0;
    if (buf_len > 0) {
        for (size_t i = 0; i < buf_len; i++)
            if (buf[i] == '\n') line_count++;
        if (buf[buf_len - 1] != '\n') line_count++;
    }

    Line *lines = NULL;
    if (line_count > 0) {
        if (line_count > SIZE_MAX / sizeof(Line)) {
            fprintf(stderr, "new_sort: out of memory\n");
            free(buf);
            return 1;
        }
        lines = malloc(line_count * sizeof(Line));
        if (!lines) {
            fprintf(stderr, "new_sort: out of memory\n");
            free(buf);
            return 1;
        }
    }

    size_t idx = 0;
    size_t start = 0;
    for (size_t i = 0; i < buf_len; i++) {
        if (buf[i] == '\n') {
            lines[idx].data = buf + start;
            lines[idx].len = i - start;
            lines[idx].pos = idx;
            idx++;
            start = i + 1;
        }
    }
    if (start < buf_len) {
        lines[idx].data = buf + start;
        lines[idx].len = buf_len - start;
        lines[idx].pos = idx;
        idx++;
    }

    if (check_flag) {
        for (size_t i = 1; i < line_count; i++) {
            int cmp = line_cmp(&lines[i - 1], &lines[i]);
            if (unique_flag ? (cmp >= 0) : (cmp > 0)) {
                fprintf(stderr, "new_sort: -:%zu: disorder: ", i + 1);
                fwrite(lines[i].data, 1, lines[i].len, stderr);
                fputc('\n', stderr);
                free(lines);
                free(buf);
                return 1;
            }
        }
        free(lines);
        free(buf);
        return 0;
    }

    if (line_count > 1)
        qsort(lines, line_count, sizeof(Line), line_cmp);

    if (unique_flag && line_count > 1) {
        size_t out = 0;
        size_t i = 0;
        while (i < line_count) {
            size_t j = i + 1;
            while (j < line_count && unique_equal(&lines[i], &lines[j]))
                j++;
            size_t best = i;
            for (size_t k = i + 1; k < j; k++)
                if (lines[k].pos < lines[best].pos)
                    best = k;
            lines[out++] = lines[best];
            i = j;
        }
        line_count = out;
    }

    int write_err = 0;
    for (size_t i = 0; i < line_count; i++) {
        if (lines[i].len > 0) {
            if (fwrite(lines[i].data, 1, lines[i].len, stdout) != lines[i].len) {
                write_err = 1;
                break;
            }
        }
        if (fputc('\n', stdout) == EOF) {
            write_err = 1;
            break;
        }
    }
    if (!write_err && fflush(stdout) != 0)
        write_err = 1;

    free(lines);
    free(buf);

    if (write_err) {
        fprintf(stderr, "new_sort: write error\n");
        return 1;
    }
    return 0;
}
EOF

