static int grow_array(LineArray *la) {
    if (la->count == la->capacity) {
        size_t new_cap;
        if (la->capacity == 0) new_cap = 16;
        else if (la->capacity > SIZE_MAX / 2) new_cap = la->capacity + 1;
        else new_cap = la->capacity * 2;
        // check if new_cap * sizeof(Line) overflows
        if (new_cap > SIZE_MAX / sizeof(Line)) return -1;
        Line *tmp = realloc(la->lines, new_cap * sizeof(Line));
        if (!tmp) return -1;
        la->lines = tmp;
        la->capacity = new_cap;
    }
    return 0;
}
```

