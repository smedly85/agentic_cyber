#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    const unsigned char *data;
    size_t len;
} Line;

static int line_cmp(const void *pa, const void *pb) {
    const Line *a = (const Line *)pa;
    const Line *b = (const Line *)pb;
    size_t minlen = a->len < b->len ? a->len : b->len;
    for (size_t i = 0; i < minlen; i++) {
        if (a->data[i] != b->data[i])
            return a->data[i] < b->data[i] ? -1 : 1;
    }
    if (a->len < b->len) return -1;
    if (a->len > b->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc > 1) {
        fprintf(stderr, "usage: new_sort\n");
        return 2;
    }
    
    // Read all input
    unsigned char *buf = NULL;
    size_t buf_len = 0, buf_cap = 0;
    
    int read_ok = 1;
    while (1) {
        unsigned char c;
        if (fread(&c, 1, 1, stdin) != 1) {
            if (ferror(stdin)) read_ok = 0;
            break;
        }
        if (buf_len + 1 > buf_cap) {
            size_t new_cap;
            if (buf_cap > SIZE_MAX / 2) {
                if (buf_len + 1 > SIZE_MAX) { read_ok = 0; break; }
                new_cap = buf_len + 1;
            } else {
                new_cap = buf_cap ? buf_cap * 2 : 256;
                if (new_cap < buf_len + 1) new_cap = buf_len + 1;
            }
            unsigned char *tmp = realloc(buf, new_cap);
            if (!tmp) { read_ok = 0; break; }
            buf = tmp;
            buf_cap = new_cap;
        }
        buf[buf_len++] = c;
    }
    
    if (!read_ok) {
        fprintf(stderr, "new_sort: %s\n", 
                ferror(stdin) ? "read error" : "out of memory");
        free(buf);
        return 1;
    }
    
    // Split into lines
    // Count lines first
    size_t line_count = 0;
    if (buf_len > 0) {
        line_count = 1;
        for (size_t i = 0; i < buf_len; i++)
            if (buf[i] == '\n') line_count++;
    }
    
    Line *lines = NULL;
    if (line_count > 0) {
        if (line_count > SIZE_MAX / sizeof(Line)) {
            fprintf(stderr, "new_sort: out of memory\n");
            free(buf);
            return 1;
        }
        lines = malloc(line_count * sizeof(Line));
        if (!lines) {
            fprintf(stderr, "new_sort: out of memory\n");
            free(buf);
            return 1;
        }
    }
    
    size_t idx = 0;
    size_t start = 0;
    for (size_t i = 0; i <= buf_len; i++) {
        if (i == buf_len || buf[i] == '\n') {
            lines[idx].data = buf + start;
            lines[idx].len = i - start;
            idx++;
            start = i + 1;
        }
    }
    
    // Sort
    if (line_count > 1) {
        qsort(lines, line_count, sizeof(Line), line_cmp);
    }
    
    // Write output
    int write_ok = 1;
    for (size_t i = 0; i < line_count; i++) {
        if (lines[i].len > 0) {
            if (fwrite(lines[i].data, 1, lines[i].len, stdout) != lines[i].len) {
                write_ok = 0;
                break;
            }
        }
        if (fputc('\n', stdout) == EOF) {
            write_ok = 0;
            break;
        }
    }
    if (write_ok && fflush(stdout) != 0)
        write_ok = 0;
    
    free(lines);
    free(buf);
    
    if (!write_ok) {
        fprintf(stderr, "new_sort: write error\n");
        return 1;
    }
    return 0;
}
