// Line storage: each line is a dynamically allocated byte buffer
// Collection: array of line pointers, dynamically grown

typedef struct {
    unsigned char *data;
    size_t len;
    size_t cap;
} Line;

typedef struct {
    Line *lines;
    size_t count;
    size_t cap;
} LineCollection;

// Comparison: bytewise, unsigned
static int compare_lines(const Line *a, const Line *b) {
    size_t min_len = a->len < b->len ? a->len : b->len;
    int cmp = memcmp(a->data, b->data, min_len);
    if (cmp != 0) return cmp < 0 ? -1 : 1;
    // One is prefix of other
    if (a->len < b->len) return -1;
    if (a->len > b->len) return 1;
    return 0;
}

// qsort comparator
static int qsort_cmp(const void *pa, const void *pb) {
    const Line *a = *(const Line *const *)pa;
    const Line *b = *(const Line *const *)pb;
    return compare_lines(a, b);
}

