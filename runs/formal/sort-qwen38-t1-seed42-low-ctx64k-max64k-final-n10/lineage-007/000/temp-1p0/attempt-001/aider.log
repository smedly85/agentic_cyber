#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Line;

typedef struct {
    Line *items;
    size_t count;
    size_t cap;
} LineBuf;

static void die(const char *msg) {
    fprintf(stderr, "new_sort: %s\n", msg);
    exit(1);
}

static void *xmalloc(size_t size) {
    if (size == 0) size = 1;
    void *p = malloc(size);
    if (!p) die("memory allocation failure");
    return p;
}

static void *xrealloc(void *ptr, size_t size) {
    if (size == 0) size = 1;
    void *p = realloc(ptr, size);
    if (!p) die("memory allocation failure");
    return p;
}

static int overflow_check(size_t a, size_t b, size_t *result) {
    if (a != 0 && b > SIZE_MAX / a) return -1;
    *result = a * b;
    return 0;
}

static void free_line_buf(LineBuf *buf) {
    for (size_t i = 0; i < buf->count; i++) {
        free(buf->items[i].data);
    }
    free(buf->items);
    buf->items = NULL;
    buf->count = 0;
    buf->cap = 0;
}

static int store_line(LineBuf *buf, const unsigned char *data, size_t len) {
    if (buf->count == buf->cap) {
        size_t new_cap;
        if (buf->cap == 0) {
            new_cap = 16;
        } else {
            if (overflow_check(buf->cap, 2, &new_cap) != 0) die("allocation size overflow");
        }
        if (overflow_check(new_cap, sizeof(Line), NULL) != 0) die("allocation size overflow");
        Line *new_items = xrealloc(buf->items, new_cap * sizeof(Line));
        if (!new_items) die("memory allocation failure");
        buf->items = new_items;
        buf->cap = new_cap;
    }
    
    Line *l = &buf->items[buf->count];
    if (len > 0) {
        l->data = xmalloc(len);
        if (!l->data) die("memory allocation failure");
        memcpy(l->data, data, len);
    } else {
        l->data = NULL;
    }
    l->len = len;
    buf->count++;
    return 0;
}

static int cmp_lines(const void *a, const void *b) {
    const Line *la = *(const Line *)a;
    const Line *lb = *(const Line *)b;
    size_t min_len = la->len < lb->len ? la->len : lb->len;
    
    int cmp = 0;
    if (min_len > 0) {
        cmp = memcmp(la->data, lb->data, min_len);
    }
    
    if (cmp != 0) return cmp;
    
    // One is a prefix of the other
    if (la->len < lb->len) return -1;
    if (la->len > lb->len) return 1;
    return 0;
}
