#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef struct {
    unsigned char *data;
    size_t len;
} Line;

typedef struct {
    Line *items;
    size_t count;
    size_t cap;
} LineBuf;

static void die(const char *msg) {
    fprintf(stderr, "new_sort: %s\n", msg);
    exit(1);
}

static void *xmalloc(size_t size) {
    void *p = malloc(size ? size : 1);
    if (!p) die("memory allocation failure");
    return p;
}

static void *xrealloc(void *ptr, size_t size) {
    void *p = realloc(ptr, size ? size : 1);
    if (!p) die("memory allocation failure");
    return p;
}

static int mul_overflow(size_t a, size_t b, size_t *result) {
    if (a != 0 && b > SIZE_MAX / a) return -1;
    *result = a * b;
    return 0;
}

static void free_all(LineBuf *buf) {
    for (size_t i = 0; i < buf->count; i++) {
        free(buf->items[i].data);
    }
    free(buf->items);
}

static int store_line(LineBuf *buf, const unsigned char *data, size_t len) {
    if (buf->count == buf->cap) {
        size_t new_cap;
        if (buf->cap == 0) {
            new_cap = 16;
        } else {
            if (mul_overflow(buf->cap, 2, &new_cap) != 0) die("allocation size overflow");
        }
        size_t total;
        if (mul_overflow(new_cap, sizeof(Line), &total) != 0) die("allocation size overflow");
        Line *new_items = xrealloc(buf->items, total);
        if (!new_items) die("memory allocation failure");
        buf->items = new_items;
        buf->cap = new_cap;
    }
    
    Line *l = &buf->items[buf->count];
    if (len > 0) {
        l->data = xmalloc(len);
        if (!l->data) die("memory allocation failure");
        memcpy(l->data, data, len);
    } else {
        l->data = NULL;
    }
    l->len = len;
    buf->count++;
    return 0;
}

static int cmp_lines(const void *a, const void *b) {
    const Line *la = *(const Line *)a;
    const Line *lb = *(const Line *)b;
    size_t min_len = la->len < lb->len ? la->len : lb->len;
    
    if (min_len > 0) {
        int r = memcmp(la->data, lb->data, min_len);
        if (r != 0) return r;
    }
    
    if (la->len < lb->len) return -1;
    if (la->len > lb->len) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc > 1) {
        fprintf(stderr, "usage: new_sort\n");
        return 2;
    }
    
    LineBuf buf = {0};
    unsigned char *line_data = NULL;
    size_t line_len = 0;
    size_t line_cap = 0;
    int line_started = 0;
    
    int c;
    while ((c = fgetc(stdin)) != EOF) {
        unsigned char byte = (unsigned char)c;
        
        if (byte == '\n') {
            if (line_started) {
                store_line(&buf, line_data, line_len);
            }
            line_len = 0;
            line_started = 0;
        } else {
            if (line_len == line_cap) {
                size_t new_cap;
                if (line_cap == 0) {
                    new_cap = 256;
                } else {
                    if (mul_overflow(line_cap, 2, &new_cap) != 0) die("allocation size overflow");
                }
                unsigned char *nd = xrealloc(line_data, new_cap);
                if (!nd) die("memory allocation failure");
                line_data = nd;
                line_cap = new_cap;
            }
            line_data[line_len++] = byte;
            line_started = 1;
        }
    }
    
    if (ferror(stdin)) {
        free(line_data);
        free_all(&buf);
        die("input error");
    }
    
    // Handle final line without trailing newline
    if (line_started) {
        store_line(&buf, line_data, line_len);
    }
    
    free(line_data);
    
    if (buf.count > 1) {
        qsort(buf.items, buf.count, sizeof(Line), cmp_lines);
    }
    
    // Write output
    for (size_t i = 0; i < buf.count; i++) {
        if (buf.items[i].len > 0) {
            if (fwrite(buf.items[i].data, 1, buf.items[i].len, stdout) != buf.items[i].len) {
                free_all(&buf);
                die("output error");
            }
        }
        if (fputc('\n', stdout) == EOF) {
            free_all(&buf);
            die("output error");
        }
    }
    
    if (fflush(stdout) != 0) {
        free_all(&buf);
        die("output error");
    }
    
    free_all(&buf);
    return 0;
}
