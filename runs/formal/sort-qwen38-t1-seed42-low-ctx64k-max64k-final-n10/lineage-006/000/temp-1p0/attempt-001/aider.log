} Line;

static Line *lines = NULL;
static size_t line_count = 0;
static size_t line_capacity = 0;

static int add_line(const char *data, size_t len) {
    if (line_count >= line_capacity) {
        size_t new_cap = line_capacity == 0 ? INITIAL_CAPACITY : line_capacity * 2;
        if (new_cap < line_capacity) {
            return -1;  // overflow
        }
        Line *new_lines = realloc(lines, new_cap * sizeof(Line));
        if (!new_lines) {
            return -1;
        }
        lines = new_lines;
        line_capacity = new_cap;
    }
    
    lines[line_count].data = malloc(len + 1);
    if (!lines[line_count].data) {
        return -1;
    }
