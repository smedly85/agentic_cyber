#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <errno.h>

#define INITIAL_CAPACITY 64
#define CHUNK_SIZE 4096

typedef struct {
    char *data;
    size_t len;
} Line;

static Line *lines = NULL;
static size_t line_count = 0;
static size_t line_capacity = 0;

static int add_line(const char *data, size_t len) {
    if (line_count >= line_capacity) {
        size_t new_cap = line_capacity == 0 ? INITIAL_CAPACITY : line_capacity * 2;
        if (new_cap < line_capacity) {
            return -1;  // overflow
        }
        Line *new_lines = realloc(lines, new_cap * sizeof(Line));
        if (!new_lines) {
            return -1;
        }
        lines = new_lines;
        line_capacity = new_cap;
    }
    
    lines[line_count].data = malloc(len + 1);
    if (!lines[line_count].data) {
        return -1;
    }
    memcpy(lines[line_count].data, data, len);
    lines[line_count].data[len] = '\0';
    lines[line_count].len = len;
    line_count++;
    return 0;
}

static int read_all_input(void) {
    char *buffer = NULL;
    size_t buffer_size = 0;
    size_t buffer_used = 0;
    
    while (1) {
        if (buffer_used >= buffer_size) {
            size_t new_size = buffer_size == 0 ? CHUNK_SIZE : buffer_size * 2;
            if (new_size < buffer_size) {
                return -1;  // overflow
            }
            char *new_buf = realloc(buffer, new_size);
            if (!new_buf) {
                return -1;
            }
            buffer = new_buf;
            buffer_size = new_size;
        }
        
        size_t to_read = buffer_size - buffer_used;
        if (to_read == 0) {
            break;
        }
        
        size_t n = fread(buffer + buffer_used, 1, to_read, stdin);
        if (n == 0) {
            if (ferror(stdin)) {
                free(buffer);
                return -1;
            }
            break;
        }
        buffer_used += n;
    }
    
    if (buffer_used == 0) {
        free(buffer);
        return 0;
    }
    
    size_t start = 0;
    for (size_t i = 0; i < buffer_used; i++) {
        if (buffer[i] == '\n') {
            if (add_line(buffer + start, i - start) < 0) {
                free(buffer);
                return -1;
            }
            start = i + 1;
        }
    }
    
    if (start < buffer_used) {
        if (add_line(buffer + start, buffer_used - start) < 0) {
            free(buffer);
            return -1;
        }
    }
    
    free(buffer);
    return 0;
}

static int compare_lines(const void *a, const void *b) {
    const Line *la = (const Line *)a;
    const Line *lb = (const Line *)b;
    
    size_t min_len = la->len < lb->len ? la->len : lb->len;
    int result = memcmp((const unsigned char *)la->data, (const unsigned char *)lb->data, min_len);
    
