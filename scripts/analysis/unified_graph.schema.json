{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified-program-graph-v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "reason", "details"],
      "properties": {
        "schema_version": {"const": "unified-program-graph-v2"},
        "status": {"const": "unavailable"},
        "reason": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "language", "backend", "extractor_version", "source", "compiler", "llvm_ir_sha256", "entry_points", "nodes", "edges", "limitations"],
      "properties": {
        "schema_version": {"const": "unified-program-graph-v2"},
        "status": {"const": "success"},
        "language": {"const": "c"},
        "backend": {"const": "llvm-ir-cfg-v2"},
        "extractor_version": {"const": "llvm-ir-cfg-extractor-v2"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "compiler": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "binary_sha256", "profile", "command"],
          "properties": {
            "version": {"type": "string"},
            "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "profile": {"type": "string"},
            "command": {"type": "array", "items": {"type": "string"}}
          }
        },
        "llvm_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry_points": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "label", "owner", "content", "audit"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["function", "block", "api"]},
              "label": {"type": "string", "minLength": 1},
              "owner": {"type": ["string", "null"]},
              "content": {"type": "array", "items": {"type": "string"}},
              "audit": {"type": "object"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "source", "target", "label"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "extraction_environment": {"type": "object"}
      }
    }
  ]
}
