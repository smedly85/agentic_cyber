{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified-program-graph-v1",
  "type": "object",
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": {"const": "unified-program-graph-v1"},
    "status": {"enum": ["success", "unavailable"]},
    "language": {"const": "c"},
    "backend": {"const": "llvm-ir-cfg-v1"},
    "source": {"type": "object", "required": ["path", "sha256"]},
    "compiler": {"type": "object", "required": ["version", "profile", "command"]},
    "nodes": {"type": "array"},
    "edges": {"type": "array"}
  }
}
