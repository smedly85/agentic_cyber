{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 1 exploratory Tree-sitter C ordered syntax v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "status", "source_file", "entry_points", "functions", "call_sites", "direct_edges", "unresolved_calls", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"const": "tree_sitter_c_syntax_exploratory"},
    "status": {"enum": ["success", "unsupported_language", "dependency_unavailable", "invalid_encoding", "parser_failure", "malformed_input", "unsupported_input", "io_error"]},
    "source_file": {"type": "string"},
    "entry_points": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
    "call_sites": {"type": "array", "items": {"$ref": "#/$defs/call"}},
    "direct_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "unresolved_calls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"not": {"const": "success"}}}},
    "then": {"properties": {
      "functions": {"maxItems": 0}, "call_sites": {"maxItems": 0},
      "direct_edges": {"maxItems": 0}, "unresolved_calls": {"maxItems": 0},
      "diagnostics": {"minItems": 1}
    }}
  }],
  "$defs": {
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["start_byte", "end_byte", "start", "end"],
      "properties": {
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}
      }
    },
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 0}],
      "items": false
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "role", "ordering", "location", "children"],
      "properties": {
        "id": {"type": "string"}, "kind": {"type": "string"},
        "role": {"type": ["string", "null"]},
        "ordering": {"enum": [
          "source_statement_sequence", "condition_then_exclusive_branch", "alternative_branch",
          "condition_body_repeat", "body_condition_repeat", "initializer_condition_body_update_repeat",
          "condition_then_label_dispatch", "label_with_possible_fallthrough",
          "callee_and_arguments_before_invocation_no_sibling_order", "unsequenced_arguments",
          "left_before_right", "left_then_conditional_right", "unsequenced_operands",
          "indeterminately_sequenced_initializers", "unevaluated_or_vla_dependent", "unevaluated",
          "generic_selection_unresolved", "syntax_only_no_execution_order_claim"
        ]},
        "location": {"$ref": "#/$defs/location"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "operator": {"type": "string"}, "token": {"type": "string"},
        "call_site": {"type": "string"}
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "entry_point", "location", "structure"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "entry_point": {"type": "boolean"},
        "location": {"$ref": "#/$defs/location"}, "structure": {"$ref": "#/$defs/event"}
      }
    },
    "call": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "function", "event", "callee_name", "target", "resolution", "location"],
      "properties": {
        "id": {"type": "string"}, "function": {"type": "string"}, "event": {"type": "string"},
        "callee_name": {"type": ["string", "null"]}, "target": {"type": ["string", "null"]},
        "resolution": {"enum": ["internal_direct", "external_declared", "unresolved_indirect", "unresolved_name"]},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["caller", "target", "callee_name", "call_site"],
      "properties": {
        "caller": {"type": "string"}, "target": {"type": ["string", "null"]},
        "callee_name": {"type": "string"}, "call_site": {"type": "string"}
      }
    }
  }
}
