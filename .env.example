# Copy to .env (gitignored). Model names use LiteLLM syntax,
# e.g. ollama_chat/qwen3-coder-next:latest or openai/<model>.

# Shared endpoint/key used by every role unless overridden per role.
AGENT_API_BASE=http://localhost:11434
AGENT_API_KEY=

# Worker: used by every topology.
AGENT_WORKER_MODEL=ollama_chat/qwen3-coder-next:latest
# AGENT_WORKER_API_BASE=
# AGENT_WORKER_API_KEY=

# Planner: topology = "planner_worker".
# AGENT_PLANNER_MODEL=
# Orchestrator: topology = "orchestrator".
# AGENT_ORCHESTRATOR_MODEL=

# lineage mode with generator = "aider" (src/harness/run_lineage_experiment.sh roles).
# Both roles share one endpoint (AGENT_ARCHITECT_API_BASE or AGENT_API_BASE).
# AGENT_ARCHITECT_MODEL=ollama_chat/qwen3.8:27b
# AGENT_EDITOR_MODEL=ollama_chat/qwen3-coder-next:latest   # optional; the script has a default
