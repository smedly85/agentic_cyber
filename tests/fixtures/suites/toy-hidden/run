#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from toy_suite import run_suite

CASES = [
    ("lone_minus", ["-"], "", 1),
    ("empty_after_flag", ["-s"], "0\n", 0),
    ("zeros", ["0", "-0", "00"], "0\n", 0),
    ("big", ["1000000", "2000000"], "3000000\n", 0),
    ("negate_negative", ["-n", "-3", "1"], "2\n", 0),
]
sys.exit(run_suite(CASES, sys.argv))
