#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from toy_suite import run_suite

CASES = [
    ("sum_basic", ["1", "2", "3"], "6\n", 0),
    ("sum_negative", ["5", "-7"], "-2\n", 0),
    ("square", ["-s", "2", "3"], "25\n", 0),
    ("negate", ["-n", "4"], "-4\n", 0),
    ("invalid", ["1", "x"], "", 1),
    ("usage", [], "", 2),
]
sys.exit(run_suite(CASES, sys.argv))
